            $('#shareDropdownBtn').on('click', function(e) {
                e.stopPropagation();
                $('#shareDropdownMenu').toggle();
            });
            
            // Close dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#shareDropdownBtn, #shareDropdownMenu').length) {
                    $('#shareDropdownMenu').hide();
                }
            });
        });
    </script>


   
