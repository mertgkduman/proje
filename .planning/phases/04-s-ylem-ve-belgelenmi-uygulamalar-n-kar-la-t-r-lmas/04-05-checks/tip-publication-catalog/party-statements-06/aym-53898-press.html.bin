            $('.btn-word:first').attr('href', '/api/DocumentGenerator/GenerateDocument?nodeId=92244&format=docx');
            $('.btn-pdf:first').attr('href', '/api/DocumentGenerator/GenerateDocument?nodeId=92244&format=pdf');
            
