<style>
  .page-banner{background:#f8f9fa;border-bottom:2px solid #e43442;padding:.75rem 0;margin-bottom:.5rem;}
  .banner-title{font-size:1.25rem;font-weight:800;margin:0;color:#000;letter-spacing:.2px;}
  .sort-inline select{ min-width: 160px; }

  /* Boş durum */
  .empty-state{ text-align:center; padding:2rem 1rem; border:2px dashed #eee; border-radius:16px; background:#fff; }
  .empty-state .empty-emoji{ font-size:2rem; }

  /* KART ve özel efektler (ORİJİNAL STİLLER KORUNDU) */
  .parti-card{
    position:relative; display:block;
    background:#fff; border:1px solid rgba(0,0,0,.06); border-radius:18px; overflow:hidden;
    box-shadow:0 8px 22px rgba(0,0,0,0.07); transition:transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    cursor:pointer; will-change: transform, box-shadow;
    transform-style: preserve-3d;
  }
  .parti-card:hover{transform:translateY(-4px); box-shadow:0 16px 34px rgba(0,0,0,0.15); border-color:rgba(228,52,66,.35);}
  .parti-card::after{
    content:""; position:absolute; inset:0; pointer-events:none; opacity:0;
    background:
      radial-gradient(120px 60px at 0% 0%, rgba(228,52,66,.18), transparent 70%),
      radial-gradient(120px 60px at 100% 0%, rgba(228,52,66,.12), transparent 70%),
      radial-gradient(140px 80px at 0% 100%, rgba(255,173,0,.10), transparent 70%),
      radial-gradient(140px 80px at 100% 100%, rgba(255,173,0,.12), transparent 70%);
    mix-blend-mode: multiply;
    transition: opacity .25s ease;
  }
  .parti-card:hover::after{ opacity:1; animation:burnFlicker 1.6s ease-in-out infinite alternate; }
  .parti-card::before{
    content:""; position:absolute; inset:0; pointer-events:none; opacity:0;
    background: linear-gradient(115deg, transparent 40%, rgba(255,255,255,.55) 50%, transparent 62%);
    transform: translateX(-120%);
  }
  .parti-card:hover::before{ opacity:1; animation: shineSweep .9s ease forwards; }
  @keyframes shineSweep{ 0%{ transform: translateX(-120%);} 100%{ transform: translateX(120%);} }
  @keyframes burnFlicker{ 0%{ filter: blur(0px) brightness(1);} 100%{ filter: blur(.6px) brightness(1.08);} }

  .parti-card-img{ position:relative; overflow:hidden; aspect-ratio: 16 / 9; display:flex; align-items:center; justify-content:center; background:#f3f4f6; }
  .parti-card-img img{ width:100%; height:100%; object-fit:contain; display:block; transition: transform .35s ease; will-change: transform; }
  .parti-card:hover .parti-card-img img{ transform: scale(1.02); }

  .parti-card-meta{ position:absolute; left:16px; right:16px; bottom:12px; display:flex; align-items:center; justify-content:space-between; gap:.5rem; z-index:2; }
  .date-pill{ background:#e43442; color:#fff; padding:5px 10px; font-size:.8rem; border-radius:16px; box-shadow:0 2px 8px rgba(0,0,0,0.12); font-weight:800; }

  .parti-card-footer{ display:flex; align-items:center; gap:.5rem; padding:.5rem .75rem; background:#fff; border-top:1px solid rgba(0,0,0,.06); }
  .footer-tag{ display:inline-flex; align-items:center; gap:.35rem; background:#fff; color:#e43442; border:1px solid rgba(228,52,66,.4); padding:5px 10px; border-radius:999px; font-weight:800; font-size:.8rem; line-height:1; }

  .corner-icon{ position:absolute; top:10px; right:10px; width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,.58); color:#fff; font-size:14px; box-shadow:0 4px 12px rgba(0,0,0,.25); transform: translateZ(20px); transition: transform .25s ease, box-shadow .25s ease, opacity .2s ease; z-index:2; }
  .parti-card:hover .corner-icon{ transform: translateZ(20px) scale(1.06); box-shadow:0 6px 16px rgba(0,0,0,.32); }
  .corner-video{ background:rgba(228,52,66,.85); } .corner-pdf{ background:rgba(0,0,0,.72); }

  .parti-card-body{ padding:18px 18px 18px; display:flex; flex-direction:column; min-height:148px; }
  .parti-card-title{ font-size:1.05rem; font-weight:900; line-height:1.35; color:#101010; margin:2px 0 8px; text-transform: uppercase; letter-spacing:.02em; display:block; overflow:hidden; min-height: calc(1.35em * 3); max-height: calc(1.35em * 3); }
  .parti-card-desc{ font-size:.95rem; color:#4a4a4a; line-height:1.55; margin:0; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }

  .btn-more{background:#fff; color:#e43442; border:2px solid #e43442; border-radius:12px;}
  .btn-more:hover{background:#ffecee; color:#c92d37;}

  .reveal{ opacity:0; transform: translateY(8px); }
  .reveal.revealed{ opacity:1; transform: translateY(0); transition: opacity .25s ease, transform .25s ease; }

  /* ====== Sol Keşfet (yalnızca raporlar-belgeler) ====== */
  aside.col-lg-3 .card { border: 1px solid #eee; }
  .content-outline.no-inner-border{ border:0; padding:.5rem 0; background:#fff; }
  #tagsBar{ max-height: calc(100vh - 84px - 32px); overflow:auto; padding-right:6px; scrollbar-width:thin; }
  .sidebar-heading{ font-size:.8rem; letter-spacing:.04em; text-transform:uppercase; color:#6c757d; }

  .tag-link{
    border:0; background:#fff; width:100%;
    display:flex; align-items:flex-start; justify-content:space-between;
    padding:.45rem .75rem; overflow:hidden; text-align:left;
  }
  .tag-link + .tag-link{ border-top:1px solid #f1f1f1; }
  .tag-link:hover{ background:#f8f9fa; }
  .tag-link.active{ background:#fde6e6; }

  .tag-link .tag-text{ flex:1 1 auto; min-width:0; white-space: normal; line-height:1.25; }
  .tag-link .badge{ flex:0 0 auto; margin-left:.5rem; white-space:nowrap; }

  @media (min-width: 992px){
    .is-raporlar #partiGrid > .aciklama-col{ flex: 0 0 50% !important; max-width: 50% !important; }
  }

  @media (prefers-reduced-motion: reduce){
    .parti-card, .parti-card *{ transition: none !important; animation: none !important; }
  }
  @media (max-width: 420px){
    .parti-card-meta{ flex-direction:column; align-items:flex-start; gap:.4rem; bottom:12px; }
  }

  .btn-tip { background:#e43442; color:#fff; border-color:#e43442; }
  .btn-tip:hover { color:#fff; filter:brightness(.95); }
</style>

<script>
(function(){
  const STEP = 15;
  const grid = document.getElementById('partiGrid');
  const isRaporlar = document.querySelector('.container-1200.is-raporlar') !== null;
  const items = grid ? Array.from(grid.querySelectorAll('.aciklama-col')) : [];
  const counter = document.getElementById('aciklamaCounter');
  const counterMobile = document.getElementById('aciklamaCounterMobile');
  const moreBtn = document.getElementById('btnDahaFazla');
  const sortTop = document.getElementById('sortSelect');
  const sortMobileTop = document.getElementById('sortSelectMobileTop');
  const sortMobileBottom = document.getElementById('sortSelectMobileBottom');
  const emptyState = document.getElementById('emptyState');

  const sidebarBar = document.getElementById('tagsBar');
  const mobileBar  = document.getElementById('tagsBarMobile');
  let activeTag = ""; // boş = tümü

  function isFilteredOut(el){ return el.classList.contains('filtered-out'); }
  const poolHidden = () => items.filter(el => el.classList.contains('lazy-hide') && !isFilteredOut(el));
  const poolShown  = () => items.filter(el => !el.classList.contains('d-none') && !isFilteredOut(el));
  const poolAll    = () => items.filter(el => !isFilteredOut(el));

  function updateCounter() {
    if (!grid) return;
    const total = poolAll().length || items.length;
    const shown = poolShown().length || (items.length ? Math.min(items.length, 15) : 0);
    const text = shown + ' / ' + total;
    if (counter) counter.textContent = text;
    if (counterMobile) counterMobile.textContent = text;
  }

  function setActiveButton(bar, tag){
    if (!bar) return;
    const btns = bar.querySelectorAll('.tag-link, .tag-chip');
    btns.forEach(btn => {
      const t = btn.getAttribute('data-tag') || "";
      btn.classList.toggle('active', t === tag);
      if (t === tag) btn.setAttribute('aria-current','true'); else btn.removeAttribute('aria-current');
    });
  }

  function applyFilter(tag){
    activeTag = tag || "";
    if (!isRaporlar || !grid) return;

    setActiveButton(sidebarBar, activeTag);
    setActiveButton(mobileBar, activeTag);

    items.forEach(el => {
      const tags = (el.getAttribute('data-tags') || '').split(',').filter(Boolean);
      const match = (activeTag === "") ? true : tags.includes(activeTag);
      if (match) el.classList.remove('filtered-out');
      else el.classList.add('filtered-out');
    });

    let shownCount = 0;
    items.forEach(el => {
      if (isFilteredOut(el)) {
        el.classList.add('d-none'); el.classList.remove('lazy-hide');
      } else {
        if (shownCount < 15) { el.classList.remove('d-none'); el.classList.remove('lazy-hide'); shownCount++; }
        else { el.classList.add('d-none'); el.classList.add('lazy-hide'); }
      }
      el.querySelector('.parti-card')?.classList.remove('revealed');
    });

    requestAnimationFrame(() => {
      poolShown().forEach((el, idx) => setTimeout(() => el.querySelector('.parti-card')?.classList.add('revealed'), 20 + idx*15));
    });

    if (moreBtn) {
      if (poolHidden().length > 0) moreBtn.classList.remove('d-none');
      else moreBtn.classList.add('d-none');
    }
    if (emptyState){
      if (poolAll().length === 0) emptyState.classList.remove('d-none');
      else emptyState.classList.add('d-none');
    }
    updateCounter();
  }

  // Daha Fazla Göster
  if (moreBtn) {
    moreBtn.addEventListener('click', () => {
      const pool = (isRaporlar ? poolHidden() : Array.from(grid.querySelectorAll('.lazy-hide'))).slice(0, STEP);
      pool.forEach((el, idx) => {
        el.classList.remove('d-none'); el.classList.remove('lazy-hide');
        const card = el.querySelector('.parti-card');
        setTimeout(() => card?.classList.add('revealed'), 20 + idx*25);
      });
      const anyHidden = (isRaporlar ? poolHidden() : Array.from(grid.querySelectorAll('.lazy-hide'))).length > 0;
      if (!anyHidden) moreBtn.classList.add('d-none');
      updateCounter();
    });
  }

  // Sıralama
  function applySort(mode){
    if (!grid) return;
    const cols = Array.from(grid.children);
    let sorted = cols;
    if (mode === 'title') {
      sorted = cols.sort((a,b) =>
        (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '', 'tr')
      );
    } else if (mode === 'asc' || mode === 'desc') {
      sorted = cols.sort((a,b) => {
        const ia = a.getAttribute('data-iso') || '';
               const ib = b.getAttribute('data-iso') || '';
        return (mode === 'asc') ? ia.localeCompare(ib) : ib.localeCompare(ia);
      });
    }
    sorted.forEach(el => grid.appendChild(el));
    if (isRaporlar) applyFilter(activeTag);
    updateCounter();
  }

  function syncSortSelects(val){
    [sortTop, sortMobileTop, sortMobileBottom].forEach(sel => { if (sel) sel.value = val; });
  }

  [sortTop, sortMobileTop, sortMobileBottom].forEach(sel=>{
    if (!sel) return;
    sel.addEventListener('change', e => {
      const v = e.target.value;
      syncSortSelects(v);
      applySort(v);
    });
  });

  function tagClickHandler(e){
    const btn = e.target.closest('.tag-link, .tag-chip');
    if (!btn) return;
    const tag = btn.getAttribute('data-tag') || "";
    applyFilter(tag);
  }
  sidebarBar && sidebarBar.addEventListener('click', tagClickHandler);
  mobileBar  && mobileBar.addEventListener('click', tagClickHandler);

  // İlk yükleme
  requestAnimationFrame(() => {
    if (grid){
      Array.from(grid.querySelectorAll('.aciklama-col:not(.d-none) .parti-card'))
           .forEach((card, idx) => setTimeout(() => card.classList.add('revealed'), 30 + idx*20));
    }
    updateCounter();
  });
})();
</script>
