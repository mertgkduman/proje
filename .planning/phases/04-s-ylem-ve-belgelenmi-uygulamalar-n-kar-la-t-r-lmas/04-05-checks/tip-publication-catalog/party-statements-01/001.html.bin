<script>
(function () {
  // Okuma ilerleme çubuğu
  var bar = document.getElementById('kbIlerleme'), col = document.getElementById('kurtulusBildirgesi');
  function guncelle() {
    if (!bar || !col) return;
    var r = col.getBoundingClientRect(), toplam = col.offsetHeight - window.innerHeight;
    var oran = toplam > 0 ? Math.min(1, Math.max(0, -r.top / toplam)) : 1;
    bar.style.width = (oran * 100) + '%';
  }
  window.addEventListener('scroll', guncelle, { passive: true });
  window.addEventListener('resize', guncelle);
  guncelle();
  // Video: kapağa dokununca YouTube oynatıcısı (nocookie) yüklenir ve başlar
  var v = document.getElementById('kbVideo');
  if (v) v.addEventListener('click', function () {
    var f = document.createElement('iframe');
    f.src = 'https://www.youtube-nocookie.com/embed/' + v.getAttribute('data-id')
      + '?autoplay=1&rel=0&modestbranding=1&playsinline=1&start=' + (v.getAttribute('data-start') || '0');
    f.title = 'Kurtuluş Bildirgesi';
    f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    f.allowFullscreen = true;
    f.referrerPolicy = 'strict-origin-when-cross-origin';
    v.replaceWith(f);
  });
  // Hazır mesajlar: metin = WhatsApp/kopyala (uzun), kisa = telefonun paylaş menüsü
  var pm = {};
  try { pm = JSON.parse(document.getElementById('kbPaylasMesaj').textContent); } catch (e) {}
  // Mesajı ve bağlantıyı kopyala
  var k = document.getElementById('kbKopyala');
  if (k) k.addEventListener('click', function () {
    var metin = pm.metin || 'https://tip.org.tr/kurtulus-bildirgesi';
    var bitti = function () { k.innerHTML = '<i class="fa-solid fa-check"></i>'; setTimeout(function () { k.innerHTML = '<i class="fa-solid fa-copy"></i>'; }, 1600); };
    if (navigator.clipboard) navigator.clipboard.writeText(metin).then(bitti, function () { window.prompt('Kopyalayın:', metin); });
    else window.prompt('Kopyalayın:', metin);
  });
  // Telefonun kendi paylaş menüsü (destekleyen tarayıcılarda görünür)
  var ps = document.getElementById('kbPaylas');
  if (ps && navigator.share) {
    ps.classList.remove('d-none');
    ps.addEventListener('click', function () {
      navigator.share({ title: 'Kurtuluş Bildirgesi', text: pm.kisa || '', url: pm.url }).catch(function () {});
    });
  }
})();
</script>
