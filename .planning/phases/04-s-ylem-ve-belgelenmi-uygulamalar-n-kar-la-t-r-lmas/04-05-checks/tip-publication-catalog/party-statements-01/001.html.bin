<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
(function(){
  const overlay = document.getElementById('searchOverlay');
  const card    = overlay.querySelector('.search-card');
  const input   = document.getElementById('searchInput');
  const results = document.getElementById('searchResults');
  const openBtns = [document.getElementById('openSearchDesktop'), document.getElementById('openSearchMobile')].filter(Boolean);
  const endpointBase = document.body.getAttribute('data-search-endpoint') || '/';
  // Alt alan adlarında (ör. biryolvar) sonuçlar ana siteye gitsin.
  const SITE_BASE = "";
  const siteUrl = (u) => (typeof u === 'string' && u.startsWith('/') && !u.startsWith('//')) ? SITE_BASE + u : u;
  function openOverlay(){
    overlay.classList.add('show');
    setTimeout(()=> input?.focus(), 10);
    document.body.style.overflow = 'hidden';
  }
  function closeOverlay(){
    overlay.classList.remove('show');
    document.body.style.overflow = '';
    input.value = '';
    results.classList.remove('show');
    results.innerHTML = '';
  }
  openBtns.forEach(b=> b.addEventListener('click', openOverlay));
  document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape' && overlay.classList.contains('show')) closeOverlay(); });
  overlay.addEventListener('click', (e)=>{ if(!card.contains(e.target)) closeOverlay(); });
  let t=null, lastQ='';
  input.addEventListener('input', ()=>{
    const q = input.value.trim();
    if (q === lastQ) return;
    lastQ = q;
    clearTimeout(t);
    if (q.length < 2) {
      results.classList.remove('show');
      results.innerHTML = '';
      return;
    }
    t = setTimeout(()=> search(q), 160);
  });
  async function search(q){
    try{
      const url = endpointBase + (endpointBase.includes('?') ? '&' : '?') + '__ajax=search&q=' + encodeURIComponent(q);
      const res = await fetch(url, {credentials:'same-origin'});
      if (!res.ok) throw new Error('HTTP '+res.status);
      const data = await res.json();
      const items = Array.isArray(data.items) ? data.items : [];
      if (!items.length) {
        results.innerHTML = '<div class="sr-empty">☹️ Maalesef aradığın kelimeye ait bir sonuç bulamadık.</div>';
        results.classList.add('show');
        return;
      }
      results.innerHTML = items.map(it=>{
        const thumb = it.thumb ? it.thumb : 'https://tip.org.tr/wp-content/uploads/2023/05/tip-logo-1600x900-2-scaled.jpg';
        const date  = it.date ? new Date(it.date.replace(' ','T')).toLocaleDateString('tr-TR') : '';
        const badge = it.label ? `<span class="sr-badge">${escapeHtml(it.label)}</span>` : '';
        const snippet = (it.snippet||'').trim();
        return `
          <a class="sr-item" href="${siteUrl(it.url)}">
            <span class="sr-thumb"><img src="${thumb}" alt=""></span>
            <span class="sr-meta" style="min-width:0;">
              <h4 class="sr-title">
                ${escapeHtml(it.title)} ${badge}
              </h4>
              ${snippet ? `<p class="sr-snippet">${escapeHtml(snippet)}</p>` : ''}
              ${date ? `<small style="color:#666">${date}</small>` : ''}
            </span>
          </a>`;
      }).join('');
      results.classList.add('show');
    } catch(e){
      console.error('Arama hatası:', e);
      results.innerHTML = '<div class="sr-empty">☹️ Maalesef aradığın kelimeye ait bir sonuç bulamadık.</div>';
      results.classList.add('show');
    }
  }
  function escapeHtml(s){
    return (s||'').replace(/[&<>"']/g, m=> ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  }
})();
</script>

</body>
</html>
<div class="kb-ilerleme" id="kbIlerleme" aria-hidden="true"></div>
<div class="kb-sayfa">
<main class="kb-col" id="kurtulusBildirgesi">

  <!-- ================= VİDEO ================= -->
  <section class="kb-video" aria-label="Kurtuluş Bildirgesi videosu">
    <div class="kb-video-cerceve">
      <button type="button" class="kb-video-kapak" id="kbVideo" data-id="RCX5F2xb3Hw" data-start="0"
              aria-label="Kurtuluş Bildirgesi videosunu oynat">
        <img src="https://i.ytimg.com/vi/RCX5F2xb3Hw/maxresdefault.jpg" alt="" loading="lazy" width="1280" height="720"
             onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/RCX5F2xb3Hw/hqdefault.jpg'">
        <span class="kb-video-oynat" aria-hidden="true"><i class="fa-solid fa-play"></i></span>
      </button>
    </div>
  </section>

  <!-- ================= YURTTAŞA MEKTUP ================= -->
  <article class="a4" aria-labelledby="mektup-baslik">
    <header class="a4-bant">
      <picture>
        <source type="image/webp" srcset="/assets/kurtulus-bildirgesi/a4-yurttasa-mektup-bant-800.webp 800w, /assets/kurtulus-bildirgesi/a4-yurttasa-mektup-bant-1600.webp 1600w" sizes="(min-width:1100px) 1060px, 100vw">
        <img src="/assets/kurtulus-bildirgesi/a4-yurttasa-mektup-bant-1600.jpg" srcset="/assets/kurtulus-bildirgesi/a4-yurttasa-mektup-bant-800.jpg 800w, /assets/kurtulus-bildirgesi/a4-yurttasa-mektup-bant-1600.jpg 1600w" sizes="(min-width:1100px) 1060px, 100vw" width="1600" height="686" alt="Kalabalığın içinde havaya kaldırılmış Türkiye İşçi Partisi atkısı; yanında “Yurttaşa Mektup” başlığı">
      </picture>
      <h1 class="a4-gizli" id="mektup-baslik">Yurttaşa Mektup</h1>
    </header>
    <div class="a4-metin">
      <p>Sevgili yurttaşımız,</p>
      <p>Her kim olursan ol, bu mektubu okuyorsan ya dertlisindir ya da öfkeli.</p>
      <p>Geçmişi, bugünü ve geleceği, kendini ve ülkeni düşünüp “Bunları hak etmedik” diyorsundur.</p>
      <p>Evet, sen bunu hak etmedin. Annen baban, varsa eşin, çocuğun bunları hak etmedi. Ülken, ülkemiz bu yaşadıklarımızı hak etmedi.</p>
      <p>Aslında çok şey de istememiştin.</p>
      <p>Düzgün bir iş, belki bir ev, evladına ücretsiz ve nitelikli eğitim, güvenli bir gelecek…</p>
      <p>Emekliysen onca yılda hak ettiğin, seni kimseye muhtaç etmeyecek bir ikramiye, bir maaş, sağlık hizmeti…</p>
      <p>Öğrenciysen çalışmaya mecbur olmadan okumak…</p>
      <p>Kimseye zarar vermeden, kimseye muhtaç olmadan, boyun eğmeden kendin gibi olabilmek…</p>
      <p>Belki senede iki kere de olsa konsere gidebilmek, fiyatını düşünmeden kitap alabilmek, sosyal medyada özgürce dolaşabilmek, bir parkta kafanı dinlemek…</p>
      <p>İstediğin partiye, adaya oy verebilmek. Oy verdiğin parti, aday kazandığında yönettiğini görebilmek…</p>
      <p class="a4-kirmizi">Sen milyonlarsın.</p>
      <p class="a4-kirmizi">Sen bu ülkeyi var edensin, onun temel direğisin. Emeğinle var ettiğin bu ülkede kimseye muhtaç olmadan, onurunla, kardeşçe yaşamayı sonuna kadar hak ediyorsun.</p>
      <p class="a4-kirmizi">Sen emeğinin karşılığını, hakkın olanı istedin.</p>
      <p>Gelgelelim, bir avuç tuzu kuruya hiçbir şey yetmedi.</p>
      <p>Torpilli işlere, ballı ihalelere, beşer onar evlere, arazilere, tapulara doyamadılar.</p>
      <p>Hesaplarındaki, sülalelerini doyuracak milyonlara rağmen emekçi çocukları için sunulan burslara bile çöktüler.</p>
      <p>Yetmedi; bankalardaki milyonlarını onlarca katına çıkarmak için yurttaşları fon tuzağına çekip resmen kazık attılar, insanların yılların emeğiyle biriktirdiklerini iç ettiler.</p>
      <p>Topraklar, en değerli işletmeler, okuduğun gazete, izlediğin kanal… Hepsi onların oldu.</p>
      <p class="a4-kirmizi">Doymadılar.</p>
      <p>Tüm bunları yaparken “vatan, millet, din, bayrak” edebiyatına sarılmaktan da vazgeçmediler.</p>
      <p>Bu ülke açgözlülüğün, riyakârlığın, halk düşmanlığının bu derecesini görmedi.</p>
      <p>Bu bir avuç arsız yüzünden burada, kendi yurdunda güvende hissetmeyi unuttun; biliyoruz.</p>
      <p>“Koruyup kollar”, “herkes için var”, “bu halka aittir” dedikleri devletin kapılarını sana tamamen kapattılar; farkındayız.</p>
      <p>Vatandaşlarının bütün birikimlerini hortumlayan, vurgunlarla, tarikatlarla, çetelerle, gazla copla ayakta duran bu kara düzen bir tarafta.</p>
      <p>Bu ülkeyi emeğiyle, onuruyla var eden sen ise bir taraftasın.</p>
      <p class="a4-kalin">O halde kara düzenin karşı tarafında olmanın hakkını verelim, gereğini yapalım.</p>
      <p class="a4-kalin">“Siyaset yapacaksan paran olacak, patronlarla aran iyi olacak, tarikatları karşına almayacak, Sarayın sınırlarını da fazla zorlamayacaksın” diyenlere kulak asmayalım.</p>
      <p class="a4-kalin">“Bu işler halkla olmaz; güçlülerin, zenginlerin, dışarıdaki büyük devletlerin onayı olmadan hiçbir şey değişmez” diyenlere inanmayalım.</p>
      <p class="a4-kalin">Halkı birbirine düşürüp sonra buna siyaset diyenlerin, hamaseti muhalefet diye sunanların peşinden gitmeyelim.</p>
      <p>Hiçbiri senin kira derdini, yakıt derdini, işten çıkarılmanı, maaşını, çocuğunun beslenmesini ve eğitimini, emekliliğini, toprağını, ormanını, geleceğini, dertlerini, hayallerini umursamıyor.</p>
      <p>Sen de artık bunun farkındasın: Önüne konan seçeneklerin hiçbiri sana gerçek bir çıkış sunmuyor.</p>
      <p>Tek adamdan da onun beslemelerinden de, muhalefet diye önüne konan sağcılıktan da kurtulmak istiyorsun.</p>
      <p>Çaresiz değilsin. Ülkeni, bugününü, geleceğini, haysiyetini kurtarmak senin elinde.</p>
      <p>Harekete geçmek için isminin ne olduğu önemli değil; yeter ki emeğini koy.</p>
      <p>Gel, bu Kurtuluş hareketinin, bu isimsizler hareketinin binlerce emekçisinden biri ol.</p>
      <p class="a4-son">Kurtuluş ellerimizde.</p>

    </div>
    <figure class="a4-foto">
      <picture>
        <source type="image/webp" srcset="/assets/kurtulus-bildirgesi/a4-yurttasa-mektup-foto-800.webp 800w, /assets/kurtulus-bildirgesi/a4-yurttasa-mektup-foto-1600.webp 1600w" sizes="(min-width:1100px) 1060px, 100vw">
        <img src="/assets/kurtulus-bildirgesi/a4-yurttasa-mektup-foto-1600.jpg" srcset="/assets/kurtulus-bildirgesi/a4-yurttasa-mektup-foto-800.jpg 800w, /assets/kurtulus-bildirgesi/a4-yurttasa-mektup-foto-1600.jpg 1600w" sizes="(min-width:1100px) 1060px, 100vw" width="1600" height="649" loading="lazy" alt="Bir eylemde megafonla slogan atan genç bir kadın">
      </picture>
    </figure>
  </article>

  <!-- ================= KURTULUŞ BİLDİRGESİ ================= -->
  <article class="a4" aria-labelledby="bildirge-baslik">
    <header class="a4-bant">
      <picture>
        <source type="image/webp" srcset="/assets/kurtulus-bildirgesi/a4-kurtulus-bildirgesi-bant-800.webp 800w, /assets/kurtulus-bildirgesi/a4-kurtulus-bildirgesi-bant-1600.webp 1600w" sizes="(min-width:1100px) 1060px, 100vw">
        <img src="/assets/kurtulus-bildirgesi/a4-kurtulus-bildirgesi-bant-1600.jpg" srcset="/assets/kurtulus-bildirgesi/a4-kurtulus-bildirgesi-bant-800.jpg 800w, /assets/kurtulus-bildirgesi/a4-kurtulus-bildirgesi-bant-1600.jpg 1600w" sizes="(min-width:1100px) 1060px, 100vw" width="1600" height="686" loading="lazy" alt="Koyu kırmızı zemin önünde yumruğunu kaldırmış bir insan silueti; yanında “Kurtuluş Bildirgesi” başlığı">
      </picture>
      <h2 class="a4-gizli" id="bildirge-baslik">Kurtuluş Bildirgesi</h2>
    </header>
    <div class="a4-metin">
      <p>Biz bu ülkenin emeğiyle geçinen yurttaşlarıyız.</p>
      <p>KURTULUŞUN yolunu açmak için bir araya geliyoruz.</p>
      <p>Ülkemizi, bütün birikimimizi gasp eden bir avuç arsızdan kurtaracağız.</p>
      <p>Doğayı, topraklarımızı, fabrikalarımızı, köprülerimizi satan, halkı satan ve sonunda kendini de satılığa çıkaran bu çürümüş siyasetten ülkemizi kurtaracağız.</p>
      <p>Saray’ın güdümündekileri, rejimin ufkundan ötesini göremeyenleri, memleket namına bir davası olmayanları, paraya ve menfaate tapanları reddediyoruz.</p>
      <p>Her daim düzenin ve gücün yanında olan ama iş hamasete gelince mangalda kül bırakmayan, rejimle sağcılık yarıştıran, sağa teslim olmuş siyaseti reddediyoruz.</p>
      <p class="a4-kirmizi">En ağır koşullarda üç kuruşa çalıştırılan emekçilerin,</p>
      <p class="a4-kirmizi">Isınmak için tren istasyonlarına sığınan emeklilerin,</p>
      <p class="a4-kirmizi">Okuldan çıkarılıp patrona teslim edilen çocuk işçilerin,</p>
      <p class="a4-kirmizi">Her gün bir kız kardeşi daha şiddete uğrayan kadınların,</p>
      <p class="a4-kirmizi">Toprağı, doğası vahşi madenciliğe peşkeş çekilen çiftçinin,</p>
      <p class="a4-kirmizi">Kiraya parası yetmeyen, ay sonunu getiremeyen, sürekli borçlanan, azıcık birikimi de çalınan tüm emekçilerin,</p>
      <p class="a4-kirmizi">Yani içinde yaşadığı ülke her gün biraz daha ellerinden kaymakta olan bu halkın artık bu siyasete “yeter” dediğini, memleketin sola, onun erdemine ve cesaretine su gibi ihtiyaç duyduğunu görüyoruz.</p>
      <p>Biz birbirimize güveniyoruz. Kurtuluşun ellerimizde olduğunu biliyoruz.</p>
      <p>Bu ülkede, “özel okul mu olur, tüm çocuklarımız ücretsiz, nitelikli, bilimsel eğitim alacak” diyen <em class="a4-kirmizi">birileri var.</em></p>
      <p>“Ücretsiz, nitelikli, yollarda ve sıralarda sürünmeden sağlık hizmeti sağlayacağız” diyen <em class="a4-kirmizi">birileri var.</em></p>
      <p>“Batsın sizin çocuk sömürünüz; MESEM’inizi kapatıp çocukları karınlarının doyduğu, güvenli okullara göndereceğiz” diyen <em class="a4-kirmizi">birileri var.</em></p>
      <p>“Her yere kreş açacağız, yaşlılar için bakım hizmeti sağlayacağız” diyen <em class="a4-kirmizi">birileri var.</em></p>
      <p>“10 tane, 100 tane eviniz olamaz, barınmayı servet biriktirme aracına çeviremezsiniz” diyen <em class="a4-kirmizi">birileri var.</em></p>
      <p>“Herkese iş güvencesi, herkese sendika güvencesi” diyen <em class="a4-kirmizi">birileri var.</em></p>
      <p>“Yeter Türk-Kürt-Alevi-Sünni ayrımcılığınız. Yeter insanların kime âşık olacağına karışmanız. Hepimiz eşit yurttaşlarız!” diyen <em class="a4-kirmizi">birileri var.</em></p>
      <p>“Kadın katillerini, çocuk katillerini, işçi katillerini affetmeyeceğiz” diyen <em class="a4-kirmizi">birileri var.</em></p>
      <p>“Dünyayı kana bulayan zorba ABD dostumuz filan değil” diyen <em class="a4-kirmizi">birileri var.</em></p>
      <p>“Yeter savaş ve düşmanlık sattığınız, biz barış istiyoruz” diyen <em class="a4-kirmizi">birileri var.</em></p>
      <p>Onlar ise ne zaman hakkımızı istesek “kaynağımız yok” diyorlar.</p>
      <p class="a4-koyu">Var. Üreten, çalışan insanımız var.</p>
      <p class="a4-koyu">Bilgimiz, birikimimiz, yaratıcı gençlerimiz var.</p>
      <p class="a4-koyu">Bu ülkeye sahip çıkacak milyonlarımız var.</p>
      <p>Eksik olan, bütün bunları halkın ortak ihtiyaçları için seferber edecek cesaret, irade ve siyasal ufuk.</p>
      <p>Mesele, elimizde olanı kimin için ve ne için kullanacağımıza karar verme gücünü, yani egemenliğimizi geri almak.</p>
      <p>Bizi kendimizden başkası kurtarmayacak.</p>
      <p>Artık kaybedecek bir günümüz dahi olmadığını bildiğimiz için, kimseyi arkamızda bırakmadan, kapı kapı gezip birbirimizi bularak, birliğimizi sağlamak için toplanıyoruz.</p>
      <p>Saraya direnen herkesle yol yürümeye hazırız.</p>
      <p class="a4-kirmizi">Derdimiz bu rejimle pazarlık değil mücadele diyorsanız, biz varız!</p>
      <p>Kentlerde, kasabalarda, mahallelerde, iş yerlerinde, okullarda nerede yaşamı var ediyorsak orada buluşuyoruz.</p>
      <p>Bulunduğumuz yerde dertlerimizi, ama mutlaka çözümlerimizi de konuşmak, temsilcilerimizi belirlemek, KURTULUŞ programımızı hep birlikte yazmak için bir araya geliyoruz.</p>
      <p>Birimiz diğerine üstün sayılmadan, eşitler olarak halkımız ve ülkemiz için bütünleşiyoruz.</p>
      <p>Çağrımız bu kara düzenden kurtulmak isteyen tüm yurttaşlarımızadır.</p>
      <p>Önceliği kendi siyasi ikbali değil, halk için bu rejimle mücadele etmek olan herkesi yan yana yürümeye çağırıyoruz.</p>
      <p>Gelin il il, mahalle mahalle buluşalım. Kurtuluşun yolunu birlikte açalım.</p>
      <p class="a4-slogan"><span>KURTULUŞ ELLERİMİZDE!</span><br><span>YA HEP BERABER YA HİÇBİRİMİZ!</span></p>

    </div>
    <figure class="a4-foto a4-foto--katil">
      <picture>
        <source type="image/webp" srcset="/assets/kurtulus-bildirgesi/a4-kurtulus-bildirgesi-foto-800.webp 800w, /assets/kurtulus-bildirgesi/a4-kurtulus-bildirgesi-foto-1600.webp 1600w" sizes="(min-width:1100px) 1060px, 100vw">
        <img src="/assets/kurtulus-bildirgesi/a4-kurtulus-bildirgesi-foto-1600.jpg" srcset="/assets/kurtulus-bildirgesi/a4-kurtulus-bildirgesi-foto-800.jpg 800w, /assets/kurtulus-bildirgesi/a4-kurtulus-bildirgesi-foto-1600.jpg 1600w" sizes="(min-width:1100px) 1060px, 100vw" width="1600" height="688" loading="lazy" alt="Türkiye İşçi Partisi mitinginde kırmızı ve mor bayraklarla kalabalık">
      </picture>
      <a class="kb-katil" href="https://tipekatil.tip.org.tr/">Mücadeleye sen de katıl <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </figure>
  </article>

    <div class="kb-son">
    <p class="kb-son-baslik">Bildirgeyi yay, kurtuluşun yolunu birlikte açalım</p>
    <div class="kb-paylas" aria-label="Paylaş">
