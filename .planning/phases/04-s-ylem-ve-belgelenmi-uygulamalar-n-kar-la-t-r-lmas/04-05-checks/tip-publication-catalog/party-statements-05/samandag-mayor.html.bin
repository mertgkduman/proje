                                            <li>
                            <button type="button" role="switch" @click="$store.a11y.toggle('images')" :aria-checked="!!$store.a11y.prefs.images"
                                    class="flex min-h-16 w-full items-center gap-3.5 px-4 py-3 text-left transition hover:bg-slate-50">
                                <span class="grid size-10 shrink-0 place-items-center rounded-xl transition" :class="$store.a11y.prefs.images ? 'bg-[#1d4ed8] text-white' : 'bg-slate-100 text-slate-700'"><svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
  <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88"/>
</svg></span>
                                <span class="flex-1"><span class="block font-semibold text-ink">Görselleri Gizle</span><span class="block text-xs text-slate-600">Görselleri gizler</span></span>
                                <span class="relative h-7 w-12 shrink-0 rounded-full transition" :class="$store.a11y.prefs.images ? 'bg-[#1d4ed8]' : 'bg-slate-300'" aria-hidden="true">
                                    <span class="absolute top-1 left-1 size-5 rounded-full bg-white shadow transition" :class="$store.a11y.prefs.images && 'translate-x-5'"></span>
                                </span>
                            </button>
                        </li>
                                    </ul>

                <button type="button" @click="$store.a11y.speaking ? $store.a11y.stop() : $store.a11y.speak()" :aria-pressed="$store.a11y.speaking"
                        class="flex min-h-16 w-full items-center gap-3.5 rounded-3xl px-4 py-3 text-left ring-1 transition"
                        :class="$store.a11y.speaking ? 'bg-[#1d4ed8] text-white ring-[#1d4ed8]' : 'bg-white text-ink ring-slate-200 hover:bg-slate-50'">
                    <span class="grid size-10 shrink-0 place-items-center rounded-xl" :class="$store.a11y.speaking ? 'bg-white/20' : 'bg-slate-100 text-slate-700'"><svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
  <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.009 9.009 0 0 1 2.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75Z"/>
</svg></span>
                    <span class="flex-1"><span class="block font-semibold" x-text="$store.a11y.speaking ? 'Okumayı Durdur' : 'Sayfayı Sesli Oku'"></span><span class="block text-xs opacity-80">Seçili metni veya sayfa içeriğini okur</span></span>
                </button>

                <div class="rounded-3xl bg-slate-50 p-4 text-sm text-slate-700 ring-1 ring-slate-200">
                    <p class="font-semibold text-ink">Klavye kısayolları</p>
                    <ul class="mt-2 space-y-1.5">
                        <li><kbd class="rounded-md bg-white px-1.5 py-0.5 font-mono text-xs ring-1 ring-slate-300">Tab</kbd> öğeler arasında gezinme</li>
                        <li><kbd class="rounded-md bg-white px-1.5 py-0.5 font-mono text-xs ring-1 ring-slate-300">Ctrl</kbd> + <kbd class="rounded-md bg-white px-1.5 py-0.5 font-mono text-xs ring-1 ring-slate-300">K</kbd> sitede arama</li>
                        <li><kbd class="rounded-md bg-white px-1.5 py-0.5 font-mono text-xs ring-1 ring-slate-300">Esc</kbd> pencereleri kapatma</li>
                    </ul>
                </div>
            </div>

            <div class="flex gap-2 border-t border-slate-100 p-4 pb-[calc(1rem+env(safe-area-inset-bottom))]">
                <button type="button" @click="$store.a11y.reset()" class="btn-light flex-1"><svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
  <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/>
</svg> Sıfırla</button>
                <a href="https://samandag.bel.tr/public/sayfa/erisilebilirlik" class="btn flex-1 bg-[#1d4ed8] text-white hover:bg-[#1e40af]">Beyanımız</a>
            </div>
        </div>
    </div>
</div>

    
    </body>
</html>
