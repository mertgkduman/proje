</svg>                <label for="site-search" class="sr-only">Aranacak kelime</label>
                <input id="site-search" x-ref="input" x-model="q" @input.debounce.250ms="run()" @keydown.down.prevent="move(1)" @keydown.up.prevent="move(-1)"
                       name="q" type="search" autocomplete="off" placeholder="Haber, duyuru, belge, hizmet ara..."
                       class="h-16 w-full border-0 bg-transparent text-lg text-slate-900 placeholder:text-slate-600 focus:ring-0 focus:outline-none">
                <span x-show="loading" class="size-5 animate-spin rounded-full border-2 border-brand-200 border-t-brand-600" aria-hidden="true"></span>
                <button type="button" @click="open = false" class="hidden rounded-lg bg-slate-100 px-2 py-1 text-xs font-bold text-slate-600 sm:block" aria-label="Kapat">ESC</button>
            </form>
            <div class="max-h-[60vh] overflow-y-auto p-2" aria-live="polite">
