                                                            <a href="https://samandag.bel.tr/public/duyurular" class="chip bg-slate-100 px-3.5 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-700">Duyurular</a>
                                                            <a href="https://samandag.bel.tr/public/meclis-kararlari" class="chip bg-slate-100 px-3.5 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-700">Meclis Kararları</a>
                                                            <a href="https://samandag.bel.tr/public/e-belediye" class="chip bg-slate-100 px-3.5 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-700">E-Belediye</a>
                                                            <a href="https://samandag.bel.tr/public/vefat-edenler" class="chip bg-slate-100 px-3.5 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-700">Vefat Edenler</a>
                                                            <a href="https://samandag.bel.tr/public/iletisim" class="chip bg-slate-100 px-3.5 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-700">İletişim</a>
                                                    </div>
                    </div>
                </template>
                <template x-for="(r, idx) in results" :key="r.url">
                    <a :href="r.url" class="flex items-center gap-3 rounded-2xl px-4 py-3 transition" :class="active === idx ? 'bg-brand-50' : 'hover:bg-slate-50'">
                        <span class="chip shrink-0 bg-brand-50 text-brand-800 ring-1 ring-brand-100" x-text="r.type"></span>
                        <span class="line-clamp-1 font-semibold text-slate-800" x-text="r.title"></span>
                    </a>
                </template>
                <template x-if="q.trim().length >= 2 && !loading && results.length === 0">
                    <p class="p-6 text-center text-slate-600">Sonuç bulunamadı. <button type="button" @click="go()" class="font-semibold text-brand-700 underline">Tüm sitede ara</button></p>
                </template>
                <template x-if="results.length">
                    <button type="button" @click="go()" class="mt-1 w-full rounded-2xl px-4 py-3 text-left text-sm font-semibold text-brand-700 hover:bg-brand-50">Tüm sonuçları gör →</button>
