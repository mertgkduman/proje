    <template x-teleport="body">
        <div x-show="drawer" x-cloak class="fixed inset-0 z-[70] xl:hidden" role="dialog" aria-modal="true" aria-label="Menü" id="mobile-drawer"
             @keydown.escape.window="drawer = false" x-effect="document.body.style.overflow = drawer ? 'hidden' : ''">
            <div x-show="drawer" x-transition.opacity class="absolute inset-0 bg-ink/60 backdrop-blur-sm" @click="drawer = false"></div>
            <div x-show="drawer" x-trap.noscroll="drawer"
                 x-transition:enter="transition ease-out duration-300" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0"
                 x-transition:leave="transition ease-in duration-200" x-transition:leave-end="translate-x-full"
                 class="absolute inset-y-0 right-0 flex w-full max-w-md flex-col overflow-hidden bg-white text-ink shadow-2xl">
                <div class="pattern-dots pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
                <div class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-brand-200/60 blur-3xl" aria-hidden="true"></div>
                <div class="relative flex items-center justify-between px-5 py-4">
                    <span class="logo-mask block aspect-[529/133] h-10 bg-gradient-to-r from-brand-700 to-sand-600" style="--logo: url('https://samandag.bel.tr/public/storage/upload/site/yatay-beyaz-logo.svg')" role="img" aria-label="Samandağ Belediyesi"></span>                    <button type="button" @click="drawer = false" class="grid size-11 place-items-center rounded-full bg-mist ring-1 ring-slate-200" aria-label="Menüyü kapat"><svg class="size-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
</svg></button>
                </div>
                <nav class="relative flex-1 overflow-y-auto px-4 pb-6" aria-label="Mobil menü">
                    <a href="https://samandag.bel.tr/public" class="flex min-h-14 items-center rounded-2xl px-4 font-display text-2xl font-semibold">Anasayfa</a>
                                                                        <div x-data="{ o: true }">
                                <button type="button" @click="o = !o" :aria-expanded="o" class="flex min-h-14 w-full items-center justify-between rounded-2xl px-4 text-left font-display text-2xl font-semibold" :class="o && 'bg-mist'">
                                    Başkan
                                    <span class="grid size-9 place-items-center rounded-full bg-mist transition" :class="o && 'rotate-180 !bg-brand-600 text-white'"><svg class="size-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-slot="icon">
  <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
</svg></span>
