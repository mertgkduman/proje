    padding:.3rem .6rem; border-radius:10px; border:1px solid rgba(0,0,0,.06); background:#fff;
  }
  .cat-link:hover{ background:#ffecee; border-color:#e43442; color:#c2202c; }
  .meta-top .date-pill{
    background:#e43442; color:#fff; padding:4px 10px; font-size:.8rem; border-radius:999px;
    font-weight:800; line-height:1;
  }
  .type-chip{
    display:inline-flex; align-items:center; gap:.35rem;
    padding:.25rem .55rem; border-radius:999px; font-weight:800; font-size:.78rem;
    border:1px solid #ddd; background:#fafafa; color:#111;
  }
  .type-video{ border-color:#ffc9c9; background:#fff5f5; }
  .type-pdf{   border-color:#ffd7cc; background:#fff2ed; }

  /* Paylaş butonu + popover */
  .meta-share-btn{
    display:inline-flex; align-items:center; justify-content:center;
    width:34px; height:34px; border-radius:999px; border:1px solid #e6e6e6;
    background:#fff; color:#111; cursor:pointer;
    transition:background .15s ease, box-shadow .15s ease, transform .12s ease;
  }
  .meta-share-btn:hover{ background:#f6f6f6; }
  .meta-share-btn:active{ transform:scale(.98); }

  /* ÖNEMLİ: fixed konum + yüksek z-index + taşmaya karşı max-height */
  .share-popover{
    position:fixed; /* absolute yerine fixed */
    right:auto; top:auto; left:0; /* JS ile ayarlanacak */
    background:#fff; border:1px solid #e9e9e9; border-radius:12px; box-shadow:0 12px 32px rgba(0,0,0,.12);
    padding:8px; min-width:220px; max-width:92vw; max-height:60vh; overflow:auto;
    display:none; z-index:2000; /* yükseltildi */
  }
  .share-popover[aria-hidden="false"]{ display:block; }
  .share-popover a, .share-popover .copy-link-btn{
    display:flex; align-items:center; gap:.5rem;
    width:100%; padding:8px 10px; border-radius:10px; text-decoration:none; color:#111; border:0; background:transparent; cursor:pointer;
    font-weight:600;
  }
  .share-popover a:hover, .share-popover .copy-link-btn:hover{ background:#f7f7f7; }
  .share-popover i{ width:18px; text-align:center; }

  /* Başlık */
  .post-title{
    font-weight:900; line-height:1.22; margin:.25rem 0 .4rem; font-size:1.9rem;
  }
  .post-title-row{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:.8rem;
    flex-wrap:wrap;
    margin-bottom:.35rem;
  }
  .title-open-link{
    margin-left:auto;
    white-space:nowrap;
  }
  @media (min-width:992px){ .post-title{ font-size:2.2rem; } }
  @media (max-width:576px){ .post-title{ font-size:1.6rem; } }

  /* Etiketler */
  .tags-row{ display:flex; flex-wrap:wrap; gap:.35rem .35rem; margin-bottom:.6rem; }
  .tag-chip{
    display:inline-flex; align-items:center; gap:.35rem;
    padding:.35rem .6rem; font-weight:800; font-size:.78rem; border-radius:999px;
    background:#fff; color:#e43442; border:1px solid rgba(228,52,66,.35); text-decoration:none;
  }
  .tag-chip:hover{ background:#ffecee; border-color:#e43442; color:#c2202c; }

  /* İçerik */
  .object-cover{width:100%;height:100%;object-fit:cover;display:block;}
  .post-content{ font-size:1.02rem; }
  .post-content p{ line-height:1.75; margin-bottom:1rem; color:#111; }
  .post-content h2,.post-content h3{ font-weight:800; margin:1.25rem 0 .5rem; }
  .post-content img.content-img{
    display:block; width:100%; height:auto; max-width:100%;
    border-radius:12px; margin: .6rem 0;
  }
  .post-content a{ color:#000; text-decoration:underline; text-underline-offset:2px; }
  .post-content a:hover{ color:#111; text-decoration-thickness:2px; }

  /* Benzer içerikler */
  .sidebar-heading{ font-size:.78rem; letter-spacing:.04em; text-transform:uppercase; color:#6c757d; font-weight:700; }
  .sidebar-divider{ height:2px; background:rgba(228,52,66,.35); border-radius:2px; }
  .similar-list{ display:flex; flex-direction:column; gap:.6rem; }
  .similar-mini{
    display:flex; align-items:flex-start; gap:.7rem; text-decoration:none; color:#000;
    padding:.3rem .25rem; border-radius:.5rem; transition:background .12s ease, transform .12s ease;
  }
  .similar-mini:hover{ background:#f8f9fa; transform:translateX(2px); }
  .similar-mini-thumb{ width:56px; height:56px; border-radius:10px; overflow:hidden; flex:0 0 auto; background:#f2f2f2; }
  .similar-mini-thumb img{ width:100%; height:100%; object-fit:cover; display:block; }
  .similar-mini-body{ display:flex; flex-direction:column; line-height:1.35; min-width:0; }
  .similar-mini-title{ display:block; font-weight:600; font-size:.95rem; color:#111; text-transform:uppercase; }
  .similar-mini-date{ display:block; margin-top:.15rem; font-size:.78rem; color:#666; }

  /* === PDF Görüntüleyici === */
  #pdfCarousel .carousel-item img { max-height: 90vh; object-fit: contain; background:#f3f4f6; cursor: zoom-in; }
  #pdfCarousel .carousel-control-prev,
  #pdfCarousel .carousel-control-next{
    width:58px;
    opacity:1;
  }
  .pdf-stage-wrap{ position:relative; }
  .page-counter-float{
    position:absolute;
    top:10px;
    right:10px;
    z-index:5;
    background:rgba(0,0,0,.82);
    color:#fff;
    border:1px solid rgba(255,255,255,.25);
    border-radius:999px;
    padding:.25rem .62rem;
    font-weight:800;
    box-shadow:0 8px 18px rgba(0,0,0,.28);
  }
  #pdfCarousel .carousel-control-prev-icon,
  #pdfCarousel .carousel-control-next-icon{
    width:46px;
    height:46px;
    border-radius:999px;
    background-color:rgba(0,0,0,.82);
    background-size:45% 45%;
    box-shadow:0 10px 22px rgba(0,0,0,.34), 0 0 0 1px rgba(255,255,255,.25) inset;
  }
  #pdfCarousel .carousel-control-prev:hover .carousel-control-prev-icon,
  #pdfCarousel .carousel-control-next:hover .carousel-control-next-icon{
    background-color:rgba(0,0,0,.92);
  }
  .page-pager{
    display:flex; gap:.25rem; overflow-x:auto; padding:.15rem; border-radius:.5rem; background:#f8f9fa; border:1px solid #eee;
    max-width:100%; scrollbar-width:thin;
  }
  .page-pill{ border:1px solid #dcdcdc; background:#fff; color:#111; padding:.25rem .5rem; border-radius:.5rem; font-weight:700; line-height:1; cursor:pointer; }
  .page-pill.active{ border-color:#273248; background:#e6e9f3; color:#273248; }

  .reader{ position:fixed; inset:0; background:rgba(0,0,0,.9); display:flex; flex-direction:column; z-index:1090; }
  .reader.hidden{ display:none; }
  .reader-toolbar{ display:flex; align-items:center; gap:.5rem; padding:.5rem; background:rgba(0,0,0,.4); position:sticky; top:0; z-index:3; }
  .rbtn{ border:1px solid rgba(255,255,255,.25); color:#fff; background:transparent; border-radius:.5rem; padding:.35rem .6rem; font-weight:800; cursor:pointer; }
  .rbtn:hover{ background:rgba(255,255,255,.08); }
  .rbtn.rclose{ margin-left:auto; font-size:1.25rem; padding:.25rem .6rem; }
  .reader-middle{ display:flex; align-items:center; gap:.35rem; margin-inline:auto; }
  .reader-counter{ color:#fff; font-weight:700; margin-left:.35rem; }
  .reader-stage{ position:relative; flex:1; overflow:hidden; display:flex; align-items:center; justify-content:center; touch-action:none; }
  #readerImg{ max-width:95vw; max-height:92vh; transform-origin:center center; cursor:grab; }
  .reader-open { overflow:hidden; }
  .reader-nav{ position:fixed; top:50%; transform:translateY(-50%); width:56px; height:56px; border-radius:50%; border:1px solid rgba(255,255,255,.3); background:rgba(0,0,0,.35); color:#fff; font-size:26px; font-weight:800; display:flex; align-items:center; justify-content:center; z-index:4; cursor:pointer; }
  .reader-left{ left:12px; } .reader-right{ right:12px; } .reader-nav:active{ transform:translateY(-50%) scale(.98); }

  /* PDF iFrame fallback */
  .pdf-shell{ display:flex; flex-direction:column; gap:.75rem; }
  .pdf-frame-wrap{ position:relative; border:1px solid #eee; border-radius:.9rem; overflow:hidden; background:#fff; box-shadow:0 10px 28px rgba(0,0,0,.08); }
  .pdf-frame{ width:100%; height:120vh; border:0; background:#f3f4f6; }
  .pdf-loading{
    position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.75rem;
    background:linear-gradient(180deg, rgba(255,255,255,.92), rgba(255,255,255,.86)); backdrop-filter:saturate(1.2) blur(2px); z-index:2;
  }
  .loading-text{ font-weight:800; letter-spacing:.02em; color:#111; }
  .spinner{ width:38px; height:38px; border-radius:50%; border:3px solid rgba(0,0,0,.12); border-top-color:#273248; animation:spin 1s linear infinite; }
  @keyframes spin{ to { transform:rotate(360deg);} }


  /* Modern "PDF Olarak Oku" butonu */
  .pdf-read-btn{
    display:inline-flex; align-items:center; gap:.5rem;
    border:1px solid rgba(0,0,0,.08);
    background:linear-gradient(135deg, #111 0%, #2b2b2b 50%, #111 100%);
    color:#fff;
    padding:.52rem .82rem;
    border-radius:999px;
    font-weight:900;
    letter-spacing:.01em;
    box-shadow:0 10px 26px rgba(0,0,0,.14);
    transition:transform .12s ease, box-shadow .15s ease, filter .15s ease;
    white-space:nowrap;
  }
  .pdf-read-btn i{ font-size:.95em; }
  .pdf-read-btn:hover{ filter:brightness(1.06); box-shadow:0 12px 30px rgba(0,0,0,.18); }
  .pdf-read-btn:active{ transform:scale(.985); }
  .pdf-open-link{
    display:inline-flex;
    align-items:center;
    gap:.4rem;
    border:1px solid #d3d8de;
    color:#273248;
    background:#fff;
    border-radius:999px;
    padding:.52rem .82rem;
    font-size:.84rem;
    font-weight:800;
    text-decoration:none;
  }
  .pdf-open-link:hover{ background:#f3f6fb; color:#111; }

  /* ✅ PDF Önizleme Overlay (iframe) */
  .pdf-overlay{
    position:fixed; inset:0;
    background:rgba(0,0,0,.88);
    z-index:1200;
    display:flex; flex-direction:column;
  }
  .pdf-overlay.hidden{ display:none; }
  .pdf-overlay-toolbar{
    display:flex; align-items:center; justify-content:space-between;
    padding:.55rem .65rem;
    background:rgba(0,0,0,.45);
    border-bottom:1px solid rgba(255,255,255,.12);
    backdrop-filter:saturate(1.2) blur(4px);
  }
  .pdf-overlay-title{
    display:flex; align-items:center; gap:.5rem;
    color:#fff; font-weight:900; letter-spacing:.02em;
  }
  .pdf-overlay-actions{ display:flex; align-items:center; gap:.45rem; }
  .pbtn{
    display:inline-flex; align-items:center; justify-content:center;
    width:40px; height:40px;
    border-radius:12px;
    border:1px solid rgba(255,255,255,.18);
    background:rgba(255,255,255,.06);
    color:#fff;
    font-weight:900;
    cursor:pointer;
    text-decoration:none;
    transition:background .15s ease, transform .12s ease;
  }
  .pbtn:hover{ background:rgba(255,255,255,.10); }
  .pbtn:active{ transform:scale(.98); }
  .pbtn-close{ font-size:1.25rem; line-height:1; }
  .pbtn-link i{ font-size:.95rem; }

  .pdf-overlay-body{
    position:relative;
    flex:1;
    padding:.65rem;
  }
  .pdf-overlay-frame{
    width:100%;
    height:100%;
    border:0;
    border-radius:16px;
    background:#f3f4f6;
    box-shadow:0 18px 42px rgba(0,0,0,.22);
  }
  .pdf-overlay-loading{
    position:absolute; inset:.65rem;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.75rem;
    border-radius:16px;
    background:linear-gradient(180deg, rgba(255,255,255,.92), rgba(255,255,255,.86));
    z-index:2;
  }
  .pdf-inline-nav,
  .pdf-overlay-nav{
    position:absolute; top:50%; transform:translateY(-50%);
    width:44px; height:44px; border-radius:999px;
    border:1px solid rgba(255,255,255,.45) !important;
    background:rgba(0,0,0,.82) !important;
    color:#fff !important;
    font-size:22px; font-weight:800; z-index:3; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 10px 22px rgba(0,0,0,.38), 0 0 0 1px rgba(0,0,0,.25) inset;
    backdrop-filter:blur(2px);
  }
  .pdf-inline-nav.left, .pdf-overlay-nav.left{ left:10px; }
  .pdf-inline-nav.right, .pdf-overlay-nav.right{ right:10px; }
  .pdf-inline-page,
  .pdf-overlay-page{
    position:absolute; left:50%; transform:translateX(-50%);
    bottom:12px; z-index:3; background:rgba(255,255,255,.92); border:1px solid rgba(0,0,0,.12);
    border-radius:999px; padding:.22rem .6rem; font-size:.78rem; font-weight:800; color:#273248;
  }
  .pdf-usage-note{
    margin:.65rem 0 .1rem;
    display:flex;
    align-items:flex-start;
    gap:.55rem;
    padding:.72rem .82rem;
    border-radius:.72rem;
    border:1px solid rgba(39,50,72,.22);
    background:linear-gradient(180deg, #f6f8fc 0%, #eef2f8 100%);
    color:#2f3e5a;
    font-size:.86rem;
    line-height:1.45;
    font-weight:700;
  }
  .pdf-usage-note i{
    margin-top:.08rem;
    color:#273248;
    font-size:.95rem;
    flex:0 0 auto;
  }

  /* ====== VIDEO: Mobilde tam ekran (inline) / Masaüstünde 16:9 ====== */
  .video-embed { position: relative; width: 100%; border-radius: 14px; overflow: hidden; background:#000; box-shadow:0 10px 28px rgba(0,0,0,.12); }
  .video-embed iframe{ position:absolute; inset:0; width:100%; height:100%; border:0; display:block; }
  @media (min-width: 768px){ .ratio-16x9-desktop { padding-top:56.25%; } }
  /* ====== VIDEO: Mobilde kare (1:1) / Masaüstünde 16:9 ====== */
  @media (max-width: 767.98px){
    .video-embed-shell{
      margin-left: 0;
      transform: none;
      width: 100%;
    }
    .ratio-16x9-desktop{
      padding-top: 100%;
      height: auto;
      border-radius: 14px;
      box-shadow: 0 10px 28px rgba(0,0,0,.12);
    }
    .title-open-link{ margin-left:0; }
    .reader-toolbar{
      flex-wrap:wrap;
      align-items:flex-start;
      row-gap:.4rem;
    }
    .reader-middle{
      order:3;
      width:100%;
      margin-inline:0;
      justify-content:center;
    }
    #btnFit{
      order:-1;
      margin-right:auto;
    }
  }

  /* İçerik içi görsel dots (yalnızca PDF’te JS ile eklenecek, CSS global kalabilir) */
  .content-dots{
    display:flex; gap:.35rem; justify-content:center; margin:.4rem 0 .8rem;
  }
  .content-dots .dot{
    width:10px; height:10px; border-radius:50%; border:none; background:#ddd; cursor:pointer;
    transition:transform .12s ease, background .12s ease;
  }
  .content-dots .dot.active{ background:#e43442; transform:scale(1.1); }

  /* 404 butonları uyumu */
  .btn-tip { background:#e43442; color:#fff; border-color:#e43442; }
  .btn-tip:hover { color:#fff; filter:brightness(.95); }
</style>

<script>
(function(){
  // >>> Buradan kontrol: Sadece PDF içeriklerde galeri/önizleme scriptleri aktif olsun
  const IS_PDF = false;

  /* Görsel galeri (içerik içi) — SADECE PDF */
  if (IS_PDF) {
    const content = document.getElementById('postContent');
    if (content){
      const imgs = Array.from(content.querySelectorAll('img.content-img'));
      if (imgs.length > 1){
        const dots = document.createElement('div');
        dots.className = 'content-dots';
        imgs.forEach((_,i)=>{
          const b = document.createElement('button');
          b.type='button'; b.className = 'dot' + (i===0?' active':'');
          b.setAttribute('aria-label','Görsel '+(i+1));
          b.addEventListener('click', ()=>go(i));
          dots.appendChild(b);
        });
        content.appendChild(dots);

        let idx = 0, startX=0, deltaX=0, dragging=false;
        function update(){
          imgs.forEach((im,i)=>{ im.style.display = (i===idx)?'block':'none'; });
          dots.querySelectorAll('.dot').forEach((d,i)=> d.classList.toggle('active', i===idx));
        }
        function go(i){ idx = Math.max(0, Math.min(imgs.length-1, i)); update(); imgs[idx].scrollIntoView({behavior:'smooth', block:'center'}); }
        function next(){ go(idx+1); } function prev(){ go(idx-1); }
        update();
        document.addEventListener('keydown', e=>{ if (e.key==='ArrowRight') next(); else if (e.key==='ArrowLeft') prev(); });
        content.addEventListener('pointerdown', e=>{ dragging=true; startX=e.clientX; deltaX=0; }, {passive:true});
        content.addEventListener('pointermove', e=>{ if(!dragging) return; deltaX=e.clientX-startX; }, {passive:true});
        content.addEventListener('pointerup',   ()=>{ if(!dragging) return; dragging=false; if(Math.abs(deltaX)>40){ deltaX<0?next():prev(); } }, {passive:true});
      }
    }
  }
  // <<< SADECE PDF

  /* PDF carousel + tam ekran okuyucu (zaten sadece PDF bloğunda DOM var; yine de korunur) */
  const $  = (s, r=document)=>r.querySelector(s);
  const $$ = (s, r=document)=>Array.from(r.querySelectorAll(s));
  const carouselEl = $('#pdfCarousel');
  if (carouselEl){
    let carousel;
    try { carousel = new bootstrap.Carousel(carouselEl, { interval:false, ride:false, touch:true, pause:false }); } catch(e){}
    const pageNoEl = $('#pageNo');
    const pager = $('#pagePager');
    const items = $$('.carousel-item', carouselEl);
    const imgs  = $$('.page-img', carouselEl);
    const reader = $('#readerOverlay');
    const readerImg = $('#readerImg');
    const total = items.length;

    function updatePager(activeIndex){
      if (pageNoEl) pageNoEl.textContent = (activeIndex+1);
      const pills = $$('.page-pill', pager||document.createElement('div'));
      pills.forEach((b,i)=> b.classList.toggle('active', i===activeIndex));
      const activePill = pills[activeIndex];
      if (activePill && pager) pager.scrollTo({ left: Math.max(0, activePill.offsetLeft - 40), behavior: 'smooth' });
    }
    carouselEl.addEventListener('slid.bs.carousel', e=>{
      const idx = items.indexOf(e.relatedTarget);
      updatePager(idx);
      if (reader && !reader.classList.contains('hidden')) setReaderIndex(idx);
    });
    updatePager(0);

    pager && pager.addEventListener('click', (e)=>{
      const btn = e.target.closest('.page-pill'); if(!btn) return;
      const to = parseInt(btn.getAttribute('data-bs-slide-to'),10);
      if (!Number.isNaN(to)) carousel?.to(to);
    });

    const srcs = imgs.map(i => i.getAttribute('src'));
    let rIndex=0, scale=1, panX=0, panY=0;
    function setReaderIndex(i){
      rIndex = Math.max(0, Math.min(total-1, i));
      if (readerImg) readerImg.setAttribute('src', srcs[rIndex]);
      const readerCounter = $('#readerCounter');
      if (readerCounter) readerCounter.textContent = (rIndex+1) + ' / ' + total;
      resetTransform();
    }
    function resetTransform(){ scale=1; panX=0; panY=0; applyTransform(); }
    function applyTransform(){ if(readerImg) readerImg.style.transform = `translate(${panX}px,${panY}px) scale(${scale})`; }
    function next(){ setReaderIndex(rIndex+1); }
    function prev(){ setReaderIndex(rIndex-1); }

    async function openReader(i){
      if (!reader) return;
      setReaderIndex(i);
      reader.classList.remove('hidden');
      reader.setAttribute('aria-hidden','false');
      document.documentElement.classList.add('reader-open');
      try { await reader.requestFullscreen?.(); } catch(_){}
    }
    async function closeReader(){
      if (!reader) return;
      reader.classList.add('hidden');
      reader.setAttribute('aria-hidden','true');
      document.documentElement.classList.remove('reader-open');
      if (document.fullscreenElement) { try { await document.exitFullscreen(); } catch(_){ } }
    }

    $$('.page-img', carouselEl).forEach(img => img.addEventListener('click', ()=>{
      const idx=parseInt(img.dataset.index,10)||0; openReader(idx);
    }));
    $('#btnClose')?.addEventListener('click', closeReader);
    $('#btnPrev')?.addEventListener('click', prev);
    $('#readerLeft')?.addEventListener('click', prev);
    $('#readerRight')?.addEventListener('click', next);
    $('#btnZoomIn')?.addEventListener('click', ()=> { scale = Math.min(5, scale*1.25); applyTransform(); });
    $('#btnZoomOut')?.addEventListener('click', ()=> { scale = Math.max(0.5, scale*0.8); applyTransform(); });
    $('#btnFit')?.addEventListener('click', resetTransform);
    $('#btnFs')?.addEventListener('click', async ()=>{
      if (document.fullscreenElement) { try { await document.exitFullscreen(); } catch(_){ } }
      else { try { await $('#readerOverlay').requestFullscreen?.(); } catch(_){ } }
    });

    let startX=0, deltaX=0, dragging=false; const threshold=40;
    carouselEl.addEventListener('pointerdown', e=>{ dragging=true; startX=e.clientX; deltaX=0; });
    carouselEl.addEventListener('pointermove', e=>{ if(!dragging) return; deltaX=e.clientX-startX; });
    carouselEl.addEventListener('pointerup', ()=>{ if(!dragging) return; dragging=false; if(Math.abs(deltaX)>threshold){ deltaX<0?carousel?.next():carousel?.prev(); } });
  }

  /* PDF iframe loader (sayfa içi fallback iframe için) */
  (function(){
    var frame = document.getElementById('pdfFrame');
    var wrap = frame ? frame.closest('.pdf-frame-wrap') : null;
    var overlay = document.getElementById('pdfLoading');
    var btnPrev = document.getElementById('pdfInlinePrev');
    var btnNext = document.getElementById('pdfInlineNext');
    var pageNo  = document.getElementById('pdfInlinePageNo');
    if (!frame || !overlay) return;
    var inlinePage = 1;
    var inlineBase = "";
    function inlineSrc(p){
      return inlineBase + '#page=' + p + '&view=fitH&toolbar=1&navpanes=0';
    }
    function setInlinePage(p){
      inlinePage = Math.max(1, p|0);
      frame.src = inlineSrc(inlinePage);
      if (pageNo) pageNo.textContent = 'Sayfa ' + inlinePage;
      overlay.style.display='flex';
      overlay.style.opacity='1';
      overlay.style.pointerEvents='auto';
    }
    function hideOverlay(){
      overlay.style.opacity='0'; overlay.style.pointerEvents='none';
      setTimeout(()=>overlay.style.display='none', 250);
    }
    frame.addEventListener('load', hideOverlay, {once:false});
    btnPrev && btnPrev.addEventListener('click', ()=> setInlinePage(inlinePage - 1));
    btnNext && btnNext.addEventListener('click', ()=> setInlinePage(inlinePage + 1));
    if (wrap) {
      var sX = 0, sY = 0;
      wrap.addEventListener('touchstart', function(e){
        if (!e.touches || !e.touches[0]) return;
        sX = e.touches[0].clientX;
        sY = e.touches[0].clientY;
      }, {passive:true});
      wrap.addEventListener('touchend', function(e){
        if (!e.changedTouches || !e.changedTouches[0]) return;
        var eX = e.changedTouches[0].clientX;
        var eY = e.changedTouches[0].clientY;
        var dx = eX - sX;
        var dy = eY - sY;
        if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy)) {
          setInlinePage(inlinePage + (dx < 0 ? 1 : -1));
        }
      }, {passive:true});
    }
    setInlinePage(1);
    setTimeout(()=>{ if(overlay && overlay.style.display!=='none') hideOverlay(); }, 10000);
  })();

  /* ✅ PDF "PDF olarak oku" — overlay içinde PDF önizleme (iframe) */
  (function(){
    if (!IS_PDF) return;

    const pdfUrl = "";
    const btnId  = "";

    const btn   = btnId ? document.getElementById(btnId) : null;
    const ov    = document.getElementById('pdfOverlay');
    const frame = document.getElementById('pdfOverlayFrame');
    const load  = document.getElementById('pdfOvLoading');
    const close = document.getElementById('pdfOvClose');
    const fsBtn = document.getElementById('pdfOvFs');
    const ovPrev = document.getElementById('pdfOvPrev');
    const ovNext = document.getElementById('pdfOvNext');
    const ovPageNo = document.getElementById('pdfOvPageNo');
    const ovBody = ov ? ov.querySelector('.pdf-overlay-body') : null;

    if (!btn || !ov || !frame || !pdfUrl) return;

    let srcSet = false;
    let ovPage = 1;
    function overlaySrc(p){
      return pdfUrl + '#page=' + p + '&view=fitH&toolbar=1&navpanes=0';
    }
    function setOverlayPage(p){
      ovPage = Math.max(1, p|0);
      frame.src = overlaySrc(ovPage);
      if (ovPageNo) ovPageNo.textContent = 'Sayfa ' + ovPage;
    }

    function showLoading(){
      if (!load) return;
      load.style.display = 'flex';
      load.style.opacity = '1';
      load.style.pointerEvents = 'auto';
    }
    function hideLoading(){
      if (!load) return;
      load.style.opacity='0';
      load.style.pointerEvents='none';
      setTimeout(()=>{ if(load) load.style.display='none'; }, 250);
    }

    function openOverlay(){
      ov.classList.remove('hidden');
      ov.setAttribute('aria-hidden','false');
      document.documentElement.classList.add('reader-open'); // scroll kilidi için aynı sınıf

      // src’yi ilk açılışta set et (performans)
      if (!srcSet){
        showLoading();
        setOverlayPage(1);
        srcSet = true;
      } else {
        // tekrar açılışta kısa loading göstermeyelim
        hideLoading();
      }
    }

    async function closeOverlay(){
      ov.classList.add('hidden');
      ov.setAttribute('aria-hidden','true');
      document.documentElement.classList.remove('reader-open');
      if (document.fullscreenElement) { try { await document.exitFullscreen(); } catch(_){ } }
    }

    btn.addEventListener('click', (e)=>{
      e.preventDefault();
      e.stopPropagation();
      openOverlay();
    });

    close?.addEventListener('click', closeOverlay);

    // overlay dışına tıklayınca kapat (toolbar/body içi hariç)
    ov.addEventListener('click', (e)=>{
      const t = e.target;
      if (t === ov) closeOverlay();
    });

    document.addEventListener('keydown', (e)=>{
      if (e.key === 'Escape' && ov.getAttribute('aria-hidden') === 'false') closeOverlay();
    });

    fsBtn?.addEventListener('click', async ()=>{
      try{
        if (document.fullscreenElement) await document.exitFullscreen();
        else await ov.requestFullscreen?.();
      }catch(_){}
    });
    ovPrev?.addEventListener('click', ()=>{ showLoading(); setOverlayPage(ovPage - 1); });
    ovNext?.addEventListener('click', ()=>{ showLoading(); setOverlayPage(ovPage + 1); });
    if (ovBody) {
      let sX = 0, sY = 0;
      ovBody.addEventListener('touchstart', (e)=>{
        if (!e.touches || !e.touches[0]) return;
        sX = e.touches[0].clientX;
        sY = e.touches[0].clientY;
      }, {passive:true});
      ovBody.addEventListener('touchend', (e)=>{
        if (!e.changedTouches || !e.changedTouches[0]) return;
        const eX = e.changedTouches[0].clientX;
        const eY = e.changedTouches[0].clientY;
        const dx = eX - sX;
        const dy = eY - sY;
        if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy)) {
          showLoading();
          setOverlayPage(ovPage + (dx < 0 ? 1 : -1));
        }
      }, {passive:true});
    }

    frame.addEventListener('load', hideLoading, { once:false });
  })();

  /* ===========================
     YouTube — Ses Açma & Tam Ekran
     =========================== */
  (function(){
    var frameId = "";
    if (!frameId) return;
    var frame = document.getElementById(frameId);
    if (!frame) return;

    // Kullanıcı etkileşimini yakalayıp kısa süre işaretli tut (unMute izni için)
    var hadUserGesture = false, gestureTimer;
    ['click','touchstart','keydown'].forEach(function(ev){
      document.addEventListener(ev, function(){
        hadUserGesture = true;
        clearTimeout(gestureTimer);
        gestureTimer = setTimeout(function(){ hadUserGesture = false; }, 3000);
      }, {capture:true, passive:true});
    });

    // Iframe API yükle
    var apiTag = document.createElement('script');
    apiTag.src = "https://www.youtube.com/iframe_api";
    document.head.appendChild(apiTag);

    var player;
    window.onYouTubeIframeAPIReady = function(){
      player = new YT.Player(frameId, {
        events: {
          onReady: function(e){
            // Autoplay muted başlar; görünürse oynatmayı deneyelim
            try { e.target.playVideo(); } catch(_){}
          },
          onStateChange: function(e){
            // Kullanıcı Play'e bastığında PLAYING durumuna geçer
            if (e.data === YT.PlayerState.PLAYING) {
              if (player.isMuted() && hadUserGesture) {
                try {
                  player.unMute();
                  player.setVolume(100);
                } catch(_) {}
              }
            }
          }
        }
        // playerVars URL’de zaten verildi (controls=1, fs=1, vb.)
      });
    };
  })();

  /* Paylaş butonu davranışı (KAYMA YOK: fixed konum + viewport bazlı ölçüm) */
  (function(){
    const btn   = document.getElementById("shareBtn_253");
    const menu  = document.getElementById('shareMenu');
    if (!btn || !menu) return;

    const pageTitle = "6-7 Nisan 2024 Tarihli Parti Meclisi Değerlendirmesi";
    const pageUrl   = "https:\/\/tip.org.tr\/myk-ve-parti-meclisi\/parti-meclisi-degerlendirmesi-6-7-nisan-2024";

    function tryWebShare(){
      if (navigator.share){
        navigator.share({ title: pageTitle || document.title, url: pageUrl })
          .catch(()=>{ toggleMenu(true); }); // kullanıcı paylaşımı iptal ederse fallback göster
        return true;
      }
      return false;
    }

    function placeMenu(){
      const prevDisplay = menu.style.display;
      const prevVis     = menu.style.visibility;
      menu.style.visibility = 'hidden';
      menu.style.display    = 'block';

      const r   = btn.getBoundingClientRect(); // viewport koordinatları
      const mh  = menu.offsetHeight;
      const mw  = menu.offsetWidth;

      const spaceBelow = window.innerHeight - r.bottom;
      const openUp     = spaceBelow < (mh + 12);

      let top  = openUp ? (r.top - mh - 8) : (r.bottom + 8);
      let left = r.right - mw; // sağa hizala

      const PAD = 12;
      left = Math.min(window.innerWidth - PAD - mw, Math.max(PAD, left));
      if (openUp && top < PAD) top = PAD;
      if (!openUp && (top + mh > window.innerHeight - PAD)) top = window.innerHeight - PAD - mh;

      menu.style.top  = top  + 'px';
      menu.style.left = left + 'px';

      menu.style.display    = prevDisplay || 'none';
      menu.style.visibility = prevVis     || '';
    }

    function toggleMenu(show){
      const willShow = (typeof show==='boolean') ? show : menu.getAttribute('aria-hidden') !== 'false';
      if (willShow) placeMenu();
      menu.setAttribute('aria-hidden', willShow ? 'false' : 'true');
      btn.setAttribute('aria-expanded', willShow ? 'true' : 'false');
    }

    btn.addEventListener('click', function(e){
      e.preventDefault();
      e.stopPropagation();
      if (!tryWebShare()){
        toggleMenu();
      }
    });

    document.addEventListener('click', function(e){
      if (!menu || menu.getAttribute('aria-hidden') === 'true') return;
      const t = e.target;
      if (t === btn || btn.contains(t) || menu.contains(t)) return;
      toggleMenu(false);
    });

    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') toggleMenu(false);
    });

    ['scroll','resize','orientationchange'].forEach(ev=>{
      window.addEventListener(ev, ()=>{
        if (menu.getAttribute('aria-hidden') === 'false') placeMenu();
      }, {passive:true});
    });

    const copyBtn = menu.querySelector('.copy-link-btn');
    copyBtn?.addEventListener('click', async ()=>{
      try{
        await navigator.clipboard.writeText(pageUrl);
        copyBtn.innerHTML = '<i class="fa-solid fa-check"></i> Kopyalandı';
        setTimeout(()=>{ copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i> Bağlantıyı kopyala'; }, 1600);
      }catch(_){
        const ta = document.createElement('textarea');
        ta.value = pageUrl; document.body.appendChild(ta); ta.select();
        try{ document.execCommand('copy'); }catch(_){}
        document.body.removeChild(ta);
      }
    });
  })();

  // single-cat ile benzer "Arama yap" davranışı
  window.tryOpenSearch = function(){
    const trg = document.getElementById('openSearchDesktop') || document.getElementById('openSearchMobile');
    if (trg) { trg.click(); return; }
    window.location.href = '/arama/';
  };
})();
</script>
