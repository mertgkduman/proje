      function load_extCss(){
        if(wnw_first_css == false && lazy_load_css.length > 0){
          lazyloadimages(0);
          lazyloadiframes(0);
          lazy_load_css.reverse().forEach(function(src) {
            var load_css = document.createElement("link");
            load_css.rel = "stylesheet";
            load_css.href = src;
            load_css.type = "text/css";
            var godefer2 = document.getElementsByTagName("link")[0];
            if(godefer2 == undefined){
              document.getElementsByTagName("head")[0].appendChild(load_css);
            }else{
              godefer2.parentNode.insertBefore(load_css, godefer2);
            }
          });
          wnw_first_css = true;
        }
      }
      var _lazyObs = null;
      function _loadLazyEl(el) {
        var src = el.getAttribute("data-src") || el.src;
        var srcset = el.getAttribute("data-srcset") || "";
        el.src = src;
        if (el.srcset != null && el.srcset !== "" && srcset) { el.srcset = srcset; }
        delete el.dataset.class;
        el.setAttribute("data-done", "Loaded");
      }
      function _initLazyObs() {
        if (_lazyObs) return;
        if (!window.IntersectionObserver) { _legacyLazyLoad(0); return; }
        _lazyObs = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (!e.isIntersecting) return;
            var el = e.target;
            if (el.getAttribute("data-class") === "LazyLoad") {
              _loadLazyEl(el);
              _lazyObs.unobserve(el);
            }
          });
        }, {rootMargin: "200px 0px"});
        document.querySelectorAll("[data-class=LazyLoad]").forEach(function(el) { _lazyObs.observe(el); });
      }
      function _observeNewLazyEls() {
        if (!_lazyObs) return;
        document.querySelectorAll("[data-class=LazyLoad]").forEach(function(el) { _lazyObs.observe(el); });
      }
      function _legacyLazyLoad(top) {
        var imgs = document.getElementsByTagName("img");
        var window_height = window.innerHeight;
        for (var i = 0; i < imgs.length; i++) {
          if (imgs[i].getAttribute("data-class") === "LazyLoad") {
            var r = imgs[i].getBoundingClientRect();
            if (r.top !== 0 && r.top - window_height < 200) { _loadLazyEl(imgs[i]); }
          }
        }
        var iframes = document.getElementsByTagName("iframe");
        for (var j = 0; j < iframes.length; j++) {
          if (iframes[j].getAttribute("data-class") === "LazyLoad") {
            var ri = iframes[j].getBoundingClientRect();
            if (ri.top !== 0 && ri.top - window_height < 200) { _loadLazyEl(iframes[j]); }
          }
        }
      }
      function lazyloadimages(top) { _initLazyObs(); }
      function lazyloadiframes(top) { _initLazyObs(); }
      function _wnwLoadVideo(v) {
        var nodes = v.querySelectorAll("[data-src]");
        for (var i = 0; i < nodes.length; i++) {
          nodes[i].src = nodes[i].getAttribute("data-src");
          nodes[i].removeAttribute("data-src");
        }
        if (v.getAttribute("data-src")) { v.src = v.getAttribute("data-src"); v.removeAttribute("data-src"); }
        v.removeAttribute("data-class");
        if (v.getAttribute("data-autoplay")) {
          v.removeAttribute("preload");
          v.load();
          v.muted = true;
          var p = v.play();
          if (p && p.catch) { p.catch(function(){}); }
        }
        else {
          v.preload = "metadata";
          v.load();
        }
      }
      function _wnwInitVideos() {
        var vs = document.querySelectorAll("video[data-class=LazyVideo]");
        if (!vs.length) { return; }
        if (!window.IntersectionObserver) {
          for (var i = 0; i < vs.length; i++) { _wnwLoadVideo(vs[i]); }
          return;
        }
        var vobs = new IntersectionObserver(function(entries) {
          entries.forEach(function(e) {
            if (!e.isIntersecting) { return; }
            vobs.unobserve(e.target);
            _wnwLoadVideo(e.target);
          });
        }, {rootMargin: "200px 0px"});
        for (var j = 0; j < vs.length; j++) { vobs.observe(vs[j]); }
      }
      window.addEventListener("load", function(){ setTimeout(_wnwInitVideos, 0); });
    lazyloadimages(0);</script></body>
