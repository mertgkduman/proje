<body data-search-endpoint="/parti-aciklamalari/inadimiz-da-umudumuz-da-ayakta">
<div id="tipAppPromo" class="tip-app-promo" hidden>
  <span class="tip-app-promo__text">TİP Dijital Uygulamasını indirin, gelişmeleri takip edin.</span>
  <a
    id="tipAppPromoStoreBtn"
    class="tip-app-promo__store"
    href="https://play.google.com/store/apps/details?id=com.tipdijital"
    target="_blank"
    rel="noopener"
    aria-label="Uygulamayı Aç"
  >
    <span id="tipAppPromoIcon" class="tip-app-promo__icon" aria-hidden="true"></span>
    <span id="tipAppPromoBtnText">Uygulamayı Aç</span>
  </a>
  <button id="tipAppPromoClose" type="button" class="tip-app-promo__close" aria-label="Kapat">×</button>
</div>
<script>
(function () {
  var promo = document.getElementById('tipAppPromo');
  var storeBtn = document.getElementById('tipAppPromoStoreBtn');
  var storeBtnText = document.getElementById('tipAppPromoBtnText');
  var iconWrap = document.getElementById('tipAppPromoIcon');
  var closeBtn = document.getElementById('tipAppPromoClose');
  if (!promo || !storeBtn || !storeBtnText || !iconWrap || !closeBtn) return;

  var APP_DEEP_LINK = "tipdijital://open";
  var BTN_TEXT = "Uygulamayı Aç";
  var STORE_IOS = 'https://apps.apple.com/us/app/ti-p-dijital/id6760565514';
  var STORE_ANDROID = 'https://play.google.com/store/apps/details?id=com.tipdijital';
  // Kapatınca 7 gün gösterme (localStorage; gizli modda/erişim yoksa sessizce geçilir)
  var SNOOZE_KEY = 'tip_app_promo_snooze_until';
  var SNOOZE_MS = 7 * 24 * 60 * 60 * 1000;
  var ua = navigator.userAgent || '';
  var isApple = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  var isAndroid = /Android/i.test(ua);
  var isMobile = window.matchMedia('(max-width: 991.98px)').matches || /Android|iPhone|iPad|iPod|Mobile/i.test(ua);
  if (!isMobile) return;

  // iOS Safari: Apple'ın yerel Smart App Banner'ı (apple-itunes-app) zaten çıkar → özel çubuk yok.
  // Diğer iOS tarayıcıları / uygulama içi tarayıcılar yerel banner'ı göstermez → çubuk kalır.
  var isInAppOrOtherBrowser = /CriOS|FxiOS|EdgiOS|OPiOS|OPT\/|YaBrowser|DuckDuckGo|GSA\/|FBAN|FBAV|FB_IAB|FBIOS|Instagram|Line\/|Twitter|Snapchat|TikTok|musical_ly|Bytedance|LinkedInApp|Pinterest|WhatsApp|Telegram/i.test(ua);
  var isIOSSafari = isApple && !isInAppOrOtherBrowser && /Version\/[\d.]+.*Safari\//.test(ua);
  if (isIOSSafari) return;

  try {
    var until = parseInt(window.localStorage.getItem(SNOOZE_KEY) || '0', 10);
    if (until && until > Date.now()) return;
  } catch (e) {}

  if (isApple) {
    storeBtn.href = STORE_IOS;
    iconWrap.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M16.83 12.98c.03 3.2 2.8 4.26 2.83 4.27-.02.08-.44 1.5-1.45 2.98-.88 1.28-1.8 2.55-3.24 2.58-1.42.03-1.88-.84-3.5-.84s-2.13.81-3.47.86c-1.39.05-2.45-1.39-3.34-2.66-1.82-2.62-3.22-7.4-1.35-10.66.93-1.62 2.58-2.64 4.38-2.67 1.37-.03 2.66.92 3.49.92.82 0 2.36-1.14 3.98-.98.68.03 2.58.27 3.8 2.05-.1.06-2.28 1.33-2.25 3.95zM13.8 5.89c.74-.9 1.24-2.15 1.1-3.39-1.06.04-2.35.71-3.11 1.61-.69.8-1.3 2.08-1.14 3.31 1.19.09 2.41-.61 3.15-1.53z"/></svg>';
  } else {
    storeBtn.href = STORE_ANDROID;
    iconWrap.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M7.27 5.04 5.5 1.88l.87-.5 1.79 3.2A9.02 9.02 0 0 1 12 3.75c1.38 0 2.69.32 3.84.83l1.79-3.2.87.5-1.77 3.16A8.29 8.29 0 0 1 20.5 12v7.25c0 .83-.67 1.5-1.5 1.5h-1v3.25c0 .55-.45 1-1 1s-1-.45-1-1V20.75h-8V24c0 .55-.45 1-1 1s-1-.45-1-1v-3.25H5c-.83 0-1.5-.67-1.5-1.5V12c0-3.06 1.6-5.75 3.77-6.96ZM8.75 9.5a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm6.5 0a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Z"/></svg>';
  }

  storeBtn.addEventListener('click', function (e) {
    e.preventDefault();
    var fallbackUrl = storeBtn.href;
    var didHide = false;
    var fallbackTimer;

    function clearFallback() {
      if (fallbackTimer) {
        clearTimeout(fallbackTimer);
        fallbackTimer = null;
      }
      document.removeEventListener('visibilitychange', onVisibilityChange);
      window.removeEventListener('pagehide', onPageHide);
    }

    function onVisibilityChange() {
      if (document.hidden) {
        didHide = true;
        clearFallback();
      }
    }

    function onPageHide() {
      didHide = true;
      clearFallback();
    }

    document.addEventListener('visibilitychange', onVisibilityChange);
    window.addEventListener('pagehide', onPageHide);

    fallbackTimer = setTimeout(function () {
      clearFallback();
      if (!didHide) {
        window.location.href = fallbackUrl;
      }
    }, 1200);

    window.location.href = APP_DEEP_LINK;
  });

  storeBtnText.textContent = BTN_TEXT;
  storeBtn.setAttribute('aria-label', BTN_TEXT);
  promo.hidden = false;
  promo.classList.add('is-visible');
  document.body.classList.add('tip-app-promo-visible');

  closeBtn.addEventListener('click', function () {
    promo.hidden = true;
    promo.classList.remove('is-visible');
    document.body.classList.remove('tip-app-promo-visible');
    try {
      window.localStorage.setItem(SNOOZE_KEY, String(Date.now() + SNOOZE_MS));
    } catch (e) {}
  });
})();
</script>

