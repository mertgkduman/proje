        <a role="menuitem" href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Ftip.org.tr%2Fparti-aciklamalari%2Fbaris-atay-mengulluogluna-yapilan-saldiriyi-azmettirenler-hesap-versin" target="_blank" rel="noopener"><i class="fa-brands fa-facebook-f"></i> Facebook</a>
