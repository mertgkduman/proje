<style>
  body, .card-body { color:#000; }

  .page-banner{ background:#f8f9fa; border-bottom:2px solid #e43442; padding:.75rem 0; margin-bottom:1rem; }
  .banner-title{ font-size:1.25rem; font-weight:800; margin:0; color:#000; letter-spacing:.2px; }
  .banner-context .context-label{
    display:inline-block; font-weight:800; font-size:1rem; color:#111;
    padding:.25rem .65rem; border:1px solid rgba(0,0,0,.1); border-radius:999px; background:#fff;
  }
  /* "Sayı X" butonu stili */
  .context-toggle{ cursor:pointer; }
  .context-toggle:focus{ outline:2px solid #273248; outline-offset:2px; }

  /* Üstte açılan Sayı seçici (yalnızca sayı görünümünde var) */
  .issue-switcher{
    position:absolute; right:0; top:100%;
    margin-top:.5rem; width:min(520px, 96vw);
    background:#fff; border:1px solid rgba(0,0,0,.12); border-radius:.75rem;
    box-shadow:0 14px 32px rgba(0,0,0,.12); padding:.6rem; z-index:30;
  }
  .issue-switcher[hidden]{ display:none; }
  .switcher-head{ display:flex; align-items:center; justify-content:space-between; padding:.25rem .25rem .35rem; }
  .switcher-head strong{ font-weight:800; font-size:.95rem; }
  .switcher-all{ font-weight:800; text-decoration:none; color:#273248; }
  .switcher-all:hover{ text-decoration:underline; }
  .switcher-grid{
    display:grid; grid-template-columns: repeat(7, 1fr); gap:.35rem; padding:.25rem;
  }
  @media (max-width: 575.98px){
    .switcher-grid{ grid-template-columns: repeat(6, 1fr); }
  }
  .switcher-item{
    display:flex; align-items:center; justify-content:center;
    border:1px solid #e1e1e1; border-radius:.5rem; padding:.35rem 0; text-decoration:none;
    font-weight:800; color:#111; background:#fff;
  }
  .switcher-item:hover{ background:#f8f9fa; }
  .switcher-item.active{ background:#e6e9f3; color:#273248; border-color:#273248; }

  .info-bubble{
    display:block; width:100%; margin:.5rem 0 1.1rem; padding:.95rem 1.15rem;
    background:#fff; color:#111; border:1px solid rgba(39,50,72,.25);
    border-left-width:6px; border-left-color:#273248; border-radius:.85rem;
    box-shadow:0 3px 12px rgba(0,0,0,.04); line-height:1.55; font-weight:500;
  }

  .card.border-0.shadow-sm .card-body{ padding:1.5rem; }

  .issue-vertical{ display:flex; flex-direction:column; gap:.3rem; }
  .issue-row{
    display:flex; align-items:center; padding:.5rem .6rem; border-radius:.5rem; text-decoration:none; color:#111;
    background:#fff; border:1px solid rgba(0,0,0,.08);
    transition: background .12s ease, transform .12s ease, border-color .12s ease; font-weight:700;
  }
  .issue-row:hover{ background:#f8f9fa; transform:translateX(2px); }
  .issue-row.active{ background:#e6e9f3; border-color:rgba(39,50,72,.35); color:#273248; }

  .covers-grid{ display:grid; gap:.9rem; grid-template-columns: repeat(2, minmax(0,1fr)); }
  @media (min-width:576px){ .covers-grid{ grid-template-columns: repeat(3, minmax(0,1fr)); } }
  @media (min-width:992px){ .covers-grid{ grid-template-columns: repeat(4, minmax(0,1fr)); } }
  .cover-card{ display:flex; flex-direction:column; text-decoration:none; color:#111;
    border:1px solid rgba(0,0,0,.08); border-radius:.75rem; overflow:hidden; background:#fff;
    transition:transform .12s ease, box-shadow .12s ease, border-color .12s ease; }
  .cover-card:hover{ transform:translateY(-2px); box-shadow:0 12px 22px rgba(0,0,0,.08); border-color:rgba(39,50,72,.35); }
  .cover-thumb{ width:100%; aspect-ratio:2/3; background:#fafafa; overflow:hidden; }
  .cover-img{ width:100%; height:100%; object-fit:cover; display:block; }
  .cover-caption{ padding:.5rem .6rem; font-weight:800; text-align:center; font-size:.95rem; border-top:1px solid rgba(0,0,0,.06); }

  /* Carousel görselleri */
  #pdfCarousel .carousel-item img { max-height: 90vh; object-fit: contain; background:#f3f4f6; cursor: zoom-in; }
  #pdfCarousel .carousel-control-prev,
  #pdfCarousel .carousel-control-next{
    width:46px; height:46px; top:50%; transform:translateY(-50%);
    border-radius:999px; background:rgba(0,0,0,.82); opacity:.95;
    margin:0 10px; box-shadow:0 10px 22px rgba(0,0,0,.35);
  }
  #pdfCarousel .carousel-control-prev{ left:0; }
  #pdfCarousel .carousel-control-next{ right:0; }
  #pdfCarousel .carousel-control-prev-icon,
  #pdfCarousel .carousel-control-next-icon{ width:20px; height:20px; }
  .page-counter-float{
    position:absolute; right:10px; top:10px; z-index:3;
    background:rgba(0,0,0,.82); color:#fff;
    border:1px solid rgba(255,255,255,.25);
    border-radius:999px; padding:.22rem .6rem;
    font-size:.78rem; font-weight:800;
  }

  /* Pager */
  .page-pager{
    display:flex; gap:.25rem; overflow-x:auto; padding:.15rem; border-radius:.5rem; background:#f8f9fa; border:1px solid #eee;
    max-width:100%; scrollbar-width:thin;
  }
  .page-pill{
    border:1px solid #dcdcdc; background:#fff; color:#111; padding:.25rem .5rem;
    border-radius:.5rem; font-weight:700; line-height:1; cursor:pointer;
  }
  .page-pill.active{ border-color:#273248; background:#e6e9f3; color:#273248; }

  /* Reader */
  .reader{ position:fixed; inset:0; background:rgba(0,0,0,.9); display:flex; flex-direction:column; z-index:1090; }
  .reader.hidden{ display:none; }
  .reader-toolbar{
    display:flex; align-items:center; gap:.5rem; padding:.5rem; background:rgba(0,0,0,.4);
    position:sticky; top:0; z-index:3;
  }
  .rbtn{
    border:1px solid rgba(255,255,255,.25); color:#fff; background:transparent; border-radius:.5rem; padding:.35rem .6rem;
    font-weight:800; cursor:pointer;
  }
  .rbtn:hover{ background:rgba(255,255,255,.08); }
  .rbtn.rclose{ margin-left:auto; font-size:1.25rem; padding:.25rem .6rem; }
  .reader-middle{ display:flex; align-items:center; gap:.35rem; margin-inline:auto; }
  .reader-counter{ color:#fff; font-weight:700; margin-left:.35rem; }

  .reader-stage{
    position:relative; flex:1; overflow:hidden; display:flex; align-items:center; justify-content:center;
    touch-action: none; z-index:1;
  }
  #readerImg{ max-width: 95vw; max-height: 92vh; transform-origin: center center; cursor: grab; }
  .reader-open { overflow:hidden; }

  /* Büyük yön butonları */
  .reader-nav{
    position:fixed; top:50%; transform:translateY(-50%);
    width:56px; height:56px; border-radius:50%;
    border:1px solid rgba(255,255,255,.3);
    background:rgba(0,0,0,.35);
    color:#fff; font-size:26px; font-weight:800;
    display:flex; align-items:center; justify-content:center;
    z-index:4; cursor:pointer;
  }
  .reader-left{ left:12px; }
  .reader-right{ right:12px; }
  .reader-nav:active{ transform:translateY(-50%) scale(.98); }

  /* iFrame fallback */
  .pdf-shell{ display:flex; flex-direction:column; gap:.75rem; }
  .viewer-toolbar .btn{ border-radius:.5rem; }
  .pdf-frame-wrap{ position:relative; border:1px solid #eee; border-radius:.9rem; overflow:hidden; background:#fff; box-shadow:0 10px 28px rgba(0,0,0,.08); }
  .pdf-frame{ width:100%; height:120vh; border:0; background:#f3f4f6; }
  .pdf-loading{
    position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.75rem;
    background:linear-gradient(180deg, rgba(255,255,255,.92), rgba(255,255,255,.86)); backdrop-filter:saturate(1.2) blur(2px); z-index:2;
  }
  .loading-text{ font-weight:800; letter-spacing:.02em; color:#111; }
  .spinner{ width:38px; height:38px; border-radius:50%; border:3px solid rgba(0,0,0,.12); border-top-color:#273248; animation:spin 1s linear infinite; }
  .pdf-inline-nav{
    position:absolute; top:50%; transform:translateY(-50%);
    width:44px; height:44px; border-radius:999px;
    border:1px solid rgba(255,255,255,.45);
    background:rgba(0,0,0,.82); color:#fff;
    font-size:22px; font-weight:800; z-index:3; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 10px 22px rgba(0,0,0,.38), 0 0 0 1px rgba(0,0,0,.25) inset;
  }
  .pdf-inline-nav.left{ left:10px; }
  .pdf-inline-nav.right{ right:10px; }
  .pdf-inline-page{
    position:absolute; right:10px; top:10px; z-index:3;
    background:rgba(0,0,0,.82); color:#fff;
    border:1px solid rgba(255,255,255,.25);
    border-radius:999px; padding:.22rem .6rem;
    font-size:.78rem; font-weight:800;
  }
  .pdf-usage-note{
    margin:.65rem 0 .1rem; display:flex; align-items:flex-start; gap:.55rem;
    padding:.72rem .82rem; border-radius:.72rem; border:1px solid rgba(39,50,72,.22);
    background:linear-gradient(180deg, #f6f8fc 0%, #eef2f8 100%);
    color:#2f3e5a; font-size:.86rem; line-height:1.45; font-weight:700;
  }
  .pdf-usage-note i{ margin-top:.08rem; color:#273248; font-size:.95rem; flex:0 0 auto; }
  @keyframes spin{ to { transform:rotate(360deg);} }

  .btn-tip { background:#273248; color:#fff; border-color:#273248; }
  .btn-tip:hover { color:#fff; filter:brightness(.95); }
</style>

<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
  // Issue Switcher (yalnızca sayı görünümünde var)
  (function(){
    const toggle = document.getElementById('issueToggle');
    const panel  = document.getElementById('issueSwitcher');
    if (!toggle || !panel) return;

    function openPanel(){
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      const first = panel.querySelector('.switcher-item:not(.active)') || panel.querySelector('.switcher-item');
      first && first.focus && first.focus();
      document.addEventListener('click', onDocClick);
      document.addEventListener('keydown', onKey);
    }
    function closePanel(){
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      document.removeEventListener('click', onDocClick);
      document.removeEventListener('keydown', onKey);
    }
    function onDocClick(e){
      if (panel.contains(e.target) || toggle.contains(e.target)) return;
      closePanel();
    }
    function onKey(e){
      if (e.key === 'Escape'){ e.preventDefault(); closePanel(); toggle.focus(); }
    }

    toggle.addEventListener('click', function(){
      (panel.hidden ? openPanel : closePanel)();
    });
  })();

  // Sadece iframe fallback’i için yükleniyor overlay’i
  (function() {
    var frame = document.getElementById('pdfFrame');
    var overlay = document.getElementById('pdfLoading');
    if (!frame || !overlay) return;

    function hideOverlay(){
      overlay.style.opacity = '0';
      overlay.style.pointerEvents = 'none';
      setTimeout(function(){ overlay.style.display='none'; }, 250);
    }
    overlay.style.display = 'flex';
    frame.addEventListener('load', hideOverlay, { once:true });
    setTimeout(function(){ if (overlay && overlay.style.display !== 'none') hideOverlay(); }, 10000);
  })();
</script>
