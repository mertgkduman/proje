                  <div class="page-counter-float">Sayfa <span id="pageNo">1</span> / 17</div>
                  <button class="carousel-control-prev" type="button" data-bs-target="#pdfCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Önceki</span>
                  </button>
                  <button class="carousel-control-next" type="button" data-bs-target="#pdfCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Sonraki</span>
                  </button>
                </div>

                <!-- Tam ekran okuma modu + büyük yön butonları -->
                <div id="readerOverlay" class="reader hidden" aria-hidden="true">
                  <div class="reader-toolbar">
                    <button class="rbtn" id="btnPrev" title="Önceki (←)">&#10094;</button>
                    <div class="reader-middle">
                      <button class="rbtn" id="btnZoomOut" title="Yakınlığı azalt">−</button>
                      <button class="rbtn" id="btnFit" title="Sığdır">Sığdır</button>
                      <button class="rbtn" id="btnZoomIn" title="Yakınlaştır">+</button>
                      <span class="reader-counter" id="readerCounter">1 / 17</span>
                    </div>
                    <button class="rbtn" id="btnFs" title="Tam Ekran (Enter)">⤢</button>
                    <button class="rbtn rclose" id="btnClose" title="Kapat (Esc)">×</button>
                  </div>

                  <button class="reader-nav reader-left" id="readerLeft" aria-label="Önceki sayfa">&#10094;</button>
                  <button class="reader-nav reader-right" id="readerRight" aria-label="Sonraki sayfa">&#10095;</button>

                  <div class="reader-stage" id="readerStage">
                    <img id="readerImg" alt="Okuyucu görseli">
                  </div>
                </div>

                <script>
                  (function(){
                    const $  = (s, r=document)=>r.querySelector(s);
                    const $$ = (s, r=document)=>Array.from(r.querySelectorAll(s));

                    const carouselEl = $('#pdfCarousel');
                    if (!carouselEl) return;
                    let carousel;
                    try { carousel = new bootstrap.Carousel(carouselEl, { interval:false, ride:false, touch:true, pause:false }); } catch(e){}

                    const pageNoEl = $('#pageNo');
                    const pager    = $('#pagePager');
                    const items    = $$('.carousel-item', carouselEl);
                    const imgs     = $$('.page-img', carouselEl);
                    const total    = 17;

                    // Desktop sürükle
                    let startX=0, deltaX=0, dragging=false;
                    const threshold=40;
                    carouselEl.addEventListener('pointerdown', (e)=>{ dragging=true; startX=e.clientX; deltaX=0; });
                    carouselEl.addEventListener('pointermove', (e)=>{ if(!dragging) return; deltaX=e.clientX-startX; });
                    carouselEl.addEventListener('pointerup', ()=>{ if(!dragging) return; dragging=false; if(Math.abs(deltaX)>threshold){ deltaX<0?carousel?.next():carousel?.prev(); } });

                    function updatePager(activeIndex){
                      if (pageNoEl) pageNoEl.textContent = (activeIndex+1);
                      const pills = $$('.page-pill', pager||document.createElement('div'));
                      pills.forEach((b,i)=> b.classList.toggle('active', i===activeIndex));
                      const activePill = pills[activeIndex];
                      if (activePill && pager) pager.scrollTo({ left: Math.max(0, activePill.offsetLeft - 40), behavior: 'smooth' });
                    }
                    carouselEl.addEventListener('slid.bs.carousel', e=>{
                      const idx = items.indexOf(e.relatedTarget);
                      updatePager(idx);
                      if (!reader.classList.contains('hidden')) setReaderIndex(idx);
                    });
                    updatePager(0);

                    pager && pager.addEventListener('click', (e)=>{
                      const btn = e.target.closest('.page-pill'); if(!btn) return;
                      const to = parseInt(btn.getAttribute('data-bs-slide-to'),10);
                      if (!Number.isNaN(to)) carousel?.to(to);
                    });

                    // === Reader ===
                    const reader        = $('#readerOverlay');
                    const readerImg     = $('#readerImg');
                    const readerStage   = $('#readerStage');
                    const btnClose      = $('#btnClose');
                    const btnPrev       = $('#btnPrev');
                    const btnZoomIn     = $('#btnZoomIn');
                    const btnZoomOut    = $('#btnZoomOut');
                    const btnFit        = $('#btnFit');
                    const btnFs         = $('#btnFs');
                    const readerCounter = $('#readerCounter');
                    const readerLeft    = $('#readerLeft');
                    const readerRight   = $('#readerRight');

                    if (!reader || !readerImg || !readerStage) return;

                    const srcs = imgs.map(i => i.getAttribute('src'));
                    let rIndex=0, scale=1, panX=0, panY=0, pDown=false, pStartX=0, pStartY=0, panStartX=0, panStartY=0;

                    function setReaderIndex(i){
                      rIndex = Math.max(0, Math.min(total-1, i));
                      readerImg.setAttribute('src', srcs[rIndex]);
                      if (readerCounter) readerCounter.textContent = (rIndex+1) + ' / ' + total;
                      resetTransform();
                    }
                    function resetTransform(){ scale=1; panX=0; panY=0; applyTransform(); }
                    function applyTransform(){ readerImg.style.transform = `translate(${panX}px,${panY}px) scale(${scale})`; }
                    function next(){ setReaderIndex(rIndex+1); carousel?.to(rIndex); }
                    function prev(){ setReaderIndex(rIndex-1); carousel?.to(rIndex); }
                    function zoomBy(f){ scale = Math.min(5, Math.max(0.5, scale*f)); applyTransform(); }

                    // Aç/Kapat + Fullscreen
                    async function openReader(i){
                      setReaderIndex(i);
                      reader.classList.remove('hidden');
                      reader.setAttribute('aria-hidden','false');
                      document.documentElement.classList.add('reader-open');
                      try { await reader.requestFullscreen?.(); } catch(_){}
                    }
                    async function closeReader(){
                      reader.classList.add('hidden');
                      reader.setAttribute('aria-hidden','true');
                      document.documentElement.classList.remove('reader-open');
                      if (document.fullscreenElement) { try { await document.exitFullscreen?.(); } catch(_){ } }
                    }

                    // Görsele tıklayınca aç
                    imgs.forEach(img => img.addEventListener('click', ()=>{ const idx=parseInt(img.dataset.index,10)||0; openReader(idx); }));

                    // Reader kontroller
                    btnClose?.addEventListener('click', closeReader);
                    btnPrev ?.addEventListener('click', prev);
                    readerLeft ?.addEventListener('click', prev);
                    readerRight?.addEventListener('click', next);
                    btnZoomIn ?.addEventListener('click', ()=> zoomBy(1.25));
                    btnZoomOut?.addEventListener('click', ()=> zoomBy(0.8));
                    btnFit    ?.addEventListener('click', resetTransform);
                    btnFs     ?.addEventListener('click', async ()=>{
                      if (document.fullscreenElement) { try { await document.exitFullscreen?.(); } catch(_){ } }
                      else { try { await reader.requestFullscreen?.(); } catch(_){ } }
                    });

                    // Klavye
                    document.addEventListener('keydown', (e)=>{
                      if (reader.classList.contains('hidden')) return;
                      if (e.key==='Escape') { e.preventDefault(); closeReader(); }
                      if (e.key==='ArrowRight') next();
                      if (e.key==='ArrowLeft')  prev();
                      if (e.key==='+'||e.key==='='){ e.preventDefault(); zoomBy(1.25); }
                      if (e.key==='-'||e.key==='_'){ e.preventdefault(); zoomBy(0.8); }
                      if (e.key.toLowerCase()==='f') resetTransform();
                      if (e.key==='Enter') btnFs?.click();
                    });

                    // Pan / swipe
                    readerStage.addEventListener('pointerdown', (e)=>{
                      pDown=true; readerStage.setPointerCapture?.(e.pointerId);
                      pStartX=e.clientX; pStartY=e.clientY; panStartX=panX; panStartY=panY;
                    });
                    readerStage.addEventListener('pointermove', (e)=>{
                      if(!pDown) return;
                      const dx = e.clientX - pStartX;
                      const dy = e.clientY - pStartY;
                      if (scale === 1 && Math.abs(dx) > Math.abs(dy)) return; // swipe'i carousel’e bırak
                      panX = panStartX + dx; panY = panStartY + dy; applyTransform();
                    });
                    readerStage.addEventListener('pointerup', (e)=>{
                      if(!pDown) return; pDown=false;
                      const dx = e.clientX - pStartX;
                      if (scale === 1 && Math.abs(dx) > 50) { dx<0 ? next() : prev(); }
                    });

                    readerStage.addEventListener('wheel', (e)=>{
                      if (reader.classList.contains('hidden')) return;
                      e.preventDefault();
                      const dir = e.deltaY > 0 ? 0.9 : 1.1;
                      zoomBy(dir);
                    }, {passive:false});
                  })();
                </script>

              
                      </div>
        </article>
      </main>

    </div>
  </div>
</section>

