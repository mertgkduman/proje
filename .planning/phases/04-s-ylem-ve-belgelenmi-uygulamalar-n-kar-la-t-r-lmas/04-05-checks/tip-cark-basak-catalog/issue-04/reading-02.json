  "pages": [
    {
      "pdf_page_index": 11,
      "characters": 2680,
      "text_sha256": "143b8772663209c8673f0c3671bca3bba969da102481a6d96b043fbaa35c7565",
      "observation": "Yıllık grev, kamu ve özel ayrımı ile katılımcı sayısı grafiği görsel olarak okundu. Başlık dönemi ve eksen sonu aynı değil."
    },
    {
      "pdf_page_index": 12,
      "characters": 3535,
      "text_sha256": "a0038a25bd3f3c20f6f05eebf077cbc9276d0ed6027f915c953f5ee7a5a017eb",
      "observation": "İşçi meclislerinin gerekçeleri ve örgütlenme taslağı."
    },
    {
      "pdf_page_index": 13,
      "characters": 2292,
      "text_sha256": "d812f784bc555f81f58c5dc08fad3b35eec2c866887399fcf011fc0c06684379",
      "observation": "İşçi meclisi, işyeri birimi ve kadın işçi katılımına ilişkin tasarım."
    },
    {
      "pdf_page_index": 14,
      "characters": 1236,
      "text_sha256": "050e6793e2ede763175deb6d384d14d6bf17685a404483cea34ab243fdbdc203",
      "observation": "Önerilen üç örgütlenme biriminin şeması ve İstanbul sanayi alanları haritası görsel olarak okundu. Pilot hayata geçme belgesi açık."
    },
    {
      "pdf_page_index": 15,
      "characters": 1546,
      "text_sha256": "e1a02431b918af9322a1aa98c67eafd769d9b58b878887c19bd4836c87955cb9",
      "observation": "İşçi meclisi önerisinin devamı, hazırlık ve faaliyet tasarısı."
    },
    {
      "pdf_page_index": 16,
      "characters": 1490,
      "text_sha256": "238a74bef5d4ba428e2ff2f5f831538515400280aab59d57cb207eda9096590f",
      "observation": "2005–2018 sektör grafiği görsel olarak okundu. Seri ucu harfleriyle sektör açıklamalarında açıklık sorunu var, sayı bu grafikten alınmadı."
    },
    {
      "pdf_page_index": 17,
      "characters": 2002,
      "text_sha256": "ab58a4496924c4b4d3299666893e803d673232791d61d2fd78ae18ceaef36d1e",
      "observation": "Kentlerde ve hizmet sektöründe istihdam ve örgütlenme hakkında yorum."
    },
    {
      "pdf_page_index": 18,
      "characters": 1964,
      "text_sha256": "61ded533ae2989fe855866ff2db7c4a49a5394479423900299a0617e7efbe6fa",
      "observation": "Resmî üyelik, fiilî üyelik ve toplu sözleşme grafik kategorileri ile sektör tablosu görsel okundu. Dönem ve kaynak aslı ayrıca araştırılmalı."
    },
    {
      "pdf_page_index": 19,
      "characters": 3404,
      "text_sha256": "56d4bda64e9f39c3b8564969ee5d6daa45ca7bb2c2976f62ba47f031809f82ea",
      "observation": "Ücretli öğretmen, alışveriş merkezi çalışanı ve diğer iş profillerine ilişkin taslak sınıflandırma ve iddialar."
    },
    {
      "pdf_page_index": 20,
      "characters": 3820,
      "text_sha256": "aa7793c42aeee6f67be035f2d58e6a79046ed85edd3c3c5dc9c3479b56186939",
      "observation": "İşyerlerinin kent ve çalışma koşulları ile sendikal çalışma önerileri."
    },
    {
      "pdf_page_index": 21,
      "characters": 3732,
      "text_sha256": "7586a30417443888896bbe89c3b948427d9f99620ebcab7f3aef85729caf0b9c",
      "observation": "Kent sendikacılığı ve yeni örgütlenme alanlarına ilişkin öneriler."
    }
  ],
