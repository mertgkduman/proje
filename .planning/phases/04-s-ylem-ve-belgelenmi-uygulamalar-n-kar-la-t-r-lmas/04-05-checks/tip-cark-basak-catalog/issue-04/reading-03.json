    {
      "pdf_page_index": 25,
      "characters": 4108,
      "text_sha256": "5053f2a97cb078a1419063dec322db853b7694955b8132780d0f03dcefd3e579",
      "observation": "İnşaat işçisi ve meslek gruplarındaki çalışma düzenine ilişkin taslak değerlendirmesi."
    },
    {
      "pdf_page_index": 26,
      "characters": 3854,
      "text_sha256": "f2a19a04a17c7c58d72980e0479ea829c685fce05e8aa3a68e43801d65a2d3bc",
      "observation": "İnşaat sektöründeki işyeri örnekleri, iş güvenliği ve beklenen gelişmeler."
    },
    {
      "pdf_page_index": 27,
      "characters": 1683,
      "text_sha256": "0b4f20e8a867db366b739b948e12dac377e82b4bf3cc9215fef047c21fdc3a61",
      "observation": "2018 Temmuz–2019 Ocak sektör istihdam tablosu görsel okundu. Taslaktaki istihdam farkı doğrulanmış işten çıkarma sayısı olarak kodlanmadı."
    },
    {
      "pdf_page_index": 28,
      "characters": 3312,
      "text_sha256": "3440cda666fd015e978874fd943260e2cdfb4a972a2e1e275264fc4e5bb4485f",
      "observation": "İnşaat işçilerinin örgütlenmesine ilişkin taslak öneriler."
    },
    {
