      "text_sha256": "da484983b6bd10a8ba82cca9dedcbffd75b5edcce31b4636519e5565ca56049c",
      "observation": "Merkez Komitesi taslağı için Örgüt Bürosu üzerinden görüş iletme yolu ve yerel seçim planlaması."
    },
    {
      "pdf_page_index": 3,
      "characters": 2376,
      "text_sha256": "aa53b92655f30bb2614c74416ee0e23faaaf8aa7b5f61194e2f54d223cdeb916",
