<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
(function () {
  const countdowns = document.querySelectorAll('.timeline-mini-countdown');
  if (!countdowns.length) return;

  const tick = () => {
    const now = new Date();
    countdowns.forEach((box) => {
      const raw = box.getAttribute('data-event-at');
      if (!raw) return;

      const target = new Date(raw.replace(' ', 'T') + ':00');
      let diff = Math.floor((target.getTime() - now.getTime()) / 1000);
      if (diff < 0) diff = 0;

      const days = Math.floor(diff / 86400);
      const hours = Math.floor((diff % 86400) / 3600);
      const mins = Math.floor((diff % 3600) / 60);
      const secs = diff % 60;

      const d = box.querySelector('[data-unit="d"]');
      const h = box.querySelector('[data-unit="h"]');
      const m = box.querySelector('[data-unit="m"]');
      const s = box.querySelector('[data-unit="s"]');
      if (d) d.textContent = String(days);
      if (h) h.textContent = String(hours).padStart(2, '0');
      if (m) m.textContent = String(mins).padStart(2, '0');
      if (s) s.textContent = String(secs).padStart(2, '0');
    });
  };

  tick();
  setInterval(tick, 1000);
})();
</script>
