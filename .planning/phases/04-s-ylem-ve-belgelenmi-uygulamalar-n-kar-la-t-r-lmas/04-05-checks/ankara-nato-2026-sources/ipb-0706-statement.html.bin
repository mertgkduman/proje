<style id="newsletter-inline-css">
/* --- ATKINSON HYPERLEGIBLE FAMILY --- */

/* Regular */
@font-face {
    font-family: 'Atkinson';
    src: url('https://ipb.org/wp-content/themes/ipb/fonts/AtkinsonHyperlegible-Regular.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
}

/* Bold */
@font-face {
    font-family: 'Atkinson';
    src: url('https://ipb.org/wp-content/themes/ipb/fonts/AtkinsonHyperlegible-Bold.woff2') format('woff2');
    font-weight: 700;
    font-style: normal;
}

/* Italic */
@font-face {
    font-family: 'Atkinson';
    src: url('https://ipb.org/wp-content/themes/ipb/fonts/AtkinsonHyperlegible-Italic.woff2') format('woff2');
    font-weight: 400;
    font-style: italic;
}

/* Bold Italic */
@font-face {
    font-family: 'Atkinson';
    src: url('https://ipb.org/wp-content/themes/ipb/fonts/AtkinsonHyperlegible-BoldItalic.woff2') format('woff2');
    font-weight: 700;
    font-style: italic;
}

/* --- OPEN SANS ITALIC VARIANTS --- */

/* Open Sans 500 Italic (Medium) */
@font-face {
    font-family: 'Open Sans Italic';
    src: url('https://ipb.org/wp-content/themes/ipb/fonts/Open%20Sans-500italic.woff2') format('woff2');
    font-weight: 500;
    font-style: italic;
}

/* Open Sans 600 Italic (Semi-Bold) */
@font-face {
    font-family: 'Open Sans Italic';
    src: url('https://ipb.org/wp-content/themes/ipb/fonts/Open%20Sans-600italic.woff2') format('woff2');
    font-weight: 600;
    font-style: italic;
}

/* Open Sans 700 Italic (Bold) */
@font-face {
    font-family: 'Open Sans Italic';
    src: url('https://ipb.org/wp-content/themes/ipb/fonts/Open%20Sans-700italic.woff2') format('woff2');
    font-weight: 700;
    font-style: italic;
}

/* Open Sans 800 Italic (Extra Bold) */
@font-face {
    font-family: 'Open Sans Italic';
    src: url('https://ipb.org/wp-content/themes/ipb/fonts/Open%20Sans-800italic.woff2') format('woff2');
    font-weight: 800;
    font-style: italic;
}

/* --- APPLICATION RULES --- */

/* Default font for the entire newsletter */
.tnp-body, .tnp-text, .tnp-table {
    font-family: 'Atkinson', Helvetica, Arial, sans-serif !important;
    font-size: 16px;
    line-height: 1.5;
}

/* Atkinson for headers */
.tnp-title, .tnp-heading, h1, h2, h3 {
    font-family: 'Atkinson', sans-serif !important;
    font-weight: 700;
}
/*# sourceURL=newsletter-inline-css */
</style>
