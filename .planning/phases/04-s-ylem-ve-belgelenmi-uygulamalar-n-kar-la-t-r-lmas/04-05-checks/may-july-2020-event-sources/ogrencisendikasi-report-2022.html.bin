    <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
        const isPanelRequest = false;
        const linkCards = document.querySelectorAll('.js-link-card[data-href]');
        linkCards.forEach((card) => {
            const href = card.getAttribute('data-href');
            if (!href) return;

            card.addEventListener('click', (event) => {
                const target = event.target;
                if (target instanceof Element && target.closest('a, button')) return;
                window.location.href = href;
            });

            card.addEventListener('keydown', (event) => {
                if (event.key !== 'Enter' && event.key !== ' ') return;
                event.preventDefault();
                window.location.href = href;
            });
        });

        const animatedElements = document.querySelectorAll('[data-reveal]');
        const revealAll = () => {
            animatedElements.forEach((element) => element.classList.add('is-visible'));
        };
        if (isPanelRequest) {
            revealAll();
        } else if ('IntersectionObserver' in window && animatedElements.length > 0) {
            const revealFallback = window.setTimeout(() => {
                revealAll();
            }, 1800);

            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                        observer.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.05, rootMargin: '120px 0px' });

            animatedElements.forEach((element) => observer.observe(element));
        } else {
            revealAll();
        }

        if (isPanelRequest && typeof bootstrap !== 'undefined') {
            const adminMenu = document.getElementById('adminMenu');
            const adminMenuToggle = document.getElementById('adminMenuToggle');
            if (adminMenu && adminMenuToggle) {
                const adminMenuCollapse = bootstrap.Collapse.getOrCreateInstance(adminMenu, { toggle: false });
                adminMenuToggle.addEventListener('click', (event) => {
                    event.preventDefault();
                    if (adminMenu.classList.contains('show')) {
                        adminMenuCollapse.hide();
                    } else {
                        adminMenuCollapse.show();
                    }
                });
                adminMenu.addEventListener('shown.bs.collapse', () => {
                    adminMenuToggle.setAttribute('aria-expanded', 'true');
                });
                adminMenu.addEventListener('hidden.bs.collapse', () => {
                    adminMenuToggle.setAttribute('aria-expanded', 'false');
                });
                const panelNavLinks = adminMenu.querySelectorAll('.nav-link');
                panelNavLinks.forEach((link) => {
                    link.addEventListener('click', () => {
                        if (window.innerWidth < 1200) {
                            adminMenuCollapse.hide();
                        }
                    });
                });
            }
        }
    </script>
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092" integrity="sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==" data-cf-beacon='{"version":"2024.11.0","token":"99f155586b3744359ded581c2a627182","r":1,"spa":2}' crossorigin="anonymous"></script>
