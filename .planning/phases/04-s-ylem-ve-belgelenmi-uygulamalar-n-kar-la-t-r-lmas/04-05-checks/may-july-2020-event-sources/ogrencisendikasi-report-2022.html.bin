                                        data-report-title="17 Kasım Uluslararası Öğrenciler Günü Raporu (2021)"
                                        data-report-summary-html="Uluslararası Öğrenciler Günü kapsamında öğrencilerin ortak sorunlarını ve kolektif çözüm yollarını değerlendiren rapor."
                                        data-report-date="17.11.2021"
                                        data-report-url="/assets/reports/17-kasim-uluslararasi-ogrenciler-gunu-raporu-2021.pdf"
                                        data-report-slug="sen-ben-degil-biz-degistirebiliriz-raporu"
                                                                            >
                                        <i class="fa-regular fa-eye me-1"></i> İncele
                                    </button>
                                                            </div>

                            <h2>17 Kasım Uluslararası Öğrenciler Günü Raporu (2021)</h2>
                            <p class="report-summary">Uluslararası Öğrenciler Günü kapsamında öğrencilerin ortak sorunlarını ve kolektif çözüm yollarını değerlendiren rapor.</p>
                        </div>
