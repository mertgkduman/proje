</section>

<div class="modal fade" id="rapor-onizleme-modal" tabindex="-1" aria-labelledby="rapor-onizleme-modal-etiket" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content report-modal-content report-modal-content-full">
            <div class="modal-body p-0">
                <div class="report-preview-main">
                    <div class="report-preview-top">
                        <div class="report-modal-header-main">
                            <h2 class="report-modal-main-title">Rapor Önizleme</h2>
                            <h3 id="raporOnizlemeBaslik" class="modal-title report-modal-subtitle mb-1"></h3>
                            <p id="raporOnizlemeOzet" class="report-modal-desc mb-1"></p>
                            <div class="report-modal-meta-line">
                                <span class="report-date" id="raporOnizlemeTarih"></span>
                            </div>
                        </div>
                        <div class="report-modal-actions">
                            <a id="raporOnizlemeYeniSekme" class="btn btn-sm btn-report-pdf-open" target="_blank" rel="noopener noreferrer" href="#">
                                <i class="fa-solid fa-up-right-from-square me-1"></i> Tam Ekran
                            </a>
                            <button type="button" class="btn btn-sm btn-report-close" data-bs-dismiss="modal">Kapat</button>
                        </div>
                    </div>
                    <div id="raporOnizlemeDurum" class="report-preview-status">Rapor yükleniyor...</div>
                    <div id="raporOnizlemeSayfalar" class="report-pages-grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
(() => {
    const modalEl = document.getElementById('rapor-onizleme-modal');
    if (!modalEl) return;

    const titleEl = document.getElementById('raporOnizlemeBaslik');
    const dateEl = document.getElementById('raporOnizlemeTarih');
    const summaryEl = document.getElementById('raporOnizlemeOzet');
    const statusEl = document.getElementById('raporOnizlemeDurum');
    const pagesEl = document.getElementById('raporOnizlemeSayfalar');
    const openLinkEl = document.getElementById('raporOnizlemeYeniSekme');
    let activeRenderToken = 0;
    // Her önizlemeye paylaşılabilir /raporlar/<slug> URL'i ver (SEO + paylaşım).
    const reportsBaseUrl = "https://ogrencisendikasi.com/raporlar";
    const baseDocTitle = document.title;

    async function loadPdfJs() {
        if (window.pdfjsLib) return window.pdfjsLib;
        await new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
            script.onload = resolve;
            script.onerror = reject;
            document.head.appendChild(script);
        });
        if (!window.pdfjsLib) {
            throw new Error('pdf.js yüklenemedi');
        }
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
        return window.pdfjsLib;
    }

    async function renderPdfPages(pdfUrl, renderToken) {
        pagesEl.innerHTML = '';
        statusEl.textContent = 'Rapor yükleniyor...';
        statusEl.style.display = 'block';

        try {
            const pdfjs = await loadPdfJs();
            const loadingTask = pdfjs.getDocument(pdfUrl);
            const pdf = await loadingTask.promise;
            const totalPages = pdf.numPages;

            statusEl.textContent = `Toplam ${totalPages} sayfa. Tümü hazırlanıyor...`;

            for (let pageNumber = 1; pageNumber <= totalPages; pageNumber++) {
                if (renderToken !== activeRenderToken) {
                    return;
                }

                const page = await pdf.getPage(pageNumber);
                const baseViewport = page.getViewport({ scale: 1 });
                const targetWidth = Math.max(520, Math.min(900, Math.floor((window.innerWidth || 1440) / 3)));
                const scale = targetWidth / baseViewport.width;
                const viewport = page.getViewport({ scale });

                const canvas = document.createElement('canvas');
                const dpr = Math.min(window.devicePixelRatio || 1, 2);
                canvas.width = Math.floor(viewport.width * dpr);
                canvas.height = Math.floor(viewport.height * dpr);
                canvas.style.width = '100%';
                canvas.style.height = 'auto';
                canvas.className = 'pdf-page-canvas';

                const context = canvas.getContext('2d', { alpha: false });
                if (!context) continue;
                context.setTransform(dpr, 0, 0, dpr, 0, 0);
                context.imageSmoothingEnabled = true;
                context.imageSmoothingQuality = 'high';

                await page.render({ canvasContext: context, viewport }).promise;

                const pageCard = document.createElement('article');
                pageCard.className = 'pdf-page-card';
                pageCard.innerHTML = `<span class="pdf-page-number">Sayfa ${pageNumber}</span>`;
                pageCard.appendChild(canvas);
                pagesEl.appendChild(pageCard);

                statusEl.textContent = `${pageNumber}/${totalPages} sayfa hazırlandı...`;
            }

            statusEl.style.display = 'block';
            statusEl.textContent = `Toplam ${totalPages} sayfa yüklendi. Aşağı kaydırarak tüm sayfaları görebilirsiniz.`;
        } catch (error) {
            statusEl.style.display = 'block';
            statusEl.textContent = 'PDF önizleme yüklenemedi. Lütfen "PDF\'yi Aç" butonunu kullanın.';
            pagesEl.innerHTML = '';
        }
    }

    modalEl.addEventListener('show.bs.modal', (event) => {
        const trigger = event.relatedTarget;
        if (!(trigger instanceof HTMLElement)) return;

        const reportTitle = trigger.getAttribute('data-report-title') || 'Rapor Önizleme';
        const reportSummaryHtml = trigger.getAttribute('data-report-summary-html') || '';
        const reportDate = trigger.getAttribute('data-report-date') || '';
        const reportUrl = trigger.getAttribute('data-report-url') || '#';

        titleEl.textContent = reportTitle;
        summaryEl.innerHTML = reportSummaryHtml;
        dateEl.innerHTML = reportDate !== '' ? `<i class="fa-regular fa-calendar me-1"></i>${reportDate}` : '';
        openLinkEl.setAttribute('href', reportUrl);
        openLinkEl.setAttribute('title', `${reportTitle} PDF dosyasını yeni sekmede aç`);
        document.title = `${reportTitle} | Raporlar | Öğrenci Sendikası`;

        // URL'i bu rapora ait paylaşılabilir adrese güncelle (geçmişi kirletmeden).
        const previewSlug = trigger.getAttribute('data-report-slug') || '';
        if (previewSlug) {
            try { history.replaceState(history.state, '', reportsBaseUrl + '/' + encodeURIComponent(previewSlug)); } catch (e) {}
        }

        activeRenderToken++;
        renderPdfPages(reportUrl, activeRenderToken);
    });

    modalEl.addEventListener('hidden.bs.modal', () => {
        activeRenderToken++;
        statusEl.style.display = 'none';
        pagesEl.innerHTML = '';
        // Modal kapanınca URL'i ve başlığı liste sayfasına geri al.
        document.title = baseDocTitle;
        try { history.replaceState(history.state, '', reportsBaseUrl); } catch (e) {}
    });

    const previewCards = Array.from(document.querySelectorAll('.js-report-preview-card'));
    previewCards.forEach((card) => {
        if (!(card instanceof HTMLElement) || card.classList.contains('is-disabled')) return;

        card.addEventListener('click', (event) => {
            const target = event.target;
            if (target instanceof Element && target.closest('a, button')) return;
            const actionButton = card.querySelector('.js-open-report-preview:not([disabled])');
            if (actionButton instanceof HTMLElement) {
                actionButton.click();
            }
        });

        card.addEventListener('keydown', (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return;
            event.preventDefault();
            const actionButton = card.querySelector('.js-open-report-preview:not([disabled])');
            if (actionButton instanceof HTMLElement) {
                actionButton.click();
            }
        });
    });

    window.addEventListener('load', () => {
        const defaultAutoOpenSlug = "19-mayis-raporu";
        const query = new URLSearchParams(window.location.search);
        const onizleSlug = query.get('onizle') || defaultAutoOpenSlug;
        if (!onizleSlug) return;

        const buttons = Array.from(document.querySelectorAll('.js-open-report-preview'));
        const targetButton = buttons.find((button) => {
            if (!(button instanceof HTMLElement)) return false;
            return button.getAttribute('data-report-slug') === onizleSlug && !button.hasAttribute('disabled');
        });

        if (!targetButton) return;
        targetButton.click();
    });
})();
</script>
    </main>

