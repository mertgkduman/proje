    {
      "kind": "passage",
      "values": {
        "id": "0404-yeni-parti-haber-274-sanayi",
        "version_id": "0404-yeni-parti-haber-274-v1",
        "section": "AB ve lojistik başlığı, Made in Europe değerlendirmesi",
        "exact": "“Değerli arkadaşlar, dört gün önce burada yaptığımız basın toplantısında, 'Made in Europe' başlığıyla bilinen ve Avrupa Birliği'nin kendi içindeki ticareti geliştirmeyi amaçlayan çalışmasının önümüzdeki dönemde Türkiye'ye muhtemel yansımalarını da tartışmış, bu konuda bazı açıklamalar yapmıştık.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0404-yeni-parti-haber-295-lojistik",
        "version_id": "0404-charter-announcement-api-v1",
        "section": "Türkiye–AB Gümrük Birliği, kara yolu sürücüleri önerisi",
        "exact": "Dolayısıyla buna baktığımız zaman uluslararası nakliyecilerin talepleri açık ve bunlar karşılanabilir taleplerdir. Bir defa TIR sürücülerinin Avrupa ekonomisinin sürdürülebilirliği ve Avrupa-Avrasya bölgeleri arasında karayoluyla yapılan ticarette önemli rolleri vardır. Türkiye-AB Ortak Gümrük Birliği sahası içerisinde hizmet sağlayıcısı konumları temelinde acil ve öncelikli grup olarak değerlendirilmesi, bu alana alınması lazım.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0404-yeni-parti-haber-295-vize",
        "version_id": "0404-charter-announcement-api-v1",
        "section": "Schengen süresi ve profesyonel sürücüler",
        "exact": "İkincisi, Schengen Bölgesi'ne seyahat eden sürücüler için 90/180 kuralının, yani altı aylık vize alırsan 90 gün kalırsın kuralının, esnetilip aldıkları vize süresi kadar orada bulunabilmelerine olanak sağlanması gerekmektedir. Ve üçüncüsü olarak da burada randevu sürelerinin problem olmasından, bu alanda çalışan TIR sürücülerine de özel bir sistem geliştirilmesi ve hızlı başvuru yollarına imkân sağlanması lazım. Burada Schengen Bölgesi ülkeleri için tek bir vize merkezinin oluşturulması önemli ve bu konuyla ilgili de gerek Ticaret Bakanlığının gerekse Dışişleri Bakanlığının gerekli temasları yapması, bu sektörde çalışan milyonlar için çok önemlidir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "pdf_page_index": null,
        "printed_page": null
      }
    }
