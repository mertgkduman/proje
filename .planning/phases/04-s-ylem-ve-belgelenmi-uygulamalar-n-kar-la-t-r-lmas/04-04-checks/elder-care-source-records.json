    {
      "kind": "passage",
      "values": {
        "id": "0404-yasli-bulbul-role",
        "version_id": "0404-yasli-bulbul-v1",
        "exact": "YENİ Parti Aydın Milletvekili Süleyman Bülbül, Aydın’da yaşlı nüfus oranının Türkiye ortalamasının üzerinde olduğuna dikkat çekerek yaşlı bakım hizmetlerinin yetersizliğini gündeme taşıdı. Bülbül, huzurevlerinde başvuru, kabul ve bekleme sayılarını sorarken ilçelerde gündüz yaşlı bakım merkezleri açılması ve evde profesyonel bakım hizmetlerinin yaygınlaştırılması çağrısında bulundu.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Haber girişi ve milletvekili sıfatı",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0404-yasli-bulbul-requests",
        "version_id": "0404-yasli-bulbul-v1",
        "exact": "“Sayın Bakan, kapasiteyi söylediniz. Başvuran kaç kişi, kabul edilen kaç kişi, sıra bekleyen kaç kişi? Evinde bakım hizmeti bekleyen kaç yurttaşımız var? Bu soruların yanıtını neden Aydınlılarla paylaşmadınız?”",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Açıklamada yöneltilen sorular",
        "pdf_page_index": null,
        "printed_page": null
