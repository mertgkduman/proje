    {
      "kind": "passage",
      "values": {
        "id": "0404-ab-wiseler-meeting",
        "version_id": "0404-ab-wiseler-v1",
        "exact": "YENİ Parti Grup Başkanvekili Murat Emir, Genel Başkan Yardımcısı Utku &Ccedil;akır&ouml;zer, İlhan Uzgel ve Şule Bucak'tan oluşan heyet L&uuml;ksemburg Temsilciler Meclisi Başkanı Claude Wiseler ve beraberindeki parlamento heyeti ile bir araya geldi.",
        "section": "TBMM heyet görüşmesi ve katılımcılar",
        "prefix": null,
        "suffix": null,
        "article": null,
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0404-ab-wiseler-agenda",
        "version_id": "0404-ab-wiseler-v1",
        "exact": "\"L&uuml;ksemburg Temsilciler Meclisi Başkanı Claude Wiseler, meclisteki siyasi grupların başkanları ve temsilcilerinden oluşan heyeti Gazi Meclisimizde ağırlamaktan memnuniyet duyduk. Heyetler arası g&ouml;r&uuml;şmemizde iki &uuml;lke arasındaki parlamenter diplomasiyi, b&ouml;lgesel gelişmeleri ve T&uuml;rkiye-Avrupa Birliği ilişkilerini kapsamlı bi&ccedil;imde ele aldık.\"",
        "section": "Murat Emir’e atfedilen görüşme gündemi",
        "prefix": null,
        "suffix": null,
        "article": null,
        "pdf_page_index": null,
        "printed_page": null
      }
    },
