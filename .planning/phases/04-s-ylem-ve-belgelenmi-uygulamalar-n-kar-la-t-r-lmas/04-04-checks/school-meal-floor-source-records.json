    {
      "kind": "passage",
      "values": {
        "id": "0404-tbmm-yemek-gunes-1021-motion",
        "version_id": "0404-tbmm-yemek-gunes-1021-v1",
        "exact": "21 Ekim 2026 tarihinde Iğdır Milletvekili Yılmaz Hun ve arkadaşları tarafından (20703 grup numaralı) eğitim sisteminde yaşanan sorunların araştırılması amacıyla Türkiye Büyük Millet Meclisine verilmiş olan Meclis araştırması önergesinin diğer önergelerin önüne alınarak görüşmelerinin 21/10/2026 Çarşamba günkü birleşimde yapılması önerilmiştir.",
        "section": "DEM Parti gündem önerisi, 20703 grup numarası",
        "prefix": null,
        "suffix": null,
        "article": null,
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0404-tbmm-yemek-gunes-1021-authority",
        "version_id": "0404-tbmm-yemek-gunes-1021-v1",
        "exact": "BAŞKAN - Yeni Parti Grubu adına Çanakkale Milletvekili Sayın İsmet Güneşhan.",
        "section": "Başkanın İsmet Güneşhan’ı Yeni Parti grubu adına çağırması",
        "prefix": null,
        "suffix": null,
        "article": null,
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0404-tbmm-yemek-gunes-1021-meal",
        "version_id": "0404-tbmm-yemek-gunes-1021-v1",
        "exact": "7) Çocuklarımıza -devamlı söylüyoruz- temiz içme suyu ve bir öğün ücretsiz yemek verilmelidir.",
        "section": "Yeni Parti grubunun 21 Ekim okul yemeği talebi",
        "prefix": null,
        "suffix": null,
        "article": null,
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0404-tbmm-yemek-gunes-1021-support",
        "version_id": "0404-tbmm-yemek-gunes-1021-v1",
        "exact": "Hepsinden de öte, bunların çözülebilmesi için öncelikle iktidarın bu sorunları görmesi ve kabul etmesi gerekmektedir. Dolayısıyla DEM PARTİ'nin bu grup önerisini desteklediğimizi belirtiyor, saygılarımı sunuyorum. (Yeni Parti sıralarından alkışlar)",
        "section": "Güneşhan’ın DEM Parti grup önerisine açık desteği",
        "prefix": null,
        "suffix": null,
        "article": null,
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0404-tbmm-yemek-gunes-1021-result",
        "version_id": "0404-tbmm-yemek-gunes-1021-v1",
        "exact": "BAŞKAN - Öneriyi oylarınıza sunuyorum: Kabul edenler... Kabul etmeyenler... Öneri kabul edilmemiştir.",
        "section": "Eğitim gündemi, 4. grup önerisinin hemen sonundaki ret",
        "prefix": null,
        "suffix": null,
        "article": null,
        "pdf_page_index": null,
        "printed_page": null
      }
    },
