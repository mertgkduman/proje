  "readings": [
    {
      "id": 294,
      "section_start": 26,
      "section_end": 28,
      "notes": "Adalet Bakanlığı bütçe görüşmesi metninin son üç bölümü. Fon soruşturmasında istenen açıklamalar ve iade süreci hakkındaki iddialar konuşmacıya aittir. 9 Kasım TBMM haberi konuşmayı ve bakanlığın ayrı açıklamasını kaydediyor.",
      "next_leads": [
        "https://tbmm.gov.tr/milletvekili/UyeKomisyonKonusmaTutanakDetay?tutanakId=91852",
        "https://tbmm.gov.tr/Haber/adalet-bakanliginin-2027-yili-butce-20261109131015"
      ]
    },
    {
      "id": 293,
      "section_start": 1,
      "section_end": 1,
      "notes": "Azerbaycan Cumhurbaşkanı İlham Aliyev ile Karabağ Zaferi yıldönümü için telefon görüşmesi duyurusu. Yeni Parti genel başkanının parti sıfatı ve tebrik görüşmesinin sınırlı içeriği ayrı tutuldu.",
      "next_leads": [
        "https://www.ankatv.com.tr/ozgur-ozel-ile-ne-konustular-aliyev-cephesinden-ilk-aciklama-geldi-1723/",
        "https://www.kozatv.com.tr/haber/ozgur-ozel-ile-ilham-aliyev-arasinda-telefon-gorusmesi"
      ]
    },
    {
      "id": 292,
      "section_start": 1,
      "section_end": 2,
      "notes": "Genel başkanın Kurucular Kurulu ve Parti Meclisi toplantılarına başkanlık ettiği duyuruluyor. Karar kütüğü, oylama ve yürürlük için ayrı kanıt gerekir. 295 aynı gün bu toplantıları daha geniş bir açıklamada anıyor.",
      "next_leads": [
        "0404-pm-degisikligi-event",
        "https://api.yeni-parti.org.tr/api/haberler/295"
      ]
    },
    {
      "id": 291,
      "section_start": 1,
      "section_end": 1,
      "notes": "Ulusal ön seçim sonrası başlık geçerli oyların tamamını, gövde yüzde 81,3 katılımı bildiriyor. Sonraki resmî kurultaydan ve yerel ön seçim toplamlarından ayrı. Sandık tutanağı bu duyuruda yer almıyor.",
      "next_leads": [
        "0404-genelbaskan-onsecim"
      ]
    },
    {
      "id": 290,
      "section_start": 1,
      "section_end": 3,
      "notes": "Özgür Özel’in kuruluş kurultayı genel başkanlık çalışma programı kitapçığına doğrudan bağlantı. 287 aynı başlık ve dosya adresine yönlendiriyor. Duyuru ve sonraki erişimde gözlenen PDF sürümünün bire bir eşitliği ayrı soru.",
      "next_leads": [
        "https://cdn.yeni-parti.org.tr/site/calisma_programi.pdf",
        "https://api.yeni-parti.org.tr/api/haberler/287"
      ]
    },
    {
      "id": 289,
      "section_start": 1,
      "section_end": 12,
      "notes": "Özgür Özel’in Ankara’da genel başkanlık ön seçimi için oy kullanması, ön seçim usulü, üye katılımı ve daha sonraki kurultay açıklaması. Mahalle meclisleri ve kampanya öngörüleri henüz gerçekleşme sonucu değil. Aidat ve 250 bin kampanya katılımcısı ifadeleri konuşmacının beyanı.",
      "next_leads": [
        "0404-genelbaskan-onsecim",
        "https://api.yeni-parti.org.tr/api/haberler/295"
      ]
    },
    {
      "id": 288,
      "section_start": 1,
      "section_end": 8,
      "notes": "Murat Emir’in basın açıklamasında Kartalkaya davası, fon soruşturması iddiaları ve 8 Kasım ön seçimine çağrı. 81 il ve üç bin sandık planı, seçim sonrası katılım sonucu dışındadır. Yargı işlemleri ve mali iddialar ilgili belgelerle ayrı izlenmeli.",
      "next_leads": [
        "0404-genelbaskan-onsecim",
        "https://tbmm.gov.tr/Haber/adalet-bakanliginin-2027-yili-butce-20261109131015"
      ]
    },
    {
      "id": 287,
      "section_start": 1,
      "section_end": 3,
      "notes": "Aynı çalışma programı PDF’sine yönlendiren ikinci arşiv kaydı. İki ayrı JSON belge kaydı ve bir PDF. Bu gövde politika uygulanması göstermiyor.",
      "next_leads": [
        "https://cdn.yeni-parti.org.tr/site/calisma_programi.pdf",
        "https://api.yeni-parti.org.tr/api/haberler/290"
      ]
    },
    {
      "id": 286,
      "section_start": 1,
      "section_end": 14,
      "notes": "Cem Aydın’a atfedilen YÖK binası önü açıklaması ve iktidar koşuluna bağlanan YÖK’ü kaldırma, özerklik ve rektör belirleme vaatleri. Eğitim kurumu yönetimine ilişkin vaadi ve olası bağımsız olay kaydını ayrı araştır.",
      "next_leads": [
        "https://yeni-parti.org.tr/haber/286"
      ]
    },
    {
      "id": 283,
      "section_start": 1,
      "section_end": 11,
      "notes": "Murat Emir’in TBMM’de Ecevit anması, COP31’e katılım ve iklim talepleri, fon soruşturması hakkındaki görüşleri. Kurumsal iklim zirvesi katılımı, konuşmada açıklanan beklenti ve heyet planından ayrıca belgelenmeli.",
      "next_leads": [
        "https://cdn.tbmm.gov.tr/TbmmWeb/Tutanak/28/5/14/Ham/7a9ec4d0-5611-415d-a3f5-6c7d1677d672.html",
        "https://api.yeni-parti.org.tr/api/haberler/283"
      ]
    },
    {
      "id": 282,
      "section_start": 1,
      "section_end": 17,
      "notes": "Murat Emir’in basın toplantısı Ecevit anması, Mekke Anlaşması ve fon soruşturması hakkında. Ticari ve kişisel iddialar konuşmacıya atfedilmeli. İşsizlik Fonu paragrafında metin 1,9 milyar ve 1,9 milyon ifadelerini ayrı kullanıyor.",
      "next_leads": [
        "https://tbmm.gov.tr/Haber/mekke-anlasmasi-nin-onaylanmasinin-20261105015200",
        "https://tbmm.gov.tr/Haber/adalet-bakanliginin-2027-yili-butce-20261109131015"
      ]
    },
    {
      "id": 281,
      "section_start": 1,
      "section_end": 4,
      "notes": "Metnin ilk 2.431 karakteri. Murat Emir’in Genel Kurulda Mekke Anlaşması ve asker gönderme olasılığına itiraz ettiği bölüm. Konuşma ve oylama ayrı, sevk sonucu için ek kanıt gerekir. 2431 sonrası 003 işinde.",
      "next_leads": [
        "https://tbmm.gov.tr/milletvekili/UyeGenelKurulKonusmalariDetay?eid=149580",
        "https://tbmm.gov.tr/Haber/mekke-anlasmasi-nin-onaylanmasinin-20261105015200"
      ]
    }
  ],
