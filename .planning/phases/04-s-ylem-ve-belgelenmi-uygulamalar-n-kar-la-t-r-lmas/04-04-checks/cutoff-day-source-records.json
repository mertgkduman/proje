    {
      "kind": "passage",
      "values": {
        "id": "0404-kesim-tbmm-speech-title",
        "version_id": "0404-kesim-tbmm-v1",
        "exact": "26.- İstanbul Milletvekili Gökhan Günaydın’ın, Türkiye Cumhuriyeti’nin kurucusu Mustafa Kemal Atatürk’e ve seksen yılda yapılanlara ilişkin açıklaması",
        "section": "Gökhan Günaydın’ın 26 numaralı konuşması",
        "prefix": null,
        "suffix": null,
        "article": null,
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0404-kesim-tbmm-speech",
        "version_id": "0404-kesim-tbmm-v1",
        "exact": "GÖKHAN GÜNAYDIN (İstanbul) - Bu yıl bütçeden 3 trilyon 975 milyar TL faiz parası ödeyeceksiniz. Bu 71 milyar dolar ediyor yani memleketin bütün varlığını bir yıllık faiz parasına peşkeş çekmiş bir iktidarsınız siz. (Yeni Parti sıralarından alkışlar) \"Seksen yılda ne yaptı?\" diyenlerin kafasına böyle teker teker vuracağız. cumhuriyete, Mustafa Kemal Atatürk'e ve birikime saygı duymayı öğreneceksiniz.",
        "section": "Birinci oturumda Günaydın’ın bütçe faizi değerlendirmesi",
        "prefix": null,
        "suffix": null,
        "article": null,
        "pdf_page_index": null,
        "printed_page": null
      }
    },
