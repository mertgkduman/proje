        "version_id": "0404-etik-23975-metni-v1",
        "exact": "MADDE 1- (1) Bu Kanunun amacı, siyasi ahlaksızlıkla mücadele etmek amacıyla",
        "section": "Madde 1, amaç ve kapsam",
        "prefix": null,
        "suffix": null,
