      "kind": "passage",
      "values": {
        "id": "0404-etik-grup-konusma-greco",
        "version_id": "0404-etik-grup-konusma-v1",
        "exact": "- \"GRECO kriterlerine tam uyumlu siyasi etik yasası Yeni Partinin ilk önerisidir\"",
        "section": "Siyasi etik teklifiyle ilgili GRECO açıklaması",
        "prefix": null,
        "suffix": null,
        "article": null,
