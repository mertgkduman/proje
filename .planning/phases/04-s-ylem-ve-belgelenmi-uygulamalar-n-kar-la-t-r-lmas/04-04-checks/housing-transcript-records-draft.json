    {
      "kind": "passage",
      "values": {
        "id": "0404-barinma-grup-oneri-p",
        "version_id": "0404-tbmm-barinma-tutanak-v1",
        "exact": "Sakarya Milletvekili Ayça Taşkent ve arkadaşları tarafından, ülkemizde giderek derinleşen barınma krizinin nedenlerinin ekonomik ve sosyal sonuçları ile çözüm önerilerinin belirlenmesi amacıyla 5/8/2026 tarihinde Türkiye Büyük Millet Meclisi Başkanlığına verilmiş olan (25 sıra no.lu) Meclis araştırması önergesinin diğer önergelerin önüne alınarak görüşmelerinin 7/8/2026 Cuma günkü birleşimde yapılması önerilmiştir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Yeni Parti grubunun 25 sıra sayılı araştırma önergesini öne alma talebi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0404-barinma-grup-oylama-p",
        "version_id": "0404-tbmm-barinma-tutanak-v1",
        "exact": "BAŞKAN - Önergeyi oylarınıza sunuyorum: Kabul edenler... Kabul etmeyenler... Önerge kabul edilmemiştir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Aynı görüşmenin ardından grup önerisinin oylanması",
        "pdf_page_index": null,
        "printed_page": null
      }
