    },
    {
      "kind": "passage",
      "values": {
        "id": "0404-ilk-yayin-takip-adalet-gorusme-yanit",
        "version_id": "0404-ilk-yayin-takip-adalet-gorusme-v1",
        "exact": "\"Suçtan elde edildiği değerlendirilen kazançların izi sürülmekte, yurt dışına çıkarılan değerlerin geri getirilmesi için hukuki mekanizmalar işletilmektedir. 9 Kasım 2026 itibarıyla soruşturma kapsamında 464 şüpheli bulunmaktadır. 120 kişi tutuklu olup 262 kişi hakkında adli kontrol tedbiri uygulanmıştır. Firari 40 şüpheli hakkında yakalama kararı çıkarılmıştır. Ayrıca 386 gerçek kişi ve 116 tüzel kişinin malvarlıklarına tedbir, banka hesaplarına bloke uygulanmıştır. Yine aynı tarih itibarıyla yaklaşık 31,5 milyar lira değerinde para, taşınmaz ve hisse senedi, TMSF bünyesinde oluşturulan gönüllü iade kapsamında iade edilmiştir.\"",
        "section": "Adalet Bakanı’nın fon soruşturması hakkında beyanı",
        "prefix": null,
        "suffix": null,
        "article": null,
        "pdf_page_index": null,
        "printed_page": null
      }
