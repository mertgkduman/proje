        "version_id": "0407-ergun-staj-floor-v1",
        "exact": "tüm boyutlarıyla araştırılması amacıyla 7/10/2026 tarihinde Türkiye Büyük Millet Meclisi Başkanlığına verilmiş olan Meclis araştırması önergesinin ön görüşmelerinin, Genel Kurulun 20 Ekim 2026 Salı günkü birleşiminde yapılmasına ilişkin önerisi",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "CHP’nin staj ve çıraklık araştırmasını gündeme alma talebi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-ergun-staj-floor-role",
        "version_id": "0407-ergun-staj-floor-v1",
        "exact": "İYİ Parti Grubu adına Muğla Milletvekili Metin Ergun. </span></p><p style=\"margin-top:0pt; margin-bottom:0pt; text-indent:40.3pt; text-align:justify; line-height:115%; font-size:9pt\"><span style=\"font-family:Arial\">Sayın Ergun, buyurun. (İYİ Parti ve YENİ YOL sıralarından alkışlar)</span></p><p style=\"margin-top:0pt; margin-bottom:0pt; text-indent:40.3pt; text-align:justify; line-height:115%; font-size:9pt\"><span style=\"font-family:Arial\">İYİ PARTİ GRUBU ADINA METİN ERGUN (Muğla)",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Metin Ergun’un İYİ Parti Grubu sıfatı",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
