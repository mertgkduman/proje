        "version_id": "0407-ergun-staj-floor-v1",
        "exact": "İYİ PARTİ olarak önergeyi desteklediğimizi ifade ediyor",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Metin Ergun’un İYİ Parti Grup desteği",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
