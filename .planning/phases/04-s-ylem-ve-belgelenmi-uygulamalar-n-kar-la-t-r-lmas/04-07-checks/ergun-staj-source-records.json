        "version_id": "0407-ergun-staj-floor-v1",
        "exact": "staj ve çıraklık başlangıçlarının sigortalılık başlangıcı sayılması, geçmiş dönemler için borçlanma",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Ergun’un sigorta başlangıcı ve borçlanma önerisi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
