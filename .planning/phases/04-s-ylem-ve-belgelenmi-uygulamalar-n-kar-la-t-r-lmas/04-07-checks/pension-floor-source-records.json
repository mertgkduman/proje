    {
      "kind": "passage",
      "values": {
        "id": "0407-floor-iyi-7573-49-usta",
        "version_id": "0407-floor-iyi-7573-49-v1",
        "exact": "İYİ PARTİ GRUBU ADINA ERHAN USTA (Samsun)",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Erhan Usta’nın İYİ Parti Grubu adına söz aldığını gösteren başlık",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-floor-iyi-7573-49-quote",
        "version_id": "0407-floor-iyi-7573-49-v1",
        "exact": "Bizim parti politikamız, asgari ücret düzeyinde olması",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "En düşük aylık için İYİ Parti politikasına ilişkin ifade",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-floor-iyi-7573-49-committee",
        "version_id": "0407-floor-iyi-7573-49-v1",
        "exact": "daha makul bir rakam olsun \"25 bin liraya çıkartalım.\" diye biz önerge verdik İYİ Parti Grubu olarak, önergemiz reddedilmişti.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Usta’nın komisyondaki 25.000 TL önergesine ilişkin beyanı",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-floor-iyi-7573-49-amendment",
        "version_id": "0407-floor-iyi-7573-49-v1",
        "exact": "\"20.000\" ibaresinin \"25.000\" ibaresiyle değiştirilmesini arz ve teklif ederiz.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "7. maddeye ilişkin Genel Kurul 25.000 TL önergesi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-floor-iyi-7573-49-defense",
        "version_id": "0407-floor-iyi-7573-49-v1",
        "exact": "Önerge üzerinde söz isteyen Bursa Milletvekili Sayın Yüksel Selçuk Türkoğlu.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Önerge üzerinde söz alan Yüksel Selçuk Türkoğlu",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-floor-iyi-7573-49-signers",
        "version_id": "0407-floor-iyi-7573-49-v1",
        "exact": "Turhan Çömez</span></p></td><td style=\"width:175.4pt; padding-right:0.5pt; padding-left:0.5pt; vertical-align:top\"><p style=\"margin-top:0pt; margin-bottom:0pt; text-align:center; font-size:9pt\"><span style=\"font-family:Arial\">Ayyüce Türkeş Taş</span></p></td><td style=\"width:175.4pt; padding-right:0.5pt; padding-left:0.5pt; vertical-align:top\"><p style=\"margin-top:0pt; margin-bottom:0pt; text-align:center; font-size:9pt\"><span style=\"font-family:Arial\">Burhanettin Kocamaz</span></p></td></tr><tr><td style=\"width:175.4pt; padding-right:0.5pt; padding-left:0.5pt; vertical-align:top\"><p style=\"margin-top:0pt; margin-bottom:0pt; text-align:center; font-size:9pt\"><span style=\"font-family:Arial\">Balıkesir</span></p></td><td style=\"width:175.4pt; padding-right:0.5pt; padding-left:0.5pt; vertical-align:top\"><p style=\"margin-top:0pt; margin-bottom:0pt; text-align:center; font-size:9pt\"><span style=\"font-family:Arial\">Adana</span></p></td><td style=\"width:175.4pt; padding-right:0.5pt; padding-left:0.5pt; vertical-align:top\"><p style=\"margin-top:0pt; margin-bottom:0pt; text-align:center; font-size:9pt\"><span style=\"font-family:Arial\">Mersin</span></p></td></tr><tr><td style=\"width:175.4pt; padding-right:0.5pt; padding-left:0.5pt; vertical-align:top\"><p style=\"margin-top:0pt; margin-bottom:0pt; text-align:center; font-size:9pt\"><span style=\"font-family:Arial\">Hüsmen Kırkpınar</span></p></td><td style=\"width:175.4pt; padding-right:0.5pt; padding-left:0.5pt; vertical-align:top\"><p style=\"margin-top:0pt; margin-bottom:0pt; text-align:center; font-size:9pt\"><span style=\"font-family:Arial\">Lütfü Türkkan</span></p></td><td style=\"width:175.4pt; padding-right:0.5pt; padding-left:0.5pt; vertical-align:top\"><p style=\"margin-top:0pt; margin-bottom:0pt; text-align:center; font-size:9pt\"><span style=\"font-family:Arial\">Yüksel Selçuk Türkoğlu",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "25.000 TL Genel Kurul önergesini imzalayan altı milletvekili",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-floor-iyi-7573-49-rejection",
        "version_id": "0407-floor-iyi-7573-49-v1",
        "exact": "Önergeyi oylarınıza sunuyorum: Kabul edenler... Kabul etmeyenler... Önerge kabul edilmemiştir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "25.000 TL önergesini izleyen oylama sonucu",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
