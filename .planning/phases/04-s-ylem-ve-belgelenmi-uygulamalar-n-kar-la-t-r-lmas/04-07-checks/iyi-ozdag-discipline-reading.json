  "queries": [
    "İYİ Parti Ümit Özdağ 16 Kasım 2020 Müşterek Disiplin Kurulu oybirliği 76/D",
    "Ümit Özdağ Ankara 1 Asliye Hukuk Mahkemesi kesin 13 Ocak 2021 esas karar numarası",
    "20 Ocak 2021 Ümit Özdağ gerekçeli karar sevk savunma İYİ Parti",
    "4 Mart 2021 Ümit Özdağ İYİ Parti istifa TBMM basın toplantısı"
  ],
  "source_reads": [
