    {
      "kind": "passage",
      "values": {
        "id": "0407-policy-plenary-agenda",
        "version_id": "0407-policy-plenary-v1",
        "exact": "2.- İYİ Parti Grubunun, Grup Başkan Vekili İstanbul Milletvekili Mehmet Satuk Buğra Kavuncu tarafından, kamu zararına yol açan uygulamaların önlenmesi, 2023-2025 döneminde uygulanan tasarruf tedbirlerinin hedeflerine ne ölçüde ulaştığı, kamu maliyesine gerçek etkisinin ne olduğu, hangi alanlarda başarısızlık yaşandığı, tasarruf yükünün hangi toplumsal kesimlere yansıdığı ve kamu kaynaklarının ne ölçüde etkin kullanıldığı hususlarının tüm boyutlarıyla ortaya konulması, tespit edilecek aksaklıkların giderilmesi amacıyla 3/12/2025 tarihinde Türkiye Büyük Millet Meclisi Başkanlığına verilmiş olan Meclis araştırması önergesinin ön görüşmelerinin, Genel Kurulun 3 Aralık 2025 Çarşamba günkü birleşiminde yapılmasına ilişkin önerisi",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "İYİ Parti Grubunun aynı güne ön görüşme talebi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-policy-plenary-vote",
        "version_id": "0407-policy-plenary-v1",
        "exact": "BAŞKAN - İYİ Parti grup önerisini oylarınıza sunuyorum: Kabul edenler... Kabul etmeyenler... Öneri kabul edilmemiştir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "İYİ Parti grup önerisinin oylanması",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
