        "suffix": null,
        "article": null,
        "section": "Şenol Sunat’ın 9. madde üzerindeki grup sıfatı",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-fund-oct22-sunat-objection",
        "version_id": "0407-fund-oct22-v1",
        "exact": "olağan dışı getirilerin geri ödenmesi isteğe bağlı bir mekanizmaya bırakılmaktadır. İYİ Parti olarak bu düzenlemeye itiraz ediyoruz.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Sunat’ın isteğe bağlı iade itirazı",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-fund-oct22-electron",
        "version_id": "0407-fund-oct22-v1",
        "exact": "Divanda ihtilaf olduğundan dolayı elektronik cihazla oylamaya başvuracağım.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Teklifin tümü için elektronik oylama açıklaması",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-fund-oct22-accept",
