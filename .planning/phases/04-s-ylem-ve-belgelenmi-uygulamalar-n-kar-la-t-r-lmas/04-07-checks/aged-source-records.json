    {
      "kind": "passage",
      "values": {
        "id": "0407-aged-pension-2024-session-proposal",
        "version_id": "0407-aged-pension-2024-session-v1",
        "exact": "Manisa Milletvekili Şenol Sunat ve 19 milletvekili tarafından yaşlı vatandaşların karşılaştığı sosyal ve ekonomik sorunların araştırılarak bu sorunlara yönelik yapıcı çözüm önerileri geliştirilmesi amacıyla 12/10/2023 tarihinde",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Gündeme alınması istenen Ekim 2023 önerisi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-aged-pension-2024-session-sunat",
        "version_id": "0407-aged-pension-2024-session-v1",
        "exact": "İYİ PARTİ GRUBU ADINA ŞENOL SUNAT (Manisa)",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Gündeme alma önerisini savunan Şenol Sunat’ın grup yetkisi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-aged-pension-2024-session-sunat-statement",
        "version_id": "0407-aged-pension-2024-session-v1",
        "exact": "İYİ Parti Grubu adına yaşlı vatandaşlarımızın mağduriyetlerinin giderilmesi amacıyla sunduğumuz araştırma önergemiz üzerine söz aldım.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Sunat’ın grup adına araştırma önerisini savunduğu cümle",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-aged-pension-2024-session-dem-role",
        "version_id": "0407-aged-pension-2024-session-v1",
        "exact": "DEM PARTİ GRUBU ADINA ADALET KAYA (Diyarbakır)",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Adalet Kaya’nın DEM Parti Grubu adına konuştuğu başlık",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0407-aged-pension-2024-session-dem-support",
        "version_id": "0407-aged-pension-2024-session-v1",
        "exact": "Bu sebeple, yaşlı bakımevlerinde hizmetin iyileştirilmesine yönelik bu önergeyi DEM PARTİ olarak destekliyoruz.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "DEM Parti Grubu adına yapılan sözlü destek açıklaması",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
