						<div class="elementor-element elementor-element-1b3d799 elementor-widget elementor-widget-html" data-id="1b3d799" data-element_type="widget" data-e-type="widget" data-widget_type="html.default">
					<script>
jQuery(document).ready(function($) {
// Menü toggle
    $('#menu-toggle').off('click').on('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        $(this).toggleClass('active');
        $('#menu-panel').toggleClass('active');
    });
    
// Dışarı tıklandığında kapat
$(document).on('click', function(event) {
        if (!$(event.target).closest('#menu-toggle, #menu-panel, .elementor-element-5e422e8').length) {
            $('#menu-toggle').removeClass('active');
            $('#menu-panel').removeClass('active');
        }
    });
// ESC ile kapat
    $(document).on('keydown', function(event) {
        if (event.key === 'Escape' && $('#menu-panel').hasClass('active')) {
            $('#menu-toggle').removeClass('active');
            $('#menu-panel').removeClass('active');
        }
    });
// Menü içindeki linklere tıklandığında menüyü kapat
$('#menu-panel a').on('click', function() {
        setTimeout(function() {
            $('#menu-toggle').removeClass('active');
            $('#menu-panel').removeClass('active');
        }, 300);
    });
});
</script>				</div>
