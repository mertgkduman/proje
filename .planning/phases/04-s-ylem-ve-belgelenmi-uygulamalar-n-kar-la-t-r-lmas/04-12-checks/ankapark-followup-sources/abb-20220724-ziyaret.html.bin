<li data-level="0" class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="" data-bs-toggle="dropdown" target="">Başkan</a><ul class="dropdown-menu"><li data-level="1" class="nav-item"><a class="dropdown-item" href="/baskan" target="_self"><i class="fa-duotone fa-address-card"></i> Hakkında</a></li><li data-level="1" class="nav-item"><a class="dropdown-item" href="https://baskent153.ankara.bel.tr/Basvuru/25" target="_blank"><i class="fa-duotone fa-pen-to-square"></i> Başkan'a Mesaj</a></li><li data-level="1" class="nav-item"><a class="dropdown-item" href="/baskan/baskanin-yetkileri" target="_self"><i class="fa-duotone fa-list-ul"></i> Başkan'ın Yetkileri</a></li><li data-level="1" class="nav-item"><a class="dropdown-item" href="/baskan/fotograf-albumu" target="_self"><i class="fa-duotone fa-image"></i> Fotoğraf Albümü</a></li><li data-level="1" class="nav-item"><a class="dropdown-item" href="https://s.ankara.bel.tr/s3/abb/2026/06/18/2035aa8d-7f39-469d-b735-ec4c29e739e9.pdf" target="_self"><i class="fa-duotone fa-file-pdf"></i> Mal Varlığı</a></li><li data-level="1" class="nav-item"><a class="dropdown-item" href="/baskan/ilkleri" target="_self"><i class="fa-duotone fa-list-ul"></i> İlkleri</a></li></ul></li><li data-level="0" class="nav-item dropdown"><a class="nav-link dropdown-toggle" href="" data-bs-toggle="dropdown" target="">Kurumsal</a><ul class="dropdown-menu"><li data-level="1" class="nav-item"><a class="dropdown-item" href="/teskilat-semasi" target="_self"><i class="fa-duotone fa-sitemap"></i> Teşkilat Şeması</a></li><li data-level="1" class="nav-item dropdown-submenu dropend"><a class="dropdown-item dropdown-toggle" href="" data-bs-toggle="dropdown" target="_self"><i class="fa-duotone fa-buildings"></i> Belediye Hakkında</a><ul class="dropdown-menu"><li data-level="2" class="nav-item"><a class="dropdown-item" href="/kurumsal/tarihce" target="_self"><i class="fa-duotone fa-memo-circle-info"></i> Tarihçe</a></li><li data-level="2" class="nav-item"><a class="dropdown-item" href="/kurumsal/misyon-ve-vizyon" target="_self"><i class="fa-duotone fa-list-check"></i> Misyon ve Vizyon</a></li><li data-level="2" class="nav-item"><a class="dropdown-item" href="/kurumsal/yetki-alani" target="_self"><i class="fa-duotone fa-map-location-dot"></i> Yetki Alanı</a></li><li data-level="2" class="nav-item"><a class="dropdown-item" href="/etik-komisyonu" target="_self"><i class="fa-duotone fa-users-viewfinder"></i> Etik Komisyonu</a></li><li data-level="2" class="nav-item"><a class="dropdown-item" href="/kurumsal/belediye-encumeni" target="_self"><i class="fa-duotone fa-people-group"></i> Belediye Encümeni</a></li><li data-level="2" class="nav-item"><a class="dropdown-item" href="/dokumanlar/kamu-hizmet-standartlari" target="_self"><i class="fa-duotone fa-list-tree"></i> Kamu Hizmet Standartları</a></li></ul></li><li data-level="1" class="nav-item dropdown-submenu dropend"><a class="dropdown-item dropdown-toggle" href="" data-bs-toggle="dropdown" target="_self"><i class="fa-duotone fa-users"></i> Meclis</a><ul class="dropdown-menu"><li data-level="2" class="nav-item"><a class="dropdown-item" href="/meclis/baskan-ve-vekiller" target="_self"><i class="fa-duotone fa-user"></i> Meclis Başkanı ve Vekiller</a></li><li data-level="2" class="nav-item"><a class="dropdown-item" href="/meclis/uyeler" target="_self"><i class="fa-duotone fa-users"></i> Meclis Üyeleri</a></li><li data-level="2" class="nav-item"><a class="dropdown-item" href="/meclis/kararlar" target="_self"><i class="fa-duotone fa-files"></i> Meclis Kararları</a></li><li data-level="2" class="nav-item"><a class="dropdown-item" href="/meclis/gundem" target="_self"><i class="fa-duotone fa-calendar-days"></i> Meclis Gündemi</a></li><li data-level="2" class="nav-item"><a class="dropdown-item" href="/meclis/komisyonlar" target="_self"><i class="fa-duotone fa-people-group"></i> Meclis Komisyonları</a></li><li data-level="2" class="nav-item"><a class="dropdown-item" href="/meclis/