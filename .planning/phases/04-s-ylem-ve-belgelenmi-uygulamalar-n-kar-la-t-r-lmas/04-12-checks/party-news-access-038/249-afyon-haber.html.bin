                    class="dropdown-item"
                    onclick="initiateDesktopShare(event, 'next')"
                    data-platform="next"
                    data-share-url="https://www.afyonhaber.com/kilicdaroglu-dp-genel-merkezini-ziyaret-etti"
                    data-share-title="KILIÇDAROĞLU, DP GENEL MERKEZİNİ ZİYARET ETTİ"
