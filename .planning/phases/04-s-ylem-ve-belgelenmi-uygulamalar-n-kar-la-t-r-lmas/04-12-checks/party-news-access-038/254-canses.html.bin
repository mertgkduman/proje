    .ft4-news form:focus-within { box-shadow: 0 0 0 3px rgba(207, 29, 57, .25); box-shadow: 0 0 0 3px color-mix(in srgb, var(--footer-text-hover-color) 30%, transparent); }
    .ft4-news input { flex: 1 1 auto; min-width: 0; padding: 8px 16px; font-size: 14px; color: #374151; background: transparent; border: 0; outline: none; }
    .ft4-news button { padding: 8px 22px; font-size: 14px; font-weight: 600; white-space: nowrap; color: var(--footer-bg-color, #fff); background: var(--footer-text-hover-color); border-radius: 9999px; transition: filter .2s; }
    .ft4-news button:hover { filter: brightness(.9); }
    .ft4-sep { width: 56px; height: 3px; margin: 40px auto 0; border-radius: 3px; background: var(--footer-text-hover-color); }
    .ft4-bottom { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 24px 16px 20px; }
    .ft4-bottom ul { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 20px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
    .ft4-bottom-text { max-width: 720px; font-size: 13px; opacity: .8; }
    .dark .ft4-news form { background: #1f2937; border-color: #374151; }
    .dark .ft4-news input { color: #e5e7eb; }
</style>
