                    <div class="flex items-center">
                        <input
                                type="checkbox"
                                x-model="isTOSAccepted"
                                @change="if (newComment.text.trim().length < 3) {
        Swal.fire({
            title: 'Uyarı',
            text: 'Yorum alanı en az 3 karakter olmalıdır.',
            icon: 'warning',
            timer: 3000,
            showConfirmButton: false
        });
        isTOSAccepted = false;
    }"
                                name="usertos"
                                id="usertos-134934"
                                class="mr-2"
