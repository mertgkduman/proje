    .ft4-social a:hover { color: var(--footer-bg-color, #fff); background: var(--footer-text-hover-color); border-color: var(--footer-text-hover-color); transform: translateY(-2px); }
    .ft4-apps { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 20px; }
    .ft4-links { display: flex; flex-direction: column; align-items: center; gap: 12px; max-width: 900px; margin-top: 32px; }
    .ft4-links ul { display: flex; flex-wrap: wrap; justify-content: center; row-gap: 8px; font-size: 15px; }
    .ft4-links li { display: inline-flex; align-items: center; }
    .ft4-links li + li::before { content: ""; width: 4px; height: 4px; margin-inline: 12px; border-radius: 9999px; background: currentColor; opacity: .35; }
    .ft4-links a:not([style]) { opacity: .85; transition: opacity .2s; }
    .ft4-links a:not([style]):hover { opacity: 1; }
    .ft4-news { width: 100%; max-width: 460px; margin-top: 36px; }
    .ft4-news-title { margin: 0 0 10px; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; opacity: .8; }
