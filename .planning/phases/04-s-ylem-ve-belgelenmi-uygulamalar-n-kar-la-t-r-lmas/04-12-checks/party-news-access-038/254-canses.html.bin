                    <textarea x-model="newComment.text" x-on:input="remainingChars = 1000 - newComment.text.length" class="dark:bg-customdarkgray-900 h-24 text-sm bg-gray-100 hover:bg-white" maxlength="1000" placeholder="Herkese açık bir yorum ekleyin" required></textarea>
                    <div x-cloak x-show="remainingChars <=0" class="text-xs p-2 bg-red-100 border border-red-400 text-red-700 rounded-md mt-2">
