                                        <template hidden data-tmv-ad="89"></template>    <template hidden data-tmv-ad-end></template>                                    

                                </div>

                                <style>

        @media (min-width:1024px){
            .post-cols{display:flex;gap:1rem;align-items:flex-start}
            .post-cols > .post-main{flex:1 1 0%;min-width:0}
            .post-cols > .post-rail{width:300px;flex:0 0 300px;align-self:stretch}
        }
