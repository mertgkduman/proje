.header-13 .top-header ul li:last-child {
    padding-right: 0;
    margin-right: 0;
}

/* ========================================
   HEADER 13 - MENU TWO ROWS (SKEW EFFECT)
   ======================================== */
.header-13 .menu-two-rows::before {
    top: 0;
    left: 19px;
    content: "";
    bottom: auto;
    height: 100%;
    width: 197px;
    position: absolute;
    background-color: var(--te-color);
    -webkit-transform: skew(-30deg);
    -moz-transform: skew(-30deg);
    -ms-transform: skew(-30deg);
    -o-transform: skew(-30deg);
    transform: skew(-30deg);
    z-index: 2;
}
.header-13 .main-header .container::before {
    border-left: 3px solid var(--te-accent-color);
    bottom: 0;
    content: "";
    height: 77px;
    left: 218px;
    margin-left: 0;
    position: absolute;
    top: 15px;
    transform: rotate(30deg) translateY(-8px);
    z-index: 3;
}
.header-13 .menu-two-rows .top-menu ul:first-child {
    margin-left: 85px;
}
.header-13 .menu-two-rows .top-menu i {
    color: var(--te-accent-color);
}

/* ========================================
   HEADER 13 - CATEGORY MENU (Swiper)
   ======================================== */
.header-13 .header-13-category-menu {
    position: relative;
    height: 38px;
    padding-left: 60px;
    padding-right: 45px;
    background-color: var(--te-accent-color);
    overflow: visible;
}
.header-13 .header-13-categories-swiper {
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    height: 100%;
}
.header-13 .header-13-categories-swiper .swiper-wrapper {
    display: flex;
    align-items: center;
}
.header-13 .header-13-categories-swiper .swiper-slide {
    width: auto;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
}
.header-13 .header-13-categories-swiper .nav-link {
    white-space: nowrap;
    transition: all 0.3s ease;
    color: #333;
    padding: 0.25rem 1rem !important;
    border-right: 0.5px solid black;
}
.header-13 .header-13-categories-swiper .nav-link:hover {
    color: #555;
}

/* Swiper Navigation Buttons */
.header-13 .header-13-swiper-button-prev,
.header-13 .header-13-swiper-button-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
}
.header-13 .header-13-swiper-button-prev {
    left: 65px;
}
.header-13 .header-13-swiper-button-next {
    right: 5px;
}
.header-13 .header-13-swiper-button-prev.swiper-button-active,
.header-13 .header-13-swiper-button-next.swiper-button-active {
    opacity: 1;
    pointer-events: auto;
}
.header-13 .header-13-swiper-button-prev:hover,
.header-13 .header-13-swiper-button-next:hover {
    background: transparent;
    color: white;
    border-color: white;
    transform: translateY(-50%) scale(1.1);
}
.header-13 .header-13-swiper-button-prev i,
.header-13 .header-13-swiper-button-next i {
    font-size: 0.75rem;
}

/* ========================================
   HEADER 13 - BREAKING NEWS
   ======================================== */
.header-13 .breaking-news {
    align-items: center;
    position: relative;
    overflow: hidden;
}
.header-13 .breaking-news-label {
    flex-shrink: 0;
    margin-left: 35px;
}
.header-13 .breaking-news-wrapper {
    flex: 1;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 15px, black calc(100% - 15px), transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 15px, black calc(100% - 15px), transparent);
}
.header-13 .breaking-news-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll-13 60s linear infinite;
}
.header-13 .breaking-news-track:hover {
    animation-play-state: paused;
}
@keyframes marquee-scroll-13 {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}
.header-13 .breaking-news-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    font-size: 15px;
}
.header-13 .breaking-news-list li {
    padding-right: 3rem;
    position: relative;
}
.header-13 .breaking-news-list li::after {
    content: "\25CF";
    position: absolute;
    right: 1.25rem;
    color: var(--te-color);
    opacity: 0.5;
}
.header-13 .breaking-news-item {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    white-space: nowrap;
    transition: color 0.2s ease;
}
.header-13 .breaking-news-item:hover {
    color: var(--te-color);
}

/* ========================================
   HEADER 13 - MOBILE CATEGORIES
   ======================================== */
.header-13 .mobile-categories-wrapper {
    background-color: var(--te-accent-color);
}
.header-13 .mobile-categories-wrapper::before {
    background: linear-gradient(to right, var(--te-accent-color), transparent);
}
.header-13 .mobile-categories-wrapper::after {
