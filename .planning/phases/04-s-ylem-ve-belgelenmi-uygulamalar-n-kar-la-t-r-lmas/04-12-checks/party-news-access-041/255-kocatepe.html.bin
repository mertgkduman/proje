            padding-top: env(safe-area-inset-top);
            padding-bottom: env(safe-area-inset-bottom);
        }
        
        /* PWA badge göster (eğer varsa) */
        .pwa-only {
            display: block !important;
        }
    }
    
    /* Varsayılan olarak gizle */
    .pwa-only {
        display: none;
    }
</style>

