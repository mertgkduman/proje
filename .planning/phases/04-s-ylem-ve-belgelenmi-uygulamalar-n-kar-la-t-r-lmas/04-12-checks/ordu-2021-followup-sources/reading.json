      "pages_zero_based": [
        6
      ],
      "reading": "2024 kesin büyükşehir aday listesinde Ordu için Demokrat Parti Serhat Çelebioğlu. Sütun dizilişi sayfa görselinden doğrulandı. 2021 kongresinde adı yönetim listesinde yer alsa da adaylık ayrı işlem.",
      "page_text_sha256": {
        "6": "22f15ba1a57eaecb3201f63b5c0b9d799163de03f1fcc7535e9c5260581d7adb"
      }
    },
    {
      "publisher": "Yüksek Seçim Kurulu",
      "url": "https://www.ysk.gov.tr/doc/dosyalar/docs/31%20MART%202024%20MAHALL%C4%B0%20%C4%B0DARELER%20B%C3%9CLTEN%C4%B0.pdf",
      "original_path": "ysk-2024-mahalli-bulten.pdf",
      "sha256": "422099fba189c023d8bae3c6e9a76919a6d70ce53506afcc8b540d1520e90ea3",
