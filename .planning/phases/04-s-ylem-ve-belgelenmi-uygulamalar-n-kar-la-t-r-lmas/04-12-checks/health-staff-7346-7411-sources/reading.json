        "manifest_path": "views/03cedf6eac9ccef9a455216a86f36064/manifest.json",
        "manifest_sha256": "8504c284c52efc6f1be566600d8b28c5a6aded051882bd4784f3aab2be3b26dd"
      }
    },
    {
      "publisher": "TBMM",
      "url": "https://cdn.tbmm.gov.tr/KKBSPublicFile/D27/Y5/T2/KanunMetni/3d0dbe57-96de-4436-9df9-40e59d38571c.html",
      "original_path": "tbmm-7346-kabul.html.bin",
