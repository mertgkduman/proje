      }
    },
    {
      "publisher": "TBMM",
      "url": "https://cdn.tbmm.gov.tr/KKBSPublicFile/D27/Y5/T2/DosyaKomisyonRaporunuVerdi/2ab6dd71-937b-48ad-82d8-3a93e5eb750f.pdf",
      "original_path": "tbmm-337-komisyon-raporu.pdf",
