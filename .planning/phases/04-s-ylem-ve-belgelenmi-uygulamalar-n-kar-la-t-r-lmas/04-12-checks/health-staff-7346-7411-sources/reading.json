      }
    },
    {
      "publisher": "TBMM",
      "url": "https://cdn.tbmm.gov.tr/KKBSPublicFile/D27/Y5/T2/KanunMetni/2c0b0a6c-36b0-4f63-b22d-a5916fc941f4.html",
      "original_path": "tbmm-7411-kabul.html.bin",
