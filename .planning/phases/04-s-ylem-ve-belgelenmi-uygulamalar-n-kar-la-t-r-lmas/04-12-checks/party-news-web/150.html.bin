    <style>
      
        header .header-inline .item .more-info{
            margin-top: 12px;
        }
        header .header-inline .border-card {
            margin-top: 12px;
            margin-bottom: 24px;
            width: 100%;
            height: 145px;
            background: #ffffff;
            padding: 9px;
            box-sizing: border-box;
            -webkit-box-shadow: -12px -12px 0 0 rgba(255, 255, 255, 0.5);
            -moz-box-shadow: -12px -12px 0 0 rgba(255, 255, 255, 0.5);
            box-shadow: -12px -12px 0 0 rgba(255, 255, 255, 0.5);
            display: flex;
        }
        h6{
            font-size: 13pt!important;
            font-weight: normal!important;
        }
        .dropdown-menu .nav-link span{
            color: #262626;
            padding-right: 25px;
            margin-left: 15px;
        }
        .navbar-nav{
            margin-top: 20px;
        }
        .popup{
            width: 400px;
            height: 100vh;
            position: absolute;
            background: #8d0f0f;
            z-index: 999999;
            right: 0;
            display: flex;
            align-items: baseline;
            justify-content: center;
            padding-top: 80px;
        }
        .popup-close{
            position: absolute;
            top: 10px;
            left: 15px;
            cursor: pointer;
            font-size: 25pt;
            color: #ffffff;
        }
        .dropdown-menu{
            width: 330px;
        }
        .dropdown-menu{
            position: absolute;
            z-index: 999999999;
        }
        .mobile ul li a{
            color: #ffffff!important;
        }
        section .news .left{
            position: relative;
            width: 26%;
            -webkit-box-shadow: 0px 0px 5px 3px rgba(235,235,235,1);
            -moz-box-shadow: 0px 0px 5px 3px rgba(235,235,235,1);
            box-shadow: 0px 0px 5px 3px rgba(235,235,235,1);
            height: auto;
            padding: 18px;
        }
        header{
            -webkit-box-shadow: 0px 2px 7px 2px rgba(143,143,143,1);
            -moz-box-shadow: 0px 2px 7px 2px rgba(143,143,143,1);
            box-shadow: 0px 2px 7px 2px rgba(143,143,143,1);
        }
        @media screen and (max-width:480px){
 header .header-inline .item .title {
    font-size: 14px;
    padding-bottom: 6px;
  }}
  header{
  overflow:unset!important
  }
  .popup-resim{
  max-width:95vw!important}
  .popup{
  min-width:390px!important;
  max-width:100vw;
  height:100vh
  }
  section .right .yerel-yonetim .box p {
    font-size: 10pt;
    margin-top: 10px;
    color: #8e8d8d;
}
section .right .yerel-yonetim .box h3 {
    font-size: 15pt;
    margin-top: 10px;
    color: #000;
}
section .right .yerel-yonetim .box {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-right: 30px;
}
section .right .genel-baskan h3 {
    font-size: 15pt;
    margin-top: 10px;
    color: #000;
}

section .right .genel-baskan p {
    font-size: 10pt;
    margin-top: 10px;
    color: #8e8d8d;
}
@media only screen and (max-width: 600px) {
  
}

section.first-section {
    height: auto;
    background: #e2eaf3;
    margin-top: 0px;
    border-top: 1px solid #adb2b9;
    border-bottom: 1px solid #adb2b9;
}

footer .footer-card .center .center-inline ul li {
    line-height: 25px;
    padding-left: 25px;
    font-size: 11pt;
    color: #ffffff!important
}

footer .footer-card .footer-inline {
    padding-top: 80px;
    padding-bottom: 40px;
}

.right-inline ul li{
font-size: 11pt!important
}
.news .container{
min-height: 800px!important 
}
.line img{
height:3px!important
}
section .right .bottom img {
    width: 100%;
   height: auto!important
}

footer .footer-card .center .center-inline ul li {
    padding-left: 0px!important
}

footer .footer-card .right .right-inline ul li {
    padding-left: 0px!important
}

section .right .yerel-yonetim .box p{
font-size: 12pt;
}

section .right .genel-baskan p{
font-size: 12pt;
}

section .right .yerel-yonetim .box a p{
font-size: 12pt;
}

element.style {
}
section .right .genel-baskan p {
    font-size: 12pt;
}
section .right .genel-baskan p {
    margin-top: 10px;
    color: #5f5f5f!important;
}
section .right .yerel-yonetim .box p{
    color: #5f5f5f!important;
}
section .right .genel-baskan a p{
margin-top:0
}
section .right .yerel-yonetim .box a p {
margin-top:0
}
section .right .genel-baskan a p:hover{
margin-top:0
}
section .right .yerel-yonetim .box a p:hover {
margin-top:0
}
/*Kategori kutu yükseklik*/
  .klm{
      height: 400px!important;
  }

section .right .yerel-yonetim .box p{
width:200px;
text-align:center
}
section .container .section-one .bottom {
height:180px
}
section .right .yerel-yonetim .box h3{
font-size:12pt;
}
section .right .yerel-yonetim .box p{
font-size:11pt
}
        i:hover {
          color: #8D0401!important;
          transition: 500ms;
        }
        
