        };

        window.iettSaatleriGetir = function() {
            const h = document.getElementById('hatIett').value, div = document.getElementById('sonucIett');
            if (!h) { div.innerHTML = '<div class="hata-mesaji">Lütfen bir hat seçin.</div>'; return; }
            const b = iettBilgi[h], dk = new Date().getHours() * 60 + new Date().getMinutes();
            let html = '<div class="guzergah-bilgi"><strong>📍 Güzergah:</strong>' + b.g + '<br><span class="sure-etiket">⏱️ Süre: ' + b.s + '</span></div>';
            let u = b.st.split(',').map(x => x.trim()).filter(saat => sH(saat) > dk);
            u.sort((a, x) => sH(a) - sH(x));
            const gos = u.slice(0, 6);
            html += gos.length ? '<div class="sonuc-baslik">Yaklaşan Seferler:</div>' + gos.map(saat => '<div class="sefer-karti"><div class="saat">🕒 ' + saat + '</div><div class="kalkis-yeri">Kalkış:<br><b>' + b.k + '</b></div></div>').join('') : '<div class="hata-mesaji">Bugün için başka sefer kalmamıştır.</div>';
            div.innerHTML = html;
        };
    })();
    </script>
