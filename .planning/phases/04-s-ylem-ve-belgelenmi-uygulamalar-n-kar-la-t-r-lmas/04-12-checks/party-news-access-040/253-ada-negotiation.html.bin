        <style>
    .ulasim-sidebar-kutu{background:#fff;border:1px solid #e2e8f0;border-top:4px solid #d90423;border-radius:10px;overflow:hidden;margin-bottom:20px;box-shadow:0 4px 15px rgba(0,0,0,0.06);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;clear:both}
    .ulasim-sekme-bar{display:flex;background:#f8fafc;border-bottom:1px solid #e2e8f0}
    .ulasim-sekme-btn{flex:1;padding:12px 8px;border:none;background:transparent;font-size:14px;font-weight:800;color:#475569;cursor:pointer;border-bottom:3px solid transparent}
