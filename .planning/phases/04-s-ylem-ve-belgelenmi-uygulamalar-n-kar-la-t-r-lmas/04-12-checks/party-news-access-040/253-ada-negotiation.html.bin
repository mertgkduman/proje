    .ulasim-form-group select{width:100%;padding:9px 10px;border:1px solid #cbd5e1;border-radius:6px;font-size:13px;font-weight:600;color:#0f172a;background:#fff;outline:none;box-sizing:border-box}
    .ulasim-btn-ara{width:100%;padding:11px;border:none;border-radius:6px;font-size:13.5px;font-weight:800;color:#fff;cursor:pointer;margin-top:4px}
    .btn-vapur{background:#0ea5e9}.btn-vapur:hover{background:#0284c7}
    .btn-iett{background:#f59e0b}.btn-iett:hover{background:#d97706}
    .sonuc-baslik{font-size:12px;color:#64748b;margin-top:14px;border-bottom:1px solid #e2e8f0;padding-bottom:6px;font-weight:800}
    .sefer-karti{background:#f8fafc;border-left:4px solid #10b981;padding:9px 10px;margin-top:8px;border-radius:4px;display:flex;justify-content:space-between;align-items:center}
    .sefer-karti .saat{font-size:15.5px;font-weight:900;color:#0f172a}
    .sefer-karti .firma,.sefer-karti .kalkis-yeri{font-size:11px;color:#334155;background:#e2e8f0;padding:4px 7px;border-radius:4px;text-align:right;font-weight:700;line-height:1.2}
