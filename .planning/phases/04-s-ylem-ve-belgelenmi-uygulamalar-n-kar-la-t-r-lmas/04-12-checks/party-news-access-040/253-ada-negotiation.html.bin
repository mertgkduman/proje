    <script>
    (function() {
        window.ulasimSekmeDegistir = function(s) {
            document.getElementById('sekmeVapur').classList.toggle('aktif', s === 'vapur');
            document.getElementById('sekmeIett').classList.toggle('aktif', s === 'iett');
            document.getElementById('icerikVapur').style.display = s === 'vapur' ? 'block' : 'none';
            document.getElementById('icerikIett').style.display = s === 'iett' ? 'block' : 'none';
        };

        const seferler = [];
        const F = { P: 'Prenstur', M: 'Mavi Marmara', T: 'Turyol', S: 'Şehir Hatları' };
        function vE(k, v, st, f, t = 'hergun') {
            v.split(',').forEach(vr => st.split(',').forEach(s => {
                if (!s) return;
                let tp = t;
                if (s.includes('*')) { tp = 'pazar_yok'; s = s.replace('*', ''); }
                seferler.push({ kalkis: k, varis: vr.trim(), saat: s.trim(), firma: F[f] || f, tip: tp });
            }));
        }

        const hamVapur = "Kartal|Buyukada,Heybeliada|06:20*,07:15,08:00,08:30,09:00,09:30,10:30,11:30,12:30,13:30,14:30,15:30,16:00,16:30,17:00,17:30,18:30,19:30,20:30|P;Buyukada|Kartal|07:15*,08:15,08:55,09:25,09:55,10:25,11:25,12:25,13:25,14:25,15:25,16:25,17:00,17:30,18:00,18:25,19:25,20:25,21:25|P;Heybeliada|Kartal|07:00*,08:00,08:40,09:10,09:40,10:10,11:10,12:10,13:10,14:10,15:10,16:10,16:45,17:10,17:50,18:10,19:10,20:10,21:10|P;Bostanci|Buyukada,Heybeliada|07:10*,08:05,09:00,10:30,11:35,12:30,13:30,14:45,15:30,16:20,17:30,18:20,19:30,21:05,22:00,23:00|M;Bostanci|Kinaliada,Burgazada|08:05,09:05,10:30,12:00,14:30,16:30,17:35,18:30,19:40,21:05,23:00|M;Buyukada|Bostanci|06:20,07:25*,08:00,08:50,09:35,11:05,12:20,13:05,14:05,15:20,16:15,17:25,18:15,19:20,20:35,21:50|M;Buyukada|Heybeliada|06:20,09:35,11:05,13:05,14:05,14:30,15:20,15:30,22:35|M;Heybeliada|Bostanci|06:35,07:10*,07:45,08:35,09:50,11:20,12:05,13:20,14:20,15:35,16:00,17:10,18:00,19:05,20:20,21:35|M;Heybeliada|Buyukada|07:10*,07:45,08:35,12:05,16:00,17:10,18:00,19:05,20:20,21:35,23:30|M;Burgazada|Kinaliada,Bostanci|07:00,07:45,08:45,09:45,11:15,12:45,15:10,17:10,18:15,19:10,20:25|M;Kinaliada|Bostanci|07:15,08:00,09:00,10:00,11:30,13:00,15:25,17:25,18:30,19:25,20:40|M;Kinaliada|Burgazada|08:30,09:30,10:55,12:25,14:55,16:55,18:00,18:55,20:05,21:30,23:25|M;Besiktas|Kabatas,Eminonu,Heybeliada,Buyukada|09:30,11:30|M;Kabatas|Eminonu,Heybeliada,Buyukada|09:45,11:45|M;Eminonu|Heybeliada,Buyukada|10:00,12:00|M;Buyukada|Besiktas,Kabatas,Eminonu|14:30,15:30|M;Heybeliada|Besiktas,Kabatas,Eminonu|14:45,15:45|M;Eminonu|Buyukada,Heybeliada,Burgazada,Kinaliada|09:40,10:40,11:40,12:40,13:40,14:40|T;Karakoy|Buyukada,Heybeliada,Burgazada,Kinaliada|09:45,10:45,11:45,12:45,13:45,14:45|T;Kadikoy|Buyukada,Heybeliada,Burgazada,Kinaliada|10:10,11:10,12:10,13:10,14:10,15:10|T;Buyukada|Eminonu,Karakoy,Kadikoy|14:15,15:15,16:15,17:15,18:15,19:15|T;Heybeliada|Eminonu,Karakoy,Kadikoy|14:30,15:30,16:30,17:30,18:30,19:30|T;Burgazada|Eminonu,Karakoy,Kadikoy|14:45,15:45,16:45,17:45,18:45,19:45|T;Kinaliada|Eminonu,Karakoy,Kadikoy|15:00,16:00,17:00,18:00,19:00,20:00|T;Buyukada|Sedef|07:35*,07:55,19:45|S;Sedef|Buyukada|07:50*,08:10,20:00|S;Tuzla|Pendik,Buyukada|10:35|S|hafta_sonu;Pendik|Buyukada|11:30|S|hafta_sonu;Buyukada|Pendik,Tuzla|18:20|S|hafta_sonu;Maltepe|Buyukada,Heybeliada,Burgazada,Kinaliada|06:45*,09:15,11:20,15:35,21:45|S;Maltepe|Buyukada,Heybeliada|08:20*,10:05,12:00,13:45,16:50,17:50,18:35,19:05,20:05,20:40|S;Kinaliada|Burgazada,Heybeliada,Buyukada,Maltepe|07:05*,08:00*,10:30,14:00,17:10|S;Burgazada|Heybeliada,Buyukada,Maltepe|07:20*,08:15*,10:45,14:15,17:25|S;Heybeliada|Buyukada,Maltepe|07:35*,08:30*,09:15,11:00,12:45,14:30,15:40,17:40,18:30,19:15,19:45,20:45,21:20|S;Buyukada|Maltepe|07:50*,08:45*,09:30,10:55,11:15,13:00,14:45,15:55,17:20,17:55,18:40,19:30,20:00,21:00,21:35|S;Bostanci|Kinaliada,Burgazada,Heybeliada,Buyukada|02:00,04:45,07:05,07:45,08:20,09:25*,10:05,11:00,12:55,15:10,17:55,18:35,20:00,21:45,00:00|S;Buyukada|Heybeliada,Burgazada,Kinaliada,Bostanci|03:10,05:55,06:45*,07:05,10:00*,10:40,12:50,16:20,17:45,18:15,19:10,22:55,23:30,00:35|S;Heybeliada|Burgazada,Kinaliada,Bostanci|02:55,05:40,07:00*,07:20,10:15*,10:55,16:05,17:30,19:25,22:40,00:50|S;Burgazada|Kinaliada,Bostanci|02:40,05:25,09:00,10:30*,11:10,15:50,19:40,22:25,01:05|S;Kinaliada|Bostanci|02:25,05:10,08:45,10:45*,11:25,15:35,19:55,22:10,01:20|S;Kabatas|Kadikoy,Kinaliada,Burgazada,Heybeliada,Buyukada|06:45*,07:30,08:00*,08:30,09:00,10:05,11:05,12:00,14:00,16:30,17:35,18:25,18:50,19:20,19:40,21:40,23:30|S;Kadikoy|Kinaliada,Burgazada,Heybeliada,Buyukada|07:10*,07:55,08:25*,08:55,09:25,10:30,11:30,12:25,14:25,16:55,18:00,19:25,20:05,22:05,23:55|S;Buyukada|Heybeliada,Burgazada,Kinaliada,Kadikoy,Kabatas|05:45*,06:15,06:35*,07:00,07:40,07:55*,08:15,09:00,10:35*,11:00,12:05,13:30,15:00,16:30,17:35,18:30,19:35,20:35,21:45|S;Heybeliada|Burgazada,Kinaliada,Kadikoy,Kabatas|06:00*,06:30,06:50*,07:15,07:55,08:10*,08:30,09:15,10:50*,11:15,12:20,13:45,15:15,16:45,17:50,18:45,19:50,20:50,22:00|S;Burgazada|Kinaliada,Kadikoy,Kabatas|06:15*,06:45,07:05*,07:30,08:10,09:30,11:05*,11:30,12:35,14:00,15:30,17:00,18:05,19:00,20:05,21:05,22:15|S;Kinaliada|Kadikoy,Kabatas|06:30*,07:00,07:20*,07:45,08:25,09:45,11:20*,11:45,12:50,14:15,15:45,17:15,18:20,19:15,20:20,21:20,22:30|S;Besiktas|Kinaliada,Burgazada,Heybeliada,Buyukada|07:25*,08:10,13:00,15:15,18:15|S;Buyukada|Heybeliada,Burgazada,Kinaliada,Kadikoy,Besiktas|07:10*,08:35,10:10,11:10*,15:40,18:00|S;Heybeliada|Burgazada,Kinaliada,Kadikoy,Besiktas|07:25*,08:50,10:25,11:25*,15:55,18:15|S;Burgazada|Kinaliada,Kadikoy,Besiktas|07:40*,09:05,10:40,11:40*,16:10,18:30|S;Kinaliada|Kadikoy,Besiktas|07:55*,09:20,10:55,11:55*,16:25,18:45|S";
        hamVapur.split(';').forEach(satir => { const p = satir.split('|'); vE(p[0], p[1], p[2], p[3], p[4] || 'hergun'); });

        function sH(s) { let p = s.split(':'); return parseInt(p[0], 10) * 60 + parseInt(p[1], 10); }

        window.seferleriGetir = function() {
            const k = document.getElementById('kalkisVapur').value, v = document.getElementById('varisVapur').value, div = document.getElementById('sonucVapur');
            if (!k || !v) { div.innerHTML = '<div class="hata-mesaji">Lütfen kalkış ve varış iskelesi seçin.</div>'; return; }
            if (k === v) { div.innerHTML = '<div class="hata-mesaji">Farklı bir varış noktası seçin.</div>'; return; }
            const dk = new Date().getHours() * 60 + new Date().getMinutes(), gun = new Date().getDay();
            let b = seferler.filter(s => s.kalkis === k && s.varis === v && !(s.tip === 'pazar_yok' && gun === 0) && !(s.tip === 'sadece_pazar' && gun !== 0) && !(s.tip === 'hafta_ici' && (gun === 0 || gun === 6)) && !(s.tip === 'hafta_sonu' && gun >= 1 && gun <= 5) && sH(s.saat) > dk);
            b.sort((a, x) => sH(a.saat) - sH(x.saat));
            const tekil = [], gor = new Set();
            b.forEach(s => { const key = s.saat + s.firma; if (!gor.has(key)) { gor.add(key); tekil.push(s); } });
            const gos = tekil.slice(0, 6);
            div.innerHTML = gos.length ? '<div class="sonuc-baslik">Yaklaşan Seferler:</div>' + gos.map(s => '<div class="sefer-karti"><div class="saat">🕒 ' + s.saat + '</div><div class="firma">' + s.firma + '</div></div>').join('') : '<div class="hata-mesaji">Bugün için başka sefer kalmamıştır.</div>';
        };

        const iettBilgi = {
            'BA1': { k: 'Araba Meydanı', s: '~12 Dk (Ring)', g: 'Araba Meydanı ➔ Tepeköy ➔ Kadıyoran ➔ Anadolu Kulübü ➔ Araba Meydanı', st: '06:00,06:20,06:55,07:20,07:40,07:50,08:05,08:30,08:40,08:50,09:00,09:10,09:35,09:50,10:10,10:30,10:40,11:05,11:20,11:35,11:45,12:00,12:15,12:25,12:40,12:55,13:10,13:25,13:40,14:00,14:20,14:35,14:55,15:10,15:30,15:50,16:15,16:40,16:55,17:10,17:30,17:50,18:00,18:20,18:40,19:00,19:20,19:40,20:00,20:30,20:50,21:05,21:35,21:50,22:10,22:40,23:05,23:35,00:00' },
            'BA2_G': { k: 'Araba Meydanı', s: '~15 Dk', g: 'Araba Meydanı ➔ Nizam ➔ Dilburnu ➔ Aşıklar ➔ Lunapark Meydanı', st: '09:00,09:10,09:20,09:30,09:45,10:00,10:10,10:20,10:30,10:40,10:50,11:00,11:10,11:20,11:30,11:40,11:50,12:00,12:15,12:30,12:45,13:00,13:15,13:30,13:45,14:00,14:15,14:30,14:45,15:00,15:15,15:30,15:45,16:00,16:15,16:30,16:45,17:00,17:15,17:30,17:45,18:00,18:15,18:30,18:45,19:00,19:20,19:40,20:00,20:30,21:00' },
            'BA2_D': { k: 'Lunapark Meydanı', s: '~15 Dk', g: 'Lunapark ➔ Adalar Müzesi ➔ Maden ➔ Nakibey ➔ Çınar ➔ Araba Meydanı', st: '09:15,09:25,09:35,09:45,10:00,10:15,10:25,10:35,10:45,10:55,11:05,11:15,11:25,11:35,11:45,11:55,12:05,12:20,12:35,12:50,13:05,13:15,13:30,13:45,14:00,14:15,14:30,14:45,15:00,15:15,15:30,15:45,16:00,16:15,16:30,16:45,17:00,17:15,17:30,17:45,18:00,18:15,18:30,18:45,19:00,19:15,19:35,19:55,20:15,20:45,21:15' },
            'BA4': { k: 'Araba Meydanı', s: '~15 Dk (Ring)', g: 'Araba Meydanı ➔ Çınar ➔ Nakibey ➔ Maden ➔ Adalar Müzesi ➔ Araba Meydanı', st: '06:00,06:20,06:50,07:20,07:45,08:05,08:25,08:50,09:10,09:35,09:50,10:10,10:30,11:05,11:20,11:45,12:00,12:25,12:55,13:10,13:30,13:50,14:10,14:35,14:55,15:10,15:30,15:50,16:15,16:40,16:55,17:20,17:50,18:10,18:35,18:50,19:20,19:40,20:00,20:30,20:50,21:15,21:35,22:10,22:40,23:05,23:35' },
