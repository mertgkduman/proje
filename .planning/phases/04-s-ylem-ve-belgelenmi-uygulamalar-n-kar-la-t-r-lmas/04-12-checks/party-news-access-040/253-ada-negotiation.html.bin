    <script>
    (function() {
        const slider = document.getElementById("adaHvMainSlider");
        if (!slider) return;
        const slides = Array.from(slider.querySelectorAll(".ada-hv-slide"));
        const dots   = Array.from(document.querySelectorAll("#adaHvDots .ada-hv-dot"));
        const prev   = slider.querySelector(".ada-hv-prev");
        const next   = slider.querySelector(".ada-hv-next");
        if (slides.length < 2) return;

        let cur = 0, timer = null;
        function showSlide(i) {
            cur = (i + slides.length) % slides.length;
            slides.forEach(function(s, idx) { s.classList.toggle("aktif", idx === cur); });
            dots.forEach(function(d, idx) { d.classList.toggle("aktif", idx === cur); });
        }
        function startAuto() { stopAuto(); timer = setInterval(function() { showSlide(cur + 1); }, 5000); }
        function stopAuto() { if (timer) clearInterval(timer); }

        dots.forEach(function(d) {
            const idx = parseInt(d.getAttribute("data-idx"), 10);
            d.addEventListener("mouseenter", function() { showSlide(idx); startAuto(); });
            d.addEventListener("click", function() { showSlide(idx); startAuto(); });
        });
        if (prev) prev.addEventListener("click", function() { showSlide(cur - 1); startAuto(); });
        if (next) next.addEventListener("click", function() { showSlide(cur + 1); startAuto(); });

        slider.addEventListener("mouseenter", stopAuto);
        slider.addEventListener("mouseleave", startAuto);
        startAuto();

        const track = document.getElementById("adaHvTickerTrack");
        const tNext = document.getElementById("adaHvTickerNext");
        if (track && tNext) {
            tNext.addEventListener("click", function() {
                if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 10) track.scrollLeft = 0;
                else track.scrollLeft += 280;
            });
        }
    })();
    </script>
        <script>
    (function() {
        if (window.adaPiyasaHavaYuklendi) return;
