        const stil = document.createElement("style");
        stil.innerHTML = `
            :root { --ana-kirmizi:#d90423; --kart-bg:#ffffff; --arkaplan:#f8fafc; --cizgi:#e2e8f0; --metin-ana:#0f172a; --metin-alt:#64748b; }
            .tekil-piyasa-bar { background:var(--kart-bg); border:1px solid var(--cizgi); border-left:4px solid var(--ana-kirmizi); border-radius:8px; padding:10px 12px; margin:12px 0 20px 0; display:grid; grid-template-columns:repeat(4,1fr); gap:10px; box-shadow:0 2px 8px rgba(0,0,0,0.05); font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; clear:both; }
            .piyasa-item { cursor:pointer; transition:background 0.25s,transform 0.15s,box-shadow 0.25s; border-radius:7px; padding:8px 10px; border:1px solid #f1f5f9; background:#fff; }
            .piyasa-item:hover { background:var(--arkaplan); transform:translateY(-1px); box-shadow:0 4px 10px rgba(0,0,0,0.06); }
            .piyasa-ad { display:flex; align-items:center; justify-content:space-between; font-size:11.5px; font-weight:800; color:#475569; margin-bottom:5px; }
            .piyasa-deger-satir { display:flex; align-items:center; justify-content:space-between; gap:6px; }
            .piyasa-fiyat { font-size:16.5px; font-weight:900; color:#0f172a; font-variant-numeric:tabular-nums; }
            .piyasa-oran { font-size:11px; font-weight:800; color:#fff; padding:2px 6px; border-radius:5px; white-space:nowrap; }
            .piyasa-oran.dusus { background:#ef4444 !important; }
            .piyasa-oran.yukselis { background:#10b981 !important; }
            .canli-nokta { display:inline-block; width:8px; height:8px; background:#10b981; border-radius:50%; margin-right:5px; box-shadow:0 0 6px #10b981; animation:canliNabiz 1.2s infinite; }
            @keyframes canliNabiz { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:0.35; transform:scale(0.8); } }
            @keyframes flashYesil { 0% { background-color:rgba(16,185,129,0.32); border-color:#10b981; box-shadow:0 0 12px rgba(16,185,129,0.35); } 100% { background-color:#fff; border-color:#f1f5f9; } }
            @keyframes flashKirmizi { 0% { background-color:rgba(239,68,68,0.32); border-color:#ef4444; box-shadow:0 0 12px rgba(239,68,68,0.35); } 100% { background-color:#fff; border-color:#f1f5f9; } }
            .flash-up { animation:flashYesil 1.1s ease-out; }
            .flash-down { animation:flashKirmizi 1.1s ease-out; }
            #ada-ozel-merkez-overlay { display:none; position:fixed; inset:0; z-index:999998; background:rgba(15,23,42,0.75); backdrop-filter:blur(4px); overflow-y:auto; padding:24px 14px; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
            #icerikAlani { max-width:1140px; margin:0 auto; }
            .bp-kapsayici { background:var(--kart-bg); border:1px solid var(--cizgi); border-radius:12px; padding:22px; box-shadow:0 20px 50px rgba(0,0,0,0.3); }
            .bp-ust-kartlar { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:20px; }
            .bp-ozet-kart { border:1px solid var(--cizgi); border-radius:8px; padding:12px 14px; cursor:pointer; background:var(--kart-bg); }
            .bp-ozet-kart:hover,.bp-ozet-kart.aktif { border-color:#f97316; box-shadow:0 4px 12px rgba(249,115,22,0.12); }
            .bp-ozet-ust { display:flex; justify-content:space-between; align-items:center; font-size:13px; font-weight:800; color:var(--metin-ana); margin-bottom:6px; }
            .bp-ozet-alt { display:flex; justify-content:space-between; align-items:flex-end; }
            .bp-sekme-bar { display:flex; gap:8px; border-bottom:2px solid var(--cizgi); margin-bottom:20px; overflow-x:auto; }
            .bp-sekme-btn { padding:10px 16px; border:none; background:transparent; font-weight:800; font-size:13.5px; color:var(--metin-alt); cursor:pointer; border-bottom:3px solid transparent; margin-bottom:-2px; white-space:nowrap; }
            .bp-sekme-btn.aktif { color:#f97316; border-bottom-color:#f97316; }
            .bp-endeks-bar { display:flex; align-items:center; gap:8px; margin-bottom:14px; flex-wrap:wrap; }
            .bp-endeks-hap { padding:7px 16px; border-radius:20px; border:1px solid var(--cizgi); background:var(--arkaplan); color:var(--metin-ana); font-size:12.5px; font-weight:800; cursor:pointer; }
            .bp-endeks-hap.aktif { background:#f97316; color:#fff; border-color:#f97316; }
            .bp-endeks-select { padding:7px 14px; border-radius:20px; border:1px solid var(--cizgi); background:var(--arkaplan); color:var(--metin-ana); font-size:12.5px; font-weight:700; cursor:pointer; }
            .bp-grafik-kutu { position:relative; background:var(--kart-bg); border:1px solid var(--cizgi); border-radius:10px; padding:16px; margin-bottom:18px; }
            .bp-periyot-bar { display:inline-flex; background:var(--arkaplan); border:1px solid var(--cizgi); border-radius:20px; padding:3px; gap:4px; margin-top:10px; }
            .bp-periyot-btn { padding:5px 13px; border-radius:16px; border:none; background:transparent; font-size:12px; font-weight:800; color:var(--metin-alt); cursor:pointer; }
            .bp-periyot-btn.aktif { background:var(--kart-bg); color:var(--metin-ana); box-shadow:0 1px 4px rgba(0,0,0,0.12); }
            .bp-harf-bar { display:flex; flex-wrap:wrap; gap:4px; background:var(--arkaplan); padding:8px; border-radius:8px; margin-bottom:14px; border:1px solid var(--cizgi); }
            .bp-harf-btn { min-width:26px; height:28px; border:none; background:transparent; font-size:12px; font-weight:800; color:var(--metin-alt); border-radius:5px; cursor:pointer; }
            .bp-harf-btn:hover,.bp-harf-btn.aktif { background:#ef4444; color:#fff; }
            .bp-tablo { width:100%; border-collapse:collapse; font-size:13px; margin-bottom:22px; }
            .bp-tablo th { text-align:left; padding:10px 12px; background:var(--arkaplan); color:var(--metin-alt); font-size:11.5px; font-weight:700; border-bottom:1px solid var(--cizgi); }
            .bp-tablo td { padding:11px 12px; border-bottom:1px solid var(--cizgi); font-weight:600; color:var(--metin-ana); }
            .bp-up { color:#10b981; font-weight:800; }
            .bp-down { color:#ef4444; font-weight:800; }
            .ai-sinyal-ye { background:#059669; color:#fff; font-size:11px; font-weight:800; padding:3px 10px; border-radius:4px; display:inline-block; }
            .ai-sinyal-notr { background:#e2e8f0; color:#475569; font-size:11px; font-weight:700; padding:3px 10px; border-radius:4px; display:inline-block; }
            .bp-ikili-grid { display:grid; grid-template-columns:1fr 1fr; gap:18px; margin-bottom:24px; }
            .bp-alt-kart { border:1px solid var(--cizgi); border-radius:10px; padding:16px; background:var(--kart-bg); }
            .bp-cevirici-kutu { background:var(--arkaplan); border:1px solid var(--cizgi); border-radius:10px; padding:18px; margin-top:20px; }
            .bp-cevirici-grid { display:grid; grid-template-columns:1fr 160px 40px 1fr; gap:10px; align-items:center; margin-top:12px; }
            .bp-cevirici-grid input,.bp-cevirici-grid select { width:100%; padding:10px 12px; border:1px solid var(--cizgi); border-radius:6px; font-size:14px; font-weight:700; background:var(--kart-bg); color:var(--metin-ana); box-sizing:border-box; }
            .hava-gun-kart { background:var(--arkaplan); border:1px solid var(--cizgi); border-radius:8px; padding:14px 10px; text-align:center; }
            .ada-hizli-servis-bar { display:flex; flex-wrap:wrap; gap:8px; margin:-10px 0 18px 0; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; }
            .ada-servis-hap { display:inline-flex; align-items:center; gap:5px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:20px; padding:5px 12px; font-size:12px; font-weight:700; color:#1e293b !important; text-decoration:none !important; cursor:pointer; }
            .ada-servis-hap:hover { border-color:#d90423; background:#fff1f2; color:#d90423 !important; }
            @media (max-width:768px) {
                .tekil-piyasa-bar { grid-template-columns:repeat(2,1fr); gap:8px; padding:8px; }
                .piyasa-fiyat { font-size:15px; }
                .bp-ust-kartlar,.bp-ikili-grid,.bp-cevirici-grid { grid-template-columns:1fr; }
                .bp-kapsayici { padding:14px; }
            }
        `;
        document.head.appendChild(stil);

        function getOrCreateMerkezAlan() {
            let overlay = document.getElementById("ada-ozel-merkez-overlay");
            if (!overlay) {
                overlay = document.createElement("div");
                overlay.id = "ada-ozel-merkez-overlay";
                overlay.innerHTML = '<div id="icerikAlani"></div>';
                overlay.addEventListener("click", function(e) { if (e.target === overlay) window.kategoriSec("Tümü"); });
                document.body.appendChild(overlay);
            }
            kaydedilenScroll = window.scrollY;
            overlay.style.display = "block";
            document.body.style.overflow = "hidden";
            return document.getElementById("icerikAlani");
        }

        window.kategoriSec = function() {
            finansSayfasiAcikMi = false;
            const overlay = document.getElementById("ada-ozel-merkez-overlay");
            if (overlay) overlay.style.display = "none";
            document.body.style.overflow = "";
            window.scrollTo({ top: kaydedilenScroll, behavior: "instant" });
        };

        function trSayi(num, basamak = 2) {
            return Number(num).toLocaleString("tr-TR", { minimumFractionDigits: basamak, maximumFractionDigits: basamak });
        }

        function altinlariHesapla() {
            const yeniGram = (piyasaVeri.ons.satis * piyasaVeri.usd.satis) / 31.1034768;
            piyasaVeri.gramAltin.sonYon = yeniGram >= piyasaVeri.gramAltin.satis ? "yukselis" : "dusus";
            piyasaVeri.gramAltin.satis = yeniGram;
            piyasaVeri.gramAltin.alis = yeniGram - 1.15;
            piyasaVeri.ceyrekAltin.satis = yeniGram * 1.635;
            piyasaVeri.ceyrekAltin.alis = piyasaVeri.ceyrekAltin.satis - 74;
            piyasaVeri.yarimAltin.satis = yeniGram * 3.27;
            piyasaVeri.yarimAltin.alis = piyasaVeri.yarimAltin.satis - 116;
            piyasaVeri.tamAltin.satis = yeniGram * 6.51;
            piyasaVeri.tamAltin.alis = piyasaVeri.tamAltin.satis - 830;
            piyasaVeri.cumhuriyet.satis = yeniGram * 6.512;
            piyasaVeri.cumhuriyet.alis = piyasaVeri.cumhuriyet.satis - 207;
        }

        try {
            const ws = new WebSocket("wss://stream.binance.com:9443/stream?streams=usdttry@ticker/eurusdt@ticker/paxgusdt@ticker");
            ws.onmessage = function(event) {
                try {
                    const msg = JSON.parse(event.data);
                    if (!msg || !msg.data) return;
                    const s = msg.data.s, fiyat = parseFloat(msg.data.c), degisim = parseFloat(msg.data.P);
                    if (s === "USDTTRY" && fiyat > 30) {
                        piyasaVeri.usd.sonYon = fiyat >= piyasaVeri.usd.satis ? "yukselis" : "dusus";
                        piyasaVeri.usd.satis = fiyat; piyasaVeri.usd.alis = fiyat - 0.0018; piyasaVeri.usd.degisim = degisim;
                        altinlariHesapla(); canliDomGuncelle("usd");
                    } else if (s === "EURUSDT" && fiyat > 0.9) {
                        const yeniEur = fiyat * piyasaVeri.usd.satis;
                        piyasaVeri.eur.sonYon = yeniEur >= piyasaVeri.eur.satis ? "yukselis" : "dusus";
                        piyasaVeri.eur.satis = yeniEur; piyasaVeri.eur.alis = yeniEur - 0.0050;
                        canliDomGuncelle("eur");
                    } else if (s === "PAXGUSDT" && fiyat > 2000) {
                        piyasaVeri.ons.sonYon = fiyat >= piyasaVeri.ons.satis ? "yukselis" : "dusus";
                        piyasaVeri.ons.satis = fiyat; piyasaVeri.ons.alis = fiyat - 0.60;
                        altinlariHesapla(); canliDomGuncelle("altin");
                    }
                } catch (e) {}
            };
        } catch (e) {}

        setInterval(function() {
            const r = ["usd", "eur", "altin", "bist"][Math.floor(Math.random() * 4)];
            const ufakFark = (Math.random() - 0.48) * 0.0045;
            if (r === "usd") {
                piyasaVeri.usd.sonYon = ufakFark >= 0 ? "yukselis" : "dusus";
                piyasaVeri.usd.satis = Math.max(40, piyasaVeri.usd.satis + ufakFark);
                piyasaVeri.usd.alis = piyasaVeri.usd.satis - 0.0016;
                altinlariHesapla();
            } else if (r === "eur") {
                piyasaVeri.eur.sonYon = ufakFark >= 0 ? "yukselis" : "dusus";
                piyasaVeri.eur.satis = Math.max(45, piyasaVeri.eur.satis + ufakFark);
                piyasaVeri.eur.alis = piyasaVeri.eur.satis - 0.0055;
            } else if (r === "altin") {
                const af = (Math.random() - 0.48) * 1.35;
                piyasaVeri.gramAltin.sonYon = af >= 0 ? "yukselis" : "dusus";
                piyasaVeri.gramAltin.satis += af;
                piyasaVeri.gramAltin.alis = piyasaVeri.gramAltin.satis - 1.15;
            } else if (r === "bist") {
                const bf = (Math.random() - 0.47) * 3.80;
                piyasaVeri.bist100.sonYon = bf >= 0 ? "yukselis" : "dusus";
                piyasaVeri.bist100.deger += bf;
                endeksVerileri["BIST 100"].baz = piyasaVeri.bist100.deger;
            }
            piyasaVeri.sonGuncelleme = new Date().toLocaleTimeString("tr-TR");
            canliDomGuncelle(r);
        }, 3500);

        function canliDomGuncelle(degisenTip) {
            tumPiyasaBarlariniGuncelle(degisenTip);
            if (finansSayfasiAcikMi && document.querySelector(".bp-kapsayici")) {
                const saatEl = document.getElementById("bpCanliSaat");
                if (saatEl) saatEl.innerText = piyasaVeri.sonGuncelleme;
                const guncelleHucre = function(id, metin, yon) {
                    const el = document.getElementById(id);
                    if (!el || el.innerText === metin) return;
                    el.innerText = metin;
                    el.classList.remove("flash-up", "flash-down");
                    void el.offsetWidth;
                    el.classList.add(yon === "yukselis" ? "flash-up" : "flash-down");
                };
                guncelleHucre("bpUstUsd", trSayi(piyasaVeri.usd.satis, 4), piyasaVeri.usd.sonYon);
                guncelleHucre("bpUstEur", trSayi(piyasaVeri.eur.satis, 4), piyasaVeri.eur.sonYon);
                guncelleHucre("bpUstAltin", trSayi(piyasaVeri.gramAltin.satis, 2), piyasaVeri.gramAltin.sonYon);
                guncelleHucre("bpUstBist", trSayi(piyasaVeri.bist100.deger, 2), piyasaVeri.bist100.sonYon);
                guncelleHucre("tabloUsdSatis", trSayi(piyasaVeri.usd.satis, 4), piyasaVeri.usd.sonYon);
                guncelleHucre("tabloEurSatis", trSayi(piyasaVeri.eur.satis, 4), piyasaVeri.eur.sonYon);
                guncelleHucre("tabloGramSatis", trSayi(piyasaVeri.gramAltin.satis, 2), piyasaVeri.gramAltin.sonYon);
                guncelleHucre("tabloCeyrekSatis", trSayi(piyasaVeri.ceyrekAltin.satis, 2), piyasaVeri.gramAltin.sonYon);
                window.adaKurHesapla();
            }
        }

        function tumPiyasaBarlariniGuncelle(parlayanTip = "") {
            const barlar = document.querySelectorAll(".piyasa-bar");
            if (barlar.length === 0) return;

            const kalemler = [
                { kod: "usd", id: "doviz", baslik: "DOLAR", fiyat: trSayi(piyasaVeri.usd.satis, 4), oran: piyasaVeri.usd.degisim, yon: piyasaVeri.usd.sonYon },
                { kod: "eur", id: "doviz", baslik: "EURO", fiyat: trSayi(piyasaVeri.eur.satis, 4), oran: piyasaVeri.eur.degisim, yon: piyasaVeri.eur.sonYon },
                { kod: "altin", id: "altin", baslik: "GRAM ALTIN", fiyat: trSayi(piyasaVeri.gramAltin.satis, 2), oran: piyasaVeri.gramAltin.degisim, yon: piyasaVeri.gramAltin.sonYon },
                { kod: "bist", id: "borsa", baslik: "BIST 100", fiyat: trSayi(piyasaVeri.bist100.deger, 2), oran: piyasaVeri.bist100.degisim, yon: piyasaVeri.bist100.sonYon }
            ];

            const icerikHTML = kalemler.map(function(k) {
                const yukselisMi = k.yon ? (k.yon === "yukselis") : (k.oran >= 0);
                const ok = yukselisMi ? "↑" : "↓";
                const sinif = yukselisMi ? "yukselis" : "dusus";
                const flashSinif = (parlayanTip === k.kod) ? (k.yon === "yukselis" ? "flash-up" : "flash-down") : "";
                const ledRenk = yukselisMi ? "#10b981" : "#ef4444";
                return '<div class="piyasa-item ' + flashSinif + '" onclick="window.adaFinansHavaAc(\'' + k.id + '\')" title="Canlı Borsa, Döviz ve Altın Grafiği için tıklayın">' +
                    '<span class="piyasa-ad"><span><span class="canli-nokta" style="background:' + ledRenk + ';box-shadow:0 0 6px ' + ledRenk + ';"></span>' + k.baslik + '</span> <small style="color:#94a3b8;font-weight:normal;">Detay ›</small></span>' +
                    '<div class="piyasa-deger-satir">' +
                        '<span class="piyasa-fiyat">' + k.fiyat + '</span>' +
                        '<span class="piyasa-oran ' + sinif + '">' + ok + ' %' + trSayi(Math.abs(k.oran), 2) + '</span>' +
                    '</div>' +
                '</div>';
            }).join("");

            barlar.forEach(function(bar) {
                bar.innerHTML = icerikHTML;
                if (!bar.nextElementSibling || !bar.nextElementSibling.classList.contains("ada-hizli-servis-bar")) {
                    const servisBar = document.createElement("div");
                    servisBar.className = "ada-hizli-servis-bar";
                    servisBar.innerHTML =
                        '<a class="ada-servis-hap" onclick="window.adaFinansHavaAc(\'borsa\');return false;" href="#canli-borsa">📈 Canlı Borsa Grafiği</a>' +
                        '<a class="ada-servis-hap" id="ada-hap-hava" onclick="window.adaSadeceHavaAc();return false;" href="#hava-durumu">☀️ Adalar Hava Durumu (' + adalarHava.sicaklik + '°C)</a>' +
                        '<a class="ada-servis-hap" onclick="window.adaDepremSayfasiAc();return false;" href="#son-depremler">🚨 AFAD & Kandilli Son Depremler</a>' +
                        '<a class="ada-servis-hap" onclick="window.adaNobetciEczaneAc();return false;" href="#nobetci-eczaneler">💊 Adalar Nöbetçi Eczaneler</a>' +
                        '<a class="ada-servis-hap" onclick="window.adaOtellerSayfasiAc(\'Tümü\');return false;" href="#oteller">🏨 Adalar Otel & Konaklama</a>';
                    bar.after(servisBar);
                }
            });
        }

        window.bpGrafikCiz = function(endeksAdi, periyot) {
            if (endeksAdi) seciliEndeks = endeksAdi;
            if (periyot) seciliPeriyot = periyot;

            const bilgi = endeksVerileri[seciliEndeks] || endeksVerileri["BIST 100"];
            const bazFiyat = bilgi.baz;
            const dususTrendiMi = (seciliPeriyot === "1A" || seciliPeriyot === "3A" || bilgi.degisim < 0);
            const anaRenk = dususTrendiMi ? "#ef4444" : "#10b981";

            const aktifGrafikNoktalari = [];
            const saatler = ["09:55","10:15","10:30","10:45","11:00","11:15","11:30","11:45","12:00","12:30","13:00","13:30","14:00","14:30","15:00","15:30","16:00","16:30","17:00","17:15","17:30","17:45","18:00","18:10"];
            const gunEtiketleri = ["12 Eki","15 Eki","18 Eki","21 Eki","24 Eki","27 Eki","30 Eki","02 Kas","05 Kas","08 Kas","11 Kas","14 Kas","17 Kas","20 Kas","23 Kas","26 Kas","29 Kas","01 Ara","03 Ara","05 Ara","07 Ara","08 Ara","09 Ara","Bugün"];

            for (let i = 0; i < 24; i++) {
                const dalga = Math.sin(i * 0.55) * (bazFiyat * 0.004) + (dususTrendiMi ? -i * (bazFiyat * 0.0012) : i * (bazFiyat * 0.0009));
                const deger = +(bazFiyat - (bazFiyat * 0.008) + dalga).toFixed(2);
                aktifGrafikNoktalari.push({
                    etiket: seciliPeriyot === "1G" ? saatler[i] : gunEtiketleri[i],
                    deger: deger,
                    yuksek: +(deger + 18.4).toFixed(2),
                    dusuk: +(deger - 14.2).toFixed(2)
                });
            }
            aktifGrafikNoktalari[23].deger = bazFiyat;

            const degerler = aktifGrafikNoktalari.map(n => n.deger);
            const minD = Math.min(...degerler) * 0.999, maxD = Math.max(...degerler) * 1.001, genislik = 680, yukseklik = 220;

            const koordinatlar = aktifGrafikNoktalari.map((n, idx) => {
                const x = Math.round((idx / (aktifGrafikNoktalari.length - 1)) * (genislik - 70)) + 15;
                const y = Math.round(yukseklik - 25 - ((n.deger - minD) / (maxD - minD)) * (yukseklik - 50));
                return { x, y, ...n };
            });

            const cizgiPoints = koordinatlar.map(k => `${k.x},${k.y}`).join(" ");
            const alanPoints = `15,${yukseklik - 20} ${cizgiPoints} ${koordinatlar[koordinatlar.length - 1].x},${yukseklik - 20}`;

            const grafikAlani = document.getElementById("bpCanliGrafikKonteyner");
            if (!grafikAlani) return;

            grafikAlani.innerHTML = `
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;flex-wrap:wrap;">
                    <div class="bp-endeks-bar" style="margin:0;">
                        <button class="bp-endeks-hap ${seciliEndeks==='BIST 100'?'aktif':''}" onclick="window.bpGrafikCiz('BIST 100', null)">BIST 100</button>
                        <button class="bp-endeks-hap ${seciliEndeks==='BIST 50'?'aktif':''}" onclick="window.bpGrafikCiz('BIST 50', null)">BIST 50</button>
                        <button class="bp-endeks-hap ${seciliEndeks==='BIST 30'?'aktif':''}" onclick="window.bpGrafikCiz('BIST 30', null)">BIST 30</button>
                        <select class="bp-endeks-select" onchange="if(this.value) window.bpGrafikCiz(this.value, null)">
                            <option value="">Diğer Endeksler ▾</option>
                            <option value="BIST BANKA" ${seciliEndeks==='BIST BANKA'?'selected':''}>BIST BANKA</option>
                            <option value="BIST SINAİ" ${seciliEndeks==='BIST SINAİ'?'selected':''}>BIST SINAİ</option>
                            <option value="BIST TEKNOLOJİ" ${seciliEndeks==='BIST TEKNOLOJİ'?'selected':''}>BIST TEKNOLOJİ</option>
                            <option value="BIST ULAŞTIRMA" ${seciliEndeks==='BIST ULAŞTIRMA'?'selected':''}>BIST ULAŞTIRMA</option>
                            <option value="BIST GYO" ${seciliEndeks==='BIST GYO'?'selected':''}>BIST GYO</option>
                            <option value="BIST HOLDİNG" ${seciliEndeks==='BIST HOLDİNG'?'selected':''}>BIST HOLDİNG</option>
                        </select>
                    </div>
                    <div style="font-size:12px;color:var(--metin-alt);font-weight:700;">Seçili Endeks: <strong style="color:var(--metin-ana);font-size:14px;">${seciliEndeks} (${trSayi(bazFiyat, 2)})</strong></div>
                </div>
                <div style="position:relative;user-select:none;">
                    <svg id="bpAnaSvg" viewBox="0 0 ${genislik} ${yukseklik}" style="width:100%;height:230px;overflow:visible;cursor:crosshair;">
                        <defs><linearGradient id="bpGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="${anaRenk}" stop-opacity="0.28"/><stop offset="100%" stop-color="${anaRenk}" stop-opacity="0.0"/></linearGradient></defs>
                        ${[0, 0.25, 0.5, 0.75, 1].map(oran => {
                            const y = Math.round(25 + oran * (yukseklik - 50));
                            const f = trSayi(maxD - oran * (maxD - minD), 2);
                            return `<line x1="15" y1="${y}" x2="${genislik - 65}" y2="${y}" stroke="#e2e8f0" stroke-dasharray="3,3"/><text x="${genislik - 60}" y="${y + 4}" font-size="10" fill="#64748b" font-weight="700">${f}</text>`;
                        }).join("")}
                        <polygon points="${alanPoints}" fill="url(#bpGrad)"/>
                        <polyline fill="none" stroke="${anaRenk}" stroke-width="2.6" points="${cizgiPoints}"/>
                        <rect x="${genislik - 62}" y="${koordinatlar[koordinatlar.length-1].y - 10}" width="60" height="20" rx="4" fill="${anaRenk}"/>
                        <text x="${genislik - 32}" y="${koordinatlar[koordinatlar.length-1].y + 4}" font-size="10" fill="#fff" font-weight="800" text-anchor="middle">${trSayi(bazFiyat, 0)}</text>
                        <line id="bpHoverLine" x1="0" y1="15" x2="0" y2="${yukseklik - 20}" stroke="#334155" stroke-width="1.2" stroke-dasharray="4,4" style="display:none;"/>
                        <circle id="bpHoverDot" cx="0" cy="0" r="5" fill="${anaRenk}" stroke="#fff" stroke-width="2" style="display:none;"/>
                    </svg>
                    <div id="bpHoverTooltip" style="display:none;position:absolute;top:20px;left:50px;background:rgba(15,23,42,0.92);color:#fff;padding:10px 14px;border-radius:8px;font-size:11.5px;pointer-events:none;box-shadow:0 8px 20px rgba(0,0,0,0.25);z-index:10;min-width:155px;"></div>
                </div>
                <div class="bp-periyot-bar">
                    ${["1G", "1H", "1A", "3A", "1Y", "5Y"].map(p => `<button class="bp-periyot-btn ${seciliPeriyot===p?'aktif':''}" onclick="window.bpGrafikCiz(null, '${p}')">${p}</button>`).join("")}
                </div>
            `;

            const svgEl = document.getElementById("bpAnaSvg"), hoverLine = document.getElementById("bpHoverLine"), hoverDot = document.getElementById("bpHoverDot"), tooltip = document.getElementById("bpHoverTooltip");
            if (svgEl) {
                svgEl.addEventListener("mousemove", (e) => {
                    const rect = svgEl.getBoundingClientRect();
                    const relX = ((e.clientX - rect.left) / rect.width) * genislik;
                    let enYakin = koordinatlar[0], minFark = 9999;
                    koordinatlar.forEach(k => { const f = Math.abs(k.x - relX); if (f < minFark) { minFark = f; enYakin = k; } });
                    hoverLine.setAttribute("x1", enYakin.x); hoverLine.setAttribute("x2", enYakin.x); hoverLine.style.display = "block";
                    hoverDot.setAttribute("cx", enYakin.x); hoverDot.setAttribute("cy", enYakin.y); hoverDot.style.display = "block";
                    tooltip.style.display = "block";
                    tooltip.style.left = Math.min(rect.width - 170, Math.max(10, (enYakin.x / genislik) * rect.width - 75)) + "px";
                    tooltip.innerHTML = `<div style="font-weight:800;color:#facc15;margin-bottom:4px;border-bottom:1px solid rgba(255,255,255,0.15);padding-bottom:3px;">🕒 ${enYakin.etiket}</div><div style="display:flex;justify-content:space-between;gap:12px;"><span>Değer:</span> <strong>${trSayi(enYakin.deger, 2)}</strong></div><div style="display:flex;justify-content:space-between;gap:12px;"><span>Yüksek:</span> <strong>${trSayi(enYakin.yuksek, 2)}</strong></div><div style="display:flex;justify-content:space-between;gap:12px;"><span>Düşük:</span> <strong>${trSayi(enYakin.dusuk, 2)}</strong></div>`;
                });
                svgEl.addEventListener("mouseleave", () => { hoverLine.style.display = "none"; hoverDot.style.display = "none"; tooltip.style.display = "none"; });
            }
        };

        window.bpHisseHarfSec = function(harf) {
            seciliHarf = harf;
            document.querySelectorAll(".bp-harf-btn").forEach(b => b.classList.toggle("aktif", b.dataset.harf === harf));
            const tbody = document.getElementById("bpHisseTabloGövde");
            if (!tbody) return;
            const filtreli = harf === "TÜMÜ" ? tumHisseler : tumHisseler.filter(h => h.kod.startsWith(harf) || h.ad.startsWith(harf));
            if (filtreli.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align:center;padding:20px;color:#94a3b8;">"${harf}" harfi ile başlayan hisse senedi bulunamadı.</td></tr>`;
                return;
            }
            tbody.innerHTML = filtreli.map(h => {
                const up = h.farkYuzde >= 0, renk = up ? "#10b981" : "#ef4444";
                const points = up ? "0,18 15,15 30,16 45,9 60,11 75,4" : "0,5 15,8 30,7 45,14 60,16 75,20";
                return `<tr><td><div style="display:flex;align-items:center;gap:10px;"><div style="width:30px;height:30px;border-radius:50%;background:${up?'#dcfce7':'#fee2e2'};color:${renk};display:flex;align-items:center;justify-content:center;font-weight:900;font-size:11px;">${h.kod.substring(0,2)}</div><div><strong style="display:block;font-size:13.5px;">${h.kod}</strong><small style="color:var(--metin-alt);font-size:10.5px;">${h.ad}</small></div></div></td><td><svg width="75" height="22"><polyline fill="none" stroke="${renk}" stroke-width="2" points="${points}"/></svg></td><td><strong>${trSayi(h.fiyat, 2)}</strong></td><td class="${up?'bp-up':'bp-down'}">${up?'↑':'↓'} %${trSayi(h.farkYuzde, 2)}</td><td class="${up?'bp-up':'bp-down'}">${trSayi(h.fark, 2)}</td><td>${trSayi(h.alis, 2)} / ${trSayi(h.satis, 2)}</td></tr>`;
            }).join("");
        };

        function ruzgarAdiBul(derece) {
            if (derece >= 20 && derece < 70) return "Poyraz";
            if (derece >= 70 && derece < 110) return "Gündoğusu";
            if (derece >= 110 && derece < 160) return "Keşişleme";
            if (derece >= 160 && derece < 200) return "Kıble";
            if (derece >= 200 && derece < 250) return "Lodos";
            if (derece >= 250 && derece < 290) return "Günbatısı";
            if (derece >= 290 && derece < 340) return "Karayel";
            return "Yıldız";
        }

        function wmoDurumCoz(kod) {
            if (kod === 0) return { metin: "Açık, Güneşli", ikon: "☀️" };
            if (kod <= 2) return { metin: "Az Bulutlu", ikon: "🌤️" };
            if (kod === 3) return { metin: "Çok Bulutlu", ikon: "☁️" };
            if (kod <= 48) return { metin: "Sisli / Puslu", ikon: "🌫️" };
            if (kod <= 67) return { metin: "Yağmurlu", ikon: "🌧️" };
            if (kod <= 77) return { metin: "Kar Yağışlı", ikon: "❄️" };
            if (kod <= 82) return { metin: "Sağanak Yağış", ikon: "🌦️" };
            return { metin: "Fırtınalı", ikon: "⛈️" };
        }

        async function canliHavaDurumuCek() {
            try {
                const res = await fetch("https://api.open-meteo.com/v1/forecast?latitude=40.8742&longitude=29.1286&current=temperature_2m,weather_code,wind_speed_10m,wind_direction_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,wind_speed_10m_max&timezone=Europe%2FIstanbul&forecast_days=5");
                if (!res.ok) return;
                const d = await res.json();
                if (d.current) {
                    const info = wmoDurumCoz(d.current.weather_code);
                    adalarHava.sicaklik = Math.round(d.current.temperature_2m);
                    adalarHava.durum = info.metin; adalarHava.ikon = info.ikon;
                    adalarHava.ruzgarHiz = Math.round(d.current.wind_speed_10m);
                    adalarHava.ruzgarYon = ruzgarAdiBul(d.current.wind_direction_10m);
                }
                const hapHava = document.getElementById("ada-hap-hava");
                if (hapHava) hapHava.innerHTML = `${adalarHava.ikon} Adalar Hava Durumu (${adalarHava.sicaklik}°C • ${adalarHava.ruzgarYon})`;
            } catch (e) {}
        }

        window.adaFinansHavaAc = function(aktifSekme = "borsa") {
            if (aktifSekme === "hava" && window.adaSadeceHavaAc) { window.adaSadeceHavaAc(); return; }
            finansSayfasiAcikMi = true;
            const alan = getOrCreateMerkezAlan();
            const harfler = ["TÜMÜ","A","B","C","Ç","D","E","F","G","H","I","İ","K","M","O","P","S","Ş","T","V","Y","Z"];

            alan.innerHTML = `
                <div class="bp-kapsayici">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:10px;">
                        <div>
                            <h1 style="font-size:22px;font-weight:900;color:var(--metin-ana);margin:0;"><span class="canli-nokta"></span>Canlı Borsa, Döviz, Altın & Piyasalar</h1>
                            <span style="font-size:12px;color:var(--metin-alt);">Son Güncelleme: <strong id="bpCanliSaat">${piyasaVeri.sonGuncelleme}</strong> • Grafiğin üzerinde farenizi gezdirerek detayları görebilirsiniz.</span>
                        </div>
                        <button type="button" onclick="window.kategoriSec('Tümü')" style="background:var(--ana-kirmizi);color:#fff;border:none;cursor:pointer;font-weight:800;font-size:13px;padding:9px 16px;border-radius:6px;">✕ Kapat / Habere Dön</button>
                    </div>
                    <div class="bp-ust-kartlar">
                        <div class="bp-ozet-kart ${aktifSekme==='borsa'?'aktif':''}" onclick="window.adaFinansHavaAc('borsa')"><div class="bp-ozet-ust"><span>BIST 100</span> <span id="bpUstBist">${trSayi(piyasaVeri.bist100.deger, 2)}</span></div><div class="bp-ozet-alt"><svg width="75" height="24"><polyline fill="none" stroke="#10b981" stroke-width="2.2" points="0,20 15,16 30,18 45,10 60,12 75,4"/></svg><span class="bp-up" style="font-size:12px;">↑ %${trSayi(piyasaVeri.bist100.degisim, 2)}</span></div></div>
                        <div class="bp-ozet-kart ${aktifSekme==='doviz'?'aktif':''}" onclick="window.adaFinansHavaAc('doviz')"><div class="bp-ozet-ust"><span>Dolar</span> <span id="bpUstUsd">${trSayi(piyasaVeri.usd.satis, 4)}</span></div><div class="bp-ozet-alt"><svg width="75" height="24"><polyline fill="none" stroke="#10b981" stroke-width="2.2" points="0,18 18,17 35,15 50,8 65,7 75,5"/></svg><span class="bp-up" style="font-size:12px;">↑ %${trSayi(Math.abs(piyasaVeri.usd.degisim), 2)}</span></div></div>
                        <div class="bp-ozet-kart" onclick="window.adaFinansHavaAc('doviz')"><div class="bp-ozet-ust"><span>Euro</span> <span id="bpUstEur">${trSayi(piyasaVeri.eur.satis, 4)}</span></div><div class="bp-ozet-alt"><svg width="75" height="24"><polyline fill="none" stroke="#ef4444" stroke-width="2.2" points="0,6 18,9 35,7 50,14 65,16 75,19"/></svg><span class="bp-down" style="font-size:12px;">↓ %${trSayi(piyasaVeri.eur.degisim, 2)}</span></div></div>
                        <div class="bp-ozet-kart ${aktifSekme==='altin'?'aktif':''}" onclick="window.adaFinansHavaAc('altin')"><div class="bp-ozet-ust"><span>Gram Altın</span> <span id="bpUstAltin">${trSayi(piyasaVeri.gramAltin.satis, 2)}</span></div><div class="bp-ozet-alt"><svg width="75" height="24"><polyline fill="none" stroke="#ef4444" stroke-width="2.2" points="0,5 18,8 35,12 50,10 65,17 75,20"/></svg><span class="bp-down" style="font-size:12px;">↓ %${trSayi(piyasaVeri.gramAltin.degisim, 2)}</span></div></div>
                    </div>
                    <div class="bp-sekme-bar">
                        <button class="bp-sekme-btn ${aktifSekme==='borsa'?'aktif':''}" onclick="window.adaFinansHavaAc('borsa')">📈 Canlı Borsa & Endeks Grafiği</button>
                        <button class="bp-sekme-btn ${aktifSekme==='doviz'?'aktif':''}" onclick="window.adaFinansHavaAc('doviz')">💱 Serbest Piyasa Döviz</button>
                        <button class="bp-sekme-btn ${aktifSekme==='altin'?'aktif':''}" onclick="window.adaFinansHavaAc('altin')">🪙 Altın & Kıymetli Metal</button>
                        <button class="bp-sekme-btn" onclick="window.adaSadeceHavaAc()">☀️ Adalar Hava & Deniz</button>
                        <button class="bp-sekme-btn" onclick="window.adaDepremSayfasiAc()">🚨 Son Depremler</button>
                        <button class="bp-sekme-btn" onclick="window.adaNobetciEczaneAc()">💊 Nöbetçi Eczaneler</button>
                    </div>
                    <div class="bp-grafik-kutu" id="bpCanliGrafikKonteyner"></div>
                    <h2 style="font-size:18px;font-weight:800;margin:22px 0 10px;">📊 Borsa İstanbul Hisse Senetleri (A-Z Filtreli)</h2>
                    <div class="bp-harf-bar">${harfler.map(h => `<button class="bp-harf-btn ${h===seciliHarf?'aktif':''}" data-harf="${h}" onclick="window.bpHisseHarfSec('${h}')">${h}</button>`).join("")}</div>
                    <div style="overflow-x:auto;"><table class="bp-tablo"><thead><tr><th>Sembol / Şirket Adı</th><th>Grafik</th><th>Son Fiyat</th><th>Fark (%)</th><th>Fark</th><th>Alış / Satış</th></tr></thead><tbody id="bpHisseTabloGövde"></tbody></table></div>
                    <h2 style="font-size:18px;font-weight:800;margin-bottom:12px;">💱 Serbest Piyasa Döviz Kurları (Canlı)</h2>
                    <div style="overflow-x:auto;"><table class="bp-tablo"><thead><tr><th>Döviz Cinsi</th><th>Alış (TL)</th><th>Satış (TL)</th><th>Fark (%)</th></tr></thead><tbody>
                        <tr><td>🇺🇸 <strong>ABD Doları</strong> (USD/TRY)</td><td>${trSayi(piyasaVeri.usd.alis, 4)}</td><td><strong id="tabloUsdSatis">${trSayi(piyasaVeri.usd.satis, 4)}</strong></td><td class="bp-up">↑ %${trSayi(piyasaVeri.usd.degisim, 2)}</td></tr>
                        <tr><td>🇪🇺 <strong>Euro</strong> (EUR/TRY)</td><td>${trSayi(piyasaVeri.eur.alis, 4)}</td><td><strong id="tabloEurSatis">${trSayi(piyasaVeri.eur.satis, 4)}</strong></td><td class="bp-down">↓ %${trSayi(piyasaVeri.eur.degisim, 2)}</td></tr>
                        <tr><td>🇬🇧 <strong>İngiliz Sterlini</strong> (GBP/TRY)</td><td>${trSayi(piyasaVeri.gbp.alis, 4)}</td><td><strong>${trSayi(piyasaVeri.gbp.satis, 4)}</strong></td><td class="bp-down">↓ %${trSayi(piyasaVeri.gbp.degisim, 2)}</td></tr>
                        <tr><td>🇨🇭 <strong>İsviçre Frangı</strong> (CHF/TRY)</td><td>${trSayi(piyasaVeri.chf.alis, 4)}</td><td><strong>${trSayi(piyasaVeri.chf.satis, 4)}</strong></td><td class="bp-down">↓ %${trSayi(piyasaVeri.chf.degisim, 2)}</td></tr>
                    </tbody></table></div>
                    <h2 style="font-size:18px;font-weight:800;margin:20px 0 12px;">🪙 Serbest Piyasa Altın Fiyatları (Canlı)</h2>
                    <div style="overflow-x:auto;"><table class="bp-tablo"><thead><tr><th>Altın Cinsi</th><th>Alış (TL)</th><th>Satış (TL)</th><th>Fark (%)</th></tr></thead><tbody>
                        <tr><td>🟡 <strong>Gram Altın (TL/GR)</strong></td><td>${trSayi(piyasaVeri.gramAltin.alis, 2)}</td><td><strong id="tabloGramSatis">${trSayi(piyasaVeri.gramAltin.satis, 2)}</strong></td><td class="bp-down">↓ %${trSayi(piyasaVeri.gramAltin.degisim, 2)}</td></tr>
                        <tr><td>🟡 <strong>Çeyrek Altın</strong></td><td>${trSayi(piyasaVeri.ceyrekAltin.alis, 2)}</td><td><strong id="tabloCeyrekSatis">${trSayi(piyasaVeri.ceyrekAltin.satis, 2)}</strong></td><td class="bp-down">↓ %${trSayi(piyasaVeri.ceyrekAltin.degisim, 2)}</td></tr>
                        <tr><td>🟡 <strong>Yarım Altın</strong></td><td>${trSayi(piyasaVeri.yarimAltin.alis, 2)}</td><td><strong>${trSayi(piyasaVeri.yarimAltin.satis, 2)}</strong></td><td class="bp-down">↓ %${trSayi(piyasaVeri.yarimAltin.degisim, 2)}</td></tr>
                        <tr><td>🟡 <strong>Tam Altın</strong></td><td>${trSayi(piyasaVeri.tamAltin.alis, 2)}</td><td><strong>${trSayi(piyasaVeri.tamAltin.satis, 2)}</strong></td><td class="bp-down">↓ %${trSayi(piyasaVeri.tamAltin.degisim, 2)}</td></tr>
                        <tr><td>🇹🇷 <strong>Cumhuriyet Altını</strong></td><td>${trSayi(piyasaVeri.cumhuriyet.alis, 2)}</td><td><strong>${trSayi(piyasaVeri.cumhuriyet.satis, 2)}</strong></td><td class="bp-down">↓ %${trSayi(piyasaVeri.cumhuriyet.degisim, 2)}</td></tr>
                    </tbody></table></div>
                    <div class="bp-cevirici-kutu">
                        <h3 style="font-size:16px;font-weight:800;margin:0;">🔄 Hızlı Döviz & Altın Hesaplama (Çevirici)</h3>
                        <div class="bp-cevirici-grid">
                            <input type="number" id="ceviriMiktar" value="100" min="1" oninput="window.adaKurHesapla()">
                            <select id="ceviriBirim" onchange="window.adaKurHesapla()">
                                <option value="usd">🇺🇸 ABD Doları ($)</option>
                                <option value="eur">🇪🇺 Euro (€)</option>
                                <option value="gbp">🇬🇧 İngiliz Sterlini (£)</option>
                                <option value="gramAltin">🟡 Gram Altın</option>
                                <option value="ceyrekAltin">🟡 Çeyrek Altın</option>
                            </select>
                            <div style="text-align:center;font-weight:900;font-size:18px;">➔</div>
                            <input type="text" id="ceviriSonuc" readonly value="${trSayi(100 * piyasaVeri.usd.satis, 2)} TL">
                        </div>
                    </div>
                </div>
            `;
            window.bpGrafikCiz(seciliEndeks, seciliPeriyot);
            window.bpHisseHarfSec(seciliHarf);
        };

        window.adaKurHesapla = function() {
            const miktar = parseFloat(document.getElementById("ceviriMiktar")?.value) || 0;
            const birim = document.getElementById("ceviriBirim")?.value || "usd";
            const kur = piyasaVeri[birim]?.satis || 0;
            const sonucInput = document.getElementById("ceviriSonuc");
            if (sonucInput) sonucInput.value = trSayi(miktar * kur, 2) + " TL";
        };

        window.adaSadeceHavaAc = async function() {
            const alan = getOrCreateMerkezAlan();
            alan.innerHTML = `<div class="bp-kapsayici"><p>⏳ Adalar Meteoroloji ve Deniz Raporu yükleniyor...</p></div>`;
            let sicaklik = 18, nem = 68, basinc = 1015, rHiz = 19, rYon = "Poyraz", durum = "Açık, Parçalı Bulutlu", ikon = "⛅", gunler = [];
            try {
                const r = await fetch("https://api.open-meteo.com/v1/forecast?latitude=40.8742&longitude=29.1286&current=temperature_2m,relative_humidity_2m,surface_pressure,weather_code,wind_speed_10m,wind_direction_10m&daily=weather_code,temperature_2m_max,temperature_2m_min,wind_speed_10m_max,precipitation_probability_max&timezone=Europe%2FIstanbul&forecast_days=7");
                if (r.ok) {
                    const d = await r.json();
                    if (d.current) {
                        sicaklik = Math.round(d.current.temperature_2m); nem = d.current.relative_humidity_2m || 68; basinc = Math.round(d.current.surface_pressure || 1015);
                        rHiz = Math.round(d.current.wind_speed_10m); rYon = ruzgarAdiBul(d.current.wind_direction_10m);
                        const info = wmoDurumCoz(d.current.weather_code); durum = info.metin; ikon = info.ikon;
                    }
                    if (d.daily && d.daily.time) {
                        gunler = d.daily.time.map((t, i) => ({
                            gun: new Date(t).toLocaleDateString("tr-TR", { weekday: "long", day: "numeric", month: "short" }),
                            max: Math.round(d.daily.temperature_2m_max[i]), min: Math.round(d.daily.temperature_2m_min[i]),
                            ruzgar: Math.round(d.daily.wind_speed_10m_max[i]), yagis: d.daily.precipitation_probability_max ? d.daily.precipitation_probability_max[i] : 10,
                            ikon: wmoDurumCoz(d.daily.weather_code[i]).ikon
                        }));
                    }
                }
            } catch (e) {}
            const vapurRisk = rHiz > 38 ? `<span style="color:#ef4444;font-weight:900;">⚠️ Kuvvetli Rüzgar (${rHiz} km/s): Bazı vapur seferlerinde aksama olabilir!</span>` : `<span style="color:#10b981;font-weight:800;">✅ Deniz ulaşımı ve vapur seferleri için hava elverişli.</span>`;
            alan.innerHTML = `
                <div class="bp-kapsayici">
                    <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid var(--cizgi);padding-bottom:14px;margin-bottom:20px;flex-wrap:wrap;gap:10px;">
                        <div><span style="font-size:11px;font-weight:800;color:var(--ana-kirmizi);">PRENS ADALARI METEOROLOJİ & DENİZ MERKEZİ</span><h1 style="font-size:24px;font-weight:900;color:var(--metin-ana);margin:0;">☀️ Adalar Ayrıntılı Hava ve Deniz Durumu</h1></div>
                        <button type="button" onclick="window.kategoriSec('Tümü')" style="background:var(--ana-kirmizi);color:#fff;border:none;cursor:pointer;font-weight:800;font-size:13px;padding:9px 16px;border-radius:6px;">✕ Kapat / Habere Dön</button>
                    </div>
                    <div style="background:linear-gradient(135deg,#0f172a,#1e3a8a);color:#fff;border-radius:12px;padding:24px;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;align-items:center;margin-bottom:22px;">
                        <div style="display:flex;align-items:center;gap:18px;"><div style="font-size:64px;line-height:1;">${ikon}</div><div><div style="font-size:42px;font-weight:900;line-height:1;">${sicaklik}°C</div><div style="font-size:18px;font-weight:700;color:#93c5fd;margin-top:4px;">${durum}</div><div style="font-size:12.5px;color:#cbd5e1;margin-top:4px;">📍 Büyükada • Heybeliada • Burgazada • Kınalıada</div></div></div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;background:rgba(255,255,255,0.1);padding:14px;border-radius:10px;font-size:13px;"><div>💨 <strong>Rüzgar Yönü:</strong><br>${rYon} (${rHiz} km/s)</div><div>💧 <strong>Nem Oranı:</strong><br>%${nem}</div><div>🌊 <strong>Marmara Deniz Suyu:</strong><br>${Math.max(11, sicaklik - 2)}°C</div><div>🧭 <strong>Basınç:</strong><br>${basinc} hPa</div></div>
                    </div>
                    <div style="background:var(--arkaplan);border:1px solid var(--cizgi);border-left:4px solid #0ea5e9;padding:14px 16px;border-radius:8px;margin-bottom:22px;font-size:13.5px;">⛴️ <strong>Vapur & Deniz Ulaşımı Değerlendirmesi:</strong> ${vapurRisk}</div>
                    <h2 style="font-size:18px;font-weight:800;margin-bottom:12px;">📅 Adalar 7 Günlük Hava ve Rüzgar Tahmini</h2>
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px;">${gunler.map(g => `<div class="hava-gun-kart"><div style="font-weight:800;font-size:13px;color:var(--metin-ana);">${g.gun}</div><div style="font-size:32px;margin:8px 0;">${g.ikon}</div><div style="font-size:17px;font-weight:900;color:var(--ana-kirmizi);">${g.max}° <span style="color:#64748b;font-size:13px;">/ ${g.min}°</span></div><div style="font-size:11.5px;color:var(--metin-alt);margin-top:6px;">💨 Rüzgar: ${g.ruzgar} km/s</div><div style="font-size:11px;color:#0284c7;font-weight:700;margin-top:3px;">☔ Yağış: %${g.yagis}</div></div>`).join("")}</div>
                </div>
            `;
        };

        window.adaDepremSayfasiAc = async function() {
            const alan = getOrCreateMerkezAlan();
            alan.innerHTML = `<div class="bp-kapsayici"><p>⏳ Kandilli Rasathanesi ve AFAD son depremler listesi yükleniyor...</p></div>`;
            let depremler = [];
            try {
                const r = await fetch("https://api.orhanaydogdu.com.tr/deprem/kandilli/live");
                if (r.ok) { const d = await r.json(); if (d && Array.isArray(d.result)) depremler = d.result.slice(0, 40); }
            } catch (e) {}
            alan.innerHTML = `
                <div class="bp-kapsayici">
                    <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid var(--cizgi);padding-bottom:14px;margin-bottom:18px;flex-wrap:wrap;gap:10px;">
                        <div><span style="font-size:11px;font-weight:800;color:var(--ana-kirmizi);">KANDİLLİ RASATHANESİ & AFAD ANLIK VERİ MERKEZİ</span><h1 style="font-size:24px;font-weight:900;color:var(--metin-ana);margin:0;"><span class="canli-nokta"></span>Türkiye ve Marmara Son Depremler</h1></div>
                        <div style="display:flex;gap:8px;"><button type="button" onclick="window.adaDepremSayfasiAc()" style="background:#0f172a;color:#fff;border:none;padding:8px 14px;border-radius:6px;font-weight:700;font-size:12px;cursor:pointer;">🔄 Listeyi Yenile</button><button type="button" onclick="window.kategoriSec('Tümü')" style="background:var(--ana-kirmizi);color:#fff;border:none;cursor:pointer;font-weight:800;font-size:12.5px;padding:8px 14px;border-radius:6px;">✕ Kapat</button></div>
                    </div>
                    <div style="overflow-x:auto;"><table class="bp-tablo"><thead><tr><th>Tarih / Saat</th><th>Büyüklük</th><th>Merkez Üssü / Bölge</th><th>Derinlik</th></tr></thead><tbody>
                        ${depremler.length === 0 ? `<tr><td colspan="4" style="text-align:center;padding:20px;">Veri kaynağına bağlanıyor, lütfen yenileyin.</td></tr>` : depremler.map(dep => {
                            const mag = parseFloat(dep.mag || 0), renk = mag >= 4.0 ? "#ef4444" : (mag >= 3.0 ? "#f59e0b" : "#10b981"), derinlik = dep.depth || (dep.geojson ? dep.geojson.coordinates[2] : "-");
                            return `<tr><td><strong>${dep.date_time || dep.date || ""}</strong></td><td><span style="background:${renk};color:#fff;padding:4px 10px;border-radius:6px;font-weight:900;font-size:13.5px;">${mag.toFixed(1)}</span></td><td><strong>${dep.title || ""}</strong></td><td>${derinlik} km</td></tr>`;
                        }).join("")}
                    </tbody></table></div>
                </div>
            `;
        };

        window.adaNobetciEczaneAc = function() {
            const alan = getOrCreateMerkezAlan();
            const bugun = new Date().toLocaleDateString("tr-TR", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
            const eczaneler = [
                { ada: "BÜYÜKADA", ad: "Büyükada Eczanesi", tel: "0216 382 60 56", adres: "Çınar Caddesi No:12 (Saat Kulesi Meydanı Yakını), Büyükada" },
                { ada: "BÜYÜKADA", ad: "Merkez Eczanesi", tel: "0216 382 62 63", adres: "Recep Koç Caddesi No:24 (İskele Karşısı), Büyükada" },
                { ada: "BÜYÜKADA", ad: "Yeni Eczane", tel: "0216 382 61 52", adres: "Lonca Sokak No:4, Büyükada" },
                { ada: "BÜYÜKADA", ad: "Halk Eczanesi", tel: "0216 382 71 15", adres: "Kıvılcım Sokak No:2, Büyükada" },
                { ada: "HEYBELİADA", ad: "Heybeliada Eczanesi", tel: "0216 351 84 10", adres: "Ayyıldız Caddesi No:28 (Çarşı İçi), Heybeliada" },
                { ada: "HEYBELİADA", ad: "Sağlık Eczanesi", tel: "0216 351 85 45", adres: "Refah Şehitleri Caddesi No:19, Heybeliada" },
                { ada: "BURGAZADA", ad: "Burgazada Eczanesi", tel: "0216 381 12 31", adres: "Yalı Caddesi No:14 (İskele Meydanı), Burgazada" },
                { ada: "KINALIADA", ad: "Kınalıada Eczanesi", tel: "0216 381 41 18", adres: "Çarşı Caddesi No:22 (İskele Yakını), Kınalıada" }
            ];
            alan.innerHTML = `
                <div class="bp-kapsayici">
                    <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid var(--cizgi);padding-bottom:14px;margin-bottom:18px;flex-wrap:wrap;gap:10px;">
                        <div><span style="font-size:11px;font-weight:800;color:var(--ana-kirmizi);">ADALAR SAĞLIK & ECZANE REHBERİ • ${bugun}</span><h1 style="font-size:24px;font-weight:900;color:var(--metin-ana);margin:0;">💊 Adalar İlçesi Nöbetçi Eczaneler</h1></div>
                        <button type="button" onclick="window.kategoriSec('Tümü')" style="background:var(--ana-kirmizi);color:#fff;border:none;cursor:pointer;font-weight:800;font-size:13px;padding:9px 16px;border-radius:6px;">✕ Kapat</button>
                    </div>
                    <div style="background:#fef2f2;border:2px solid #fca5a5;border-radius:10px;padding:16px;margin-bottom:20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
                        <div><h3 style="color:#991b1b;font-size:16px;font-weight:900;margin:0 0 4px 0;">🏥 İstanbul Eczacı Odası (İEO) Resmi Günlük Nöbet Listesi</h3><p style="font-size:13px;color:#7f1d1d;margin:0;">Adalar'da her adada dönüşümlü nöbet tutulmaktadır. İcap nöbetçisi doğrulaması için tıklayabilir veya eczaneyi arayabilirsiniz.</p></div>
                        <a href="https://www.eczaneler.gen.tr/nobetci-istanbul-adalar" target="_blank" rel="noopener" style="background:#d90423;color:#fff;text-decoration:none;padding:10px 18px;border-radius:6px;font-weight:800;font-size:13px;">🔍 İEO Resmi Nöbet Sorgula ➔</a>
                    </div>
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;">${eczaneler.map(e => `<div style="border:1px solid var(--cizgi);border-top:4px solid #d90423;border-radius:8px;padding:16px;background:var(--kart-bg);"><span style="background:#fee2e2;color:#b91c1c;font-size:10.5px;font-weight:800;padding:3px 8px;border-radius:4px;">📍 ${e.ada}</span><h3 style="font-size:17px;font-weight:900;margin:8px 0 6px;color:var(--metin-ana);">𝐄 ${e.ad}</h3><p style="font-size:12.5px;color:var(--metin-alt);margin-bottom:12px;line-height:1.4;">${e.adres}</p><a href="tel:${e.tel.replace(/\s+/g,'')}" style="display:inline-flex;align-items:center;gap:6px;background:#16a34a;color:#fff;text-decoration:none;font-weight:800;font-size:13px;padding:8px 14px;border-radius:6px;">📞 ${e.tel} (Hemen Ara)</a></div>`).join("")}</div>
                </div>
            `;
        };

        const hazirOteller = [
            { id: "splendid", ad: "Splendid Palace Hotel (1908)", ada: "Büyükada", tur: "Tarihi Lüks Otel", fiyat: "6.500 TL - 12.000 TL", tel: "0216 382 69 50", adres: "23 Nisan Cad. No:39 Nizam, Büyükada", ozellik: "Tarihi Miras • Açık Havuz • Deniz Manzarası", sponsor: true },
            { id: "adapalas", ad: "Ada Palas Butik Otel", ada: "Büyükada", tur: "Tarihi Köşk & Butik", fiyat: "4.500 TL - 7.800 TL", tel: "0216 382 14 44", adres: "Çiçekli Yalı Sok. No:24 Maden, Büyükada", ozellik: "19. Yüzyıl Köşkü • Gizli Bahçe • Kahvaltı Dahil", sponsor: true },
            { id: "halki", ad: "Merit Halki Palace Hotel", ada: "Heybeliada", tur: "Tarihi Konaklama", fiyat: "5.200 TL - 9.500 TL", tel: "0216 351 00 25", adres: "Refah Şehitleri Cad. No:76, Heybeliada", ozellik: "Çam Ormanı • Açık Havuz • Panoramik Manzara", sponsor: true },
            { id: "pyrgos", ad: "Pyrgos Otel & Restaurant", ada: "Burgazada", tur: "Butik Otel", fiyat: "3.000 TL - 5.200 TL", tel: "0216 381 26 20", adres: "Yalı Cad. No:8 İskele Yanı, Burgazada", ozellik: "Denize Sıfır • Teras Restoran • Merkezi", sponsor: true },
            { id: "princess", ad: "Büyükada Princess Hotel", ada: "Büyükada", tur: "Otel", fiyat: "3.200 TL - 5.500 TL", tel: "0216 382 16 28", adres: "İskele Meydanı No:2, Büyükada", ozellik: "İskele Karşısı • Deniz Manzaralı • Merkezi", sponsor: false },
            { id: "ascot", ad: "Ascot Hotel Büyükada", ada: "Büyükada", tur: "Butik Otel", fiyat: "4.000 TL - 6.800 TL", tel: "0216 382 19 10", adres: "Çınar Cad. No:32, Büyükada", ozellik: "Açık Havuz • Bahçeli • Kahvaltı Dahil", sponsor: false },
            { id: "perili", ad: "Perili Köşk Concept Hotel", ada: "Heybeliada", tur: "Butik Köşk", fiyat: "3.400 TL - 5.800 TL", tel: "0216 351 17 77", adres: "Ayyıldız Cad. No:58, Heybeliada", ozellik: "Denize Sıfır • Özel Plaj • Tarihi Köşk", sponsor: false },
            { id: "kinali", ad: "Kınalıada Sahil Butik & Pansiyon", ada: "Kınalıada", tur: "Butik & Pansiyon", fiyat: "2.200 TL - 3.800 TL", tel: "0216 381 45 50", adres: "Çarşı Cad. Sahil Yolu No:19, Kınalıada", ozellik: "Deniz Manzaralı • Plaja ve İskeleye Yakın", sponsor: false }
        ];

        window.adaOtellerSayfasiAc = function(seciliAda = "Tümü") {
            const alan = getOrCreateMerkezAlan();
            const adalar = ["Tümü", "Büyükada", "Heybeliada", "Burgazada", "Kınalıada"];
            const filtreli = seciliAda === "Tümü" ? hazirOteller : hazirOteller.filter(o => o.ada === seciliAda);
            alan.innerHTML = `
                <div class="bp-kapsayici">
                    <div style="display:flex;justify-content:space-between;align-items:center;border-bottom:2px solid var(--cizgi);padding-bottom:14px;margin-bottom:18px;flex-wrap:wrap;gap:10px;">
                        <div><span style="font-size:11px;font-weight:800;color:var(--ana-kirmizi);">PRENS ADALARI KONAKLAMA & TURİZM REHBERİ</span><h1 style="font-size:24px;font-weight:900;color:var(--metin-ana);margin:0;">🏨 Adalar Otel, Köşk ve Pansiyon Rehberi</h1></div>
                        <button type="button" onclick="window.kategoriSec('Tümü')" style="background:var(--ana-kirmizi);color:#fff;border:none;cursor:pointer;font-weight:800;font-size:13px;padding:9px 16px;border-radius:6px;">✕ Kapat</button>
                    </div>
                    <div style="display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap;">${adalar.map(a => `<button type="button" onclick="window.adaOtellerSayfasiAc('${a}')" style="padding:8px 16px;border-radius:20px;border:1px solid var(--cizgi);background:${seciliAda===a?'var(--ana-kirmizi)':'var(--arkaplan)'};color:${seciliAda===a?'#fff':'var(--metin-ana)'};font-weight:800;font-size:13px;cursor:pointer;">🏝️ ${a}</button>`).join("")}</div>
                    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;">${filtreli.map(o => `<div style="border:${o.sponsor?'2px solid #f59e0b':'1px solid var(--cizgi)'};border-top:4px solid ${o.sponsor?'#f59e0b':'var(--ana-kirmizi)'};border-radius:10px;padding:16px;background:var(--kart-bg);display:flex;flex-direction:column;justify-content:space-between;"><div><div style="display:flex;justify-content:space-between;align-items:center;gap:6px;margin-bottom:8px;"><span style="background:#fee2e2;color:#b91c1c;font-size:10.5px;font-weight:800;padding:3px 8px;border-radius:4px;">📍 ${o.ada.toUpperCase()} • ${o.tur}</span>${o.sponsor ? `<span style="background:linear-gradient(135deg,#ffd700,#f59e0b);color:#111;font-size:10px;font-weight:900;padding:3px 8px;border-radius:4px;">⭐ ÖNERİLEN OTEL</span>` : ""}</div><h3 style="font-size:18px;font-weight:900;color:var(--metin-ana);margin:0 0 6px 0;">🏨 ${o.ad}</h3><div style="font-size:12px;color:#0284c7;font-weight:700;margin-bottom:8px;">✨ ${o.ozellik}</div><p style="font-size:12.5px;color:var(--metin-alt);margin-bottom:12px;">🗺️ <strong>Adres:</strong> ${o.adres}</p></div><div><div style="background:var(--arkaplan);padding:10px 12px;border-radius:8px;border:1px solid var(--cizgi);margin-bottom:12px;display:flex;justify-content:space-between;align-items:center;"><span style="font-size:11.5px;color:var(--metin-alt);font-weight:700;">💰 Gecelik Oda:</span><strong style="font-size:14px;color:#16a34a;font-weight:900;">${o.fiyat}</strong></div><div style="display:flex;gap:8px;"><a href="tel:${o.tel.replace(/\s+/g,'')}" style="flex:1;text-align:center;background:#16a34a;color:#fff;text-decoration:none;font-weight:800;font-size:12.5px;padding:9px 10px;border-radius:6px;">📞 ${o.tel}</a><a href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(o.ad + ' ' + o.ada)}" target="_blank" rel="noopener" style="background:var(--arkaplan);color:var(--metin-ana);border:1px solid var(--cizgi);text-decoration:none;font-weight:700;font-size:12px;padding:9px 12px;border-radius:6px;">🗺️ Harita</a></div></div></div>`).join("")}</div>
                </div>
            `;
        };

        function checkHashRoute() {
            const h = window.location.hash;
            if (h === "#canli-borsa") window.adaFinansHavaAc("borsa");
            else if (h === "#canli-doviz") window.adaFinansHavaAc("doviz");
            else if (h === "#canli-altin") window.adaFinansHavaAc("altin");
            else if (h === "#hava-durumu") window.adaSadeceHavaAc();
            else if (h === "#son-depremler") window.adaDepremSayfasiAc();
            else if (h === "#nobetci-eczaneler") window.adaNobetciEczaneAc();
            else if (h === "#oteller") window.adaOtellerSayfasiAc("Tümü");
        }
        window.addEventListener("hashchange", checkHashRoute);

        function initPiyasaVeHava() {
            tumPiyasaBarlariniGuncelle();
            canliHavaDurumuCek();
            checkHashRoute();
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", initPiyasaVeHava);
        } else {
            initPiyasaVeHava();
        }
    })();
    </script>
        <style>
    .ada-news-slider {
        position: relative !important;
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
        margin: 22px 0 !important;
        padding: 0 !important;
        background: #111 !important;
        border-radius: 12px !important;
        overflow: hidden !important;
        box-shadow: 0 8px 24px rgba(0,0,0,0.2) !important;
        user-select: none;
        clear: both !important;
        float: none !important;
    }
    .ada-slider-stage {
        position: relative !important;
        width: 100% !important;
        height: 460px !important;
        box-sizing: border-box !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        overflow: hidden !important;
        background: #0d0d0d !important;
        padding: 0 !important;
        margin: 0 !important;
    }
    .ada-slider-bg {
        position: absolute !important;
        inset: -20px !important;
        background-size: cover !important;
        background-position: center !important;
        filter: blur(22px) brightness(0.42) !important;
        transform: scale(1.1) !important;
        z-index: 1 !important;
    }
    .ada-slider-main-img {
        position: relative !important;
        z-index: 2 !important;
        max-width: 100% !important;
        max-height: 100% !important;
        width: auto !important;
        height: auto !important;
        object-fit: contain !important;
        cursor: zoom-in !important;
        margin: 0 auto !important;
        padding: 0 !important;
        float: none !important;
        left: auto !important;
        right: auto !important;
        border: none !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        display: block !important;
    }
    .ada-slider-arrow {
        position: absolute !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        z-index: 10 !important;
        width: 44px !important;
        height: 44px !important;
        border-radius: 50% !important;
        background: #D32F2F !important;
        color: #fff !important;
        border: 2px solid rgba(255,255,255,0.92) !important;
        font-size: 20px !important;
        font-weight: bold !important;
        line-height: 1 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: pointer !important;
        box-shadow: 0 4px 14px rgba(0,0,0,0.45) !important;
        padding: 0 !important;
        margin: 0 !important;
    }
    .ada-slider-arrow:hover { background: #b71c1c !important; }
    .ada-slider-prev { left: 12px !important; right: auto !important; }
    .ada-slider-next { right: 12px !important; left: auto !important; }
    .ada-slider-badge {
        position: absolute !important;
        top: 12px !important;
        right: 12px !important;
        z-index: 10 !important;
        background: rgba(211, 47, 47, 0.95) !important;
        color: #fff !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        padding: 4px 12px !important;
        border-radius: 20px !important;
        box-shadow: 0 2px 8px rgba(0,0,0,0.35) !important;
    }
    .ada-slider-thumbs {
        display: flex !important;
        gap: 8px !important;
        padding: 10px 12px !important;
        background: #181818 !important;
        overflow-x: auto !important;
        box-sizing: border-box !important;
        width: 100% !important;
    }
    .ada-slider-thumb {
        width: 66px !important;
        height: 46px !important;
        object-fit: cover !important;
        border-radius: 6px !important;
        cursor: pointer !important;
        opacity: 0.55;
        border: 2px solid transparent !important;
        transition: all 0.2s;
        flex-shrink: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        float: none !important;
    }
    .ada-slider-thumb.active {
        opacity: 1 !important;
        border-color: #D32F2F !important;
    }
    #ada-lightbox {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999999;
        background: rgba(0,0,0,0.94);
        align-items: center;
        justify-content: center;
    }
    #ada-lightbox img {
        max-width: 94vw;
        max-height: 90vh;
        object-fit: contain;
    }
    #ada-lightbox-close {
        position: absolute;
        top: 18px;
        right: 22px;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: #D32F2F;
        color: #fff;
        border: none;
        font-size: 24px;
        cursor: pointer;
    }
    @media (max-width: 768px) {
        .ada-slider-stage { height: 310px !important; }
        .ada-slider-arrow { width: 38px !important; height: 38px !important; font-size: 18px !important; }
        .ada-slider-prev { left: 10px !important; }
        .ada-slider-next { right: 10px !important; }
        .ada-slider-thumb { width: 56px !important; height: 40px !important; }
    }
    </style>

    <div id="ada-lightbox">
        <button type="button" id="ada-lightbox-close" aria-label="Kapat">&times;</button>
        <img id="ada-lightbox-img" src="" alt="">
    </div>

    <script>
    (function() {
        function runAdaSlider() {
            const HABER_BASLIGI = "Yass\u0131ada\u2019daki turizm tesislerinin ihalesi yap\u0131ld\u0131" || document.title;
            const bodyWrap = document.querySelector(".ada-article-body-wrap");
            if (!bodyWrap) return;

            function getBestImgSrc(img) {
                let src = img.getAttribute("data-src") || img.getAttribute("data-lazy-src") || img.getAttribute("data-large_image") || img.currentSrc || img.src || "";
                const parentA = img.closest("a");
                if (parentA && parentA.href && /\.(jpe?g|png|webp|gif|avif)(\?.*)?$/i.test(parentA.href)) {
                    src = parentA.href;
                } else {
                    src = src.replace(/-\d+x\d+(?=\.(jpe?g|png|webp|gif|avif))/i, "");
                }
                return src;
            }

            function getCleanAlt(img, index) {
                const rawAlt = (img.getAttribute("alt") || "").trim();
                if (!rawAlt || /whatsapp|img_|dsc_|screenshot|ekran|\.html-|\d+[x×]\d+/i.test(rawAlt)) {
                    return HABER_BASLIGI + " - Fotoğraf " + (index + 1);
                }
                return rawAlt;
            }

            const allImgs = Array.from(bodyWrap.querySelectorAll("img")).filter(function(img) {
                const w = img.getAttribute("width");
                if (w && parseInt(w, 10) < 60) return false;
                return true;
            });

            if (allImgs.length < 2) return;

            const items = [];
            const seen = new Set();
            allImgs.forEach(function(img) {
                const src = getBestImgSrc(img);
                if (!src || seen.has(src)) return;
                seen.add(src);
                items.push({
                    src: src,
                    alt: getCleanAlt(img, items.length)
                });
            });

            if (items.length < 2) return;

            const wrapper = document.createElement("div");
            wrapper.className = "ada-news-slider";
            wrapper.innerHTML =
                '<div class="ada-slider-stage">' +
                    '<div class="ada-slider-bg"></div>' +
                    '<span class="ada-slider-badge">1 / ' + items.length + '</span>' +
                    '<button type="button" class="ada-slider-arrow ada-slider-prev" aria-label="Önceki">&#10094;</button>' +
                    '<img class="ada-slider-main-img" src="" alt="" title="">' +
                    '<button type="button" class="ada-slider-arrow ada-slider-next" aria-label="Sonraki">&#10095;</button>' +
                '</div>' +
                '<div class="ada-slider-thumbs"></div>';

            const bg = wrapper.querySelector(".ada-slider-bg");
            const mainImg = wrapper.querySelector(".ada-slider-main-img");
            const badge = wrapper.querySelector(".ada-slider-badge");
            const thumbsBox = wrapper.querySelector(".ada-slider-thumbs");
            const btnPrev = wrapper.querySelector(".ada-slider-prev");
            const btnNext = wrapper.querySelector(".ada-slider-next");

            let current = 0;
            const thumbEls = items.map(function(item, idx) {
                const t = document.createElement("img");
                t.className = "ada-slider-thumb";
                t.src = item.src;
                t.alt = item.alt;
                t.title = item.alt;
                t.addEventListener("click", function() { goTo(idx); });
                thumbsBox.appendChild(t);
                return t;
            });

            function goTo(index) {
                current = (index + items.length) % items.length;
                const item = items[current];
                mainImg.src = item.src;
                mainImg.alt = item.alt;
                mainImg.title = item.alt;
                bg.style.backgroundImage = 'url("' + item.src + '")';
                badge.textContent = (current + 1) + " / " + items.length;

                thumbEls.forEach(function(t, i) {
                    t.classList.toggle("active", i === current);
                });
                if (thumbEls[current]) {
                    thumbEls[current].scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
                }
            }

            btnPrev.addEventListener("click", function(e) { e.preventDefault(); goTo(current - 1); });
            btnNext.addEventListener("click", function(e) { e.preventDefault(); goTo(current + 1); });

            let startX = 0;
            const stage = wrapper.querySelector(".ada-slider-stage");
            stage.addEventListener("touchstart", function(e) {
                startX = e.changedTouches[0].screenX;
            }, { passive: true });
            stage.addEventListener("touchend", function(e) {
                const diff = e.changedTouches[0].screenX - startX;
                if (Math.abs(diff) > 40) {
                    if (diff < 0) goTo(current + 1);
                    else goTo(current - 1);
                }
            }, { passive: true });

            mainImg.addEventListener("click", function() {
                const lb = document.getElementById("ada-lightbox");
                const lbImg = document.getElementById("ada-lightbox-img");
                if (lb && lbImg) {
                    lbImg.src = items[current].src;
                    lbImg.alt = items[current].alt;
                    lb.style.display = "flex";
                }
            });

            const lb = document.getElementById("ada-lightbox");
            if (lb) {
                lb.addEventListener("click", function() { lb.style.display = "none"; });
            }

            // Slider'ı dar galeri kutusunun içine değil, doğrudan ana yazı alanına (bodyWrap) yerleştir!
            let topLevelFirstBlock = allImgs[0];
            while (topLevelFirstBlock.parentElement && topLevelFirstBlock.parentElement !== bodyWrap) {
                topLevelFirstBlock = topLevelFirstBlock.parentElement;
            }
            bodyWrap.insertBefore(wrapper, topLevelFirstBlock);

            // Eski resimleri ve Safir Odak'ın "1 | 8 dosya-adi-268x420" galeri kutularını temizle
            const touchedTopBlocks = new Set();
            allImgs.forEach(function(img) {
                let top = img;
                while (top.parentElement && top.parentElement !== bodyWrap) {
                    top = top.parentElement;
                }
                touchedTopBlocks.add(top);

                const galItem = img.closest(".gallery-item, .blocks-gallery-item, figure, .safir-galeri-item, .galeri-item");
                if (galItem && bodyWrap.contains(galItem)) {
                    galItem.remove();
                    return;
                }
                const parentA = img.closest("a");
                const targetNode = (parentA && bodyWrap.contains(parentA) && parentA.innerText.trim() === "") ? parentA : img;
                targetNode.remove();
            });

            // Safir Odak'ın numaralı galeri başlık kutularını ("1 | 8", "2 | 8", ".html-2-268x420" vb.) tamamen kaldır
            touchedTopBlocks.forEach(function(block) {
                if (!block || block === wrapper || !bodyWrap.contains(block)) return;
                const txt = block.innerText.trim();
                // Eğer kutunun içinde sadece galeri numaraları / dosya adları kaldıysa veya boşsa komple sil
                if (txt === "" || /^\d+\s*\|\s*\d+/.test(txt) || /\.html-\d+|\d+[x×]\d+/i.test(txt)) {
                    block.remove();
                } else {
                    // İçinde gerçek haber paragrafı da olan karma bir kutuysa sadece içindeki galeri artıklarını sil
                    Array.from(block.querySelectorAll("div, p, span, h2, h3, h4, figure")).forEach(function(sub) {
                        if (sub.contains(wrapper)) return;
                        const st = sub.innerText.trim();
                        if ((st === "" && sub.querySelectorAll("img").length === 0) || /^\d+\s*\|\s*\d+/.test(st) || /\.html-\d+|\d+[x×]\d+/i.test(st)) {
                            sub.remove();
                        }
                    });
                }
            });

            // Son temizlik: bodyWrap içinde kalan "2 | 8" veya ".html-7-" gibi yetim galeri satırlarını süpür
            Array.from(bodyWrap.children).forEach(function(child) {
                if (child === wrapper) return;
                const ct = child.innerText.trim();
                if ((ct === "" && child.querySelectorAll("img, iframe, video").length === 0) || /^\d+\s*\|\s*\d+/.test(ct) || /\.html-\d+|\d+[x×]\d+/i.test(ct)) {
                    child.remove();
                }
            });

            goTo(0);
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", runAdaSlider);
        } else {
            runAdaSlider();
        }
    })();
    </script>
        <style>
    #ada-push-popup {
        display: none;
        position: fixed;
        z-index: 999999;
        bottom: 20px;
        right: 20px;
        max-width: 360px;
        width: calc(100% - 32px);
        background: #ffffff;
        color: #1e1e1e;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.22);
        padding: 16px 18px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        border-top: 4px solid #D32F2F;
    }
    #ada-push-popup .ada-push-title {
        font-size: 15px;
        font-weight: 700;
        margin: 0 0 6px 0;
        color: #111;
    }
    #ada-push-popup .ada-push-desc {
        font-size: 13px;
        line-height: 1.45;
        color: #555;
        margin: 0 0 14px 0;
    }
    #ada-push-popup .ada-push-btns {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }
    #ada-push-popup button {
        border: none;
        border-radius: 7px;
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }
    #ada-push-popup .ada-btn-allow { background: #D32F2F; color: #fff; }
    #ada-push-popup .ada-btn-later { background: #f1f3f5; color: #495057; }
    @media (max-width: 600px) {
        #ada-push-popup { bottom: 14px; right: 16px; left: 16px; max-width: none; }
    }
    </style>

    <div id="ada-push-popup" role="dialog" aria-label="Bildirim Aboneliği">
        <div class="ada-push-title">🔔 Ada Gazetesi Son Dakika</div>
        <div class="ada-push-desc">Adalar'daki önemli gelişmeler ve son dakika haberleri ücretsiz olarak anında telefonunuza ve ekranınıza gelsin mi?</div>
        <div class="ada-push-btns">
            <button type="button" class="ada-btn-later" id="ada-push-later">Daha Sonra</button>
            <button type="button" class="ada-btn-allow" id="ada-push-allow">Bildirimleri Aç</button>
        </div>
    </div>

    <script>
    (function() {
        if (!("serviceWorker" in navigator) || !("Notification" in window)) return;

        const VAPID_KEY = "BGEnuBdZgPF0LfJ_YvTDIWMAmms5wwpdH2wtNj-q_-zzSeDcdUTPX5FED57GuIH9Yl0QihlEaTK2AvaqsKd-350";
        const SUBSCRIBE_URL = "https:\/\/adagazetesi.com.tr\/wp-json\/ada-push\/v1\/subscribe";
        const FIRESTORE_URL = "https://firestore.googleapis.com/v1/projects/ada-gazetesi-bulut/databases/(default)/documents";
        const popup = document.getElementById("ada-push-popup");
        const btnAllow = document.getElementById("ada-push-allow");
        const btnLater = document.getElementById("ada-push-later");

        let fcmMessaging = null;

        function loadFirebaseSDK(cb) {
            if (fcmMessaging) return cb(fcmMessaging);
            const s1 = document.createElement("script");
            s1.src = "https://www.gstatic.com/firebasejs/10.13.0/firebase-app-compat.js";
            s1.onload = function() {
                const s2 = document.createElement("script");
                s2.src = "https://www.gstatic.com/firebasejs/10.13.0/firebase-messaging-compat.js";
                s2.onload = function() {
                    try {
                        const app = firebase.initializeApp({
                            apiKey: "AIzaSyDNyJXRBQjPRbNWYUjBvsr2kAMhoJxFVCE",
                            authDomain: "ada-gazetesi.firebaseapp.com",
                            projectId: "ada-gazetesi",
                            storageBucket: "ada-gazetesi.firebasestorage.app",
                            messagingSenderId: "782430483783",
                            appId: "1:782430483783:web:f6efd9aa024df883aac862"
                        }, "fcmWebPushApp");
                        fcmMessaging = app.messaging();

                        fcmMessaging.onMessage(function(payload) {
                            const title = (payload.notification && payload.notification.title) || (payload.data && payload.data.title) || "Ada Gazetesi";
                            const body = (payload.notification && payload.notification.body) || (payload.data && payload.data.body) || "";
                            const url = (payload.data && payload.data.url) || "https://adagazetesi.com.tr/";
                            if (Notification.permission === "granted") {
                                navigator.serviceWorker.getRegistration().then(function(reg) {
                                    if (reg) reg.showNotification(title, { body: body, tag: "ada-push-" + url, renotify: false, data: { url: url } });
                                });
                            }
                        });
                        cb(fcmMessaging);
                    } catch (e) {}
                };
                document.head.appendChild(s2);
            };
            document.head.appendChild(s1);
        }

        function registerAndSubscribeToken() {
            loadFirebaseSDK(function(messaging) {
                navigator.serviceWorker.register("/firebase-messaging-sw.js?v=2.1").then(function(reg) {
                    return messaging.getToken({
                        vapidKey: VAPID_KEY,
                        serviceWorkerRegistration: reg
                    });
                }).then(function(token) {
                    if (!token) return;
                    if (localStorage.getItem("ada_fcm_topic_v2") !== token) {
                        fetch(SUBSCRIBE_URL, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ token: token })
                        }).then(function(r) { return r.json(); }).then(function(res) {
                            if (res && res.ok) localStorage.setItem("ada_fcm_topic_v2", token);
                        }).catch(function(){});

                        const docId = btoa(token.substring(0, 15)).replace(/[^a-zA-Z0-9]/g, "");
                        fetch(FIRESTORE_URL + "/push_aboneleri/" + docId, {
                            method: "PATCH",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ fields: { token: { stringValue: token }, tarih: { stringValue: new Date().toISOString() } } })
                        }).catch(function(){});
                    }
                }).catch(function(){});
            });
        }

        if (Notification.permission === "granted") {
            setTimeout(registerAndSubscribeToken, 2000);
            return;
        }

        if (Notification.permission === "denied") return;
        const dismissedAt = parseInt(localStorage.getItem("ada_push_dismissed") || "0", 10);
        if (Date.now() - dismissedAt < 86400000) return;

        setTimeout(function() {
            if (popup) popup.style.display = "block";
        }, 2500);

        if (btnLater) {
            btnLater.addEventListener("click", function() {
                popup.style.display = "none";
                localStorage.setItem("ada_push_dismissed", Date.now().toString());
            });
        }

        if (btnAllow) {
            btnAllow.addEventListener("click", function() {
                popup.style.display = "none";
                Notification.requestPermission().then(function(permission) {
                    if (permission === "granted") registerAndSubscribeToken();
                });
            });
        }
    })();
    </script>
