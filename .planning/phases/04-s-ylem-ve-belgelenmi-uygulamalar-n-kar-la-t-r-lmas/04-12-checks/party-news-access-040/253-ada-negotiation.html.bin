    <style id="ada-hv-head-css">
    .ada-hv-wrapper { width:100%; max-width:1240px; margin:0 auto 24px auto; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; box-sizing:border-box; clear:both; }
    .ada-hv-wrapper * { box-sizing:border-box; }
    .ada-hv-ticker-bar { display:flex; align-items:center; background:#fff; border:1px solid #e2e8f0; border-radius:8px; padding:8px 12px; margin-bottom:14px; gap:12px; box-shadow:0 2px 6px rgba(0,0,0,0.03); }
    .ada-hv-ticker-label { font-size:13px; font-weight:900; color:#0f172a; white-space:nowrap; padding-right:12px; border-right:2px solid #e2e8f0; }
    .ada-hv-ticker-track { display:flex; gap:20px; overflow-x:auto; scrollbar-width:none; flex:1; scroll-behavior:smooth; }
    .ada-hv-ticker-track::-webkit-scrollbar { display:none; }
    .ada-hv-ticker-item { white-space:nowrap; font-size:13px; font-weight:600; color:#1e293b !important; text-decoration:none !important; }
    .ada-hv-ticker-item:hover { color:#d90423 !important; }
    .ada-hv-hash { color:#d90423; font-weight:800; margin-right:4px; }
    .ada-hv-ticker-next { width:28px; height:28px; border-radius:50%; border:none; background:#0284c7; color:#fff; font-weight:bold; cursor:pointer; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
    .ada-hv-top3-wrap { background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:12px; margin-bottom:16px; }
    .ada-hv-sicak-badge { display:inline-block; background:#d90423; color:#fff; font-size:11.5px; font-weight:900; padding:4px 12px; border-radius:4px; letter-spacing:0.6px; margin-bottom:10px; }
    .ada-hv-top3-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12px; }
    .ada-hv-top3-card { position:relative; display:block; height:195px; border-radius:8px; overflow:hidden; background:#111; text-decoration:none !important; }
    .ada-hv-top3-card img { width:100% !important; height:100% !important; object-fit:cover !important; transition:transform 0.35s ease; display:block; }
    .ada-hv-top3-card:hover img { transform:scale(1.05); }
    .ada-hv-top3-overlay { position:absolute; inset:auto 0 0 0; padding:28px 12px 10px; background:linear-gradient(transparent,rgba(0,0,0,0.92)); }
    .ada-hv-top3-overlay h3 { margin:0 !important; color:#fff !important; font-size:14.5px !important; font-weight:800 !important; line-height:1.3 !important; }
    .ada-hv-cat-pill { position:absolute; top:10px; left:10px; z-index:4; background:rgba(217,4,35,0.92); color:#fff; font-size:10.5px; font-weight:800; padding:3px 8px; border-radius:4px; }
    .ada-hv-vid-pill { position:absolute; top:10px; right:10px; z-index:4; background:rgba(15,23,42,0.88); color:#fde047; font-size:10.5px; font-weight:900; padding:3px 8px; border-radius:4px; border:1px solid rgba(253,224,71,0.5); }
    .ada-hv-main-grid { display:grid; grid-template-columns:52% 20% 28%; gap:14px; align-items:start; }
    .ada-hv-slider { position:relative; width:100%; height:390px; border-radius:10px; overflow:hidden; background:#0f172a; box-shadow:0 4px 16px rgba(0,0,0,0.12); }
    .ada-hv-slide { display:none; position:relative; width:100%; height:100%; text-decoration:none !important; }
    .ada-hv-slide.aktif { display:block; }
    .ada-hv-slide img { width:100% !important; height:100% !important; object-fit:cover !important; display:block; }
    .ada-hv-slide-overlay { position:absolute; inset:auto 0 0 0; padding:45px 18px 16px; background:linear-gradient(transparent,rgba(0,0,0,0.94)); }
    .ada-hv-slide-overlay h2 { margin:0 !important; color:#fff !important; font-size:22px !important; font-weight:900 !important; line-height:1.25 !important; text-shadow:0 2px 6px rgba(0,0,0,0.5); }
    .ada-hv-nav { position:absolute; top:46%; transform:translateY(-50%); z-index:6; width:38px; height:38px; border-radius:50%; border:none; background:rgba(0,0,0,0.55); color:#fff; font-size:18px; cursor:pointer; }
    .ada-hv-nav:hover { background:#d90423; }
    .ada-hv-prev { left:10px; }
    .ada-hv-next { right:10px; }
    .ada-hv-dots { display:flex; justify-content:space-between; gap:6px; margin:10px 0 6px 0; padding:4px 2px; }
    .ada-hv-dot { width:32px; height:32px; border-radius:50%; border:1px solid #cbd5e1; background:#fff; color:#1e293b; font-size:13px; font-weight:800; cursor:pointer; transition:all 0.15s; padding:0; }
    .ada-hv-dot.aktif,.ada-hv-dot:hover { background:#d90423; color:#fff; border-color:#d90423; transform:scale(1.08); }
    .ada-hv-piyasa { display:grid !important; grid-template-columns:repeat(4,minmax(0,1fr)) !important; gap:6px !important; margin:10px 0 12px 0 !important; padding:8px !important; background:#fff !important; border:1px solid #e2e8f0 !important; border-left:4px solid #d90423 !important; border-radius:8px !important; box-shadow:0 2px 8px rgba(0,0,0,0.04) !important; }
    .ada-hv-piyasa .piyasa-item { padding:6px 7px !important; min-width:0 !important; }
    .ada-hv-piyasa .piyasa-ad { font-size:10.5px !important; margin-bottom:4px !important; white-space:nowrap; }
    .ada-hv-piyasa .piyasa-ad small { display:none !important; }
    .ada-hv-piyasa .piyasa-deger-satir { flex-wrap:nowrap !important; gap:4px !important; }
    .ada-hv-piyasa .piyasa-fiyat { font-size:13px !important; }
    .ada-hv-piyasa .piyasa-oran { font-size:9.5px !important; padding:2px 4px !important; }
    .ada-hv-col-left .ada-hizli-servis-bar { margin:8px 0 4px 0 !important; }
    .ada-hv-col-mid,.ada-hv-col-right { display:flex; flex-direction:column; gap:12px; }
    .ada-hv-side-card { display:block; background:#fff; border:1px solid #e2e8f0; border-radius:8px; overflow:hidden; text-decoration:none !important; box-shadow:0 2px 6px rgba(0,0,0,0.04); transition:transform 0.2s,box-shadow 0.2s; }
    .ada-hv-side-card:hover { transform:translateY(-2px); box-shadow:0 6px 14px rgba(0,0,0,0.09); }
    .ada-hv-thumb { position:relative; width:100%; overflow:hidden; background:#111; }
    .ada-hv-mid-card .ada-hv-thumb { height:155px; }
    .ada-hv-right-card .ada-hv-thumb { height:180px; }
    .ada-hv-thumb img { width:100% !important; height:100% !important; object-fit:cover !important; display:block; }
    .ada-hv-side-body { padding:10px 11px; }
    .ada-hv-side-cat { display:block; font-size:10.5px; font-weight:800; color:#d90423; margin-bottom:4px; }
    .ada-hv-side-body h4 { margin:0 !important; font-size:13.5px !important; font-weight:800 !important; color:#0f172a !important; line-height:1.32 !important; }
    .ada-hv-right-card .ada-hv-side-body h4 { font-size:15px !important; }
    .ada-hv-tum-btn { display:block; text-align:center; background:#d90423; color:#fff !important; text-decoration:none !important; font-size:13px; font-weight:800; padding:10px; border-radius:7px; }
    .ada-hv-tum-btn:hover { background:#b91c1c; }
    @media (max-width:960px) {
        .ada-hv-top3-grid { grid-template-columns:1fr; }
        .ada-hv-top3-card { height:185px; }
        .ada-hv-main-grid { grid-template-columns:1fr; }
        .ada-hv-slider { height:260px; }
        .ada-hv-slide-overlay h2 { font-size:17px !important; }
        .ada-hv-dot { width:27px; height:27px; font-size:11.5px; }
        .ada-hv-piyasa { grid-template-columns:repeat(2,minmax(0,1fr)) !important; }
        .ada-hv-col-mid,.ada-hv-col-right { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
        .ada-hv-tum-btn { grid-column:span 2; }
    }
    </style>
