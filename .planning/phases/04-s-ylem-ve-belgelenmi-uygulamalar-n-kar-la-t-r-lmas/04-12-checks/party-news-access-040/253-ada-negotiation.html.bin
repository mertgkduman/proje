    <style>
        #ada-cerez-kutusu {
            position: fixed; bottom: 20px; left: 20px; max-width: 360px; background: #ffffff;
            color: #333333; padding: 20px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            border-top: 4px solid #d32f2f; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            z-index: 999999; display: none; box-sizing: border-box; animation: adaCerezYukari 0.4s ease-out;
        }
        @keyframes adaCerezYukari { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        #ada-cerez-kutusu h4 { margin: 0 0 8px 0; font-size: 16px; color: #222; display: flex; align-items: center; gap: 6px; }
        #ada-cerez-kutusu p { margin: 0 0 15px 0; font-size: 13px; line-height: 1.5; color: #555; }
        #ada-cerez-kutusu a.cerez-link { color: #d32f2f; text-decoration: underline; font-weight: 600; }
        .ada-cerez-butonlar { display: flex; gap: 10px; }
        .ada-cerez-btn { flex: 1; padding: 10px; border-radius: 6px; font-size: 13px; font-weight: bold; cursor: pointer; text-align: center; border: none; transition: opacity 0.2s; }
        .ada-cerez-btn:hover { opacity: 0.9; }
        .ada-cerez-kabul { background: #d32f2f; color: #fff; }
        .ada-cerez-red { background: #f1f3f5; color: #495057; }
        @media (max-width: 576px) { #ada-cerez-kutusu { bottom: 10px; right: 10px; left: 10px; max-width: none; } }
    </style>

    <div id="ada-cerez-kutusu">
        <h4>🍪 Çerez (Cookie) Tercihi</h4>
        <p>
            Size daha iyi bir haber deneyimi sunmak, site trafiğini analiz etmek ve içerikleri kişiselleştirmek için çerezleri kullanıyoruz. Detaylar için <a href="https://adagazetesi.com.tr/cookie-policy" class="cerez-link">Gizlilik ve Çerez Politikamızı</a> inceleyebilirsiniz.
        </p>
        <div class="ada-cerez-butonlar">
            <button class="ada-cerez-btn ada-cerez-kabul" onclick="adaCerezKaydet('kabul')">Kabul Et</button>
            <button class="ada-cerez-btn ada-cerez-red" onclick="adaCerezKaydet('zorunlu')">Sadece Zorunlular</button>
        </div>
    </div>

    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        (function() {
            try {
                var KayitliOnay = localStorage.getItem('ada_cerez_onay');
                if (!KayitliOnay) {
                    document.getElementById('ada-cerez-kutusu').style.display = 'block';
                } else if (KayitliOnay === 'kabul') {
                    gtag('consent', 'update', {'ad_storage': 'granted', 'ad_user_data': 'granted', 'ad_personalization': 'granted', 'analytics_storage': 'granted'});
                    dataLayer.push({'event': 'cerez_kabul_edildi'});
                }
            } catch(e) {}
        })();
        function adaCerezKaydet(secim) {
            try {
                localStorage.setItem('ada_cerez_onay', secim);
                if (secim === 'kabul') {
                    gtag('consent', 'update', {'ad_storage': 'granted', 'ad_user_data': 'granted', 'ad_personalization': 'granted', 'analytics_storage': 'granted'});
                    dataLayer.push({'event': 'cerez_kabul_edildi'});
                } else {
                    gtag('consent', 'update', {'ad_storage': 'denied', 'ad_user_data': 'denied', 'ad_personalization': 'denied', 'analytics_storage': 'denied'});
                }
            } catch(e) {}
            document.getElementById('ada-cerez-kutusu').style.display = 'none';
        }
    </script>
