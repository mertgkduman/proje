                        </div>
                    </div>

                    <div class="spmt-dates-block">
                        <div class="single-post-date-item">
                            <span><strong>Yayın Tarihi:</strong> 16.08.2021 22:55</span>
                                                            <span><strong>Son Güncelleme:</strong> 17.08.2021 13:40</span>
                                                    </div>
                    </div>

                    <div class="spmt-buttons-block">
                        <button class="single-post-share-btn" type="button"
                            data-post-url="https://serbestiyet.com/serbestiyet-in-english/her-sey-dahil-yassiada-67939/"
