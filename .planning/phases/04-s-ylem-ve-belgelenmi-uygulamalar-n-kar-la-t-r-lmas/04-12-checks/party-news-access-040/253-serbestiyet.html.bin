                        </div>
                    </div>

                    <div class="spmt-bottom">
                                                    <ul class="spmt-categories">
                                                                    <li>
                                        <a href="https://serbestiyet.com/category/serbestiyet-in-english/" class="spmt-category-link">
                                            ÖZEL HABER                                        </a>
                                    </li>
                                                                    <li>
                                        <a href="https://serbestiyet.com/category/haberler/" class="spmt-category-link">
                                            Haberler                                        </a>
                                    </li>
                                                                    <li>
                                        <a href="https://serbestiyet.com/category/featured/" class="spmt-category-link">
                                            Manşet                                        </a>
                                    </li>
