    {
      "kind": "passage",
      "values": {
        "id": "0412-policy-demokrat-plenary-motion",
        "version_id": "0412-policy-demokrat-plenary-v1",
        "exact": "(2/1525) esas numaralı Kanun Teklifi’nin İç Tüzük’ün 37’nci maddesi gereğince doğrudan Genel Kurul gündemine alınmasını talep ediyorum. Gereğinin yapılmasını saygılarımla arz ederim.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "2/1525 için İçtüzük 37 doğrudan gündeme alma önergesi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0412-policy-demokrat-plenary-statement",
        "version_id": "0412-policy-demokrat-plenary-v1",
        "exact": "Demokrat Partili 3 milletvekili Haydar Altıntaş, Cemal Enginyurt ve benim imzamla verdiğimiz Petrol Piyasası Kanunu’nda değişiklik teklifimizle ilgili söz aldım.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Salih Uzun’un Demokrat Parti milletvekilleri adına teklifin içeriğini anlatması",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0412-policy-demokrat-plenary-vote",
        "version_id": "0412-policy-demokrat-plenary-v1",
        "exact": "Şimdi İç Tüzük’ün 37’nci maddesi gereği doğrudan gündeme alma önergesini oylarınıza sunuyorum: Kabul edenler… Kabul etmeyenler… Önerge kabul edilmemiştir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "İçtüzük 37 uyarınca önergenin oylanması",
        "pdf_page_index": null,
        "printed_page": null
      }
    }
