    {
      "kind": "passage",
      "values": {
        "id": "0412-followup-ankaramasasi-boards-elections",
        "version_id": "0412-followup-ankaramasasi-boards-v1",
        "exact": "Demokrat Parti'nin \"Söz yeniden milletin\" sloganıyla düzenlediği 15. Olağan Kongresi, Ankara’da gerçekleştirildi. Gültekin Uysal, 1.208 delegeden 765’inin oyunu alarak yeniden genel başkanlığa seçildi. Kongrenin ardından Genel İdare Kurulu (GİK), Merkez Karar Kurulu (MKK) ve Yüksek Haysiyet Divanı için seçimler yapıldı.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Genel başkan seçimi ardından bildirilen kurul seçimleri",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0412-followup-ankaramasasi-boards-gik",
        "version_id": "0412-followup-ankaramasasi-boards-v1",
        "exact": "Kongre sonrası açıklanan 50 kişilik Genel İdare Kurulu (GİK) üyelerinde, 26 kişi mevcut yerini korurken, 24 kişilik bir değişiklik yaşandı. Daha önce GİK’te görev alan İlay Aksoy ve Cemal Enginyurt'un ise yeni listede yer almadığı görüldü.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Bildirilen GİK listesi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0412-followup-ankaramasasi-boards-mkk",
        "version_id": "0412-followup-ankaramasasi-boards-v1",
        "exact": "70 kişilik Merkez Karar Kurulu (MKK) listesinde ise 53 yeni isim göreve getirildi. Bu değişiklik, partinin yönetim kademelerinde yenilenme ve dinamizm arayışı olarak yorumlandı.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Bildirilen MKK listesi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0412-followup-ankaramasasi-boards-yhd",
        "version_id": "0412-followup-ankaramasasi-boards-v1",
        "exact": "21 kişilik Yüksek Haysiyet Divanı'nda da 11 isim yerini korurken, 10 isimde değişikliğe gidildi",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Bildirilen Yüksek Haysiyet Divanı listesi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
