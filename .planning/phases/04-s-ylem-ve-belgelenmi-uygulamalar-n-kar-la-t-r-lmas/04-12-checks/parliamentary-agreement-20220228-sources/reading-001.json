  "read_sections": [
    {
      "pages_zero_based": [
        2,
        5,
        6
      ],
      "reading": "Dizgi sayfası ve içindekiler. Hukuk devleti, yasama, yürütme, yargı ve siyasal etik başlıkları asıl bölümlerle eşleniyor."
    },
    {
      "pages_zero_based": [
        8,
        10,
        11,
        12,
        13,
        14,
        15,
        16,
        18
      ],
      "reading": "Önsöz ve giriş mevcut sisteme eleştiri, anayasal tarih anlatısı, denge ve denetim, özgürlük ve liyakat hedefi. Geçmişe dair değerlendirmeler ortak metne atıflı."
    },
    {
      "pages_zero_based": [
        19,
        20,
        21,
        22
      ],
      "reading": "Beş yıllık Meclis seçimi, yüzde 3 ülke barajı, nispi temsil ve yurt dışı seçim çevresi. Hazine yardımında yüzde 1 eşik ve dörtte bir eşit pay. Açık bağış ve harcama beyanı, torba kanun, sözlü soru, muhalefet gündemi, bütçe hakkı ve ana muhalefet başkanlığındaki Kesin Hesap Komisyonu."
    },
    {
      "pages_zero_based": [
        23,
        24,
        25,
        26,
        27,
        28
      ],
      "reading": "Cumhurbaşkanı için yedi yıl ve tek dönem, parti bağının kesilmesi. Hükümetin Meclise karşı sorumluluğu ve yapıcı güvensizlik. OHAL’de Meclis onayı. Ayrı hâkimler ve savcılar kurulları, AYM, YSK ve Sayıştayın önerilen yapıları."
    }
  ],
  "raw_text_chars": 42525,
  "limits": [
    "PDF kapağına ve program metnine dayalı okuma. Bu nüshada imza sayfası yer almıyor.",
    "Ortak bir mutabakat metni. Tek başına Anayasa değişikliği, teklif kaydı veya yürürlük belgesi değildir."
  ],
