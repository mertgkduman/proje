    {
      "kind": "passage",
      "values": {
        "id": "0406-sivas-2880-floor-call",
        "version_id": "0406-iklim-final-floor-v1",
        "exact": "2 Temmuz 2025 tarihinde Kars Milletvekili Grup Başkan Vekili Gülüstan Kılıç Koçyiğit ve Muş Milletvekili Grup Başkan Vekili Sezai Temelli tarafından, Sivas katliamının tüm boyutlarıyla araştırılması amacıyla Türkiye Büyük Millet Meclisine verilmiş olan -12618 grup numaralı- Meclis araştırması önergesinin",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "DEM Sivas önergesini veren grup başkanvekilleri",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0406-sivas-2880-floor-role",
        "version_id": "0406-iklim-final-floor-v1",
        "exact": "DEM PARTİ GRUBU ADINA ONUR DÜŞÜNMEZ (Hakkâri)",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "DEM grubu adına konuşmacı",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0406-sivas-2880-floor-speech",
        "version_id": "0406-iklim-final-floor-v1",
        "exact": "Bu Meclis bir ülkenin kendi karanlığıyla yüzleşmesine öncülük edebilir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "DEM grubu adına araştırmanın gerekçesi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0406-sivas-2880-floor-no-quorum",
        "version_id": "0406-iklim-final-floor-v1",
        "exact": "Karar yeter sayısı yoktur.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "İlk oylamada karar yeter sayısı yokluğu",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0406-sivas-2880-floor-retry",
        "version_id": "0406-iklim-final-floor-v1",
        "exact": "BAŞKAN - Önerge kabul edilmemiştir, karar yeter sayısı vardır.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "İkinci oylamanın sonucu",
