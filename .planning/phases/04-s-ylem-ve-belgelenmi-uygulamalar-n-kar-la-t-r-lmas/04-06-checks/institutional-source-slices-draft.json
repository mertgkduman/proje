    {
      "kind": "passage",
      "values": {
        "id": "0406-tbmm-101831-submission-p",
        "version_id": "0406-tbmm-101831-v1",
        "exact": "1.- DEM PARTİ Grubu adına Grup Başkanvekili Kars Milletvekili Gülüstan Kılıç Koçyiğit’in,\nkadın cinayetleri başta olmak üzere kadına yönelik her türlü şiddetin önlenmesi ve toplumsal cinsiyet\neşitliği politikalarının uygulanabilmesi amacıyla bir Meclis araştırması açılmasına ilişkin önergesi\n(10/1831) (Başkanlığa geliş tarihi: 10.10.2024)",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Önerge sunuşu",
        "pdf_page_index": 16,
        "printed_page": null
      }
    },
    {
