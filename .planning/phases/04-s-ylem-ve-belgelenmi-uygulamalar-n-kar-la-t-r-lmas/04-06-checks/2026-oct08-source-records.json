    {
      "kind": "passage",
      "values": {
        "id": "0406-oct08-floor-agenda",
        "version_id": "0406-oct08-floor-v1",
        "exact": "Adana Milletvekili Sadullah Kısacık ve 19 milletvekili tarafından, aracı kurumlar ve portföy yönetim şirketleri nezdinde patlak veren finansal soygunun arka planındaki organize suç ve dolandırıcılık ağlarının, sığ paylardaki manipülatif çete faaliyetlerinin, kriz öncesi soygunu haber alarak fonları boşaltan odakların, aracı kurum ve portföy yönetim şirketlerinin organize sorumluluklarının, denetim yetkisini zamanında kullanmayarak suça göz yuman kurumların ve şaibeli tasfiye süreçlerinin bütün yönleriyle araştırılması; faillerin, azmettirenlerin, siyasi ve idari uzantılarının tespit edilmesi amacıyla 6/10/2026 tarihinde Türkiye Büyük Millet Meclisi Başkanlığına verilmiş olan Meclis araştırması önergemizin diğer önergelerin önüne alınarak görüşmelerin 8/10/2026 Perşembe günkü birleşimde yapılması önerilmiştir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Yeni Yol’un 6 Ekim başvurusu için 8 Ekim ön görüşme önerisi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0406-oct08-floor-decision",
        "version_id": "0406-oct08-floor-v1",
        "exact": "Öneriyi oylarınıza sunuyorum: Kabul edenler... Kabul etmeyenler... Kabul edilmemiştir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Yeni Yol’un ön görüşme önerisine ilişkin başkanın ilk oturum oylaması",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
