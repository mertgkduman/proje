    {
      "kind": "passage",
      "values": {
        "id": "0411-fund-arikan-authority",
        "version_id": "0411-fund-arikan-v1",
        "exact": "Saadet Partisi Genel Başkanı Mahmut Arıkan,",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "TBMM haber girişinde Arıkan’ın Saadet sıfatı",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-fund-arikan-date",
        "version_id": "0411-fund-arikan-v1",
        "exact": "2026-10-21 - 13:01",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "TBMM haber yayım tarihi ve saati",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-fund-arikan-group",
        "version_id": "0411-fund-arikan-v1",
        "exact": "Arıkan, Yeni Yol Partisinin TBMM Grup Toplantısı'nda",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Toplantının Yeni Yol grubu olduğu haber gövdesinde",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-fund-arikan-bill",
        "version_id": "0411-fund-arikan-v1",
        "exact": "Tasfiyesine Karar Verilen Bazı Yatırım Fonları Hakkında Kanun Teklifi'nin görüşmelerine değinen Arıkan",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Eleştirilen fon teklifinin haber gövdesindeki adı",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-fund-arikan-quote",
        "version_id": "0411-fund-arikan-v1",
        "exact": "bataklığı kurutmak yerine sivrisinek avlamaya çalışıldığını",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Arıkan’ın doğrudan aktarılmış kısa ifadesi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-fund-arikan-critique",
        "version_id": "0411-fund-arikan-v1",
        "exact": "Teklifin, mağdurun parasına güvence vermediğini ifade eden Arıkan, fonların tasfiyesi, değerlemesi, satışı ve yatırımcılara yapılacak ödemeler konusunda SPK'ye geniş yetkiler verilmesini eleştirdi.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "TBMM haberinin güvence ve SPK yetkisi aktarımı",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-fund-law-text-power",
        "version_id": "0411-fund-law-text-v1",
        "exact": "tespitini ve nakde çevrilmesini, değerleme esaslarını, fon pay sahipliğinin\r\nbelirlenme şeklini, ara ve nihai ödemeyi, dağıtım sırasını ve tasfiyeye ilişkin\r\ndiğer usul ve esasları belirlemeye yetkilidir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Madde 3 fıkra 1, SPK’nın belirleme yetkisi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-fund-law-text-sale",
        "version_id": "0411-fund-law-text-v1",
        "exact": "talebi üzerine ilgili varlıkların Borsa dışında satışına onay verebilir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Madde 3 fıkra 2, Borsa dışında satış onayı",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-fund-law-text-interim",
        "version_id": "0411-fund-law-text-v1",
        "exact": "1.000.000 Türk lirası ara ödeme yapılabilir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Madde 4 fıkra 2, 1.000.000 TL ara ödeme üst sınırı",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-fund-law-text-cash",
        "version_id": "0411-fund-law-text-v1",
        "exact": "hâlinde Kurul; mevcut nakitten mümkün olan en fazla sayıda fon pay sahibinin",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Madde 4 fıkra 3, dağıtılabilir nakdin yetmemesi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-fund-law-text-distribution",
        "version_id": "0411-fund-law-text-v1",
        "exact": "Ödemeler YTM tarafından katılma payı sahipliği oranında yapılır.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Madde 6 fıkra 6, geri kazanımın dağıtım oranı",
        "pdf_page_index": null,
        "printed_page": null
      }
    }
  ]
}
