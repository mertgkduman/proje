    {
      "kind": "passage",
      "values": {
        "id": "0411-policy-saadet-plenary-schedule",
        "version_id": "0411-policy-saadet-plenary-v1",
        "exact": "İsrail'e karşı getirilen ihracat kısıtlamasının etkinliğinin ve\nbugüne kadar yapılan ticaretin Filistin (Gazze) halkına yönelik olumsuz etkilerinin araştırılması amacıyla",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Saadet Grubunun aynı birleşimde ön görüşme talebi",
        "pdf_page_index": 14,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-policy-saadet-plenary-speaker",
        "version_id": "0411-policy-saadet-plenary-v1",
        "exact": "Gelecek-Saadet\nGrubunun grup önerisi üzerinde söz almış bulunuyorum.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Saadet Grubu adına görüşmede Selçuk Özdağ’ın sıfatı",
        "pdf_page_index": 14,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-policy-saadet-plenary-vote",
        "version_id": "0411-policy-saadet-plenary-v1",
        "exact": "Saadet Partisi Grubunun önerisini oylarınıza sunuyorum: Kabul edenler... Kabul etmeyenler...\nÖneri kabul edilmemiştir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Saadet grup önerisinin oylanması ve sonraki gündeme geçişi",
        "pdf_page_index": 20,
        "printed_page": null
      }
