        "version_id": "0411-inquiry-pension-2024-session-v1",
        "exact": "SAADET PARTİSİ GRUBU ADINA MAHMUT ARIKAN (Kayseri)",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Saadet Partisi Grubu adına konuşmacı",
        "pdf_page_index": null,
        "printed_page": null
