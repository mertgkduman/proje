    {
      "kind": "passage",
      "values": {
        "id": "0411-retired-2023-speech-quote",
        "version_id": "0411-retired-2023-speech-v1",
        "exact": "Tekrar ifade ediyorum, emeklilerimizin maaşlarında kalıcı bir iyileştirme bekliyoruz, bu iyileştirme tek seferlik sadakayla olmaz.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Kalıcı aylık iyileştirmesi beklentisi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-retired-2023-speech-exclusion",
        "version_id": "0411-retired-2023-speech-v1",
        "exact": "çalışmayan emeklilere verecekmişsiniz.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Çalışmayanlarla sınırlı ödeme eleştirisi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-retired-2023-speech-speaker",
        "version_id": "0411-retired-2023-speech-v1",
        "exact": "ŞERAFETTİN KILIÇ (Antalya) – Sayın Başkan, değerli milletvekilleri; hepinizi saygıyla selamlıyorum.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Konuşmacı ve bağlamı",
        "pdf_page_index": null,
        "printed_page": null
      }
