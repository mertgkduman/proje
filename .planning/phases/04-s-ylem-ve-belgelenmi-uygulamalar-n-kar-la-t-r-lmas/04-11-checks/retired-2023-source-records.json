    {
      "kind": "passage",
      "values": {
        "id": "0411-retired-2023-law7464-amount",
        "version_id": "0411-retired-2023-law7464-v1",
        "exact": "2023 yılı Ekim ödeme döneminde\r\ngelir veya aylık ödemesi yapılanlara dosya bazında 5.000 TL tutarında bir\r\ndefaya mahsus olmak üzere ödeme yapılır.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "İlk düzenlemede tek seferlik tutar",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-retired-2023-law7464-excluded",
        "version_id": "0411-retired-2023-law7464-v1",
        "exact": "almakta iken 2023 yılı Ekim ayı içinde bu Kanun veya 506 sayılı Kanunun geçici\r\n20 nci maddesi kapsamında sigortalı olarak çalışanlar",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Çalışma nedeniyle kapsam dışı bırakma",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0411-retired-2023-law7464-exception",
        "version_id": "0411-retired-2023-law7464-v1",
        "exact": "Ancak, ölüm geliri\r\nve aylığı almakta olanlar hakkında bu fıkra hükümleri uygulanmaz.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Ölüm aylığı ve geliri istisnası",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
