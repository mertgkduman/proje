    {
      "kind": "passage",
      "values": {
        "id": "0408-policy-yeni-yol-esens-press-quota",
        "version_id": "0408-policy-yeni-yol-esens-press-v1",
        "exact": "Yeni Yol Partisi İstanbul Milletvekili Elif Esen, \"Özel sektör ve kamudaki engelli istihdam kotasının yüzde 6'ya çıkarılması ve bu kotanın en az 3'te birinin kadın engelli çalışanlardan oluşması gerekir.\" dedi.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "İstihdam kotası ve kadın engelli çalışan alt kotası",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0408-policy-yeni-yol-esens-press-announce",
        "version_id": "0408-policy-yeni-yol-esens-press-v1",
        "exact": "Esen, 3 Aralık Dünya Engelliler Günü dolayısıyla Meclis'te düzenlediği basın toplantısında, engelli vatandaşların sorunlarını anlattı.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Mecliste basın açıklaması ve 3 Aralık",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
