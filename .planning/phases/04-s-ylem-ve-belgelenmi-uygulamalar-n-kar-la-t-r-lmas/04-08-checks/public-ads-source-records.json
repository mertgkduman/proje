        "manifest_sha256": "e47b41d3416899a59bb228ca678c8eecdbd415bcbac65efc716c5ecfbd955e57",
        "version_id": "0408-public-ads-plenary-v1"
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0408-public-ads-plenary-schedule",
        "version_id": "0408-public-ads-plenary-v1",
        "exact": "Muğla Milletvekili ve Grup Başkan Vekili Selçuk Özdağ ve 20 milletvekili tarafından, kamu kurumlarının, kamuya bağlı, ilgili ve ilişkili kuruluşların basın ve dijital medya kuruluşlarına verdiği reklam ve ilanların kamu kaynaklarının eşitlik ve hakkaniyet ölçülerine göre verilip verilmediğinin tespiti ve varsa hukuka aykırılıkların belirlenerek giderilmesine yönelik tedbirlerin alınması amacıyla 3/12/2025 tarihinde Türkiye Büyük Millet Meclisi Başkanlığına verilmiş olan Meclis araştırması önergemizin diğer önergelerin önüne alınarak görüşmelerinin 3/12/2025 Çarşamba günkü birleşimde yapılması önerilmiştir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Yeni Yol grubunun aynı gün ön görüşme talebi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0408-public-ads-plenary-group",
        "version_id": "0408-public-ads-plenary-v1",
        "exact": "YENİ YOL GRUBU ADINA SELÇUK ÖZDAĞ (Muğla) - Sayın Başkan, değerli milletvekilleri; grup önerimiz üzerine söz almış bulunuyorum. Hepinizi saygıyla selamlıyorum.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Selçuk Özdağ’ın grup adına söz alması",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0408-public-ads-plenary-vote",
        "version_id": "0408-public-ads-plenary-v1",
        "exact": "BAŞKAN - Öneriyi oylarınıza sunuyorum: Kabul edenler... Kabul etmeyenler... Önerge kabul edilmemiştir.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "24. Birleşim 2. Oturum Yeni Yol grup önerisinin sonucu",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0408-public-ads-plenary-ekmen",
        "version_id": "0408-public-ads-plenary-v1",
        "exact": "MEHMET EMİN EKMEN (Mersin) - Reklamlardan bahsediyoruz, Basın İlan Kurumundan değil.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Yeni Yol milletvekilinin görüşmede kapsamı belirtmesi",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0408-public-ads-plenary-cupolo",
        "version_id": "0408-public-ads-plenary-v1",
        "exact": "Biz, bu önergeye \"Evet.\" diyeceğiz ama bunun da ötesine geçip RTÜK gibi baskıcı kurumların kapatılmasını, Basın İlan Kurumunun tümüyle sivil toplum, bağımsız sivil toplum örgütlerinin denetimine açılmasını ve Türkiye'deki medya ikliminin tekrar tartışmaya açılmasını öneriyoruz ve konuşmayı da bitirirken ilansız bir şekilde yaşamını sürdürmeye devam eden bütün özgür basını, Yeni Yaşam'ı, Mezopotamya Ajansı'nı, JINNEWS'i, İlke TV'yi, Evrensel'i saygıyla selamlıyorum.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "DEM grubu adına açıklanan destek tutumu",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
