  "records": [
    {
      "id": "2018-22-april-eligibility",
      "date": "2018-04-22",
      "source_ids": [
        "ysk-264"
      ],
      "pdf_page_indices": [
        1,
        2
      ],
      "note": "YSK 264’te on parti sayıyor. Demokrat Parti ve Saadet Parti listede, Emek Partisi listede yok. Karar, genel kongre veya teşkilatlanma şartına ilişkin toplu gerekçe veriyor. EMEP’e özel sicil dosyası ve olası itiraz sonucu açık."
    },
    {
      "id": "2018-25-april-hudapar-objection",
      "date": "2018-04-25",
      "source_ids": [
        "ysk-287"
      ],
      "pdf_page_indices": [
        2,
        3
      ],
      "note": "Hür Dava Partisi’nin itirazı üzerine 287 sayılı kararla ayrı yeterlilik tespiti yapıldı. Bu karar EMEP hakkında bireysel inceleme değil. İlk duyurudaki liste ile kesin oy pusulası aşaması ayrı."
    },
    {
      "id": "2018-election-emep-public-position",
      "publication_dates": [
        "2018-05-04",
        "2018-05-07",
        "2018-06-23"
      ],
      "source_ids": [
        "evrensel-may4",
        "emep-may7",
        "emep-june23"
      ],
      "note": "4 Mayıs Evrensel haberinde Selma Gürkan’ın Demirtaş ve tarihsel HDP için destek açıklaması var. 7 Mayıs parti sitesi yeniden yayımı aynı tercihleri seçim türüne göre ayırıyor ve parti görüşmelerini açıklıyor. 23 Haziran yayınında Genel Başkan Yardımcısı Şükran Doğan’ın sandık güvenliği çağrısı ve çalışmaya ilişkin parti beyanı var. Destek, EMEP’in kendi adıyla pusulada yer alması veya resmî seçim ittifakı üyeliği anlamına gelmiyor."
    },
