  "chains": [
    {
      "date": "2018-10-09",
      "sources": [
        "disk-visit",
        "emep-visit"
      ],
      "note": "DİSK ve EMEP, DİSK’in Selma Gürkan, Levent Tüzel ve Güven Gerçek’ten oluşan heyeti ağırladığını ve ekonomik kriz üzerine görüş alışverişi yapıldığını ayrı kurum yayınlarıyla doğruluyor. Bir ortak karar veya uygulanmış ekonomik önlem belgelenmedi."
    },
    {
      "date": "2018-10-19",
      "sources": [
        "evrensel-detention",
        "evrensel-statement"
      ],
      "note": "Volkan Pekal Adana OSB’de bildiriyi dağıtan beş EMEP üye veya yöneticisinin ifadeleri alındıktan sonra salıverildiğini bildiriyor. 20 Ekim’deki Artı Gerçek metni Pekal’a dayanıyor, bağımsız ikinci tanıklık olarak sayılmadı."
    },
    {
      "date": "2018-10-21",
      "sources": [
        "evrensel-statement",
        "spk-2018-law"
      ],
      "note": "21 Ekim haberinde 6362/107(2) atfı var. 19 Ekim haberindeki 6352 numarası, Resmî Gazete değişikliği ve dönemin SPK açıklamasındaki 6362 ile uyuşmuyor. Hükmün o dönemde aradığı menfaat unsuru kanun ve SPK açıklamasında belirtiliyor. 27 Mart 2015 tarihli 6637 madde 11 değişikliği TBMM belgesinde kontrol edildi. İlk soruşturma evrakı erişilmedi.",
      "official_amendment_url": "https://www5.tbmm.gov.tr/tutanaklar/KANUNLAR_KARARLAR/kanuntbmmc099/kanuntbmmc099/kanuntbmmc09906637.pdf"
    },
    {
      "date": "2018-12-05",
      "date_kind": "publication",
      "sources": [
        "evrensel-nonprosecution"
      ],
      "note": "Pekal takipsizlik verildiğini ve el konulan bildirilerin dosyada saklandığını aktarıyor. EMEP il başkanı polis ve savcılık hakkında şikâyet ettiklerini, bildirilerin iadesine itiraz edeceklerini söylüyor. İmzalı takipsizlik, karar günü, dosya numarası ve bu ayrı şikâyetin sonucu açık."
    }
  ]
}
