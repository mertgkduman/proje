  "chains": [
    {
      "id": "selma-gurkan-afrin-ifade",
      "chronology": [
        {
          "date": "2018-02-27",
          "sources": [
            "evrensel-first"
          ],
          "note": "EMEP’in aktardığı adliye önü konuşması. Bildiri nedeniyle yargılanan parti üyelerinin işlemi ayrı."
        },
        {
          "date": "2018-10-09",
          "sources": [
            "emep-hearing"
          ],
          "note": "EMEP İstanbul 26. Ağır Ceza Mahkemesindeki ilk duruşmayı ve Gürkan’ın genel başkan sıfatıyla savunmasını aktarıyor. 22 Ocak’a erteleme kaydında sonraki duruşmanın gerçekleşmesi açık."
        },
        {
          "date": "2019-04-24",
          "sources": [
            "evrensel-first"
          ],
          "note": "Haber hükümde bir yılın 10 aya indirildiğini ve 6.000 TL adli para cezasına çevrildiğini bildiriyor."
        },
        {
          "date": "2020-07-02",
          "sources": [
            "evrensel-appeal"
          ],
          "note": "Evrensel İstanbul Bölge Adliye Mahkemesi’nin dilekçeyi esastan reddettiğini bildiriyor. Heyet, karar günü ve karar numarası açık.",
          "date_kind": "publication"
        },
        {
          "date": "2024-06-06",
          "sources": [
            "birgun-cassation"
          ],
          "note": "BirGün, Evrensel aktarımıyla Yargıtay 3. Ceza Dairesindeki bozmayı bildiriyor. Karar günü, numarası ve imzalı gerekçe açık.",
          "date_kind": "publication"
        },
        {
          "date": "2024-11-06",
          "sources": [
            "tihv-acquittal",
            "evrensel-acquittal"
          ],
          "note": "TİHV 7 Kasım raporunda 6 Kasım duruşmasındaki beraati bildiriyor. Evrensel aynı beraati 6 Kasım’da aktarıyor. İmzalı hüküm ve kesinleşme kaydı açık."
        }
      ],
      "party_role": "Gürkan’ın o tarihteki parti sıfatı ile kendisi hakkında yürütülen yargılama ayrı aktörlerle kaydedilecek."
    },
    {
      "id": "roboski-basvuru-yollari",
      "chronology": [
        {
          "date": "2011-12-28",
          "sources": [
            "hudoc-fr"
          ],
          "note": "AİHM dosyasında 34 ölüm yer alıyor. Parti metnindeki yaş alt grubunun sayımı açık.",
          "pdf_page_indices": [
            0,
            1
          ]
        },
        {
          "date": "2016-02-24",
          "sources": [
            "rg-aym-2016"
          ],
          "note": "Görsel hükümde AYM 2014/11864’ü evrakın geçerli mazeret olmaksızın süresinde tamamlanmaması nedeniyle oyçokluğuyla reddetti. Osman Alifeyyaz Paksüt karşıoyda.",
          "pdf_page_indices": [
            0,
            8,
            9
          ]
        },
        {
          "date": "2016-03-23",
          "sources": [
            "rg-2016-index"
          ],
          "note": "29662 sayılı Resmî Gazete’deki yayım.",
          "date_kind": "publication"
        },
        {
          "date": "2018-04-10",
          "sources": [
            "hudoc-fr"
          ],
          "note": "49976/16 ve 275 diğer başvuru birleştirildi. AİHM madde 35 §1 uyarınca iç hukuk yollarının kuralına uygun tüketilmemesi gerekçesiyle oybirliğiyle kabul edilemez buldu.",
          "pdf_page_indices": [
            0,
            9,
            10,
            11
          ]
        },
        {
          "date": "2018-05-17",
          "sources": [
            "hudoc-fr"
          ],
          "note": "Fransızca kararın yazılı bildirim günü.",
          "date_kind": "written_communication",
          "pdf_page_indices": [
            12
          ]
        },
        {
          "date": "2025-06-12",
          "sources": [
            "aym-2025-copy"
          ],
          "note": "2021/15347 ve birleşen 2021/19066, yeniden soruşturma isteğine ilişkin. Erişilen nüsha yaşam hakkı iddiası için mükerrer başvuru gerekçesiyle ret, adil yargılanma için konu bakımından yetkisizlik bildiriyor. Mahkemenin özgün tam metni yerel alımda erişilemedi.",
          "source_status": "official_index_and_unofficial_full_text",
          "official_index": "https://eski--kararlarbilgibankasi.anayasa.gov.tr/BB/2021/15347"
        }
      ],
      "party_role": "EMEP bölge metni anma ve sorumluların belirlenmesi çağrısıdır. Başvurucular ve yargı işlemleri kendi belgelerinde izlenir.",
      "other_hudoc_case": "56543/16 ayrı milletvekilliği ve dokunulmazlık dosyasıdır."
    }
  ]
