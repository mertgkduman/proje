  "records": [
    {
      "id": "superpak-strike-start",
      "date": "2018-06-20",
      "source_ids": [
        "seluloz-start"
      ],
      "note": "Selüloz-İş, toplu iş sözleşmesi görüşmelerinde anlaşma çıkmayınca grevin İzmir/Torbalı, Karaman ve Gaziantep fabrikalarında 20 Haziran saat 08.00’de başladığını ve yaklaşık 250 işçiyi kapsadığını bildiriyor."
    },
    {
      "id": "emep-superpak-gaziantep-visit",
      "publication_date": "2018-07-13",
      "source_ids": [
        "evrensel-visit"
      ],
      "api_post_id": 2915,
      "note": "Evrensel haberi ve parti arşivindeki aynı haberin yeniden yayımı, EMEP Genel Başkan Yardımcısı Mehmet Türkmen ile üyelerin Gaziantep’te dayanışma ziyaretini aktarıyor. 13 Temmuz yayın günü. Ziyaretin kesin günü ve varsa ayrı yerel örgüt tutanağı açık. Parti rolü açıklama ve ziyarettir."
    },
    {
      "id": "industriall-letter-to-mayr-melnhof",
      "date": "2018-07-30",
      "source_ids": [
        "industriall-letter"
      ],
      "pdf_page_index": 0,
      "note": "IndustriALL Genel Sekreteri Cenevre’den Mayr-Melnhof Packaging yönetimine yazdı ve Selüloz-İş’le pazarlık için Türkiye’deki şirket yönetimi nezdinde girişim istedi. Sendika mektubu ayrı müdahale. İşverenin yanıtı ve mektubun etkisi açık."
    },
    {
      "id": "superpak-agreement",
      "date": "2018-12-22",
      "union_report_date": "2018-12-24",
      "announced_return_date": "2019-01-02",
      "source_ids": [
        "seluloz-terms",
        "liman-outcome"
      ],
      "note": "Selüloz-İş, 22 Aralık’ta İzmir’de işverenle anlaşma ve grevin sona erdiğini 24 Aralık’ta duyurdu. Üç yıllık sözleşme, enflasyona bağlı ücret artışı, sosyal yardımlar, vergi dilimleri ve 2 Ocak’a kadar ücretli izin sendika açıklamasında. Liman-İş yayını 2018 için 280 TL, 2019 ilk yarısı için 300 TL brüt artış ve sonraki dönem için enflasyon oranı bildiriyor. Asıl imzalı sözleşme ve ücret bordroları açık. 2 Ocak ilan edilen işbaşı günü. İşbaşı gerçekleşmesi ve EMEP’in anlaşmaya etkisi bu belgelerde belirlenmedi."
    }
  ],
