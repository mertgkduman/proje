  "findings": [
    {
      "date": "2014-05-13",
      "stage": "Eynez kazası",
      "sources": [
        "soma-tuzel-7-44353",
        "aym-soma-rg-index"
      ],
      "note": "Manisa Soma Eynez’de 301 işçi hayatını kaybetti. 486 sayısı 2018 EMEP açıklamasında ve tarihsel TBMM konuşmasında yaralı sayısı olarak geçiyor. AYM kararlarının olay anlatımında yaralananlar sayısal ayrıntı verilmeden anılıyor."
    },
    {
      "date": "2014-05-21",
      "stage": "Meclis araştırması ön görüşmesi",
      "sources": [
        "soma-tuzel-2014-05-21"
      ],
      "note": "91. birleşimde Abdullah Levent Tüzel tutanakta HDP Grubu adına konuşuyor. Grup sıfatı konuşmanın kendi dönem ve kurum kaydıdır. Başka bir parti adına kurumsal davranış sayılmadı."
    },
    {
      "date": "2014-05-21",
      "stage": "7/44353 yazılı soru",
      "sources": [
        "soma-44353-detail",
        "soma-44353-filing"
      ],
      "note": "TBMM’ye geliş ve soru metni 21 Mayıs. İstanbul Milletvekili Tüzel kazanın nedenlerini, iş güvenliği ile kurtarma süreçlerini soruyor. İlk günlere ilişkin iddialar soru metninin gerekçesidir."
    },
    {
      "date": "2014-05-22",
      "stage": "Gündem dışı konuşma",
      "sources": [
        "soma-tuzel-2014-05-22"
      ],
      "note": "92. birleşimde 13 Mayıs faciası ve madenlerde çalışma koşulları hakkında Tüzel’in gündem dışı konuşması. 21 Mayıs HDP grup konuşması ve 7/44353 ile ayrı işlemler."
    },
    {
      "date": "2014-07-01",
      "stage": "7/44353 Bakanlık cevabı",
      "sources": [
        "soma-44353-detail",
        "soma-tuzel-7-44353",
        "https://www5.tbmm.gov.tr/tutanaklar/TUTANAK/TBMM/d24/c081/tbmm24081110.pdf"
      ],
      "note": "Taner Yıldız imzalı üst yazı 1 Temmuz, 110. birleşim ss. 501–508. Bakanlık 301 ölümü ve TKİ ruhsatını doğruluyor, 23 Mayıs 2014 itibarıyla ILO 176 için görüş süreci başlatıldığını ve adli/idari soruşturmaların sürdüğünü bildiriyor. Cevap sahadaki tüm önlemlerin fiilen alındığına kanıt olarak kullanılmadı."
    },
    {
      "date": "2014-12-04",
      "stage": "ILO 176 için 6580 sayılı uygun bulma kanunu",
      "sources": [
        "tbmm-6580"
      ],
      "note": "TBMM kabulü 4 Aralık, 29203 sayılı Resmî Gazete yayımı 12 Aralık. Bakanın Temmuz cevabındaki hazırlık, TBMM kabulü ve ILO’ya tevdi ayrı."
    },
    {
      "date": "2015-01-07",
      "stage": "7/59481 yazılı soru",
      "sources": [
        "soma-59481-detail",
        "soma-59481-filing"
      ],
      "note": "Tüzel’in düşük kalorili kömür alımı ve Sayıştay tespitlerini sorduğu ayrı dosya. İmzalı metin 6 Ocak, TBMM’ye geliş 7 Ocak."
    },
    {
      "date": "2015-01-30",
      "stage": "Soma Araştırma Komisyonu raporunun dağıtımı",
      "sources": [
        "soma-680"
      ],
      "note": "TBMM 680 sıra sayısı ile dağıtımı 30 Ocak olarak kaydediyor. Sicil durumu raporun Genel Kurulda görüşülmediğini ve hükümsüz kaldığını belirtiyor. Raporun bütün bölümlerinin özgün nüshaları ve önerilerin uygulanması açık."
    },
    {
      "date": "2015-03-23",
      "stage": "7/59481 Bakanlık cevabı",
      "sources": [
        "soma-59481-detail",
        "soma-59481-reply",
        "https://www5.tbmm.gov.tr/tutanaklar/TUTANAK/TBMM/d24/c108/tbmm24108081.pdf"
      ],
      "note": "23 Mart Bakanlık cevabı 81. birleşimde yer alıyor. Bakanlık 3,8 milyon TL hakediş kesintisi olduğunu ve kamu zararı olmadığı görüşünü bildiriyor. TBMM tutanağında 7/59243 sahibi Hasan Ören de Sayıştay raporunun 70. sayfasından 1.549.311 ton yıkama ve 768.791 ton satılabilir kömür rakamlarını aktarıyor. Kurum raporunun aslı ve fiilî ödeme kaydı ayrı araştırılacak."
    },
    {
      "date": "2015-03-23",
      "stage": "ILO 176 onay belgesinin tevdii",
      "sources": [
        "ilo-176-deposit"
      ],
      "note": "ILO Türkiye’nin 176 sayılı sözleşme onay belgesini 23 Martta teslim aldığını 24 Martta açıkladı. Kurumun olay tarihli İngilizce yayımı bu günü tevdi olarak tanımlıyor. Saha uygulaması için ayrı denetim kaydı gerekiyor."
    },
    {
      "date": "2018-05-12",
      "stage": "EMEP dördüncü yıl açıklaması",
      "sources": [
        "party-api-gap-015-source-reading.json"
      ],
      "note": "Levent Tüzel EMEP genel başkan yardımcısı sıfatıyla anma ve iş güvenliği açıklaması yaptı. 2014 Meclis kayıtlarındaki dönemsel roller ayrıca korunuyor."
    },
    {
      "date": "2020-01-29",
      "stage": "Kamu görevlileri soruşturması hakkında AYM",
      "sources": [
        "aym-soma-rg-index",
        "https://www.anayasa.gov.tr/media/6521/2016-13649.pdf",
        "aym-soma-rg-2016-13649"
      ],
      "note": "2016/13649 ve birleşen 2016/14545. AYM yaşam hakkının usul boyutunun ihlalini saptadı. Yeniden yargılama için Danıştay 1. Daireye gönderdi. Resmî Gazete 9 Mart 2020, sayı 31063."
    },
    {
      "date": "2023-11-02",
      "stage": "Ana ceza yargılaması hakkında AYM",
      "sources": [
        "https://eski--kararlarbilgibankasi.anayasa.gov.tr/BB/2021/9961",
        "https://librumhukuk.com/karar/anayasa-mahkemesi/1494/aym-bireysel-basvuru-aysel-gezer-ve-derler-b-no-2021-9961/"
      ],
      "note": "Aysel Gezer ve Diğerleri, 2021/9961 ve birleşen 2022/53802. AYM çoğunluğu, kabul edilebilir başvurularda yaşam hakkının usul boyutu yönünden ihlal bulmadı. Karar, 11 Temmuz 2018 ilk derece ve 4 Nisan 2022 temyiz aşamalarına atıf yapıyor. Kamu görevlileri için 2020 izin dosyası ayrı. Asıl ilk derece ve kanun yolu hükümleri ile sonraki idari süreç makbuzları açık."
    }
  ],
  "open": [
    "Sayıştay’ın Ege Linyitleri 2013 denetim raporu, yüklenici sözleşmesi ve hakediş yazıları.",
    "AYM göndermesinden sonraki Danıştay ve kamu görevlileri ceza dosyaları.",
    "EMEP’in dönemsel program maddesi ve Tüzel’in 2014–2015 Meclis işlemlerinin kurumsal görev veya parti yetkisi kaydı."
  ],
