    {
      "kind": "passage",
      "values": {
        "id": "0409-policy-pirha-2023-place-first",
        "version_id": "0409-policy-pirha-2023-v1",
        "exact": "Demokratik Bölgeler Partisi (DBP) 6’ncı Olağanüstü Kongresini, Ankara Dünya Ticaret Merkezi’nde gerçekleştirdi. Kongre salonuna, “Kürt sonuna demokratik çözüm”, “3’ncü yolda demokratik Cumhuriyete”, “Jin Jiyan Azadi”, “Tecride hayır barış hemen şimdi” pankartları asıldı. Kongreye, çok sayıda kişi ve delegelerin yanı sıra Halkların Eşitlik ve Demokrasi Partisi (HEDEP) milletvekilleri, MYK üyeleri, Sivil Toplum Örgütleri (STÖ) ve Barış Anneleri katıldı.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Aynı haberin ilk kongre paragrafında Ankara",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0409-policy-pirha-2023-place-next",
        "version_id": "0409-policy-pirha-2023-v1",
        "exact": "Diyarbakır&#8217;da gerçekleşen kongrede, DBP’nin yeni eş genel başkanlığına önerilen Çiğdem Kılıçgün Uçar ve Keskin Bayındır’ın salona gelmesi alkışlarla karşılandı.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Sonraki paragrafta Diyarbakır anlatımı",
        "pdf_page_index": null,
        "printed_page": null
      }
    },
    {
      "kind": "passage",
      "values": {
        "id": "0409-policy-pirha-2023-result",
        "version_id": "0409-policy-pirha-2023-v1",
        "exact": "Ardından DBP’nin eş genel başkanlığına önerilen Çiğdem Kılıçgün Uçar ile Keskin Bayındır DBP’nin yeni eş genel başkanları olarak seçildi. Kongrede DBP’nin PM, MYK üyeleri ile yeni yönetimi de belirlendi.",
        "prefix": null,
        "suffix": null,
        "article": null,
        "section": "Uçar ve Bayındır’ın seçildiğinin bildirildiği paragraf",
        "pdf_page_index": null,
        "printed_page": null
      }
