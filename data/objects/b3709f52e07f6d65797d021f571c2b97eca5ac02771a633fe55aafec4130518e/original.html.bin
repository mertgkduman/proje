<script>
  // scroll reveal
  const observer = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); observer.unobserve(e.target); } });
  }, {threshold:.15});
  document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));

  // nav active-state scroll spy (only applies to in-page section anchors, e.g. on the homepage)
  const navLinks = document.querySelectorAll('nav.links a[href*="#"]');
  const navSections = Array.from(navLinks)
    .map(link => document.getElementById(link.href.split('#')[1]))
    .filter(Boolean);
  if (navSections.length) {
    const navObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        navLinks.forEach(link => {
          link.classList.toggle('active', link.href.split('#')[1] === entry.target.id);
        });
      });
    }, {rootMargin: '-40% 0px -50% 0px'});
    navSections.forEach(sec => navObserver.observe(sec));
  }

  // membership form
  const form = document.getElementById('uyeForm');
  if (form) {
    const msg = document.getElementById('formMsg');
    const submitBtn = form.querySelector('button[type="submit"]');
    form.addEventListener('submit', async function(e){
      e.preventDefault();
      submitBtn.disabled = true;
      msg.classList.remove('show', 'error');
      try {
        const res = await fetch('https://yenipartiyiz.biz/uye-basvuru', {
          method: 'POST',
          headers: { 'X-CSRF-TOKEN': 'KkaVeMmbjg40Rxa5qblggIufLWAl9Nc4vS4BdB54' },
          body: new FormData(form)
        });
        const data = await res.json();
        if (data.success) {
          msg.textContent = 'Teşekkürler! Başvurun alındı, ekibimiz en kısa sürede seninle iletişime geçecek.';
          msg.classList.add('show');
          form.reset();
        } else {
          msg.textContent = data.message || 'Bir şeyler ters gitti, lütfen tekrar dene.';
          msg.classList.add('show', 'error');
        }
      } catch (err) {
        msg.textContent = 'Bağlantı hatası, lütfen tekrar dene.';
        msg.classList.add('show', 'error');
      } finally {
        submitBtn.disabled = false;
      }
    });
  }
</script>

