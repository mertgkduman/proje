,\"fullRoute\":\"/tr/ekonomi/8-uluslararasi-finans-kurulusu-sivas-ve-taseli-ges-icin-destek-mektubu-imzaladi/4121289\",\"timeDifference\":\"\",\"isRecent\":false,\"newsType\":1},{\"enmNewsType\":0,\"liveBlogId\":null,\"liveBlogIsActive\":null,\"contentId\":4121242,\"redirect\":\"\",\"title\":\"İran Meclis Başkanı Kalibaf: ABD şu ana kadar İran’ın mesajına yanıt vermedi\",\"subTitle\":\"İran Meclis Başkanı Kalibaf: ABD şu ana kadar İran’ın mesajına yanıt vermedi\",\"description\":\"İran Meclis Başkanı Muhammed Bakır Kalibaf, ülkesinin yasal taleplerini içeren cevabını ABD tarafına açık ve net bir şekilde ilettiğini vurgulayarak, “ABD şu ana kadar İran’ın mesajına yanıt vermedi.” dedi.\",\"routeLink\":\"dunya/iran-meclis-baskani-kalibaf-abd-su-ana-kadar-iran-in-mesajina-yanit-vermedi/4121242\",\"imageUrl\":\"22160998455c03b3107cd86047384fc1.jpg\",\"archive\":false,\"videoUrl\":null,\"videoTime\":null,\"author\":null,\"authorImageUrl\":\"\",\"authorId\":null,\"authorTitle\":null,\"authorUrl\":\"\",\"poster\":null,\"filePath\":\"Contents/2026/11/11\",\"headline\":null,\"slot\":null,\"showAtLastNews\":1,\"createDate\":\"2026-11-11T20:14:44.77\",\"publishDate\":\"2026-11-11T20:15:48.507\",\"contentPhotos\":[],\"contentVideos\":[],\"id\":4121242,\"imagePath\":\"https://web-cdnprod.aa.com.tr/uploads/Contents/2026/11/11/\",\"videoPath\":\"\",\"posterPath\":\"\",\"posterUrl\":\"\",\"formatedCreatedDate\":\"11 Kasım 2026\",\"formatedUpdatedDate\":\"\",\"fullRoute\":\"/tr/dunya/iran-meclis-baskani-kalibaf-abd-su-ana-kadar-iran-in-mesajina-yanit-vermedi/4121242\",\"timeDifference\":\"\",\"isRecent\":false,\"newsType\":1},{\"enmNewsType\":0,\"liveBlogId\":null,\"liveBlogIsActive\":null,\"contentId\":4121204,\"redirect\":\"\",\"title\":\"Kızılhaç: Gazze'de yerinden edilmiş aileler çok az koruma ve şiddetli soğuklarla ​​karşı karşıya\",\"subTitle\":\"Kızılhaç: Gazze'de yerinden edilmiş aileler çok az koruma ve şiddetli soğuklarla ​​karşı karşıya\",\"description\":\"IFRC, Gazze'de yerinden edilmiş ailelerin şiddetli soğuklarla karşı karşıya olduğunu, tek barınakları olan çadırların ise şiddetli yağmur, sel ve rüzgar nedeniyle kullanılamaz hale geldiğini bildirdi.\",\"routeLink\":\"dunya/kizilhac-gazzede-yerinden-edilmis-aileler-cok-az-koruma-ve-siddetli-soguklarla-karsi-karsiya/4121204\",\"imageUrl\":\"294083fa5c0442d148cc6a1546f6c82f.jpg\",\"archive\":false,\"videoUrl\":null,\"videoTime\":null,\"author\":null,\"authorImageUrl\":\"\",\"authorId\":null,\"authorTitle\":null,\"authorUrl\":\"\",\"poster\":null,\"filePath\":\"Contents/2026/11/11\",\"headline\":null,\"slot\":null,\"showAtLastNews\":1,\"createDate\":\"2026-11-11T20:06:04.243\",\"publishDate\":\"2026-11-11T20:11:44.79\",\"contentPhotos\":[],\"contentVideos\":[],\"id\":4121204,\"imagePath\":\"https://web-cdnprod.aa.com.tr/uploads/Contents/2026/11/11/\",\"videoPath\":\"\",\"posterPath\":\"\",\"posterUrl\":\"\",\"formatedCreatedDate\":\"11 Kasım 2026\",\"formatedUpdatedDate\":\"\",\"fullRoute\":\"/tr/dunya/kizilhac-gazzede-yerinden-edilmis-aileler-cok-az-koruma-ve-siddetli-soguklarla-karsi-karsiya/4121204\",\"timeDifference\":\"\",\"isRecent\":false,\"newsType\":1},{\"enmNewsType\":0,\"liveBlogId\":null,\"liveBlogIsActive\":null,\"contentId\":4121172,\"redirect\":\"\",\"title\":\"Uluslararası Enerji Ekonomisi Birliği COP2026 Sempozyumu Antalya'da başladı\",\"subTitle\":\"Uluslararası Enerji Ekonomisi Birliği COP2026 Sempozyumu Antalya'da başladı\",\"description\":\"Uluslararası Enerji Ekonomisi Birliğince (IAEE) düzenlenen IAEE COP 2026 Sempozyumu, yerli ve yabancı akademisyenleri, kamu ve özel sektör temsilcilerini Antalya'da buluşturdu.\",\"routeLink\":\"ekonomi/uluslararasi-enerji-ekonomisi-birligi-cop2026-sempozyumu-antalyada-basladi/4121172\",\"imageUrl\":\"77e5bf8e3b7d02b84d669b12209d7b04.jpg\",\"archive\":false,\"videoUrl\":null,\"videoTime\":null,\"author\":null,\"authorImageUrl\":\"\",\"authorId\":null,\"authorTitle\":null,\"authorUrl\":\"\",\"poster\":null,\"filePath\":\"Conten