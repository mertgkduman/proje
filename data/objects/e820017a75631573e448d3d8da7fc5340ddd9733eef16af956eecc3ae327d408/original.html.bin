7\",\"$8\",\"$9\",\"$a\",\"$b\",\"$15\",\"$16\",\"$17\",\"$18\",\"$19\",\"$1a\",\"$1b\",\"$1c\",\"$1d\",\"$1e\",\"$1f\",\"$20\"],\"default\"]\naf:T581,\u003cp\u003eANKARA \u003c/p\u003e\u003cp\u003e\u003cstrong\u003eİyi Parti \u003c/strong\u003eGenel Sekreterliğine \u003cstrong\u003eCHP\u003c/strong\u003e'den istifa ederek partiye katılan \u003cstrong\u003eİzmir Milletvekili Aytun Çıray\u003c/strong\u003e getirildi.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eİyi Parti Genel Başkanı Meral Akşener\u003c/strong\u003e tarafından belirlenen başkanlık divanı üyelerinin görev dağılımı yapıldı.\u003c/p\u003e\u003cp\u003eBuna göre, Çıray Genel Sekreter olurken, \u003cstrong\u003eKoray Aydın\u003c/strong\u003e ise teşkilat işlerinden sorumlu Genel Başkan Yardımcısı görevine getirildi.\u003c/p\u003e\u003cp\u003eAhmet Ersagun Yücel sosyal politikalardan sorumlu Genel Başkan Yardımcısı, Ayfer Yılmaz uluslar arası işlerden sorumlu Genel Başkan Yardımcısı, Dursun Müsavat Dervişoğlu ise mahalli idarelerden sorumlu Genel Başkan yardımcısı oldu.\u003c/p\u003e\u003cp\u003eEski Merkez Bankası Başkanı Durmuş Yılmaz, ekonomiden sorumlu Genel Başkan Yardımcılığına, Hayrettin Nuhoğlu Genel Muhasipliğe, Mustafa Erdem hukuk ve seçim işlerinden sorumlu Genel Başkan Yardımcılığına, Şenol Bal parlamento ve siyasi ilişkilerden sorumlu Genel Başkan Yardımcılığına, Şule Ünlü Doğan, eğitim, kültür ve sanat politikalarından sorumlu Genel Başkan Yardımcılığına, Ümit Özdağ medya ve propagandadan sorumlu genel başkan yardımcılığına ve Vedat Taylan Yıldız da iletişim ve teknolojiden sorumlu Genel Başkan Yardımcılığına getirildi.\u003c/p\u003e\u003cp\u003eMuhabir: Barış Gündoğan\u003c/p\u003e9e:[\"$\",\"section\",null,{\"className\":\"container border-x border-borderColor flex flex-col bg-background\",\"children\":[[\"$\",\"$Lab\",null,{\"articleId\":\"949129\",\"articleTitle\":\"İyi Parti'de görev dağılımı belli oldu\",\"category\":\"Politika\",\"author\":\"Barış Gündoğan\",\"publishDate\":\"2017-10-27