    <!-- VIDEO PARTNER ROTATION (membrana / reklamup) -->
<script>
    (function () {
        var REKLAMUP_PERCENT = 100; // gösterim yüzdesi — tek ayar noktası

        // Membrana (ym.js) başka bir kaynaktan sızsa bile init olamasın: push'u yutan boş kuyruk.
        var q = [];
        q.push = function () {};
        window.yieldMasterCmd = q;

        window.dataLayer = window.dataLayer || [];

        // Plus üye kapısı — SessionManager.removeAds() ile AYNI sinyal (uyelik subdomain'inin set ettiği cookie).
        // Sunucu tarafında DEĞİL burada: anasayfa HTML'i Cloudflare'de cookie'den bağımsız cache'leniyor,
        // dolayısıyla Razor tarafındaki bir sunucu koşulu Plus üyeye ulaşmaz. ReklamUp player'ı kendi sticky banner'ını
        // doğrudan <body>'ye eklediği için removeAds() de ona erişemez; script hiç yüklenmemeli.
        var isPlusUser = false;
        try {
            isPlusUser = /(?:^|;\s*)_sgf_user_pids=[^;]+/.test(document.cookie);
        } catch (e) { /* cookie erişimi yoksa reklamı normal akışta göster */ }

        if (isPlusUser) {
            window.dataLayer.push({ event: 'video_partner_skipped', reason: 'plus_user' });
            return;
        }

        var partner = null;
        try {
            var qs = new URLSearchParams(window.location.search).get('videoPartner');
            if (qs === 'reklamup' || qs === 'membrana') partner = qs; // test override
        } catch (e) { /* eski tarayıcı — kuraya düş */ }

        if (!partner) {
            partner = (Math.random() * 100 < REKLAMUP_PERCENT) ? 'reklamup' : 'membrana';
        }

        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://videoapi.reklamup.com/datastore/generated/player/1/0/1/1.js';

        var cur = document.currentScript;
        if (cur && cur.parentNode) {
            cur.parentNode.insertBefore(s, cur);
        } else {
            document.head.appendChild(s);
        }

        window.dataLayer.push({ event: 'video_partner_selected', video_partner: partner });
    })();
</script>
<!-- /VIDEO PARTNER ROTATION -->

