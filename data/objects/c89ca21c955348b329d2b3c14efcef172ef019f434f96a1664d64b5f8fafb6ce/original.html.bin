    <!-- Aps Tag -->
    <script>
    (function () {
        try {
            if (window.inAppInterstitialBlockDisabled === true) return;

            var ua = navigator.userAgent || '';
            var isIOS = /iPhone|iPad|iPod/.test(ua) || (navigator.platform === 'MacIntel' && (navigator.maxTouchPoints || 0) > 1);

            // iOS WKWebView'de gerçek Safari'nin "Safari/" token'ı yoktur; CriOS/FxiOS ise
            // token'ı taşıdığı için yanlışlıkla yakalanmaz. Android tarafında WebView'in
            // "; wv)" işareti + bilinen uygulama imzaları kullanılır.
            var isInApp =
                /;\s*wv\)/.test(ua) ||
                /(FBAN|FBAV|FB_IAB|FBIOS|Instagram|LinkedInApp|Line\/|MicroMessenger|TwitterAndroid|Snapchat|Pinterest|GSA\/)/i.test(ua) ||
                (isIOS && !/Safari\//.test(ua));

            var forced = location.search.indexOf('inAppAdTest=1') > -1;
            var blocked = [];
            window.szcInAppAdBlock = { isInApp: isInApp, forced: forced, blocked: blocked };

            if (!isInApp && !forced) return;

            var BLOCKED_AD_UNITS = /sozcu_mobile_interstial|sozcu_popup/;

            window.googletag = window.googletag || { cmd: [] };
            googletag.cmd.push(function () {
                var original = googletag.defineOutOfPageSlot;
                if (typeof original !== 'function') return;
                googletag.defineOutOfPageSlot = function (adUnitPath) {
                    if (typeof adUnitPath === 'string' && BLOCKED_AD_UNITS.test(adUnitPath)) {
                        blocked.push(adUnitPath);
                        return null;
                    }
                    return original.apply(this, arguments);
                };
            });

            // İkinci katman: slot başka bir yoldan tanımlanırsa creative'in render edileceği
            // div kalmasın. adsv2'deki tüm getElementById kullanımları null-guard'lı.
            document.addEventListener('DOMContentLoaded', function () {
                var ids = ['div-sozcu_popup', 'div-sozcu_mobile_interstial'];
                for (var i = 0; i < ids.length; i++) {
                    var el = document.getElementById(ids[i]);
                    if (el && el.parentNode) el.parentNode.removeChild(el);
                }
            });
        } catch (e) {}
    })();
</script>

