    <!-- Editorial image dead-connection recovery (iOS WebKit + desktop Safari).
         Bound here in <head> BEFORE images load so above-the-fold failures are caught.
         Bounded (max/page), kill-switch'li (window.imageOneRetryDisabled), sadece editöryel sozcucdn.
         imageOneRetry.ts bundle ile dataset.imgRetry üzerinden koordineli (çift retry yok). -->
    <script>
        (function () {
            try {
                var ua = navigator.userAgent;
                var isIOS = /iPhone|iPad|iPod/.test(ua) || (navigator.platform === 'MacIntel' && (navigator.maxTouchPoints || 0) > 1);
                var isDesktopSafari = /\bSafari\//.test(ua) && !/\b(Chrome|Chromium|CriOS|HeadlessChrome|Edg|OPR|Firefox|FxiOS)\//.test(ua);
                if (!(isIOS || isDesktopSafari) || window.imageOneRetryDisabled === true) return;
                var MAX = 50, done = 0;
                function isCdn(h) { return h === 'sozcucdn.com' || /\.sozcucdn\.com$/.test(h); }
                function bust(raw) { try { var u = new URL(raw, location.origin); if (!isCdn(u.hostname)) return null; u.searchParams.set('safari_img_retry', '1'); return u.toString(); } catch (e) { return null; } }
                document.addEventListener('error', function (e) {
                    var img = e.target;
                    if (done >= MAX || !(img instanceof HTMLImageElement) || img.dataset.imgRetry === '1') return;
                    var src = img.currentSrc || img.getAttribute('src') || '';
                    if (!/sozcucdn\.com/.test(src) || src.indexOf('safari_img_retry') > -1) return;
                    var next = bust(src); if (!next) return;
                    img.dataset.imgRetry = '1'; done++;
                    var pic = img.closest && img.closest('picture');
                    if (pic) Array.prototype.forEach.call(pic.querySelectorAll('source'), function (s) {
                        var ss = s.getAttribute('srcset');
                        if (ss && /sozcucdn\.com/.test(ss)) s.setAttribute('srcset', ss.replace(/[^\s,]+/g, function (m) { return bust(m) || m; }));
                    });
                    img.removeAttribute('srcset'); img.setAttribute('loading', 'eager'); img.setAttribute('src', next);
                }, true);
            } catch (e) {}
        })();
    </script>
