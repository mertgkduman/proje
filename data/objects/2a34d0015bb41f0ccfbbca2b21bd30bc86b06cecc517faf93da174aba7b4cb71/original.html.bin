                <canvas class="zemin__field" data-menu-field='{&quot;mode&quot;:&quot;island&quot;,&quot;seed&quot;:777,&quot;cell&quot;:13,&quot;gap&quot;:2,&quot;radius&quot;:0,&quot;scale&quot;:7,&quot;levels&quot;:8,&quot;band&quot;:0.2,&quot;tones&quot;:4,&quot;gamma&quot;:1,&quot;floor&quot;:0.32,&quot;shading&quot;:&quot;symmetric&quot;,&quot;dropLowest&quot;:false,&quot;jitter&quot;:0,&quot;peaks&quot;:11,&quot;octaves&quot;:3,&quot;lacunarity&quot;:2,&quot;gain&quot;:0.5,&quot;warp&quot;:0.4,&quot;groundL&quot;:0.175,&quot;groundC&quot;:0.04,&quot;groundH&quot;:258,&quot;inkL&quot;:0.38,&quot;inkC&quot;:0.055,&quot;inkH&quot;:250,&quot;phase&quot;:1.0800000000000007,&quot;speed&quot;:0.06,&quot;animate&quot;:true,&quot;fps&quot;:20}' aria-hidden="true"></canvas>
                <p class="site-sheet__slogan"><span>Türkiye&apos;nin </span><span class="site-sheet__word"><span>DEVA</span><svg class="site-mark site-mark--drawn" aria-hidden="true" focusable="false" viewBox="0 0 500 150" preserveAspectRatio="none"><path d="M7.7,145.6C109,125,299.9,116.2,401,121.3c42.1,2.2,87.6,11.8,87.3,25.7" pathLength="1" stroke-dasharray="1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"/></svg></span><span>&apos;sı</span></p>
