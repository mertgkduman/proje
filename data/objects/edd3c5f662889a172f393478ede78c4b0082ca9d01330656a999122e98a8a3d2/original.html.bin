<style>
  body, .card-body { color:#000; }

  .page-banner{background:#f8f9fa;border-bottom:2px solid #e43442;padding:.75rem 0;margin-bottom:1rem;}
  .banner-title{font-size:1.25rem;font-weight:800;margin:0;color:#000;letter-spacing:.2px;}

  /* Banner sosyal ikonları */
  .banner-socials .social-btn{
    width:36px;height:36px;border-radius:50%;
    display:inline-flex;align-items:center;justify-content:center;
    background:#273248;color:#fff;font-size:.95rem;border:none;text-decoration:none;
    transition:transform .15s ease, box-shadow .15s ease, background .15s ease;
  }
  .banner-socials .social-btn:hover{ background:#c2202c; transform:translateY(-2px); box-shadow:0 6px 18px rgba(228,52,66,.3); }

  .text-tip{color:#e43442;}
  .link{color:#e43442;text-decoration:none; font-weight:700; }
  .mb-section{margin-bottom:2rem;}
  .section-divider{padding-bottom:1.5rem; border-bottom:3px solid rgba(228,52,66,.35);}

  /* HERO */
  .container-1200 { max-width: 1000px; }
  .hero-band{ row-gap:1rem; }
  .hero-name{
    font-weight:900; line-height:1.15; margin:.25rem 0 .25rem;
    font-size:2rem;
  }
  @media (min-width: 768px){ .hero-name{ font-size:2.25rem; } }
  @media (min-width: 992px){ .hero-name{ font-size:2.5rem; } }

  .hero-avatar{
    width:100%;
    max-width:520px;
    border-radius:14px;
    background:#fff;
    margin:.5rem 0 0;
  }
  @media (min-width: 992px){ .hero-avatar{ margin:.25rem 0; } }

  .hero-text{ max-width:66ch; }
  p{ line-height:1.7; margin:.75rem 0; }

  /* --- GALERİ --- */
  .gallery-head{ display:flex; align-items:center; gap:.6rem; margin-bottom:.6rem; }
  .gallery-title{ font-size:1.125rem; font-weight:800; margin:0; display:flex; align-items:center; gap:.5rem; }
  .gallery-ico{ display:inline-flex; width:28px; height:28px; align-items:center; justify-content:center; background:#e43442; color:#fff; border-radius:8px; }
  .gallery-grid{ display:grid; grid-template-columns:repeat(2, 1fr); gap:.75rem; }
  .gallery-item{ position:relative; }
  .gallery-item a{ display:block; border:1px solid #e9ecef; border-radius:10px; overflow:hidden; background:#fff; position:relative; }
  .gallery-item img{ width:100%; height:380px; object-fit:cover; display:block; transition:transform .18s ease; }
  .gallery-item a:hover img{ transform:scale(1.03); }

  /* --- LIGHTBOX --- */
  .lb[hidden]{ display:none; }
  .lb{ position:fixed; inset:0; z-index:1050; }
  .lb-backdrop{ position:absolute; inset:0; background:rgba(0,0,0,.7); }
  .lb-dialog{ position:relative; width:min(92vw,1200px); max-height:92vh; margin:4vh auto; background:#111; color:#fff; border-radius:14px; display:flex; flex-direction:column; box-shadow:0 16px 40px rgba(0,0,0,.5); }
  .lb-close{ position:absolute; right:.5rem; top:.5rem; width:36px; height:36px; border-radius:8px; border:none; background:rgba(255,255,255,.12); color:#fff; font-size:18px; cursor:pointer; }
  .lb-media{ padding:0; display:flex; align-items:center; justify-content:center; background:#000; border-top-left-radius:14px; border-top-right-radius:14px; }
  #lbImg{ max-width:100%; max-height:72vh; width:auto; height:auto; object-fit:contain; display:block; }
  .lb-footer{ display:flex; align-items:center; justify-content:space-between; gap:.75rem; padding:.75rem 1rem; background:#1b1b1b; border-bottom-left-radius:14px; border-bottom-right-radius:14px; }
  .lb-meta{ display:flex; flex-direction:column; gap:.15rem; }
  #lbTitle{ font-size:1rem; }
  .lb-actions{ display:flex; gap:.5rem; }
  .lb-btn{ display:inline-flex; align-items:center; justify-content:center; padding:.55rem 1rem; border-radius:10px; text-decoration:none; font-weight:700; background:#e43442; color:#fff; }
  .lb-btn:hover{ background:#c2202c; }

  /* Mobilde tam ekran Lightbox */
  @media (max-width: 767.98px) {
    .lb-dialog { width:100vw; max-width:100vw; height:100vh; max-height:100vh; margin:0; border-radius:0; }
    .lb-close { right:1rem; top:1rem; }
    .lb-media { flex-grow:1; padding:1rem; border-radius:0; }
    #lbImg { height:100%; object-fit:contain; }
    .lb-footer { border-radius:0; background:#000; }
  }
</style>

<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
(function(){
  const lightbox   = document.getElementById('lightbox');
  const imgEl      = document.getElementById('lbImg');
  const dlBtn      = document.getElementById('lbDownload');

  document.addEventListener('click', function(ev){
    const a = ev.target.closest('a.js-lightbox');
    if(!a) return;
    ev.preventDefault();

    const href = a.getAttribute('href');
    imgEl.src  = href;
    dlBtn.href = href;
    openLb();
  });

  lightbox.addEventListener('click', function(ev){
    if (ev.target.hasAttribute('data-close')) { closeLb(); }
  });
  document.addEventListener('keydown', function(ev){
    if (ev.key === 'Escape' && !lightbox.hasAttribute('hidden')) closeLb();
  });

  function openLb(){
    lightbox.removeAttribute('hidden');
    lightbox.setAttribute('aria-hidden','false');
    document.documentElement.style.overflow = 'hidden';
  }
  function closeLb(){
    lightbox.setAttribute('hidden','');
    lightbox.setAttribute('aria-hidden','true');
    imgEl.src = '';
    document.documentElement.style.overflow = '';
  }
})();
</script>
