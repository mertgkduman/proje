<!-- ============ LIGHTBOX ============ -->
<div class="lb" id="lightbox" aria-hidden="true" hidden>
  <div class="lb-backdrop" data-close></div>
  <div class="lb-dialog" role="dialog" aria-modal="true" aria-labelledby="lbTitle">
    <button class="lb-close" type="button" aria-label="Kapat" title="Kapat (Esc)" data-close>✕</button>
    <div class="lb-media">
      <img id="lbImg" src="" alt="Önizleme" />
    </div>
    <div class="lb-footer">
      <div class="lb-meta">
        <strong id="lbTitle">Görsel Önizleme</strong>
      </div>
      <div class="lb-actions">
        <a id="lbDownload" class="lb-btn" href="#" download>İndir</a>
      </div>
    </div>
  </div>
</div>

