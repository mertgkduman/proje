<style type="text/css">
.author-slider {
width: 100%;
box-sizing: border-box;
padding: 0 20px;
}
.author-slide {
text-align: left;
padding: 10px;
box-sizing: border-box;
}
.author-slide img {
border-radius: 50%;
display: block;
margin-bottom: 10px;
max-width: 100%;
height: auto;
}
.author-slide h3, .author-slide p {
margin: 0;
}
.slick-prev, .slick-next {
position: absolute;
top: 50%;
transform: translateY(-50%);
background: none;
border: none;
outline: none;
cursor: pointer;
color: #4d4d4d !important; /* Varsayılan renk */
display: block !important;
opacity: 1 !important;
z-index: 1000;
width: auto;
height: auto;
text-shadow: none !important;
}
.slick-prev::before, .slick-next::before {
content: '' !important;
}
/* Large screens (default settings) */
.slick-prev {
left: -40px;
}
.slick-next {
right: -40px;
}
/* Tablet screens */
@media (max-width: 768px) {
.slick-prev {
left: -20px; /* Okları daha içeri almak için */
}
.slick-next {
right: -20px; /* Okları daha içeri almak için */
}
}
/* Mobile screens */
@media (max-width: 480px) {
.slick-prev, .slick-next {
top: 90%; /* Okların yükseklik pozisyonunu ayarlar */
transform: translateY(-50%);
}
.slick-prev {
left: 10px; /* Sol ok için içeriye çekme */
}
.slick-next {
right: 10px; /* Sağ ok için içeriye çekme */
}
}
.slick-prev:hover, .slick-next:hover,
.slick-prev:focus, .slick-next:focus,
.slick-prev:active, .slick-next:active {
color: #39B54A !important; /* Hover durumunda yeşil renk */
background: none !important;
border: none !important;
text-shadow: none !important;
}
</style>
