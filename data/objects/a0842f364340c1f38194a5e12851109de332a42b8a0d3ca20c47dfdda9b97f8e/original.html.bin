<style>
.yg-cop31 {
display: flex;
align-items: center;
justify-content: center;
flex-wrap: wrap;
gap: 12px;
max-width: 900px;
margin: 12px auto 22px;
padding: 12px 20px;
background: linear-gradient(110deg, #f0faf1, #ffffff, #edf8ef);
border: 1px solid #d5ead8;
border-radius: 10px;
font-family: inherit;
text-align: center;
box-sizing: border-box;
}
.yg-cop31-badge {
display: inline-flex;
align-items: center;
gap: 7px;
padding: 7px 12px;
background: #d62828;
color: #ffffff;
border-radius: 6px;
font-size: 13px;
font-weight: 800;
letter-spacing: 1px;
}
.yg-cop31-dot {
width: 7px;
height: 7px;
border-radius: 50%;
background: #fff;
animation: ygPulse 2s infinite;
}
.yg-cop31-text {
display: flex;
flex-wrap: wrap;
justify-content: center;
gap: 5px;
font-size: 15px;
line-height: 1.6;
color: #444;
}
.yg-cop31-text strong {
color: #269638;
font-weight: 750;
}
@keyframes ygPulse {
0%, 100% { opacity: 1; transform: scale(1); }
50% { opacity: .35; transform: scale(.75); }
}
@media (max-width: 600px) {
.yg-cop31 {
margin: 10px 12px 18px;
padding: 12px;
gap: 8px;
}
.yg-cop31-text {
font-size: 13px;
}
}
@media (prefers-reduced-motion: reduce) {
.yg-cop31-dot { animation: none; }
}
</style>
