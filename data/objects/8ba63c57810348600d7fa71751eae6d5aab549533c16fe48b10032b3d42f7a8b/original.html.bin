idth\":\"2px\",\"height\":\"24px\"},\"aria-hidden\":\"true\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0 space-y-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-skeletonColor rounded animate-pulse bg-skeletonColor\",\"style\":{\"width\":\"48px\",\"height\":\"14px\"},\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"bg-skeletonColor rounded animate-pulse bg-skeletonColor\",\"style\":{\"width\":\"95%\",\"height\":\"18px\"},\"aria-hidden\":\"true\"}]]}]]}]\na1:[\"$\",\"div\",\"last-news-skeleton-5\",{\"className\":\"flex gap-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center shrink-0 w-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-skeletonColor rounded-full animate-pulse shrink-0 bg-skeletonColor\",\"style\":{\"width\":\"8px\",\"height\":\"8px\"},\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"bg-skeletonColor animate-pulse mt-0 shrink-0 bg-skeletonColor\",\"style\":{\"width\":\"2px\",\"height\":\"24px\"},\"aria-hidden\":\"true\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0 space-y-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-skeletonColor rounded animate-pulse bg-skeletonColor\",\"style\":{\"width\":\"48px\",\"height\":\"14px\"},\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"bg-skeletonColor rounded animate-pulse bg-skeletonColor\",\"style\":{\"width\":\"75%\",\"height\":\"18px\"},\"aria-hidden\":\"true\"}]]}]]}]\na2:[\"$\",\"div\",\"last-news-skeleton-6\",{\"className\":\"flex gap-2\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col items-center shrink-0 w-3\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-skeletonColor rounded-full animate-pulse shrink-0 bg-skeletonColor\",\"style\":{\"width\":\"8px\",\"height\":\"8px\"},\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"bg-skeletonColor animate-pulse mt-0 shrink-0 bg-skeletonColor\",\"style\":{\"width\":\"2px\",\"height\":\"24px\"},\"aria-hidden\":\"true\"}]]}],[\"$\",\"div\",null,{\"className\":\"flex-1 min-w-0 space-y-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"bg-skeletonColor rounded animate-pulse bg-skeletonColor\",\"style\":{\"width\":\"48px\",\"height\":\"14px\"},\"aria-hidden\":\"true\"}],[\"$\",\"div\",null,{\"className\":\"bg-skeletonColor rounded animate-pulse bg-skeletonColor\",\"style\":{\"width\":\"95%\",\"height\":\"18px\"},\"aria-hidden\":\"true\"}]]}]]}]\na3:[\"$\",\"div\",null,{\"className\":\"flex justify-between items-center gap-4 mt-4\",\"children\":[\"$\",\"div\",null,{\"className\":\"bg-skeletonColor rounded animate-pulse bg-skeletonColor\",\"style\":{\"width\":\"100px\",\"height\":\"20px\"},\"aria-hidden\":\"true\"}]}]\na4:[\"$\",\"div\",null,{\"className\":\"border-b border-borderColor\"}]\na5:[\"$\",\"section\",null,{\"className\":\"flex flex-col gap-1 text-start p-4\",\"role\":\"status\",\"aria-busy\":\"true\",\"children\":[[\"$\",\"div\",null,{\"children\":[\"$\",\"div\",null,{\"className\":\"bg-skeletonColor animate-pulse w-full h-auto aspect-[4/3] rounded-lg bg-skeletonColor\",\"style\":{},\"aria-hidden\":\"true\"}]}],[\"$\",\"div\",null,{\"className\":\"caustenBlack text-start\",\"children\":[\"$\",\"div\",null,{\"className\":\"bg-skeletonColor rounded animate-pulse rounded bg-skeletonColor\",\"style\":{\"width\":\"60%\",\"height\":\"28px\"},\"aria-hidden\":\"true\"}]}]]}]\naa:Ta85,\u003cp\u003eMilli Görüş hareketinin kurucu lideri ve \"Türk siyasetinin hocası\" merhum başbakanlardan \u003cstrong\u003eNecmettin Erbakan\u003c/strong\u003e tarafından 20 Temmuz 2001'de \u003cstrong\u003ekurulan Saadet Partisi'\u003c/strong\u003ende, kongre hazırlığında sona gelindi.\u003c/p\u003e\u003cp\u003eKurucu Genel Başkanlığını Recai Kutan'ın yaptığı partinin 11 Mayıs 2003'te yapılan 1. Olağan Kongresi'nde, Kutan'ın aday olmaması nedeniyle Erbakan genel başkanlığa seçildi.\u003c/p\u003e\u003cp\u003eTakvimler 29 Aralık 2003'ü gösterdiğinde ise Yargıtay Cumhuriyet Başsavcılığı, Erbakan'ın kesinleşmiş hapis cezası nedeniyle parti üyeliğinden ayrılmasını istedi. Bunun üzerine Erbakan, 30 Ocak 2004'te parti üyeliğinden ve genel başkanlık görevinden istifa ederek, yerini Kutan'a bıraktı.\u003c/p\u003e\u003cp\u003ePartinin 8 Nisan 2006'da yapılan 2. Olağan Büyük Kongresinde Kutan, yeniden genel başkanlığa seçildi.\u003c/p\u003e\u003cp\u003eKutan, 2 yıl sürdürdüğü bu görevin ardından 26 Ekim 2008'de yapılan 3. Büyük Kongre'de koltuğu Numan Kurtulmuş'a devretti.\u003c/p\u003e\u003ch3\u003eErbakan 6 yıl sonra yeniden Genel Başkan\u003c/h3\u003e\u003cp\u003eKurtulmuş, 11 Temmuz 2010'da yapılan Olağanüstü Kongre süreci ve sonrasında yaşanan olayların ardından 1 Ekim 2010'da yaptığı basın toplantısında, genel başkanlık görevi ve partiden istifa ettiğini açıkladı.\u003c/p\u003e\u003cp\u003eBunun üzerine 17 Ekim 2010'da yapılan Olağanüstü Büyük Kongrede Erbakan, 6 yıl önce bırakmak zorunda kaldığı Genel Başkanlık görevine yeniden döndü.\u003c/p\u003e\u003cp\u003eErbakan'ın 28 Şubat post-modern darbenin yıl dönümü arifesinde solunum yetmezliğine bağlı, kalp ve çoklu organ yetmezliği sebebiyle 27 Şubat 2011'de vefat etmesi dolayısıyla parti, 2011 Genel Seçimleri'ne Mustafa Kamalak'ın Genel Başkanlığında gitme kararı aldı.\u003c/p\u003e\u003cp\u003eKamalak, seçimden hemen sonra yapılan kongrede de tekrar genel başkan seçildi.\u003c/p\u003e\u003cp\u003ePartinin, 30 Ekim 2016'de gerçekleştirdiği 6. Olağan Kongresinde, yeni Genel Başkan \u003cstrong\u003eTemel Karamollaoğlu\u003c/strong\u003e oldu.\u003c/p\u003e\u003ch3\u003eKongrede, Milli Görüş'ün gelecek 50 yıl vizyonu anlatılacak\u003c/h3\u003e\u003cp\u003eYaklaşık 18 yıldır siyaset sahnesinde yer alan Saadet Partisi'nin 7'nci Olağan Büyük Kongresi ise 3 Kasım Pazar günü Ankara Spor Salonu'nda saat 10.00'da yapılacak.\u003c/p\u003e\u003cp\u003eKaramollaoğlu'nun tek aday olacağı kongrede, yeni parti programı oylamaya sunulacak. Milli Görüş hareketinin 50 yıllık siyasi hafızası, Türkiye ve dünyadaki gelişmelerin göz önünde bulundurularak hazırlandığı parti programı ve hareketin gelecek 50 yıl vizyonu kongrede anlatılacak.\u003c/p\u003e\u003cp\u003eAyrıca \"Gelecek Saadet ile Gelecek\" sloganıyla yapılacak kongre için yeni parti müzikleri de hazırlandı.\u003c/p\u003e9d:[\"$\",\"section\",null,{\"className\":\"container border-x border-borderColor flex flex-col bg-background\",\"children\":[[\"$\",\"$La6\",null,{\"articleId\":\"1632608\",\"articleTitle\":\"Saadet Partisi'nde kongre heyecanı\",\"category\":\"Politika\",\"author\":\"Sefa Şahin,Süleyman Tunç\",\"publishDate\":\"2019-11-01T11:02:10.027\"}],[\"$\",\"$La7\",null,{\"contentId\":\"1632608\",\"contentType\":\"article\",\"category\":\"Politika\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col md:flex-row gap-0\",\"children\":[[\"$\",\"div\",null,{\"className\":\"w-full flex flex-col md:w-8/12 lg:w-9/12 border-e border-borderColor\",\"children\":[[\"$\",\"div\",null,{\"className\":\"items-start p-5 lg:px-20\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col items-start gap-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-2\",\"children\":[[\"$\",\"$L21\",\"0\",{\"href\":\"/tr/politika\",\"children\":[\"$\",\"span\",\"0\",{\"className\":\"bg-categoryTagBackground text-categoryTagText px-3 py-2 caustenRegular rounded-full text-[12px] md:text-[14px] inline-flex items-center justify-center uppercase\",\"children\":\"Politika\"}]}]]}],[\"$\",\"div\",null,{\"className\":\"flex flex-row items-start gap-2\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-col items-start gap-2\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"category-detail-subtitle caustenBlack text-[31px] leading-none md:text-[32px] xl:text-[42px] font-bold\",\"children\":\"Saadet Partisi'nde kongre heyecanı\"}],[\"$\",\"span\",null,{\"className\":\"category-detail-description lora text-[17px] leading-[1.4] lg:text-[18px] xl:text-[20px] text-descriptionColor\",\"children\":\"Saadet Partisi'nin 