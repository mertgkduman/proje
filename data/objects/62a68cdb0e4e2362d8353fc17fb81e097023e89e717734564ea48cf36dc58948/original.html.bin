<script>
    // --- Sayfada Geçirilen Süre Takibi (Time on Page) ---
    let pageLoadTime = Date.now();
    let totalTimeSpent = 0;
    let isPageActive = true;

    // Kullanıcı sekmeyi değiştirdiğinde süreyi duraklat/devam ettir
    document.addEventListener('visibilitychange', function () {
        if (document.hidden) {
            totalTimeSpent += Date.now() - pageLoadTime;
            isPageActive = false;
        } else {
            pageLoadTime = Date.now();
            isPageActive = true;
        }
    });

    // Sayfa kapanmadan veya yenilenmeden hemen önce veriyi gönder
    window.addEventListener('beforeunload', function () {
        if (isPageActive) {
            totalTimeSpent += Date.now() - pageLoadTime;
        }
        gtag('event', 'time_spent_on_page', {
            'value': totalTimeSpent,
            'page_path': window.location.pathname
        });
    });

    // --- Kaydırma Derinliği Takibi (Scroll Depth) ---
    document.addEventListener('scroll', function () {
        const scrollHeight = document.documentElement.scrollHeight;
        const scrollTop = document.documentElement.scrollTop || document.body.scrollTop;
        const clientHeight = document.documentElement.clientHeight;
        
        // Yüzdelik hesaplama
        const scrollDepth = (scrollTop + clientHeight) / scrollHeight * 100;
        const thresholds = [25, 50, 75, 100];

        thresholds.forEach(threshold => {
            // Eğer eşik aşıldıysa ve daha önce tetiklenmediyse
            if (scrollDepth >= threshold && !window[`scrollThreshold${threshold}`]) {
                window[`scrollThreshold${threshold}`] = true; // Global bayrak (flag) ayarla
                gtag('event', 'scroll_depth', {
                    'value': threshold,
                    'page_path': window.location.pathname
                });
            }
        });
    });
</script>

