        <style>
            html.kx-sabitduzen body{width:1366px;transform-origin:0 0;transform:scale(var(--kx-olcek))}
            html.kx-sabitduzen .suorta{width:1200px !important;max-width:1200px !important}
            html.kx-sabitduzen .grid-stack.gs-prelayout>.grid-stack-item[data-tamgenislik="1"]{margin-left:calc(50% - 683px);margin-right:calc(50% - 683px)}
            html.kx-sabitduzen>[data-kx-sabit]{position:absolute;top:0;left:0;width:0;height:0}
        </style>
        <script>
            /* NEDEN transform:scale, zoom DEGIL — ikisi de sayfayi kucultur ama zoom
               layout'u YENIDEN HESAPLAR: olcekli piksele yuvarlama icerigi ~1-3px
               buyutur ve kutusunda zaten sinirda duran modullerde (or. Yazarlar_12
               icerigi kutusunu olceksiz halde bile 3px asiyor) tasma iki katina
               cikip overflow:hidden ile kirpilir — sayfalama noktalari kayboluyordu.
               transform layout'a HIC dokunmaz: 1366'lik tuvalde hesaplanan sayfa
               yalnizca gorsel olarak kuculur, yani tabletin viewport=1366 ile yaptigi
               isin birebir ayni. Olculdu (olcek 0.72): tasma zoom'da 6.7px,
               transform'da 3px = olceksiz haliyle ayni.
               BEDELI iki tane, ikisi de burada telafi ediliyor:
               1) transform layout yuksekligini degistirmedigi icin sayfa olceksiz
                  boyunda kaydirilirdi — body'ye negatif alt marj verilir.
               2) transform'lu ata, icindeki position:fixed ogelerin kapsayici blogunu
                  degistirir (viewport yerine body); o ogeler html'in altina tasinir.
                  .aramaKatman'in CSS'i .Header_025 kapsaminda oldugu icin ata sinifini
                  tasiyan bir sarmalayiciyla tasinir, yoksa stilsiz kalirdi. Tasima
                  DOMContentLoaded'da, yani defer'li home.js referanslarini aldiktan
                  SONRA yapilir. Yeni bir fixed oge eklenirse asagidaki listeye girmeli. */
            (function () {
                var TABAN = 1366;                // deskmode viewport'u
                var de = document.documentElement;
                var sonK = null, tasindi = false;

                function olcek() {
                    var w = de.clientWidth || window.innerWidth;
                    return w >= TABAN ? 1 : w / TABAN;
                }
                function telafiEt(k) {
                    var b = document.body;
                    if (!b) return;
                    if (k === 1) { b.style.removeProperty('margin-bottom'); return; }
                    b.style.marginBottom = -(b.offsetHeight * (1 - k)) + 'px';
                }
                function sabitleriDisariAl() {
                    if (!document.body) return;
                    tasindi = true;
                    ['#yukari-kaydir-btn', '#kxAcilis', '.aramaKatman', '#kxSolMenu'].forEach(function (sec) {
                        [].forEach.call(document.querySelectorAll(sec), function (el) {
                            var eb = el.parentNode;
                            if (eb === de || (eb && eb.hasAttribute && eb.hasAttribute('data-kx-sabit'))) return;
                            var ata = el.closest ? el.closest('#haberxheader, #haberxfooter, .grid-stack-item') : null;
                            if (ata && ata.className) {
                                var sar = document.createElement('div');
                                sar.className = ata.className;
                                sar.setAttribute('data-kx-sabit', '1');
                                de.appendChild(sar);
                                sar.appendChild(el);
                            } else {
                                /* data-kx-sabit BURAYA konmaz: o isaret yalnizca
                                   sarmalayici icindir, ogenin kendisine konursa
                                   yukaridaki 0x0 kurali ogeyi de kucultup sol uste
                                   yapistirir (yukari-kaydir butonu boyle kaybolmustu).
                                   Tekrar tasimayi zaten ebeveyn kontrolu engelliyor. */
                                de.appendChild(el);
                            }
                        });
                    });
                }
                function ayarla() {
                    var k = olcek();
                    if (k !== sonK) {
                        sonK = k;
                        if (k === 1) {
                            de.classList.remove('kx-sabitduzen');
                            de.style.removeProperty('--kx-olcek');
                        } else {
                            de.style.setProperty('--kx-olcek', k);
                            de.classList.add('kx-sabitduzen');
                            if (!tasindi) sabitleriDisariAl();
                        }
                    }
                    telafiEt(k);
                }
                ayarla();
                addEventListener('resize', ayarla);
                document.addEventListener('DOMContentLoaded', function () {
                    if (sonK !== null && sonK < 1) sabitleriDisariAl();
                    ayarla();
                    /* Sayfa boyu sonradan degisir (tembel gorsel, sonsuz yukleme,
                       reklam) — alt marj telafisi onunla birlikte guncellenmeli. */
                    if (window.ResizeObserver)
                        new ResizeObserver(function () { telafiEt(sonK === null ? 1 : sonK); }).observe(document.body);
                });
                if (window.ResizeObserver) new ResizeObserver(ayarla).observe(de);
            })();
        </script>

    
