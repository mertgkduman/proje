        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0" style="height:90vh;">
                <div class="modal-header py-2 px-3" style="background:var(--bordo);color:#fff;border-radius:0;">
                    <span id="pdfModalLabel" class="small fw-semibold text-truncate me-2" style="max-width:80%;"></span>
                    <div class="d-flex gap-2 ms-auto">
                        <button id="pdfModalFullscreen" type="button"
                            class="btn btn-sm px-2 py-1 border-0 text-white d-flex align-items-center gap-1"
                            style="background:rgba(255,255,255,0.15); font-size:0.75rem;" title="Yeni sekmede aç">
                            <i class="ri-external-link-line"></i>
                            <span class="d-none d-sm-inline">Tam ekran</span>
                        </button>

                        <button type="button" class="btn btn-sm px-2 py-1 border-0 text-white"
                            style="background:rgba(255,255,255,0.15);" data-bs-dismiss="modal" aria-label="Kapat">
                            <i class="ri-close-line"></i>
                        </button>
                    </div>
                </div>
                <div class="modal-body p-0" style="flex:1;overflow:hidden;">
                    <iframe id="pdfModalFrame" src="" style="width:100%;height:100%;border:none;"
                        allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </div>

    <script src="https://www.yargitaycb.gov.tr/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="https://www.yargitaycb.gov.tr/js/yargitay-script.js"></script>
    <script src="https://www.yargitaycb.gov.tr/js/yargitay-pages.js"></script>
    
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const pdfModal = new bootstrap.Modal(document.getElementById('pdfModal'));
            const pdfFrame = document.getElementById('pdfModalFrame');
            const pdfLabel = document.getElementById('pdfModalLabel');

            let currentPdfHref = '';

            document.addEventListener('click', function(e) {
                const link = e.target.closest('a[href]');
                if (!link) return;
                const href = link.getAttribute('href') || '';
                if (href.match(/\.pdf(\?.*)?$/i)) {
                    e.preventDefault();
                    currentPdfHref = href;
                    const fileName = decodeURIComponent(href.split('/').pop().split('?')[0]);
                    pdfLabel.textContent = fileName;
                    pdfFrame.src = href.includes('#') ? href : href + '#page=1&zoom=auto';
                    pdfModal.show();
                }
            });

            document.getElementById('pdfModalFullscreen').addEventListener('click', function() {
                if (currentPdfHref) window.open(currentPdfHref, '_blank');
            });

            document.getElementById('pdfModal').addEventListener('hidden.bs.modal', function() {
                pdfFrame.src = '';
                currentPdfHref = '';
            });
        });
    </script>

    <script src="https://www.yargitaycb.gov.tr/js/_Accessibility.js" data-asw-css-path="https://www.yargitaycb.gov.tr/css/_Accessibility.css"
        data-asw-lang="tr" data-asw-position="bottom-right" data-asw-offset="20,90" defer></script>
</body>

</html>
