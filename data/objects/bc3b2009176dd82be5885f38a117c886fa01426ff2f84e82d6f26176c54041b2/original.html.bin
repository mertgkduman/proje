<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
(function() {
  const contentRoot = document.querySelector('.tuzuk-html');

  // Arama elemanları
  const searchInputs = [document.getElementById('tocSearch'), document.getElementById('tocSearchMobile')].filter(Boolean);
  const clearBtns    = [document.getElementById('tocClear'), document.getElementById('tocClearMobile')].filter(Boolean);
  const countEls     = [document.getElementById('searchCount'), document.getElementById('searchCountMobile')].filter(Boolean);

  const allLinks = Array.from(document.querySelectorAll('.toc-link'));
  const sections = Array.from(document.querySelectorAll('.tuzuk-section'));
  const linkMap  = new Map(); allLinks.forEach(a => linkMap.set(a.getAttribute('href'), a));

  // ---------------- Yardımcılar
  let matchNodes = []; let matchIndex = -1;

  function clearHighlights(){
    contentRoot.querySelectorAll('mark.search-hit').forEach(m => m.replaceWith(document.createTextNode(m.textContent)));
  }
  function highlightInElement(el, re){
    el.innerHTML = el.innerHTML.replace(/<mark class="search-hit">(.*?)<\/mark>/g,'$1');
    el.innerHTML = el.innerHTML.replace(re, m => `<mark class="search-hit">${m}</mark>`);
  }
  function updateCounts(t){ countEls.forEach(el => el && (el.textContent = String(t))); }
  function resetBadgesAndFilter(){
    allLinks.forEach(a=>{
      a.classList.remove('d-none');
      const b=a.querySelector('.hit-badge');
      if (b){ b.classList.add('d-none'); b.textContent='0'; }
    });
  }
  function applyBadges(sectionHits){
    allLinks.forEach(a=>{
      const id=a.getAttribute('href');
      const n=sectionHits.get(id)||0;
      const b=a.querySelector('.hit-badge');
      if (b){
        if (n>0){ b.textContent=n; b.classList.remove('d-none'); }
        else { b.classList.add('d-none'); }
      }
    });
  }
  function filterTOC(sectionHits, q){
    const active = (q && q.length >= 2);
    allLinks.forEach(a=>{
      if (!active){ a.classList.remove('d-none'); return; }
      const id = a.getAttribute('href');
      const n  = sectionHits.get(id) || 0;
      if (n===0) a.classList.add('d-none'); else a.classList.remove('d-none');
    });
  }
  const debounce = (fn,ms)=>{ let t; return (...a)=>{ clearTimeout(t); t=setTimeout(()=>fn(...a),ms); }; };
  function buildRegexFromQuery(q){
    const esc = s => s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
    return new RegExp(q.split(/\s+/).filter(Boolean).map(esc).join('|'),'gi');
  }

  // ---------------- Arama (OTOMATİK ATLAMA YOK)
  function doSearch(qRaw){
    const q = (qRaw || '').trim();
    sessionStorage.setItem('tuzukSearch', q);
    clearHighlights(); resetBadgesAndFilter(); matchNodes = []; matchIndex = -1;

    if (q.length < 2){ updateCounts(0); return; }

    const re = buildRegexFromQuery(q);
    const sectionHits = new Map();

    contentRoot.querySelectorAll('p, h2, h3, pre').forEach(el => highlightInElement(el, re));
    matchNodes = Array.from(contentRoot.querySelectorAll('mark.search-hit'));

    sections.forEach(sec => sectionHits.set('#'+sec.id, sec.querySelectorAll('mark.search-hit').length));

    applyBadges(sectionHits);
    filterTOC(sectionHits, q);
    updateCounts(matchNodes.length);
    // İlk eşleşmeye kaydırma kaldırıldı.
  }
  const debouncedSearch = debounce(doSearch, 250);

  // ---------------- TOC tıklaması: vurguları temizle + aramayı sıfırla + bölüm başına git
  function gotoSectionFromTOC(anchorEl){
    const id = anchorEl.getAttribute('href');
    if (!id || id.length <= 1) return;

    clearHighlights(); resetBadgesAndFilter(); updateCounts(0);
    searchInputs.forEach(i => i && (i.value = ''));
    sessionStorage.removeItem('tuzukSearch');
    matchNodes = []; matchIndex = -1;

    const target = document.querySelector(id);
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (anchorEl.dataset.nav === 'mobile') {
        const offcanvasEl = document.getElementById('tocOffcanvas');
        const inst = offcanvasEl ? bootstrap.Offcanvas.getInstance(offcanvasEl) : null;
        if (inst) inst.hide();
      }
    }
  }

  // Dahili anchor’lar
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      const id = a.getAttribute('href');
      if (!id || id.length <= 1) return;
      const target = document.querySelector(id);
      if (!target) return;

      e.preventDefault();
      if (a.classList.contains('toc-link')) {
        // TOC linki: arama state’ini sıfırla ve bölüm başına git
        gotoSectionFromTOC(a);
      } else {
        // Normal iç link: yumuşak kaydırma
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // Klavye ile eşleşmeler arası gezinti
  searchInputs.forEach(inp=>{
    const saved = sessionStorage.getItem('tuzukSearch') || '';
    if (saved) inp.value = saved;
    inp.addEventListener('input', e => debouncedSearch(e.target.value));
    inp.addEventListener('keydown', e=>{
      if (e.key === 'Enter'){
        e.preventDefault();
        const q = (inp.value || '').trim();
        if (q.length < 2) return;
        if (!matchNodes.length) { doSearch(q); }
        if (!matchNodes.length) return;

        matchIndex = e.shiftKey
          ? (matchIndex <= 0 ? matchNodes.length - 1 : matchIndex - 1)
          : (matchIndex + 1) % matchNodes.length;

        matchNodes[matchIndex].scrollIntoView({ behavior:'smooth', block:'center' });
      }
    });
  });

  clearBtns.forEach(btn=>{
    btn.addEventListener('click', ()=>{
      searchInputs.forEach(i=> i && (i.value=''));
      sessionStorage.removeItem('tuzukSearch');
      clearHighlights(); resetBadgesAndFilter(); updateCounts(0);
      matchNodes = []; matchIndex = -1;
    });
  });

  // Aktif başlık takibi
  function setActiveFromSection(secEl) {
    if (!secEl) return;
    document.querySelectorAll('.toc-link.active, .toc-link[aria-current="true"]').forEach(l=>{
      l.classList.remove('active'); l.removeAttribute('aria-current');
    });
    const id  = '#'+secEl.id;
    const link= linkMap.get(id);
    if (link){
      link.classList.add('active');
      link.setAttribute('aria-current','true');
      const toc = document.getElementById('tocNav');
      if (toc && toc.contains(link)){
        link.scrollIntoView({ block:'nearest', behavior:'smooth' });
      }
    }
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        setActiveFromSection(entry.target);
        // Mobilde görünür olunca offcanvas kapalı kalır (elle kapatıyoruz).
      }
    });
  }, { root: null, rootMargin: '0px 0px -70% 0px', threshold: 0.1 });

  sections.forEach(sec => observer.observe(sec));
  if (sections.length) setActiveFromSection(sections[0]);
  if (location.hash) {
    const target = document.querySelector(location.hash);
    target && target.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Sayfa yüklenince: varsa önceki aramayı sadece vurgula (atlma yok)
  const initial = sessionStorage.getItem('tuzukSearch') || '';
  if (initial){ doSearch(initial); }

  // Başa dön butonu
  const btt = document.getElementById('backToTop');
  const toggleBtt=()=>{ if (window.scrollY>300) btt.classList.add('show'); else btt.classList.remove('show'); };
  window.addEventListener('scroll', toggleBtt, {passive:true});
  window.addEventListener('load', toggleBtt);
  btt.addEventListener('click', ()=> window.scrollTo({top:0, behavior:'smooth'}));
})();
</script>
