                    href="https://t.me/share/url?url=https%3A%2F%2Fwww.sanliurfagazetesi.com%2Fyeni-yolda-genel-baskanlik-gorevine-sanliurfa-eski-valisi-izzettin-kucuk-getirildi&text=Yeni+Yol%E2%80%99da+Genel+Ba%C5%9Fkanl%C4%B1k+G%C3%B6revine+%C5%9Eanl%C4%B1urfa+Eski+Valisi+%C4%B0zzettin+K%C3%BC%C3%A7%C3%BCk+Getirildi"
                    class="dropdown-item"
                    onclick="initiateDesktopShare(event, 'telegram')"
                    data-platform="telegram"
                    data-share-url="https://www.sanliurfagazetesi.com/yeni-yolda-genel-baskanlik-gorevine-sanliurfa-eski-valisi-izzettin-kucuk-getirildi"
                    data-share-title="Yeni Yol’da Genel Başkanlık Görevine Şanlıurfa Eski Valisi İzzettin Küçük Getirildi"
                    rel="noreferrer nofollow noopener external"
                    title="Telegram"
                >
                    <i class="fab fa-telegram-plane text-primary me-2"></i>Telegram
                </a>
