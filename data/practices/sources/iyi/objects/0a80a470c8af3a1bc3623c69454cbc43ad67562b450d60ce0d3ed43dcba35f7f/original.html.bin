	<section class="side-box-03" id="side-tabpanel-1" role="tabpanel" aria-labelledby="side-tab-1">
					<div class="post-view-1">
				<a href="/guncel-haberler/sariyerde-aranan-aslan-icin-iraktan-destek-tedirgin-etmeden-bulunabilir-2085751">
					<div class="t">Sarıyer'de aranan aslan için Irak'tan destek: "Tedirgin etmeden bulunabilir"</div>
					<div class="imgc">
						<img class="lazy" loading="lazy" src="https://cdn.karar.com/news/1949663.jpg" alt="Sarıyer&#039;de aranan aslan için Irak&#039;tan destek: &quot;Tedirgin etmeden bulunabilir&quot;"/>
					</div>
					<div class="t2">Güncel</div>
				</a>
