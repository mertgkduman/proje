<div class="fr-group">
<label for="frEmail">E-posta <span class="fr-req">*</span></label>
<input type="email" id="frEmail" name="Email" maxlength="150" autocomplete="email" required />
</div>
</div>
<div class="fr-group">
<label for="frSubject">Konu <span class="fr-req">*</span></label>
<input type="text" id="frSubject" name="Title" maxlength="200" placeholder="Örn. Haberde tarih hatası" required />
</div>
<div class="fr-group">
<label for="frDescription">Açıklama</label>
<textarea id="frDescription" name="Description" maxlength="2000" placeholder="İsterseniz hatayı kısaca anlatın"></textarea>
</div>
<div class="fr-group">
<label for="frImage">Görsel</label>
<div class="fr-upload">
<input type="file" id="frImage" name="image" accept="image/jpeg,image/png" />
<div class="fr-upload__preview" data-feedback-report-preview hidden>
<img alt="Seçilen görsel" />
<button type="button" class="fr-upload__remove" data-feedback-report-remove-image aria-label="Görseli kaldır">&times;</button>
</div>
</div>
<small class="fr-hint">İsteğe bağlı. JPG veya PNG, en fazla 3 MB.</small>
</div>
<label class="fr-check fr-consent">
<input type="checkbox" name="IsConsentGiven" value="true" required />
<span><a href="/kisisel-verilerin-korunmasi" target="_blank" rel="noopener">KVKK Aydınlatma Metni</a>'ni okudum, kişisel verilerimin bildirimimin değerlendirilmesi amacıyla işlenmesini kabul ediyorum. <span class="fr-req">*</span></span>
</label>
<div class="fr-captcha" data-feedback-report-captcha></div>
<p class="fr-message" data-feedback-report-message role="status" aria-live="polite"></p>
<div class="fr-actions">
<button type="button" class="fr-btn fr-btn--back" data-feedback-report-close>İptal</button>
<button type="submit" class="fr-btn fr-btn--primary">Gönder</button>
</div>
</form>
</div>
</div>
</div>
<style>#feedbackReportRoot .fr-overlay{position:fixed;inset:0;z-index:1000000;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(0,0,0,.55);}#feedbackReportRoot .fr-overlay[hidden]{display:none;}#feedbackReportRoot .fr-modal{position:relative;width:100%;max-width:560px;max-height:calc(100vh - 32px);overflow-y:auto;padding:24px;background:#fff;color:#222;border-radius:10px;box-shadow:0 12px 40px rgba(0,0,0,.3);font-size:14px;line-height:1.5;text-align:left;}#feedbackReportRoot .fr-close{position:absolute;top:10px;right:12px;width:32px;height:32px;border:0;background:none;font-size:26px;line-height:1;color:#666;cursor:pointer;}#feedbackReportRoot .fr-title{margin:0 0 6px;font-size:20px;font-weight:700;}#feedbackReportRoot .fr-intro{margin:0 0 18px;color:#555;}#feedbackReportRoot .fr-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}#feedbackReportRoot .fr-group{display:flex;flex-direction:column;gap:4px;margin-bottom:12px;}#feedbackReportRoot .fr-group label{font-weight:600;}#feedbackReportRoot .fr-req{color:#cc181c;}#feedbackReportRoot .fr-group input,#feedbackReportRoot .fr-group textarea{width:100%;padding:9px 11px;font:inherit;color:#222;background:#fff;border:1px solid #d6d6d6;border-radius:6px;}#feedbackReportRoot .fr-group textarea{min-height:90px;resize:vertical;}#feedbackReportRoot .fr-group input:focus,#feedbackReportRoot .fr-group textarea:focus{outline:none;border-color:#cc181c;box-shadow:0 0 0 3px rgba(204,24,28,.12);}#feedbackReportRoot .fr-upload{display:flex;align-items:center;gap:12px;flex-wrap:wrap;}#feedbackReportRoot .fr-upload input[type=file]{flex:1;min-width:0;padding:7px;border:1px dashed #c8c8c8;cursor:pointer;}#feedbackReportRoot .fr-upload__preview{position:relative;flex-shrink:0;width:96px;height:64px;background:#f3f3f3;border:1px solid #e2e2e2;border-radius:6px;}#feedbackReportRoot .fr-upload__preview[hidden]{display:none;}#feedbackReportRoot .fr-upload__preview img{width:100%;height:100%;object-fit:cover;border-radius:6px;}#feedbackReportRoot .fr-upload__remove{position:absolute;top:-8px;right:-8px;width:22px;height:22px;padding:0;border:0;border-radius:50%;background:#222;color:#fff;font-size:15px;line-height:22px;cursor:pointer;}#feedbackReportRoot .fr-hint{color:#777;font-size:12px;}#feedbackReportRoot .fr-check{display:flex;align-items:flex-start;gap:8px;cursor:pointer;}#feedbackReportRoot .fr-check input{margin-top:3px;flex-shrink:0;width:16px;height:16px;accent-color:#cc181c;}#feedbackReportRoot .fr-consent{margin-bottom:8px;color:#444;}#feedbackReportRoot .fr-consent a{color:#cc181c;text-decoration:underline;}#feedbackReportRoot .fr-captcha{min-height:78px;margin-bottom:8px;}#feedbackReportRoot .fr-message{min-height:20px;margin:0 0 8px;color:#cc181c;}#feedbackReportRoot .fr-message.is-success{color:#1e7b34;}#feedbackReportRoot .fr-actions{display:flex;justify-content:flex-end;gap:10px;}#feedbackReportRoot .fr-btn{min-width:110px;padding:9px 18px;border:0;border-radius:6px;font-weight:600;cursor:pointer;}#feedbackReportRoot .fr-btn[disabled]{opacity:.6;cursor:default;}#feedbackReportRoot .fr-btn--back{background:#eee;color:#222;}#feedbackReportRoot .fr-btn--primary{background:#cc181c;color:#fff;}@media (max-width:575px){#feedbackReportRoot .fr-row{grid-template-columns:1fr;gap:0;}#feedbackReportRoot .fr-modal{padding:20px 16px;}}</style>
<script>(function () {var root =document.getElementById("feedbackReportRoot");if (!root) return;var MAX_IMAGE_BYTES =3 *1024 *1024;var overlay =root.querySelector(".fr-overlay");var form =root.querySelector("#feedbackReportForm");var imageInput =root.querySelector("#frImage");var preview =root.querySelector("[data-feedback-report-preview]");var previewImg =preview.querySelector("img");var message =root.querySelector("[data-feedback-report-message]");var submitButton =form.querySelector("button[type=submit]");var pageUrl ="";var lastFocus =null;var captchaHost =root.querySelector("[data-feedback-report-captcha]");var siteKey =root.getAttribute("data-recaptcha-site-key");var captchaPromise =null;var captchaWidgetId =null;function loadRecaptcha() {if (window.grecaptcha &&window.grecaptcha.render) return Promise.resolve(window.grecaptcha);if (!captchaPromise) {captchaPromise =new Promise(function (resolve,reject) {window.__frRecaptchaOnload =function () {resolve(window.grecaptcha);};var s =document.createElement("script");s.src ="https://www.google.com/recaptcha/api.js?hl=tr&render=explicit&onload=__frRecaptchaOnload";s.async =true;s.onerror =function () {captchaPromise =null;reject(new Error("reCAPTCHA yüklenemedi"));};document.head.appendChild(s);});}
return captchaPromise;}
function ensureCaptcha() {if (!siteKey) return;loadRecaptcha().then(function (g) {if (captchaWidgetId ===null) captchaWidgetId =g.render(captchaHost,{sitekey:siteKey });}).catch(function () {setMessage("Doğrulama yüklenemedi, sayfayı yenileyip tekrar deneyin.");});}
function getCaptchaResponse() {return captchaWidgetId !==null &&window.grecaptcha ?window.grecaptcha.getResponse(captchaWidgetId) :"";}
 function resetCaptcha() {if (captchaWidgetId !==null &&window.grecaptcha) window.grecaptcha.reset(captchaWidgetId);}
function clearImage() {imageInput.value ="";if (previewImg.src) URL.revokeObjectURL(previewImg.src);previewImg.removeAttribute("src");preview.hidden =true;}
imageInput.addEventListener("change",function () {var file =imageInput.files &&imageInput.files[0];setMessage("");if (!file) {clearImage();return;}
if (file.type !=="image/jpeg" &&file.type !=="image/png") {clearImage();setMessage("Sadece JPG veya PNG görsel yükleyebilirsiniz.");return;}
if (file.size >MAX_IMAGE_BYTES) {clearImage();setMessage("Görsel en fazla 3 MB olabilir.");return;}
if (previewImg.src) URL.revokeObjectURL(previewImg.src);previewImg.src =URL.createObjectURL(file);preview.hidden =false;});function setMessage(text,isSuccess) {message.textContent =text ||"";message.classList.toggle("is-success",!!isSuccess);}
function open() {lastFocus =document.activeElement;pageUrl =window.location.href;setMessage("");overlay.hidden =false;document.documentElement.style.overflow ="hidden";form.querySelector("#frFullName").focus();ensureCaptcha();}
function close() {overlay.hidden =true;document.documentElement.style.overflow ="";if (lastFocus &&lastFocus.focus) lastFocus.focus();}
document.addEventListener("click",function (e) {var opener =e.target.closest("[data-feedback-report-open]");if (opener) {e.preventDefault();open();return;}
if (e.target.closest("[data-feedback-report-remove-image]")) {clearImage();return;}
if (e.target.closest("[data-feedback-report-close]") ||e.target ===overlay) close();});document.addEventListener("keydown",function (e) {if (e.key ==="Escape" &&!overlay.hidden) close();});form.addEventListener("submit",async function (e) {e.preventDefault();if (!form.checkValidity()) {var firstInvalid =form.querySelector(":invalid");setMessage(firstInvalid &&firstInvalid.type ==="checkbox"
?"Devam etmek için onay vermeniz gerekiyor."
:"Lütfen zorunlu alanları doğru şekilde doldurun.");if (firstInvalid) firstInvalid.focus();return;}
if (!getCaptchaResponse()) {setMessage("Lütfen robot olmadığınızı doğrulayın.");return;}
 var data =new FormData(form);data.append("PageUrl",pageUrl);submitButton.disabled =true;setMessage("Gönderiliyor…",true);try {var response =await fetch(form.action,{method:"POST",body:data });var result =await response.json().catch(function () {return {};});if (response.ok) {setMessage(result.message ||"Bildiriminiz alındı, teşekkür ederiz.",true);form.reset();clearImage();setTimeout(close,1800);} else if (response.status ===429) {setMessage("Çok fazla bildirim gönderdiniz, lütfen biraz sonra tekrar deneyin.");} else {setMessage(result.message ||"Bildirim gönderilemedi.");}
} catch (err) {setMessage("Beklenmeyen bir hata oluştu.");} finally {resetCaptcha();submitButton.disabled =false;}
});})();</script>
