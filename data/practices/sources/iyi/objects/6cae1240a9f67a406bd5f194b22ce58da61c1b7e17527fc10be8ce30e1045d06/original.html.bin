"position:relative!important;width:100%;height:auto!important;aspect-ratio:16/9!important;" +
"overflow:hidden!important;background:#000!important;padding:0!important;min-height:0!important;display:block!important;" +
"}" +
sel + " > video{" +
"position:absolute!important;top:0!important;left:0!important;right:0!important;bottom:0!important;" +
"width:100%!important;height:100%!important;max-height:none!important;object-fit:contain!important;" +
