"position:absolute!important;top:0!important;left:0!important;width:100%!important;height:100%!important;" +
"}" +
sel + " .adContainer > div," + sel + " .adContainer iframe," + sel + " .adContainer > video{" +
"max-width:100%!important;max-height:100%!important;" +
"}";var s =document.createElement("style");s.id ="gunun-ozeti-style";s.textContent =css;(document.head ||document.documentElement).appendChild(s);}
function getCookie(name) {var m =document.cookie.match("(?:^|; )" + name.replace(/([.$?*|{}()\[\]\\\/\+^])/g,"\\$1") + "=([^;]*)");return m ?decodeURIComponent(m[1]) :null;}
function absUrl(u) {try {return new URL(u,location.origin).href;} catch (e) {return location.href;}
}
function catFromUrl(u) {try {var seg =new URL(u,location.origin).pathname.split("/").filter(Boolean);return seg[0] ||CONFIG.defaultCategory;} catch (e) {return CONFIG.defaultCategory;}
}
function articleUrl(el) {var d =el.getAttribute("data-url");if (d) return absUrl(d);var m =el.querySelector("[data-url]");if (m &&m.getAttribute("data-url")) return absUrl(m.getAttribute("data-url"));return location.href;}
function articleTitle(el) {var d =el.getAttribute("data-title");if (d) return d;var h =el.querySelector("h1");if (h &&h.textContent.trim()) return h.textContent.trim();return document.title ||CONFIG.defaultTitle;}
var pending =[];var loading =false;function ensureAdLib(cb) {if (typeof window.video_ad ==="function") {cb();return;}
pending.push(cb);if (loading) return;loading =true;var startAdScript =function () {var s =document.createElement("script");s.src =CONFIG.adScriptSrc;s.onload =function () {var q =pending.slice();pending.length =0;q.forEach(function (f) {try {f();} catch (e) {} });};document.head.appendChild(s);};if (window.google &&window.google.ima) {startAdScript();} else {var ima =document.createElement("script");ima.src =CONFIG.imaSrc;ima.onload =startAdScript;document.head.appendChild(ima);}
}
function videoHtml(vid) {return '<div class="article-recommended">' +
'<div class="article-recommended__header">G&Uuml;N&Uuml;N &Ouml;ZET&#304;</div>' +
'<div class="article-recommended__item video_content" data-stick-after-seen="1" style="position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;background:#000;">' +
'<video id="contentElement-' + vid + '" class="video-player" width="100%" height="auto" muted controls controlsList="nodownload" playsinline preload="metadata" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:contain;">' +
'<source src="' + CONFIG.videoBase + '?p=' + dateParam() + '" type="video/mp4"></video>' +
'<div id="playButton-' + vid + '"></div>' +
'<div id="adContainer-' + vid + '" class="adContainer" data-bik-reklam="true" data-bik-reklam-id="adContainer' + String(vid).replace(/[^A-Za-z0-9]/g,'') + '"></div>' +
'</div></div>';}
function insertVideo(articleEl,vid) {var body =articleEl.querySelector(CONFIG.bodySelector);if (!body) return false;var ps =Array.prototype.filter.call(body.children,function (el) {return el.tagName ==="P";});if (!ps.length) return false;var html =videoHtml(vid);if (ps.length >=CONFIG.insertAfterParagraph) {ps[CONFIG.insertAfterParagraph - 1].insertAdjacentHTML("afterend",html);} else {ps[ps.length - 1].insertAdjacentHTML("afterend",html);}
return true;}
 
 function wire(vid,articleEl) {var url =articleUrl(articleEl);var title =articleTitle(articleEl);var category =catFromUrl(url);ensureAdLib(function () {if (typeof window.video_ad ==="function") {try {window.video_ad(vid,url,title,category);} catch (e) {}
}
var el =document.getElementById("contentElement-" + vid);if (typeof window.respondToVisibilityVideo ==="function" &&el) {window.respondToVisibilityVideo(el,function () {});el.onplaying =function () {window.son_aktif_video ="contentElement-" + vid;};el.onpause =function () {window.son_aktif_video ="";};}
});}
var seen =Object.create(null);var idSeed =999900;function autoId(articleEl) {var explicit =articleEl.getAttribute("data-id");if (explicit) return explicit;return String(++idSeed);}
function scan() {if (CONFIG.respectSubscribeCookie &&getCookie("IsSubscribe")) return;var articles =document.querySelectorAll(CONFIG.articleSelector);for (var i =0;i < articles.length;i++) {var a =articles[i];var key =a.getAttribute("data-id") ||a.id ||a.getAttribute("data-url") ||String(i);if (seen[key]) continue;seen[key] =true;if (a.querySelector(CONFIG.gallerySelector)) continue;if (a.querySelector("video")) continue;var vid =autoId(a);if (insertVideo(a,vid)) wire(vid,a);}
}
injectStyle();if (document.readyState ==="loading") {document.addEventListener("DOMContentLoaded",scan);} else {scan();}
window.addEventListener("load",scan);if (window.MutationObserver) {var mo =new MutationObserver(function () {scan();});mo.observe(document.body,{childList:true,subtree:true });}
})();</script>
<script>(function () {"use strict";var CONFIG ={selector:".video_content",articleSelector:'[id="content"], [id^="content-"]',refRatio:0.5,topOffset:0,desktopWidth:360,showCloseButton:true,stickOnlyWhenPlaying:false,stickWhenBelow:true,stickAfterSeen:true,debug:false
};var stuck =null;var placeholder =null;var dismissed =new WeakSet();var seen =new WeakSet();var ticking =false;function injectStyle() {if (document.getElementById("sticky-video-style")) return;var css =".video_content.is-sticky{" +
