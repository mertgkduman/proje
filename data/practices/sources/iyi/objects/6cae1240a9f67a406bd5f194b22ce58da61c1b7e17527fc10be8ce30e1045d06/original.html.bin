<script>let defaultFontSize =20;function adjustFontSize(event,action) {const paragraphs =document.querySelectorAll(".article-content > p");if (!paragraphs.length) {return;}
paragraphs.forEach(paragraph =>{let currentFontSize =parseInt(window.getComputedStyle(paragraph).fontSize) ||defaultFontSize;if (action ==='-') {currentFontSize =Math.max(12,currentFontSize - 2);} else if (action ==='+') {currentFontSize =Math.min(28,currentFontSize + 2);}
paragraph.style.fontSize =`${currentFontSize}px`;});}
</script>
<script>(function () {"use strict";var CONFIG ={articleSelector:'[id="content"], [id^="content-"]',bodySelector:".article-content",gallerySelector:".fotohaber-content, .photoLine, .fotohaber",videoBase:"https://v.turkiyegazetesi.com.tr/gunun-ozeti/gunun_ozeti.mp4",imaSrc:"https://imasdk.googleapis.com/js/sdkloader/ima3.js",adScriptSrc:"https://s.turkiyegazetesi.com.tr/s/js/video_ad.js?v=85ca959f-f009-48",insertAfterParagraph:4,respectSubscribeCookie:false,defaultCategory:"gundem",defaultTitle:"Gunun ozeti",debug:false
};function dateParam() {var n =new Date();return n.getFullYear().toString() +
