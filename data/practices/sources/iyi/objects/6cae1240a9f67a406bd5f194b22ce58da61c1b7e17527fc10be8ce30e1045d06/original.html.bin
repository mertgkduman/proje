function isPlaying(box) {var v =box.querySelector("video");return !!(v &&!v.paused &&!v.ended &&v.currentTime >0);}
function notifyResize() {var fire =function () {var ev;try {ev =new Event("resize");}
catch (e) {ev =document.createEvent("Event");ev.initEvent("resize",true,true);}
window.dispatchEvent(ev);};window.requestAnimationFrame(fire);setTimeout(fire,60);setTimeout(fire,250);}
function flowRect(box) {if (box ===stuck &&placeholder) return placeholder.getBoundingClientRect();return box.getBoundingClientRect();}
function stick(box) {if (stuck ===box) return;if (stuck) unstick();var rect =box.getBoundingClientRect();placeholder =document.createElement("div");placeholder.setAttribute("data-sticky-placeholder","1");placeholder.style.height =rect.height + "px";box.parentNode.insertBefore(placeholder,box);box.classList.add("is-sticky");if (CONFIG.showCloseButton &&!box.querySelector(".sticky-video-close")) {var btn =document.createElement("button");btn.className ="sticky-video-close";btn.type ="button";btn.setAttribute("aria-label","Kapat");btn.innerHTML ="&times;";btn.addEventListener("click",function (e) {e.stopPropagation();dismissed.add(box);unstick();});box.appendChild(btn);}
stuck =box;notifyResize();}
function unstick() {if (!stuck) return;stuck.classList.remove("is-sticky");var btn =stuck.querySelector(".sticky-video-close");if (btn &&btn.parentNode) btn.parentNode.removeChild(btn);if (placeholder &&placeholder.parentNode) placeholder.parentNode.removeChild(placeholder);placeholder =null;stuck =null;notifyResize();}
function currentArticle(ref) {var blocks =document.querySelectorAll(CONFIG.articleSelector);if (!blocks.length) return undefined;var best =null,bestTop =-Infinity;var nextBelow =null,nextTop =Infinity;for (var i =0;i < blocks.length;i++) {var top =blocks[i].getBoundingClientRect().top;if (top <=ref) {if (top >bestTop) {bestTop =top;best =blocks[i];}
} else if (top < nextTop) {nextTop =top;nextBelow =blocks[i];}
}
return best ||nextBelow;}
var warnedNoBlocks =false;function fallbackDesired(vh) {if (CONFIG.debug &&!warnedNoBlocks) {warnedNoBlocks =true;console.warn('[sticky-video] articleSelector "' + CONFIG.articleSelector +
'" hic eleman bulamadi; eski mantiga dusuluyor. Haberi saran elemanin id/class degerini CONFIG.articleSelector ile guncelle.');}
var boxes =document.querySelectorAll(CONFIG.selector);var desired =null,bestBottom =-Infinity;for (var i =0;i < boxes.length;i++) {var r =flowRect(boxes[i]);if (r.bottom >CONFIG.topOffset &&r.top < vh) dismissed.delete(boxes[i]);if (dismissed.has(boxes[i])) continue;if (r.bottom <=CONFIG.topOffset &&r.bottom >bestBottom) {bestBottom =r.bottom;desired =boxes[i];}
}
return desired;}
function markSeen(vh) {var boxes =document.querySelectorAll(CONFIG.selector);for (var i =0;i < boxes.length;i++) {var r =flowRect(boxes[i]);if (r.bottom >CONFIG.topOffset &&r.top < vh) seen.add(boxes[i]);}
}
function update() {ticking =false;var vh =window.innerHeight;var ref =CONFIG.topOffset + (vh - CONFIG.topOffset) *CONFIG.refRatio;markSeen(vh);var article =currentArticle(ref);var desired =null;if (article ===undefined) {desired =fallbackDesired(vh);} else if (article) {var box =article.querySelector(CONFIG.selector);if (box) {var r =flowRect(box);if (r.bottom >CONFIG.topOffset &&r.top < vh) dismissed.delete(box);var blocked =dismissed.has(box) ||(CONFIG.stickOnlyWhenPlaying &&box !==stuck &&!isPlaying(box));var above =r.bottom <=CONFIG.topOffset;var below =r.top >=vh;var mustSee =CONFIG.stickAfterSeen ||box.hasAttribute("data-stick-after-seen");var belowOk =!mustSee ||seen.has(box);var wantStick =above ||(CONFIG.stickWhenBelow &&below &&belowOk);if (!blocked &&wantStick) desired =box;}
if (CONFIG.debug) {console.log('[sticky-video] aktif haber:',article.id ||article.className,'| video:',!!box,'| sticky:',!!desired);}
}
if (desired !==stuck) {if (desired) stick(desired);else unstick();}
}
function schedule() {if (!ticking) {ticking =true;window.requestAnimationFrame(update);}
}
function init() {injectStyle();window.addEventListener("scroll",schedule,{passive:true });window.addEventListener("resize",schedule,{passive:true });window.addEventListener("load",schedule);if (window.MutationObserver) {new MutationObserver(schedule).observe(document.body,{childList:true,subtree:true });}
update();setTimeout(schedule,300);}
if (document.readyState ==="loading") {document.addEventListener("DOMContentLoaded",init);} else {init();}
})();</script>
<script>async function loadComponent(name,uniqueSuffix ="",articleId =null,tagId =null) {let url =`/components/${name}`;const urlParams =new URLSearchParams(window.location.search);const hasNoCache =urlParams.has('nocache');const lowerName =name.toLowerCase();if (lowerName ==="comments") {url =`/components/comments?articleId=${articleId}`;} else if (lowerName ==="headlineslider") {url =`/components?name=headlineslider`;} else if (lowerName ==="mostreadnews") {url =`/components?name=mostreadnews&wrapperCss=detail-sidebar`;} else if (lowerName ==="dontmissit") {url =`/components?name=dontmissit&articleId=${articleId}`;} else if (lowerName ==="highlights") {url =`/components/highlights?articleId=${articleId}`;}
if (hasNoCache) {const separator =url.includes('?') ?'&' :'?';url +=`${separator}nocache=1`;}
try {const response =await fetch(url);if (!response.ok) return;const html =await response.text();let contentContainerId ="";if (lowerName ==="headlineslider") contentContainerId ="headlineSliderContainer" + uniqueSuffix;else if (lowerName ==="comments") contentContainerId ="reviewsContainer" + uniqueSuffix;else if (lowerName ==="mostreadnews") contentContainerId ="popularNewsContainer" + uniqueSuffix;else if (lowerName ==="dontmissit") contentContainerId ="dontMissItContainer" + uniqueSuffix;else if (lowerName ==="highlights") contentContainerId ="highlightsContainer" + uniqueSuffix;const container =document.getElementById(contentContainerId);if (!container) return;container.innerHTML =html;container.classList.remove('most-read-skeleton');container.querySelectorAll('script').forEach(function(oldScript) {const newScript =document.createElement('script');if (oldScript.src) {newScript.src =oldScript.src;} else {newScript.textContent =oldScript.textContent;}
oldScript.parentNode.replaceChild(newScript,oldScript);});if (lowerName ==="comments") {if (typeof loadMoreComments ==='function') loadMoreComments(container);if (typeof sortComments ==='function') sortComments(container);}
if (typeof Imageslazy ==='function') {Imageslazy();}
if (typeof initSaveItemButtons ==='function') {initSaveItemButtons();}
if (typeof initListSaveButtons ==='function') {initListSaveButtons();}
 if (typeof window.statsBindLinks ==='function') {window.statsBindLinks(container);}
} catch (error) {console.error(`${name} bileşeni yüklenemedi:`,error);}
}
async function loadAllComponents(uniqueSuffix ="",articleId =null,tagId =null) {await Promise.allSettled([loadComponent("headlineslider",uniqueSuffix,articleId,tagId),loadComponent("mostreadnews",uniqueSuffix,articleId,tagId),articleId ?loadComponent("comments",uniqueSuffix,articleId,tagId) :Promise.resolve(),articleId ?loadComponent("dontmissit",uniqueSuffix,articleId,tagId) :Promise.resolve(),articleId ?loadComponent("highlights",uniqueSuffix,articleId,tagId) :Promise.resolve()
]);}
window.loadComponent =loadComponent;window.loadAllComponents =loadAllComponents;function initAboveTheFold() {const articleId =966200;const tagId =2;loadComponent("mostreadnews","",articleId,tagId);}
if (document.readyState ==="loading") {document.addEventListener("DOMContentLoaded",initAboveTheFold);} else {initAboveTheFold();}
 window.addEventListener("load",() =>{const articleId =966200;const tagId =2;Promise.allSettled([loadComponent("headlineslider","",articleId,tagId),articleId ?loadComponent("comments","",articleId,tagId) :Promise.resolve(),articleId ?loadComponent("dontmissit","",articleId,tagId) :Promise.resolve(),articleId ?loadComponent("highlights","",articleId,tagId) :Promise.resolve()
]);});window.initLiveBlog =function () {document.querySelectorAll('.js-live-content').forEach(function (content) {var box =content.closest('.news-live-box');var btn =box.querySelector('.js-live-readmore');if (!btn ||btn.dataset.liveBound) return;btn.dataset.liveBound ='1';if (content.scrollHeight >content.offsetHeight) {content.classList.add('is-collapsed');btn.style.display ='inline-flex';}
btn.addEventListener('click',function () {var expanded =box.classList.toggle('expanded');content.classList.toggle('is-collapsed',!expanded);btn.querySelector('.readmore-text').textContent =expanded ?'Daha az gör' :'Devamını gör';});});}
if (document.readyState ==='complete') {window.initLiveBlog();} else {window.addEventListener('load',window.initLiveBlog);}
document.addEventListener('DOMContentLoaded',function () {loadMoreComments();sortComments();const articleContent =document.querySelector(".article-content");if (articleContent) {convertMediaLinks(articleContent);}
document.querySelectorAll('.vote-btn').forEach(btn =>{btn.addEventListener('click',function handleVote() {const surveyId =this.id.replace('voteBtn-','');const pollDiv =document.querySelector(`.article-poll[data-survey-id='${surveyId}']`);if (pollDiv.submitted) {return;}
const questionHeader =pollDiv.querySelector('.article-poll__question');const form =document.getElementById(`surveyForm-${surveyId}`);const selectedOption =form.querySelector('input[type="radio"]:checked');if (!pollDiv.remainingQuestions) {const hiddenDiv =document.querySelector(`.hidden-questions[data-survey-id='${surveyId}']`);pollDiv.remainingQuestions =JSON.parse(hiddenDiv.textContent);pollDiv.answers =[];}
let remainingQuestions =pollDiv.remainingQuestions;const currentQuestion =remainingQuestions[0];const isRequired =currentQuestion ?currentQuestion.IsRequired :true;if (isRequired &&!selectedOption) {alert("Lütfen bir seçenek işaretleyin.");return;}
if (currentQuestion &&selectedOption) {pollDiv.answers.push({surveyId:surveyId,questionId:currentQuestion.QuestionId,optionId:parseInt(selectedOption.value),userAgent:navigator.userAgent,answerText:null,submittedAt:new Date().toISOString()
});}
remainingQuestions.shift();if (remainingQuestions.length ===0) {pollDiv.querySelector('.article-poll__thanks').style.display ='block';pollDiv.submitted =true;fetch("/home/create-survey-response",{method:'POST',headers:{'Content-Type':'application/json','RequestVerificationToken':document.querySelector('input[name="__RequestVerificationToken"]')?.value
},body:JSON.stringify(pollDiv.answers)
}).then(res =>res.json());return;}
const nextQuestion =remainingQuestions[0];questionHeader.textContent =nextQuestion.QuestionText;let optionsHTML ='';nextQuestion.Options.sort((a,b) =>a.SortOrder - b.SortOrder).forEach(opt =>{optionsHTML +=`
<label class='article-poll__option'><input type='radio' name='vote-${nextQuestion.QuestionId}' value='${opt.OptionId}'><span class='custom-radio'></span><span class='label-text'>${opt.OptionText}</span></label>`;});form.innerHTML =optionsHTML +
`<button type='button' class='btn vote-btn' id='voteBtn-${surveyId}'>Oy Ver</button>`;form.querySelector('.vote-btn').addEventListener('click',handleVote);});});});document.addEventListener('click',function (e) {const sendBtn =e.target.closest('.comments__send-btn');if (!sendBtn) return;const inputArea =sendBtn.closest('.comments__input-area');if (!inputArea) return;const textarea =inputArea.querySelector('.comments__textarea');const articleId =parseInt(inputArea.dataset.articleId ||"0",10);const parentReviewId =inputArea.dataset.parentReviewId ?parseInt(inputArea.dataset.parentReviewId,10) :null;addReview(textarea,articleId,parentReviewId);});document.addEventListener('keydown',function (e) {if (e.key ==="Enter" &&!e.shiftKey) {const textarea =e.target.closest('.comments__input-area .comments__textarea');if (!textarea) return;const inputArea =textarea.closest('.comments__input-area');if (!inputArea) return;e.preventDefault();const articleId =parseInt(inputArea.dataset.articleId ||"0",10);const parentReviewId =inputArea.dataset.parentReviewId ?parseInt(inputArea.dataset.parentReviewId,10) :null;addReview(textarea,articleId,parentReviewId);}
});document.addEventListener('click',function (e) {const replyBtn =e.target.closest('.comment__action-btn.comment__reply');if (!replyBtn) return;const li =replyBtn.closest('li.comment');if (!li) return;toggleReplyBox(li);});document.addEventListener('click',async function (e) {const sendBtn =e.target.closest('.comments__reply-area .comments__send-btn');if (sendBtn) {const replyArea =sendBtn.closest('.comments__reply-area');const textarea =replyArea.querySelector('.comments__textarea');const articleId =parseInt(replyArea.dataset.articleId ||'0',10);const parentReviewId =parseInt(replyArea.dataset.parentReviewId ||'0',10);const ok =await addReview(textarea,articleId,parentReviewId);if (ok) replyArea.remove();return;}
const cancelBtn =e.target.closest('.comments__cancel-reply-btn');if (cancelBtn) {cancelBtn.closest('.comments__reply-area')?.remove();return;}
});document.addEventListener('keydown',async function (e) {const ta =e.target;if (!(ta instanceof HTMLTextAreaElement)) return;if (!ta.closest('.comments__reply-area')) return;if (e.key ==='Enter' &&!e.shiftKey) {e.preventDefault();const replyArea =ta.closest('.comments__reply-area');const articleId =parseInt(replyArea.dataset.articleId ||'0',10);const parentReviewId =parseInt(replyArea.dataset.parentReviewId ||'0',10);const ok =await addReview(ta,articleId,parentReviewId);if (ok) replyArea.remove();}
});document.addEventListener('click',function (e) {const rc =e.target.closest('.comment__reply-count');if (!rc) return;const li =rc.closest('li.comment');const replies =li?.querySelector('.comments__replies');if (!replies) return;const isVisible =replies.style.display !=='none';replies.style.display =isVisible ?'none' :'';rc.classList.toggle('is-open',!isVisible);});if (!window.__tgCommentMoreBound) {window.__tgCommentMoreBound =true;document.addEventListener('click',function (e) {const moreBtn =e.target.closest('.comment__more-btn');if (!moreBtn) return;const textEl =moreBtn.closest('.comment__text');const shortEl =textEl?.querySelector('.comment__text-short');const fullEl =textEl?.querySelector('.comment__text-full');if (!shortEl ||!fullEl) return;const expand =moreBtn.getAttribute('aria-expanded') !=='true';shortEl.style.display =expand ?'none' :'';fullEl.style.display =expand ?'inline' :'none';moreBtn.setAttribute('aria-expanded',String(expand));moreBtn.textContent =expand ?'Daha Az Göster' :'Daha Fazla Göster';});}
document.addEventListener('click',async function (e) {const btn =e.target.closest('button.comment__action-btn.comment__like, button.comment__action-btn.comment__dislike');if (!btn) return;const action =btn.dataset.action;if (action !=='like' &&action !=='dislike') return;const li =btn.closest('li.comment');if (!li) return;const reviewId =parseInt(li.dataset.reviewId,10);if (!reviewId) return;if (li.dataset.loading ==="1") return;li.dataset.loading ="1";const likeBtn =li.querySelector('.comment__like');const dislikeBtn =li.querySelector('.comment__dislike');const likeActive =likeBtn?.classList.contains('is-active');const dislikeActive =dislikeBtn?.classList.contains('is-active');const clickedIsLike =(action ==='like');try {if ((clickedIsLike &&likeActive) ||(!clickedIsLike &&dislikeActive)) {const r1 =await postVote({reviewId,isLike:clickedIsLike,remove:true });likeBtn?.querySelector('.comment__action-count')?.replaceChildren(document.createTextNode(r1.voteLike ??0));dislikeBtn?.querySelector('.comment__action-count')?.replaceChildren(document.createTextNode(r1.voteDislike ??0));likeBtn?.classList.remove('is-active');dislikeBtn?.classList.remove('is-active');return;}
if ((clickedIsLike &&dislikeActive) ||(!clickedIsLike &&likeActive)) {likeBtn?.classList.remove('is-active');dislikeBtn?.classList.remove('is-active');try {const r1 =await postVote({reviewId,isLike:!clickedIsLike,remove:true });likeBtn?.querySelector('.comment__action-count')?.replaceChildren(document.createTextNode(r1.voteLike ??0));dislikeBtn?.querySelector('.comment__action-count')?.replaceChildren(document.createTextNode(r1.voteDislike ??0));} catch (err) {}
const r2 =await postVote({reviewId,isLike:clickedIsLike,remove:false });likeBtn?.querySelector('.comment__action-count')?.replaceChildren(document.createTextNode(r2.voteLike ??0));dislikeBtn?.querySelector('.comment__action-count')?.replaceChildren(document.createTextNode(r2.voteDislike ??0));if (clickedIsLike) {likeBtn?.classList.add('is-active');dislikeBtn?.classList.remove('is-active');} else {dislikeBtn?.classList.add('is-active');likeBtn?.classList.remove('is-active');}
return;}
const r =await postVote({reviewId,isLike:clickedIsLike,remove:false });likeBtn?.querySelector('.comment__action-count')?.replaceChildren(document.createTextNode(r.voteLike ??0));dislikeBtn?.querySelector('.comment__action-count')?.replaceChildren(document.createTextNode(r.voteDislike ??0));if (clickedIsLike) {likeBtn?.classList.add('is-active');dislikeBtn?.classList.remove('is-active');} else {dislikeBtn?.classList.add('is-active');likeBtn?.classList.remove('is-active');}
} catch (_) {} finally {li.dataset.loading ="0";}
});function loadMoreComments(targetContainer) {const root =targetContainer ||document;const list =root.querySelector('.comments__list');const moreWrap =root.querySelector('.comments__load-more');const moreBtn =root.querySelector('#comments-load-more') ||(moreWrap ?moreWrap.querySelector('button') :null);const limit =2;if (!list) return;if (!list.dataset.expanded) list.dataset.expanded ='0';function collapseToLimitLocal() {const items =getTopLevelItems(list);const expanded =list.dataset.expanded ==='1';let shown =0;items.forEach(li =>{if (expanded) {li.style.display ='';} else {if (shown < limit) {li.style.display ='';shown++;}
else {li.style.display ='none';}
}
});if (moreWrap) {moreWrap.style.display =(items.length <=limit ||expanded) ?'none' :'';}
}
collapseToLimitLocal();moreBtn?.addEventListener('click',function () {list.dataset.expanded ='1';collapseToLimitLocal();});}
async function addReview(textarea,articleId,parentReviewId) {if (!isLoggedIn()) {Swal.fire({icon:"info",title:"Giriş gerekli",text:"Yorum yapmak için giriş yapın.",confirmButtonText:"Tamam" });return false;}
const text =(textarea?.value ||"").trim();if (!text) {Swal.fire({icon:"info",title:"Yorum Boş Olamaz",text:"Lütfen bir şeyler yazın." });return false;}
try {const res =await fetch("/review/addreview",{method:"POST",credentials:"same-origin",headers:(window.tgCsrfHeaders
?window.tgCsrfHeaders({"Content-Type":"application/json" })
:{"Content-Type":"application/json" }),body:JSON.stringify({text,articleId,parentReviewId })
});if (res.status ===401) {Swal.fire({icon:"info",title:"Giriş gerekli",text:"Yorum yapmak için giriş yapın." });return false;}
const data =await res.json();if (!res.ok ||!data?.success) {if (res.status ===429) {Swal.fire({icon:"warning",title:"Uyarı",text:data?.message ||"Lütfen bir dakika bekleyip tekrar deneyin." });} else {Swal.fire({icon:"error",title:"Hata",text:data?.message ||"Yorum eklenemedi." });}
return false;}
textarea.value ="";Swal.fire({icon:"success",title:"Yorum alındı",text:"Yorumunuz onaylandıktan sonra görünecek.",confirmButtonText:"Tamam" });return true;} catch (err) {Swal.fire({icon:"error",title:"Hata",text:"Bir şeyler ters gitti." });return false;}
}
async function postVote(payload) {const res =await fetch("/review/vote",{method:"POST",credentials:"same-origin",headers:(window.tgCsrfHeaders
?window.tgCsrfHeaders({"Content-Type":"application/json" })
:{"Content-Type":"application/json" }),body:JSON.stringify(payload)
});if (res.status ===401) {Swal.fire({icon:"info",title:"Giriş gerekli",text:"Oy kullanmak için giriş yapmanız gerekiyor.",confirmButtonText:"Tamam" });}
const data =await res.json();if (!res.ok ||!data?.success) {Swal.fire({icon:"info",title:"Hata!",text:"Oy kullanırken bir hata oluştu.",confirmButtonText:"Tamam" });}
return data;}
function toggleReplyBox(li) {const existing =li.querySelector('.comments__reply-area');if (existing) {existing.remove();return;}
 const rootInputArea =li.closest('.comments')?.querySelector('.comments__input-area');const articleId =parseInt(rootInputArea?.dataset.articleId ||'0',10);if (!articleId) return;const parentId =parseInt(li.dataset.reviewId ||'0',10);const wrap =document.createElement('div');wrap.className ='comments__reply-area';wrap.setAttribute('data-article-id',String(articleId));wrap.setAttribute('data-parent-review-id',String(parentId));wrap.innerHTML =`
<div class="comments__form-scope" style="margin-top:8px; position:relative;"><textarea class="comments__textarea" rows="1" placeholder="Yanıtınızı yazın"></textarea><button type="button" class="comments__send-btn"><img src="https://s.turkiyegazetesi.com.tr/s/i/icon-comments-textarea-img.svg" alt="Gönder"></button><div class="comments__reply-actions" style="margin-top:6px;"><button type="button" class="comments__cancel-reply-btn">İptal</button></div></div>`;const actions =li.querySelector('.comment__actions');(actions?.parentNode)?.insertBefore(wrap,actions.nextSibling);}
function getRawCookie(name) {return document.cookie.split("; ").reduce((r,v) =>{const parts =v.split("=");return parts[0] ===name ?decodeURIComponent(parts[1]) :r;},null);}
function isLoggedIn() {return !!getRawCookie('userId');}
function sortComments(targetContainer) {const root =targetContainer ||document;const sortSelect =root.querySelector("#comments-sort") ||root.querySelector(".comments__sort-select");const list =root.querySelector(".comments__list");if (!sortSelect ||!list) return;sortSelect.addEventListener("change",function () {const items =getTopLevelItems(list);const value =this.value;if (value.includes("Yeni")) {items.sort((a,b) =>{const da =new Date(a.querySelector(".comment__time")?.dataset.datetime ||0);const db =new Date(b.querySelector(".comment__time")?.dataset.datetime ||0);return db - da;});} else if (value.includes("Eski")) {items.sort((a,b) =>{const da =new Date(a.querySelector(".comment__time")?.dataset.datetime ||0);const db =new Date(b.querySelector(".comment__time")?.dataset.datetime ||0);return da - db;});} else if (value.includes("Beğenilen")) {items.sort((a,b) =>{const la =parseInt(a.querySelector(".comment__like .comment__action-count")?.textContent.trim() ||"0",10);const lb =parseInt(b.querySelector(".comment__like .comment__action-count")?.textContent.trim() ||"0",10);return lb - la;});}
list.innerHTML ="";items.forEach(li =>list.appendChild(li));loadMoreComments(root);});}
function getTopLevelItems(listEl) {const list =listEl ||document.querySelector('.comments__list');return Array.from(list?.children ||[])
.filter(el =>el.classList?.contains('comment') &&!el.closest('.comments__replies'));}
function copyLink(url) {navigator.clipboard.writeText('https://www.turkiyegazetesi.com.tr' + url).then(() =>{alert("Bağlantı panoya kopyalandı!");}).catch(() =>{alert("Bağlantı kopyalanamadı!");});}
document.addEventListener("DOMContentLoaded",function () {document.querySelectorAll('.faq-item').forEach(item =>{const q =item.querySelector('.faq-question');q.addEventListener('click',() =>{const open =document.querySelector('.faq-item.active');if (open &&open !==item) {open.classList.remove('active');}
item.classList.toggle('active');});});});function convertMediaLinks(newsContent) {const links =newsContent.querySelectorAll("a");links.forEach(link =>{const url =link.href;if (!url) return;const videoId =getYouTubeVideoId(url);if (!videoId) return;const iframe =document.createElement("iframe");iframe.src ='https://www.youtube.com/embed/' + videoId;iframe.width ="100%";iframe.height ="360";iframe.frameBorder ="0";iframe.allowFullscreen =true;link.replaceWith(iframe);});}
function getYouTubeVideoId(url) {const match =url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|v\/|shorts\/))([\w-]{11})/);return match ?match[1] :null;}
</script>
