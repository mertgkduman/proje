"margin:0!important;padding:0!important;" +
"z-index:2147483647;background:#000;border-radius:8px;overflow:hidden;" +
"box-shadow:0 10px 30px rgba(0,0,0,.4);" +
"}" +
".video_content.is-sticky > video,.video_content.is-sticky video{" +
