    <section class="section two-articles bottom-spacer--s equalise-columns" data-vr-zone="DAHA FAZLA HABER OKU">
      <div class="view view-teaser-mode view-id-teaser_mode view-display-id-block_2 view-dom-id-71a7e86519843a71de235f6245e9158a">

        
  
  
      <div class="view-content">
