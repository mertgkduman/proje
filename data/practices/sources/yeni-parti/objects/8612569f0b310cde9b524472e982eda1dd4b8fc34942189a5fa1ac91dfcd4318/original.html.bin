        }
    </script>

    <script>
        (function(){
        const audio = document.getElementById('apAudio');
        const playBtn = document.getElementById('apPlay');
        const icon = document.getElementById('apIcon');
        const timeEl = document.getElementById('apTime');
        const fill = document.getElementById('apFill');
        const seek = document.getElementById('apSeek');
        const volWrap = document.getElementById('apVolWrap');
        const volPopup = document.getElementById('apVolPopup');
        const volIcon = document.getElementById('apVolIcon');
        const volInput = document.getElementById('apVol');
        const volPct = document.getElementById('apVolPct');
        const speedBtn = document.getElementById('apSpeed');

        const speeds = [1, 1.5, 2];
        let speedIdx = 0;
        audio.volume = 0.8;

        const PLAY = '<polygon points="6,3 20,12 6,21"/>';
        const PAUSE = '<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>';
        const VOL_ON = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/>';
        const VOL_LOW = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>';
        const VOL_OFF = '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/>';

        function fmt(s) {
            s = Math.floor(s || 0);
            return Math.floor(s/60) + ':' + (s%60 < 10 ? '0' : '') + (s%60);
        }

        playBtn.addEventListener('click', function() {
            if (audio.paused) { audio.play(); icon.innerHTML = PAUSE; }
            else { audio.pause(); icon.innerHTML = PLAY; }
        });

        audio.addEventListener('timeupdate', function() {
            if (!audio.duration) return;
            var pct = (audio.currentTime / audio.duration) * 100;
            fill.style.width = pct + '%';
            seek.value = pct;
            timeEl.textContent = fmt(audio.currentTime) + ' / ' + fmt(audio.duration);
        });

        audio.addEventListener('loadedmetadata', function() {
            timeEl.textContent = '0:00 / ' + fmt(audio.duration);
        });

        audio.addEventListener('ended', function() { icon.innerHTML = PLAY; });

        seek.addEventListener('input', function() {
            if (audio.duration) audio.currentTime = (seek.value / 100) * audio.duration;
        });

        volWrap.addEventListener('click', function(e) {
            if (e.target === volInput) return;
            volPopup.classList.toggle('open');
        });

        document.addEventListener('click', function(e) {
            if (!volWrap.contains(e.target)) volPopup.classList.remove('open');
        });

        volInput.addEventListener('input', function(e) {
            e.stopPropagation();
            var v = parseInt(volInput.value);
            audio.volume = v / 100;
            audio.muted = false;
            volPct.textContent = v + '%';
            volIcon.innerHTML = v === 0 ? VOL_OFF : v < 50 ? VOL_LOW : VOL_ON;
        });

        volInput.addEventListener('click', function(e) { e.stopPropagation(); });

        speedBtn.addEventListener('click', function() {
            speedIdx = (speedIdx + 1) % speeds.length;
            audio.playbackRate = speeds[speedIdx];
            speedBtn.textContent = speeds[speedIdx] + 'x';
        });
        })();
    </script>

    

