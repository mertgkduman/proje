    <script>
        $(function () {
            var sticky1 = new StickySidebar('.sticky1', {
                containerSelector: '#main-content',
                topSpacing: 150,
                bottomSpacing: 20
            });
            var sticky2 = new StickySidebar('.sticky2', {
                containerSelector: '#main-content',
                topSpacing: 150,
                bottomSpacing: 20
            });
            $('#news_in_gallery').magnificPopup({
                delegate: 'a',
                type: 'image',
                gallery: {
                    enabled: true,
                },
                callbacks: {
                    change: function () {
                        let dataId = $(this.currItem.el[0]).attr('data-id');

                        var btnDownload = `<a class="download_icn_popup" download href=${this.currItem.src}><img src="https://apa.az/site/assets/images/icons/download_img_gal.svg"/></a>`
                        var btnBuy =
                            `<a href='https://apa.az/photo/photo-album' class="buy_icn_popup">
                                <img onload={SVGInject(this)} src="https://apa.az/site/assets/images/icons/wallet_archive.svg"/>
                            </a>`
                        setTimeout(() => {
                            $('.download_icn_popup').remove();
                            $('.buy_icn_popup').remove();
                            $(document).find(".mfp-content").append(btnDownload);
                            dataId > 0 && $(document).find(".mfp-content").append(btnBuy)
                        }, 100);
                    },
                }
            });

            $('.title_news ').html(function (i, h) {
                return h.replace(/&nbsp;/g, ' ');
            });

        })
    </script>

