            var currentPath = window.location.pathname;
            var isHomepage = currentPath === "/" || currentPath === "/tr/anasayfa" || currentPath === "/en/home-page";
            var popupShown = sessionStorage.getItem('popupShown');
            
            if (isHomepage || !popupShown) {
