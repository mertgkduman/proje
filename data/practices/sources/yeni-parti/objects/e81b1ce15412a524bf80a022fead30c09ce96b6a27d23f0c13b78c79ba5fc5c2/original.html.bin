<script>
(function () {
    if (!navigator.cookieEnabled) return;
    var endpoint = "\/gunluk-ziyaret.php";
    var lastDay = '', timer, pending = false;
    function day() { return new Date(Date.now() + 10800000).toISOString().slice(0, 10); }
    function record() {
        if (pending) return;
        pending = true;
        fetch(endpoint, {method: 'POST', credentials: 'same-origin', cache: 'no-store', keepalive: true})
            .then(function (r) { if (!r.ok) throw Error('counter'); return r.json(); })
            .then(function (data) {
                if (!data.ok) throw Error('counter');
                lastDay = data.gun;
                clearTimeout(timer);
                timer = setTimeout(record, Math.max(1000, (data.sifirlama - data.simdi) * 1000 + 250));
            }).catch(function () {
                clearTimeout(timer);
                timer = setTimeout(record, 60000);
            }).then(function () { pending = false; });
    }
    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'visible' && lastDay !== day()) record();
    });
    record();
})();
</script>
