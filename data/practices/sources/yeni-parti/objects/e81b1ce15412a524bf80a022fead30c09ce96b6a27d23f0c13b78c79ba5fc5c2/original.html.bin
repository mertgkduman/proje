<script>
(function(){
    function khSyncDesktopHeaderHeight(){
        var header=document.querySelector('.kh-header');
        if(!header){return;}
        if(window.matchMedia('(min-width: 769px)').matches){
            document.documentElement.style.setProperty('--kh-header-desktop-height',header.offsetHeight+'px');
        }else{
            document.documentElement.style.removeProperty('--kh-header-desktop-height');
        }
    }
    khSyncDesktopHeaderHeight();
    window.addEventListener('resize',khSyncDesktopHeaderHeight,{passive:true});
}());
</script>

<script>
document.addEventListener('DOMContentLoaded', function(){
    var header=document.querySelector('.kh-header'), search=document.getElementById('headerSearchBar'), menu=document.getElementById('mobileMenuPanel'), menuButtons=document.querySelectorAll('.kh-menu-toggle');
    var marketBox=document.getElementById('khMarketMini'), marketLabel=document.getElementById('khMarketLabel'), marketValue=document.getElementById('khMarketValue'), marketChange=document.getElementById('khMarketChange'), marketItems=[], marketIndex=0;
    if(marketBox){try{marketItems=JSON.parse(marketBox.getAttribute('data-market-items')||'[]')}catch(e){marketItems=[]}}
    function marketGoster(item){if(!item||!marketBox)return;marketLabel.textContent=item.label||'';marketValue.textContent=item.val||'';marketChange.textContent=(item.up?'▲':'▼')+' %'+(item.change||'0,00');marketChange.classList.toggle('is-up',!!item.up);marketChange.classList.toggle('is-down',!item.up)}
    function havaIkonu(desc){var d=String(desc||'').toLocaleLowerCase('tr-TR');if(d.indexOf('gok')>-1||d.indexOf('firt')>-1)return '⚡';if(d.indexOf('yag')>-1||d.indexOf('saganak')>-1||d.indexOf('cis')>-1)return '🌧';if(d.indexOf('kar')>-1)return '❄';if(d.indexOf('bulut')>-1||d.indexOf('kapal')>-1||d.indexOf('sis')>-1)return '☁';return '☀'}
    function marketVerisiniUygula(payload){
        if(!payload||typeof payload!=='object')return;
        if(Array.isArray(payload.items)&&payload.items.length){marketItems=payload.items;marketIndex=0;marketBox.setAttribute('data-market-items',JSON.stringify(marketItems));marketGoster(marketItems[0])}
        var weather=payload.weather||{},weatherBox=document.querySelector('.kh-weather-mini'),weatherIcon=weatherBox?weatherBox.querySelector('span'):null,weatherTemp=weatherBox?weatherBox.querySelector('strong'):null;
        if(weatherBox&&weather.temp&&weather.temp!=='--'){if(weatherIcon)weatherIcon.textContent=havaIkonu(weather.desc);if(weatherTemp)weatherTemp.textContent=weather.temp+'°';weatherBox.setAttribute('aria-label',(weather.city||'Kırıkkale')+' hava durumu')}
        try{window.localStorage.setItem('kh_market_weather_last',JSON.stringify({savedAt:Date.now(),payload:payload}))}catch(e){}
    }
    try{var son=JSON.parse(window.localStorage.getItem('kh_market_weather_last')||'null');if(son&&son.payload&&Date.now()-Number(son.savedAt||0)<21600000)marketVerisiniUygula(son.payload)}catch(e){}
    if(marketItems.length>1){window.setInterval(function(){marketBox.classList.add('is-changing');window.setTimeout(function(){marketIndex=(marketIndex+1)%marketItems.length;marketGoster(marketItems[marketIndex]);marketBox.classList.remove('is-changing')},220)},3500)}
    if(marketBox&&marketBox.dataset.marketEndpoint){
        fetch(marketBox.dataset.marketEndpoint,{credentials:'same-origin',cache:'no-store',headers:{'X-Requested-With':'XMLHttpRequest'}}).then(function(response){if(!response.ok)throw new Error('HTTP '+response.status);return response.text()}).then(function(html){
            var gecici=document.createElement('div');gecici.innerHTML=html;var yeni=gecici.querySelector('.finance-ticker-container[data-finance-payload]');if(!yeni)return;
            try{marketVerisiniUygula(JSON.parse(yeni.getAttribute('data-finance-payload')||'{}'))}catch(e){}
            var mevcut=document.querySelector('.ana-sayfa-finans-bandi .finance-ticker-container');if(mevcut)mevcut.replaceWith(yeni);
        }).catch(function(){/* Son gecerli veri ekranda tutulur. */});
    }
    document.querySelectorAll('.kh-district-menu').forEach(function(district){var closeTimer,toggle=district.querySelector('.kh-submenu-toggle');function setSubmenu(open){district.classList.toggle('is-open',open);if(toggle)toggle.setAttribute('aria-expanded',open?'true':'false')}district.addEventListener('mouseenter',function(){window.clearTimeout(closeTimer);setSubmenu(true)});district.addEventListener('mouseleave',function(){closeTimer=window.setTimeout(function(){setSubmenu(false)},600)});district.querySelectorAll('a').forEach(function(link){link.addEventListener('focus',function(){window.clearTimeout(closeTimer);setSubmenu(true)})});if(toggle)toggle.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();setSubmenu(!district.classList.contains('is-open'))})});
    document.querySelectorAll('.search-btn-trigger').forEach(function(button){button.addEventListener('click',function(){var open=search.style.display==='block';search.style.display=open?'none':'block';if(!open){var input=search.querySelector('input');if(input)input.focus();}})});
    function setMenuState(open){
        header.classList.toggle('mobil-menu-acik',open);
        document.body.classList.toggle('kh-mobile-menu-open',open);
        menuButtons.forEach(function(button){
            button.setAttribute('aria-expanded',open?'true':'false');
            button.setAttribute('aria-label',open?'Menüyü kapat':'Tüm menü');
            button.setAttribute('title',open?'Menüyü kapat':'Tüm menü');
            button.innerHTML=open?'&#10005;':'&#9776;';
        });
    }
    menuButtons.forEach(function(menuButton){menuButton.addEventListener('click',function(e){e.stopPropagation();setMenuState(!header.classList.contains('mobil-menu-acik'));});});
    if(menu){menu.addEventListener('click',function(e){if(e.target===menu){setMenuState(false);}});}
    document.addEventListener('click',function(e){if(header&&header.classList.contains('mobil-menu-acik')&&!menu.contains(e.target)&&!e.target.closest('.kh-menu-toggle')){setMenuState(false);}});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'&&header&&header.classList.contains('mobil-menu-acik')){setMenuState(false);}});
});
</script>

<script>
document.addEventListener('DOMContentLoaded',function(){
  function bildir(el,olay){
    if(!el.dataset.reklamId)return;
    var v=new URLSearchParams({reklam_id:el.dataset.reklamId,olay:olay,kategori_id:el.dataset.kategoriId||'',haber_id:el.dataset.haberId||''});
    var u="/api/telemetry/reklam-olay.php";
    if(navigator.sendBeacon)navigator.sendBeacon(u,v);else fetch(u,{method:'POST',body:v,keepalive:true,credentials:'same-origin'});
  }
  var gorulen=new WeakSet(), io='IntersectionObserver' in window?new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting&&e.intersectionRatio>=.5&&!gorulen.has(e.target)){gorulen.add(e.target);bildir(e.target,'gosterim');io.unobserve(e.target)}})},{threshold:.5}):null;
  document.querySelectorAll('[data-reklam-id]').forEach(function(el){var limit=parseInt(el.dataset.frekansLimit||'0',10),gun=(new Date).toISOString().slice(0,10),key='kh-ad-'+gun+'-'+el.dataset.reklamId,count=parseInt(localStorage.getItem(key)||'0',10);if(limit>0&&count>=limit){el.hidden=true;return}if(io)io.observe(el);else bildir(el,'gosterim');el.addEventListener('click',function(){bildir(el,'tiklama')},{passive:true});if(limit>0)localStorage.setItem(key,String(count+1))});
});
</script>
<script>
(function(){var d={sayfa:location.pathname,cihaz:/mobile|android|iphone/i.test(navigator.userAgent)?'mobil':'masaustu'};function yolla(){if(d.LCP||d.CLS||d.INP||d.TTFB)navigator.sendBeacon("/api/telemetry/web-vitals.php",new URLSearchParams(d))}try{new PerformanceObserver(function(l){var e=l.getEntries().pop();if(e)d.LCP=Math.round(e.startTime)}).observe({type:'largest-contentful-paint',buffered:true});new PerformanceObserver(function(l){var t=0;l.getEntries().forEach(function(e){if(!e.hadRecentInput)t+=e.value});d.CLS=t.toFixed(4)}).observe({type:'layout-shift',buffered:true});new PerformanceObserver(function(l){var e=l.getEntries().pop();if(e)d.INP=Math.round(e.duration)}).observe({type:'event',buffered:true,durationThreshold:40})}catch(e){}var n=performance.getEntriesByType('navigation')[0];if(n)d.TTFB=Math.round(n.responseStart);addEventListener('pagehide',yolla,{once:true})})();
</script>
<script>document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('img:not([loading])').forEach(function(i,n){if(n>1)i.loading='lazy';i.decoding='async'})});</script>

    
