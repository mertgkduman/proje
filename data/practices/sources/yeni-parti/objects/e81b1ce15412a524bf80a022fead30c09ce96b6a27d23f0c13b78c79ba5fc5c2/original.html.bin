<script>(function(){var d=document.documentElement,p=document.getElementById('kh-erisim-panel'),b=document.getElementById('kh-erisim-dugme'),s=Number(localStorage.getItem('kh-font')||100);function uygula(){d.style.fontSize=s+'%';d.classList.toggle('kh-yuksek-kontrast',localStorage.getItem('kh-kontrast')==='1');d.classList.toggle('kh-hareket-yok',localStorage.getItem('kh-hareket')==='1')}b.addEventListener('click',function(){p.hidden=!p.hidden;b.setAttribute('aria-expanded',String(!p.hidden))});p.addEventListener('click',function(e){var x=e.target.dataset.khErisim;if(!x)return;if(x==='buyut')s=Math.min(140,s+10);if(x==='kucult')s=Math.max(80,s-10);if(x==='kontrast')localStorage.setItem('kh-kontrast',localStorage.getItem('kh-kontrast')==='1'?'0':'1');if(x==='hareket')localStorage.setItem('kh-hareket',localStorage.getItem('kh-hareket')==='1'?'0':'1');if(x==='sifirla'){s=100;localStorage.removeItem('kh-kontrast');localStorage.removeItem('kh-hareket')}localStorage.setItem('kh-font',String(s));uygula()});uygula()})();</script>
