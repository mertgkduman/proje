        <script>(function(){let bas=Date.now(),g={};function y(o){if(g[o])return;g[o]=1;navigator.sendBeacon('/ziyaret-olay.php',new URLSearchParams({haber_id:792,olay:o,sure:Math.round((Date.now()-bas)/1000)}))}y('sayfa');setInterval(()=>{g.aktif=0;y('aktif')},60000);addEventListener('scroll',()=>{let p=(scrollY+innerHeight)/document.documentElement.scrollHeight*100;[25,50,75,100].forEach(x=>{if(p>=x)y('scroll'+x)})},{passive:true});addEventListener('pagehide',()=>{g.cikis=0;y('cikis')})})();</script>

<script>
(function(){
    var galeri=document.querySelector('[data-haber-galeri]'); if(!galeri)return;
    var resimler=Array.prototype.slice.call(galeri.querySelectorAll('.haber-galeri-kart img'));
    var modal=galeri.querySelector('[data-galeri-modal]'),buyuk=galeri.querySelector('[data-galeri-buyuk]'),sayac=galeri.querySelector('[data-galeri-sayac]'),aktif=0;
    function goster(i){aktif=(i+resimler.length)%resimler.length;buyuk.src=resimler[aktif].src;buyuk.alt=resimler[aktif].alt;sayac.textContent=(aktif+1)+' / '+resimler.length;modal.classList.add('aktif');modal.setAttribute('aria-hidden','false');document.body.style.overflow='hidden'}
    function kapat(){modal.classList.remove('aktif');modal.setAttribute('aria-hidden','true');document.body.style.overflow=''}
    galeri.querySelectorAll('[data-galeri-index]').forEach(function(k){k.addEventListener('click',function(){goster(parseInt(k.getAttribute('data-galeri-index'),10)||0)})});
    galeri.querySelector('[data-galeri-onceki]').addEventListener('click',function(){goster(aktif-1)});galeri.querySelector('[data-galeri-sonraki]').addEventListener('click',function(){goster(aktif+1)});galeri.querySelector('[data-galeri-kapat]').addEventListener('click',kapat);
    modal.addEventListener('click',function(e){if(e.target===modal)kapat()});document.addEventListener('keydown',function(e){if(!modal.classList.contains('aktif'))return;if(e.key==='Escape')kapat();if(e.key==='ArrowLeft')goster(aktif-1);if(e.key==='ArrowRight')goster(aktif+1)});
})();
document.querySelectorAll('.yorum-sikayet').forEach(function(b){b.addEventListener('click',function(){var n=prompt('Şikâyet nedenini kısaca yazın:','Uygunsuz içerik');if(!n)return;fetch('/yorum-sikayet.php',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:'yorum_id='+encodeURIComponent(b.dataset.yorum)+'&neden='+encodeURIComponent(n)}).then(function(){b.textContent='Şikâyet alındı';b.disabled=true})})});
</script>
