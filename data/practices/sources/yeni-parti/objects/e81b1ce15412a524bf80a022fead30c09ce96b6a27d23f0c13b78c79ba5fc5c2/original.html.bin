(function () {
    if (window.portalFacebookShareBound) return;
    window.portalFacebookShareBound = true;
    document.addEventListener('click', function (event) {
        var link = event.target.closest('a[data-portal-facebook]');
        if (!link || event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        if (window.matchMedia('(max-width: 767px)').matches) return;
        var left = Math.max(0, (window.screen.width - 600) / 2);
        var top = Math.max(0, (window.screen.height - 400) / 2);
        var popup = window.open(link.href, 'Facebook', 'width=600,height=400,left=' + left + ',top=' + top + ',resizable=yes,scrollbars=yes');
        if (popup) {
            event.preventDefault();
            try { popup.opener = null; popup.focus(); } catch (error) {}
        }
    });
})();
</script>
