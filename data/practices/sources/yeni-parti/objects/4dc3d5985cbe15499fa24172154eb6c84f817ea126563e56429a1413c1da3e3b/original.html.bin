io:4 / 1}.posts-6b01fb514034e ul li .post-image{margin-right:0}.posts-6b01fb514034e ul li .post-title{padding:10px 10px 10px 10px;display:flex}.posts-6b01fb514034e ul li .post-image>.article-category{display:none}}@media only screen and (max-width:480px){.posts-6b01fb514034e ul{margin:-10px -5px}.posts-6b01fb514034e ul li{width:calc(100% - 10px);margin:5px 5px}.posts-6b01fb514034e ul li .post-image{width:calc(50% - 50px)}.posts-6b01fb514034e ul li .post-image img{aspect-ratio:16 / 9}}</style><ul><li><div class="li-con"><div class="post-image">
<a href="https://ihbaraydin.com/kocarlida-7-aydir-yatan-kepce-3-belediye-baskanini-tartismaya-acti/" title="Koçarlı&#8217;da 7 aydır yatan kepçe 3 Belediye Başkanını tartışmaya açtı">
