    <script src="https://www.cesmeninsesi.com.tr/assets/js/app.js"></script>
    <script>
    // Page loader: complete on load
    (function() {
        var loader = document.getElementById('page-loader');
        function finishLoading() {
            if (!loader) return;
            loader.classList.add('done');
            setTimeout(function() { loader.classList.add('hidden'); }, 500);
        }
        if (document.readyState === 'complete') {
            finishLoading();
        } else {
            window.addEventListener('load', finishLoading);
        }
        // Show loader on link click navigation
        document.addEventListener('click', function(e) {
            var link = e.target.closest('a[href]');
            if (!link) return;
            var href = link.getAttribute('href');
            if (!href || href.startsWith('#') || href.startsWith('javascript') || link.target === '_blank' || link.hasAttribute('download')) return;
            // Internal link - show loader
            loader.classList.remove('done', 'hidden');
            loader.querySelector('div').style.animation = 'none';
            void loader.offsetWidth; // reflow
            loader.querySelector('div').style.animation = '';
        });
    })();
    </script>
    <script>
    // Adblocker detection — ek güvenlik (CSS katmanlı yaklaşım zaten çalışıyor)
    (function() {
        var bait = document.createElement('div');
        bait.className = 'adsbox';
        bait.style.cssText = 'position:absolute;top:-1px;left:-1px;width:1px;height:1px;';
        bait.innerHTML = '&nbsp;';
        document.body.appendChild(bait);
        function check() {
            if (!bait || bait.offsetHeight === 0 || getComputedStyle(bait).display === 'none') {
                // Adblocker aktif — _ca div'lerini gizle (alt katman zaten görünür)
                document.querySelectorAll('._ca').forEach(function(el) { el.style.display = 'none'; });
            }
        }
        window.addEventListener('load', function() { setTimeout(check, 1200); });
        window._checkAdblock = check;
    })();
    </script>
    <script>
(function() {
    const BASE_URL = 'https://www.cesmeninsesi.com.tr/';
    const IS_MOBILE = false;
    const IS_LOGGED_IN = false;
    const CURRENT_USER_NAME = '';
    const CURRENT_USER_INITIAL = CURRENT_USER_NAME ? CURRENT_USER_NAME.charAt(0).toUpperCase() : '';

    // ==================== LIKE SYSTEM ====================
    function initLikeButtons(container) {
        container.querySelectorAll('.like-btn').forEach(btn => {
            if (btn.dataset.initialized) return;
            btn.dataset.initialized = '1';
            btn.addEventListener('click', async () => {
                if (btn.dataset.loggedIn !== '1') {
                    const tooltip = btn.parentElement.querySelector('.like-tooltip');
                    if (tooltip) {
                        tooltip.classList.remove('hidden');
                        setTimeout(() => tooltip.classList.add('hidden'), 2500);
                    }
                    return;
                }
                try {
                    const res = await fetch(BASE_URL + 'api/begen', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                        body: new URLSearchParams({ article_id: btn.dataset.articleId }),
                    });
                    const data = await res.json();
                    if (data.success) {
                        // Increment displayed count by 1 on like
                        const countEl = btn.querySelector('.like-count');
                        let current = parseInt(countEl.textContent.replace(/\./g, '').replace(/,/g, '')) || 0;
                        if (data.liked) {
                            countEl.textContent = (current + 1).toLocaleString('tr-TR');
                        } else {
                            countEl.textContent = Math.max(0, current - 1).toLocaleString('tr-TR');
                        }
                    }
                } catch (e) { console.error('Like failed:', e); }
            });
        });
    }

    // ==================== COMMENTS SYSTEM ====================
    function loadComments(listEl) {
        const articleId = listEl.dataset.articleId;
        const type = listEl.dataset.type || 'article';
        fetch(BASE_URL + 'api/yorumlar/' + articleId + '?type=' + type)
            .then(r => r.json())
            .then(data => {
                const loading = listEl.querySelector('.comments-loading');
                if (loading) loading.remove();
                const currentUserId = data.currentUserId;
                if (data.comments && data.comments.length > 0) {
                    listEl.innerHTML = data.comments.map(c => `
                        <div class="flex gap-3 ${c.parent_id ? 'ml-8' : ''}" data-comment-id="${c.id}">
                            <div class="w-8 h-8 shrink-0 rounded-full bg-gray-200 flex items-center justify-center text-xs font-bold text-gray-500">
                                ${c.author_name.charAt(0).toUpperCase()}
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-semibold text-gray-900">${c.author_name}</span>
                                    <span class="text-[10px] text-gray-400">${c.created_at}</span>
                                </div>
                                <p class="mt-1 text-sm text-gray-700 leading-relaxed">${c.body}</p>
                                <div class="flex items-center gap-2 mt-1">
                                    <button class="text-[10px] font-semibold text-gray-400 hover:text-blue-600 reply-btn" data-parent="${c.id}" data-article-id="${articleId}">Yanıtla</button>
                                    ${currentUserId && c.user_id == currentUserId ? `<button class="text-[10px] font-semibold text-gray-400 hover:text-red-500 delete-btn" data-id="${c.id}">Sil</button>` : ''}
                                </div>
                            </div>
                        </div>
                    `).join('');
                    initCommentActions(listEl);
                } else {
                    listEl.innerHTML = '<p class="text-xs text-gray-400">Henüz yorum yapılmamış. İlk yorumu siz yapın!</p>';
                }
            })
            .catch(e => console.error('Comments load failed:', e));
    }

    function initCommentActions(listEl) {
        listEl.querySelectorAll('.reply-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const section = listEl.closest('section');
                const form = section.querySelector('.comment-form');
                const bodyEl = form.querySelector('.comment-body');
                let parentInput = form.querySelector('.reply-parent-id');
                if (!parentInput) {
                    parentInput = document.createElement('input');
                    parentInput.type = 'hidden';
                    parentInput.className = 'reply-parent-id';
                    parentInput.name = 'parent_id';
                    form.appendChild(parentInput);
                }
                parentInput.value = btn.dataset.parent;
                bodyEl.focus();
                bodyEl.placeholder = 'Yanıt yazın...';
            });
        });
        listEl.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                if (!confirm('Bu yorumu silmek istediğinize emin misiniz?')) return;
                try {
                    const res = await fetch(BASE_URL + 'api/yorum/' + btn.dataset.id, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        const el = btn.closest('[data-comment-id]');
                        if (el) el.remove();
                    } else { alert(data.error || 'Silme başarısız.'); }
                } catch (e) { alert('Silme sırasında hata oluştu.'); }
            });
        });
    }

    function initCommentForms(container) {
        container.querySelectorAll('.comment-form').forEach(form => {
            if (form.dataset.initialized) return;
            form.dataset.initialized = '1';
            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const articleId = form.dataset.articleId;
                const type = form.dataset.type || 'article';
                const bodyEl = form.querySelector('.comment-body');
                const body = bodyEl.value.trim();
                if (!body) return;

                const payload = { article_id: articleId, commentable_type: type, body: body };
                const parentInput = form.querySelector('.reply-parent-id');
                if (parentInput) payload.parent_id = parentInput.value;

                const nickEl = form.querySelector('.comment-nick');
                const emailEl = form.querySelector('.comment-email');
                const passEl = form.querySelector('.comment-password');
                if (nickEl) payload.nick = nickEl.value;
                if (emailEl) payload.email = emailEl.value;
                if (passEl) payload.password = passEl.value;

                const responseEl = form.closest('section').querySelector('.comment-response');

                try {
                    const res = await fetch(BASE_URL + 'api/yorum', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                        body: new URLSearchParams(payload),
                    });
                    const data = await res.json();
                    if (data.error) {
                        responseEl.className = 'comment-response mt-3 p-3 rounded-lg bg-red-50 text-red-700 text-sm font-medium';
                        responseEl.textContent = data.error;
                        responseEl.classList.remove('hidden');
                    } else if (data.success) {
                        responseEl.className = 'comment-response mt-3 p-3 rounded-lg bg-green-50 text-green-700 text-sm font-medium';
                        responseEl.innerHTML = 'Yorumunuz eklendi!';
                        responseEl.classList.remove('hidden');
                        bodyEl.value = '';
                        if (parentInput) parentInput.remove();

                        // Append new comment
                        const listEl = form.closest('section').querySelector('.comments-list');
                        const noComment = listEl.querySelector('p.text-xs');
                        if (noComment) noComment.remove();
                        const newEl = document.createElement('div');
                        newEl.className = 'flex gap-3' + (data.comment.parent_id ? ' ml-8' : '');
                        newEl.innerHTML = `
                            <div class="w-8 h-8 shrink-0 rounded-full bg-blue-100 flex items-center justify-center text-xs font-bold text-blue-600">
                                ${data.comment.author_name.charAt(0).toUpperCase()}
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-semibold text-gray-900">${data.comment.author_name}</span>
                                    <span class="text-[10px] text-gray-400">Az önce</span>
                                </div>
                                <p class="mt-1 text-sm text-gray-700 leading-relaxed">${data.comment.body}</p>
                            </div>
                        `;
                        listEl.appendChild(newEl);
                        setTimeout(() => responseEl.classList.add('hidden'), 4000);
                    }
                } catch (e) { console.error('Comment submit failed:', e); }
            });
        });
    }

    // ==================== INIT FIRST ARTICLE ====================
    initLikeButtons(document);
    document.querySelectorAll('.comments-list').forEach(el => loadComments(el));
    initCommentForms(document);

    // ==================== AD SYSTEM ====================
    const AD_PUB_ID = 'ca-pub-5142482886872528';
        const AD_BANNERS = {"728x90":"\u003Cdiv class=\"_cb\" style=\"position:absolute;inset:0;z-index:1;background:#011784;\"\u003E\u003Cimg src=\"https&#x3A;&#x2F;&#x2F;www.cesmeninsesi.com.tr&#x2F;public&#x2F;uploads&#x2F;banners&#x2F;728x90.jpg\" alt=\"Reklam\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:contain;display:block;\"\u003E\u003C/div\u003E","320x100":"\u003Cdiv class=\"_cb\" style=\"position:absolute;inset:0;z-index:1;background:#011784;\"\u003E\u003Cimg src=\"https&#x3A;&#x2F;&#x2F;www.cesmeninsesi.com.tr&#x2F;public&#x2F;uploads&#x2F;banners&#x2F;728x90.jpg\" alt=\"Reklam\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:contain;display:block;\"\u003E\u003C/div\u003E","300x250":"\u003Cdiv class=\"_cb\" style=\"position:absolute;inset:0;z-index:1;background:#011784;\"\u003E\u003Cimg src=\"https&#x3A;&#x2F;&#x2F;www.cesmeninsesi.com.tr&#x2F;public&#x2F;uploads&#x2F;banners&#x2F;300x300.jpg\" alt=\"Reklam\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:contain;display:block;\"\u003E\u003C/div\u003E","160x600":"\u003Cdiv class=\"_cb\" style=\"position:absolute;inset:0;z-index:1;background:#011784;\"\u003E\u003Cimg src=\"https&#x3A;&#x2F;&#x2F;www.cesmeninsesi.com.tr&#x2F;public&#x2F;uploads&#x2F;banners&#x2F;160x600.jpg\" alt=\"Reklam\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:contain;display:block;\"\u003E\u003C/div\u003E","300x600":"\u003Cdiv class=\"_cb\" style=\"position:absolute;inset:0;z-index:1;background:#011784;\"\u003E\u003Cimg src=\"https&#x3A;&#x2F;&#x2F;www.cesmeninsesi.com.tr&#x2F;public&#x2F;uploads&#x2F;banners&#x2F;300x600.jpg\" alt=\"Reklam\" loading=\"lazy\" decoding=\"async\" style=\"width:100%;height:100%;object-fit:contain;display:block;\"\u003E\u003C/div\u003E"};

    /** Banner varsa onu, yoksa AdSense + sarı uyarı katmanını döndürür */
    function adLayer(size, insHtml) {
        if (AD_BANNERS[size]) return AD_BANNERS[size];
        return `<div class="_ca" style="position:absolute;inset:0;z-index:2;">${insHtml}</div>` + adWarningHtml();
    }

    function adWarningHtml() {
        return '<div style="position:absolute;inset:0;z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:12px;gap:6px;background:linear-gradient(135deg,#fffbeb,#fef3c7);border:1px solid #fcd34d;border-radius:8px;"><svg style="width:28px;height:28px;color:#f59e0b;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg><a href="https://www.cesmeninsesi.com.tr/reklam-ver" style="font-size:11px;font-weight:700;color:#92400e;margin:0;">Buraya Reklam Verebilirsiniz</a><p style="font-size:9px;color:#a16207;margin:0;max-width:180px;line-height:1.3;">İletişim için bize ulaşın.</p></div>';
    }

    function createInlineAd() {
        const w = IS_MOBILE ? 320 : 728;
        const h = IS_MOBILE ? 100 : 90;
        const adDiv = document.createElement('div');
        adDiv.className = 'my-6 flex justify-center';
        adDiv.innerHTML = `<div class="_cr" style="position:relative;width:${w}px;max-width:100%;height:${h}px;overflow:hidden;border-radius:8px;">
            ${adLayer(w + 'x' + h, `<ins class="adsbygoogle" style="display:inline-block;width:${w}px;height:${h}px" data-ad-client="${AD_PUB_ID}" data-ad-slot="5000000001"></ins>`)}
        </div>`;
        // Note: push will be called AFTER appending to DOM
        return adDiv;
    }

    /**
     * Create in-article ad block (appears inside article body).
     * Uses responsive ad format for better fill rate.
     */
    function createInArticleAd(position) {
        const slotMap = { top: '6000000001', mid: '6000000002', bottom: '6000000003' };
        const slot = slotMap[position] || '6000000001';
        const adDiv = document.createElement('div');
        adDiv.className = 'in-article-ad my-6 flex justify-center';
        if (IS_MOBILE) {
            adDiv.innerHTML = `<div class="_cr" style="position:relative;width:300px;max-width:100%;min-height:250px;overflow:hidden;border-radius:8px;">
                ${adLayer('300x250', `<ins class="adsbygoogle" style="display:block" data-ad-client="${AD_PUB_ID}" data-ad-slot="${slot}" data-ad-format="fluid" data-ad-layout="in-article"></ins>`)}
            </div>`;
        } else {
            adDiv.innerHTML = `<div class="_cr" style="position:relative;width:728px;max-width:100%;min-height:90px;overflow:hidden;border-radius:8px;">
                ${adLayer('728x90', `<ins class="adsbygoogle" style="display:block" data-ad-client="${AD_PUB_ID}" data-ad-slot="${slot}" data-ad-format="fluid" data-ad-layout="in-article"></ins>`)}
            </div>`;
        }
        return adDiv;
    }

    /**
     * Push AdSense for all unfilled ins elements inside a container.
     * Must be called AFTER the container is in the DOM.
     */
    function pushAdsInContainer(container) {
        const unfilled = container.querySelectorAll('ins.adsbygoogle[data-adsbygoogle-status=undefined], ins.adsbygoogle:not([data-adsbygoogle-status])');
        unfilled.forEach(() => {
            try { (adsbygoogle = window.adsbygoogle || []).push({}); } catch(e) {}
        });
        if (window._checkAdblock) setTimeout(window._checkAdblock, 800);
    }

    function refreshLeftAds() {
        const adContainer = document.getElementById('left-ad-container');
        if (!adContainer) return;
        adContainer.innerHTML = `
            <div class="flex justify-center">
                <div class="_cr" style="position:relative;width:160px;height:600px;overflow:hidden;border-radius:8px;">
                    ${adLayer('160x600', `<ins class="adsbygoogle" style="display:inline-block;width:160px;height:600px" data-ad-client="${AD_PUB_ID}" data-ad-slot="2000000001" data-ad-format="auto"></ins>`)}
                </div>
            </div>
            <div class="flex justify-center mt-4">
                <div class="_cr" style="position:relative;width:300px;max-width:100%;height:250px;overflow:hidden;border-radius:8px;">
                    ${adLayer('300x250', `<ins class="adsbygoogle" style="display:inline-block;width:300px;height:250px" data-ad-client="${AD_PUB_ID}" data-ad-slot="2000000002" data-ad-format="auto"></ins>`)}
                </div>
            </div>
        `;
        // Push after DOM update (use requestAnimationFrame for timing)
        requestAnimationFrame(() => {
            pushAdsInContainer(adContainer);
        });
    }

    // Refresh sidebar ads every ~10 screen scrolls
    (function() {
        var lastRefreshY = 0;
        var scrollThreshold = window.innerHeight * 10; // 10 viewport heights
        window.addEventListener('scroll', function() {
            var scrolled = window.scrollY - lastRefreshY;
            if (scrolled >= scrollThreshold) {
                lastRefreshY = window.scrollY;
                refreshLeftAds();
            }
        }, { passive: true });
    })();

    // ==================== INFINITE SCROLL ====================
    const container = document.getElementById('next-articles-container');
    const trigger = document.getElementById('next-article-trigger');
    if (!trigger || !container) return;

    let loadedIds = [5114];
    let loading = false;
    let hasMore = true;

    const observer = new IntersectionObserver(entries => {
        if (entries[0].isIntersecting && !loading && hasMore) {
            loadNext();
        }
    }, { rootMargin: '400px' });
    observer.observe(trigger);

    async function loadNext() {
        loading = true;
        const lastId = loadedIds[loadedIds.length - 1];
        try {
            const res = await fetch(BASE_URL + 'api/haber/next/' + lastId + '?exclude=' + loadedIds.join(','));
            const data = await res.json();

            if (!data.hasMore) {
                hasMore = false;
                trigger.innerHTML = '<p class="text-sm text-gray-400 text-center">Tüm haberler okundu.</p>';
                observer.disconnect();
                loading = false;
                return;
            }

            const art = data.article;
            loadedIds.push(art.id);

            const tagsHtml = art.tags && art.tags.length > 0
                ? `<div class="mt-8 pt-6 border-t border-gray-100"><div class="flex flex-wrap items-center gap-2"><span class="text-xs font-semibold text-gray-500">Etiketler:</span>${art.tags.map(t => `<span class="px-2.5 py-1 text-xs font-medium bg-gray-100 text-gray-600 rounded-full">#${t}</span>`).join('')}</div></div>`
                : '';

            const authorHtml = art.author
                ? `<div class="flex items-center gap-3 mb-6 pb-6 border-b border-gray-100">
                    ${art.author.avatar ? `<img src="${BASE_URL}uploads/profil/${art.author.avatar}" class="w-10 h-10 rounded-full object-cover border border-gray-200">` : `<div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center text-sm font-bold text-gray-500">${art.author.full_name.charAt(0)}</div>`}
                    <div><span class="text-sm font-semibold text-gray-900">${art.author.full_name}</span></div>
                  </div>`
                : '';

            // Date formatting
            const pubDate = new Date(art.published_at);
            const trMonths = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
            const dateStr = pubDate.getDate() + ' ' + trMonths[pubDate.getMonth()] + ' ' + pubDate.getFullYear();
            const timeStr = pubDate.toTimeString().substring(0, 5);

            // Share URLs
            const shareUrl = encodeURIComponent(art.url);
            const shareText = encodeURIComponent(art.title);

            // Comment form HTML (same as first article)
            const commentFormHtml = IS_LOGGED_IN
                ? `<form class="comment-form space-y-3" data-article-id="${art.id}" data-type="article">
                    <div class="flex items-center gap-2 mb-2">
                        <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center text-xs font-bold text-blue-600">${CURRENT_USER_INITIAL}</div>
                        <span class="text-sm font-semibold text-gray-900">${CURRENT_USER_NAME}</span>
                    </div>
                    <textarea rows="3" required minlength="3" class="comment-body w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-none" placeholder="Yorumunuzu yazın..."></textarea>
                    <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white font-semibold rounded-lg text-sm hover:bg-blue-700 transition-colors">Yorum Yap</button>
                   </form>`
                : `<div class="bg-gray-50 rounded-lg p-5">
                    <p class="text-sm font-medium text-gray-700 mb-4">Yorum yapmak için bilgilerinizi girin — anında üye olun:</p>
                    <form class="comment-form space-y-3" data-article-id="${art.id}" data-type="article">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <input type="text" class="comment-nick w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" required placeholder="Kullanıcı adınız" maxlength="60">
                            <input type="email" class="comment-email w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" required placeholder="E-posta adresiniz">
                        </div>
                        <input type="password" class="comment-password w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" required minlength="6" placeholder="Şifre (en az 6 karakter)">
                        <textarea rows="3" required minlength="3" class="comment-body w-full px-3 py-2.5 border border-gray-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none resize-none" placeholder="Yorumunuzu yazın..."></textarea>
                        <div class="flex items-center justify-between">
                            <button type="submit" class="px-5 py-2.5 bg-blue-600 text-white font-semibold rounded-lg text-sm hover:bg-blue-700 transition-colors">Kayıt Ol & Yorum Yap</button>
                            <a href="${BASE_URL}giris" class="text-xs text-gray-500 hover:text-blue-600">Zaten üyeyim &rarr;</a>
                        </div>
                    </form>
                   </div>`;

            const wrapper = document.createElement('div');
            wrapper.className = 'scroll-article-wrapper mt-8';
            wrapper.dataset.articleId = art.id;
            wrapper.dataset.articleUrl = art.url;
            wrapper.dataset.articleTitle = art.title;

            wrapper.innerHTML = `
                <article class="bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm lg:max-w-4xl" id="article-${art.id}">
                    <div class="relative">
                        <img src="${art.cover_image}" alt="${art.title}" class="w-full aspect-[21/9] object-cover">
                    </div>
                    <div class="p-6 lg:p-8">
                        ${art.category_name ? `<a href="${BASE_URL}kategori/${art.category_slug}" class="inline-block px-3 py-1 rounded-full bg-blue-50 text-blue-600 text-xs font-bold uppercase tracking-wide hover:bg-blue-100 transition-colors mb-4">${art.category_name}</a>` : ''}
                        <h1 class="text-2xl lg:text-[2rem] xl:text-[2.25rem] font-extrabold leading-[1.2] mb-4 text-gray-900">${art.title}</h1>
                        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-400 mb-6 pb-6 border-b border-gray-100">
                            <time class="flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                                ${dateStr}
                            </time>
                            <span class="text-gray-200">|</span>
                            <span class="flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                ${timeStr}
                            </span>
                            <span class="text-gray-200">|</span>
                            <span>${art.reading_time} dk okuma</span>
                            <span class="text-gray-200">|</span>
                            <span class="flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                ${art.view_count} görüntülenme
                            </span>
                        </div>
                        ${art.summary ? `<p class="text-base lg:text-lg text-gray-600 leading-relaxed mb-6 font-medium italic border-l-4 border-blue-500 pl-5">${art.summary}</p>` : ''}
                        ${authorHtml}
                        <div class="prose prose-gray max-w-none prose-headings:text-gray-900 prose-headings:font-extrabold prose-p:text-gray-700 prose-p:leading-relaxed prose-a:text-blue-600 prose-img:rounded-lg prose-blockquote:border-blue-600 prose-blockquote:bg-blue-50/30 prose-blockquote:py-1">${art.body}</div>
                        ${tagsHtml}
                        <!-- Share + Engagement -->
                        <div class="mt-8 pt-5 border-t border-gray-100">
                            <div class="flex items-center justify-between flex-wrap gap-3">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-semibold text-gray-400">Paylaş:</span>
                                    <a href="https://www.facebook.com/sharer/sharer.php?u=${shareUrl}" target="_blank" rel="noopener" class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 hover:bg-blue-600 hover:text-white transition-colors" title="Facebook">
                                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z"/></svg>
                                    </a>
                                    <a href="https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}" target="_blank" rel="noopener" class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 hover:bg-black hover:text-white transition-colors" title="X (Twitter)">
                                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                                    </a>
                                    <a href="https://wa.me/?text=${shareText}%20${shareUrl}" target="_blank" rel="noopener" class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 hover:bg-green-600 hover:text-white transition-colors" title="WhatsApp">
                                        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492l4.638-1.466A11.929 11.929 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75c-2.24 0-4.359-.636-6.173-1.738l-.443-.262-3.078.973.989-2.996-.287-.455A9.695 9.695 0 012.25 12c0-5.385 4.365-9.75 9.75-9.75S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"/></svg>
                                    </a>
                                    <button class="copy-link-btn w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center text-gray-500 hover:bg-gray-700 hover:text-white transition-colors" data-url="${art.url}" title="Linki Kopyala">
                                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                                    </button>
                                </div>
                                <div class="flex items-center gap-4">
                                    <div class="relative group">
                                        <button class="like-btn flex items-center gap-1.5 text-sm font-semibold transition-colors text-red-500" data-article-id="${art.id}" data-logged-in="${IS_LOGGED_IN ? '1' : '0'}">
                                            <svg class="w-4 h-4" fill="currentColor" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                                            <span class="like-count">${art.view_count.toLocaleString('tr-TR')}</span>
                                            <span class="like-label text-xs">kişi beğendi</span>
                                        </button>
                                        ${!IS_LOGGED_IN ? `<span class="like-tooltip hidden absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-1.5 bg-gray-900 text-white text-xs rounded-lg whitespace-nowrap shadow-lg">Lütfen üye olun<span class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-gray-900"></span></span>` : ''}
                                    </div>
                                    <a href="#halkin-sesi-${art.id}" class="flex items-center gap-1.5 text-sm text-gray-500 hover:text-blue-600 transition-colors">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                                        <span class="font-semibold">${art.comment_count}</span> yorum
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
                <!-- Comments: Halkın Sesi -->
                <section class="bg-white border border-gray-200 rounded-xl overflow-hidden mt-6 shadow-sm max-w-4xl" id="halkin-sesi-${art.id}">
                    <div class="p-6 md:p-8">
                        <div class="flex items-center gap-2 mb-5">
                            <span class="w-2 h-2 rounded-full bg-yellow-400"></span>
                            <h3 class="text-lg font-extrabold text-gray-900">Halkın Sesi, Çeşme'nin Sesi</h3>
                        </div>
                        <p class="text-sm text-gray-500 mb-6">Bu haber hakkında ne düşünüyorsunuz? Yorumunuzu paylaşın, tartışmaya katılın.</p>
                        <div class="comments-list space-y-4 mb-6" data-article-id="${art.id}" data-type="article">
                            <p class="text-xs text-gray-400 comments-loading">Yorumlar yükleniyor...</p>
                        </div>
                        <div class="border-t border-gray-100 pt-6">
                            ${commentFormHtml}
                            <div class="comment-response mt-3 hidden"></div>
                        </div>
                    </div>
                </section>
            `;

            // Insert inline ad before the new article
            container.appendChild(createInlineAd());

            container.appendChild(wrapper);

            // Insert in-article ads inside the article body
            const proseEl = wrapper.querySelector('.prose');
            if (proseEl) {
                const paragraphs = proseEl.querySelectorAll(':scope > p');
                // Insert 'top' ad after 2nd paragraph
                if (paragraphs.length > 2) {
                    paragraphs[1].after(createInArticleAd('top'));
                }
                // Insert 'mid' ad after ~60% of paragraphs
                const midIndex = Math.floor(paragraphs.length * 0.6);
                if (paragraphs.length > 5 && midIndex > 2) {
                    paragraphs[midIndex].after(createInArticleAd('mid'));
                }
            }

            // Insert 'bottom' ad after the article (before comments)
            const commentsSection = wrapper.querySelector('[id^="halkin-sesi-"]');
            if (commentsSection) {
                const bottomAd = createInArticleAd('bottom');
                commentsSection.parentNode.insertBefore(bottomAd, commentsSection);
            }

            container.appendChild(trigger);

            // CRITICAL: Push ads AFTER all elements are in the DOM
            requestAnimationFrame(() => {
                pushAdsInContainer(container);
            });

            // Refresh left sidebar ads
            refreshLeftAds();

            // Initialize all interactive elements for the new article
            initLikeButtons(wrapper);
            wrapper.querySelectorAll('.comments-list').forEach(el => loadComments(el));
            initCommentForms(wrapper);

            // Copy link buttons
            wrapper.querySelectorAll('.copy-link-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    navigator.clipboard.writeText(btn.dataset.url).then(() => { btn.title = 'Kopyalandı!'; });
                });
            });

            // Re-check adblock for newly added ad slots
            if (window._checkAdblock) setTimeout(window._checkAdblock, 1200);

        } catch (e) {
            console.error('Next article load failed:', e);
        }
        loading = false;
    }

    // ==================== URL UPDATE ON SCROLL ====================
    const originalUrl = 'https://www.cesmeninsesi.com.tr/haber/yeni-parti-cesmede-dolunay-onur-ve-yonetimi-mazbatalarini-alarak-goreve-basladi-1791449917';
    const originalTitle = 'YEN\u0130\x20Parti\x20\u00C7e\u015Fme\x27de\x20Dolunay\x20Onur\x20ve\x20y\u00F6netimi\x20mazbatalar\u0131n\u0131\x20alarak\x20g\u00F6reve\x20ba\u015Flad\u0131';
    let currentUrl = window.location.href;

    function updateUrlOnScroll() {
        const viewportMiddle = window.innerHeight * 0.3;
        let activeArticle = null;

        // Check original article
        const origArticle = document.getElementById('article-5114');
        if (origArticle) {
            const rect = origArticle.getBoundingClientRect();
            if (rect.top <= viewportMiddle && rect.bottom > viewportMiddle) {
                activeArticle = { url: originalUrl, title: originalTitle };
            }
        }

        // Check dynamically loaded articles
        document.querySelectorAll('.scroll-article-wrapper').forEach(el => {
            const rect = el.getBoundingClientRect();
            if (rect.top <= viewportMiddle && rect.bottom > viewportMiddle) {
                activeArticle = { url: el.dataset.articleUrl, title: el.dataset.articleTitle };
            }
        });

        if (activeArticle && activeArticle.url !== currentUrl) {
            currentUrl = activeArticle.url;
            history.replaceState(null, '', activeArticle.url);
            document.title = activeArticle.title + ' - \u00c7e\u015fme\'nin Sesi';
            const canonical = document.querySelector('link[rel=canonical]');
            if (canonical) canonical.href = activeArticle.url;

            // Signal pageview to Google Analytics / AdSense for proper ad attribution
            if (typeof gtag === 'function') {
                gtag('event', 'page_view', {
                    page_title: activeArticle.title,
                    page_location: activeArticle.url,
                });
            }
        }
    }

    let scrollTick = false;
    window.addEventListener('scroll', () => {
        if (!scrollTick) {
            scrollTick = true;
            requestAnimationFrame(() => { updateUrlOnScroll(); scrollTick = false; });
        }
    }, { passive: true });
})();
</script>

        <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092" integrity="sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==" data-cf-beacon='{"version":"2024.11.0","token":"6886df722ac14d62bdb689674c1bb464","r":1,"spa":2}' crossorigin="anonymous"></script>
</body>
</html>
