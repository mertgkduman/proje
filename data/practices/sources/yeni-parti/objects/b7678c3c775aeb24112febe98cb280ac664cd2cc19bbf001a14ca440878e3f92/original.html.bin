		<style>.dkn-parallax-container { position: relative; display: block; overflow: hidden; clear: both; margin: 0; padding: 0; z-index: 1; }
        .dkn-parallax-clip { position: absolute; top: 0; right: 0; bottom: 0; left: 0; clip-path: inset(0); -webkit-clip-path: inset(0); }
        .dkn-parallax-inner { position: fixed; top: 0; left: 0; width: 100%; display: flex; justify-content: center; align-items: center; will-change: transform; visibility: hidden; z-index: -1; pointer-events: none; }
        .dkn-parallax-content-block { width: 100%; height: auto; pointer-events: auto; }
        .dkn-parallax-content-block img, .dkn-parallax-content-block iframe, .dkn-parallax-content-block video, .dkn-parallax-content-block embed { display: block; margin: 0 auto; max-width: 100%; height: auto; object-fit: contain; }
        .dkn-parallax-content-block .unslider { overflow: visible !important; }
        .dkn-parallax-content-block .unslider-wrap { display: flex !important; }</style><style type="text/css">.blue-message, .is-style-blue-message {
background: none repeat scroll 0 0 #3399ff;
    color: #ffffff;
    text-shadow: none;
    font-size: 16px;
    line-height: 24px;
    padding: 10px;
}.green-message, .is-style-green-message {
background: none repeat scroll 0 0 #8cc14c;
    color: #ffffff;
    text-shadow: none;
    font-size: 16px;
    line-height: 24px;
    padding: 10px;
}.orange-message, .is-style-orange-message {
background: none repeat scroll 0 0 #faa732;
    color: #ffffff;
    text-shadow: none;
    font-size: 16px;
    line-height: 24px;
    padding: 10px;
}.red-message, .is-style-red-message {
background: none repeat scroll 0 0 #da4d31;
    color: #ffffff;
    text-shadow: none;
    font-size: 16px;
    line-height: 24px;
    padding: 10px;
}.grey-message, .is-style-grey-message {
background: none repeat scroll 0 0 #53555c;
