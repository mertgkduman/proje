<script>
(function () {
    const dialog = document.getElementById('mobile-back-recommendations');
    const articleContent = document.getElementById('news-content');
    const isMobile = window.matchMedia('(max-width: 767.98px)').matches;

    if (!dialog || !articleContent || !isMobile) {
        return;
    }

    const closeDialog = function () {
        dialog.classList.remove('is-open');
        dialog.setAttribute('aria-hidden', 'true');
    };

    const openDialog = function () {
        dialog.classList.add('is-open');
        dialog.setAttribute('aria-hidden', 'false');
    };

    if ('IntersectionObserver' in window) {
        const articleEndTrigger = document.createElement('span');
        articleEndTrigger.setAttribute('aria-hidden', 'true');
        articleContent.insertAdjacentElement('afterend', articleEndTrigger);

        const observer = new IntersectionObserver(function (entries) {
            if (entries.some(function (entry) { return entry.isIntersecting; })) {
                openDialog();
                observer.disconnect();
            }
        }, {
            threshold: 0.15
        });

        observer.observe(articleEndTrigger);
    } else {
        window.addEventListener('scroll', function showAtArticleEnd() {
            const articleBottom = articleContent.getBoundingClientRect().bottom;

            if (articleBottom <= window.innerHeight) {
                openDialog();
                window.removeEventListener('scroll', showAtArticleEnd);
            }
        }, { passive: true });
    }

    dialog.querySelectorAll('[data-mobile-back-close]').forEach(function (button) {
        button.addEventListener('click', closeDialog);
    });

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && dialog.classList.contains('is-open')) {
            closeDialog();
        }
    });
})();
</script>



