<script>
const summaryText = `YENİ Parti Ankara Milletvekili Aylin Yaman, eğitim alan, sınavlara hazırlanan ve meslek sahibi olan binlerce engelli bireyin çalışma hayatına katılımda ciddi sorunlarla karşılaştığını belirtti.

EKPSS’den yüksek puan alan adayların yeterli kadro açılmadığı için atanamadığını ifade eden Yaman, kamu kurumlarında uygulanan yüzde 4’lük engelli istihdam kotasının artırılması gerektiğini savundu.

Yaman, Çalışma ve Sosyal Güvenlik Bakanı Vedat Işıkhan’a yönelttiği soru önergesine verilen yanıtın ise mevcut yönetmelik hükümlerinin tekrarlanmasından ibaret olduğunu belirterek tepki gösterdi.`;

let currentIndex = 0;
let isTyping = false;
let isExpanded = false;
let typingTimeout = null;

function toggleWidget() {
    const widget = document.getElementById('aiWidget');
    const content = document.getElementById('aiContent');
    const textElement = document.getElementById('aiText');
    const typingIndicator = document.getElementById('typingIndicator');
    const generatedText = document.getElementById('aiGeneratedText');

    if (!isExpanded) {
        isExpanded = true;
        widget.classList.add('expanded');
        content.classList.add('show');

        // sıfırla
        textElement.innerHTML = '';
        currentIndex = 0;
        typingIndicator.classList.add('active');
        generatedText.classList.remove('show');

        typeWriter();
    } else {
        isExpanded = false;
        widget.classList.remove('expanded');
        content.classList.remove('show');
        clearTimeout(typingTimeout);
        isTyping = false;
        typingIndicator.classList.remove('active');
        generatedText.classList.remove('show');
    }
}

function typeWriter() {
    const textElement = document.getElementById('aiText');
    const typingIndicator = document.getElementById('typingIndicator');
    const generatedText = document.getElementById('aiGeneratedText');
    if (isTyping) return;
    isTyping = true;

    const cursor = document.createElement('span');
    cursor.className = 'cursor';
    textElement.appendChild(cursor);

    setTimeout(() => {

        const bullet = document.createTextNode('• ');
        textElement.insertBefore(bullet, cursor);

        function type() {
            if (!isExpanded) {
                cursor.remove();
                isTyping = false;
                return;
            }

            if (currentIndex < summaryText.length) {
                const char = summaryText.charAt(currentIndex);

                if (char === '\n') {
                    currentIndex++;

                    if (summaryText[currentIndex] && summaryText[currentIndex] !== '\n') {
                        const br = document.createElement('br');
                        textElement.insertBefore(br, cursor);
                        const bullet = document.createTextNode('• ');
                        textElement.insertBefore(bullet, cursor);
                    }

                } else {
                    const textNode = document.createTextNode(char);
                    textElement.insertBefore(textNode, cursor);
                    currentIndex++;
                }

                const delay = (/[.,!?]/.test(char)) ? 150 : Math.random() * 10 + 10;
                typingTimeout = setTimeout(type, delay);
            } else {
                typingIndicator.classList.remove('active');
                setTimeout(() => {
                    cursor.remove();
                    isTyping = false;
                    generatedText.classList.add('show');
                }, 400);
            }
        }

        type();
    }, 2500);
}

</script>



