<script>
if (!window.newsReactionListenerAdded) {
    window.newsReactionListenerAdded = true;

    document.addEventListener('click', function (event) {
        const button = event.target.closest('.news-reactions__button');
        if (!button) return;

        const reactionBox = button.closest('.news-reactions');
        const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');

        if (reactionBox.classList.contains('is-loading')) return;
        reactionBox.classList.add('is-loading');

        fetch(reactionBox.dataset.reactionUrl, {
            method: 'POST',
            headers: {
                'Accept': 'application/json',
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': csrfToken
            },
            body: JSON.stringify({
                reaction: button.dataset.reaction
            })
        })
        .then(function (response) {
            if (!response.ok) {
                throw new Error('Tepki kaydedilemedi.');
            }

            return response.json();
        })
        .then(function (data) {
            reactionBox.classList.toggle('has-selection', Boolean(data.selected_reaction));

            reactionBox.querySelectorAll('.news-reactions__button').forEach(function (reactionButton) {
                const reaction = reactionButton.dataset.reaction;
                const count = Number(data.counts[reaction] || 0);
                const isSelected = data.selected_reaction === reaction;

                reactionButton.classList.toggle('is-selected', isSelected);
                reactionButton.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
                reactionButton.setAttribute('aria-label', reactionButton.dataset.label + ', ' + count + ' tepki');
                reactionButton.querySelector('.news-reactions__count').textContent = count;
            });
        })
        .catch(function (error) {
            console.error(error);
        })
        .finally(function () {
            reactionBox.classList.remove('is-loading');
        });
    });
}
</script>

