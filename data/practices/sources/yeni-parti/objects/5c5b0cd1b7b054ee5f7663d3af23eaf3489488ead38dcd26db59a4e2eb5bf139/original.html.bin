<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script>
function downloadBase64(dataUrl, filename) {
  try {
    var parts = dataUrl.split(';base64,');
    var contentType = parts[0].split(':')[1];
    var raw = window.atob(parts[1]);
    var rawLength = raw.length;
    var uInt8Array = new Uint8Array(rawLength);
    for (var i = 0; i < rawLength; ++i) {
      uInt8Array[i] = raw.charCodeAt(i);
    }
    var blob = new Blob([uInt8Array], {type: contentType});
    var blobUrl = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = blobUrl;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(blobUrl);
  } catch(err) {
    var a = document.createElement('a');
    a.href = dataUrl;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  }
}
function getLocalImageUrl(url) {
  if (!url) return '';
  var clean = url.replace(/^url\(["']?|["']?\)$/g, '');
  if (clean.indexOf('londrasondakika.b-cdn.net') !== -1) {
    clean = clean.replace(/https?:\/\/londrasondakika\.b-cdn\.net/i, '');
  } else if (clean.indexOf('londrasondakika.com') !== -1) {
    clean = clean.replace(/https?:\/\/(www\.)?londrasondakika\.com/i, '');
  } else if (clean.indexOf('samsunsondakika.com.tr') !== -1) {
    clean = clean.replace(/https?:\/\/(www\.)?samsunsondakika\.com\.tr/i, '');
  }
  
  var basePath = '';
  if (clean.indexOf('http') !== 0) {
    if (basePath && clean.indexOf(basePath) === 0) {
      clean = window.location.origin + clean;
    } else {
      var relativePath = clean.indexOf('/') === 0 ? clean : '/' + clean;
      clean = window.location.origin + basePath + relativePath;
    }
  }
  return clean;
}
function addEmoji(emoji) {
  var t = document.getElementById('yorum_alani');
  if (!t) return;
  var s = t.selectionStart, e = t.selectionEnd;
  t.value = t.value.substring(0,s) + emoji + t.value.substring(e);
  t.focus(); t.selectionStart = t.selectionEnd = s + emoji.length;
}
document.addEventListener("DOMContentLoaded", function() {
  var igBtn=document.getElementById('igShareBtn'), storyModal=document.getElementById('storyModal'),
      closeBtn=document.getElementById('closeStoryModal'), downloadBtn=document.getElementById('downloadStory'),
      refreshBtn=document.getElementById('refreshPreviewBtn'), titleEditor=document.getElementById('igTitleEditor'),
      cardTitle=document.getElementById('storyCardTitle'), previewImg=document.getElementById('storyPreviewImg'),
      storyCard=document.getElementById('storyCard'), textColorPicker=document.getElementById('igTextColor'),
      bgColorPicker=document.getElementById('igBgColor'), applyTextColorBtn=document.getElementById('applyTextColor'),
      applyBgColorBtn=document.getElementById('applyBgColor'), clearFormatBtn=document.getElementById('clearFormat'),
      fontIncreaseBtn=document.getElementById('fontIncrease'), fontDecreaseBtn=document.getElementById('fontDecrease'),
      fontSizeDisplay=document.getElementById('fontSizeDisplay'),
      btnSizePost=document.getElementById('btnSizePost'), btnSizeStory=document.getElementById('btnSizeStory'),
      storyCardImgContainer=document.getElementById('storyCardImgContainer'),
      storyCardLogoContainer=document.getElementById('storyCardLogoContainer'),
      storyCardTextContainer=document.getElementById('storyCardTextContainer'),
      savedRange=null, currentFontSize=68;

  document.addEventListener('selectionchange', function() {
    if (!titleEditor) return;
    var sel=window.getSelection();
    if (sel.rangeCount > 0) { var r=sel.getRangeAt(0); if (titleEditor.contains(r.commonAncestorContainer)) savedRange=r; }
  });

  if (btnSizePost && btnSizeStory) {
    btnSizePost.addEventListener('click', function() {
      btnSizePost.style.background = '#0072ff';
      btnSizePost.style.color = '#fff';
      btnSizeStory.style.background = '#242438';
      btnSizeStory.style.color = '#ccc';

      if (storyCard) storyCard.style.height = '1360px';
      if (storyCardImgContainer) storyCardImgContainer.style.height = '680px';
      if (storyCardLogoContainer) storyCardLogoContainer.style.top = '680px';
      if (storyCardTextContainer) {
        storyCardTextContainer.style.height = '680px';
        storyCardTextContainer.style.paddingTop = '120px';
        storyCardTextContainer.style.justifyContent = 'center';
      }
      if (downloadBtn) downloadBtn.download = 'samsunsondakika-gonderi.jpg';

      renderCard();
    });

    btnSizeStory.addEventListener('click', function() {
      btnSizeStory.style.background = '#0072ff';
      btnSizeStory.style.color = '#fff';
      btnSizePost.style.background = '#242438';
      btnSizePost.style.color = '#ccc';

      if (storyCard) storyCard.style.height = '1920px';
      if (storyCardImgContainer) storyCardImgContainer.style.height = '960px';
      if (storyCardLogoContainer) storyCardLogoContainer.style.top = '960px';
      if (storyCardTextContainer) {
        storyCardTextContainer.style.height = '960px';
        storyCardTextContainer.style.paddingTop = '80px';
        storyCardTextContainer.style.justifyContent = 'flex-start';
      }
      if (downloadBtn) downloadBtn.download = 'samsunsondakika-hikaye.jpg';

      renderCard();
    });
  }

  var renderTimeout = null;
  function scheduleRender() {
    if (renderTimeout) clearTimeout(renderTimeout);
    renderTimeout = setTimeout(function() {
      renderCard();
    }, 500);
  }

  // Yazı boyutu kontrolü
  function updateFontSize(delta) {
    currentFontSize = Math.min(120, Math.max(24, currentFontSize + delta));
    if (cardTitle) cardTitle.style.fontSize = currentFontSize + 'px';
    if (fontSizeDisplay) fontSizeDisplay.textContent = currentFontSize + 'px';
    scheduleRender();
  }
  if (fontIncreaseBtn) fontIncreaseBtn.addEventListener('click', function(){ updateFontSize(4); });
  if (fontDecreaseBtn) fontDecreaseBtn.addEventListener('click', function(){ updateFontSize(-4); });

  function applyFormatting(color, isBg, isClear) {
    if (!savedRange || savedRange.collapsed) { alert("Lütfen önce metni seçin!"); return; }
    titleEditor.focus();
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(savedRange);

    if (isClear) {
      // Tüm biçimi temizle
      document.execCommand('styleWithCSS', false, true);
      document.execCommand('removeFormat', false, null);
    } else {
      // Her zaman güvenilir span yöntemi kullan
      try {
        var range = sel.getRangeAt(0);
        var span = document.createElement('span');
        if (isBg) {
          span.style.backgroundColor = color;
          span.style.verticalAlign = '-3px';
        } else {
          span.style.color = color;
        }
        span.appendChild(range.extractContents());
        range.insertNode(span);
        // Cursoru sona al
        range.setStartAfter(span);
        range.collapse(true);
        sel.removeAllRanges();
        sel.addRange(range);
      } catch(e) { console.warn('Format error:', e); }
    }
    cardTitle.innerHTML = titleEditor.innerHTML;
    scheduleRender();
  }

  if (applyTextColorBtn) applyTextColorBtn.addEventListener('mousedown',function(e){e.preventDefault();applyFormatting(textColorPicker.value,false,false);});
  if (applyBgColorBtn) applyBgColorBtn.addEventListener('mousedown',function(e){e.preventDefault();applyFormatting(bgColorPicker.value,true,false);});
  if (clearFormatBtn) clearFormatBtn.addEventListener('mousedown',function(e){e.preventDefault();applyFormatting(null,false,true);});
  if (titleEditor && cardTitle) {
    titleEditor.addEventListener('input',function(){
      cardTitle.innerHTML=this.innerHTML;
      scheduleRender();
    });
  }

  function renderCard(cb) {
    if (downloadBtn) {
      downloadBtn.style.pointerEvents = 'none';
      downloadBtn.style.opacity = '0.7';
      downloadBtn.innerHTML = '⏳ Hazırlanıyor...';
    }

    var bgImgEl = document.getElementById('storyCardBgImg');
    if (bgImgEl) {
      var currentBg = bgImgEl.style.backgroundImage;
      if (currentBg && currentBg !== 'none') {
        bgImgEl.style.backgroundImage = "url('" + getLocalImageUrl(currentBg) + "')";
      }
    }
    var logoImgEl = storyCard ? storyCard.querySelector('#storyCardLogoContainer img') : null;
    if (logoImgEl && logoImgEl.src) {
      logoImgEl.src = getLocalImageUrl(logoImgEl.src);
    }

    html2canvas(storyCard,{scale:1,useCORS:true,allowTaint:true,backgroundColor:'#050505'}).then(function(canvas){
      var img=canvas.toDataURL('image/jpeg',0.95);
      previewImg.src = img;
      if (downloadBtn) {
        downloadBtn.href = img;
        downloadBtn.style.pointerEvents = 'auto';
        downloadBtn.style.opacity = '1';
        downloadBtn.innerHTML = '⬇️ İndir (JPEG)';
      }
      if(cb) cb(img);
    }).catch(function(e){
      console.error(e);
      alert('Kart oluşturulurken hata oluştu.');
      if (downloadBtn) {
        downloadBtn.style.pointerEvents = 'auto';
        downloadBtn.style.opacity = '1';
        downloadBtn.innerHTML = '⬇️ İndir (JPEG)';
      }
    });
  }

  if (refreshBtn) refreshBtn.addEventListener('click',function(){ if(titleEditor&&cardTitle) cardTitle.innerHTML=titleEditor.innerHTML; var o=this.innerHTML; this.innerHTML='⏳ Yükleniyor...'; this.disabled=true; var s=this; renderCard(function(){s.innerHTML=o;s.disabled=false;}); });

  if (igBtn) igBtn.addEventListener('click',function(e){ e.preventDefault(); var o=this.innerHTML; this.innerHTML='<i class="ph-bold ph-spinner"></i> Hazırlanıyor...'; this.style.opacity='0.7'; this.style.pointerEvents='none'; if(titleEditor&&cardTitle) titleEditor.innerHTML=cardTitle.innerHTML; var s=this; setTimeout(function(){ renderCard(function(){ storyModal.style.display='flex'; s.innerHTML=o; s.style.opacity='1'; s.style.pointerEvents='auto'; }); },300); });

  if (closeBtn) closeBtn.addEventListener('click',function(){ storyModal.style.display='none'; });

  // ==========================================
  // DİKEY VİDEO & GÖRSEL TASARLAYICI JS LOGIC
  // ==========================================
  var videoBtn = document.getElementById('videoShareBtn');
  var videoBtnHeader = document.getElementById('videoShareBtnHeader');
  if (videoBtn || videoBtnHeader) {
    var videoModal = document.getElementById('videoModal'),
        closeVideoBtn = document.getElementById('closeVideoModal'),
        downloadVideoJpgBtn = document.getElementById('downloadVideoJpg'),
        downloadVideoMp4Btn = document.getElementById('downloadVideoMp4'),
        refreshVideoBtn = document.getElementById('refreshVideoPreviewBtn'),
        videoTitleEditor = document.getElementById('videoTitleEditor'),
        videoCardTitle = document.getElementById('videoCardTitle'),
        videoPreviewImg = document.getElementById('videoPreviewImg'),
        videoCard = document.getElementById('videoCard'),
        videoTextColorPicker = document.getElementById('videoTextColor'),
        videoBgColorPicker = document.getElementById('videoBgColor'),
        applyVideoTextColorBtn = document.getElementById('applyVideoTextColor'),
        applyVideoBgColorBtn = document.getElementById('applyVideoBgColor'),
        videoClearFormatBtn = document.getElementById('videoClearFormat'),
        videoFontIncreaseBtn = document.getElementById('videoFontIncrease'),
        videoFontDecreaseBtn = document.getElementById('videoFontDecrease'),
        videoFontSizeDisplay = document.getElementById('videoFontSizeDisplay'),
        videoProgressContainer = document.getElementById('videoProgressContainer'),
        videoProgressBar = document.getElementById('videoProgressBar'),
        videoProgressPercent = document.getElementById('videoProgressPercent'),
        videoProgressText = document.getElementById('videoProgressText'),
        videoAudioInput = document.getElementById('videoAudioInput'),
        selectAudioBtn = document.getElementById('selectAudioBtn'),
        audioStatusText = document.getElementById('audioStatusText'),
        videoAudioPlayer = document.getElementById('videoAudioPlayer'),
        customAudioPlayer = document.getElementById('customAudioPlayer'),
        videoSavedRange = null,
        currentVideoFontSize = 72,
        isDefaultAudio = true,
        videoDuration = 12000,
        zoomSlider = document.getElementById('videoImgZoomSlider'),
        panXSlider = document.getElementById('videoImgPanXSlider'),
        panYSlider = document.getElementById('videoImgPanYSlider'),
        zoomValueText = document.getElementById('zoomValueText'),
        panXValueText = document.getElementById('panXValueText'),
        panYValueText = document.getElementById('panYValueText'),
        resetImgSettingsBtn = document.getElementById('resetImgSettingsBtn'),
        videoCardImage = document.getElementById('videoCardImage'),
        videoPreviewContainer = document.getElementById('videoPreviewContainer'),
        videoMediaInput = document.getElementById('videoMediaInput'),
        selectMediaBtn = document.getElementById('selectMediaBtn'),
        mediaStatusText = document.getElementById('mediaStatusText'),
        videoCardVideo = document.getElementById('videoCardVideo'),
        videoPreviewVideo = document.getElementById('videoPreviewVideo'),
        toggleVideoSoundBtn = document.getElementById('toggleVideoSoundBtn'),
        useOriginalSoundBtn = document.getElementById('useOriginalSoundBtn'),
        mixBackgroundLowBtn = document.getElementById('mixBackgroundLowBtn'),
        audioControlsContainer = document.getElementById('audioControlsContainer'),
        videoTextPanYSlider = document.getElementById('videoTextPanYSlider'),
        textPanYValueText = document.getElementById('textPanYValueText'),
        videoBgPanYSlider = document.getElementById('videoBgPanYSlider'),
        bgPanYValueText = document.getElementById('bgPanYValueText'),
        videoCardBottomPanel = document.getElementById('videoCardBottomPanel'),
        isVideoLoaded = false,
        isVideoSoundMuted = true,
        isUseOriginalSound = false,
        isMixBackgroundLow = false,
        videoTrimStart = 0,
        videoTrimEnd = 12,
        videoTrimContainer = document.getElementById('videoTrimContainer'),
        trimStartSlider = document.getElementById('trimStartSlider'),
        trimEndSlider = document.getElementById('trimEndSlider'),
        trimStartValueText = document.getElementById('trimStartValueText'),
        trimEndValueText = document.getElementById('trimEndValueText'),
        trimDurationText = document.getElementById('trimDurationText'),
        isEditorPaused = false,
        isEditorMuted = false,
        previewPlayPauseBtn = document.getElementById('previewPlayPauseBtn'),
        previewPlayPauseIcon = document.getElementById('previewPlayPauseIcon'),
        previewPlayPauseText = document.getElementById('previewPlayPauseText'),
        previewMuteBtn = document.getElementById('previewMuteBtn'),
        previewMuteIcon = document.getElementById('previewMuteIcon'),
        previewMuteText = document.getElementById('previewMuteText');

    window.switchVideoTab = function(tabName) {
      var textTab = document.getElementById('videoTabContentText');
      var mediaTab = document.getElementById('videoTabContentMedia');
      var posTab = document.getElementById('videoTabContentPosition');
      
      if (textTab) textTab.style.display = 'none';
      if (mediaTab) mediaTab.style.display = 'none';
      if (posTab) posTab.style.display = 'none';
      
      var tabs = document.querySelectorAll('.video-tab-btn');
      tabs.forEach(function(t) {
        t.classList.remove('active');
        t.style.background = '#0d0d12';
        t.style.color = '#888';
      });
      
      if (tabName === 'text' && textTab) {
        textTab.style.display = 'flex';
        var btn = document.getElementById('tabBtnText');
        if (btn) {
          btn.classList.add('active');
          btn.style.background = '#1e1e2d';
          btn.style.color = '#fff';
        }
      } else if (tabName === 'media' && mediaTab) {
        mediaTab.style.display = 'flex';
        var btn = document.getElementById('tabBtnMedia');
        if (btn) {
          btn.classList.add('active');
          btn.style.background = '#1e1e2d';
          btn.style.color = '#fff';
        }
      } else if (tabName === 'position' && posTab) {
        posTab.style.display = 'flex';
        var btn = document.getElementById('tabBtnPosition');
        if (btn) {
          btn.classList.add('active');
          btn.style.background = '#1e1e2d';
          btn.style.color = '#fff';
        }
      }
    };

    if (previewPlayPauseBtn) {
      previewPlayPauseBtn.addEventListener('click', function() {
        isEditorPaused = !isEditorPaused;
        updateEditorPlaybackState();
      });
    }

    if (previewMuteBtn) {
      previewMuteBtn.addEventListener('click', function() {
        isEditorMuted = !isEditorMuted;
        updateEditorMuteState();
      });
    }

    function updateEditorPlaybackState() {
      var activeBgMusic = isDefaultAudio ? videoAudioPlayer : customAudioPlayer;
      if (isEditorPaused) {
        if (activeBgMusic) activeBgMusic.pause();
        if (isVideoLoaded && videoPreviewVideo) videoPreviewVideo.pause();
        if (previewPlayPauseIcon) previewPlayPauseIcon.className = 'ph-bold ph-play';
        if (previewPlayPauseText) previewPlayPauseText.textContent = 'Oynat';
      } else {
        if (activeBgMusic) activeBgMusic.play().catch(function(e) {});
        if (isVideoLoaded && videoPreviewVideo) videoPreviewVideo.play().catch(function(e) {});
        if (previewPlayPauseIcon) previewPlayPauseIcon.className = 'ph-bold ph-pause';
        if (previewPlayPauseText) previewPlayPauseText.textContent = 'Duraklat';
      }
    }

    function updateEditorMuteState() {
      updateLivePreviewSound();
      if (isEditorMuted) {
        if (previewMuteIcon) previewMuteIcon.className = 'ph-bold ph-speaker-slash';
        if (previewMuteText) previewMuteText.textContent = 'Sesi Aç';
        if (previewMuteBtn) previewMuteBtn.style.background = '#4a1c1c';
      } else {
        if (previewMuteIcon) previewMuteIcon.className = 'ph-bold ph-speaker-high';
        if (previewMuteText) previewMuteText.textContent = 'Sesi Kapat';
        if (previewMuteBtn) previewMuteBtn.style.background = '#242438';
      }
    }

    function updateTrimValuesDisplay() {
      if (trimStartValueText) trimStartValueText.textContent = parseFloat(videoTrimStart).toFixed(1) + 's';
      if (trimEndValueText) trimEndValueText.textContent = parseFloat(videoTrimEnd).toFixed(1) + 's';
      var diff = videoTrimEnd - videoTrimStart;
      if (trimDurationText) trimDurationText.textContent = diff.toFixed(1) + ' Saniye';
    }

    if (trimStartSlider) {
      trimStartSlider.addEventListener('input', function() {
        var val = parseFloat(trimStartSlider.value);
        if (val >= videoTrimEnd - 0.5) {
          val = videoTrimEnd - 0.5;
          trimStartSlider.value = val;
        }
        videoTrimStart = val;
        updateTrimValuesDisplay();
        updateDynamicDuration();
        
        if (videoPreviewVideo) videoPreviewVideo.currentTime = videoTrimStart;
        if (videoCardVideo) videoCardVideo.currentTime = videoTrimStart;
      });
    }

    if (trimEndSlider) {
      trimEndSlider.addEventListener('input', function() {
        var val = parseFloat(trimEndSlider.value);
        if (val <= videoTrimStart + 0.5) {
          val = videoTrimStart + 0.5;
          trimEndSlider.value = val;
        }
        videoTrimEnd = val;
        updateTrimValuesDisplay();
        updateDynamicDuration();
        
        if (videoPreviewVideo) videoPreviewVideo.currentTime = videoTrimEnd;
        if (videoCardVideo) videoCardVideo.currentTime = videoTrimEnd;
      });
    }

    if (videoPreviewVideo) {
      videoPreviewVideo.addEventListener('timeupdate', function() {
        if (isVideoLoaded) {
          if (videoPreviewVideo.currentTime < videoTrimStart) {
            videoPreviewVideo.currentTime = videoTrimStart;
          } else if (videoPreviewVideo.currentTime > videoTrimEnd) {
            videoPreviewVideo.currentTime = videoTrimStart;
          }
        }
      });
    }

    function updateDynamicDuration() {
      if (isVideoLoaded && videoCardVideo && videoCardVideo.duration && isFinite(videoCardVideo.duration)) {
        var trimLengthMs = Math.round((videoTrimEnd - videoTrimStart) * 1000);
        videoDuration = Math.min(60000, Math.max(3000, trimLengthMs));
        var seconds = (videoDuration / 1000).toFixed(1);
        var fileName = videoMediaInput.files[0] ? videoMediaInput.files[0].name : 'Video';
        mediaStatusText.innerHTML = '🎬 <strong>Yüklendi:</strong> ' + fileName + ' (Kırpılan: ' + seconds + ' Sn)';
        mediaStatusText.style.color = '#ff007f';
      } else if (!isDefaultAudio && customAudioPlayer && customAudioPlayer.duration && isFinite(customAudioPlayer.duration)) {
        var audioLengthMs = Math.round((customAudioPlayer.duration + 1.0) * 1000); // 1.0 second delay added
        videoDuration = Math.min(60000, Math.max(3000, audioLengthMs)); // Bound between 3s and 60s
        var seconds = (videoDuration / 1000).toFixed(1);
        var fileName = videoAudioInput.files[0] ? videoAudioInput.files[0].name : 'Müzik';
        audioStatusText.innerHTML = '🎵 <strong>Yüklendi:</strong> ' + fileName + ' (' + seconds + ' Sn, 1sn gecikmeli)';
        audioStatusText.style.color = '#00c6ff';
      } else {
        videoDuration = 12000;
        if (audioStatusText) {
          audioStatusText.innerHTML = '🎵 <strong>Varsayılan Ses:</strong> sondakika.mpeg (12.0 Sn)';
          audioStatusText.style.color = '#00c6ff';
        }
      }
      if (downloadVideoMp4Btn) {
        var secondsText = (videoDuration / 1000).toFixed(1);
        downloadVideoMp4Btn.innerHTML = '<span style="font-size:18px;">🎬</span><span>' + secondsText + ' Saniye MP4 Video Üret</span>';
      }
    }

    if (videoAudioPlayer) {
      videoAudioPlayer.addEventListener('loadedmetadata', function() {
        if (isDefaultAudio && !isVideoLoaded) {
          updateDynamicDuration();
        }
      });
    }

    if (customAudioPlayer) {
      customAudioPlayer.addEventListener('loadedmetadata', function() {
        if (!isDefaultAudio) {
          updateDynamicDuration();
        }
      });
    }

    if (selectAudioBtn && videoAudioInput) {
      selectAudioBtn.addEventListener('click', function() {
        videoAudioInput.click();
      });
      
      videoAudioInput.addEventListener('change', function(e) {
        var file = e.target.files[0];
        if (file) {
          isDefaultAudio = false;
          var fileUrl = URL.createObjectURL(file);
          customAudioPlayer.src = fileUrl;
          customAudioPlayer.load();
          audioStatusText.innerHTML = '🎵 <strong>Yüklendi:</strong> ' + file.name + ' (Hesaplanıyor...)';
          audioStatusText.style.color = '#00c6ff';
          customAudioPlayer.oncanplaythrough = function() {
            updateLivePreviewSound();
            customAudioPlayer.oncanplaythrough = null;
          };
        } else {
          isDefaultAudio = true;
          customAudioPlayer.src = '';
          updateDynamicDuration();
          updateLivePreviewSound();
        }
      });
    }

    function updateSoundToggleUI() {
      // 1. Video Sesi
      if (isVideoSoundMuted) {
        toggleVideoSoundBtn.innerHTML = '<i class="ph-bold ph-speaker-slash"></i> 🔇 Video Sesi Kapalı';
        toggleVideoSoundBtn.style.background = '#4a1c1c';
      } else {
        toggleVideoSoundBtn.innerHTML = '<i class="ph-bold ph-speaker-high"></i> 🔊 Video Sesi Açık';
        toggleVideoSoundBtn.style.background = '#1c4a24';
      }

      // 2. Sadece Orijinal Ses
      if (isUseOriginalSound) {
        useOriginalSoundBtn.innerHTML = '<i class="ph-bold ph-check-circle"></i> 🔊 Sadece Orijinal Ses Aktif';
        useOriginalSoundBtn.style.background = '#0072ff';
      } else {
        useOriginalSoundBtn.innerHTML = '<i class="ph-bold ph-music-notes-slash"></i> 🔊 Orijinal Sesi Kullan';
        useOriginalSoundBtn.style.background = '#242438';
      }

      // 3. Orijinal Ses + %5 Müzik
      if (isMixBackgroundLow) {
        mixBackgroundLowBtn.innerHTML = '<i class="ph-bold ph-check-circle"></i> 🔊 Orijinal Ses + %5 Müzik Aktif';
        mixBackgroundLowBtn.style.background = '#0072ff';
      } else {
        mixBackgroundLowBtn.innerHTML = '<i class="ph-bold ph-waveform"></i> 🔊 Orijinal Ses + %5 Müzik';
        mixBackgroundLowBtn.style.background = '#242438';
      }

      // 4. Background Music container opacity and pointer events
      if (isUseOriginalSound) {
        if (toggleVideoSoundBtn) {
          toggleVideoSoundBtn.style.opacity = '0.5';
          toggleVideoSoundBtn.style.pointerEvents = 'none';
        }
        if (audioControlsContainer) {
          audioControlsContainer.style.opacity = '0.4';
          audioControlsContainer.style.pointerEvents = 'none';
        }
      } else if (isMixBackgroundLow) {
        if (toggleVideoSoundBtn) {
          toggleVideoSoundBtn.style.opacity = '0.5';
          toggleVideoSoundBtn.style.pointerEvents = 'none';
        }
        if (audioControlsContainer) {
          audioControlsContainer.style.opacity = '0.7';
          audioControlsContainer.style.pointerEvents = 'auto';
        }
      } else {
        if (toggleVideoSoundBtn) {
          toggleVideoSoundBtn.style.opacity = '1';
          toggleVideoSoundBtn.style.pointerEvents = 'auto';
        }
        if (audioControlsContainer) {
          audioControlsContainer.style.opacity = '1';
          audioControlsContainer.style.pointerEvents = 'auto';
        }
      }
      updateLivePreviewSound();
    }

    function updateLivePreviewSound() {
      if (!videoModal || videoModal.style.display !== 'flex') return;

      var activeBgMusic = isDefaultAudio ? videoAudioPlayer : customAudioPlayer;
      var inactiveBgMusic = isDefaultAudio ? customAudioPlayer : videoAudioPlayer;
      
      if (inactiveBgMusic) {
        inactiveBgMusic.pause();
        inactiveBgMusic.currentTime = 0;
      }

      if (isUseOriginalSound) {
        if (videoAudioPlayer) { videoAudioPlayer.muted = true; videoAudioPlayer.volume = 0; }
        if (customAudioPlayer) { customAudioPlayer.muted = true; customAudioPlayer.volume = 0; }
        if (isVideoLoaded && videoPreviewVideo) {
          videoPreviewVideo.muted = false;
          videoPreviewVideo.volume = 1.0;
        }
      } else if (isMixBackgroundLow) {
        if (videoAudioPlayer) { 
          videoAudioPlayer.muted = false; 
          videoAudioPlayer.volume = isDefaultAudio ? 0.05 : 0; 
        }
        if (customAudioPlayer) { 
          customAudioPlayer.muted = false; 
          customAudioPlayer.volume = isDefaultAudio ? 0 : 0.05; 
        }
        if (isVideoLoaded && videoPreviewVideo) {
          videoPreviewVideo.muted = false;
          videoPreviewVideo.volume = 1.0;
        }
      } else {
        if (videoAudioPlayer) { 
          videoAudioPlayer.muted = false; 
          videoAudioPlayer.volume = isDefaultAudio ? 1.0 : 0; 
        }
        if (customAudioPlayer) { 
          customAudioPlayer.muted = false; 
          customAudioPlayer.volume = isDefaultAudio ? 0 : 1.0; 
        }
        if (isVideoLoaded && videoPreviewVideo) {
          videoPreviewVideo.muted = isVideoSoundMuted;
          videoPreviewVideo.volume = isVideoSoundMuted ? 0.0 : 1.0;
        }
      }

      if (isEditorMuted) {
        if (videoAudioPlayer) { videoAudioPlayer.muted = true; videoAudioPlayer.volume = 0; }
        if (customAudioPlayer) { customAudioPlayer.muted = true; customAudioPlayer.volume = 0; }
        if (videoPreviewVideo) { videoPreviewVideo.muted = true; videoPreviewVideo.volume = 0; }
      }

      if (activeBgMusic) {
        activeBgMusic.loop = true;
        if (!isEditorPaused) {
          activeBgMusic.play().catch(function(e) {});
        } else {
          activeBgMusic.pause();
        }
      }
      
      if (isVideoLoaded && videoPreviewVideo) {
        if (!isEditorPaused) {
          videoPreviewVideo.play().catch(function(e) {});
        } else {
          videoPreviewVideo.pause();
        }
      }
    }

    if (toggleVideoSoundBtn) {
      toggleVideoSoundBtn.addEventListener('click', function() {
        isVideoSoundMuted = !isVideoSoundMuted;
        if (isVideoSoundMuted) {
          isUseOriginalSound = false;
          isMixBackgroundLow = false;
        }
        updateSoundToggleUI();
      });
    }

    if (useOriginalSoundBtn) {
      useOriginalSoundBtn.addEventListener('click', function() {
        isUseOriginalSound = !isUseOriginalSound;
        if (isUseOriginalSound) {
          isMixBackgroundLow = false;
          isVideoSoundMuted = false;
        }
        updateSoundToggleUI();
      });
    }

    if (mixBackgroundLowBtn) {
      mixBackgroundLowBtn.addEventListener('click', function() {
        isMixBackgroundLow = !isMixBackgroundLow;
        if (isMixBackgroundLow) {
          isUseOriginalSound = false;
          isVideoSoundMuted = false;
        }
        updateSoundToggleUI();
      });
    }

    function updateTextVerticalPosition() {
      if (!videoCardTitle) return;
      var val = parseInt(videoTextPanYSlider.value);
      videoCardTitle.style.transform = 'translateY(' + val + 'px)';
      if (textPanYValueText) {
        textPanYValueText.textContent = val + 'px';
      }
      if (videoCardBottomPanel && videoBgPanYSlider) {
        var bgVal = parseInt(videoBgPanYSlider.value);
        videoCardBottomPanel.style.transform = 'translateY(' + bgVal + 'px)';
        if (bgPanYValueText) {
          bgPanYValueText.textContent = bgVal + 'px';
        }
      }
    }

    if (videoTextPanYSlider) {
      videoTextPanYSlider.addEventListener('input', updateTextVerticalPosition);
      videoTextPanYSlider.addEventListener('change', function() {
        updateTextVerticalPosition();
        renderVideoCard();
      });
    }

    if (videoBgPanYSlider) {
      videoBgPanYSlider.addEventListener('input', updateTextVerticalPosition);
      videoBgPanYSlider.addEventListener('change', function() {
        updateTextVerticalPosition();
        renderVideoCard();
      });
    }

    if (selectMediaBtn && videoMediaInput) {
      selectMediaBtn.addEventListener('click', function() {
        videoMediaInput.click();
      });
      
      videoMediaInput.addEventListener('change', function(e) {
        var file = e.target.files[0];
        if (file) {
          var fileType = file.type;
          var fileUrl = URL.createObjectURL(file);
          
          if (fileType.startsWith('video/')) {
            isVideoLoaded = true;
            isEditorPaused = false;
            if (previewPlayPauseIcon) previewPlayPauseIcon.className = 'ph-bold ph-pause';
            if (previewPlayPauseText) previewPlayPauseText.textContent = 'Duraklat';
            
            if (videoCardImage) videoCardImage.style.display = 'none';
            if (videoCardVideo) {
              videoCardVideo.style.display = 'block';
              videoCardVideo.src = fileUrl;
              videoCardVideo.muted = true;
              videoCardVideo.play().catch(function(err){ console.log("Auto-play blocked:", err); });
            }
            
            if (videoPreviewImg) {
              videoPreviewImg.style.position = 'absolute';
              videoPreviewImg.style.top = '0';
              videoPreviewImg.style.left = '0';
              videoPreviewImg.style.zIndex = '5';
            }
            if (videoPreviewVideo) {
              videoPreviewVideo.style.display = 'block';
              videoPreviewVideo.src = fileUrl;
              videoPreviewVideo.muted = true;
              videoPreviewVideo.play().catch(function(err){ console.log("Auto-play blocked:", err); });
            }
            
            if (toggleVideoSoundBtn) toggleVideoSoundBtn.style.display = 'flex';
            if (useOriginalSoundBtn) useOriginalSoundBtn.style.display = 'flex';
            if (mixBackgroundLowBtn) mixBackgroundLowBtn.style.display = 'flex';
            isUseOriginalSound = false;
            isMixBackgroundLow = false;
            updateSoundToggleUI();
            
            videoCardVideo.onloadedmetadata = function() {
              var duration = videoCardVideo.duration;
              if (duration && isFinite(duration)) {
                videoTrimStart = 0;
                videoTrimEnd = Math.min(60, duration);
                
                if (trimStartSlider) {
                  trimStartSlider.max = duration;
                  trimStartSlider.value = 0;
                }
                
                if (trimEndSlider) {
                  trimEndSlider.max = duration;
                  trimEndSlider.value = videoTrimEnd;
                }
                
                if (videoTrimContainer) {
                  videoTrimContainer.style.display = 'flex';
                }
                
                updateTrimValuesDisplay();
                updateDynamicDuration();
              }
            };

          } else if (fileType.startsWith('image/')) {
            isVideoLoaded = false;
            videoTrimStart = 0;
            videoTrimEnd = 12;
            if (videoTrimContainer) {
              videoTrimContainer.style.display = 'none';
            }
            if (videoCardVideo) {
              videoCardVideo.style.display = 'none';
              videoCardVideo.src = '';
            }
            if (videoPreviewVideo) {
              videoPreviewVideo.style.display = 'none';
              videoPreviewVideo.src = '';
            }
            if (videoCardImage) {
              videoCardImage.style.display = 'block';
              videoCardImage.style.backgroundImage = "url('" + fileUrl + "')";
            }
            if (videoPreviewImg) {
              videoPreviewImg.style.position = 'static';
              videoPreviewImg.style.display = 'block';
            }
            
            mediaStatusText.innerHTML = '🖼️ <strong>Yüklendi:</strong> ' + file.name;
            mediaStatusText.style.color = '#00c6ff';
            
            if (toggleVideoSoundBtn) toggleVideoSoundBtn.style.display = 'none';
            if (useOriginalSoundBtn) useOriginalSoundBtn.style.display = 'none';
            if (mixBackgroundLowBtn) mixBackgroundLowBtn.style.display = 'none';
            isUseOriginalSound = false;
            isMixBackgroundLow = false;
            updateSoundToggleUI();
            
            updateDynamicDuration();
          }
          
          updateCardImageStyle();
          renderVideoCard();
        }
      });
    }

    function updateCardImageStyle() {
      if (!videoCardImage) return;
      var zoomVal = (zoomSlider.value / 100).toFixed(2);
      var panXVal = parseInt(panXSlider.value);
      var panYVal = parseInt(panYSlider.value);
      
      var transformStr = 'scale(' + zoomVal + ') translate(' + (panXVal / zoomVal) + 'px, ' + (panYVal / zoomVal) + 'px)';
      videoCardImage.style.transform = transformStr;
      if (videoCardVideo) videoCardVideo.style.transform = transformStr;
      
      if (videoPreviewVideo && videoPreviewContainer) {
        var previewScaleFactor = videoPreviewContainer.offsetWidth / 1080;
        var previewPanX = (panXVal * previewScaleFactor) / zoomVal;
        var previewPanY = (panYVal * previewScaleFactor) / zoomVal;
        videoPreviewVideo.style.transform = 'scale(' + zoomVal + ') translate(' + previewPanX + 'px, ' + previewPanY + 'px)';
      }
      
      zoomValueText.textContent = zoomSlider.value + '%';
      panXValueText.textContent = panXVal + 'px';
      panYValueText.textContent = panYVal + 'px';
    }

    if (zoomSlider) {
      zoomSlider.addEventListener('input', updateCardImageStyle);
      panXSlider.addEventListener('input', updateCardImageStyle);
      panYSlider.addEventListener('input', updateCardImageStyle);
      
      var debounceTimer;
      function autoTriggerPreview() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(function() {
          renderVideoCard();
        }, 200);
      }
      
      zoomSlider.addEventListener('change', autoTriggerPreview);
      panXSlider.addEventListener('change', autoTriggerPreview);
      panYSlider.addEventListener('change', autoTriggerPreview);
    }
    
    if (resetImgSettingsBtn) {
      resetImgSettingsBtn.addEventListener('click', function() {
        zoomSlider.value = 100;
        panXSlider.value = 0;
        panYSlider.value = 0;
        if (videoTextPanYSlider) {
          videoTextPanYSlider.value = 0;
        }
        if (videoBgPanYSlider) {
          videoBgPanYSlider.value = 0;
        }
        updateTextVerticalPosition();
        updateCardImageStyle();
        renderVideoCard();
      });
    }

    if (videoPreviewContainer) {
      var isDragging = false;
      var startX = 0;
      var startY = 0;
      var startPanX = 0;
      var startPanY = 0;

      videoPreviewContainer.addEventListener('mousedown', function(e) {
        e.preventDefault();
        isDragging = true;
        videoPreviewContainer.style.cursor = 'grabbing';
        
        startX = e.clientX;
        startY = e.clientY;
        startPanX = parseInt(panXSlider.value);
        startPanY = parseInt(panYSlider.value);
      });

      window.addEventListener('mousemove', function(e) {
        if (!isDragging) return;
        var scaleFactor = 3.375;
        var diffX = Math.round((e.clientX - startX) * scaleFactor);
        var diffY = Math.round((e.clientY - startY) * scaleFactor);
        
        var newPanX = Math.min(500, Math.max(-500, startPanX + diffX));
        var newPanY = Math.min(500, Math.max(-500, startPanY + diffY));
        
        panXSlider.value = newPanX;
        panYSlider.value = newPanY;
        
        updateCardImageStyle();
      });

      window.addEventListener('mouseup', function() {
        if (isDragging) {
          isDragging = false;
          videoPreviewContainer.style.cursor = 'grab';
          renderVideoCard();
        }
      });
      
      videoPreviewContainer.addEventListener('touchstart', function(e) {
        if (e.touches.length === 1) {
          isDragging = true;
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
          startPanX = parseInt(panXSlider.value);
          startPanY = parseInt(panYSlider.value);
        }
      });

      videoPreviewContainer.addEventListener('touchmove', function(e) {
        if (!isDragging || e.touches.length !== 1) return;
        e.preventDefault();
        var scaleFactor = 3.375;
        var diffX = Math.round((e.touches[0].clientX - startX) * scaleFactor);
        var diffY = Math.round((e.touches[0].clientY - startY) * scaleFactor);
        
        panXSlider.value = Math.min(500, Math.max(-500, startPanX + diffX));
        panYSlider.value = Math.min(500, Math.max(-500, startPanY + diffY));
        updateCardImageStyle();
      }, { passive: false });

      videoPreviewContainer.addEventListener('touchend', function() {
        if (isDragging) {
          isDragging = false;
          renderVideoCard();
        }
      });
    }

    document.addEventListener('selectionchange', function() {
      if (!videoTitleEditor) return;
      var sel = window.getSelection();
      if (sel.rangeCount > 0) {
        var r = sel.getRangeAt(0);
        if (videoTitleEditor.contains(r.commonAncestorContainer)) {
          videoSavedRange = r;
        }
      }
    });

    var videoRenderTimeout = null;
    function scheduleVideoRender() {
      if (videoRenderTimeout) clearTimeout(videoRenderTimeout);
      videoRenderTimeout = setTimeout(function() {
        renderVideoCard();
      }, 500);
    }

    function updateVideoFontSize(delta) {
      currentVideoFontSize = Math.min(130, Math.max(24, currentVideoFontSize + delta));
      if (videoCardTitle) videoCardTitle.style.fontSize = currentVideoFontSize + 'px';
      if (videoFontSizeDisplay) videoFontSizeDisplay.textContent = currentVideoFontSize + 'px';
      scheduleVideoRender();
    }

    if (videoFontIncreaseBtn) videoFontIncreaseBtn.addEventListener('click', function() { updateVideoFontSize(4); });
    if (videoFontDecreaseBtn) videoFontDecreaseBtn.addEventListener('click', function() { updateVideoFontSize(-4); });

    function applyVideoFormatting(color, isBg, isClear) {
      if (!videoSavedRange || videoSavedRange.collapsed) {
        alert("Lütfen önce biçimlendirmek istediğiniz metni seçin!");
        return;
      }
      videoTitleEditor.focus();
      var sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(videoSavedRange);

      if (isClear) {
        document.execCommand('styleWithCSS', false, true);
        document.execCommand('removeFormat', false, null);
      } else {
        try {
          var range = sel.getRangeAt(0);
          var span = document.createElement('span');
          if (isBg) {
            span.style.backgroundColor = color;
            span.style.padding = '2px 8px';
            span.style.borderRadius = '6px';
            span.style.display = 'inline-block';
            span.style.lineHeight = '1.2';
            span.style.margin = '2px 0';
          } else {
            span.style.color = color;
          }
          span.appendChild(range.extractContents());
          range.insertNode(span);
          range.setStartAfter(span);
          range.collapse(true);
          sel.removeAllRanges();
          sel.addRange(range);
        } catch (e) { console.warn('Format error:', e); }
      }
      videoCardTitle.innerHTML = videoTitleEditor.innerHTML;
      scheduleVideoRender();
    }

    if (applyVideoTextColorBtn) applyVideoTextColorBtn.addEventListener('mousedown', function(e) { e.preventDefault(); applyVideoFormatting(videoTextColorPicker.value, false, false); });
    if (applyVideoBgColorBtn) applyVideoBgColorBtn.addEventListener('mousedown', function(e) { e.preventDefault(); applyVideoFormatting(videoBgColorPicker.value, true, false); });
    if (videoClearFormatBtn) videoClearFormatBtn.addEventListener('mousedown', function(e) { e.preventDefault(); applyVideoFormatting(null, false, true); });
    
    if (videoTitleEditor && videoCardTitle) {
      videoTitleEditor.addEventListener('input', function() {
        videoCardTitle.innerHTML = this.innerHTML;
        scheduleVideoRender();
      });
    }

    function renderVideoCard(cb) {
      if (downloadVideoJpgBtn) {
        downloadVideoJpgBtn.style.pointerEvents = 'none';
        downloadVideoJpgBtn.style.opacity = '0.7';
        downloadVideoJpgBtn.innerHTML = '<span style="font-size:18px;">⏳</span><span>Hazırlanıyor...</span>';
      }

      if (videoCardImage) {
        var currentBg = videoCardImage.style.backgroundImage;
        if (currentBg && currentBg !== 'none') {
          videoCardImage.style.backgroundImage = "url('" + getLocalImageUrl(currentBg) + "')";
        }
      }
      var vLogoImgEl = videoCard ? videoCard.querySelector('img') : null;
      if (vLogoImgEl && vLogoImgEl.src) {
        vLogoImgEl.src = getLocalImageUrl(vLogoImgEl.src);
      }

      var originalBg = videoCard.style.background;
      var originalImgDisplay = videoCardImage.style.display;
      var originalVideoDisplay = videoCardVideo.style.display;
      
      if (isVideoLoaded) {
        videoCard.style.background = 'transparent';
        videoCardImage.style.display = 'none';
        videoCardVideo.style.display = 'none';
      }
      
      html2canvas(videoCard, {
        scale: 1,
        useCORS: true,
        allowTaint: true,
        backgroundColor: isVideoLoaded ? null : '#0d0d12'
      }).then(function(canvas) {
        if (isVideoLoaded) {
          videoCard.style.background = originalBg;
          videoCardImage.style.display = originalImgDisplay;
          videoCardVideo.style.display = originalVideoDisplay;
        }
        
        var img = isVideoLoaded ? canvas.toDataURL('image/png') : canvas.toDataURL('image/jpeg', 0.95);
        videoPreviewImg.src = img;
        if (downloadVideoJpgBtn) {
          downloadVideoJpgBtn.href = img;
          downloadVideoJpgBtn.style.pointerEvents = 'auto';
          downloadVideoJpgBtn.style.opacity = '1';
          downloadVideoJpgBtn.innerHTML = '<span style="font-size:18px;">📸</span><span>Görsel Olarak İndir (JPG)</span>';
        }

        if (cb) cb(img, canvas);
      }).catch(function(e) {
        console.error(e);
        alert('Dikey tasarım oluşturulurken hata oluştu. Lütfen tekrar deneyin.');
        if (downloadVideoJpgBtn) {
          downloadVideoJpgBtn.style.pointerEvents = 'auto';
          downloadVideoJpgBtn.style.opacity = '1';
          downloadVideoJpgBtn.innerHTML = '<span style="font-size:18px;">📸</span><span>Görsel Olarak İndir (JPG)</span>';
        }
      });
    }

    if (refreshVideoBtn) {
      refreshVideoBtn.addEventListener('click', function() {
        if (videoTitleEditor && videoCardTitle) {
          videoCardTitle.innerHTML = videoTitleEditor.innerHTML;
        }
        var origHtml = this.innerHTML;
        this.innerHTML = '⏳ Önizleme Güncelleniyor...';
        this.disabled = true;
        var selfBtn = this;
        renderVideoCard(function() {
          selfBtn.innerHTML = origHtml;
          selfBtn.disabled = false;
        });
      });
    }

    function openVideoCreatorModal(btnElement) {
      if (!btnElement) return;
      var origHtml = btnElement.innerHTML;
      btnElement.innerHTML = '<i class="ph-bold ph-spinner"></i> Yükleniyor...';
      btnElement.style.opacity = '0.7';
      btnElement.style.pointerEvents = 'none';
      
      // Reset editor playback control states
      isEditorPaused = false;
      isEditorMuted = false;
      if (previewPlayPauseIcon) previewPlayPauseIcon.className = 'ph-bold ph-pause';
      if (previewPlayPauseText) previewPlayPauseText.textContent = 'Duraklat';
      if (previewMuteIcon) previewMuteIcon.className = 'ph-bold ph-speaker-high';
      if (previewMuteText) previewMuteText.textContent = 'Sesi Kapat';
      if (previewMuteBtn) previewMuteBtn.style.background = '#242438';

      if (videoTitleEditor && videoCardTitle) {
        videoTitleEditor.innerHTML = videoCardTitle.innerHTML;
      }
      setTimeout(function() {
        renderVideoCard(function() {
          videoModal.style.display = 'flex';
          btnElement.innerHTML = origHtml;
          btnElement.style.opacity = '1';
          btnElement.style.pointerEvents = 'auto';
          updateLivePreviewSound();
        });
      }, 300);
    }

    if (videoBtn) {
      videoBtn.addEventListener('click', function(e) {
        e.preventDefault();
        openVideoCreatorModal(this);
      });
    }

    if (videoBtnHeader) {
      videoBtnHeader.addEventListener('click', function(e) {
        e.preventDefault();
        openVideoCreatorModal(this);
      });
    }

    if (closeVideoBtn) {
      closeVideoBtn.addEventListener('click', function() {
        videoModal.style.display = 'none';
        clearTimeout(window.lskCustomAudioTimer);
        if (videoAudioPlayer) {
          videoAudioPlayer.pause();
          videoAudioPlayer.currentTime = 0;
        }
        if (customAudioPlayer) {
          customAudioPlayer.pause();
          customAudioPlayer.currentTime = 0;
        }
        if (videoCardVideo) {
          videoCardVideo.pause();
          videoCardVideo.currentTime = 0;
          videoCardVideo.muted = true;
        }
        if (videoPreviewVideo) {
          videoPreviewVideo.pause();
          videoPreviewVideo.currentTime = 0;
          videoPreviewVideo.muted = true;
        }
      });
    }

    if (downloadVideoJpgBtn) {
      downloadVideoJpgBtn.addEventListener('click', function() {
        var origText = this.innerHTML;
        this.textContent = '📸 Görsel Hazırlanıyor...';
        this.disabled = true;
        var selfBtn = this;
        renderVideoCard(function(imgData) {
          downloadBase64(imgData, 'samsunsondakika-dikey-gorsel.jpg');
          selfBtn.innerHTML = origText;
          selfBtn.disabled = false;
        });
      });
    }

    if (downloadVideoMp4Btn) {
      downloadVideoMp4Btn.addEventListener('click', function() {
        if (videoTitleEditor && videoCardTitle) {
          videoCardTitle.innerHTML = videoTitleEditor.innerHTML;
        }
        var selfBtn = this;
        selfBtn.disabled = true;

        renderVideoCard(function(imgData, renderedCanvas) {
          videoProgressContainer.style.display = 'flex';
          videoProgressBar.style.width = '0%';
          videoProgressPercent.textContent = '0%';

          var recordingCanvas = document.createElement('canvas');
          recordingCanvas.width = 720;
          recordingCanvas.height = 1280;
          var ctx = recordingCanvas.getContext('2d');

          var stream = recordingCanvas.captureStream(29);
          
          var combinedStream = stream;
          if (videoAudioPlayer && videoAudioPlayer.src) {
            try {
              if (!window.lskAudioGraph) {
                var audioCtx = new (window.AudioContext || window.webkitAudioContext)({ latencyHint: 'playback' });
                
                // Background default music player source & gain
                var bgSource = audioCtx.createMediaElementSource(videoAudioPlayer);
                var bgGain = audioCtx.createGain();
                bgSource.connect(bgGain);
                
                // Custom user track source & gain
                var customSource = audioCtx.createMediaElementSource(customAudioPlayer);
                var customGain = audioCtx.createGain();
                customSource.connect(customGain);
                
                // Video player source & gain (Persistent)
                var videoSource = audioCtx.createMediaElementSource(videoCardVideo);
                var videoGain = audioCtx.createGain();
                videoSource.connect(videoGain);
                
                // Combined destination node
                var dest = audioCtx.createMediaStreamDestination();
                
                bgGain.connect(dest);
                bgGain.connect(audioCtx.destination);
                customGain.connect(dest);
                customGain.connect(audioCtx.destination);
                videoGain.connect(dest);
                videoGain.connect(audioCtx.destination);
                
                window.lskAudioGraph = {
                  context: audioCtx,
                  bgSource: bgSource,
                  bgGain: bgGain,
                  customSource: customSource,
                  customGain: customGain,
                  videoSource: videoSource,
                  videoGain: videoGain,
                  destination: dest
                };
              }
              
              if (window.lskAudioGraph.context.state === 'suspended') {
                window.lskAudioGraph.context.resume();
              }
              
              // Reset / Set dynamic volumes
              if (isUseOriginalSound) {
                // Background music and custom music fully muted
                window.lskAudioGraph.bgGain.gain.setValueAtTime(0.0, window.lskAudioGraph.context.currentTime);
                window.lskAudioGraph.customGain.gain.setValueAtTime(0.0, window.lskAudioGraph.context.currentTime);
                // Video sound at full volume
                window.lskAudioGraph.videoGain.gain.setValueAtTime(1.0, window.lskAudioGraph.context.currentTime);
              } else if (isMixBackgroundLow) {
                // Background music at 5% volume, custom audio at 5% volume
                window.lskAudioGraph.bgGain.gain.setValueAtTime(0.05, window.lskAudioGraph.context.currentTime);
                window.lskAudioGraph.customGain.gain.setValueAtTime(isDefaultAudio ? 0.0 : 0.05, window.lskAudioGraph.context.currentTime);
                // Video sound at full volume
                window.lskAudioGraph.videoGain.gain.setValueAtTime(1.0, window.lskAudioGraph.context.currentTime);
              } else {
                if (isDefaultAudio) {
                  // Background music at full volume, custom audio muted
                  window.lskAudioGraph.bgGain.gain.setValueAtTime(1.0, window.lskAudioGraph.context.currentTime);
                  window.lskAudioGraph.customGain.gain.setValueAtTime(0.0, window.lskAudioGraph.context.currentTime);
                } else {
                  // Background music starts at 100% volume
                  window.lskAudioGraph.bgGain.gain.setValueAtTime(1.0, window.lskAudioGraph.context.currentTime);
                  // Duck background music smoothly by 85% (volume to 0.15) at 1.0 second, fading over 0.2s
                  window.lskAudioGraph.bgGain.gain.setValueAtTime(1.0, window.lskAudioGraph.context.currentTime + 1.0);
                  window.lskAudioGraph.bgGain.gain.linearRampToValueAtTime(0.15, window.lskAudioGraph.context.currentTime + 1.2);
                  
                  // Custom audio track at 100% volume
                  window.lskAudioGraph.customGain.gain.setValueAtTime(1.0, window.lskAudioGraph.context.currentTime);
                }
                
                // Video sound mixing
                if (isVideoLoaded && !isVideoSoundMuted) {
                  window.lskAudioGraph.videoGain.gain.setValueAtTime(1.0, window.lskAudioGraph.context.currentTime);
                } else {
                  window.lskAudioGraph.videoGain.gain.setValueAtTime(0.0, window.lskAudioGraph.context.currentTime);
                }
              }
              
              var audioTrack = window.lskAudioGraph.destination.stream.getAudioTracks()[0];
              var videoTrack = stream.getVideoTracks()[0];
              combinedStream = new MediaStream([videoTrack, audioTrack]);
              
              // Play default background music immediately
              if (!isUseOriginalSound) {
                videoAudioPlayer.currentTime = 0;
                videoAudioPlayer.play();
              }
              
              // Play custom video sound if loaded
              if (isVideoLoaded) {
                videoCardVideo.muted = false; // Let the AudioContext capture the audio
                videoCardVideo.currentTime = videoTrimStart;
                videoCardVideo.play().catch(function(err){ console.log("video play failed:", err); });
              }
              
              // Play custom track exactly 1.0 second later
              if (!isDefaultAudio && !isUseOriginalSound) {
                customAudioPlayer.currentTime = 0;
                window.lskCustomAudioTimer = setTimeout(function() {
                  customAudioPlayer.play();
                }, 1000);
              }
            } catch(e) {
              console.warn('Audio capture/mixing failed, recording silently:', e);
            }
          }
          
          // Prioritize QuickTime & iOS native compatible H.264 MP4 codecs first
          var supportedMime = 'video/mp4;codecs="avc1.424028,mp4a.40.2"';
          if (!MediaRecorder.isTypeSupported(supportedMime)) {
            supportedMime = 'video/mp4;codecs=avc1';
            if (!MediaRecorder.isTypeSupported(supportedMime)) {
              supportedMime = 'video/mp4;codecs=h264';
              if (!MediaRecorder.isTypeSupported(supportedMime)) {
                supportedMime = 'video/mp4';
                if (!MediaRecorder.isTypeSupported(supportedMime)) {
                  // Fallback to WebM if MP4 is not supported on client machine
                  supportedMime = 'video/webm;codecs=vp9';
                  if (!MediaRecorder.isTypeSupported(supportedMime)) {
                    supportedMime = 'video/webm;codecs=vp8';
                    if (!MediaRecorder.isTypeSupported(supportedMime)) {
                      supportedMime = 'video/webm';
                      if (!MediaRecorder.isTypeSupported(supportedMime)) {
                        supportedMime = '';
                      }
                    }
                  }
                }
              }
            }
          }

          var mediaRecorder;
          var chunks = [];
          try {
            if (supportedMime) {
              mediaRecorder = new MediaRecorder(combinedStream, { mimeType: supportedMime, videoBitsPerSecond: 3000000 });
            } else {
              mediaRecorder = new MediaRecorder(combinedStream, { videoBitsPerSecond: 3000000 });
            }
          } catch(e) {
            console.error('MediaRecorder init error:', e);
            mediaRecorder = new MediaRecorder(combinedStream);
          }

          mediaRecorder.ondataavailable = function(e) {
            if (e.data && e.data.size > 0) {
              chunks.push(e.data);
            }
          };

          mediaRecorder.onstop = function() {
            clearTimeout(window.lskCustomAudioTimer);
            if (videoAudioPlayer) {
              videoAudioPlayer.pause();
              videoAudioPlayer.currentTime = 0;
            }
            if (customAudioPlayer) {
              customAudioPlayer.pause();
              customAudioPlayer.currentTime = 0;
            }
            if (videoCardVideo) {
              videoCardVideo.pause();
              videoCardVideo.currentTime = videoTrimStart;
              videoCardVideo.muted = true;
            }
            if (videoPreviewVideo) {
              videoPreviewVideo.currentTime = videoTrimStart;
              videoPreviewVideo.play().catch(function(e) {});
            }
            var blob = new Blob(chunks, { type: supportedMime || 'video/webm' });
            var videoUrl = URL.createObjectURL(blob);
            
            var a = document.createElement('a');
            a.href = videoUrl;
            a.download = 'samsunsondakika-dikey-video.mp4';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);

            setTimeout(function() {
              videoProgressContainer.style.display = 'none';
              selfBtn.disabled = false;
            }, 1000);
          };

          // Generate 20 floating cinematic bokeh particles
          var particles = [];
          for (var i = 0; i < 20; i++) {
            particles.push({
              x: Math.random() * 1080,
              y: Math.random() * 1920,
              radius: Math.random() * 45 + 15,
              speedY: Math.random() * 1.5 + 0.6,
              amplitudeX: Math.random() * 25 + 5,
              frequencyX: Math.random() * 0.0025 + 0.0008,
              phaseX: Math.random() * Math.PI * 2,
              opacity: Math.random() * 0.14 + 0.04
            });
          }

          if (isVideoLoaded && videoCardVideo) {
            videoCardVideo.muted = false;
            videoCardVideo.currentTime = videoTrimStart;
            videoCardVideo.play().catch(function(err){ console.log("video play failed:", err); });
          }

          mediaRecorder.start();

          var duration = videoDuration;
          var elapsed = 0;
          var fps = 29;
          var frameDuration = 1000 / fps;

          function renderNextFrame() {
            var progress = Math.min(1, elapsed / duration);

            // Synchronize the video's currentTime to match the exact frame being drawn
            // Prevent video from playing past the trim end point
            if (isVideoLoaded && videoCardVideo) {
              if (videoCardVideo.currentTime > videoTrimEnd) {
                videoCardVideo.pause();
                videoCardVideo.currentTime = videoTrimEnd;
              }
            }

            // Small delay to allow the browser's video seek and paint pipeline to catch up
            setTimeout(function() {
              requestAnimationFrame(function() {
                ctx.clearRect(0, 0, 720, 1280);

                ctx.save();
                ctx.scale(720 / 1080, 720 / 1080);

                if (isVideoLoaded) {
                  // Draw solid background color
                  ctx.fillStyle = '#0d0d12';
                  ctx.fillRect(0, 0, 1080, 1920);

                  // Draw dynamic video frame with object-fit: contain, zoom, and panning offsets
                  var vWidth = videoCardVideo.videoWidth || 1080;
                  var vHeight = videoCardVideo.videoHeight || 1920;
                  var targetW = 1080;
                  var targetH = 1920;
                  
                  var videoRatio = vWidth / vHeight;
                  var targetRatio = targetW / targetH;
                  
                  var drawW = targetW;
                  var drawH = targetH;
                  var drawX = 0;
                  var drawY = 0;
                  
                  if (videoRatio > targetRatio) {
                    // Video is wider than 9:16 (landscape) -> Fit to width
                    drawW = targetW;
                    drawH = targetW / videoRatio;
                    drawY = (targetH - drawH) / 2;
                  } else {
                    // Video is taller than 9:16 -> Fit to height
                    drawH = targetH;
                    drawW = targetH * videoRatio;
                    drawX = (targetW - drawW) / 2;
                  }

                  var zoomVal = (zoomSlider.value / 100);
                  var panXVal = parseInt(panXSlider.value);
                  var panYVal = parseInt(panYSlider.value);

                  ctx.save();
                  // Clip to full canvas (0, 0, 1080, 1920)
                  ctx.beginPath();
                  ctx.rect(0, 0, 1080, 1920);
                  ctx.clip();
                  
                  // Apply transforms with center origin (540, 960)
                  ctx.translate(540, 960);
                  ctx.scale(zoomVal, zoomVal);
                  ctx.translate(panXVal / zoomVal, panYVal / zoomVal);
                  ctx.translate(-540, -960);
                  
                  // Draw dynamic video frame
                  ctx.drawImage(videoCardVideo, drawX, drawY, drawW, drawH);
                  ctx.restore();

                  // Draw overlays (transparent image renderedCanvas containing text, logo, footer branding)
                  ctx.drawImage(renderedCanvas, 0, 0);

                } else {
                  // 1. Ken Burns Slow Zoom / Cinematic Camera Drift Effect (For static image)
                  var scale = 1 + 0.05 * progress; 
                  var dx = - (1080 * (scale - 1)) / 2;
                  var dy = - (1920 * (scale - 1)) / 2;

                  ctx.save();
                  ctx.translate(dx, dy);
                  ctx.scale(scale, scale);
                  ctx.drawImage(renderedCanvas, 0, 0);
                  ctx.restore();
                }

                // 2. Render Floating Bokeh Particles ( Cinematic Dust / Sparkles )
                particles.forEach(function(p) {
                  var currentY = p.y - p.speedY * (elapsed / 16);
                  if (currentY < -p.radius) currentY = 1920 + p.radius; 
                  
                  var currentX = p.x + Math.sin((elapsed * p.frequencyX) + p.phaseX) * p.amplitudeX;
                  if (currentX < -p.radius) currentX = 1080 + p.radius;
                  if (currentX > 1080 + p.radius) currentX = -p.radius;
                  
                  ctx.save();
                  var grad = ctx.createRadialGradient(currentX, currentY, 0, currentX, currentY, p.radius);
                  grad.addColorStop(0, 'rgba(255, 255, 255, ' + p.opacity + ')');
                  grad.addColorStop(0.5, 'rgba(255, 240, 220, ' + (p.opacity * 0.4) + ')'); 
                  grad.addColorStop(1, 'rgba(255, 255, 255, 0)');
                  ctx.fillStyle = grad;
                  ctx.beginPath();
                  ctx.arc(currentX, currentY, p.radius, 0, Math.PI * 2);
                  ctx.fill();
                  ctx.restore();
                });

                // 3. Diagonal Metallic Glint Shimmer Sweep ( Sweeps every 4 seconds )
                var shimmerProgress = (elapsed % 4000) / 4000;
                var shimmerX = shimmerProgress * 2500 - 500;
                
                ctx.save();
                var shimmerGrad = ctx.createLinearGradient(shimmerX, 0, shimmerX + 400, 1920);
                shimmerGrad.addColorStop(0, 'rgba(255, 255, 255, 0)');
                shimmerGrad.addColorStop(0.5, 'rgba(255, 255, 255, 0.08)'); 
                shimmerGrad.addColorStop(1, 'rgba(255, 255, 255, 0)');
                ctx.fillStyle = shimmerGrad;
                ctx.fillRect(0, 0, 1080, 1920);
                ctx.restore();

                // 4. Ambient pulse vignette glow
                var gradient = ctx.createRadialGradient(540, 960, 500, 540, 960, 1200);
                var glowIntensity = Math.sin(elapsed / 500) * 0.15 + 0.15;
                gradient.addColorStop(0, 'rgba(0,0,0,0)');
                gradient.addColorStop(0.8, 'rgba(0, 92, 151, ' + (glowIntensity * 0.3) + ')');
                gradient.addColorStop(1, 'rgba(54, 55, 149, ' + (glowIntensity * 0.6) + ')');
                ctx.fillStyle = gradient;
                ctx.fillRect(0, 0, 1080, 1920);

                // 5. Timeline bar and text
                ctx.fillStyle = 'rgba(0, 0, 0, 0.6)';
                ctx.fillRect(80, 1780, 920, 16);
                ctx.strokeStyle = 'rgba(255,255,255,0.1)';
                ctx.lineWidth = 2;
                ctx.strokeRect(80, 1780, 920, 16);

                var timelineGrad = ctx.createLinearGradient(80, 0, 1000, 0);
                timelineGrad.addColorStop(0, '#00c6ff');
                timelineGrad.addColorStop(0.5, '#0072ff');
                timelineGrad.addColorStop(1, '#ff007f');
                ctx.fillStyle = timelineGrad;
                ctx.fillRect(80, 1780, 920 * progress, 16);

                ctx.fillStyle = '#ffffff';
                ctx.font = 'bold 22px "Inter", sans-serif';
                ctx.textAlign = 'right';
                ctx.fillText(Math.round(progress * 100) + '%', 1000, 1760);

                ctx.restore();

                var percentVal = Math.round(progress * 100);
                videoProgressBar.style.width = percentVal + '%';
                videoProgressPercent.textContent = percentVal + '%';
                
                var totalSecs = Math.round(duration / 1000);
                videoProgressText.textContent = 'Görüntü işleniyor... (' + Math.round(elapsed / 1000) + '/' + totalSecs + ' saniye)';

                if (progress < 1) {
                  elapsed += frameDuration;
                  renderNextFrame();
                } else {
                  mediaRecorder.stop();
                }
              });
            }, 30);
          }

          renderNextFrame();
        });
      });
    }
  }
});
</script>

