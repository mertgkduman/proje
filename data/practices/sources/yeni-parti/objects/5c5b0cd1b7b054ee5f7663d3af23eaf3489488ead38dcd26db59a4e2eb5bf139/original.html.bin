<!-- Çerez (Cookie) Uyarısı -->
<style>
.cookie-banner {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    background: #111827; color: #f3f4f6;
    padding: 15px 20px;
    z-index: 9999;
    display: flex; justify-content: space-between; align-items: center; gap: 20px;
    box-shadow: 0 -10px 30px rgba(0,0,0,0.3);
    transform: translateY(110%);
    will-change: transform;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    font-family: 'Inter', sans-serif;
}
.cookie-banner.show { transform: translateY(0); }
.cookie-text { font-size: 14px; line-height: 1.5; }
.cookie-text a { color: #38bdf8; text-decoration: underline; font-weight: 600; }
.cookie-btn {
    background: #047857; color: #fff;
    border: none; border-radius: 8px;
    padding: 10px 24px; font-weight: 700; font-size: 14px;
    cursor: pointer; transition: background 0.3s;
    white-space: nowrap;
}
.cookie-btn:hover { background: #065f46; }

.cookie-mini-icon {
    position: fixed; bottom: 20px; left: 20px;
    background: #111827; color: #f3f4f6;
    width: 44px; height: 44px;
    border-radius: 50%;
    display: flex; justify-content: center; align-items: center;
    cursor: pointer; z-index: 9998;
    box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    transition: transform 0.3s, opacity 0.3s;
    opacity: 0; pointer-events: none; transform: scale(0.5);
}
.cookie-mini-icon:hover { transform: scale(1.1); background: #1f2937; }
.cookie-mini-icon.show { opacity: 1; pointer-events: auto; transform: scale(1); }

@media (max-width: 768px) {
    .cookie-banner { flex-direction: column; text-align: center; padding: 20px; }
    .cookie-btn { width: 100%; }
    .cookie-mini-icon { bottom: 15px; left: 15px; width: 40px; height: 40px; }
}
</style>

<div class="cookie-banner" id="cookieBanner">
    <div class="cookie-text">
        Daha iyi bir kullanıcı deneyimi sunabilmek için çerezler (cookies) kullanıyoruz. Sitemizi kullanarak <a href="/gizlilik/">Gizlilik Sözleşmesi</a> ve <a href="/kvkk/">K.V.K.K Politikasını</a> kabul etmiş sayılırsınız.
    </div>
    <button class="cookie-btn" id="acceptCookies">Kabul Ediyorum</button>
</div>

<div class="cookie-mini-icon" id="cookieMiniIcon" title="Çerez Ayarları">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"/>
        <path d="M8.5 8.5v.01"/>
        <path d="M16 15.5v.01"/>
        <path d="M12 12v.01"/>
        <path d="M11 17v.01"/>
        <path d="M7 14v.01"/>
    </svg>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    const banner = document.getElementById("cookieBanner");
    const miniIcon = document.getElementById("cookieMiniIcon");
    const acceptBtn = document.getElementById("acceptCookies");

    // Çerez kontrolü 1 yıllık expire için
    const getCookie = (name) => {
        const value = `; ${document.cookie}`;
        const parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(';').shift();
    };

    const setCookie = (name, value, days) => {
        let expires = "";
        if (days) {
            const date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
            expires = "; expires=" + date.toUTCString();
        }
        document.cookie = name + "=" + (value || "") + expires + "; path=/";
    };

    const consent = getCookie("cookie_consent_accepted");

    if (!consent) {
        setTimeout(function() { banner.classList.add("show"); }, 1000);
    } else {
        miniIcon.classList.add("show");
    }

    acceptBtn.addEventListener("click", function() {
        setCookie("cookie_consent_accepted", "yes", 365); // 1 yıl geçerli
        banner.classList.remove("show");
        setTimeout(() => { miniIcon.classList.add("show"); }, 500);
    });

    miniIcon.addEventListener("click", function() {
        miniIcon.classList.remove("show");
        banner.classList.add("show");
    });
});
</script>

<!-- ========== GLOBAL GÖRSEL FALLBACK ========== -->
<script>
(function () {
    var FALLBACK = window.BASE_PATH + '/uploads/haber.webp';
    // Yazar/logo görselleri hariç tüm kırık img'leri yakala
    var SKIP = ['/yazarlar/', '/ylogo', 'demo.jpg', 'haber.webp'];
    function applyFallback(img) {
        var src = img.getAttribute('src') || '';
        if (SKIP.some(function(s){ return src.indexOf(s) !== -1; })) return;
        if (src === FALLBACK) return;
        img.onerror = null;
        img.src = FALLBACK;
    }
    // Sayfa yüklendiğinde mevcut kırık görseller
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('img').forEach(function (img) {
            if (!img.complete || img.naturalWidth === 0) {
                img.addEventListener('error', function () { applyFallback(img); });
                if (img.complete && img.naturalWidth === 0) applyFallback(img);
            }
        });
    });
    // Dinamik eklenen görseller için delegation
    document.addEventListener('error', function (e) {
        if (e.target && e.target.tagName === 'IMG') applyFallback(e.target);
    }, true);
})();
</script>

