<!-- Hava Durumu & Finans Veri Yükleyici (includes/weather-finance.php) -->
<script>
(function () {
    'use strict';

    /* ---- YARDIMCI FONKSİYONLAR ---- */
    function fmtNum(n, dec) {
        if (!n) return '--';
        dec = dec !== undefined ? dec : 2;
        return parseFloat(n).toLocaleString('tr-TR', {
            minimumFractionDigits: dec,
            maximumFractionDigits: dec
        });
    }

    // WMO hava kodu → {label, emoji/SVG sınıfı}
    var weatherCodes = {
        0:  { label: 'Açık',            icon: '☀️' },
        1:  { label: 'Çoğunlukla Açık', icon: '🌤️' },
        2:  { label: 'Parçalı Bulutlu', icon: '⛅' },
        3:  { label: 'Bulutlu',         icon: '☁️' },
        45: { label: 'Sisli',           icon: '🌫️' },
        48: { label: 'Kırağılı Sis',    icon: '🌫️' },
        51: { label: 'Hafif Çisenti',   icon: '🌦️' },
        53: { label: 'Orta Çisenti',    icon: '🌦️' },
        55: { label: 'Yoğun Çisenti',   icon: '🌧️' },
        61: { label: 'Hafif Yağmur',    icon: '🌧️' },
        63: { label: 'Orta Yağmur',     icon: '🌧️' },
        65: { label: 'Şiddetli Yağmur', icon: '🌧️' },
        71: { label: 'Kar',             icon: '🌨️' },
        73: { label: 'Orta Kar',        icon: '❄️' },
        75: { label: 'Yoğun Kar',       icon: '❄️' },
        80: { label: 'Sağanak',         icon: '🌦️' },
        81: { label: 'Orta Sağanak',    icon: '🌧️' },
        82: { label: 'Şiddetli Sağanak',icon: '⛈️' },
        95: { label: 'Fırtına',         icon: '⛈️' },
        96: { label: 'Dolu',            icon: '⛈️' },
        99: { label: 'Yoğun Dolu',      icon: '⛈️' }
    };

    function applyFinanceAndWeather(d) {
        if (!d) return;
        window.__ssdFinanceData = d;
        try {
            window.dispatchEvent(new CustomEvent('ssd:finance', { detail: d }));
        } catch (err) {}

        // POUND, USD, EUR, ALTIN (GR)
        ['gbp', 'usd', 'eur', 'gold'].forEach(function(key) {
            var el = document.getElementById('fin-' + key);
            if (el) {
                if (d[key]) {
                    el.innerHTML = '<span>' + fmtNum(d[key]) + '</span> <small class="fin-up">₺</small>';
                } else {
                    el.textContent = '--';
                }
            }
        });

        // BITCOIN
        var elBtc = document.getElementById('fin-btc');
        if (elBtc) {
            if (d.btc && d.btc.price) {
                var change = d.btc.change || 0;
                var arrow  = change >= 0 ? '▲' : '▼';
                var cls    = change >= 0 ? 'fin-up' : 'fin-down';
                var priceStr = Math.round(d.btc.price).toLocaleString('tr-TR');
                elBtc.innerHTML = '<span>₺' + priceStr + '</span> <small class="' + cls + '">' + arrow + ' ' + Math.abs(change).toFixed(2) + '%</small>';
            } else {
                elBtc.textContent = '--';
            }
        }

        // HAVA DURUMU
        if (d.weather && d.weather.temp !== null && d.weather.temp !== undefined) {
            var info = weatherCodes[d.weather.code] || { label: 'Açık', icon: '🌡️' };
            var iconEl  = document.getElementById('wx-icon');
            var tempEl  = document.getElementById('wx-temp');
            var descEl  = document.getElementById('wx-desc');

            if (iconEl) iconEl.textContent = info.icon;
            if (tempEl) tempEl.textContent = d.weather.temp + '°C';
            if (descEl) descEl.textContent = info.label + ' · 💨 ' + d.weather.wind + ' km/s';
        }
    }

    /* ---- TARİH ---- */
    var dateEl = document.getElementById('topbar-date');
    if (dateEl) {
        var now  = new Date();
        var days = ['Pazar','Pazartesi','Salı','Çarşamba','Perşembe','Cuma','Cumartesi'];
        var months = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran',
                      'Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];
        var str = days[now.getDay()] + ', ' +
                  now.getDate() + ' ' +
                  months[now.getMonth()] + ' ' +
                  now.getFullYear();
        dateEl.textContent = str;
    }

    /* ---- INLINE CACHE VERİSİ VARSA ANINDA BAS (0ms GECİKME & 0 CLS) ---- */
        applyFinanceAndWeather({"gbp":66.2801,"usd":50.4936,"eur":55.397,"gold":5706.9204893339975,"oil":89.95,"btc":{"price":3037509,"change":2.0512419255704937},"currencies":[{"code":"USD","name":"ABD DOLARI","price":50.4936},{"code":"AUD","name":"AVUSTRALYA DOLARI","price":33.7377},{"code":"DKK","name":"DANİMARKA KRONU","price":7.4228},{"code":"EUR","name":"EURO","price":55.397},{"code":"GBP","name":"İNGİLİZ STERLİNİ","price":66.2801},{"code":"CHF","name":"İSVİÇRE FRANGI","price":60.0964},{"code":"SEK","name":"İSVEÇ KRONU","price":4.9711},{"code":"CAD","name":"KANADA DOLARI","price":35.2994},{"code":"KWD","name":"KUVEYT DİNARI","price":164.3241},{"code":"NOK","name":"NORVEÇ KRONU","price":5.1822},{"code":"SAR","name":"SUUDİ ARABİSTAN RİYALİ","price":13.4582},{"code":"JPY","name":"JAPON YENİ","price":31.8372},{"code":"RON","name":"RUMEN LEYİ","price":10.4136},{"code":"RUB","name":"RUS RUBLESİ","price":0.6199},{"code":"CNY","name":"ÇİN YUANI","price":7.6063},{"code":"PKR","name":"PAKİSTAN RUPİSİ","price":0.18369},{"code":"QAR","name":"KATAR RİYALİ","price":13.9355},{"code":"KRW","name":"GÜNEY KORE WONU","price":0.03797},{"code":"AZN","name":"AZERBAYCAN YENİ MANATI","price":29.8683},{"code":"AED","name":"BİRLEŞİK ARAP EMİRLİKLERİ DİRHEMİ","price":13.8254},{"code":"KZT","name":"KAZAKİSTAN TENGESİ","price":0.11173}],"time":1795301310,"weather":{"temp":12,"code":95,"wind":5,"city":"Samsun","time":1795300673}});
    
    /* ---- CACHE SÜRESİ DOLDUYSA VEYA YOKSA ARKA PLANDA GÜNCELLE ---- */
    
})();
</script>

