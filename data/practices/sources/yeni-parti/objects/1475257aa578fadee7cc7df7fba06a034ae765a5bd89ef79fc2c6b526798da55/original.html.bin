                    <div id="fl-idari-teskilat">
                        <span>
                            <a href="javascript:void(0)" onclick="MobilFooterMenuAcKapat('idariTeskilat')">       
                                İdari Teşkilat
                                <img src="/img/footer_asaga_ok.png" />
                            </a>
                        </span>
                        <ul id="idariTeskilat">
