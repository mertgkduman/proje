    <script>
        (function () {
            const savedTheme = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

            if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <title>Yeni Parti Samsun İl Kongresinde Tüzük Tartışması</title>
    <meta name="description" content="Yeni Parti Samsun 1. Olağan İl Kongresi’nde parti üyeleri, delegeler ve yöneticiler bir araya gelirken, konuşmalarda parti içi demokrasi ve üye iradesi vurgusu öne çıktı. Kongrede söz almak isteyen bir parti üyesi ile divan arasında tüzük ve genel kurulda konuşma hakkı konusunda tartışma yaşandı." />
