            <!-- Comments Section -->
            <div class="mt-8 bg-white dark:bg-gray-800 border border-gray-100 dark:border-gray-700 rounded-lg p-6 md:p-8 shadow-sm no-print"
                 x-data="{ 
                    comments: [],
                    newName: '',
                    newEmail: '',
                    newText: '',
                    submitting: false,
                    newsId: 19486,
                    showSuccess: false,
                    async init() {
                        this.fetchComments();
                    },
                    async fetchComments() {
                        try {
                            const response = await fetch(`/api/comments/${this.newsId}`);
                            this.comments = await response.json();
                        } catch (error) {
                            console.error('Comments fetch error:', error);
                        }
                    },
                    async submitComment() {
                        if(!this.newName || !this.newText) return;
                        this.submitting = true;
                        this.showSuccess = false;
                        
                        try {
                            const response = await fetch('/api/comments', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-CSRF-TOKEN': 'EZsaeClcCEz1ibLhGWTEVT12d9jNOvaKz1aZyKfB'
                                },
                                body: JSON.stringify({
                                    content_id: this.newsId,
                                    name: this.newName,
                                    email: this.newEmail,
                                    text: this.newText
                                })
                            });

                            if (response.ok) {
                                this.showSuccess = true;
                                this.newName = '';
                                this.newEmail = '';
                                this.newText = '';
                                // We don't push to comments array because it needs approval
                            } else {
                                const data = await response.json();
                                alert(data.message || 'Bir hata oluştu.');
                            }
                        } catch (error) {
                            console.error('Comment submit error:', error);
                            alert('Sistem hatası oluştu.');
                        } finally {
                            this.submitting = false;
                        }
                    }
                }">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
                    <span class="material-icons">chat_bubble</span>
                    Yorumlar <span class="bg-gray-100 dark:bg-gray-800 text-red-600 text-xs px-2 py-0.5 rounded-full" x-text="comments.length">0</span>
                </h3>

                <!-- Success Message -->
                <div x-show="showSuccess" x-cloak class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
                    <strong class="font-bold">Teşekkürler!</strong>
                    <span class="block sm:inline">Yorumunuz başarıyla gönderildi ve yönetici onayı bekliyor.</span>
                </div>

                <!-- Form -->
                <div class="bg-gray-50 dark:bg-gray-700/50 p-6 rounded-lg mb-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Ad Soyad</label>
                            <input type="text" x-model="newName" placeholder="Adınız Soyadınız" class="w-full rounded border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500 focus:border-red-600 focus:ring-red-600 text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">E-posta</label>
                            <input type="email" x-model="newEmail" placeholder="E-posta adresiniz (Yayınlanmaz)" class="w-full rounded border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500 focus:border-red-600 focus:ring-red-600 text-sm">
                        </div>
                    </div>
                    <div class="mb-4">
                         <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">İçerik</label>
                        <textarea x-model="newText" rows="3" placeholder="Yorumunuzu buraya yazın..." class="w-full rounded border-gray-300 dark:border-gray-600 dark:bg-gray-800 dark:text-white dark:placeholder-gray-500 focus:border-red-600 focus:ring-red-600 text-sm"></textarea>
                    </div>
                    <button @click="submitComment()" :disabled="submitting" class="bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-6 rounded transition text-sm disabled:opacity-50">
                        <span x-text="submitting ? 'Gönderiliyor...' : 'Yorum Yap'"></span>
                    </button>
                </div>

                <!-- List -->
                <div class="space-y-6">
                    <template x-for="comment in comments" :key="comment.id">
                        <div class="flex gap-4">
                            <div class="w-10 h-10 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center font-bold text-gray-500 dark:text-gray-400 shrink-0" x-text="comment.name.charAt(0).toUpperCase()"></div>
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="font-bold text-gray-900 dark:text-white text-sm" x-text="comment.name"></span>
                                    <span class="text-xs text-gray-500" x-text="new Date(comment.created_at).toLocaleDateString('tr-TR')"></span>
                                </div>
                                <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed" x-text="comment.comment"></p>
                            </div>
                        </div>
                    </template>
                    <div x-show="comments.length === 0" class="text-center text-gray-500 dark:text-gray-400 py-4 text-sm">
                        İlk yorumu siz yapın!
                    </div>
                </div>
            </div>
        </article>

