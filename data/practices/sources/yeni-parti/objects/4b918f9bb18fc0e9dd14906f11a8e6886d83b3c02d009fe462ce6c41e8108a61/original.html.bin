    <!-- Breaking News Ticker -->
            <div class="ilkadim-breaking-ticker bg-gray-100 dark:bg-slate-900 border-b border-gray-200 dark:border-slate-800 overflow-hidden relative h-10 flex items-center">
        <div class="container mx-auto max-w-[1280px] px-4 flex items-center">
            <span class="bg-red-700 text-white text-[10px] font-bold px-3 py-1 mr-4 whitespace-nowrap">Son Dakika</span>
