                    <button @click="fontSize = 'font-normal'; localStorage.setItem('fontSize', 'font-normal')" 
                            :class="fontSize === 'font-normal' ? 'bg-red-600 text-white' : 'bg-gray-200 text-gray-700 dark:bg-gray-600 dark:text-gray-300'"
                            class="w-8 h-8 rounded font-bold text-sm transition">A</button>
                    <button @click="fontSize = 'font-large'; localStorage.setItem('fontSize', 'font-large')" 
                            :class="fontSize === 'font-large' ? 'bg-red-600 text-white' : 'bg-gray-200 text-gray-700 dark:bg-gray-600 dark:text-gray-300'"
