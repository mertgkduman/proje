<body class="bg-white dark:bg-slate-950 font-sans antialiased text-gray-900 dark:text-gray-100 transition-colors duration-300" 
      x-data="{ 
          mobileMenuOpen: false,
          darkMode: document.documentElement.classList.contains('dark'),
          cookieConsent: localStorage.getItem('cookieConsent') === 'true',
          setTheme(isDark) {
              this.darkMode = isDark;
              document.documentElement.classList.toggle('dark', isDark);
              localStorage.setItem('theme', isDark ? 'dark' : 'light');
          },
          toggleTheme() {
              this.setTheme(!this.darkMode);
          }
      }"
      x-init="setTheme(darkMode)">

    <!-- TOP BANNER AREA -->
        <div class="flex bg-gray-100 dark:bg-gray-800 py-3 border-b border-gray-200 dark:border-gray-700 justify-center items-center">
        <div class="container mx-auto px-4 flex justify-center">
            <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8194078404210111"
     crossorigin="anonymous"></script>
        </div>
    </div>
         <!-- BLACK TOP BAR -->
    <div class="bg-black text-white text-[11px] font-medium border-b border-gray-800 relative z-50">
        <div class="container mx-auto max-w-[1280px] px-4 h-9 flex justify-between items-center">
            <!-- Left Side Links -->
            <div class="flex items-center space-x-4">
                <a class="flex items-center gap-1.5 hover:text-gray-300 transition-colors" href="https://samsunilkhaber.com.tr/foto-galeri">
                    <span class="material-icons text-sm">photo_camera</span> <span>Foto Galeriler</span>
                </a>
                <a class="flex items-center gap-1.5 hover:text-gray-300 transition-colors" href="https://samsunilkhaber.com.tr/videolar">
                    <span class="material-icons text-sm">videocam</span> <span>Video</span>
                </a>
            </div>

            <!-- Right Side Widgets -->
            <div class="flex items-center gap-4 text-[12px]" 
                 x-data="{ 
                    markets: [], 
                    currentMarketIndex: 0,
                    weather: null,
                    cities: ['Adana', 'Adıyaman', 'Afyonkarahisar', 'Ağrı', 'Aksaray', 'Amasya', 'Ankara', 'Antalya', 'Ardahan', 'Artvin', 'Aydın', 'Balıkesir', 'Bartın', 'Batman', 'Bayburt', 'Bilecik', 'Bingöl', 'Bitlis', 'Bolu', 'Burdur', 'Bursa', 'Çanakkale', 'Çankırı', 'Çorum', 'Denizli', 'Diyarbakır', 'Düzce', 'Edirne', 'Elazığ', 'Erzincan', 'Erzurum', 'Eskişehir', 'Gaziantep', 'Giresun', 'Gümüşhane', 'Hakkari', 'Hatay', 'Iğdır', 'Isparta', 'İstanbul', 'İzmir', 'Kahramanmaraş', 'Karabük', 'Karaman', 'Kars', 'Kastamonu', 'Kayseri', 'Kırıkkale', 'Kırklareli', 'Kırşehir', 'Kilis', 'Kocaeli', 'Konya', 'Kütahya', 'Malatya', 'Manisa', 'Mardin', 'Mersin', 'Muğla', 'Muş', 'Nevşehir', 'Niğde', 'Ordu', 'Osmaniye', 'Rize', 'Sakarya', 'Samsun', 'Şanlıurfa', 'Siirt', 'Sinop', 'Sivas', 'Şırnak', 'Tekirdağ', 'Tokat', 'Trabzon', 'Tunceli', 'Uşak', 'Van', 'Yalova', 'Yozgat', 'Zonguldak'],
                    selectedCity: 'Samsun',
                    loading: true,
                    init() {
                        this.fetchWidgets();
                        setInterval(() => {
                            if (this.markets.length > 0) {
                                this.currentMarketIndex = (this.currentMarketIndex + 1) % this.markets.length;
                            }
                        }, 3000); 
                    },
                    fetchWidgets() {
                        fetch(`/api/widgets?city=${this.selectedCity}`)
                            .then(r => r.json())
                            .then(d => {
                                this.markets = d.markets || [];
                                this.weather = d.weather || null;
                                this.loading = false;
                            })
                            .catch(() => { this.loading = false; });
                    },
                    changeCity() {
                        this.fetchWidgets();
                    }
                 }">
                
                <!-- Market Widget -->
                <div class="hidden sm:flex items-center justify-end min-w-[200px] border-r border-gray-800 pr-4">
                    <template x-if="loading">
                         <span class="text-gray-500 animate-pulse">Piyasalar...</span>
                    </template>
                    <template x-if="!loading && markets.length > 0">
                        <div class="flex items-center gap-1.5 font-bold">
                            <span class="text-white uppercase" x-text="markets[currentMarketIndex].name"></span>
                            <span class="material-icons text-[10px]" 
                                  :class="markets[currentMarketIndex].isUp ? 'text-green-500' : 'text-red-500'"
                                  x-text="markets[currentMarketIndex].isUp ? 'arrow_upward' : 'arrow_downward'"></span>
                            <span class="text-white" x-text="markets[currentMarketIndex].value"></span>
                            <span :class="markets[currentMarketIndex].isUp ? 'text-green-500' : 'text-red-500'"
                                  x-text="'%' + markets[currentMarketIndex].changeRate"></span>
                        </div>
                    </template>
                </div>

                <!-- Weather Widget -->
                <div class="relative" x-data="{ open: false }">
                    <div class="cursor-pointer" @click="open = !open">
                        <template x-if="weather">
                            <div class="flex items-center gap-1.5 font-bold text-white whitespace-nowrap">
                                <span x-text="weather.temperature + '°'"></span>
                                <span class="material-symbols-outlined text-[18px] text-yellow-500" x-text="weather.icon"></span>
                                <span x-text="selectedCity"></span>
                                <span class="material-symbols-outlined text-[16px] text-gray-400">expand_more</span>
                            </div>
                        </template>
                    </div>

                    <!-- Weather Dropdown -->
                    <div x-show="open" x-transition x-cloak @click.away="open = false" 
                         class="absolute right-0 top-full mt-2 w-64 bg-white dark:bg-gray-800 rounded-lg shadow-xl border border-gray-200 dark:border-gray-700 p-4 z-50 text-gray-800 dark:text-gray-200">
                        <div class="mb-4">
                            <label class="text-[10px] font-bold text-gray-500 uppercase">Şehir Seçin</label>
                            <select class="w-full bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded p-1.5 text-xs text-gray-700 dark:text-gray-300"
                                    x-model="selectedCity" @change="changeCity()">
                                <template x-for="city in cities">
                                    <option :value="city" x-text="city"></option>
                                </template>
                            </select>
                        </div>
                        <template x-if="weather && weather.weeklyForecast">
                            <div class="grid grid-cols-4 gap-1 text-center">
                                <template x-for="day in weather.weeklyForecast">
                                    <div class="flex flex-col items-center p-1 rounded hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors">
                                        <span class="text-[9px] text-gray-500 font-bold" x-text="day.day.substring(0, 3)"></span>
                                        <span class="material-symbols-outlined text-xs my-0.5" x-text="day.icon"></span>
                                        <span class="text-[10px] font-bold" x-text="day.maxTemp + '°'"></span>
                                    </div>
                                </template>
                            </div>
                        </template>
                    </div>
                </div>

                <!-- Auth Link -->
                                    <a class="pl-2 flex items-center gap-1.5 hover:text-primary transition-colors duration-200 text-white" href="/giris">
                        <span class="material-icons text-[18px]">login</span>
                        <span>Giriş Yap</span>
                    </a>
                            </div>
        </div>
    </div>

