var cookieadmin_policy = {"cookieadmin_layout":"box","cookieadmin_modal":"center","cookieadmin_position":"bottom_left","cookieadmin_days":"365","cookieadmin_notice_title":"Gizlili\u011finize sayg\u0131 duyuyoruz.","cookieadmin_notice":"\u00c7erezler, deneyiminizi geli\u015ftirmemize, size ki\u015fiselle\u015ftirilmi\u015f i\u00e7erik sunmam\u0131za ve trafi\u011fi analiz etmemize yard\u0131mc\u0131 olur. Hangi \u00e7erezlere izin verece\u011finizi \u003Cb\u003E\u00d6zelle\u015ftir\u003C/b\u003E se\u00e7ene\u011fine t\u0131klayarak se\u00e7ebilirsiniz. Gerekli olmayan \u00e7erezlere onay vermek i\u00e7in \u003Cb\u003ET\u00fcm\u00fcn\u00fc Kabul Et\u003C/b\u003E, reddetmek i\u00e7in ise \u003Cb\u003ET\u00fcm\u00fcn\u00fc Reddet\u003C/b\u003E se\u00e7ene\u011fine t\u0131klay\u0131n.\r\n","cookieadmin_preference_title":"\u00c7erez tercihlerinizi \u00f6zelle\u015ftirin.","cookieadmin_preference":"Sorunsuz bir gezinme sa\u011flamak ve temel site i\u015flevlerini etkinle\u015ftirmek i\u00e7in \u00e7erezleri kullan\u0131yoruz. A\u015fa\u011f\u0131da her bir \u00e7erez kategorisi hakk\u0131nda detayl\u0131 bilgileri inceleyebilirsiniz. \u003Cbr /\u003E \u003Cb\u003EGerekli\u003C/b\u003E olarak i\u015faretlenen \u00e7erezler, temel site i\u015flevleri i\u00e7in zorunlu oldu\u011fundan taray\u0131c\u0131n\u0131zda saklan\u0131r. \u003Cb\u003EBu \u00e7erezler GDPR kapsam\u0131nda sizin onay\u0131n\u0131z\u0131 gerektirmez.\u003C/b\u003E \u003Cbr /\u003EAyr\u0131ca site kullan\u0131m\u0131n\u0131 analiz etmek, tercihlerinizi hat\u0131rlamak ve size uygun i\u00e7erik ve reklamlar sunmak i\u00e7in \u00fc\u00e7\u00fcnc\u00fc taraf \u00e7erezlerini de kullan\u0131yoruz. Bu \u00e7erezler yaln\u0131zca sizin onay\u0131n\u0131zla etkinle\u015ftirilecektir. Bu \u00e7erezleri etkinle\u015ftirmeyi veya devre d\u0131\u015f\u0131 b\u0131rakmay\u0131 se\u00e7ebilirsiniz; ancak baz\u0131 \u00e7erez t\u00fcrlerini kapatman\u0131n gezinme deneyiminizi etkileyebilece\u011fini l\u00fctfen unutmay\u0131n.\r\n","reConsent_title":"Modify Cookie Preferences","cookieadmin_notice_title_color":"#000000","cookieadmin_notice_color":"#000000","cookieadmin_consent_inside_bg_color":"#ffffff","cookieadmin_consent_inside_border_color":"#abb8c3","cookieadmin_preference_title_color":"#000000","cookieadmin_details_wrapper_color":"#000000","cookieadmin_cookie_modal_bg_color":"#ffffff","cookieadmin_cookie_modal_border_color":"#000000","cookieadmin_customize_btn":"\u00d6zelle\u015ftir","cookieadmin_customize_btn_color":"#000000","cookieadmin_customize_btn_bg_color":"#ffffff","cookieadmin_reject_btn":"T\u00fcm\u00fcn\u00fc Reddet","cookieadmin_reject_btn_color":"#000000","cookieadmin_reject_btn_bg_color":"#ffffff","cookieadmin_accept_btn":"T\u00fcm\u00fcn\u00fc Kabul Et","cookieadmin_accept_btn_color":"#ffffff","cookieadmin_accept_btn_bg_color":"#1863dc","cookieadmin_save_btn":"Tercihlerimi Kaydet","cookieadmin_save_btn_color":"#ffffff","cookieadmin_save_btn_bg_color":"#1863dc","cookieadmin_slider_off_bg_color":"#808080","cookieadmin_slider_on_bg_color":"#3582C4","cookieadmin_links_color":"#1863dc","cookieadmin_geo_tgt":"www","cookieadmin_reconsent_icon":"","cookieadmin_reconsent_img_url":"","cookieadmin_re_consent_bg_color":"#374FD4","cookieadmin_privacy_policy":"","cookieadmin_cookie_policy":"","cookieadmin_privacy_policy_banner":"0","cookieadmin_privacy_policy_pref":"0","cookieadmin_policy_link_color":"#cbba8d","ajax_url":"https://gazetepano.com/wp-admin/admin-ajax.php","nonce":"c097fe0a9d","http_cookies":[],"home_url":"https://gazetepano.com","plugin_url":"https://gazetepano.com/wp-content/plugins/cookieadmin","is_pro":"0","ssl":"1","base_path":"/","lang":{"show_less":"Show less","duration":"Duration","session":"Session","days":"Days"},"categorized_cookies":[]};
