<style id="wp-custom-css">
/* =========================================================
   GazetePano – düzenlenmiş özel CSS
   ========================================================= */

/* ---------- Köşe yazısı başlık altı renk değişkeni ---------- */
.kanews-article-title + p {
  --kan-text-color: #f00;
}

/* ---------- Yazar kartı ---------- */
.kanews-profile-card {
  position: relative;
  display: block;
  text-decoration: none;
  color: inherit;
  transition: transform .25s ease, box-shadow .25s ease;
}

.kanews-profile-card:hover {
  transform: translateY(-6px) scale(1.03);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.15);
}

/* Kartın tamamını tıklanabilir yapan katman */
.kanews-profile-card-link {
  position: absolute;
  inset: 0;
  display: block;
  z-index: 5;
}

.kanews-profile-card-header,
.kanews-profile-card-body,
.kanews-profile-card-footer {
  position: relative;
  z-index: 6;
}

/* Yazar kartlarında takipçi sayısını gizle */
.kanews-profile-info {
  display: none !important;
}

/* ---------- Manşet başlığı ---------- */
h3.kanews-slide-headline span {
  display: inline;
  line-height: 1.3em;
  /* Satır aşağı düştüğünde padding her satıra uygulanır */
  -webkit-box-decoration-break: clone;
  box-decoration-break: clone;
  background-color: rgba(0, 0, 0, 0.03);
  padding: 8px;
  font-size: 2.1rem;
  text-shadow:
    -2px -2px 0 #000,  2px -2px 0 #000, -2px  2px 0 #000,  2px  2px 0 #000,
    -2px  0    0 #000,  2px  0    0 #000,  0   -2px 0 #000,  0    2px 0 #000;
}

/* Manşet başlığı – masaüstü */
@media (min-width: 1200px) {
  .kanews-slider-global .kanews-slide-content .kanews-slide-headline {
    font-size: 32px;
  }
}

/* Manşet başlığı – masaüstü (orta) */
@media (min-width: 992px) {
  .kanews-slider-global .kanews-slide-content .kanews-slide-headline {
    font-size: 28px;
  }
}

/* Manşet başlığı – mobil */
@media (max-width: 768px) {
  .kanews-slider-global .kanews-slide-content .kanews-slide-headline {
    font-size: 18px;
  }

  h3.kanews-slide-headline span {
    font-size: 1.3rem;
  }
}

/* ---------- Manşet etiketi (highlight) ---------- */
.kanews-slide-hightlight span {
  display: inline-block;
  margin-bottom: -4px;
  padding: 8px;
  font-family: system-ui, sans-serif;
  font-size: 0.9rem;
  color: #ffffff;
  background-color: #c02d2e;
  text-transform: uppercase;
  border-radius: 2px;
}

@media (max-width: 768px) {
  .kanews-slide-hightlight span {
    margin-bottom: 6px;
    margin-left: 6px;
    padding: 8px;
    font-size: 0.75rem;
  }
}

/* ---------- Manşet overlay gradyanı ---------- */
.kanews-slider-global .kanews-slide-overlay {
  --gradient-start-color: rgba(0, 0, 0, 0.33);
  --gradient-end-color: rgba(0, 0, 0, 0);
}

/* ---------- Mobil logo ---------- */
@media (max-width: 768px) {
  /* Logo ortadaki sütunda duruyor. O sütunun position:relative'ini kaldırıp
     header'ın tamamına göre ortalanmasını sağlıyoruz. */
  .site-header .site-header-top .col.col-lg-4 {
    position: static !important;
  }

  .site-header .site-header-top .site-header-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    width: max-content;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* Tema 425px altında max-width:125px veriyor, onu eziyoruz.
     167px = logonun doğal genişliği; daha büyük istersen burayı artır. */
  .site-header .site-header-top .site-header-logo img {
    display: block;
    width: 167px;
    max-width: 100%;
    height: auto;
  }

  /* Menü ve arama butonu logonun altında kalmasın */
  .site-mobile-menu-btn,
  .site-header-top-right {
    position: relative;
    z-index: 2;
  }
}

/* ---------- Reklam alanı boşlukları ---------- */
.kanews-section.malsw_widget.kanews-section-flat {
  padding-top: 0 !important;
  margin-top: 0 !important;
}

.kanews-section .col-12.light-mode {
  padding-top: 0 !important;
}

@media (max-width: 991px) {
  .kanews_widget_ads {
    padding-bottom: 0 !important;
    margin-bottom: 0 !important;
  }
}

/* ---------- Yazarlar sayfası ---------- */

/* Yazarlar arşivindeki sayfa başlığını gizle */
body.archive.post-type-archive-columist .kanews-page-header {
  display: none !important;
}

/* Tekil köşe yazılarında öne çıkan görseli gizle */
body.single-columist article.type-columist > .kanews-article-thumbnail {
  display: none !important;
}

/* Konuk yazar sayfasındaki kutu gölgesi */
.page-id-31455 article.kanews-section-box {
  box-shadow: none !important;
  border: none !important;
}

/* ---------- Resmi Reklamlar kategorisi ---------- */
.category-resmi-reklamlar .kanews-article-content .kanews-banner {
  display: none !important;
}

/* Not: Öne çıkan görseli gizlemek istersen aşağıdaki kuralın başındaki
   yorum işaretlerini kaldır. */
/*
.category-resmi-reklamlar .kanews-article-thumbnail {
  display: none !important;
}
*/

/* ---------- Haber paylaşım butonu ---------- */
/* Sabit (sticky) kalmasını engelle */
.single-post .kanews-article-action,
.single-post .kanews-article-action-right,
.single-post .kanews-article-share {
  position: static !important;
  top: auto !important;
  bottom: auto !important;
  transform: none !important;
}

/* ---------- Sadece mobilde görünen reklam bannerı ---------- */
.gp-mobil-reklam {
  display: none;
}

@media (max-width: 768px) {
  .gp-mobil-reklam {
    display: block;
  }
}

</style>
