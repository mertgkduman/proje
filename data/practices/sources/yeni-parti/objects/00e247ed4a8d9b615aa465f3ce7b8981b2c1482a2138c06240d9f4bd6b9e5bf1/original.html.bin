<style id="ths-manset-slider-inline-inline-css">
/* Gazetepano Haber Sistemi — Manşet Slider Widget */
.malsw-widget .kanews-post-item,
.malsw-widget .kanews-post-thumb,
.malsw-widget .kanews-post-thumb img {
  border-radius: 0 !important;
}
.malsw-widget .kanews-post-item {
  box-shadow: 0 10px 26px rgba(0,0,0,.12);
  overflow: hidden;
}
.malsw-widget .kanews-post-thumb {
  position: relative;
  width: 100%;
}
.malsw-widget .kanews-post-thumb img {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover;
  display: block;
}

/* Özel manşet görseli gerçekten oluşturulduysa üst yazıyı gizle. */
.malsw-widget .ths-ps-only .kanews-post-content { display: none !important; }

/* Görünürlük yardımcı sınıfları */
.malsw-widget.ths-only-mobile{ display:none !important; }
.malsw-widget.ths-only-desktop{ display:block; }
@media (max-width: 768px){
  .malsw-widget.ths-only-mobile{ display:block !important; }
  .malsw-widget.ths-only-desktop{ display:none !important; }
}
/* One set of cards: static grid on mobile, Slick on desktop. */
.malsw-widget[data-gphs-mobile-grid="1"] .gphs-responsive-slider:not(.slick-initialized) {
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:12px;
  margin:0;
}
.malsw-widget[data-gphs-mobile-grid="1"] .gphs-responsive-slider:not(.slick-initialized) > .kanews-slider-col {
  width:auto !important;
  max-width:none;
  min-width:0;
  padding-left:0;
  padding-right:0;
}
@media (min-width:769px) and (max-width:991px) {
  .malsw-widget[data-gphs-mobile-grid="1"] .gphs-responsive-slider:not(.slick-initialized) {grid-template-columns:repeat(3,minmax(0,1fr));}
}
@media (max-width:768px) {
  .malsw-widget[data-gphs-mobile-grid="1"] .gphs-responsive-slider:not(.slick-initialized) > .gphs-mobile-extra {display:none !important;}
  .malsw-widget[data-gphs-mobile-grid="1"] .gphs-responsive-slider:not(.slick-initialized) {
    grid-template-columns:repeat(2,minmax(0,1fr));
    column-gap:14px;
    row-gap:18px;
    align-items:start;
  }
  .malsw-widget[data-gphs-mobile-grid="1"] .kanews-post-item {
    background:#fff;
    border:0;
    border-radius:0 !important;
    box-shadow:none;
    margin:0;
    padding:0;
    overflow:visible;
  }
  .malsw-widget[data-gphs-mobile-grid="1"] .kanews-post-thumb {
    aspect-ratio:3/2;
    height:auto;
    margin:0;
    overflow:hidden;
    border-radius:5px 5px 0 0 !important;
  }
  .malsw-widget[data-gphs-mobile-grid="1"] .kanews-post-thumb picture {
    display:block;
    position:absolute;
    inset:0;
    width:100%;
    height:100%;
  }
  .malsw-widget[data-gphs-mobile-grid="1"] .kanews-post-thumb img {
    position:absolute;
    inset:0;
    transform:none !important;
    width:100% !important;
    height:100% !important;
    object-fit:cover;
    border-radius:5px 5px 0 0 !important;
  }
  .malsw-widget[data-gphs-mobile-grid="1"] .kanews-post-item:not(.ths-ps-only) .kanews-post-content {
    position:relative;
    inset:auto;
    display:block;
    padding:9px 0 0 !important;
    margin:0;
    background:none;
    text-align:start;
  }
  .malsw-widget[data-gphs-mobile-grid="1"] .kanews-post-headline {
    display:-webkit-box;
    -webkit-box-orient:vertical;
    -webkit-line-clamp:2;
    line-clamp:2;
    overflow:hidden;
    text-overflow:ellipsis;
    max-height:2.9em;
    margin:0 !important;
    padding:0;
    font-size:16px !important;
    line-height:1.45 !important;
    font-weight:700;
    color:#202428;
    text-align:start;
  }
  .malsw-widget[data-gphs-mobile-grid="1"] .kanews-post-headline a {
    color:inherit !important;
    font:inherit;
    background:none !important;
    padding:0;
    text-decoration:none;
  }
  .malsw-widget[data-gphs-mobile-grid="1"] .kanews-post-content .kanews-category,
  .malsw-widget[data-gphs-mobile-grid="1"] .kanews-post-content .kanews-label {
    display:none !important;
  }
  /* Keep text baked into custom editorial images intact. */
  .malsw-widget[data-gphs-mobile-grid="1"] .ths-ps-only .kanews-post-thumb {aspect-ratio:auto;}
  .malsw-widget[data-gphs-mobile-grid="1"] .ths-ps-only .kanews-post-thumb picture {position:static;height:auto;}
  .malsw-widget[data-gphs-mobile-grid="1"] .ths-ps-only .kanews-post-thumb img {position:static;inset:auto;height:auto !important;}
}

