    <script>
    document.addEventListener('DOMContentLoaded', function () {

        const hiddenCategories = [
            '/sag-manset/',
            '/uncategorized/'
        ];

        document.querySelectorAll('.widget-accordion-menu > li').forEach(function(item) {

            const link = item.querySelector(':scope > a');

            if (!link) return;

            const url = link.getAttribute('href');

            if (hiddenCategories.some(category => url.includes(category))) {
                item.remove();
            }

        });

    });
    </script>
