ef\":\"/kategori/kultur-sanat\",\"aria-current\":\"$undefined\",\"children\":\"Kültür-Sanat\"}],[\"$\",\"a\",\"8\",{\"href\":\"/kategori/teknoloji\",\"aria-current\":\"$undefined\",\"children\":\"Teknoloji\"}]]]}],[\"$\",\"$L1d\",null,{}]]}]}]\n")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("16:[\"$\",\"div\",null,{\"className\":\"site-ad-stage\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"desktop-ad-rails\",\"aria-label\":\"Geniş ekran reklam alanları\",\"children\":[null,null]}]]}]\n")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("1f:T520,")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push([3,""])</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push([3,""])</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("21:T520,")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("\u003cp style=\"text-align: left;\"\u003e\u003cstrong\u003e\u0026nbsp;\u003c/strong\u003eYENİ Parti Genel Başkanı Özgür Özel, Karabağ Zaferi’nin altıncı yıl dönümü dolayısıyla Azerbaycan Cumhurbaşkanı İlham Aliyev ile telefon görüşmesi gerçekleştirdi.\u003c/p\u003e\u003cp style=\"text-align: left;\"\u003eYENİ Parti Genel Başkanı Özgür Özel, Azerbaycan Zafer Günü dolayısıyla Azerbaycan Cumhurbaşkanı İlham Aliyev ile telefonda görüştü. Görüşmede, Cumhurbaşkanı Aliyev’in ve kardeş Azerbaycan halkının Zafer Günü’nü kutlayan YENİ Parti Lideri Özel, Karabağ’ın özgürlüğü uğruna hayatını kaybeden şehitleri rahmetle andı.\u003c/p\u003e\u003cp style=\"text-align: left;\"\u003eÖzel, Türkiye ile Azerbaycan arasındaki tarihi kardeşlik bağlarının ve dayanışmanın önemini vurgulayarak iki ülke arasındaki ilişkilerin geliştirilmesi konusunda her türlü yapıcı katkıyı sunmaya hazır olduklarını belirtti. Özel, “Azerbaycan’ın kederi kederimiz, sevinci sevincimizdir” ifadesini kullandı.\u003c/p\u003e\u003cp style=\"text-align: left;\"\u003eCumhurbaşkanı Aliyev ise görüşmeden duyduğu memnuniyeti dile getirerek Zafer Günü kutlaması dolayısıyla teşekkür etti. YENİ Parti’nin kuruluşunu da tebrik eden Aliyev, yeni döne")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("mde Genel Başkan Özel’e ve YENİ Parti’ye başarı dileklerini iletti.\u003c/p\u003e")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("17:[\"$\",\"article\",null,{\"className\":\"article-container\",\"data-article-path\":\"/haber/ozgur-ozel-ile-ilham-aliyev-arasinda-telefon-gorusmesi\",\"data-article-title\":\"Özgür Özel ile İlham Aliyev arasında telefon görüşmesi\",\"children\":[[\"$\",\"div\",null,{\"className\":\"article-breadcrumb\",\"children\":[[\"$\",\"a\",null,{\"href\":\"/\",\"children\":\"Koza TV\"}],[\"$\",\"span\",null,{\"children\":\"›\"}],[\"$\",\"a\",null,{\"href\":\"/kategori/siyaset\",\"children\":\"Siyaset\"}]]}],[\"$\",\"span\",null,{\"className\":\"article-category\",\"children\":\"Siyaset\"}],[\"$\",\"h1\",null,{\"children\":\"Özgür Özel ile İlham Aliyev arasında telefon görüşmesi\"}],[\"$\",\"p\",null,{\"className\":\"article-spot\",\"children\":\"YENİ Parti Genel Başkanı Özgür Özel ile Azerbaycan Devlet Başkanı İlham Aliyev arasında bir telefon görüşmesi gerçekleşti. Görüşmede, Aliyev’in ve Azerbaycan halkının Zafer Günü’nü kutlayan Özel, Karabağ’ın özgürlüğü uğruna hayatını kaybeden şehitleri rahmetle andı.\"}],[\"$\",\"div\",null,{\"className\":\"article-meta\",\"children\":[[\"$\",\"div\",null,{\"className\":\"author-badge\",\"children\":\"A\"}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"a\",null,{\"className\":\"article-author\",\"href\":\"/yazar/anka\",\"children\":\"ANKA\"}],[\"$\",\"time\",null,{\"children\":\"9 Kasım 2026 14:47\"}]]}],[\"$\",\"$L1e\",null,{\"url\":\"https://www.kozatv.com.tr/haber/ozgur-ozel-ile-ilham-aliyev-arasinda-telefon-gorusmesi\",\"title\":\"Özgür Özel ile İlham Aliyev arasında telefon görüşmesi\",\"variant\":\"inline\"}]]}],[\"$\",\"figure\",null,{\"className\":\"article-figure\",\"children\":[\"$\",\"div\",null,{\"children\":[null,[\"$\",\"img\",null,{\"src\":\"/media/2026/11/5730b78ac479b32ff20c2660f1bdf8ea.jpg\",\"alt\":\"ozgurozel aliyevtelefon\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"article-layout\",\"children\":[[\"$\",\"$L1e\",null,{\"url\":\"https://www.kozatv.com.tr/haber/ozgur-ozel-ile-ilham-aliyev-arasinda-telefon-gorusmesi\",\"title\":\"Özgür Özel ile İlham Aliyev arasında telefon görüşmesi\"}],[\"$\",\"div\",null,{\"className\":\"article-body\",\"children\":[\"\",[[\"$\",\"div\",null,{\"className\":\"rich-body\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1f\"}}],[\"$\",\"$L20\",null,{\"html\":\"$21\"}]],null,null,\"$L22\",\"$L23\"]}],\"$L24\"]}]]}]\n")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("25:T1ca9,")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("\u003cp\u003eCumhurbaşkanı adayı ve İstanbul Büyükşehir Belediye (İBB) Başkanı Ekrem İmamoğlu'nun da arasında bulunduğu 46'sı tutuklu 436 sanıklı İBB Davası'nın üçüncü duruşmasına, İstanbul 33. Ağır Ceza Mahkemesi'nce Silivri'de yeni inşa edilen duruşma salonunda devam edildi. Duruşmaların 106. günü,\u0026nbsp;tanıkların dinlenmesiyle devam ediyor.\u003c/p\u003e\u003cp\u003eTutuklu ve bazı tutuksuz sanıkların yerlerini almasının ardından salona getirilen Ekrem İmamoğlu, izleyicilerin alkışlarıyla salona geldi. İzleyiciler, \"Foncular içeri, başkanlar dışarı\" şeklinde slogan attı. İBB Başkan Vekili Nuri Aslan da duruşmayı izledi.\u003c/p\u003e\u003cp\u003eBeyanlarına başvurulan ilk tanık Didem Kılıç oldu. Avukat olduğunu, Ekrem İmamoğlu'nun avukatı tutuklu Mehmet Pehlivan ile ilgili bir durum nedeniyle\u0026nbsp;1,5 sene önce tanık olarak ifadesinin alındığını, ancak\u0026nbsp;iddianamede ve dosya içeriğinde söylemlerinin yer bulmadığını belirtti.\u0026nbsp;Yanında çalıştığı bir kişiyle iş nedeniyle arasının bozulduğunu anlatan Kılıç, daha sonra bu kişinin itirafçı olduğunu belirtti.\u003c/p\u003e\u003cp\u003eDidem Kılıç, \"Akabinde, bu öfkesine istinaden yapacaklarının ne olduğunu söyledi ve yaptı da. Bu da masum, daha önce hayatında bir araya gelmediğim, selam dahi vermediğim ki versem çok da onur duyacağım meslektaşımla alakalı olur olmaz beyanlarda bulundu. Benimle olan husumeti, benle olan duygusal ikliminden kaynaklı Avukat Mehmet Pehlivan'a sirayet etti bu. Dediğim gibi kendisini tanımıyorum. Onun tarafından yönlendirilmedim veya herhangi bir müvekkil tarafından da dosyaya dahil edilmedim. Dosyada herhangi bir dahililiğim de söz konusu değil zaten\" şeklinde konuştu.\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\"İTİRAFÇI 'BASKI ALTINDAYIM' DEDİ\"\u0026nbsp;\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eTanık olarak dinlenen Tugay Düzgün, itirafçı sanık Recep Taşçı’nın, iddianamenin hazırlandığı ilk dönemde, kendilerini bir odaya toplayıp, \"bu ifadeyi vermek zorunda kaldığını, baskı altında bulunduğunu ve iki çocuğu olduğunu\" söylediğini aktardı. Düzgün, \"Odada bu ifadeleri kullandı. Arkadaşlarım da şahit\" dedi. Tanık Düzgün, Mahkeme Başkanı'nın sorusu üzerine, odada bulunanların isimlerini de saydı.\u0026nbsp;\u003c/p\u003e\u003cp\u003eAvukatların, \"Bu bahsettiğiniz toplantıda Mehmet Recep Taşçı, tutuklama baskısı altında da bu ifadelerde bulunduğunu ve yani gerçeğe aykırı bir beyanda bulunduğunu ima edecek şekilde mi söyledi acaba?\" sorusu üzerine Düzgün, \"Net olarak bir ifade de bulunmadı sadece böyle bir baskı altında olduğunu, iki çocuğu bulunduğunu, böyle bir ifade vermek mecburiyetinde olduğunu söyledi bize\" diye konuştu.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003e\"MEDYA AŞ'DE BİR ODADA TOPLADI BİZİ\"\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eTanık olarak dinlenen Ali Kan Yurt da tanıklığının, Recep Taşkın'ın beyan verdiği durumla ilgili olduğunu belirterek, \"Bize anlattığı bir konu vardı. İlk iddianame çıktığı gün Başkanım, bütün ekibi topladı. Odada kendisi baskı altında hissettiğini ve bu baskı altında hissetmesinden kaynaklı, çocuğunun olmasından dolayı böyle bir ifade verdiğini söyledi bizlere. Bu süreç böyle geçti Başkanım, bunu aktarmak için geldim. O gün ekip arkadaşlarımız da vardı. Orada yaklaşık 6 kişiydik\" beyanını verdi.\u003c/p\u003e\u003cp\u003eMahkeme Başkanının sorusu üzerine Yurt, \"Kendisi direkt bizi toplayıp ekibe, 'Bir konuşalım' dedi, çağırdı bizleri. Medya A.Ş.'de bir odada topladı bizleri. Orada kendisi anlattı\" ifadelerini kullandı.\u003c/p\u003e\u003cp\u003eTanık Yurt, bir başka soru üzerine de \"Başka bir konuşma olmadı. Pişman olduğunu, pişmanlık değil de şöyle, kendisi baskı altında hissettiğini ve bu şeye istinaden bizde zaten gelip anlatmak istediğini söyledi. Başka da bir şey söylemedi\" dedi.\u0026nbsp;\u003c/p\u003e\u003cp\u003eMedya A.Ş.'de satın alma ve ihale personeli olarak görev yapan Recep Taşçı, iddianamede yer alan beyanında, hangi firmaların ihaleyi alacağının ve hangi rakamların teklif edileceğinin önceden bildirildiğini iddia etmişti. Taşçı'nın itirafları, \"İtirafçı memurdan yeri yerinden oynatacak sözler, ihale talimatlarını kimden aldığını tek tek açıkladı\" şeklinde yansıtılmıştı.\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eNECATİ ÖZKAN'IN ŞOFÖRÜ KONUŞTU: PARAYI BAGAJA KOYDUM\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eSanıklardan Necati Özkan'ın şoförü İsa Tolga Başarslan, tanık olarak dinlendi.\u0026nbsp;2014 yılından itibaren Necati Özkan'ın yanında bulunduğunu belirten Başarslan, Beylikdüzü'ndeki Metrohome projesinden ev almak için Beylikdüzü’ne gittiklerini, Özkan'ın bagaja koyması için kendisin içinde para olduğunu söylediği çantayı teslim ettiğini söyledi.\u0026nbsp;\u003c/p\u003e\u003cp\u003eBaşarslan, \"Yol boyunca da işte ev alımı ile ilgili, konut yatırımı ile ilgili, planlarla ilgili konuşmalar oldu arabada. Ondan sonra, vardığımız noktada da çantayı kendisine verdim Necati Bey'in, içeri girdi. Ben arabanın başında durdum. Ve sonra görüşme bittikten sonra da aracımızla ofise geri döndük\" dedi.\u0026nbsp;\u003c/p\u003e\u003cp\u003eDiğer tanık Adem Yeşilkaya da\u0026nbsp;Necati Özkan'ın yanında muhasebe ve finans sorumlusu olarak çalıştığını, Özkan'ın şahsi satın aldığı dairelerin devir protokol işlemlerini usule uygun şekilde işlediklerini anlattı.\u003c/p\u003e\u003cp\u003eDairelerin anahtar teslimi için Metro Home projesi töreni sırasında Özkan'a, Adem Kameroğlu'nun, \"Abi işte proje biraz geç kaldı pandemiden dolayı ama teslim ettik. Yani yaptığın yatırıma değdi ve proje daha da gelişiyor, ticari alanları hep kurumsal firmalara kiraya verdik. Buranın yani değeri daha da artacak\" dediğini aktardı.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eADEM SOYTEKİN'İN ÇALIŞANLARI DİNLENDİ\u0026nbsp;\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eİtirafçı Adem Soytekin'in inşaat firmasında\u0026nbsp;inşaat mühendisi olarak görev yapan Cumali Uyar da tanık olarak dinlendi.\u003c/p\u003e\u003cp\u003eUyar, İstanbul Büyükşehir Belediyesi'nin Yuvam İstanbul Kreşleri'nin Avrupa Yakası proje yöneticisi ve sorumlusu olarak çalıştığını, en son da Kahramanmaraş depreminden sonra Hatay ilinde yapılan geçici deprem konutlarının yapım yönetimiyle fiilen görev aldığını belirterek, binaların ilgili kuruma teslimini yaptığını anlattı.\u003c/p\u003e\u003cp\u003eAdem Soytekin'in avukatının, \"Soytekin ile çalışma süreniz boyunca herhangi bir suç örgütünden veya örgütsel hiyerarşiden söz etti mi? İş ilişkiniz dışında herhangi bir örgütsel faaliyet, bağlılık veya emir komuta ilişkisine bizzat tanık olduğunuz herhangi bir olay oldu mu?\" sorusuna Uyar, \"Hayır olmadı. Adem Bey ile tek ilişkimiz iş ile alakalıdır, işin yapımı ve yönetimi ile alakalıdır. Çalışan işveren ilişkisi dışında herhangi bir ilişkimiz yoktur. Örgütle de herhangi bir ilişkisini net duymadım, şahit olmadım\" yanıtını verdi.\u003c/p\u003e\u003cp\u003eBir başka soru üzerine Uyar, Adem Soytekin'in kimseden rüşvet aldığına veya birisine rüşvet verdiğine şahit olmadığını söyledi.\u003c/p\u003e\u003cp\u003eTanık Murat Kontaş,\u0026nbsp;Asoy İnşaat'ın davaya konu inşaat işleriyle alakalı bilgi vermek için geldiğini belirtti. Kontaş, Adem Soytekin’in avukatı Simge Büyük'ün, \"İşler yapılırken Adem Soytekin size bir örgütten bahsetti mi?” sorusuna, \"Hayır\" yanıtını verdi.\u0026nbsp;\u003c/p\u003e")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("18:[\"$\",\"section\",null,{\"className\":\"continuous-reading\",\"id\":\"kesintisiz-okuma\",\"aria-label\":\"Siyaset kategorisinde kesintisiz okuma\",\"children\":[\"$\",\"div\",null,{\"className\":\"continuous-wrap\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"continuous-intro\",\"children\":[[\"$\",\"span\",null,{\"children\":\"KESİNTİSİZ OKUMA\"}],[\"$\",\"h2\",null,{\"children\":[\"Siyaset\",\" gündemi burada bitmiyor\"]}]]}],[[\"$\",\"div\",\"8891\",{\"className\":\"continuous-entry\",\"children\":[[\"$\",\"article\",null,{\"className\":\"continuous-article\",\"data-article-path\":\"/haber/ibb-davasi-nda-taniklardan-carpici-iddia-itirafci-baski-altinda-beyanda-bulundu\",\"data-article-title\":\"İBB Davası'nda tanıklardan çarpıcı iddia: İtirafçı baskı altında beyanda bulundu\",\"aria-posinset\":1,\"aria-setsize\":5,\"children\":[[\"$\",\"header\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"continuous-kicker\",\"children\":[[\"$\",\"span\",null,{\"children\":\"SIRADAKİ HABER\"}],[\"$\",\"small\",null,{\"children\":[\"01\",\" / \",\"05\"]}]]}],[\"$\",\"a\",null,{\"className\":\"continuous-category\",\"href\":\"/kategori/siyaset\",\"children\":\"Siyaset\"}],[\"$\",\"h2\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"/haber/ibb-davasi-nda-taniklardan-carpici-iddia-itirafci-baski-altinda-beyanda-bulundu\",\"children\":\"İBB Davası'nda tanıklardan çarpıcı iddia: İtirafçı baskı altında beyanda bulundu\"}]}],[\"$\",\"p\",null,{\"children\":\"Aralarında Tutuklu İBB Belediye Başkanı Ekrem İmamoğlu'nun da bulunduğu İBB Davası'nın Silivri'deki duruşmasında dinlenen tanıklar, dosyada kilit rol oynayan itirafçı sanık Recep Taşçı'nın kendilerini toplayarak \\\"baskı altında olduğunu ve bu ifadeyi vermek zorunda kaldığını\\\" söylediğini aktardı. Duruşmada ayrıca avukat Mehmet Pehlivan ile ilgili tanıklık yapan Didem Kılıç, hakkındaki beyanların husumetten kaynaklandığını belirtti.\"}],[\"$\",\"div\",null,{\"className\":\"continuous-meta\",\"children\":[[\"$\",\"a\",null,{\"href\":\"/yazar/anka\",\"children\":\"ANKA\"}],[\"$\",\"time\",null,{\"children\":\"9 Kasım 2026 13:23\"}]]}]]}],[\"$\",\"figure\",null,{\"children\":[\"$\",\"div\",null,{\"children\":[null,[\"$\",\"img\",null,{\"src\":\"/media/2026/10/e18314a0f7bfba13d3b04589eb3c9a31.jpg\",\"alt\":\"imamogluibb\",\"loading\":\"lazy\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"continuous-body\",\"children\":[[[\"$\",\"div\",null,{\"className\":\"rich-body\",\"dangerouslySetInnerHTML\":{\"__html\":\"$25\"}}],\"$L26\"],null,null,\"$L27\"]}],\"$L28\"]}],\"$L29\"]}],\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\"],\"$L2e\"]}]}]\n")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("19:[\"$\",\"$L2f\",null,{}]\n")</script><script>((self[Symbol.for(