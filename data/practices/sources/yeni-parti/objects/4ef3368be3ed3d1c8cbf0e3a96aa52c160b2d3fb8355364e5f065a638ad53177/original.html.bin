"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"→\"}]]}]}]\n")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("3a:null\n")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("4a:T880,")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("\u003cp\u003eYENİ Parti, dün 81 ilde gerçekleştirilen genel başkanlık ön seçiminin sonuçlarını açıkladı.\u0026nbsp;\u003c/p\u003e\u003cp\u003eÖrgütlerden Sorumlu Genel Başkan Yardımcısı Ensar Aytekin ile Hukuk ve Seçim İşlerinden Sorumlu Genel Başkan Yardımcısı Gizem Özcan'ın imzasıyla yapılan açıklamada, 81 ilde kurulan 2 bin 502 sandıkta üyelerin oy kullandığı bildirildi.\u003c/p\u003e\u003cp\u003eAçıklamada \"YENİ Parti'de söz de karar da yetki de üyelerin! Genel Başkanlık ön seçimimizi, Türkiye genelinde kurulan 2.502 sandıkta büyük bir demokratik katılımla tamamladık. Şu ana kadar sisteme girilerek kesinleşen sonuçlara göre, 639.454 üyemiz, yüzde 81,3 katılım oranıyla sandığa giderek oy kullandı. Geçerli oyların tamamını alan Genel Başkanımız Sayın Özgür Özel, üyelerimizin rekor desteğiyle yeni döneme büyük bir güvenle adım attı. Sandığa giderek iradesini ortaya koyan tüm üyelerimize, bu büyük ve tarihi demokrasi şöleninde emek veren örgütümüze gönülden teşekkür ediyoruz.\" denildi.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eÖZGÜR ÖZEL'DEN AÇIKLAMA: Türkiye YENİ’leniyor!\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eGenel başkanlık seçiminin ardından sosyal medya hesabından açıklamada bulundu.\u0026nbsp;\u003c/p\u003e\u003cp\u003eÖzel, şu ifadeleri kullandı: YENİ Parti olarak milletimize verdiğimiz bir sözü daha yerine getirmenin mutluluğunu hep beraber yaşıyoruz. Türkiye’ye vadettiğimiz demokrasiyi önce kendi evimizde kuruyoruz. İlçe ve il başkanlarımızın ardından Genel Başkanlık ön seçimimizi tamamladık. Ülke genelinde yüzde 81,3 katılım oranıyla sandığa giderek partisine ve geleceğine sahip çıkan, bizleri Genel Başkanlığa layık gören tüm üyelerimize yürekten teşekkür ediyorum. Bu demokrasi şölenini mümkün kılan, fedakârca, özveriyle çalışan örgütümüze gönülden şükranlarımı sunuyorum. YENİ Parti milletin partisidir. Söz de karar da yetki de milletindir. Şimdi üyelerimizden aldığımız bu tarihi güveni, 1’inci Olağan Kurultayımızla, Türkiye’nin sorunlarını çözecek güçlü bir iradeye dönüştüreceğiz. YENİ Parti’yle siyaset yenileniyor. Türkiye YENİ’leniyor!\"\u003c/p\u003e")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("3c:[\"$\",\"$L20\",null,{\"html\":\"$4a\"}]\n")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("3d:[\"$\",\"div\",null,{\"className\":\"source-box\",\"children\":[[\"$\",\"span\",null,{\"children\":\"KAYNAK\"}],[\"$\",\"strong\",null,{\"children\":\"ANKA\"}],null]}]\n")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("3e:[\"$\",\"footer\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"/haber/yeni-parti-de-ozgur-ozel-rekor-oyla-guven-tazeledi\",\"children\":[\"Haberi ayrı sayfada aç \",[\"$\",\"span\",null,{\"aria-hidden\":\"true\",\"children\":\"→\"}]]}]}]\n")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("3f:null\n")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("4b:Tec1,")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).bootstrap.rsc??={rsc:[]}).rsc.push("\u003cp\u003e24 Ağustos'ta CHP'den ayrılarak YENİ Parti'ye katılan Tekirdağ Büyükşehir Belediye Başkanı Candan Yüceer, sadece 2,5 ay (75 gün) süren üyeliğinin ardından sert bir açıklamayla partisinden istifa etti. \u003c/p\u003e\u003cp\u003eHasta yatağındayken il kongresinde yaşanan siyasi hesaplaşmalara tepki gösteren Yüceer, \"Yol arkadaşlığı hukukunun çiğnendiği bir anlayışın içinde yokum\" dedi.\u003c/p\u003e\u003cp\u003eTekirdağ Büyükşehir Belediye Başkanı Candan Yüceer, sosyal medya hesabı üzerinden yaptığı kapsamlı açıklama ile YENİ Parti’den istifa ettiğini duyurdu. Siyaseti hiçbir zaman kişisel ikbal ve koltuk hesabı için yapmadığını belirten Yüceer, parti içerisindeki makam ve delegelik tartışmalarına sert sözlerle tepki gösterdi.\u003c/p\u003e\u003cp\u003eİstifa kararının arkasındaki en kritik kırılma noktasının il kongresinde yaşananlar olduğunu vurgulayan Candan Yüceer, \"Son olarak benim hasta yatağında olduğum bir dönemde il kongresinde gündemin kurultay delegeliği üzerinden tartışmaya dönüştürülmesini, bu tartışmalar nedeniyle kongrenin başlatılmamasını ve şahsımın kurultay delegesi olarak dahi yazılmamasını kabul edilebilir bulmuyorum.\" dedi.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eİŞTE SOSYAL MEDYADAN YAPILAN O AÇIKLAMA\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cspan style=\"color: rgb(15, 20, 25); background-color: rgb(255, 255, 255);\"\u003e\u003cem\u003eBugün itibarıyla üyesi olduğum Yeni Parti’den istifa ediyorum.\u003cbr\u003eBen siyaseti koltuk hesabı yapmak için yapmadım.\u003cbr\u003eBenim mücadelem hiçbir zaman kişisel ikbal mücadelesi olmadı.\u003cbr\u003eAncak üzülerek görüyorum ki bugün bazıları kendi kişisel ikbalinin, makamının ve koltuğunun hesabına düşmüş durumda.\u003cbr\u003eSon olarak benim hasta yatağında olduğum bir dönemde il kongresinde gündemin kurultay delegeliği üzerinden tartışmaya dönüştürülmesini ve bu tartışmalar nedeniyle kongrenin başlatılmamasını, şahsımın kurultay delegesi olarak dahi yazılmamasını kabul edilebilir bulmuyorum.\u003cbr\u003eBurada mesele bir delege listesinde kimin olup olmaması değildir.\u003cbr\u003eMesele yıllarca birlikte mücadele etmiş insanlara gösterilmesi gereken saygıdır.\u003cbr\u003eMesele yol arkadaşlığı hukukudur.\u003cbr\u003eMesele seçilmiş bir Büyükşehir Belediye Başkanına gösterilmesi gereken siyasi nezakettir.\u003cbr\u003eMesele birlikte yürüdüğümüz insanların birbirine nasıl davrandığıdır.\u003cbr\u003eBenim beklediğim vefa, benim aradığım yol arkadaşlığı bu değil.\u003cbr\u003eYol arkadaşlığı hukukunun bu kadar kolay çiğnendiği, kişisel çıkarların ortak değerlerin önüne geçirildiği bir anlayışın içinde yokum.\u003cbr\u003eBenim önceliğim de sorumluluğum da çok açık: Tekirdağ.\u003cbr\u003eBenim her sabah uyandığımda düşündüğüm şey Tekirdağ’ın hangi sorununu çözeceğimiz, hangi yatırımını tamamlayacağımız, hangi projemizi hayata geçireceğimiz.\u003cbr\u003e11 ilçemizde yaşayan vatandaşlarımız bizden hizmet bekliyor.\u003cbr\u003eAltyapı bekliyor, yol bekliyor, su bekliyor, sosyal destek bekliyor.\u003cbr\u003eTekirdağ’ın kaybedecek bir günü bile yok.\u003cbr\u003eBenim önceliğim siyasi hesaplaşmalar değil, Tekirdağ’a hizmettir, Tekirdağ’ın bekleyen sorunları, devam eden yatırımları ve halkımıza verdiğimiz sözlerdir.\u003cbr\u003eBen enerjimi kentin geleceğine harcamayı tercih ediyorum.\u003cbr\u003eBizim mücadelemizde, yolumuzda, önceliğimizde Tekirdağ’ın daha güçlü, daha adil, daha yaşanabilir bir kent olmasıdır.\u003cbr\u003eBen bu göreve Tekirdağ’a hizmet etmek için geldim.\u003cbr\u003eBiz başımız dik, alnımız açık, hemşerilerimize karşı sorumluluğumuzun bilinciyle yolumuza devam edeceğiz.\u003cbr\u003eVe bütün gücümle Tekirdağ’ıma olan sevgim ve bu güzel şehre hizmet etme sorumluluğumla Tekirdağ için çalışmaya devam edeceğim.\u003c/em\u003e\u003c/span\u003e\u003c/p\u003e")</script><script>((self[Symbol.for("vinext.navigationRuntime")]??={bootstrap:{routeManifest:null},functions:{}}).boo