<style>
/* Servis sayfaları: açık mod kartlarını koyu modda da tutarlı yüzey ve metin renklerine taşı. */
html[data-theme="dark"] :is(.market-page,.earthquake-page,.weather-page,.pharmacy-page,.rss-page,.news-submission-page) {
    color: #e7e8eb !important;
}
