<li style="margin-bottom: 2px;"><a href="https://www.facebook.com/diyekonustucom/" target="_blank" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='#000'" onmouseout="this.style.color=''">Facebook</a></li>
<li style="margin-bottom: 2px;"><a href="https://www.youtube.com/@diyekonustucom" target="_blank" style="color: inherit; text-decoration: none;" onmouseover="this.style.color='#000'" onmouseout="this.style.color=''">YouTube</a></li>
</ul>
