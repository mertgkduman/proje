<style>
.breaking-ticker {
    display: flex;
    width: max-content;
    animation: ticker 20s linear infinite;
}

@keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}

/* Mobil daha hızlı */
@media (max-width: 768px) {
    .breaking-ticker {
        animation: ticker 20s linear infinite;
    }
}

.nav-category-group {
    position: relative;
    display: inline-flex;
    align-items: center;
}

.site-nav-shell,
.site-mobile-nav-shell {
    width: 100%;
    max-width: 950px;
    box-sizing: border-box;
    margin-left: auto;
    margin-right: auto;
}

.site-nav-shell {
    width: 100%;
    max-width: 950px;
    position: relative;
    z-index: 8000;
    overflow-x: clip !important;
    overflow-y: visible !important;
}

header.site-shell {
    z-index: 8100 !important;
}

main.site-shell {
    position: relative;
    z-index: 1;
}

.site-nav-shell > div {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
}

.site-nav-row {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    flex-wrap: nowrap !important;
    gap: 4px !important;
    overflow-x: auto !important;
    overflow-y: visible !important;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
}

.site-nav-row > * {
    flex: 0 0 auto;
}

.site-nav-row > button:first-child {
    width: 30px !important;
    height: 30px !important;
    min-height: 30px !important;
    margin-right: 3px;
    padding: 0 !important;
    border-radius: 0 !important;
}

.site-nav-row > button:first-child:hover,
.site-nav-row > button:first-child:focus-visible {
    background-color: #000 !important;
    color: #fff !important;
}

.site-nav-row > button:first-child + a {
    margin-left: 2px;
}

.site-nav-row > .site-nav-breaking-separator {
    padding-inline: 4px;
}

.site-nav-row > .site-nav-breaking-separator + .nav-category-group > a {
    padding-left: 7px !important;
}

.site-nav-row::-webkit-scrollbar {
    display: none;
}

.nav-category-trigger {
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

.nav-game-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: #e30613 !important;
    font-weight: 800 !important;
}

.nav-game-icon {
    display: inline-grid;
    width: 15px;
    height: 15px;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(2, 1fr);
    overflow: hidden;
    border: 2px solid currentColor;
    border-radius: 3px;
    background: #fff;
}

.nav-game-icon span {
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
}

.nav-game-icon span:nth-child(2),
.nav-game-icon span:nth-child(4) { border-right: 0; }
.nav-game-icon span:nth-child(3),
.nav-game-icon span:nth-child(4) { border-bottom: 0; }
.nav-game-icon span:nth-child(3) { background: currentColor; }

@media (max-width: 768px) {
    .nav-game-link { gap: 3px; }
    .nav-game-icon { width: 13px; height: 13px; border-width: 1.5px; border-radius: 2px; }
}

.nav-category-arrow {
    font-size: 9px;
    line-height: 1;
    transform: translateY(1px);
}

.nav-category-dropdown {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 12000;
    display: none;
    min-width: 180px;
    border: 1px solid #e5e7eb;
    background: #fff;
    box-shadow: 0 16px 35px rgba(0,0,0,.14);
}

.nav-category-dropdown.is-open {
    display: block;
}

/* Spor alt menüsü açıldığında solunda görünen 90+ marka kartı. */
.nav-90plus-popover,
.mobile-nav-90plus-popover {
    align-items: center;
    background: linear-gradient(135deg, #111 0%, #292929 100%);
    border: 1px solid #ffd503;
    color: #fff;
    display: none;
    flex-direction: column;
    gap: 5px;
    justify-content: center;
    min-height: 122px;
    padding: 10px 8px;
    position: fixed;
    text-decoration: none;
    width: 104px;
    z-index: 12001;
}
.nav-90plus-popover.is-open,
.mobile-nav-90plus-popover.is-open { display: flex; }
.nav-90plus-popover strong,
.mobile-nav-90plus-popover strong { color:#ffd503; font-size:48px; font-weight:950; letter-spacing:-.1em; line-height:.82; }
.nav-90plus-popover strong span,
.mobile-nav-90plus-popover strong span { color:#fff; font-size:.58em; margin-left:1px; vertical-align:top; }
.nav-90plus-popover small,
.mobile-nav-90plus-popover small { color:#fff; font-size:9px; font-weight:900; letter-spacing:.09em; line-height:1.12; text-align:center; text-transform:uppercase; }
.nav-90plus-popover:hover,
.nav-90plus-popover:focus-visible,
.mobile-nav-90plus-popover:hover,
.mobile-nav-90plus-popover:focus-visible { background:#ffd503; color:#111; }
.nav-90plus-popover:hover strong,
.nav-90plus-popover:focus-visible strong,
.mobile-nav-90plus-popover:hover strong,
.mobile-nav-90plus-popover:focus-visible strong,
.nav-90plus-popover:hover small,
.nav-90plus-popover:focus-visible small,
.mobile-nav-90plus-popover:hover small,
.mobile-nav-90plus-popover:focus-visible small { color:#111; }

.nav-90plus-inline {
    display:inline-flex;
    align-items:center;
    margin-right:4px;
    padding:2px 5px 3px;
    border-radius:4px;
    background:#171717;
    color:#ffd503;
    font-size:10px;
    font-weight:950;
    letter-spacing:-.08em;
    line-height:1;
    vertical-align:middle;
}
.nav-category-trigger:hover .nav-90plus-inline,
.nav-category-trigger:focus-visible .nav-90plus-inline { background:#ffd503; color:#111; }

.nav-category-dropdown a {
    display: block;
    padding: 8px 10px;
    color: #111;
    font-size: 13px;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
}
.nav-category-dropdown .nav-category-all-link,
.mobile-nav-category-dropdown .nav-category-all-link {
    display: flex;
    align-items: center;
    gap: 6px;
}
.nav-open-icon { width: 14px; height: 14px; flex: 0 0 14px; }
.nav-open-label { font-size: 10px; font-weight: 800; letter-spacing: .02em; }

.nav-category-dropdown a:hover,
.nav-category-dropdown a:focus-visible {
    background: #000;
    color: #fff;
}

@media (max-width: 768px) {
    .nav-category-dropdown {
        display: none !important;
    }

    .mobile-nav-category-group {
        display: inline-flex;
    }

    .mobile-nav-category-dropdown {
        position: fixed;
        z-index: 12000;
        display: none;
        min-width: 168px;
        border: 1px solid #e5e7eb;
        background: #fff;
        box-shadow: 0 16px 35px rgba(0, 0, 0, .14);
    }

    .mobile-nav-category-dropdown.is-open {
        display: block;
    }

    .mobile-nav-category-dropdown a {
        display: block;
        padding: 6px 10px;
        color: #111;
        font-size: 12px;
        line-height: 1.2;
        font-weight: 500;
        border-bottom: 1px solid #f1f2f4;
        text-decoration: none;
        white-space: nowrap;
    }

    .mobile-nav-category-dropdown a:last-child {
        border-bottom: 0;
    }

    .mobile-nav-category-dropdown a:hover,
    .mobile-nav-category-dropdown a:focus-visible,
    .mobile-nav-category-dropdown a:active {
        background: #000;
        color: #fff;
    }

    .mobile-nav-category-trigger[aria-expanded="true"] .nav-category-arrow {
        transform: rotate(180deg) translateY(-1px);
    }

    .mobile-nav-90plus-popover { min-width:104px; }
}

#menu-overlay {
    position: fixed !important;
    inset: 0 !important;
    z-index: 2147483000 !important;
    background: rgba(9, 11, 16, .54) !important;
    opacity: 1;
    backdrop-filter: blur(3px) !important;
    -webkit-backdrop-filter: blur(3px) !important;
    transition: opacity .22s ease;
}

#menu-overlay.hidden {
    display: none !important;
    pointer-events: none !important;
}

#mega-menu {
    position: fixed !important;
    top: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    z-index: 2147483001 !important;
    width: min(372px, 92vw);
    max-width: calc(100vw - 18px);
    left: auto !important;
    max-height: none;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    background: linear-gradient(165deg, #17191f 0%, #0c0d10 42%, #08090b 100%) !important;
    color: #fff !important;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: -28px 0 70px rgba(0, 0, 0, 0.48);
    transform: translateX(100%) !important;
    will-change: transform;
    visibility: hidden;
    pointer-events: none;
}

#mega-menu.is-open {
    transform: translateX(0) !important;
    visibility: visible;
    pointer-events: auto;
}

.son-dakika-dot{display:inline-block;width:8px;height:8px;flex:0 0 8px;margin-right:6px;vertical-align:1px;border-radius:50%;background:#e21e2b;box-shadow:0 0 0 0 rgba(227,6,19,.48);animation:son-dakika-blink 1.25s ease-in-out infinite}
.son-dakika-dot-mobile{width:7px;height:7px;flex-basis:7px;margin-right:4px}
.dk-menu-link.son-dakika-menu-link{justify-content:flex-start}
@keyframes son-dakika-blink{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(227,6,19,.42)}50%{opacity:.45;box-shadow:0 0 0 4px rgba(227,6,19,0)}}
@media(prefers-reduced-motion:reduce){.son-dakika-dot{animation:none}}

.son-dakika-dot-footer{width:7px;height:7px;flex-basis:7px;margin-right:5px}
footer a:not(.footer-google-news-link){display:inline-flex;align-items:center;padding:3px 8px;border-radius:4px;transition:background-color .16s ease,color .16s ease}
footer .dk-footer-grid > div:not(:first-child) ul a,
footer .dk-footer-grid > div:not(:first-child) ul .footer-weather-button{padding-left:0!important}
footer .dk-footer-grid > div:not(:first-child) ul a,
footer .dk-footer-grid > div:not(:first-child) ul .footer-weather-button{position:relative;z-index:2;margin-left:-8px;padding:3px 8px!important}
footer a:hover,footer a:focus-visible,footer .footer-weather-button:hover,footer .footer-weather-button:focus-visible{background-color:#000!important;color:#fff!important}
footer .dk-footer-grid > div > h4{padding-left:8px;margin-left:-8px}
footer .footer-weather-button{display:inline-flex;align-items:center;padding:3px 8px!important;border:0;border-radius:4px;transition:background-color .16s ease,color .16s ease}
footer .footer-google-news-link{display:inline-flex;align-items:center;justify-content:center;gap:6px;white-space:nowrap;max-width:100%;box-sizing:border-box;padding:5px 10px;border-radius:6px;background:#e30613;color:#fff!important;text-decoration:none;transition:background-color .16s ease}
footer .footer-google-news-link img{width:15px;height:15px;flex:0 0 15px;object-fit:contain;background:transparent;border-radius:0;padding:0}
footer .footer-google-news-link:hover,footer .footer-google-news-link:focus-visible{background:#000!important;color:#fff!important}

.dk-menu-shell {
    height: 100%;
    min-height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 18px 20px 26px;
    scrollbar-width: thin;
    scrollbar-color: rgba(227,6,19, .72) transparent;
}

.dk-menu-shell::-webkit-scrollbar {
    width: 6px;
}

.dk-menu-shell::-webkit-scrollbar-thumb {
    background: rgba(227,6,19, .72);
    border-radius: 999px;
}

.dk-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding-bottom: 16px;
    margin-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}

.dk-menu-header img {
    width: auto;
    max-width: 178px;
    object-fit: contain;
}

.dk-menu-close {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #f9fafb;
    background: #0d0d0d;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    font-size: 26px;
    line-height: 1;
    transition: background .18s ease, border-color .18s ease, transform .18s ease;
}

.dk-menu-close:hover {
    background: #e30613;
    border-color: #e30613;
    transform: rotate(90deg);
}

.dk-menu-section {
    padding: 2px 0 2px;
}

.dk-menu-title {
    margin: 18px 0 7px;
    color: #e30613;
    font-size: 11px;
    line-height: 1;
    font-weight: 900;
    letter-spacing: .12em;
    text-transform: uppercase;
}

.dk-menu-link.dk-service-link,.dk-menu-link.son-dakika-menu-link{justify-content:flex-start}
.dk-menu-link-content{display:inline-flex;align-items:center;gap:10px}
.dk-service-icon{width:17px;height:17px;flex:0 0 17px;color:#ed4852}
.dk-menu-spacer{height:12px;flex:0 0 12px}

.dk-menu-list {
    display: flex;
    flex-direction: column;
}

.dk-menu-link,
.dk-menu-parent {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 42px;
    padding: 10px 2px;
    color: #f7f7f8;
    border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    text-decoration: none;
    font-size: 14.5px;
    line-height: 1.2;
    font-weight: 750;
    text-align: left;
    letter-spacing: 0;
    transition: color .16s ease, padding-left .16s ease;
}

.dk-menu-link:hover,
.dk-menu-parent:hover {
    color: #fff;
    padding-left: 7px;
}

.dk-menu-arrow {
    color: #e30613;
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 900;
    transition: transform .18s ease;
}

.dk-menu-parent.is-open .dk-menu-arrow {
    transform: rotate(180deg);
}

.dk-menu-children {
    display: none;
    padding: 5px 0 7px 12px;
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.dk-menu-children.is-open {
    display: block;
}

.dk-menu-child-link {
    display: block;
    padding: 7px 0 7px 10px;
    color: #c9cdd3;
    border-left: 2px solid rgba(227,6,19, .72);
    font-size: 13px;
    line-height: 1.25;
    font-weight: 650;
    text-decoration: none;
    transition: color .16s ease, padding-left .16s ease;
}

.dk-menu-child-link:hover {
    color: #fff;
    padding-left: 15px;
}

/* Refined hamburger drawer */
.dk-menu-shell {
    padding: 20px 22px 30px;
}

.dk-menu-header {
    padding: 4px 0 18px;
    margin-bottom: 14px;
    border-bottom-color: rgba(255,255,255,.14);
}

.dk-menu-header img {
    max-width: 164px;
    filter: drop-shadow(0 2px 10px rgba(0,0,0,.28));
}

.dk-menu-close {
    width: 36px;
    height: 36px;
    flex-basis: 36px;
    background: rgba(255,255,255,.08);
    border-color: rgba(255,255,255,.18);
}

.dk-menu-title {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 22px 0 10px;
    color: #f05a64;
    font-size: 10px;
    letter-spacing: .15em;
}

.dk-menu-title::before {
    content: "";
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: #e30613;
}

.dk-menu-link.dk-service-link {
    min-height: 42px;
    margin: 0 0 5px;
    padding: 9px 11px;
    border: 1px solid rgba(255,255,255,.075);
    border-radius: 9px;
    background: rgba(255,255,255,.045);
    color: #f3f4f6;
    transition: background .16s ease, border-color .16s ease, color .16s ease, transform .16s ease;
}

.dk-menu-link.dk-service-link:hover,
.dk-menu-link.dk-service-link:focus-visible {
    padding-left: 11px;
    border-color: rgba(255,255,255,.24);
    background: #fff;
    color: #111827;
    transform: translateX(2px);
}

.dk-menu-link.dk-service-link:hover .dk-service-icon,
.dk-menu-link.dk-service-link:focus-visible .dk-service-icon {
    color: #e30613;
}

.dk-menu-link.son-dakika-menu-link {
    min-height: 44px;
    margin-bottom: 7px;
    padding: 10px 12px;
    border: 1px solid rgba(240,72,82,.35);
    border-radius: 10px;
    background: linear-gradient(100deg, rgba(227,6,19,.24), rgba(227,6,19,.07));
    color: #fff;
}

.dk-menu-link.son-dakika-menu-link:hover,
.dk-menu-link.son-dakika-menu-link:focus-visible {
    padding-left: 12px;
    border-color: rgba(255,255,255,.3);
    background: #fff;
    color: #111827;
}

.dk-menu-spacer {
    height: 7px;
    flex-basis: 7px;
}

@media (max-width: 640px) {
    #mega-menu {
        width: min(330px, 90vw);
    }

    .dk-menu-shell {
        padding: 15px 17px 24px;
    }

    .dk-menu-link,
    .dk-menu-parent {
        min-height: 40px;
        font-size: 14px;
        padding: 9px 2px;
    }
}

/* Keep the mobile drawer aligned with the desktop service rows. */
.dk-menu-link.son-dakika-menu-link {
    min-height: 42px;
    margin: 0 0 5px;
    padding: 9px 11px;
    border: 1px solid rgba(255,255,255,.075);
    border-radius: 9px;
    background: rgba(255,255,255,.045);
    color: #f3f4f6;
}

.dk-menu-link.son-dakika-menu-link .son-dakika-dot {
    margin-right: 0;
}

.dk-menu-link.son-dakika-menu-link:hover,
.dk-menu-link.son-dakika-menu-link:focus-visible {
    padding-left: 11px;
    border-color: rgba(255,255,255,.24);
    background: #fff;
    color: #111827;
}

@media (max-width: 768px) {
    #searchBtn svg {
        display: none;
    }
}

@media (max-width: 768px) {
    .site-mobile-nav-shell > div > div > button:first-child {
        flex: 0 0 36px;
        width: 36px;
        height: 34px;
        justify-content: center;
        margin-right: -2px;
        padding: 0 !important;
        overflow: visible;
    }

    .site-mobile-nav-shell > div > div > button:first-child svg {
        display: block;
        flex: 0 0 20px;
        width: 20px;
        height: 20px;
    }

    .site-mobile-nav-shell > div > div > button:first-child + a {
        margin-left: 2px;
        padding-left: 2px;
    }
}

.site-mobile-nav-shell .site-nav-breaking-separator {
    margin-left: 1px;
}

/* Hamburger açılır menüsü: kompakt kırmızı-bordo servis kartı dili. */
#mega-menu{background:linear-gradient(160deg,#d2051e 0%,#bd001a 50%,#76000f 100%)!important;border-left-color:rgba(255,255,255,.32)!important;box-shadow:-24px 0 60px rgba(65,0,9,.42)!important}
#mega-menu .dk-menu-shell{padding:16px 17px 22px!important}
#mega-menu .dk-menu-header{margin-bottom:9px!important;padding:2px 0 11px!important;border-bottom-color:rgba(255,255,255,.28)!important}
#mega-menu .dk-menu-close{width:32px;height:32px;flex-basis:32px;border:1px solid rgba(255,255,255,.4)!important;border-radius:6px!important;background:rgba(0,0,0,.14)!important;color:#fff!important;font-size:22px!important}
#mega-menu .dk-menu-close:hover{background:#000!important;border-color:#000!important;transform:none!important}
#mega-menu .dk-menu-title{margin:15px 0 7px!important;color:#fff!important;font-size:9px!important;letter-spacing:.12em!important}
#mega-menu .dk-menu-title::before{background:#fff!important}
#mega-menu .dk-menu-list{gap:4px}
#mega-menu .dk-menu-link,#mega-menu .dk-menu-parent{min-height:36px!important;margin:0!important;padding:7px 9px!important;border:1px solid rgba(255,255,255,.28)!important;border-radius:6px!important;background:rgba(0,0,0,.12)!important;color:#fff!important;font-size:12px!important;font-weight:750!important}
#mega-menu .dk-menu-link.dk-service-link,#mega-menu .dk-menu-link.son-dakika-menu-link{min-height:36px!important;margin:0!important;padding:7px 9px!important;border:1px solid rgba(255,255,255,.28)!important;border-radius:6px!important;background:rgba(0,0,0,.12)!important;color:#fff!important}
#mega-menu .dk-menu-link:hover,#mega-menu .dk-menu-link:focus-visible,#mega-menu .dk-menu-parent:hover,#mega-menu .dk-menu-parent:focus-visible{padding-left:9px!important;border-color:#000!important;background:#000!important;color:#fff!important;transform:none!important;outline:0}
#mega-menu .dk-menu-link:hover .dk-service-icon,#mega-menu .dk-menu-link:focus-visible .dk-service-icon{color:#fff!important}
#mega-menu .dk-service-icon,#mega-menu .dk-menu-arrow{color:#fff!important}
#mega-menu .dk-menu-children{margin-top:-1px;padding:4px 0 4px 9px!important;border-bottom:0!important;background:rgba(0,0,0,.1)!important}
#mega-menu .dk-menu-child-link{padding:6px 8px!important;border-left-color:rgba(255,255,255,.6)!important;color:#fff!important;font-size:11px!important}
#mega-menu .dk-menu-child-link:hover{padding-left:8px!important;background:#000!important;color:#fff!important}
#mega-menu .dk-menu-spacer{height:3px!important;flex-basis:3px!important}

/* Sağ çekme yerine üstten açılan kompakt mega menü. */
#mega-menu{top:0!important;right:0!important;bottom:auto!important;left:0!important;width:100%!important;max-width:none!important;height:auto!important;max-height:calc(100dvh - 10px)!important;border:0!important;border-bottom:1px solid rgba(255,255,255,.34)!important;border-radius:0 0 14px 14px!important;box-shadow:0 20px 54px rgba(65,0,9,.44)!important;transform:translateY(-112%)!important}
#mega-menu.is-open{transform:translateY(0)!important}
#mega-menu .dk-menu-shell{height:auto!important;min-height:0!important;max-width:950px!important;max-height:calc(100dvh - 10px)!important;margin:0 auto!important;padding:14px 18px 18px!important}
#mega-menu .dk-menu-header{padding:0 0 10px!important;margin-bottom:7px!important}
#mega-menu .dk-menu-header img{max-width:148px!important}
#mega-menu .dk-menu-section{padding:0!important}
#mega-menu .dk-menu-list{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:4px!important}
#mega-menu .dk-menu-link,#mega-menu .dk-menu-parent{min-height:34px!important}
#mega-menu .dk-menu-children{grid-column:1/-1!important}
@media (max-width:640px){#mega-menu{max-height:calc(100dvh - 4px)!important;border-radius:0 0 11px 11px!important}#mega-menu .dk-menu-shell{max-height:calc(100dvh - 4px)!important;padding:13px 14px 16px!important}#mega-menu .dk-menu-list{grid-template-columns:1fr!important}#mega-menu .dk-menu-link,#mega-menu .dk-menu-parent{min-height:34px!important;font-size:11.5px!important}}

/* Kısa mega menü: sayfayı uzatmaz; geniş ekranda üç, mobilde iki sütun kullanır. */
#mega-menu{
    max-height:min(470px,calc(100dvh - 12px))!important;
    border-radius:0 0 12px 12px!important;
}
#mega-menu .dk-menu-shell{
    height:min(470px,calc(100dvh - 12px))!important;
    min-height:0!important;
    max-height:min(470px,calc(100dvh - 12px))!important;
    overflow-y:auto!important;
    overscroll-behavior:contain!important;
    padding:10px 16px 14px!important;
}
#mega-menu .dk-menu-header{
    padding:0 0 7px!important;
    margin-bottom:2px!important;
}
#mega-menu .dk-menu-header img{max-width:132px!important}
#mega-menu .dk-menu-close{width:28px!important;height:28px!important;flex-basis:28px!important;font-size:19px!important}
#mega-menu .dk-menu-title{margin:10px 0 4px!important;font-size:8px!important;letter-spacing:.14em!important}
#mega-menu .dk-menu-title::before{width:12px!important}
#mega-menu .dk-menu-list{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:3px!important}
#mega-menu .dk-menu-link,#mega-menu .dk-menu-parent{
    min-height:30px!important;
    padding:5px 7px!important;
    font-size:10.5px!important;
    line-height:1.1!important;
    overflow:hidden!important;
}
#mega-menu .dk-menu-link-content{gap:6px!important;min-width:0!important;white-space:nowrap!important;overflow:hidden!important}
#mega-menu .dk-menu-link-content>span:last-child{overflow:hidden!important;text-overflow:ellipsis!important}
#mega-menu .dk-service-icon{width:13px!important;height:13px!important;flex-basis:13px!important}
#mega-menu .son-dakika-dot{width:6px!important;height:6px!important;flex-basis:6px!important;margin-right:1px!important}
#mega-menu .dk-menu-spacer{display:none!important}
#mega-menu .dk-menu-category{min-width:0!important}
#mega-menu .dk-menu-children{padding:3px 0 3px 6px!important}
#mega-menu .dk-menu-child-link{padding:4px 6px!important;font-size:10px!important}
@media (max-width:760px){
    #mega-menu{max-height:calc(100dvh - 4px)!important}
    #mega-menu .dk-menu-shell{height:calc(100dvh - 4px)!important;max-height:calc(100dvh - 4px)!important;padding:10px 11px 14px!important}
    #mega-menu .dk-menu-list{grid-template-columns:repeat(2,minmax(0,1fr))!important}
    #mega-menu .dk-menu-link,#mega-menu .dk-menu-parent{min-height:32px!important;padding:6px 7px!important;font-size:10.5px!important}
}

@media print {
    * {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }

    html,
    body {
        background: #fff !important;
        overflow: visible !important;
    }

    #mega-menu,
    #menu-overlay,
    .nav-category-dropdown,
    #cookie-consent,
    .print-hidden {
        display: none !important;
        visibility: hidden !important;
    }

    #mega-menu {
        position: static !important;
        transform: translateX(100%) !important;
        height: 0 !important;
        max-height: 0 !important;
        overflow: hidden !important;
        background: transparent !important;
    }

    main.site-shell,
    .site-shell {
        width: 100% !important;
        max-width: 950px !important;
        margin-left: auto !important;
        margin-right: auto !important;
        background: #fff !important;
        box-shadow: none !important;
    }

    .article-hero-layout {
        display: grid !important;
        grid-template-columns: minmax(0, 68%) minmax(0, 30%) !important;
        gap: 2% !important;
        align-items: start !important;
        justify-content: space-between !important;
    }

    .article-hero-layout.is-gallery-layout {
        grid-template-columns: minmax(0, 100%) !important;
    }

    .article-sidebar-stack {
        display: flex !important;
        visibility: visible !important;
        break-inside: avoid !important;
        page-break-inside: avoid !important;
    }

    .article-stream-root > .stream-article-block:not(:first-child),
    .article-stream-root .stream-article-block.is-loaded-next,
    .article-stream-root .stream-article-block[data-infinite-loaded="true"] {
        display: none !important;
        visibility: hidden !important;
    }

    a {
        text-decoration: none !important;
    }
}
</style>


