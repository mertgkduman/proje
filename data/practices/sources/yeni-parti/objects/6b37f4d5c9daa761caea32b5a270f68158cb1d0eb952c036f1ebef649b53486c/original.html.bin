/* Google tercih edilen kaynak kartı. */
.google-news-feature {
    box-sizing: border-box;
    display: flex;
    width: 100%;
    height: 67px;
    align-items: center;
    gap: 14px;
    margin: 2px 0 5px;
    padding: 8px 18px;
    border: 1px solid #45484a;
    border-radius: 10px;
    background: linear-gradient(105deg, #232426 0%, #183b41 100%);
    color: #f5f2ed;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.22;
    letter-spacing: -.015em;
    text-decoration: none;
    overflow: hidden;
    contain: layout paint;
    transition: border-color .18s ease, filter .18s ease;
}

.google-news-feature:hover { border-color: #69777a; filter: brightness(1.08); }

.google-news-feature-mark {
    display: block;
    width: 48px;
    height: 49px;
    max-width: none;
    flex: 0 0 48px;
    padding: 0;
    object-fit: contain;
}

.google-news-feature-copy {
    min-width: 0;
    flex: 1 1 auto;
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

.google-news-feature-star {
    display: flex;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid #414141;
    border-radius: 50%;
    background: #222;
    color: #ffc400;
    font-size: 26px;
    line-height: 1;
}

@media (max-width: 899px) {
    .google-news-feature { height: 63px; gap: 10px; margin: 0 0 5px; padding: 10px 12px; }
    .google-news-feature-mark { width: 40px; height: 41px; flex-basis: 40px; }
    .google-news-feature-copy { font-size: 13px; }
    .google-news-feature-star { width: 40px; height: 40px; flex-basis: 40px; font-size: 23px; }
}

@media (max-width: 420px) {
    .google-news-feature { height: 55px; gap: 8px; padding: 9px; }
    .google-news-feature-mark { width: 34px; height: 35px; flex-basis: 34px; }
    .google-news-feature-copy { font-size: 11px; }
    .google-news-feature-star { width: 36px; height: 36px; flex-basis: 36px; font-size: 22px; }
}

html[data-theme="light"] .google-news-feature {
    background: linear-gradient(105deg, #fff 0%, #edf7f8 100%);
    border-color: #d9e3e5;
    color: #202124;
}

html[data-theme="light"] .google-news-feature-star { border-color: #d1d5db; background: #f3f4f6; color: #e6ad00; }

/* Koyu modda alıntı kutusu, açık moddaki beyaz yüzeyi miras almaz. */
html[data-theme="dark"] .odt-article-body > blockquote,
html[data-theme="dark"] .odt-article-body blockquote {
    background: var(--dk-surface-raised) !important;
    color: var(--dk-text) !important;
    border-color: var(--dk-border) !important;
    box-shadow: 0 8px 28px rgba(0, 0, 0, .28) !important;
}

html[data-theme="dark"] .odt-article-body blockquote,
html[data-theme="dark"] .odt-article-body blockquote * {
    color: var(--dk-text) !important;
}

html[data-theme="dark"] .odt-article-body blockquote a {
    color: var(--dk-text) !important;
    text-decoration: underline !important;
    text-decoration-color: rgba(255, 255, 255, .52) !important;
    text-decoration-thickness: 1px !important;
    text-underline-offset: 3px;
}

