    .article-meta-inner > div:first-child > span,
    .article-meta-inner > div:first-child > .article-meta-share-slot {
        flex: 0 0 auto !important;
    }

    .article-meta-inner > div:first-child > span {
        font-size: 10px !important;
        line-height: 14px !important;
    }

    .article-meta-share-slot .cover-action-btn {
        width: auto !important;
        min-width: 0 !important;
        height: 26px !important;
        gap: 2px !important;
        padding: 0 6px !important;
        border: 1px solid #d60918 !important;
        border-radius: 4px !important;
        background: #d60918 !important;
        box-shadow: none !important;
