                <div style="color:#000; font-size:8px; font-weight:700; letter-spacing:0.05em;">ONS ALTIN</div>
                <div id="pd-ons-fiyat" style="color:#000; font-size:14px; font-weight:800; line-height:1;">-</div>
                <div id="pd-ons-degisim" style="font-size:8px; color:#000;">-</div>
            </div>
            <canvas id="ons-chart" width="36" height="24"></canvas>
        </div>

        <a href="https://diyekonustu.com/piyasalar" style="padding-left:7px; color:#000; font-size:9px; font-weight:600; white-space:nowrap; text-decoration:none;">
            Tüm Piyasalar →
        </a>

    </div>
</div>
</section>

<div id="pd-tooltip" style="position:fixed; background:#1a1a1a; color:#fff; font-size:11px; font-weight:600; padding:4px 8px; border-radius:4px; pointer-events:none; display:none; z-index:9999; white-space:nowrap; border:1px solid rgba(255,255,255,0.15);"></div>

<script>
(function () {
    const pdGrafikVeri = {};
    const setText = (id, value) => {
        const el = document.getElementById(id);
        if (el) el.textContent = value;
    };

    function pdMiniGrafik(canvasId, veriler, tarihler) {
        const canvas = document.getElementById(canvasId);
        if (!canvas || !veriler || veriler.length < 2) return;
        pdGrafikVeri[canvasId] = { veriler, tarihler: tarihler ?? [] };
        const ctx = canvas.getContext('2d');
        const w = canvas.width, h = canvas.height;
        const min = Math.min(...veriler), max = Math.max(...veriler);
        const range = max - min || 1;
        ctx.clearRect(0, 0, w, h);
        ctx.beginPath();
        ctx.strokeStyle = '#e30613';
        ctx.lineWidth = 2.2;
        ctx.lineJoin = 'round';
        ctx.lineCap = 'round';
        veriler.forEach((v, i) => {
            const x = (i / (veriler.length - 1)) * w;
            const y = h - ((v - min) / range) * (h - 6) - 3;
            i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
        });
        ctx.stroke();

        if (!canvas.dataset.tooltipBound) {
            canvas.dataset.tooltipBound = '1';
            canvas.addEventListener('mousemove', (e) => {
                const tooltip = document.getElementById('pd-tooltip');
                const d = pdGrafikVeri[canvasId];
                if (!tooltip || !d) return;
                const rect = canvas.getBoundingClientRect();
                const mx = e.clientX - rect.left;
                const idx = Math.round((mx / rect.width) * (d.veriler.length - 1));
                const safeIdx = Math.max(0, Math.min(idx, d.veriler.length - 1));
                const val = d.veriler[safeIdx];
                const tarih = d.tarihler[safeIdx] ?? '';
                const valStr = val > 1000
                    ? val.toLocaleString('tr-TR', { maximumFractionDigits: 2 })
                    : val.toFixed(4);
                tooltip.style.display = 'block';
                tooltip.style.left = (e.clientX + 12) + 'px';
                tooltip.style.top = (e.clientY - 28) + 'px';
                tooltip.innerHTML = tarih
                    ? `<span style="color:rgba(255,255,255,0.6);margin-right:4px;">${tarih}</span>${valStr}`
                    : valStr;
            });
            canvas.addEventListener('mouseleave', () => {
                const tooltip = document.getElementById('pd-tooltip');
                if (tooltip) tooltip.style.display = 'none';
            });
        }
    }

    function pdFmtDeg(val) {
        if (val === null || val === undefined || isNaN(val)) return '-';
        const ok = val >= 0 ? '▲' : '▼';
        return `${val >= 0 ? '+' : ''}${parseFloat(val).toFixed(2)}% ${ok}`;
    }

    function sahteGecmis(son, adet = 10, volatilite = 0.003) {
        const dizi = [son];
        for (let i = 1; i < adet; i++) {
            const onceki = dizi[i - 1];
            dizi.unshift(onceki * (1 + (Math.random() - 0.5) * volatilite));
        }
        return dizi;
    }

    function sahteTarihler(adet = 10) {
        const tarihler = [];
        const simdi = new Date();
        for (let i = adet - 1; i >= 0; i--) {
            const d = new Date(simdi);
            d.setDate(d.getDate() - i);
            tarihler.push(d.toLocaleDateString('tr-TR', { day:'2-digit', month:'2-digit' }));
        }
        return tarihler;
    }

    function hydrateCached(veri) {
        if (veri.dolar) {
            setText('pd-dolar-fiyat', veri.dolar.fiyat);
            setText('pd-dolar-degisim', veri.dolar.degisim);
            if (veri.dolar.history) pdMiniGrafik('dolar-chart2', veri.dolar.history, veri.dolar.historyDates || sahteTarihler(veri.dolar.history.length));
        }
        if (veri.euro) {
            setText('pd-euro-fiyat', veri.euro.fiyat);
            setText('pd-euro-degisim', veri.euro.degisim);
            if (veri.euro.history) pdMiniGrafik('euro-chart2', veri.euro.history, veri.euro.historyDates || sahteTarihler(veri.euro.history.length));
        }
        if (veri.gram) {
            setText('pd-gram-fiyat', veri.gram.fiyat);
            setText('pd-gram-degisim', veri.gram.degisim);
            if (veri.gram.history) pdMiniGrafik('gram-chart', veri.gram.history, veri.gram.historyDates || sahteTarihler(veri.gram.history.length));
        }
        if (veri.btc) {
            setText('pd-btc-fiyat', veri.btc.fiyat);
            setText('pd-btc-degisim', veri.btc.degisim);
            if (veri.btc.history) pdMiniGrafik('btc-chart2', veri.btc.history, veri.btc.historyDates || sahteTarihler(veri.btc.history.length));
        }
        if (veri.bist) {
            setText('bist-fiyat', veri.bist.fiyat);
            setText('bist-degisim', veri.bist.degisim);
            if (veri.bist.history) pdMiniGrafik('bist-chart', veri.bist.history, veri.bist.historyDates || sahteTarihler(veri.bist.history.length));
        }
        if (veri.ceyrek) {
            setText('pd-ceyrek-fiyat', veri.ceyrek.fiyat);
            setText('pd-ceyrek-degisim', veri.ceyrek.degisim);
            if (veri.ceyrek.history) pdMiniGrafik('ceyrek-chart', veri.ceyrek.history, veri.ceyrek.historyDates || sahteTarihler(veri.ceyrek.history.length));
        }
        if (veri.tam) {
            setText('pd-tam-fiyat', veri.tam.fiyat);
            setText('pd-tam-degisim', veri.tam.degisim);
            if (veri.tam.history) pdMiniGrafik('tam-chart', veri.tam.history, veri.tam.historyDates || sahteTarihler(veri.tam.history.length));
        }
        if (veri.brent) {
            setText('pd-brent-fiyat', veri.brent.fiyat);
            setText('pd-brent-degisim', veri.brent.degisim);
            if (veri.brent.history) pdMiniGrafik('brent-chart', veri.brent.history, veri.brent.historyDates || sahteTarihler(veri.brent.history.length));
        }
        if (veri.ons) {
            setText('pd-ons-fiyat', veri.ons.fiyat);
            setText('pd-ons-degisim', veri.ons.degisim);
            if (veri.ons.history) pdMiniGrafik('ons-chart', veri.ons.history, veri.ons.historyDates || sahteTarihler(veri.ons.history.length));
        }
    }

    async function pdFetchJson(url, timeout = 4500) {
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), timeout);
        try {
            const response = await fetch(url, { signal: controller.signal, cache: 'no-store' });
            if (!response.ok) throw new Error(`Market request failed: ${response.status}`);
            return await response.json();
        } finally {
            window.clearTimeout(timer);
        }
    }

    function pdHydrateCrypto(crypto) {
        if (!crypto?.bitcoin) return;
        const cached = localStorage.getItem('piyasaVerileri');
        let current = {};
        try { current = cached ? JSON.parse(cached) : {}; } catch (_) {}

        const value = crypto.bitcoin.usd;
        current.btc = {
            fiyat: '$' + value.toLocaleString('tr-TR'),
            degisim: pdFmtDeg(crypto.bitcoin.usd_24h_change),
            history: sahteGecmis(value, 10, 0.005),
            historyDates: sahteTarihler(10)
        };
        localStorage.setItem('piyasaVerileri', JSON.stringify(current));
        hydrateCached(current);
    }

    async function piyasaVerileriniGosterVeGuncelle(forceRefresh = false) {
        const cached = localStorage.getItem('piyasaVerileri');
        if (cached) {
            try { hydrateCached(JSON.parse(cached)); } catch(e) {}
            // Keep cached values visible while refreshing prices immediately in the background.
        }

        try {
            void pdFetchJson('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd&include_24hr_change=true', 3500)
                .then(pdHydrateCrypto)
                .catch(() => {});

            const results = await Promise.allSettled([
                pdFetchJson('/api/doviz'),
                pdFetchJson('/api/altin'),
                pdFetchJson('/api/bist100'),
                pdFetchJson('/api/brent')
            ]);
            const [dovizResult, altinResult, bistResult, brentResult] = results;
            const doviz = dovizResult.status === 'fulfilled' ? dovizResult.value : null;
            const altin = altinResult.status === 'fulfilled' ? altinResult.value : null;
            const bist = bistResult.status === 'fulfilled' ? bistResult.value : null;
            const brent = brentResult.status === 'fulfilled' ? brentResult.value : null;
            const yeniVeri = {};

            if (doviz?.success) {
                const tryData = doviz.result.data.find(d => d.code === 'TRY');
                const eurData = doviz.result.data.find(d => d.code === 'EUR');
                if (tryData) {
                    const val = tryData.calculated;
                    yeniVeri.dolar = { fiyat: '₺' + val.toFixed(4), degisim: pdFmtDeg(tryData.change ?? null), history: tryData.history ?? sahteGecmis(val), historyDates: tryData.historyDates ?? null };
                }
                if (eurData && tryData) {
                    const val = tryData.calculated / eurData.calculated;
                    yeniVeri.euro = { fiyat: '₺' + val.toFixed(4), degisim: pdFmtDeg(eurData.change ?? null), history: eurData.history ?? sahteGecmis(val), historyDates: eurData.historyDates ?? null };
                }
            }

            if (altin?.success) {
                const gram = altin.result.find(d => d.name === 'Gram Altın');
                const ons = altin.result.find(d => d.name === 'ONS Altın');
                const ceyrek = altin.result.find(d => d.name === 'Çeyrek Altın');
                const tam = altin.result.find(d => d.name === 'Tam Altın');
                if (gram) {
                    const val = parseFloat(gram.buyingstr.replace(',', '.'));
                    yeniVeri.gram = { fiyat: '₺' + gram.buyingstr, degisim: pdFmtDeg(gram.change ?? null), history: gram.history ?? sahteGecmis(val), historyDates: gram.historyDates ?? null };
                }
                if (ons) {
                    const val = parseFloat(ons.buyingstr.replace(',', '.'));
                    yeniVeri.ons = { fiyat: '$' + ons.buyingstr, degisim: pdFmtDeg(ons.rate ?? ons.change ?? null), history: ons.history ?? sahteGecmis(val), historyDates: ons.historyDates ?? null };
                }
                if (ceyrek) {
                    const val = parseFloat(ceyrek.buyingstr.replace(',', '.'));
                    yeniVeri.ceyrek = { fiyat: '₺' + ceyrek.buyingstr, degisim: pdFmtDeg(ceyrek.change ?? null), history: ceyrek.history ?? sahteGecmis(val), historyDates: ceyrek.historyDates ?? null };
                }
                if (tam) {
                    const val = parseFloat(tam.buyingstr.replace(',', '.'));
                    yeniVeri.tam = { fiyat: '₺' + tam.buyingstr, degisim: pdFmtDeg(tam.rate ?? tam.change ?? null), history: sahteGecmis(val, 10, 0.0025), historyDates: sahteTarihler(10) };
                }
            }

            if (bist?.success && bist.fiyat) {
                const fiyat = bist.fiyat;
                const sayisalFiyat = parseFloat(fiyat.replace(/\./g, '').replace(',', '.'));
                yeniVeri.bist = { fiyat, degisim: pdFmtDeg(bist.degisim) };
                if (!isNaN(sayisalFiyat)) {
                    yeniVeri.bist.history = sahteGecmis(sayisalFiyat, 10, 0.002);
                    yeniVeri.bist.historyDates = sahteTarihler(10);
                }
            }

            if (brent?.success && brent.price) {
                const val = Number(brent.price);
                yeniVeri.brent = {
                    fiyat: '$' + val.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }),
                    degisim: pdFmtDeg(brent.change),
                    history: Array.isArray(brent.history) && brent.history.length > 1 ? brent.history : sahteGecmis(val, 10, 0.004),
                    historyDates: Array.isArray(brent.historyDates) ? brent.historyDates : sahteTarihler(10)
                };
            }

            if (Object.keys(yeniVeri).length > 0) {
                const cached = localStorage.getItem('piyasaVerileri');
                let existing = {};
                try { existing = cached ? JSON.parse(cached) : {}; } catch (_) {}
                const merged = { ...existing, ...yeniVeri };
                localStorage.setItem('piyasaVerileri', JSON.stringify(merged));
                hydrateCached(merged);
            }
        } catch(e) { console.error(e); }
    }

    piyasaVerileriniGosterVeGuncelle();
    window.setTimeout(() => {
        piyasaVerileriniGosterVeGuncelle(true);
        window.setInterval(() => piyasaVerileriniGosterVeGuncelle(true), 60000);
    }, 60000);
})();
</script>
<style>
:root {
    --mobile-gutter: 0px;
    --mobile-meta-gutter: 2px;
}

.article-page-root,
.article-page-root * {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
}

.article-local-network{display:flex;flex-wrap:wrap;align-items:center;gap:7px;margin:18px 0 2px;padding:11px 0;border-top:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb}.article-local-network-label{margin-right:3px;color:#7b8492;font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase}.article-local-network a{color:#b71825;font-size:12px;font-weight:750;line-height:1.2;text-decoration:none}.article-local-network a:not(:last-child):after{margin-left:7px;color:#cbd1d8;content:"·"}.article-local-network a:hover{text-decoration:underline}
html[data-theme="dark"] .article-local-network{border-color:#383a41}html[data-theme="dark"] .article-local-network-label{color:#aeb3bd}html[data-theme="dark"] .article-local-network a{color:#ff9da5}html[data-theme="dark"] .article-local-network a:not(:last-child):after{color:#656a74}

.odt-article-body p {
    font-size: 15px;
    line-height: 24px;
    color: rgb(0, 0, 0);
    font-weight: 400;
    font-style: normal;
    margin-top: 0;
    margin-bottom: 1.25rem !important;
}

/* Spor haberlerinde yalnız gövde metni daha hafif kalsın; başlık, spot ve vurgu metinleri aynı ağırlıkta korunur. */
.article-page-root.article-sport-page .odt-article-body :where(p, li) {
    font-weight: 350;
}

/* Dış kaynaktan gelmiş düz div metinleri de paragraf düzeninde kalır. */
.odt-article-body > div:not(.article-inline-embed):not(.editor-video-embed):not(.editor-embed-spacer) {
    margin: 0 0 1.25rem !important;
    font-size: 15px;
    line-height: 24px;
}

/* Editörden gelen tablolar: masaüstünde düzenli, mobilde sayfayı taşırmadan kaydırılabilir. */
.odt-article-body .table-wrapper {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    margin: 1.35rem 0;
    border: 1px solid #d8dce2;
    border-radius: 7px;
    background: #fff;
    -webkit-overflow-scrolling: touch;
}

.odt-article-body .table-wrapper table {
    width: 100%;
    min-width: 540px;
    border-collapse: collapse;
    color: #111827;
    font-size: 14px;
    line-height: 1.4;
}

.odt-article-body .table-wrapper th,
.odt-article-body .table-wrapper td {
    padding: 9px 11px;
    border-right: 1px solid #e1e5ea;
    border-bottom: 1px solid #e1e5ea;
    text-align: left;
    vertical-align: top;
}

.odt-article-body .table-wrapper th {
    background: #f2f4f6;
    color: #111827;
    font-weight: 700;
}

.odt-article-body .table-wrapper tr:last-child td { border-bottom: 0; }
.odt-article-body .table-wrapper th:last-child,
.odt-article-body .table-wrapper td:last-child { border-right: 0; }

/* Eski yayınlarda wrapper bulunmasa da kayıttan sonra tablo çizgileri kaybolmaz. */
.odt-article-body table {
    width: 100%;
    border-collapse: collapse;
    color: #111827;
    font-size: 14px;
    line-height: 1.4;
    border: 1px solid #d8dce2;
}

.odt-article-body table th,
.odt-article-body table td {
    padding: 9px 11px;
    border: 1px solid #e1e5ea;
    text-align: left;
    vertical-align: top;
}

.odt-article-body table th {
    background: #f2f4f6;
    color: #111827;
    font-weight: 700;
}

.odt-article-body p:empty {
    display: none;
}

.article-tag-link {
    background: #f3f4f6;
    color: #4b5563;
    font-size: 14px;
    line-height: 1.25;
    font-weight: 500;
    text-decoration: none;
}

.article-tag-link:hover,
.article-tag-link:focus-visible {
    background: #e31b33;
    color: #fff;
}

.article-services-panel{margin:0 0 14px;padding:11px;border:1px solid #e9ecf1;border-radius:11px;background:#fff;box-shadow:0 3px 12px rgba(20,32,51,.035)}
.article-sidebar-stack>.article-breaking-feature{order:0!important}.article-sidebar-stack>.article-related-panel{order:1!important}.article-sidebar-stack>.article-services-panel{order:2!important}.article-sidebar-stack>.article-most-read{order:3!important}.article-sidebar-stack>.article-instagram-follow-section{order:4!important}
.article-breaking-feature,.article-submit-feature{display:flex!important;min-height:38px!important;margin:0 0 10px!important;padding:8px 10px!important;border:1px solid #8d0012!important;border-radius:7px!important;background:linear-gradient(110deg,#d2051e 0%,#bd001a 54%,#8d0012 100%)!important;color:#fff!important;box-shadow:0 4px 12px rgba(141,0,18,.18)!important}
.article-breaking-feature:hover,.article-submit-feature:hover{border-color:#8d0012!important;background:linear-gradient(110deg,#bd001a 0%,#a60016 54%,#76000f 100%)!important;color:#fff!important;transform:translateY(-1px)}
.article-breaking-feature .son-dakika-dot{width:8px;height:8px;flex:0 0 8px;border-radius:50%;background:#fff!important;box-shadow:none!important}
.article-breaking-feature .article-service-external-icon,.article-submit-feature .article-service-external-icon{margin-left:auto;color:#fff!important}
.article-submit-feature .article-service-icon{color:#fff!important}
.article-most-read .border-t>a{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:0!important;padding:0 0 10px!important;margin-bottom:10px!important}
.article-most-read .border-t>a>img{display:block!important;width:100%!important;max-width:100%!important;height:163px!important;min-height:0!important;aspect-ratio:auto!important;object-fit:cover!important;object-position:center!important;border-radius:0!important;background:transparent!important}
.article-most-read .sidebar-list-copy{width:100%;padding:7px 2px 0;box-sizing:border-box}
.article-sidebar-stack > aside{order:0}.article-sidebar-stack > .article-services-panel{order:1}.article-sidebar-stack > .article-instagram-follow-section{order:2}.article-sidebar-stack > section:not(.article-services-panel):not(.article-instagram-follow-section){order:3}
.article-priority-actions{display:flex;flex-direction:column;gap:5px;order:0!important;margin:0!important}
.article-priority-actions>.article-breaking-feature,.article-priority-actions>.article-submit-feature{margin:0!important}
.article-sidebar-stack>.article-related-panel{order:2!important}.article-sidebar-stack>.article-instagram-follow-section{order:3!important}.article-sidebar-stack>.article-services-panel{order:4!important}.article-sidebar-stack>.article-most-read{order:5!important}
.article-services-heading{display:flex;align-items:center;gap:8px;margin:0 0 8px;color:#172235;font-size:16px;font-weight:800;letter-spacing:-.02em}
.article-services-heading:before{width:4px;height:18px;flex:0 0 4px;border-radius:9px;background:linear-gradient(180deg,#e22b39,#a81420);content:""}
.article-services-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px}
.article-service-link,.article-service-button{display:flex;min-width:0;min-height:35px;align-items:center;gap:6px;padding:6px 7px;border:1px solid #eceff3;border-radius:7px;background:#fff;color:#354153;font-size:11.5px;line-height:1.25;font-weight:650;text-decoration:none;text-align:left;box-shadow:none;transition:border-color .16s,background .16s,color .16s,transform .16s}
.article-service-google{grid-column:1/-1}
.article-service-search{grid-column:1/-1}
.article-social-follow-title{margin:0 0 7px;color:#273448;font-size:11px;font-weight:850;letter-spacing:.035em}.article-social-follow-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:2px}.article-instagram-follow{min-height:44px;padding:7px 8px;border-radius:9px;gap:8px}.article-instagram-icon{width:29px;height:29px;flex-basis:29px;border-radius:8px}.article-instagram-icon svg{width:16px;height:16px}.article-instagram-copy strong{font-size:10px;line-height:1.2}.article-social-x{background:#111}.article-social-facebook{background:#1877f2}.article-social-threads{background:#111}.article-instagram-arrow{display:none}
.article-instagram-follow-section{margin:0 0 10px}.article-instagram-follow{display:flex;min-width:0;min-height:44px;align-items:center;gap:9px;padding:6px 9px;border:1px solid #edf0f3;border-radius:9px;background:linear-gradient(110deg,#fff8fa,#fff 78%);color:#283246;text-decoration:none;box-shadow:0 2px 7px rgba(74,20,42,.025);transition:border-color .16s,transform .16s,box-shadow .16s}.article-instagram-follow:hover{border-color:#dca5b5;box-shadow:0 7px 18px rgba(74,20,42,.09);transform:translateY(-1px)}.article-instagram-icon{display:grid;width:26px;height:26px;flex:0 0 26px;place-items:center;border-radius:0;background:transparent;color:#536174}.article-instagram-icon svg{width:15px;height:15px}.article-instagram-copy{display:flex;min-width:0;flex:1;flex-direction:column;gap:2px}.article-instagram-copy strong{font-size:12px;font-weight:800;line-height:1.25}.article-instagram-copy span{color:#747e8d;font-size:10px;line-height:1.3}.article-instagram-arrow{width:17px;height:17px;flex:0 0 17px;color:#a5295d}

.article-service-link:hover,.article-service-button:hover{border-color:#e8a4a9;background:#fff8f8;color:#a91925;transform:translateY(-1px)}
.article-service-icon{width:14px;height:14px;flex:0 0 14px;color:#687386}
.article-service-external-icon{width:14px;height:14px;flex:0 0 14px;margin-left:auto;color:#49698f}
.article-service-link span:last-child,.article-service-button span:last-child{min-width:0}
.article-services-panel .article-service-link,.article-services-panel .article-service-button{min-height:38px!important;gap:7px!important;padding:8px 10px!important;border:1px solid #8d0012!important;border-radius:7px!important;background:linear-gradient(110deg,#d2051e 0%,#bd001a 54%,#8d0012 100%)!important;color:#fff!important;box-shadow:0 4px 12px rgba(141,0,18,.18)!important}
.article-services-panel .article-service-link:hover,.article-services-panel .article-service-button:hover{border-color:#8d0012!important;background:linear-gradient(110deg,#bd001a 0%,#a60016 54%,#76000f 100%)!important;color:#fff!important;transform:translateY(-1px)}
.article-services-panel .article-service-icon{color:#fff!important}
.article-services-panel .article-service-link,.article-services-panel .article-service-button{min-height:35px!important;gap:6px!important;padding:6px 7px!important;border:1px solid #eceff3!important;border-radius:7px!important;background:#fff!important;color:#354153!important;box-shadow:none!important}
.article-services-panel .article-service-link:hover,.article-services-panel .article-service-button:hover{border-color:#e8a4a9!important;background:#fff8f8!important;color:#a91925!important;transform:translateY(-1px)}
.article-services-panel .article-service-icon{color:#687386!important}
.article-instagram-follow-section{margin:0 0 10px!important}
.article-social-follow-grid{gap:5px!important}
.article-instagram-follow-section .article-instagram-follow{display:flex!important;min-height:38px!important;align-items:center!important;gap:7px!important;padding:8px 10px!important;border:1px solid #8d0012!important;border-radius:7px!important;background:linear-gradient(110deg,#d2051e 0%,#bd001a 54%,#8d0012 100%)!important;color:#fff!important;box-shadow:0 4px 12px rgba(141,0,18,.18)!important}
.article-instagram-follow-section .article-instagram-follow:hover{border-color:#8d0012!important;background:linear-gradient(110deg,#bd001a 0%,#a60016 54%,#76000f 100%)!important;color:#fff!important;transform:translateY(-1px)}
.article-instagram-follow-section .article-instagram-icon,.article-instagram-follow-section .article-social-x,.article-instagram-follow-section .article-social-facebook,.article-instagram-follow-section .article-social-threads{width:17px!important;height:17px!important;flex:0 0 17px!important;border:0!important;background:transparent!important;color:#fff!important}
.article-instagram-follow-section .article-instagram-icon svg{width:17px!important;height:17px!important;color:currentColor!important}
.article-instagram-follow-section .article-instagram-copy strong{color:#fff!important;font-size:11.5px!important;font-weight:750!important;line-height:1.15!important}
.article-instagram-follow-section .article-instagram-follow:after{content:"↗";margin-left:auto;color:#fff;font-size:15px;line-height:1;font-weight:700}
.article-service-feature{grid-column:1/-1;min-height:32px;border-color:#f0dfe1;background:#fffafa;color:#a91925;font-weight:800}
.article-service-gap{grid-column:1/-1;height:2px}
.article-service-button{width:100%;cursor:pointer;font-family:inherit}

.dk-inline-related {
    float: left;
    width: min(420px, 48%);
    margin: 0.25rem 1.35rem 1rem 0;
    padding: 0 15px 0 14px;
    border-left: 1px solid #b9b9b9;
    border-right: 1px solid #b9b9b9;
    background: #fff;
    box-sizing: border-box;
}

.dk-inline-related-title {
    margin: 0 0 10px;
    color: #8b8b8b;
    font-size: 13px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.02em;
}

.dk-inline-related-item {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 7px;
    align-items: center;
    margin: 0 0 7px;
    color: #151515;
    text-decoration: none;
}

.dk-inline-related-item:last-child {
    margin-bottom: 0;
}

.dk-inline-related-thumb {
    display: block;
    width: 112px;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background: transparent;
}

.dk-inline-related-text {
    display: block;
    align-self: center;
    margin-top: 0;
    font-size: 13px;
    line-height: 1.24;
    font-weight: 700;
    color: #151515;
    transition: color 0.2s ease;
}

.dk-inline-related-item:hover .dk-inline-related-text {
    color: #d60918;
}

.odt-article-body h2,
.odt-article-body h3,
.odt-article-body h4 {
    color: rgb(0, 0, 0);
    font-size: 18px;
    line-height: 24px;
    font-weight: 700;
    font-style: normal;
    margin-top: 1.45rem;
    margin-bottom: .86rem;
}

.odt-article-body h2 + p,
.odt-article-body h3 + p,
.odt-article-body h4 + p,
.odt-article-body blockquote + p {
    margin-top: .35rem;
}

.odt-article-body strong,
.odt-article-body b,
.odt-article-body p strong,
.odt-article-body p b {
    font-weight: 700 !important;
}

.odt-article-body > :first-child {
    margin-top: 0 !important;
}

.odt-article-body .article-inline-embed {
    display: block;
    width: 100%;
    max-width: 100% !important;
    margin: 1rem 0;
}

.odt-article-body .editor-video-embed,
.odt-article-body .article-inline-embed .editor-video-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 0;
    background: #000;
}

.odt-article-body .editor-video-embed iframe,
.odt-article-body .article-inline-embed .editor-video-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0 !important;
}

/* Dışarıdan yapıştırılan video iframe'leri de editörün kendi video kutusu kadar geniş olsun. */
.odt-article-body iframe:not([id^="twitter-widget-"]) {
    display: block;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    aspect-ratio: 16 / 9;
    height: auto !important;
    margin: 1rem 0;
    border: 0;
}

.odt-article-body .twitter-tweet,
.odt-article-body .twitter-tweet-rendered,
.odt-article-body iframe[id^="twitter-widget-"] {
    display: block !important;
    width: 100% !important;
    max-width: 560px !important;
    min-height: 520px !important;
    margin-top: 1.65rem !important;
    margin-right: auto !important;
    margin-bottom: 1.9rem !important;
    margin-left: 0 !important;
}

.odt-article-body blockquote.twitter-tweet,
.odt-article-body blockquote.instagram-media {
    border-left: 0 !important;
    padding: 0 !important;
    background: transparent !important;
    margin-left: 0 !important;
    margin-right: auto !important;
}

.odt-article-body video {
    display: block;
    width: 100%;
    height: auto;
    background: #000;
}

.odt-article-body video.dk-x-video,
.odt-article-body .article-inline-embed video.dk-x-video {
    width: 100% !important;
    max-width: 550px !important;
    height: auto !important;
    max-height: none !important;
    aspect-ratio: 3 / 4 !important;
    object-fit: contain !important;
    margin: 0 auto !important;
}

.odt-article-body .article-inline-embed.x-video-embed {
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    overflow: visible !important;
}

/* Haber videoları ilk gerçek kareyle açılır; oynatma ortadaki düğmeden başlar. */
.odt-article-body figure.editor-inline-video,
.odt-article-body .dk-inline-video {
    position: relative;
    overflow: hidden;
    background: #0b0b0b;
}

.odt-article-body .dk-inline-video video {
    background: #0b0b0b;
}

.dk-video-start {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 2px solid rgba(255, 255, 255, .9);
    border-radius: 50%;
    background: rgba(188, 14, 34, .95);
    box-shadow: 0 5px 22px rgba(0, 0, 0, .35);
    cursor: pointer;
    transform: translate(-50%, -50%);
    transition: background .18s ease, opacity .18s ease, transform .18s ease;
}

.dk-video-start:hover,
.dk-video-start:focus-visible {
    background: #950a1b;
    transform: translate(-50%, -50%) scale(1.06);
}

.dk-video-start span {
    display: block;
    width: 0;
    height: 0;
    margin-left: 5px;
    border-top: 12px solid transparent;
    border-bottom: 12px solid transparent;
    border-left: 18px solid #fff;
}

.dk-inline-video.is-playing .dk-video-start {
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, -50%) scale(.9);
}

.article-cover-video-frame {
    position: relative;
    margin: 0 0 1rem;
    overflow: hidden;
    background: #0b0b0b;
}

.article-cover-video-frame .article-cover-video {
    display: block;
    width: 100%;
    height: auto;
    min-height: 220px;
    max-height: 78vh;
    background: #0b0b0b;
    object-fit: contain;
}

.article-cover-youtube {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0b0b0b;
}

.article-cover-youtube iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
}

@media (max-width: 640px) {
    .dk-video-start {
        width: 56px;
        height: 56px;
    }

    .dk-video-start span {
        margin-left: 4px;
        border-top-width: 10px;
        border-bottom-width: 10px;
        border-left-width: 16px;
    }
}

/* Video ilk yüklenirken kapak oranı korunur; dik video yalnızca oynatılınca gerçek boyuna geçer. */
.article-cover-video-frame:not(.is-playing) {
    aspect-ratio: 16 / 9;
    background: #0b0b0b;
}

.article-cover-video-frame:not(.is-playing) .article-cover-video {
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
    max-height: none !important;
    object-fit: cover !important;
}

.article-cover-video-frame.is-playing {
    aspect-ratio: auto;
}

.article-cover-video-frame.is-playing .article-cover-video {
    height: auto !important;
    min-height: 0 !important;
    max-height: 78vh !important;
    object-fit: contain !important;
}

.odt-article-body figure,
.odt-article-body > img,
.odt-article-body p > img,
.odt-article-body .attachment {
    display: block;
    margin: .86rem 0 .96rem;
}

.odt-article-body p:has(img) {
    margin: .86rem 0 .96rem;
    line-height: 0;
}

.odt-article-body h2 + figure,
.odt-article-body h3 + figure,
.odt-article-body h2 + .attachment,
.odt-article-body h3 + .attachment {
    margin-top: .55rem;
}

.odt-article-body figure + p,
.odt-article-body .attachment + p,
.odt-article-body p:has(img) + p {
    margin-top: .7rem;
}

.odt-article-body figure figcaption {
    margin-top: 0.32rem;
    padding: 7px 10px 0;
    border-top: 1px solid #e5e7eb;
    font-size: 12.5px;
    line-height: 1.35;
    color: #5f6673;
    font-weight: 500;
    letter-spacing: .01em;
}

.odt-article-body figure figcaption a {
    color: inherit;
    text-decoration: none;
    font-weight: 600;
}

.odt-article-body figure figcaption a:hover {
    color: #d60918;
}

.odt-article-body figure figcaption:empty {
    display: none;
}

.article-cover-caption {
    margin-top: 4px;
    padding: 7px 10px 0;
    border-top: 1px solid #e5e7eb;
    font-size: 12px;
    line-height: 1.35;
    color: #646464;
    font-weight: 500;
    letter-spacing: .01em;
}

.article-post-cover-actions {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: nowrap;
    gap: 8px;
    margin: -0.25rem 0 1rem;
    padding: 11px 0 10px;
    border-top: 1px solid #d1d5db;
    border-bottom: 1px solid #d1d5db;
}

.article-cover-action-left,
.article-cover-action-right {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
}

.article-cover-action-left {
    flex: 1 1 auto;
    flex-wrap: nowrap;
}

.article-cover-action-right {
    flex: 0 0 auto;
    margin-left: auto;
}

.cover-action-btn {
    height: 38px;
    min-width: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 0 10px;
    border: 1px solid #d1d5db;
    border-radius: 7px;
    background: #fff;
    color: #111827;
    font-size: 13px;
    line-height: 1;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(15, 23, 42, .08);
}

.cover-action-btn svg {
    width: 21px;
    height: 21px;
    stroke: currentColor;
}

.cover-share-menu > .cover-action-btn svg {
    transform: scaleX(-1);
}

.cover-action-btn .comment-count-badge {
    min-width: 26px;
    height: 26px;
    padding: 0 8px;
    border-radius: 999px;
    background: #e50914;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 900;
}

.comment-action-label {
    white-space: nowrap;
}

.cover-share-menu {
    position: relative;
}

.cover-share-menu::before {
    content: "Haberi paylaş";
    position: absolute;
    left: -80px;
    bottom: calc(100% + 10px);
    padding: 9px 13px;
    border-radius: 7px;
    background: #111827;
    color: #fff;
    font-size: 13px;
    line-height: 1;
    font-weight: 800;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
    transition: opacity .16s ease, transform .16s ease;
}

.cover-share-menu::after {
    content: "";
    position: absolute;
    left: 31px;
    bottom: calc(100% + 2px);
    border: 8px solid transparent;
    border-top-color: #111827;
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
    transition: opacity .16s ease, transform .16s ease;
}

.cover-share-menu:hover::before,
.cover-share-menu:hover::after,
.cover-share-menu:focus-within::before,
.cover-share-menu:focus-within::after {
    opacity: 1;
    transform: translateY(0);
}

.cover-share-dropdown {
    position: absolute;
    top: calc(100% + 2px);
    left: 0;
    z-index: 70;
    display: none;
    width: 230px;
    padding: 13px 0 10px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 18px 35px rgba(15, 23, 42, .14);
}

.cover-share-dropdown::before {
    content: "";
    position: absolute;
    left: 30px;
    top: -12px;
    width: 22px;
    height: 22px;
    border-left: 1px solid #e5e7eb;
    border-top: 1px solid #e5e7eb;
    background: #fff;
    transform: rotate(45deg);
}

.cover-share-menu:hover .cover-share-dropdown,
.cover-share-menu:focus-within .cover-share-dropdown {
    display: block;
}

.cover-share-dropdown a,
.cover-share-dropdown button {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    padding: 6px 14px;
    border: 0;
    border-bottom: 1px solid #e5e7eb;
    background: transparent;
    color: #333;
    font-size: 12px;
    font-weight: 650;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: background .14s ease, color .14s ease;
}

.cover-share-dropdown a:hover,
.cover-share-dropdown button:hover {
    border-radius: 0;
    background: rgba(243, 244, 246, .92);
}

.cover-share-title {
    position: relative;
    z-index: 1;
    margin: 0 14px 6px;
    color: #000;
    font-size: 12px;
    line-height: 1.15;
    font-weight: 900;
}

.cover-share-title-mobile {
    display: none;
}

.cover-share-description {
    position: relative;
    z-index: 1;
    margin: 0 14px 8px;
    color: #111827;
    font-size: 11px;
    line-height: 1.3;
    font-weight: 500;
}

.cover-share-dropdown a:last-child,
.cover-share-dropdown button:last-child {
    border-bottom: 0;
}

.cover-share-icon {
    width: 21px;
    height: 21px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 12px;
    font-weight: 900;
    flex: 0 0 auto;
}

.cover-share-icon.link {
    background: #fff;
    color: #111827;
}

.cover-share-icon.facebook { background: #4267B2; }
.cover-share-icon.x { background: #000; }
.cover-share-icon.pinterest { background: #bd081c; }
.cover-share-icon.whatsapp { background: #16a34a; }
.cover-share-icon.email { background: #fff; color: #111827; }
.cover-share-icon.telegram { background: #229ED9; }
.cover-share-icon.linkedin { background: #0a66c2; }
.cover-share-icon.threads { background: #000; }
.cover-share-icon.reddit { background: #ff4500; }

.cover-listen-btn {
    width: clamp(235px, 34vw, 300px);
    min-width: 0;
    border: 0;
    border-radius: 999px;
    justify-content: flex-start;
    gap: 7px;
    padding: 0 8px 0 0;
    font-size: 13px;
    font-weight: 500;
    box-shadow: none;
}

.cover-listen-btn.is-reading {
    color: #e50914;
}

.listen-seek-btn {
    width: 29px;
    height: 29px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #111827;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex: 0 0 auto;
}

.listen-seek-btn svg {
    width: 22px;
    height: 22px;
}

.listen-play-circle {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: #f0f0f0;
    border: 1px solid #d8d8d8;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
}

.listen-play-icon,
.listen-pause-icon {
    width: 16px;
    height: 16px;
    fill: #111827;
}

.cover-listen-btn .listen-pause-icon {
    display: none;
}

.cover-listen-btn.is-reading .listen-play-icon {
    display: none;
}

.cover-listen-btn.is-reading .listen-pause-icon {
    display: block;
}

.listen-time,
.listen-remaining {
    color: #111827;
    font-size: 13px;
    line-height: 1;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
}

.listen-progress {
    position: relative;
    width: 86px;
    height: 3px;
    border-radius: 999px;
    background: #b8b8b8;
    flex: 1 1 auto;
    min-width: 42px;
}

.listen-progress-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    border-radius: inherit;
    background: #111827;
}

.listen-progress-dot {
    position: absolute;
    top: 50%;
    left: 0%;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #000;
    transform: translate(-50%, -50%);
}

.dk-comments {
    margin-top: 2rem;
    border: 1px solid #e50914;
    background: #f3f3f3;
}

.dk-comments-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    padding: 28px 32px;
    background: #e50914;
    color: #fff;
}

.dk-comments-hero h3 {
    margin: 0;
    font-size: 38px;
    line-height: 1.08;
    font-weight: 400;
    color: #fff;
}

.dk-comments-hero p {
    margin: 18px 0 0;
    font-size: 18px;
    line-height: 1.35;
    color: #fff;
}

.dk-comments-hero-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 7px;
    white-space: nowrap;
}

.dk-comments-follow {
    min-width: 118px;
    height: 42px;
    border: 1px solid rgba(255,255,255,.9);
    border-radius: 4px;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    line-height: 1;
    font-weight: 800;
    text-decoration: none;
}

.dk-comments-auth {
    color: #fff;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
}

.dk-comments-compose {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding: 26px 32px;
}

.dk-comments-avatar {
    width: 54px;
    height: 54px;
    border-radius: 999px;
    background: #fff;
    color: #d1d5db;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
}

.dk-comments-form {
    flex: 1;
    display: grid;
    gap: 10px;
}

.dk-comments-name,
.dk-comments-textarea {
    width: 100%;
    border: 2px solid #e50914;
    border-radius: 6px;
    background: #fff;
    color: #111827;
    font-size: 16px;
    line-height: 1.4;
    box-sizing: border-box;
}

.dk-comments-name {
    height: 44px;
    padding: 0 14px;
}

.dk-comments-textarea {
    min-height: 84px;
    padding: 14px;
    resize: vertical;
}

.dk-comments-submit {
    justify-self: end;
    height: 40px;
    padding: 0 18px;
    border: 0;
    border-radius: 4px;
    background: #e50914;
    color: #fff;
    font-size: 12px;
    font-weight: 800;
    cursor: pointer;
}

.dk-comments-list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    padding: 22px 32px 0;
}

.dk-comments-tab {
    position: relative;
    padding-bottom: 16px;
    color: #111827;
    font-size: 18px;
    font-weight: 800;
    text-transform: uppercase;
}

.dk-comments-tab::after {
    content: "";
    position: absolute;
    left: 0;
    right: -130px;
    bottom: 0;
    height: 4px;
    background: #ff5b63;
}

.dk-comments-sort {
    color: #e50914;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
}

.dk-comments-rule {
    height: 3px;
    margin: 0 32px 22px;
    background: #e5e7eb;
}

.dk-comment-item {
    margin: 0 32px 18px;
    padding: 0 0 16px;
    border-bottom: 1px solid #e5e7eb;
}

.dk-comment-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
}

.dk-comment-initial {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: #fff;
    color: #e50914;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 900;
}

.dk-comment-name {
    margin: 0;
    font-size: 12px;
    font-weight: 800;
    color: #111827;
}

.dk-comment-time {
    margin: 1px 0 0;
    font-size: 12px;
    color: #6b7280;
}

.dk-comment-body {
    margin: 0 0 0 46px;
    font-size: 15px;
    line-height: 1.55;
    color: #374151;
}

.dk-comments-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 8px 32px 34px;
    color: #111827;
    font-size: 19px;
    font-weight: 500;
}

.odt-article-body blockquote {
    position: relative;
    border-left: 0;
    background: #fff;
    box-shadow: 0 8px 28px rgba(17, 24, 39, 0.10);
    padding: 56px 30px 30px;
    margin: 1.85rem 0 2.05rem;
    font-size: 19px;
    line-height: 1.55;
    color: #111827;
    font-weight: 430;
}

.odt-article-body blockquote + p {
    margin-top: 1.2rem;
}

@media (max-width: 640px) {
    .odt-article-body blockquote {
        margin-left: 0;
        padding: 48px 18px 22px;
        margin-top: 1.35rem;
        margin-bottom: 1.55rem;
        font-size: 17px;
        line-height: 1.5;
    }

    .odt-article-body .twitter-tweet,
    .odt-article-body .twitter-tweet-rendered,
    .odt-article-body iframe[id^="twitter-widget-"] {
        max-width: 100% !important;
        min-height: 430px !important;
        margin-top: 1.35rem !important;
        margin-right: 0 !important;
        margin-bottom: 1.55rem !important;
        margin-left: 0 !important;
    }
}

.odt-article-body blockquote::before {
    content: "“";
    position: absolute;
    top: 14px;
    left: 30px;
    color: #d60918;
    font-size: 58px;
    line-height: 1;
    font-weight: 900;
}

.odt-article-body blockquote::after {
    content: "";
    position: absolute;
    top: 31px;
    left: 88px;
    right: 30px;
    height: 4px;
    background: #d60918;
}

.odt-article-body blockquote p,
.odt-article-body blockquote strong,
.odt-article-body blockquote span {
    font-size: inherit !important;
    line-height: inherit !important;
    color: inherit !important;
}

.odt-article-body blockquote p {
    margin-bottom: 1.45rem;
}

.odt-article-body blockquote p:last-child {
    margin-bottom: 0;
}

.odt-article-body blockquote p,
.odt-article-body blockquote strong,
.odt-article-body blockquote span {
    font-size: inherit !important;
    line-height: inherit !important;
    color: inherit !important;
}

.odt-article-body a {
    color: #bc0e22;
    font-weight: 700;
    text-decoration: none;
}

.odt-article-body a:hover {
    color: #bc0e22;
    text-decoration: underline;
}

/* Linkten hemen sonra kalın metin gelirse, editörün kaybettiği ara boşluğu görünür tutar. */
.odt-article-body a + strong::before,
.odt-article-body a + b::before {
    content: "\00a0";
    white-space: pre;
}

.odt-article-body .article-gallery-frame {
    scroll-margin-top: 100px;
    margin: 1.8rem 0 2.35rem;
}

.odt-article-body .article-gallery-count {
    display: grid;
    grid-template-columns: minmax(70px, 1fr) auto minmax(70px, 1fr);
    align-items: center;
    gap: 22px;
    margin: 1.45rem 0 1.35rem;
    color: #d60918;
    font-size: 25px;
    line-height: 1;
    font-weight: 900;
    text-align: center;
}

.odt-article-body .article-gallery-count::before,
.odt-article-body .article-gallery-count::after {
    content: '';
    height: 1px;
    background: #d9d9d9;
}

.odt-article-body .article-gallery-count-current {
    color: #000;
    font-size: 34px;
}

.odt-article-body .article-gallery-count-divider {
    display: inline-block;
    width: 1px;
    height: 34px;
    margin: 0 11px;
    background: #d9d9d9;
    vertical-align: middle;
}

.odt-article-body .article-gallery-heading {
    margin: 0 0 1rem;
    font-size: 28px;
    line-height: 1.18;
    font-weight: 800;
    color: #000;
}

.odt-article-body .article-gallery-figure {
    margin: 0;
    background: #fff;
}

.odt-article-body .article-gallery-figure img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: contain;
}

.odt-article-body .article-gallery-caption {
    margin: 1.55rem 0 0;
    font-size: 16px;
    line-height: 1.6;
    color: #000;
    font-weight: 400;
}

.odt-article-body .article-gallery-caption strong,
.odt-article-body .article-gallery-caption b {
    font-weight: 700;
}

.odt-article-body .article-gallery-caption a {
    color: #d60918;
    font-weight: 700;
    text-decoration: none;
}

.odt-article-body .article-gallery-caption p,
.odt-article-body .article-gallery-caption div {
    margin: 0 0 .75rem;
}

.odt-article-body .article-gallery-caption p:last-child,
.odt-article-body .article-gallery-caption div:last-child {
    margin-bottom: 0;
}

.odt-article-body .article-gallery-credit {
    margin: .55rem 0 0;
    font-size: 13px;
    line-height: 1.35;
    color: #646464;
    font-weight: 700;
}

.article-hero-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
}

.article-sidebar-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.sidebar-list-category {
    display: none;
}

.article-sidebar-stack section a.flex > img.shrink-0,
.article-sidebar-stack section a.flex > div.shrink-0 {
    width: 136px !important;
    height: 88px !important;
}

.article-sidebar-stack section a.flex > img.shrink-0 {
    object-fit: contain !important;
    object-position: center !important;
    background: #f5f5f5 !important;
}

.article-cover-frame {
    max-width: 760px;
}

/* GUNCELLENEN META BAR STILLERI */
html, body {
    max-width: 100%;
    overflow-x: hidden;
    margin: 0 !important;
    padding: 0 !important;
}

.article-page-root {
    width: 100%;
    max-width: 950px;
    overflow-x: clip;
}

.article-main-column,
.article-main-column > div,
.article-main-column img,
.odt-article-body,
.odt-article-body * {
    max-width: 100%;
}

.article-meta-bar {
    border-top: 1px solid #d4d4d4;
    border-bottom: 1px solid #d4d4d4;
    padding: 6px 0;
}

.article-meta-divider {
    width: 1px;
    height: 20px;
    background: #d4d4d4;
    display: inline-block;
}

.article-meta-news-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #646464;
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
}

.article-meta-share-slot {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    width: 68px;
    min-width: 68px;
    height: 26px;
}

.article-meta-share-slot .cover-share-menu {
    display: inline-flex;
}

.article-meta-share-slot .cover-action-btn {
    width: auto;
    min-width: 0;
    height: 26px;
    gap: 3px;
    padding: 0 7px 0 4px;
    border: 1px solid #d60918;
    border-radius: 4px;
    background: #d60918;
    box-shadow: none;
    color: #fff;
}

.article-meta-share-slot .cover-action-btn:hover,
.article-meta-share-slot .cover-action-btn:focus-visible {
    background: #b90a17;
    color: #fff;
    border-color: #b90a17;
    outline: 0;
}

.article-meta-share-slot .cover-action-btn svg {
    width: 20px;
    height: 20px;
}

.article-meta-share-slot .cover-share-menu > .cover-action-btn svg {
    transform: scaleX(-1);
}

.article-meta-share-slot .cover-action-btn::after {
    content: "Paylaş";
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
}

.article-meta-share-slot .cover-share-menu::before {
    left: 0;
    bottom: calc(100% + 8px);
}

.article-meta-share-slot .cover-share-menu::after {
    left: 7px;
    bottom: calc(100% + 1px);
}

.article-meta-share-divider {
    width: 1px;
    height: 20px;
    margin: 0 1px;
    background: #d4d4d4;
    display: inline-block;
}

@media (min-width: 900px) {
    .article-meta-share-slot {
        margin-right: -10px;
    }
}

.article-meta-share-slot .cover-share-dropdown {
    top: calc(100% + 7px);
}

.desktop-breadcrumb-title {
    display: inline;
    color: #4b5563;
    max-width: 420px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.google-source-follow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 44px;
    margin: 0 0 1rem;
    padding: 7px 10px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background: #fff;
    color: #111827;
    text-decoration: none;
}

.google-source-follow img {
    width: 28px;
    height: 28px;
    object-fit: contain;
    flex: 0 0 auto;
}

.google-source-follow span {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
    font-size: 13px;
    line-height: 1.25;
    font-weight: 500;
}

.google-source-follow strong {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 74px;
    height: 30px;
    padding: 0 13px;
    border-radius: 999px;
    background: #d60918;
    color: #fff;
    font-size: 12px;
    line-height: 1;
    font-weight: 800;
    flex: 0 0 auto;
}

@media (max-width: 899px) {
    .article-most-read {
        display: none !important;
    }

    html, body {
        overflow-x: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .article-page-root,
    .article-hero-layout,
    .article-main-column,
    .article-main-column > div,
    .article-cover-frame,
    .odt-article-body,
    .odt-article-body > * {
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box;
    }

    .article-page-root {
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        overflow: visible !important;
        overflow-x: visible !important;
    }

    /* Mobilde servis, takip ve etiket kartlari ilk cizimden once yerlerine
       alinana kadar haber govdesini tek karede goster. */
    .article-page-root.article-layout-pending { visibility: visible; }
    .article-page-root.article-layout-ready { visibility: visible; }

    html[data-theme="light"] .article-tag-link {
        background: #f3f4f6;
        color: #4b5563;
    }

    html[data-theme="light"] .article-tag-link:hover,
    html[data-theme="light"] .article-tag-link:focus-visible {
        background: #bc0e22;
        color: #fff;
    }

    .article-stream-root,
    .stream-article-block,
    .article-hero-layout,
    .article-main-column,
    .article-main-column > div {
        overflow: visible !important;
        overflow-x: visible !important;
    }

    .article-page-root > nav,
    .article-page-root > header,
    .article-page-root > .article-meta-bar,
    .article-main-column > :not(.article-cover-frame):not(.odt-article-body),
    .article-sidebar-stack,
    #comments-kamera-rezaletinin-golgesinde-kongre-yeni-parti-samsunda-yarin-secim-var-kavgalar-ve-on-secimler-hafizalarda {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .dk-inline-related {
        float: none;
        width: 100% !important;
        max-width: 100% !important;
        margin: 0.85rem 0 0.95rem;
        padding: 10px 0;
        border-right: 0;
        border-left: 0;
        border-top: 1px solid #dedede;
        border-bottom: 1px solid #dedede;
    }

    .dk-inline-related-title {
        font-size: 13px;
        margin-bottom: 9px;
    }

    .dk-inline-related-item {
        grid-template-columns: 108px 1fr;
        gap: 8px;
        align-items: flex-start;
        margin-bottom: 6px;
    }

    .dk-inline-related-thumb {
        width: 108px;
        align-self: flex-start;
        margin-top: 0;
        background: transparent;
    }

    .dk-inline-related-text {
        align-self: flex-start;
        margin-top: 0;
        font-size: 12px;
        line-height: 1.18;
    }

    .article-sidebar-stack section .mb-3 {
        margin-bottom: 0.35rem !important;
    }

    .article-sidebar-stack section a.flex {
        align-items: flex-start !important;
        gap: 0.35rem !important;
        padding-top: 0.35rem !important;
        padding-bottom: 0.35rem !important;
    }

    .sidebar-list-copy {
        min-width: 0;
    }

    .sidebar-list-copy > p {
        margin: 0 !important;
    }

    .sidebar-list-category {
        display: block;
        margin-top: 4px;
        color: #6b7280;
        font-size: 10px;
        line-height: 1.2;
        font-weight: 700;
        text-transform: uppercase;
    }

    .article-tag-link {
        font-size: 14px !important;
        line-height: 1.25 !important;
        font-weight: 500 !important;
    }

    .article-page-root > nav > div,
    .article-page-root > header h1,
    .article-summary,
    .odt-article-body > p,
    .odt-article-body > h2,
    .odt-article-body > h3,
    .odt-article-body > h4,
    .odt-article-body > ul,
    .odt-article-body > ol,
    .odt-article-body > blockquote,
    .odt-article-body > table,
    .odt-article-body > iframe,
    .odt-article-body > .table-wrapper,
    #comments-kamera-rezaletinin-golgesinde-kongre-yeni-parti-samsunda-yarin-secim-var-kavgalar-ve-on-secimler-hafizalarda {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .article-page-root > header h1 {
        font-size: 26px !important;
        line-height: 1.08 !important;
        font-weight: 800 !important;
    }

    .article-summary {
        font-size: 16px !important;
        line-height: 21px !important;

    }

    .article-meta-bar {
        padding: 4px var(--mobile-meta-gutter) !important;
        min-height: 34px !important;
        margin-bottom: 4px !important;
        box-sizing: border-box !important;
    }

    .article-meta-inner {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: space-between !important;
        flex-wrap: wrap !important;
        gap: 6px !important;
    }

    .article-meta-inner > div:first-child {
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
        min-width: 0 !important;
        flex: 1 1 auto !important;
        flex-wrap: wrap !important;
        row-gap: 3px !important;
        white-space: normal !important;
        overflow: visible !important;
    }

    .article-meta-inner > div:last-child {
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
        flex: 0 0 auto !important;
        white-space: nowrap !important;
    }

    .article-meta-bar span,
    .article-meta-bar a,
    .article-meta-bar button {
        font-size: 9px !important;
        line-height: 13px !important;
        font-weight: 500 !important;
    }

    .article-meta-inner > div:first-child img,
    .article-meta-inner > div:first-child svg {
