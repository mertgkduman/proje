<style id="dk-theme-styles">
.dk-theme-toggle{position:relative;display:inline-flex;flex:0 0 38px;width:38px;height:38px;align-items:center;justify-content:center;padding:0;border:1px solid #d2d6dc;border-radius:9px;background:#fff;color:#263244;cursor:pointer;transition:background-color .22s ease,border-color .22s ease,color .22s ease,transform .22s ease;}
.dk-theme-toggle:hover{border-color:#e30613;color:#e30613;transform:translateY(-1px)}
.dk-theme-toggle:focus-visible{outline:2px solid #e30613;outline-offset:2px}
.dk-theme-toggle svg{position:absolute;width:21px;height:21px;transition:opacity .24s ease,transform .32s cubic-bezier(.2,.8,.2,1)}
html[data-theme="light"] .dk-theme-moon{opacity:1;transform:rotate(0) scale(1)}
html[data-theme="light"] .dk-theme-sun{opacity:0;transform:rotate(-75deg) scale(.5)}
html[data-theme="dark"] .dk-theme-moon{opacity:0;transform:rotate(75deg) scale(.5)}
html[data-theme="dark"] .dk-theme-sun{opacity:1;transform:rotate(0) scale(1)}
html[data-theme="dark"]{color-scheme:dark;--dk-bg:#17181b;--dk-surface:#202124;--dk-surface-raised:#26272b;--dk-border:#3a3b40;--dk-text:#f1f0ed;--dk-muted:#b9bbc2;}
html[data-theme="dark"] body{background-color:var(--dk-bg)!important;color:var(--dk-text)!important;}
html[data-theme="dark"] .site-shell-paper,html[data-theme="dark"] header.site-shell{background-color:#1b1c20!important;border-color:var(--dk-border)!important;}
html[data-theme="dark"] :is(.bg-white,[class*="bg-white/"],[class*="bg-gray-50"],[class*="bg-gray-100"],[class*="bg-slate-50"],[class*="bg-slate-100"]){background-color:var(--dk-surface)!important;}
html[data-theme="dark"] :is(.bg-gray-200,.bg-slate-200){background-color:var(--dk-surface-raised)!important;}
html[data-theme="dark"] :is(.text-black,.text-gray-950,.text-gray-900,.text-gray-800,.text-gray-700,.text-gray-600,.text-slate-950,.text-slate-900,.text-slate-800,.text-slate-700,.text-slate-600){color:var(--dk-text)!important;}
html[data-theme="dark"] :is(.text-gray-500,.text-gray-400,.text-slate-500,.text-slate-400){color:var(--dk-muted)!important;}
html[data-theme="dark"] :is(.border-gray-100,.border-gray-200,.border-gray-300,.border-slate-100,.border-slate-200,.border-slate-300){border-color:var(--dk-border)!important;}
html[data-theme="dark"] :is(input,select,textarea){background-color:#222328!important;color:var(--dk-text)!important;border-color:var(--dk-border)!important;color-scheme:dark;}
html[data-theme="dark"] input::placeholder,html[data-theme="dark"] textarea::placeholder{color:#9da0a8!important;}
html[data-theme="dark"] table,html[data-theme="dark"] th,html[data-theme="dark"] td{border-color:var(--dk-border)!important;}
html[data-theme="dark"] .mobile-search-panel,html[data-theme="dark"] .mobile-search-content{background:#202124!important;color:var(--dk-text)!important;border-color:var(--dk-border)!important;}
html[data-theme="dark"] .mobile-search-panel{background:transparent!important;}
html[data-theme="dark"] .mobile-search-field input{background:transparent!important;}
html[data-theme="dark"] .header-weather-panel{background:#202124!important;color:var(--dk-text)!important;border-color:var(--dk-border)!important;}
html[data-theme="dark"] .mobile-search-overlay{background:rgba(8,9,11,.84)!important;}
html[data-theme="dark"] a:hover{color:#ed4652;}
html[data-theme="dark"] #searchBtn{background:#27282c!important;color:var(--dk-text)!important;border:1px solid #484a50!important;}
html[data-theme="dark"] #searchBtn svg{stroke:currentColor!important;}
html[data-theme="dark"] :is(.header-submit-link,.header-weather-toggle){color:var(--dk-text)!important;border-color:var(--dk-border)!important;}
html[data-theme="dark"] :is(.header-submit-link,.header-weather-toggle) svg{stroke:currentColor!important;}
html[data-theme="dark"] .header-weather-toggle:hover,
html[data-theme="dark"] .header-weather-toggle:focus-visible,
html[data-theme="dark"] .header-weather.is-open .header-weather-toggle{background:#303136!important;color:#ff6b74!important;}
html[data-theme="dark"] .header-submit-link:hover{color:#ff6b74!important;}
html[data-theme="dark"] .header-weather-panel :is(.header-weather-title,.header-weather-city){color:var(--dk-text)!important;}
html[data-theme="dark"] .header-weather-city{border-top-color:var(--dk-border)!important;}
html[data-theme="dark"] .header-weather-city:hover{background:#303136!important;}
html[data-theme="dark"] .header-weather-condition{color:var(--dk-muted)!important;}
html[data-theme="dark"] .header-weather-temperature{color:#ff6b74!important;}
html[data-theme="dark"] :is(.nav-category-dropdown,.mobile-nav-category-dropdown){background:var(--dk-surface-raised)!important;border-color:var(--dk-border)!important;box-shadow:0 16px 35px rgba(0,0,0,.34)!important;}
html[data-theme="dark"] :is(.nav-category-dropdown,.mobile-nav-category-dropdown) a{color:var(--dk-text)!important;}
html[data-theme="dark"] .mobile-nav-category-dropdown a{border-bottom-color:var(--dk-border)!important;}
html[data-theme="dark"] :is(.nav-category-dropdown,.mobile-nav-category-dropdown) a:hover,
html[data-theme="dark"] :is(.nav-category-dropdown,.mobile-nav-category-dropdown) a:focus-visible,
html[data-theme="dark"] .mobile-nav-category-dropdown a:active{background:#303136!important;color:#fff!important;}
html[data-theme="dark"] #dkThemeToggle{background:#27282c;border-color:#484a50;color:#f5d05d;}
html[data-theme="dark"] [style*="background:#fff"],html[data-theme="dark"] [style*="background: #fff"],html[data-theme="dark"] [style*="background-color:#fff"],html[data-theme="dark"] [style*="background-color: #fff"]{background-color:var(--dk-surface)!important;}
html[data-theme="dark"] [style*="color:#111"],html[data-theme="dark"] [style*="color: #111"],html[data-theme="dark"] [style*="color:#000"],html[data-theme="dark"] [style*="color: #000"]{color:var(--dk-text)!important;}
html[data-theme="dark"] .full-mobile{background:#1b1c20!important;color:var(--dk-text)!important;border-color:var(--dk-border)!important;}
html[data-theme="dark"] .full-mobile :is(.bg-white,.bg-gray-50,.bg-gray-100,[style*="background:#fff"],[style*="background: #fff"]){background-color:var(--dk-surface)!important;color:var(--dk-text)!important;border-color:var(--dk-border)!important;}
html[data-theme="dark"] .manset-media{background-color:var(--dk-surface)!important;}
html[data-theme="dark"] .category-title,html[data-theme="dark"] .category-card a{color:var(--dk-text)!important;}
html[data-theme="dark"] .category-desc{color:var(--dk-muted)!important;}
html[data-theme="dark"] :is(.category-card-media,.category-world-cup-banner){background-color:var(--dk-surface-raised)!important;}
html[data-theme="dark"] main :is(h1,h2,h3,h4,p,li,dt,dd,figcaption,blockquote){color:var(--dk-text)!important;}
html[data-theme="dark"] .category-kicker{color:#ed4652!important;}
html[data-theme="dark"] .category-desc,html[data-theme="dark"] .desktop-breadcrumb-title{color:var(--dk-muted)!important;}
html[data-theme="dark"] .article-summary,html[data-theme="dark"] .odt-article-body,html[data-theme="dark"] .odt-article-body :is(p,h2,h3,h4,li,blockquote,td,th){color:var(--dk-text)!important;}
html[data-theme="dark"] .odt-article-body a{color:#e30613!important;}
html[data-theme="dark"] :is(.google-source-follow,.cover-action-btn,.cover-share-icon,.article-services-panel,.article-service-link,.article-service-button,.article-instagram-follow,.share-copy-link){background:var(--dk-surface-raised)!important;color:var(--dk-text)!important;border-color:var(--dk-border)!important;}
html[data-theme="dark"] :is(.cover-share-title,.cover-share-description,.share-copy-label,.article-service-link,.article-service-button,.article-instagram-copy span,.article-instagram-copy strong){color:var(--dk-text)!important;}
html[data-theme="dark"] .article-service-feature{background:#302124!important;border-color:#63383d!important;color:#ff8991!important;}
html[data-theme="dark"] .article-tag-link{background:#3e434b!important;color:#f5f7fa!important;}
html[data-theme="dark"] .article-tag-link:hover,
html[data-theme="dark"] .article-tag-link:focus-visible{background:#555b65!important;color:#fff!important;}
html[data-theme="dark"] .cover-listen-btn{background:var(--dk-surface-raised)!important;color:var(--dk-text)!important;border-color:var(--dk-border)!important;}
html[data-theme="dark"] .cover-listen-btn.is-reading{color:#ff6b74!important;}
html[data-theme="dark"] .listen-seek-btn{background:transparent!important;color:var(--dk-text)!important;}
html[data-theme="dark"] .listen-seek-btn svg{stroke:currentColor!important;}
html[data-theme="dark"] .listen-play-circle{background:#37383d!important;color:var(--dk-text)!important;border-color:#4a4c52!important;}
html[data-theme="dark"] :is(.listen-play-icon,.listen-pause-icon){fill:var(--dk-text)!important;}
html[data-theme="dark"] :is(.listen-time,.listen-remaining){color:var(--dk-text)!important;}
html[data-theme="dark"] .listen-progress{background:#4a4c52!important;}
html[data-theme="dark"] .listen-progress-fill{background:#ed4652!important;}
html[data-theme="dark"] .listen-progress-dot{background:#ff6b74!important;}
html[data-theme="dark"] .article-content,html[data-theme="dark"] .article-sidebar,html[data-theme="dark"] .article-meta,html[data-theme="dark"] .article-comments,html[data-theme="dark"] [id^="comments-"]{color:var(--dk-text)!important;}
html[data-theme="dark"] [id^="comments-"] :is(input,textarea,button){background:#222328!important;color:var(--dk-text)!important;border-color:var(--dk-border)!important;}
html[data-theme="dark"] .article-service-feature:hover{background:#3a2226!important;}
html[data-theme="dark"] header .header-brand img[data-theme-logo]{filter:none!important;}
@media(max-width:640px){.dk-theme-toggle{flex-basis:36px;width:36px;height:36px;margin-left:3px;border-radius:8px}}

@media(prefers-reduced-motion:reduce){.dk-theme-toggle,.dk-theme-toggle svg{transition:none!important}}
</style>
<style id="dk-brand-red">
    :root { --brand-red: #cc1517; --brand-red-rgb: 204, 21, 23; }
    .text-red-400,.text-red-500,.text-red-600,.hover\:text-red-500:hover,.hover\:text-red-600:hover { color:#cc1517 !important; }
    .bg-red-600,.hover\:bg-red-600:hover { background-color:#cc1517 !important; }
    .hover\:bg-red-700:hover { background-color:#c70511 !important; }
    .bg-red-50 { background-color:rgba(227,6,19,.05) !important; }
    .bg-red-100 { background-color:rgba(227,6,19,.10) !important; }
    .border-red-300,.border-red-500,.border-red-800 { border-color:#cc1517 !important; }
    .ring-red-500 { --tw-ring-color:rgba(227,6,19,.5) !important; }
</style>
</head>

<body class="text-gray-900">

<!-- HEADER -->
<header class="site-shell site-shell-paper bg-white border-b border-gray-200 sticky top-0 z-50 shadow-none mt-0 md:mt-4">
<div class="px-4">
<time class="header-mobile-date" datetime="2026-11-22">22 Kasım 2026 | Pazar</time>
<div class="flex items-center justify-between h-15">

    <!-- LOGO -->
    <div class="header-brand">
        <a href="https://diyekonustu.com">
           <img src="https://diyekonustu.com/storage/branding/diyekonustu-logo-siyah.png" data-theme-logo data-light-src="https://diyekonustu.com/storage/branding/diyekonustu-logo-siyah.png" data-dark-src="https://diyekonustu.com/storage/branding/diyekonustu-logo-beyaz.png" alt="Diye Konuştu" style="width: 170px; height: auto; margin-top: 5px; margin-bottom: 5px; " fetchpriority="high" decoding="async">
        </a>
        <time class="header-date" datetime="2026-11-22">22 Kasım 2026, Pazar</time>
    </div>

<!-- SEARCH -->
<div class="header-search-actions flex items-center relative gap-1">

