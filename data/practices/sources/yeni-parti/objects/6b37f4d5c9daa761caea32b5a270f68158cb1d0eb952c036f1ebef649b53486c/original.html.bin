        <div style="display:flex; align-items:center; gap:6px; padding:0 7px; border-right:1px solid rgba(0,0,0,0.15);">
            <div>
                <div style="color:#000; font-size:8px; font-weight:700; letter-spacing:0.05em;">€ EURO</div>
                <div id="pd-euro-fiyat" style="color:#000; font-size:14px; font-weight:800; line-height:1;">-</div>
                <div id="pd-euro-degisim" style="font-size:8px; color:#000;">-</div>
            </div>
            <canvas id="euro-chart2" width="36" height="24"></canvas>
        </div>

        <div style="display:flex; align-items:center; gap:6px; padding:0 7px; border-right:1px solid rgba(0,0,0,0.15);">
            <div>
                <div style="color:#000; font-size:8px; font-weight:700; letter-spacing:0.05em;">BİTCOİN</div>
                <div id="pd-btc-fiyat" style="color:#000; font-size:14px; font-weight:800; line-height:1;">-</div>
                <div id="pd-btc-degisim" style="font-size:8px; color:#000;">-</div>
            </div>
            <canvas id="btc-chart2" width="36" height="24"></canvas>
        </div>

        <div style="display:flex; align-items:center; gap:6px; padding:0 7px; border-right:1px solid rgba(0,0,0,0.15);">
            <div>
                <div style="color:#000; font-size:8px; font-weight:700; letter-spacing:0.05em;">ÇEYREK ALTIN</div>
                <div id="pd-ceyrek-fiyat" style="color:#000; font-size:14px; font-weight:800; line-height:1;">-</div>
