    box-shadow: none;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    transition: background .16s ease, transform .16s ease;
}

.header-search-button:hover,
.header-search-button:focus-visible {
    border-color: transparent;
    background: #000;
    color: #fff;
    transform: translateY(-1px);
    outline: 0;
}

.header-submit-link {
    display: none;
}

.header-submit-text {
    display: inline-flex;
    gap: 4px;
}

.header-weather {
    position: relative;
    display: none;
}

.header-weather-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: 34px;
    height: 34px;
    padding: 0 5px;
    border: 0;
    background: transparent;
    color: #172033;
    cursor: pointer;
    transition: color .16s ease, background .16s ease;
}

.header-weather-toggle:hover,
.header-weather-toggle:focus-visible,
.header-weather.is-open .header-weather-toggle {
    color: #e30613;
    background: #f3f4f6;
    outline: 0;
}

.header-weather-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 12000;
    display: none;
    width: 205px;
    max-height: 390px;
    overflow-y: auto;
    padding: 8px 0;
    border: 1px solid #e5e7eb;
    background: #fff;
    box-shadow: 0 16px 35px rgba(15, 23, 42, .14);
}

.header-weather.is-open .header-weather-panel {
    display: block;
}

.header-weather-title {
    margin: 0;
    padding: 4px 11px 7px;
    color: #6b7280;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
}
.header-weather-title a{display:inline-flex;align-items:center;gap:6px;color:#e30613;text-decoration:none;font-weight:850}.header-weather-title a:hover{color:#8f0918;text-decoration:underline}.header-weather-title svg{width:15px;height:15px}

.header-weather-label {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    color: currentColor;
    font-size: 10px;
    font-weight: 600;
    line-height: 10px;
    text-align: left;
}

.header-weather-label span {
    display: block;
}

.header-weather-city {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 8px 11px;
    border: 0;
    border-top: 1px solid #f1f2f4;
    background: transparent;
    color: #172033;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
    text-align: left;
}

.header-weather-city:hover {
    background: #f8fafc;
}

.header-weather-temperature {
    color: #e30613;
    font-size: 13px;
    font-weight: 700;
    text-align: right;
}

.header-weather-reading {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 5px;
    min-width: 56px;
}

.header-weather-condition {
    display: inline-flex;
    width: 17px;
    height: 17px;
    color: #64748b;
}

.header-weather-condition svg {
    width: 17px;
    height: 17px;
}

.header-brand {
    display: flex;
    align-items: center;
    min-width: 0;
}

.header-date {
    display: none;
}


.header-mobile-date {
    display: none;
}

.mobile-search-overlay {
    position: fixed;
    inset: 0;
    z-index: 13000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 18vh 18px 24px;
    background: rgba(9, 10, 12, .74);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity .22s ease, visibility .22s ease;
}

.mobile-search-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
}

.mobile-search-panel {
    width: min(100%, 540px);
    color: #fff;
}

.mobile-search-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.mobile-search-heading h2 {
    margin: 0;
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
}

.mobile-search-close,
.mobile-search-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    cursor: pointer;
}

.mobile-search-close {
    width: 34px;
    height: 34px;
    padding: 0;
    color: #fff;
    background: rgba(255, 255, 255, .12);
    border-radius: 50%;
}

.mobile-search-field {
    display: flex;
    align-items: center;
    flex-direction: row;
    gap: 5px;
    padding: 5px 0 8px;
    border-bottom: 2px solid rgba(255, 255, 255, .9);
}

.mobile-search-field svg {
    flex: 0 0 auto;
}

.mobile-search-field input {
    min-width: 0;
    flex: 1;
    padding: 8px 0;
    color: #fff;
    background: transparent;
    border: 0;
    outline: 0;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
}

.mobile-search-field input::placeholder {
    color: rgba(255, 255, 255, .58);
}

.mobile-search-submit {
    width: 38px;
    height: 38px;
    padding: 0;
    color: #172033;
    background: #facc15;
    border-radius: 50%;
}

.mobile-search-category-links,
.mobile-search-more-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
}

.mobile-search-category-links {
    margin-top: 18px;
}

.mobile-search-category-link,
.mobile-search-category-toggle {
    display: inline;
    padding: 0;
    color: rgba(218, 226, 234, .82);
    border: 0;
    background: transparent;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: .02em;
    text-decoration: none;
}

.mobile-search-category-toggle {
    cursor: pointer;
    color: #e30613;
    font-weight: 600;
}

.mobile-search-category-link:hover,
.mobile-search-category-link:focus-visible,
.mobile-search-category-toggle:hover,
.mobile-search-category-toggle:focus-visible {
    color: #fff4f4;
}

.mobile-search-breaking-link {
    display: inline-flex;
    align-items: center;
    color: #e30613;
    font-weight: 700;
}

.mobile-search-more-categories {
    display: flex;
    margin-top: 13px;
}

body.mobile-search-is-open {
    overflow: hidden;
}

body.mobile-search-is-open .site-nav-shell,
body.mobile-search-is-open .site-mobile-nav-shell {
    visibility: hidden !important;
    pointer-events: none !important;
}

@media (max-width: 768px) {
    .header-search-actions {
        transform: translateX(9px);
    }

    .header-brand {
        align-items: flex-start;
        margin-left: -6px;
        padding: 0;
    }

    .header-mobile-date {
        display: block;
        padding-top: 4px;
        color: #6b7280;
        font-size: 10px;
        font-weight: 600;
        line-height: 1.2;
        white-space: nowrap;
    }

    .header-submit-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: auto;
        height: 32px;
        gap: 4px;
        padding: 3px 5px;
        color: #111827;
        border: 1px solid #d1d5db;
        border-radius: 6px;
    }

    .header-submit-link .header-submit-text {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 0;
        font-size: 8px;
        line-height: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

    .header-submit-link .header-submit-text span {
        display: block;
    }

    .header-weather {
        display: inline-flex;
        transform: translateX(4px);
    }

    .header-weather-toggle {
        height: 32px;
        gap: 3px;
        padding: 0 4px;
    }

    .header-weather-label {
        font-size: 8px;
        line-height: 9px;
        font-weight: 700;
    }
}

@media (max-width: 360px) {
    .header-weather-label {
        display: none;
    }
}

@media (min-width: 769px) {
    .header-search-actions {
        gap: 8px;
    }

    .header-weather {
        display: inline-flex;
    }

    .header-submit-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 32px;
        gap: 6px;
        padding: 6px 10px;
        color: #000;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        transition: color .2s ease;
    }

    .header-submit-link:hover {
        color: #e30613;
    }

    .header-date {
        display: block;
        margin-left: 14px;
        padding-left: 14px;
        border-left: 1px solid #d1d5db;
        color: #6b7280;
        font-size: 11px;
        font-weight: 600;
        line-height: 1.2;
        white-space: nowrap;
    }

}
html, body, body *, body *::before, body *::after, input, textarea, select, button {
    font-family: var(--font-body) !important;
}
body {
    font-size: var(--font-size-body);
    line-height: var(--line-height-body);
    font-weight: 400;
    letter-spacing: var(--letter-spacing-body);
}
[x-cloak] { display: none !important; }
h1,h2,h3,h4,h5,h6 {
    font-family: var(--font-body) !important;
    font-weight: var(--font-weight-heading);
    letter-spacing: var(--letter-spacing-heading);
    text-transform: var(--heading-transform);
}
.libre,
.slider-title,
.prose,
.font-meta,
.text-xs,
nav a,
.meta-text {
    font-family: var(--font-body) !important;
}
.prose {
    font-size: var(--font-size-content);
    line-height: var(--line-height-content);
    font-weight: var(--font-weight-content);
    text-align: var(--content-text-align);
}
img { border-radius: 0 !important; }
.prose p { margin-bottom: var(--paragraph-spacing); }
.prose h2 { font-size: 1.4rem; font-weight: 700; margin-top: 2rem; margin-bottom: 1rem; }
.prose h3 { font-size: 1.2rem; font-weight: 700; margin-top: 1.5rem; margin-bottom: .75rem; }
.prose h4 { font-size: 1.1rem; font-weight: 600; margin-top: 1.25rem; margin-bottom: .5rem; }
.prose ul { list-style: disc; padding-left: 1.5rem; margin-bottom: 1.25rem; }
.prose ol { list-style: decimal; padding-left: 1.5rem; margin-bottom: 1.25rem; }
.prose li { margin-bottom: .4rem; }
.prose blockquote { border-left: 4px solid #e30613; padding-left: 1rem; color: #4b5563; font-style: italic; margin: 1.5rem 0; }
.prose img { border-radius: 0 !important; margin: 1.5rem auto; display: block; max-width: 100%; }
.prose a[href*="storage/content"] { display: none !important; }
.breaking-bar-shell { display: none !important; }
.breaking-ticker { display: flex; gap: 40px; white-space: nowrap; animation: ticker 20s linear infinite; }
@keyframes ticker { 0% { transform: translateX(0) } 100% { transform: translateX(-100%) } }
</style>

