@media (min-width: 900px) {
    .article-hero-layout {
        grid-template-columns: minmax(0, 630px) minmax(0, 290px);
        align-items: start;
        justify-content: space-between;
    }

    .article-hero-layout.is-gallery-layout {
        grid-template-columns: minmax(0, 760px);
        justify-content: center;
    }

    .article-hero-layout.is-gallery-layout > .article-content-column {
        width: 100%;
        max-width: 760px;
        margin-left: auto;
        margin-right: auto;
    }
}

.article-scroll-top-btn {
    position: fixed;
    right: 15px;
    bottom: 18px;
    width: 36px;
    height: 40px;
    border: 1px solid #8d0012;
    border-radius: 7px;
    background: linear-gradient(110deg,#d2051e 0%,#bd001a 54%,#8d0012 100%);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: opacity .2s ease, transform .2s ease, visibility .2s ease, background .2s ease;
}

.article-scroll-top-btn.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.article-scroll-top-btn:hover {
    background: #000;
}

@media print {
    .article-page-root {
        width: 100% !important;
        max-width: 950px !important;
        margin-left: auto !important;
        margin-right: auto !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        overflow: visible !important;
    }

    .article-page-root > header {
        margin-bottom: 10px !important;
    }

    .article-page-root > header h1 {
        font-size: 30px !important;
        line-height: 34px !important;
        margin: 0 0 8px !important;
    }

    .article-summary {
        font-size: 16px !important;
        line-height: 22px !important;
        margin: 0 !important;
    }

    .article-meta-bar {
        margin-bottom: 10px !important;
    }

    .article-stream-root,
    .stream-article-block,
    .article-main-column {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        break-before: auto !important;
        page-break-before: auto !important;
    }

    .article-stream-root > .stream-article-block:not(:first-child) {
        display: none !important;
    }

    .article-hero-layout {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        overflow: visible !important;
    }

    .article-hero-layout::after {
        content: "" !important;
        display: table !important;
        clear: both !important;
    }

    .article-content-column {
        float: left !important;
        width: 67% !important;
        max-width: 67% !important;
    }

    .article-sidebar-stack {
        float: right !important;
        width: 29% !important;
        max-width: 29% !important;
    }

    .article-hero-layout.is-gallery-layout .article-content-column {
        float: none !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    .article-content-column,
    .article-sidebar-stack {
        min-width: 0 !important;
    }

    .article-sidebar-stack {
        display: flex !important;
        visibility: visible !important;
        gap: 14px !important;
        break-inside: auto !important;
        page-break-inside: auto !important;
    }

    .google-source-follow,
    .article-cover-actions,
    .article-scroll-top-btn,
    #comments-kamera-rezaletinin-golgesinde-kongre-yeni-parti-samsunda-yarin-secim-var-kavgalar-ve-on-secimler-hafizalarda {
        display: none !important;
        visibility: hidden !important;
    }

    .article-page-root svg,
    .article-page-root svg * {
        color: #111 !important;
        stroke: #111 !important;
    }

    .article-page-root button,
    .article-page-root .cover-action-btn,
    .article-page-root .article-meta-news-link,
    .article-page-root a[aria-label] {
        color: #111 !important;
        background: #fff !important;
        border-color: #d1d5db !important;
        box-shadow: none !important;
    }

    .article-page-root img[src*="Google_News_icon"],
    .article-page-root .article-meta-news-link img {
        background: transparent !important;
        filter: none !important;
        opacity: 1 !important;
    }

    .article-cover-frame {
        display: block !important;
        position: relative !important;
        left: auto !important;
        right: auto !important;
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        margin: 0 0 14px !important;
        transform: none !important;
        overflow: hidden !important;
        break-before: auto !important;
        page-break-before: auto !important;
        break-inside: auto !important;
        page-break-inside: auto !important;
        line-height: 0 !important;
    }

    .article-cover-frame img,
    .article-cover-frame > img,
    .article-cover-frame .article-cover-image {
        display: block !important;
        width: 100% !important;
        min-width: 0 !important;
        max-width: 100% !important;
        height: auto !important;
        max-height: none !important;
        object-fit: contain !important;
        object-position: center top !important;
        transform: none !important;
        border-radius: 0 !important;
        position: static !important;
    }

    .odt-article-body {
        font-size: 15px !important;
        line-height: 1.45 !important;
        margin-top: 0 !important;
    }

    .odt-article-body p {
        margin: 0 0 10px !important;
        font-size: 12px !important;
        line-height: 1.38 !important;
    }

    section[aria-label="Son haberler"] {
        margin-top: 0.45rem !important;
        padding-top: 0.25rem !important;
        padding-bottom: 0.25rem !important;
    }

    section[aria-label="Son haberler"] .mb-2 {
        margin-bottom: 0.1rem !important;
    }

    section[aria-label="Son haberler"] .grid {
        gap: 0 !important;
    }

    section[aria-label="Son haberler"] a {
        padding-top: 0.12rem !important;
        padding-bottom: 0.12rem !important;
    }

    .article-bottom-ad {
        display: none !important;
    }

    .odt-article-body figure,
    .odt-article-body .wp-block-image,
    .odt-article-body .kg-image-card,
    .odt-article-body p:has(img) {
        margin: .72rem 0 .82rem !important;
        break-before: auto !important;
        page-break-before: auto !important;
        break-inside: avoid !important;
        page-break-inside: avoid !important;
    }

    .odt-article-body figure img,
    .odt-article-body .wp-block-image img,
    .odt-article-body .kg-image-card img,
    .odt-article-body p img,
    .odt-article-body > img {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        max-height: 330px !important;
        height: auto !important;
        object-fit: contain !important;
        border-radius: 0 !important;
        object-position: center top !important;
        margin: 0 !important;
    }
}

/* Haber okuma metni ve alıntı görünümü: eski sade okuma ayarları */
.odt-article-body {
    font-size: 15px !important;
    line-height: 1.38 !important;
}

.odt-article-body p {
    font-size: 15px !important;
    line-height: 23px !important;
    color: #000 !important;
    font-weight: 400 !important;
    letter-spacing: 0 !important;
    margin-top: 0 !important;
    margin-bottom: 1rem !important;
}

.odt-article-body blockquote,
.odt-article-body > blockquote {
    position: relative !important;
    border-left: 3px solid #de1c26 !important;
    background: #fafafa !important;
    box-shadow: none !important;
    padding: .85rem 1rem .85rem .9rem !important;
    margin: 1.65rem 0 1.85rem !important;
    font-size: 15px !important;
    line-height: 23px !important;
    color: #000 !important;
    font-weight: 400 !important;
    font-style: normal !important;
}

.odt-article-body blockquote::before,
.odt-article-body blockquote::after {
    content: none !important;
    display: none !important;
}

.odt-article-body blockquote p,
.odt-article-body blockquote strong,
.odt-article-body blockquote span {
    font-size: inherit !important;
    line-height: inherit !important;
    color: inherit !important;
    font-style: inherit !important;
}

.odt-article-body blockquote p {
    margin: 0 0 .85rem !important;
}

.odt-article-body blockquote p:last-child {
    margin-bottom: 0 !important;
}

@media (max-width: 640px) {
    .odt-article-body,
    .odt-article-body p {
        font-size: 16px !important;
        line-height: 1.45 !important;
    }

    .odt-article-body blockquote,
    .odt-article-body > blockquote {
        padding: .75rem 1rem .75rem 24px !important;
        margin: 1.35rem 0 1.55rem !important;
        font-size: 16px !important;
        line-height: 1.45 !important;
    }
}

/* Haber içi görsellerin altında oluşan fazla boşluğu kapatır. */
.odt-article-body figure,
.odt-article-body .wp-block-image,
.odt-article-body .kg-image-card,
.odt-article-body .attachment,
.odt-article-body p:has(img) {
    margin-bottom: 0 !important;
}

.odt-article-body figure figcaption {
    margin-top: .2rem !important;
}

.odt-article-body figure + p,
.odt-article-body .wp-block-image + p,
.odt-article-body .kg-image-card + p,
.odt-article-body .attachment + p,
.odt-article-body p:has(img) + p {
    margin-top: .25rem !important;
}

.odt-article-body .article-gallery-figure + .article-gallery-caption {
    margin-top: 1.15rem !important;
}

/* Haber metni ritmi: paragraf, başlık, görsel, altyazı ve alıntı aralıklarını tek standarda bağlar. */
.odt-article-body {
    font-size: 15px !important;
    line-height: 1.5 !important;
}

.odt-article-body p {
    margin: 0 0 14px !important;
    font-size: 15px !important;
    line-height: 23px !important;
}

.odt-article-body h2,
.odt-article-body h3,
.odt-article-body h4 {
    margin: 22px 0 13px !important;
    line-height: 1.25 !important;
}

.odt-article-body h2 + p,
.odt-article-body h3 + p,
.odt-article-body h4 + p,
.odt-article-body blockquote + p {
    margin-top: 0 !important;
}

.odt-article-body figure,
.odt-article-body .wp-block-image,
.odt-article-body .kg-image-card,
.odt-article-body .attachment,
.odt-article-body p:has(img) {
    margin: 18px 0 14px !important;
}

.odt-article-body figure img,
.odt-article-body .wp-block-image img,
.odt-article-body .kg-image-card img,
.odt-article-body p img {
    display: block !important;
    margin: 0 !important;
}

.odt-article-body figure figcaption,
.article-cover-caption {
    margin: 2px 0 0 !important;
    padding: 0 !important;
    border-top: 0 !important;
    font-size: 13px !important;
    line-height: 1.45 !important;
    color: #555 !important;
    font-weight: 400 !important;
    text-align: left !important;
}

.odt-article-body figure + p,
.odt-article-body .wp-block-image + p,
.odt-article-body .kg-image-card + p,
.odt-article-body .attachment + p,
.odt-article-body p:has(img) + p {
    margin-top: 0 !important;
}

.odt-article-body .article-gallery-frame {
    margin: 26px 0 34px !important;
}

.odt-article-body .article-gallery-figure {
    margin: 0 !important;
}

.odt-article-body .article-gallery-credit {
    margin: 8px 0 0 !important;
