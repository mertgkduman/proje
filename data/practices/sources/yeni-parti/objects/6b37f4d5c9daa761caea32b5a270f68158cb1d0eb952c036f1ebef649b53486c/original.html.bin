<style id="dk-sport-mega-layer-fix">
/* Spor/90+ açılır kartı, nav ve diğer header katmanlarının altında kalmasın. */
.site-nav-shell,.site-mobile-nav-shell{position:relative!important;z-index:2147483000!important}
.nav-category-group{position:relative;z-index:2147483002!important}
.nav-90plus-popover,.mobile-nav-90plus-popover{z-index:2147483640!important}
#mega-menu,#mega-menu.is-open{z-index:2147483647!important}
</style>
<style id="dk-global-wrapper-layer-fix">
/* Koyu modda içerik ile sayfa zemini arasındaki yapay ara katmanı kaldır. */
html[data-theme="dark"] #main-wrapper{background:transparent!important;box-shadow:none!important;border-color:transparent!important}
html[data-theme="dark"] :is(header.site-shell,.site-nav-shell,.site-mobile-nav-shell,footer.site-shell,#main-wrapper,.site-shell-paper){background:#17181b!important;border-color:transparent!important;box-shadow:none!important}
html[data-theme="dark"] :is(hr,.footer-service-divider,.footer-bottom,[class*="border-gray"],[class*="border-slate"],[class*="divide-gray"],[class*="divide-slate"]){border-color:#303136!important}
html[data-theme="dark"] :is(.footer-service-divider,.footer-bottom){background-color:#303136!important}
html[data-theme="dark"] footer.site-shell.site-shell-paper .dk-footer-grid>div:not(:first-child){border-left-color:#303136!important}
html[data-theme="dark"] footer.site-shell.site-shell-paper .dk-footer-grid :is(h4,h5,strong){color:#f1f0ed!important}
html[data-theme="dark"] footer.site-shell.site-shell-paper .dk-footer-grid :is(a,li,p,span){color:#b9bbc2!important}
html[data-theme="dark"] footer.site-shell.site-shell-paper .dk-footer-grid a:hover{color:#cc1517!important}
html[data-theme="dark"] footer.site-shell.site-shell-paper .footer-bottom{background:transparent!important;background-color:transparent!important;background-image:none!important;border-top-color:#303136!important;color:#6f7682!important}
html[data-theme="dark"] footer.site-shell.site-shell-paper .footer-bottom *{background:transparent!important;background-color:transparent!important;background-image:none!important}
html[data-theme="dark"] #main-wrapper .section-spacing{background:transparent!important;border-color:transparent!important;box-shadow:none!important}
html[data-theme="dark"] #main-wrapper .section-spacing :is(a,h1,h2,h3,h4,p,span,div,article){border-color:#303136!important}
html[data-theme="dark"] #main-wrapper .section-spacing :is([style*="color:#000"],[style*="color: #000"],[style*="color:#111"],[style*="color: #111"]){color:#f1f0ed!important}
html[data-theme="dark"] #main-wrapper .section-spacing :is([style*="background:#fff"],[style*="background: #fff"],[style*="background-color:#fff"],[style*="background-color: #fff"]){background:#202124!important}
html[data-theme="dark"] #main-wrapper .section-spacing .bg-gray-100{background:#303136!important}
html[data-theme="dark"] #main-wrapper :is([data-home-section],.category-section,.home-section,.home-category-section,.galeri-section,.video-section,.teknoloji-section,.bilim-section,.ekonomi-section,.saglik-section){background:transparent!important;border-color:#303136!important;box-shadow:none!important}
html[data-theme="dark"] #main-wrapper :is([data-home-section],.category-section,.home-section,.home-category-section,.galeri-section,.video-section,.teknoloji-section,.bilim-section,.ekonomi-section,.saglik-section) :is(h2,h3,h4,.section-title){color:#f1f0ed!important}
html[data-theme="dark"] #main-wrapper :is([data-home-section],.category-section,.home-section,.home-category-section,.galeri-section,.video-section,.teknoloji-section,.bilim-section,.ekonomi-section,.saglik-section) :is(hr,[class*="border"],[class*="divider"]){border-color:#303136!important;background-color:transparent!important}
</style>
<style id="dk-sport-theme-final" media="not all">
/* Devre dışı bırakılmış Spor ters-tema katmanı. */
html[data-sport-theme="dark"],html[data-sport-theme="dark"] body{background:#17181b!important;color:#f1f2f4!important;--dk-initial-market:#1b1c20!important;--dk-initial-slider:#202124!important}
html[data-sport-theme="dark"] :is(header.site-shell,.site-nav-shell,.site-mobile-nav-shell,footer.site-shell,.piyasa-scroll,.full-mobile){background-color:#1b1c20!important;border-color:#393b42!important;color:#f1f2f4!important}
html[data-sport-theme="dark"] :is(header.site-shell,footer.site-shell,.site-nav-shell,.site-mobile-nav-shell,.piyasa-scroll) :is(a,button,svg){color:#f1f2f4!important;stroke:currentColor!important}
html[data-sport-theme="dark"] :is(.header-weather-toggle,.dk-theme-toggle,.header-submit-link){background:#222328!important;border-color:#454850!important;color:#f7f7f8!important}
html[data-sport-theme="dark"] .header-search-button{background:#cc1517!important;border-color:#cc1517!important;color:#fff!important}
html[data-sport-theme="dark"] .piyasa-scroll :is([style*="color:#000"],[style*="color: #000"]){color:#f1f2f4!important}
html[data-sport-theme="dark"] .piyasa-scroll>div>div{border-color:rgba(255,255,255,.17)!important}
html[data-sport-theme="dark"] footer .footer-bottom,html[data-sport-theme="dark"] footer .footer-service-divider{border-color:#383a41!important;background-color:#383a41!important}
html[data-sport-theme="dark"] footer :is(h1,h2,h3,h4){color:#fff!important}
html[data-sport-theme="dark"] footer a:hover{color:#cc1517!important}
html[data-sport-theme="light"],html[data-sport-theme="light"] body{background:#fff!important;color:#111827!important;--dk-initial-market:#f3f3f3!important;--dk-initial-slider:#fff!important}
html[data-sport-theme="light"] :is(header.site-shell,.site-nav-shell,.site-mobile-nav-shell,footer.site-shell,.piyasa-scroll,.full-mobile){background-color:#fff!important;border-color:#e4e7eb!important;color:#111827!important}
html[data-sport-theme="light"] :is(header.site-shell,footer.site-shell,.site-nav-shell,.site-mobile-nav-shell,.piyasa-scroll) :is(a,button,svg){color:#111827!important;stroke:currentColor!important}
html[data-sport-theme="light"] :is(.header-weather-toggle,.dk-theme-toggle,.header-submit-link){background:#fff!important;border-color:#d5d9df!important;color:#111827!important}
html[data-sport-theme="light"] .header-search-button{background:#cc1517!important;border-color:#cc1517!important;color:#fff!important}
/* Footer, Spor temasından bağımsız olarak ana sayfadaki sabit siyah görünümünü korur. */
html[data-sport-theme] footer.site-shell{background:#000!important;border-color:#202125!important;color:#9ca3af!important}
html[data-sport-theme] footer.site-shell :is(h1,h2,h3,h4){color:#fff!important}
html[data-sport-theme] footer.site-shell a{color:inherit!important}
html[data-sport-theme] footer.site-shell a:hover{color:#cc1517!important}
html[data-sport-theme] footer.site-shell .footer-bottom,html[data-sport-theme] footer.site-shell .footer-service-divider{border-color:#292b30!important;background-color:#292b30!important}
html[data-sport-theme] :is(.dk-theme-toggle,.dk-theme-toggle svg,header.site-shell,footer.site-shell,.piyasa-scroll,.full-mobile){transition:none!important}
/* 90+ footer'ı, seçili temadan bağımsız olarak ana sayfadaki siyah tabanını korur. */
html:has(.ninety-page) footer.site-shell{background:#000!important;border-color:#202125!important;color:#9ca3af!important}
html:has(.ninety-page) footer.site-shell :is(h1,h2,h3,h4){color:#fff!important}
html:has(.ninety-page) footer.site-shell .footer-bottom,html:has(.ninety-page) footer.site-shell .footer-service-divider{background:#292b30!important;border-color:#292b30!important}
</style>
<style id="dk-gallery-dark-surface-fix">
/* Galeri sayfalarında koyu mod: beyaz ayraç ve fotoğraf altı bilgi zemini kalmasın. */
html[data-theme="dark"] .odt-article-body :is(.article-gallery-frame,.article-gallery-figure){
    background:transparent!important;
    border-color:#3a3b40!important;
}
html[data-theme="dark"] .odt-article-body :is(.article-gallery-caption,.article-gallery-figure + .article-gallery-caption,figure figcaption){
    background:transparent!important;
    color:#f1f0ed!important;
    border-color:#3a3b40!important;
}
html[data-theme="dark"] .odt-article-body :is(.article-gallery-caption,.article-gallery-figure + .article-gallery-caption,figure figcaption) :is(p,div,span,strong,b){
    color:inherit!important;
}
html[data-theme="dark"] .odt-article-body .article-gallery-credit{color:#b9bbc2!important;}
</style>
</body>
</html>
