<main class="site-shell site-shell-paper py-0" id="main-wrapper" style="padding-left: 12px; padding-right: 12px;">
    <style>
.full-mobile { width:calc(100% + 24px) !important; margin-top:-10px; margin-left:-12px !important; margin-right:-12px !important; padding-left:0 !important; padding-right:0 !important; border-radius:0 !important; }
.piyasa-scroll::-webkit-scrollbar { height:5px; }
.piyasa-scroll::-webkit-scrollbar-thumb { background:rgba(227,6,19,.65); border-radius:10px; }
.piyasa-scroll::-webkit-scrollbar-track { background:transparent; }
.piyasa-scroll > div > div:has(#pd-dolar-fiyat) { order:1; }
.piyasa-scroll > div > div:has(#pd-euro-fiyat) { order:2; }
.piyasa-scroll > div > div:has(#pd-btc-fiyat) { order:3; }
.piyasa-scroll > div > div:has(#pd-gram-fiyat) { order:4; }
.piyasa-scroll > div > div:has(#pd-ceyrek-fiyat) { order:5; }
.piyasa-scroll > div > div:has(#bist-fiyat) { order:6; }
.piyasa-scroll > div > div:has(#pd-tam-fiyat) { order:7; }
.piyasa-scroll > div > div:has(#pd-brent-fiyat) { order:8; }
.piyasa-scroll > div > div:has(#pd-ons-fiyat) { order:9; }
.piyasa-scroll > div > a { order:10; }
.piyasa-scroll > div > div {
    flex:0 0 140px;
    min-width:140px;
    box-sizing:border-box;
}
.piyasa-scroll [id$="-fiyat"],
.piyasa-scroll [id$="-degisim"] {
    white-space:nowrap;
    font-variant-numeric:tabular-nums;
}
.piyasa-scroll canvas { display:block; flex:0 0 auto; }
@media (max-width:768px) {
    .piyasa-scroll { padding:3px 0 !important; border-radius:0 !important; }
    .piyasa-scroll > div { padding-left:4px !important; padding-right:4px !important; }
    .piyasa-scroll > div > div { gap:4px !important; padding:0 5px !important; }
    .piyasa-scroll > div > div { flex-basis:102px !important; min-width:102px !important; }
    .piyasa-scroll div[style*="letter-spacing:0.05em"] { font-size:7px !important; }
    .piyasa-scroll div[style*="font-size:14px"] { font-size:11px !important; line-height:1 !important; }
    .piyasa-scroll div[style*="font-size:8px"] { font-size:7px !important; }
    .piyasa-scroll canvas { width:28px !important; height:18px !important; }
    .piyasa-scroll a { font-size:7px !important; padding-left:5px !important; }
}
@media (min-width:769px) {
    section.full-mobile { margin-top:2px !important; margin-left:0 !important; margin-right:0 !important; width:100% !important; transform:none !important; position:relative !important; left:0 !important; }
    section.full-mobile .piyasa-scroll { padding-left:0 !important; padding-right:0 !important; }
}
</style>


<section class="full-mobile" style="background:var(--dk-initial-market,#f3f3f3) !important; margin-bottom:5px !important;">
<div class="piyasa-scroll" style="background:transparent !important; padding:4px 6px; border-radius:0; overflow-x:auto;">
    <div style="display:flex; align-items:center; gap:0; width:100%;">

        <div style="display:flex; align-items:center; gap:6px; padding:0 6px; border-right:1px solid rgba(0,0,0,0.15);">
            <div>
                <div style="color:#000; font-size:8px; font-weight:700; letter-spacing:0.05em;">$ DOLAR</div>
                <div id="pd-dolar-fiyat" style="color:#000; font-size:14px; font-weight:800; line-height:1;">-</div>
                <div id="pd-dolar-degisim" style="font-size:8px; color:#000;">-</div>
            </div>
            <canvas id="dolar-chart2" width="36" height="24"></canvas>
