<style>
.service-live-clock{display:inline-grid;grid-template-columns:auto auto;align-items:center;column-gap:7px;margin-top:16px;padding:9px 12px;border:1px solid rgba(255,255,255,.20);border-radius:11px;background:linear-gradient(145deg,rgba(255,255,255,.12),rgba(255,255,255,.045));color:#fff;box-shadow:inset 0 1px 0 rgba(255,255,255,.08);font-variant-numeric:tabular-nums}.service-live-clock:before{width:6px;height:6px;border-radius:50%;background:#f2c84b;box-shadow:0 0 9px rgba(242,200,75,.65);content:""}.service-live-clock small{color:#e8c968;font-size:9px;font-weight:850;letter-spacing:.12em;text-transform:uppercase}.service-live-clock time{grid-column:1/3;margin-top:2px;font-size:22px;font-weight:800;letter-spacing:-.04em}.service-live-clock b{margin-left:1px;padding:2px 4px;border-radius:5px;background:rgba(245,200,76,.13);color:#f5c84c;font-size:.56em;font-weight:500;vertical-align:2px}.service-live-clock b:before{content:":";margin-right:1px;color:rgba(255,255,255,.58);font-weight:400}
