<script>(()=>{const tick=()=>{const parts=new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Istanbul',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'}).formatToParts(new Date()),v=Object.fromEntries(parts.map(x=>[x.type,x.value]));document.querySelectorAll('[data-service-live-clock]').forEach(e=>{e.querySelector('time').firstChild.textContent=`${v.hour}:${v.minute}`;e.querySelector('b').textContent=v.second})};tick();setInterval(tick,1000)})();</script>
<style>
.article-scroll-top-btn{position:fixed;right:15px;bottom:18px;width:32px;height:55px;border:none;border-radius:999px;background:#000;color:#fff;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;z-index:999;opacity:0;visibility:hidden;transform:translateY(12px);transition:opacity .2s ease,transform .2s ease,visibility .2s ease,background .2s ease}.article-scroll-top-btn.is-visible{opacity:1;visibility:visible;transform:translateY(0)}.article-scroll-top-btn:hover{background:#e30613}
/* Servis sayfalarının üst açıklamaları; Son Dakika bu seçicilere bilerek dahil edilmedi. */
:is(.earthquake-head,.market-hero,.weather-hero,.pharmacy-hero,.news-submission-header)>p,.rss-hero-copy{font-size:12px!important;line-height:1.475!important}
/* Mobil servis sayfaları: içerik iki yanda 2px, üst başlıklar tam genişlik. */
@media(max-width:640px){:is(.market-page,.earthquake-page,.weather-page,.pharmacy-page,.rss-page,.news-submission-page){padding-left:2px!important;padding-right:2px!important}:is(.market-hero,.earthquake-head,.weather-hero,.pharmacy-hero,.rss-hero){position:relative!important;left:auto!important;right:auto!important;width:calc(100% + 4px)!important;max-width:none!important;margin-left:-2px!important;margin-right:-2px!important;border-radius:0!important}.news-submission-page .news-submission-header{box-sizing:border-box!important;width:100vw!important;max-width:none!important;left:auto!important;right:auto!important;transform:none!important;margin-left:calc(50% - 50vw)!important;margin-right:calc(50% - 50vw)!important;border-radius:0!important}}
/* Servis menülerindeki grup ayraçları. */
.dk-service-divider{height:1px;margin:5px 0;border:0;background:rgba(148,163,184,.28)}.footer-service-divider{height:1px;margin:5px 0;list-style:none;background:rgba(255,255,255,.18)}.article-service-divider,.breaking-service-divider{grid-column:1/-1;height:1px;margin:1px 0;background:#e7ebf0}
</style>
<script>
(()=>{const button=document.getElementById('siteScrollTopBtn');if(!button)return;const toggle=()=>button.classList.toggle('is-visible',window.scrollY>480);window.addEventListener('scroll',toggle,{passive:true});button.addEventListener('click',()=>window.scrollTo({top:0,behavior:'smooth'}));toggle()})();
</script>
<script>
(()=>{
    const labels=['Haber Gönder','Haber Ara','Son Dakika','Son Depremler','Hava Durumu','Piyasalar','Nöbetçi Eczaneler','Etkinlik Takvimi','İlçe Haberleri','Samsunspor Merkezi','Google Haberler’de Takip Et','RSS Servisleri'];
    const breaks=new Set(['Haber Ara','Son Dakika','Samsunspor Merkezi']);
    const normalize=value=>(value||'').replace(/\s+/g,' ').trim();
    const sortServices=(root,dividerClass)=>{
        if(!root)return;
        root.querySelectorAll('.dk-service-divider,.footer-service-divider,.article-service-divider,.breaking-service-divider,.article-service-gap,.breaking-service-gap,.dk-menu-spacer').forEach(node=>node.remove());
        const children=[...root.children];
        labels.forEach(label=>{
            const item=children.find(node=>normalize(node.textContent).includes(label));
            if(!item)return;
            root.appendChild(item);
            if(breaks.has(label)){
                const divider=document.createElement(root.tagName==='UL'?'li':'span');
                divider.className=dividerClass;
                divider.setAttribute('aria-hidden','true');
                root.appendChild(divider);
            }
        });
    };
    const serviceTitle=[...document.querySelectorAll('.dk-menu-title')].find(node=>normalize(node.textContent)==='Servisler');
    sortServices(serviceTitle?.nextElementSibling,'dk-service-divider');
    const footerTitle=[...document.querySelectorAll('footer h4')].find(node=>normalize(node.textContent)==='Servisler');
    sortServices(footerTitle?.nextElementSibling,'footer-service-divider');
    document.querySelectorAll('.article-services-grid').forEach(root=>sortServices(root,'article-service-divider'));
    document.querySelectorAll('.breaking-services-grid').forEach(root=>sortServices(root,'breaking-service-divider'));
})();
</script>
