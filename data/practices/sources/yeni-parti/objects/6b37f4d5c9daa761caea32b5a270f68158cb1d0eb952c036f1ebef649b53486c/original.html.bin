            <div>
                <div style="color:#000; font-size:8px; font-weight:700; letter-spacing:0.05em;">BİST 100</div>
                <div id="bist-fiyat" style="color:#000; font-size:14px; font-weight:800; line-height:1;">-</div>
                <div id="bist-degisim" style="font-size:8px; color:#000;">-</div>
            </div>
            <canvas id="bist-chart" width="36" height="24"></canvas>
        </div>

        <div style="display:flex; align-items:center; gap:6px; padding:0 7px; border-right:1px solid rgba(0,0,0,0.15);">
            <div>
                <div style="color:#000; font-size:8px; font-weight:700; letter-spacing:0.05em;">GRAM ALTIN</div>
                <div id="pd-gram-fiyat" style="color:#000; font-size:14px; font-weight:800; line-height:1;">-</div>
                <div id="pd-gram-degisim" style="font-size:8px; color:#000;">-</div>
            </div>
            <canvas id="gram-chart" width="36" height="24"></canvas>
        </div>

        <div style="display:flex; align-items:center; gap:6px; padding:0 7px; border-right:1px solid rgba(0,0,0,0.15);">
            <div>
                <div style="color:#000; font-size:8px; font-weight:700; letter-spacing:0.05em;">TAM ALTIN</div>
                <div id="pd-tam-fiyat" style="color:#000; font-size:14px; font-weight:800; line-height:1;">-</div>
                <div id="pd-tam-degisim" style="font-size:8px; color:#000;">-</div>
            </div>
            <canvas id="tam-chart" width="36" height="24"></canvas>
        </div>

        <div style="display:flex; align-items:center; gap:6px; padding:0 7px; border-right:1px solid rgba(0,0,0,0.15);">
