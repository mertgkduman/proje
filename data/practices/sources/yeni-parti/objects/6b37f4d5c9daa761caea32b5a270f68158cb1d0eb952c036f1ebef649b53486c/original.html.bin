    }

    .article-post-cover-actions {
        margin: -.2rem 0 1rem !important;
        padding: 10px 0 !important;
        gap: 8px !important;
        flex-wrap: nowrap !important;
    }

    .cover-action-btn {
        height: 38px !important;
