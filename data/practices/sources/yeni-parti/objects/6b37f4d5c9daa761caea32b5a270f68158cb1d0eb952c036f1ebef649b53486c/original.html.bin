<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>
(() => {
    let theme = "light";
    try {
        const saved = localStorage.getItem("dk-theme");
        if (saved === "dark" || saved === "light") theme = saved;
    } catch (_) {}
    document.documentElement.dataset.theme = theme;
})();
</script>
<script>
/* Tüm tema logolarını ilk boyamada doğru kaynaktan başlat; yenilemede siyah/beyaz flaşı oluşmasın. */
(() => {
    const syncThemeLogos = (root = document) => {
        const dark = document.documentElement.dataset.theme === 'dark';
        root.querySelectorAll?.('img[data-theme-logo]').forEach((logo) => {
            const source = dark ? logo.dataset.darkSrc : logo.dataset.lightSrc;
            if (source && logo.getAttribute('src') !== source) logo.setAttribute('src', source);
        });
    };
    syncThemeLogos();
    new MutationObserver((records) => records.forEach((record) => record.addedNodes.forEach((node) => {
        if (node.nodeType === 1) syncThemeLogos(node);
    }))).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
<style id="dk-theme-critical">
/* Tema tercihini ilk boya anında uygula: emtia ve manşet açık moddan koyu moda zıplamasın. */
:root{--dk-initial-market:#f3f3f3;--dk-initial-slider:#fff;}
html[data-theme="dark"]{background:#17181b;color-scheme:dark;--dk-initial-market:#1b1c20;--dk-initial-slider:#202124;}
html[data-theme="dark"] body{background:#17181b;color:#f1f0ed;}
html[data-theme="dark"] :is(header.site-shell,.site-nav-shell,.site-mobile-nav-shell,footer.site-shell,#main-wrapper,.site-shell-paper){background:#17181b!important;border-color:transparent!important;box-shadow:none!important;transition:none!important;}
html[data-theme] :is(.header-brand,.header-brand img[data-theme-logo],footer img[data-theme-logo]){transition:none!important;animation:none!important;}
html[data-theme="dark"] section.full-mobile,
html[data-theme="dark"] .piyasa-scroll{background-color:var(--dk-initial-market)!important;color:#f1f0ed!important;}
html[data-theme="dark"] .piyasa-scroll [style*="color:#000"],
html[data-theme="dark"] .piyasa-scroll [style*="color: #000"]{color:#f1f0ed!important;}
html[data-theme="dark"] :is(.manset-shell,.manset-media,.manset-media img){background-color:var(--dk-initial-slider)!important;}
/* Haber sayfası çizgileri ilk boyamada da koyu kalır; yenilemede beyaz parlama yapmaz. */
html[data-theme="dark"] :is(.article-meta-bar,.article-post-cover-actions,.article-related-panel,.article-most-read,.article-sidebar-stack section,.article-tags-block){border-color:#3a3b40!important;}
html[data-theme="dark"] :is(.article-meta-divider,.article-meta-share-divider){background-color:#3a3b40!important;border-color:#3a3b40!important;}
html[data-theme="dark"] :is(.article-related-panel,.article-most-read,.article-sidebar-stack){background-color:transparent!important;}
/* Galeri görselleri ve bilgi alanları sayfa gövdesinden önce geldiğinde de beyaz zemin çizmesin. */
html[data-theme="dark"] .odt-article-body :is(.article-gallery-frame,.article-gallery-figure,.article-gallery-caption,.article-gallery-figure + .article-gallery-caption,figure figcaption,.article-gallery-count,.article-gallery-count > span){
    background:transparent!important;
    background-color:transparent!important;
}
html[data-theme="dark"] .odt-article-body :is(.article-gallery-frame,.article-gallery-figure,.article-gallery-caption,.article-gallery-figure + .article-gallery-caption,figure figcaption,.article-gallery-count){
    border-color:#3a3b40!important;
}
html[data-theme="dark"] .odt-article-body .article-gallery-count-current{color:#f1f0ed!important;}
</style>
