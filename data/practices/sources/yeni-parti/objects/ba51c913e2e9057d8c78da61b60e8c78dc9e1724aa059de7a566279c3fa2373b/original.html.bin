                    <script type="88f9e652feb89123d3485a4d-text/javascript">
                var adproSiteId = "019ef8f4-078e-717d-8986-7855bc2ee816";
                (function() {
                    // Bundle cache kontrolü
                    var cache = localStorage.getItem('bundle_ads_off');
                    var isBundle = window.location.href.toLowerCase().includes('bundle');

                    if (isBundle) {
                        localStorage.setItem('bundle_ads_off', Date.now() + 300000); // 5 dakika
                    }

                    if (!isBundle && (!cache || Date.now() > cache)) {
                        var adp = document.createElement("script");
                        adp.type = "text/javascript";
                        adp.async = false;
                        adp.defer = true;
                        adp.id = "adpro";
                        adp.src = "https://ad-v2.bilgin.pro/js/adpro.min.js";
                        document.getElementsByTagName("head")[0].appendChild(adp);

                        // sonsuz kaydırmayla gelen slotlar için tekrar çağrılır, her slot bir kez bağlanır
                        window.adproRefresh = function() {
                            document.querySelectorAll('.adpro[data-refresh]:not([data-refresh-bound])').forEach(function(slot) {
                                var seconds = parseInt(slot.getAttribute('data-refresh'), 10);
                                slot.setAttribute('data-refresh-bound', '');
                                if (!seconds || seconds < 30) {
                                    return;
                                }
                                setInterval(function() {
                                    if (document.hidden || !window.googletag || !googletag.apiReady || !slot.getClientRects().length) {
                                        return;
                                    }
                                    var gamSlots = googletag.pubads().getSlots().filter(function(gamSlot) {
                                        return slot.contains(document.getElementById(gamSlot.getSlotElementId()));
                                    });
                                    if (gamSlots.length) {
                                        googletag.pubads().refresh(gamSlots);
                                    }
                                }, seconds * 1000);
                            });
                        };
                        window.adproRefresh();
                    }
                })();
            </script>
        
        

