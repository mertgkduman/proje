<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"Thing","@id":"https:\/\/www.aydintimes.com","name":"Haberler"}},{"@type":"ListItem","position":2,"item":{"@type":"Thing","@id":"https:\/\/www.aydintimes.com\/aydin","name":"Ayd\u0131n"}},{"@type":"ListItem","position":3,"item":{"@type":"Thing","@id":"https:\/\/www.aydintimes.com\/yeni-parti-germencikte-ibrahim-gul-devri","name":"YEN\u0130 Parti Germencik'te \u0130brahim G\u00fcl devri"}}]}</script>
<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"NewsArticle","headline":"YEN\u0130 Parti Germencik'te \u0130brahim G\u00fcl devri","articleSection":"Ayd\u0131n","dateCreated":"2026-10-05T14:51:00+03:00","datePublished":"2026-10-05T14:51:00+03:00","dateModified":"2026-10-05T14:55:05+03:00","wordCount":285,"genre":"news","mainEntityOfPage":{"@type":"WebPage","@id":"https:\/\/www.aydintimes.com\/yeni-parti-germencikte-ibrahim-gul-devri"},"articleBody":"Yeni Parti Germencik \u0130l\u00e7e \u00d6rg\u00fct\u00fc\u2019n\u00fcn 26 Eyl\u00fcl\u2019de \u00fcyelerin kat\u0131l\u0131m\u0131yla ger\u00e7ekle\u015ftirdi\u011fi \u00f6n se\u00e7imde iki rakibini geride b\u0131rakarak birinci olan Gen\u00e7lik Kollar\u0131 Ba\u015fkan\u0131 \u0130brahim G\u00fcl, tek aday olarak girdi\u011fi partisinin birinci ola\u011fan kongresinde il\u00e7e ba\u015fkanl\u0131\u011f\u0131 g\u00f6revine se\u00e7ildi.\r\n\r\n\r\n\r\n19 May\u0131s Gen\u00e7lik Park\u0131\u2019nda d\u00fczenlenen kongreye Germencik Belediye Ba\u015fkan\u0131 Burak Zencirci, Yeni Parti Germencik \u0130l\u00e7e Ba\u015fkan\u0131 Tayfur Bozda\u011f, Germencik eski Belediye Ba\u015fkan\u0131 Ahmet Yava\u015fo\u011flu, belediye meclis \u00fcyeleri, muhtarlar ve partililer kat\u0131ld\u0131.\r\n\r\nKongrede konu\u015fan Germencik Belediye Ba\u015fkan\u0131 Burak Zencirci, il\u00e7ede bug\u00fcne kadar \u00f6rg\u00fctlenme \u00e7al\u0131\u015fmalar\u0131na emek veren Kurucu \u0130l\u00e7e Ba\u015fkan\u0131 Tayfur Bozda\u011f ve y\u00f6netim kuruluna \u00f6zverili \u00e7al\u0131\u015fmalar\u0131 ile katk\u0131lar\u0131ndan dolay\u0131 te\u015fekk\u00fcr etti. Zencirci, \u201cBirlik, beraberlik ve dayan\u0131\u015fma i\u00e7erisinde Germencik\u2019imiz i\u00e7in \u00e7al\u0131\u015fmaya devam edece\u011fiz\u201d ifadelerini kulland\u0131.\r\n\r\n\u0130l\u00e7e Ba\u015fkanl\u0131\u011f\u0131 g\u00f6revine se\u00e7ilen \u0130brahim G\u00fcl ise partisinin iktidar\u0131 i\u00e7in ekip arkada\u015flar\u0131yla birlikte birlik ve beraberlik i\u00e7erisinde \u00e7al\u0131\u015facaklar\u0131n\u0131 s\u00f6yledi. Konu\u015fmalar\u0131n ard\u0131ndan kongrede tek listeyle se\u00e7ime gidildi. Delegelerin oylar\u0131yla \u0130brahim G\u00fcl, Yeni Parti Germencik \u0130l\u00e7e Ba\u015fkan\u0131 oldu.\r\n\r\nYEN\u0130 Parti Germencik'te Yeni Y\u00f6netim\r\n\r\n\u0130brahim G\u00fcl ba\u015fkanl\u0131\u011f\u0131ndaki Yeni Parti Germencik \u0130l\u00e7e Y\u00f6netim Kurulu K\u00fcbra \u00c7elik, \u0130lknur Balt\u0131k \u00c7\u00f6mez, Taylan Deveci, Ertan Ete\u015f, Suna G\u00f6zc\u00fc, As\u0131m G\u00fcnd\u00fcz, Efe Mehmet Kolda\u015f, Yasin Ko\u015far, Umut Kurum, Sema M\u0131zrak, Ayd\u0131n Mehmet P\u0131narc\u0131, Mert Ta\u015f\u00e7\u0131, Bahri Y\u0131ld\u0131r\u0131m ve Osman Zeybek\u2019ten olu\u015ftu.\r\n\r\n","description":"Yeni Parti Germencik \u0130l\u00e7e \u00d6rg\u00fct\u00fc\u2019n\u00fcn birinci ola\u011fan kongresi ger\u00e7ekle\u015ftirildi. Kongrede \u0130brahim G\u00fcl, delegelerin oylar\u0131yla \u0130l\u00e7e Ba\u015fkanl\u0131\u011f\u0131 g\u00f6revine\u2026","inLanguage":"tr-TR","keywords":[],"image":{"@type":"ImageObject","url":"https:\/\/aydintimescom.teimg.com\/crop\/1280x720\/aydintimes-com\/uploads\/2026\/10\/a-697467-66030f.webp","width":"1280","height":"720","caption":"YEN\u0130 Parti Germencik'te \u0130brahim G\u00fcl devri"},"isFamilyFriendly":"http:\/\/schema.org\/True","isAccessibleForFree":"http:\/\/schema.org\/True","publisher":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.aydintimes.com\/#organization","name":"Ayd\u0131n Times \u2013 Ayd\u0131n ve T\u00fcrkiye\u2019den Son Dakika Haberleri","image":"https:\/\/aydintimescom.teimg.com\/aydintimes-com\/uploads\/2026\/03\/aydin-times-logo-1.svg","logo":{"@type":"ImageObject","url":"https:\/\/aydintimescom.teimg.com\/aydintimes-com\/uploads\/2026\/03\/aydin-times-logo-1.svg","width":"640","height":"375"}},"author":{"@type":"Person","name":"Ezgi Balc\u0131","url":"https:\/\/www.aydintimes.com\/muhabir\/36\/ezgi-balci"},"editor":{"@type":"Person","name":"Ezgi Balc\u0131","url":"https:\/\/www.aydintimes.com\/muhabir\/36\/ezgi-balci"},"creator":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.aydintimes.com\/#organization","name":"Ayd\u0131n Times \u2013 Ayd\u0131n ve T\u00fcrkiye\u2019den Son Dakika Haberleri","url":"https:\/\/www.aydintimes.com"}}</script>


