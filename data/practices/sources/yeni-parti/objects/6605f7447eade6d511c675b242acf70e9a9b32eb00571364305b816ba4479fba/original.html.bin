<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"Thing","@id":"https:\/\/www.referansgazetesi.com.tr","name":"Haberler"}},{"@type":"ListItem","position":2,"item":{"@type":"Thing","@id":"https:\/\/www.referansgazetesi.com.tr\/siyaset","name":"S\u0130YASET"}},{"@type":"ListItem","position":3,"item":{"@type":"Thing","@id":"https:\/\/www.referansgazetesi.com.tr\/yeni-parti-gaziantepte-flas-karar-eski-belediye-baskanina-ihrac-soku","name":"Yeni Parti Gaziantep\u2019te fla\u015f karar! Eski Belediye Ba\u015fkan\u0131na ihra\u00e7 \u015foku\u2026"}}]}</script>
<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"NewsArticle","headline":"Yeni Parti Gaziantep\u2019te fla\u015f karar! Eski Belediye Ba\u015fkan\u0131na ihra\u00e7 \u015foku\u2026","articleSection":"S\u0130YASET","dateCreated":"2026-10-20T10:53:00+03:00","datePublished":"2026-10-20T10:53:00+03:00","dateModified":"2026-10-20T11:14:48+03:00","wordCount":137,"genre":"news","mainEntityOfPage":{"@type":"WebPage","@id":"https:\/\/www.referansgazetesi.com.tr\/yeni-parti-gaziantepte-flas-karar-eski-belediye-baskanina-ihrac-soku"},"articleBody":"Gaziantep Yeni Parti\u2019de kongre tart\u0131\u015fmalar\u0131 devam ediyor. \u0130l Kongresinin ard\u0131ndan sert a\u00e7\u0131klamalarda bulunan Hayri Sucu, \u0130l Ba\u015fkanl\u0131\u011f\u0131 se\u00e7imleri ile ilgili dikkat \u00e7eken iddialarda bulunmu\u015ftu. Sucu\u2019nun ortaya att\u0131\u011f\u0131 iddialarla ilgili tart\u0131\u015fmalar devam ederken, Yeni Parti O\u011fuzeli \u0130l\u00e7e Ba\u015fkanl\u0131\u011f\u0131 dikkat \u00e7eken bir karara imza att\u0131.\r\n\r\n\r\n\u0130L\u00c7E BA\u015eKANLI\u011eINDAN FLA\u015e KARAR\r\n\r\nO\u011fuzeli \u0130l\u00e7e Ba\u015fkan\u0131 Mehmet Ermayas\u0131, sosyal medya hesab\u0131 \u00fczerinden yapt\u0131\u011f\u0131 a\u00e7\u0131klama ile \u00f6nceki d\u00f6nem O\u011fuzeli Belediye Ba\u015fkan\u0131 Mehmet Erg\u00fcle\u00e7'in kesin ihra\u00e7 talebiyle disiplin kuruluna sevk edildi\u011fini duyurdu. Ermayas\u0131, Erg\u00fcle\u00e7 ile ilgili karar\u0131n gerek\u00e7esini ise parti i\u00e7i huzuru ve s\u00fck\u00fbneti bozma nedeniyle al\u0131nd\u0131\u011f\u0131n\u0131 kaydetti.\r\n\r\nS\u00f6z konusu sevkin ard\u0131ndan g\u00f6zler \u0130l Disiplin Kurulundan \u00e7\u0131kacak karara \u00e7evrildi.\r\n\r\n","description":"Yeni Parti Gaziantep\u2019te \u0130l\u00e7e ve \u0130l Kongreleri tamamland\u0131. B\u00fcy\u00fck \u00e7eki\u015fmelere ve tart\u0131\u015fmalara sahne olan kongrelerin ard\u0131ndan tart\u0131\u015fmalar devam ederken\u2026","inLanguage":"tr-TR","keywords":[],"image":{"@type":"ImageObject","url":"https:\/\/referansgazetesicomtr.teimg.com\/crop\/1280x720\/referansgazetesi-com-tr\/uploads\/2026\/10\/yeni-parti-4.jpg","width":"1280","height":"720","caption":"Yeni Parti Gaziantep\u2019te fla\u015f karar! Eski Belediye Ba\u015fkan\u0131na ihra\u00e7 \u015foku\u2026"},"publishingPrinciples":"https:\/\/www.referansgazetesi.com.tr\/yayin-ilkeleri","isFamilyFriendly":"http:\/\/schema.org\/True","isAccessibleForFree":"http:\/\/schema.org\/True","publisher":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.referansgazetesi.com.tr\/#organization","name":"Referans","image":"https:\/\/referansgazetesicomtr.teimg.com\/referansgazetesi-com-tr\/uploads\/2023\/05\/referans-logo-sonbiten.png","logo":{"@type":"ImageObject","url":"https:\/\/referansgazetesicomtr.teimg.com\/referansgazetesi-com-tr\/uploads\/2023\/05\/referans-logo-sonbiten.png","width":"640","height":"375"}},"author":{"@type":"Organization","name":"Ayhan Duman","url":"https:\/\/www.referansgazetesi.com.tr"},"editor":{"@type":"Person","name":"Ayhan Duman","url":"https:\/\/www.referansgazetesi.com.tr\/muhabir\/28\/ayhan-duman"},"creator":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.referansgazetesi.com.tr\/#organization","name":"Referans","url":"https:\/\/www.referansgazetesi.com.tr"}}</script>


