<script type="application/ld&#x2B;json">
    {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://www.sozcu.com.tr","name":"Anasayfa"}},{"@type":"ListItem","position":2,"item":{"@id":"https://www.sozcu.com.tr/gundem","name":"Gündem"}},{"@type":"ListItem","position":3,"item":{"@id":"https://www.sozcu.com.tr/husiler-somali-de-mehmetcik-e-tehdit-p375390","name":"Husiler, Somali’de Mehmetçik’e tehdit"}}]}
</script>
<script type="application/ld&#x2B;json">
    {"@context":"https://schema.org","@type":"NewsArticle","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.sozcu.com.tr/husiler-somali-de-mehmetcik-e-tehdit-p375390"},"url":"https://www.sozcu.com.tr/husiler-somali-de-mehmetcik-e-tehdit-p375390","@id":"https://www.sozcu.com.tr/husiler-somali-de-mehmetcik-e-tehdit-p375390","headline":"Husiler, Somali’de Mehmetçik’e tehdit","articleBody":"S.Arabistan ve Pakistan’la imzaladığımız 3’lü Mekke Anlaşması Dışişleri Komisyonu’nda geçti ve bu hafta Genel Kurul’da görüşülmesi bekleniyor. YENİ Parti, anlaşma teklifine muhalefet şerhi koydu. YENİ Parti Eskişehir Milletvekili Utku Çakırözer ve Düzce Milletvekili Talih Özcan, kanun teklifine yazdıkları muhalefet şerhinde, “Hâlihazırda savaştaki bir ülkeyle ‘Sana saldıran bana saldırmıştır’ anlamına gelen bir savunma anlaşması yapmak kendi ülkemizi doğrudan savaşa sokmaktır” uyarısında bulundu. Husilerin Türkiye için yakın bir tehdit ihtimali olmadığına dikkat çekildi ancak farklı coğrafyalarda tehdit olabileceği şöyle anlatıldı: ‘ÇEKİLME ÇAĞRISI’ “Husiler, Mekke Anlaşması’ndan çekilme çağrısında bulundu. Üstelik, Türkiye, Afrika Boynuzu’nda etki alanını arttırabilmek için Somali ile ilişkilerini geliştiriyor. Türkiye’nin bu anlaşmaya dayanarak doğrudan taraf olmadığı bir çatışmaya sürüklenmesi, Husilerin ülkemiz için yeni ve doğrudan bir terör tehdidi olmasına yol açabilir. Husi güçleri, Kızıldeniz ve Babülmendep Boğazı’nda yalnızca sivil gemilerimiz için değil, Somali’de konuşlandırılacak Türk kara ve deniz kuvvetlerimiz için de ciddi bir tehdit olacak.”","articleSection":"Gündem","image":[{"@type":"ImageObject","url":"https://sozcu01.sozcucdn.com/sozcu/production/uploads/images/2026/11/114jpg-jUeYfxrz_UK87AvIWd3dIA.jpg?w=1200&h=900&mode=crop&scale=both","width":1200,"height":900},{"@type":"ImageObject","url":"https://sozcu01.sozcucdn.com/sozcu/production/uploads/images/2026/11/114jpg-jUeYfxrz_UK87AvIWd3dIA.jpg?w=1200&h=675&mode=crop&scale=both","width":1200,"height":675},{"@type":"ImageObject","url":"https://sozcu01.sozcucdn.com/sozcu/production/uploads/images/2026/11/114jpg-jUeYfxrz_UK87AvIWd3dIA.jpg?w=900&h=900&mode=crop&scale=both","width":900,"height":900}],"datePublished":"2026-11-03T04:20:00+03:00","dateCreated":"2026-11-03T04:19:42+03:00","dateModified":"2026-11-03T04:20:08+03:00","genre":"News","wordCount":145,"inLanguage":"tr-TR","author":[{"@type":"Person","@id":"https://www.sozcu.com.tr/veli-toprak-a121","name":"Veli TOPRAK","url":"https://www.sozcu.com.tr/veli-toprak-a121"}],"publisher":{"@type":"Organization","@id":"https://www.sozcu.com.tr/#organization","name":"Sözcü","logo":{"@type":"ImageObject","@id":"https://www.sozcu.com.tr/#logo","url":"https://www.sozcu.com.tr/static/web/assets/logo-192x192.png","width":192,"height":192}},"description":"Teklife muhalefet şerhi koyan YENİ Parti: “Somali’de konuşlandırılacak askerimiz için de ciddi tehlike olur.”"}
</script>

