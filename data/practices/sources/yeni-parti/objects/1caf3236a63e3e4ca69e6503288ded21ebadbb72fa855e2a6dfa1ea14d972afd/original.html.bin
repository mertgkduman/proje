    <!-- VIDEO PARTNER ROTATION (membrana / reklamup) -->
<script>
    (function () {
        var REKLAMUP_PERCENT = 0; // ReklamUp gösterim yüzdesi — tek ayar noktası (0 = %100 Membrana)

        window.dataLayer = window.dataLayer || [];

        // Plus üye kapısı — SessionManager.removeAds() ile AYNI sinyal (uyelik subdomain'inin set ettiği cookie).
        // Sunucu tarafında DEĞİL burada: anasayfa HTML'i Cloudflare'de cookie'den bağımsız cache'leniyor,
        // dolayısıyla Razor tarafındaki bir sunucu koşulu Plus üyeye ulaşmaz. Video player'ları kendi
        // elemanlarını doğrudan <body>'ye ekleyebildiği için removeAds() onlara erişemez; script hiç yüklenmemeli.
        var isPlusUser = false;
        try {
            isPlusUser = /(?:^|;\s*)_sgf_user_pids=[^;]+/.test(document.cookie);
        } catch (e) { /* cookie erişimi yoksa reklamı normal akışta göster */ }

        if (isPlusUser) {
            window.dataLayer.push({ event: 'video_partner_skipped', reason: 'plus_user' });
            return;
        }

        var partner = null;
        try {
            var qs = new URLSearchParams(window.location.search).get('videoPartner');
            if (qs === 'reklamup' || qs === 'membrana') partner = qs; // test override
        } catch (e) { /* eski tarayıcı — kuraya düş */ }

        if (!partner) {
            partner = (Math.random() * 100 < REKLAMUP_PERCENT) ? 'reklamup' : 'membrana';
        }

        var s = document.createElement('script');
        s.async = true;
        if (partner === 'reklamup') {
            s.src = 'https://videoapi.reklamup.com/datastore/generated/player/1/0/1/1.js';
            // Çift player kilidi: bu pageview'de Membrana hiçbir koşulda init olmamalı.
            // ym.js başka bir yerden sızsa bile init çağrısı yieldMasterCmd.push üzerinden gelir; push'u yutuyoruz.
            var q = [];
            q.push = function () {};
            window.yieldMasterCmd = q;
        } else {
            // Membrana: container'lar .HZC_VIDEO (anasayfa, main.ts) / .SZC_VIDEO (detay, ad_article_intext.ts).
            s.src = 'https://cdn.membrana.media/szc/ym.js';
            window.yieldMasterCmd = window.yieldMasterCmd || [];
            window.yieldMasterCmd.push(function () {
                window.yieldMaster.init({ pageVersionAutodetect: true });
            });
        }

        var cur = document.currentScript;
        if (cur && cur.parentNode) {
            cur.parentNode.insertBefore(s, cur);
        } else {
            document.head.appendChild(s);
        }

        window.dataLayer.push({ event: 'video_partner_selected', video_partner: partner });
    })();
</script>
<!-- /VIDEO PARTNER ROTATION -->

