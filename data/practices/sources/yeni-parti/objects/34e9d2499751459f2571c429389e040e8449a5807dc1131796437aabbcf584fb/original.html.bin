<!doctype html>
<html lang="tr" dir="ltr" data-bs-theme="light" data-hp-color-mode="auto" data-hp-preview="0">
<head>
<script>
/* Resolve the saved color mode before stylesheets or content can paint. */
(()=>{const root=document.documentElement;let saved=null;
  if(root.dataset.hpPreview!=="1"){
    try{saved=localStorage.getItem("hp-color-mode")}catch(_error){}
  }
  const configured=root.dataset.hpColorMode||"auto";
  const mode=["light","dark","auto"].includes(saved)?saved:configured;
  root.dataset.hpColorMode=mode;
  root.dataset.bsTheme=mode==="auto"
    ?(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light")
    :mode;
})();
</script>
