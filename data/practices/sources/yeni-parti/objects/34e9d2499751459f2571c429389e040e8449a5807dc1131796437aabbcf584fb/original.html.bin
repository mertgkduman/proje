h:992px;--hp-grid-gap:12px;--hp-card-radius:9px;--hp-font-body:"Roboto","hp-fallback-roboto",Arial,sans-serif;--hp-font-heading:"Roboto","hp-fallback-roboto",Arial,sans-serif;--hp-font-navigation:"Inter","hp-fallback-inter",Arial,sans-serif;--hp-global-block-header-font:inherit;--hp-global-block-header-size:inherit;--hp-global-block-header-weight:inherit;--hp-global-block-header-color:inherit;--hp-global-block-header-bg:transparent;--hp-global-block-border-width:1px;--hp-global-block-border-color:var(--hp-border);--hp-global-block-footer-font:inherit;--hp-global-block-footer-size:inherit;--hp-global-block-footer-weight:inherit;--hp-global-block-footer-color:inherit;--hp-global-block-footer-bg:transparent;}</style>
    <link rel="stylesheet" href="/files/theme-builds/ultimate-modern/page-0e3ac8d964cf8db953d92c70edf27947c3eb68a39a99d5147d3f8255c2971f75.css?v=0e3ac8d964cf8db953d92c70edf27947c3eb68a39a99d5147d3f8255c2971f75">    <script type="application/ld+json">{"@context":"https://schema.org","@type":"NewsMediaOrganization","@id":"https://www.ayintabgazetesi.com/#organization","url":"https://www.ayintabgazetesi.com/","name":"Ayıntab Gazetesi","logo":{"@type":"ImageObject","url":"https://www.ayintabgazetesi.com/assets/branding/ayintabgazetesi-light.svg"},"address":{"@type":"PostalAddress","addressCountry":"TR","addressLocality":"GAZİANTEP","addressRegion":"GAZİANTEP","postalCode":"27500","streetAddress":"İncilipınar Mah. 36001 Sok. No:13"},"founder":{"@type":"Person","name":"Ökkeş SABAH"},"publisher":{"@type":"Person","name":"Ökkeş SABAH"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","@id":"https://www.ayintabgazetesi.com/#website","name":"Ayıntab Gazetesi","url":"https://www.ayintabgazetesi.com/","publisher":{"@id":"https://www.ayintabgazetesi.com/#organization"},"inLanguage":"tr","potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://www.ayintabgazetesi.com/search.html?q={search_term_string}"},"query-input":"required name=search_term_string"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"NewsArticle","@id":"https://www.ayintabgazetesi.com/haber/seydi-ahmet-keles-partiden-ihrac-edildi-29814.html#article","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.ayintabgazetesi.com/haber/seydi-ahmet-keles-partiden-ihrac-edildi-29814.html"},"headline":"Seydi Ahmet Keleş partiden ihraç edildi","description":"Seydi Ahmet Keleş partiden ihraç edildi","articleSection":"Gündem","articleBody":"Yeni Parti Gaziantep Milletvekili Melih Meriç, CHP Oğuzeli İlçe eski Başkanı Seydi Ahmet Keleş’in bıçaklı saldırısına uğramıştı. Meriç’in tedavisi İstanbul’da devam ederken, CHP’den istifa ederek Yeni Parti’ye geçen Keleş ile ilgili flaş bir karar çıktı.\r\nYeni Parti Gaziantep İl Yönetimi, geçtiğimiz hafta sonu toplandı. Yapılan toplantıda, Gaziantep Milletvekili Melih Meriç’i bıçakla yaralayan Seydi Ahmet Keleş’in partiden kesin ihracı ele alındı. İl Yönetiminin değerlendirmesi sonucu Keleş hakkında, kesin ihraç kararı çıktı.\r\nİL YÖNETİMİNDEN AÇIKLAMA\r\nİl Yönetiminden konuya ilişkin yapılan açıklamada, “İl Yönetim Kurulu toplantısında ayrıca Seydi Ahmet Keleş hakkında yürütülen değerlendirme ve süreç ele alınmıştır. Yapılan değerlendirmeler sonucunda, Seydi Ahmet Keleş’in YENİ Parti’den kesin ihracına İl Yönetim Kurulu tarafından karar verilmiştir. Söz konusu karar, parti tüzüğü, temel ilkeleri ve kurumsal sorumluluk anlayışı çerçevesinde alınmıştır. YENİ Parti Gaziantep İl Başkanlığı, bundan sonraki süreçte de parti ilkeleri doğrultusunda hareket etmeye; temiz, şeffaf, ilkeli ve sorumlu siyaset anlayışını kararlılıkla sürdürmeye devam edecektir. Görevlerimiz belli, duruşumuz net, hedefimiz hizmet” ifadeleri yer aldı.","inLanguage":"tr","isAccessibleForFree":true,"isFamilyFriendly":true,"datePublished":"2026-08-24T09:51:00+03:00","dateModified":"2026-08-24T09:53:00+03:00","wordCount":265,"author":{"@type":"Person","name":"Ökkeş Sabah","url":"https://www.ayintabgazetesi.com/yazar/okkes-sabah-21.html"},"publisher":{"@id":"https://www.ayintabgazetesi.com/#organization"},"publishingPrinciples":"https://www.ayintabgazetesi.com/bilgi/yayin-ilkeleri.html","image":["https://ayintabgazetesi-com.cdn.newsdata.com.tr/files/uploads/news/default/seydi-ahmet-keles-partiden-ihrac-edildi-279953.webp"],"thumbnailUrl":"https://ayintabgazetesi-com.cdn.newsdata.com.tr/files/uploads/news/default/seydi-ahmet-keles-partiden-ihrac-edildi-279953.webp"}</script>
