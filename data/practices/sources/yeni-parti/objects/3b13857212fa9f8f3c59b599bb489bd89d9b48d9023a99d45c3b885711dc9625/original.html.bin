<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"Thing","@id":"https:\/\/www.haberlisin.com","name":"Haberler"}},{"@type":"ListItem","position":2,"item":{"@type":"Thing","@id":"https:\/\/www.haberlisin.com\/siyaset","name":"Siyaset"}},{"@type":"ListItem","position":3,"item":{"@type":"Thing","@id":"https:\/\/www.haberlisin.com\/partililer-degisim-dedi-on-secimde-zafer-selda-sezginin","name":"Partililer \"de\u011fi\u015fim\" dedi! \u00d6n se\u00e7imde zafer Selda Sezgin'in"}}]}</script>
<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"NewsArticle","headline":"Partililer \"de\u011fi\u015fim\" dedi! \u00d6n se\u00e7imde zafer Selda Sezgin'in","articleSection":"Siyaset","dateCreated":"2026-10-18T19:59:00+03:00","datePublished":"2026-10-18T19:59:00+03:00","dateModified":"2026-10-18T20:13:32+03:00","wordCount":360,"genre":"news","mainEntityOfPage":{"@type":"WebPage","@id":"https:\/\/www.haberlisin.com\/partililer-degisim-dedi-on-secimde-zafer-selda-sezginin"},"articleBody":"\r\nSEZG\u0130N\u2019E 3 B\u0130N 886 OY\r\nYeni Parti\u2019nin Sakarya te\u015fkilat\u0131nda il ba\u015fkanl\u0131\u011f\u0131 i\u00e7in yap\u0131lan \u00f6n se\u00e7im tamamland\u0131. Sakarya\u2019n\u0131n 16 il\u00e7esinde kurulan sand\u0131klarda oy kullanan \u00fcyeler, Selda Sezgin ve Ecevit Kele\u015f aras\u0131nda tercih yapt\u0131. 2 aday\u0131n yar\u0131\u015ft\u0131\u011f\u0131 \u00f6n se\u00e7imde Selda Sezgin 3 bin 886 oyla ilk s\u0131rada yer ald\u0131. Ecevit Kele\u015f ise 3 bin 359 oy ald\u0131. A\u00e7\u0131klanan sonu\u00e7lara g\u00f6re 2 aday\u0131n toplam oyu 7 bin 245 olurken, Sezgin\u2019in ald\u0131\u011f\u0131 oylar\u0131n bu toplam i\u00e7indeki pay\u0131 yakla\u015f\u0131k y\u00fczde 53,6 oldu.\r\n\r\n\r\n\r\n16 \u0130L\u00c7EDE SANDIK KURULDU\r\n\r\n\u00d6n se\u00e7im kapsam\u0131nda Sakarya genelindeki 16 il\u00e7ede e\u015f zamanl\u0131 oy verme i\u015flemi ger\u00e7ekle\u015ftirildi. Sabah saatlerinde ba\u015flayan oylamada parti \u00fcyeleri, il ba\u015fkanl\u0131\u011f\u0131 s\u00fcrecine ili\u015fkin tercihlerini sand\u0131\u011fa yans\u0131tt\u0131.\r\n\r\n\r\n\r\nSEZG\u0130N: \u201cBU B\u0130R BAYRAK YARI\u015eIDIR\u201d\r\n\r\n\u00d6n se\u00e7imi kazanan Selda Sezgin, sonu\u00e7lar\u0131n ard\u0131ndan birlik mesaj\u0131 vererek hedeflerinin iktidar oldu\u011funu s\u00f6yledi. Sezgin, \u201cHep s\u00f6yledi\u011fimiz gibi bu i\u015fin kazanan\u0131, kaybedeni yok. Bu i\u015fin kazanan\u0131 hep Yeni Parti olacak. Bu bir bayrak yar\u0131\u015f\u0131d\u0131r. Biz de bu bayra\u011f\u0131 en tepeye, en zirveye \u00e7\u0131karmak i\u00e7in elimizden gelen ne varsa yapaca\u011f\u0131z. Hedefimiz her zaman iktidar olacak\u201d dedi.\r\n\r\n\r\n\r\nKELE\u015e\u2019TEN SEZG\u0130N\u2019E TEBR\u0130K VE B\u0130RL\u0130K MESAJI\r\n\r\nEcevit Kele\u015f de Sezgin\u2019i tebrik ederek parti i\u00e7in birlikte \u00e7al\u0131\u015fmaya devam edeceklerini belirtti. Kele\u015f, \u201c9 bin 372 \u00fcyenin yakla\u015f\u0131k y\u00fczde 85\u2019inin sand\u0131\u011fa yans\u0131d\u0131\u011f\u0131 \u00f6n se\u00e7imde yeni ba\u015fkan\u0131m\u0131z karde\u015fim Selda Sezgin olmu\u015ftur. Kendisini tebrik ediyorum. Hep beraber, yollara beraber \u00e7\u0131karak, ad\u0131m ad\u0131m, kap\u0131 kap\u0131 dola\u015farak, hi\u00e7 pes etmeden genel ba\u015fkan\u0131m\u0131z \u00f6nderli\u011finde Yeni Parti\u2019yi Sakarya\u2019da ve T\u00fcrkiye\u2019de iktidara ta\u015f\u0131mak i\u00e7in \u00e7al\u0131\u015faca\u011f\u0131z\u201d ifadelerini kulland\u0131.\r\n\r\n\u0130L KONGRES\u0130 25 EK\u0130M\u2019DE\r\n\r\n\u00d6n se\u00e7imin ard\u0131ndan g\u00f6zler 25 Ekim Pazar g\u00fcn\u00fc yap\u0131lacak Yeni Parti Sakarya \u0130l Kongresi\u2019ne \u00e7evrildi. \u00dcyelerin tercihinde ilk s\u0131rada yer alan Sezgin\u2019in \u00f6n se\u00e7im zaferinin ard\u0131ndan, il ba\u015fkanl\u0131\u011f\u0131na ili\u015fkin s\u00fcre\u00e7 kongrede tamamlanacak.\r\n\r\n","description":"Yeni Parti Sakarya \u0130l Ba\u015fkanl\u0131\u011f\u0131 i\u00e7in yap\u0131lan \u00f6n se\u00e7imi 3 bin 886 oy alan Selda Sezgin kazand\u0131. Ecevit Kele\u015f\u2019in 3 bin 359 oy ald\u0131\u011f\u0131 yar\u0131\u015fta Sezgin\u2026","inLanguage":"tr-TR","keywords":[],"image":{"@type":"ImageObject","url":"https:\/\/haberlisincom.teimg.com\/crop\/1280x720\/haberlisin-com\/uploads\/2026\/10\/yeni-parti-sakarya-il-baskanligi-icin-yapilan-on-secimi-3-bin-886-oy-alan-selda-sezgin-kazandi.jpeg","width":"1280","height":"720","caption":"Partililer \"de\u011fi\u015fim\" dedi! \u00d6n se\u00e7imde zafer Selda Sezgin'in"},"isFamilyFriendly":"http:\/\/schema.org\/True","isAccessibleForFree":"http:\/\/schema.org\/True","publisher":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.haberlisin.com\/#organization","name":"Haberlisin","image":"https:\/\/haberlisincom.teimg.com\/haberlisin-com\/uploads\/2026\/07\/h-a-b-e-r-l-i-s-i-n-l-o-g-o.svg","logo":{"@type":"ImageObject","url":"https:\/\/haberlisincom.teimg.com\/haberlisin-com\/uploads\/2026\/07\/h-a-b-e-r-l-i-s-i-n-l-o-g-o.svg","width":"640","height":"375"}},"author":{"@type":"Person","name":"Nazile Akarsu","url":"https:\/\/www.haberlisin.com\/muhabir\/65220\/nazile-akarsu"},"editor":{"@type":"Person","name":"Nazile Akarsu","url":"https:\/\/www.haberlisin.com\/muhabir\/65220\/nazile-akarsu"},"creator":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.haberlisin.com\/#organization","name":"Haberlisin","url":"https:\/\/www.haberlisin.com"}}</script>
<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"VideoObject","name":"Partililer \"de\u011fi\u015fim\" dedi! \u00d6n se\u00e7imde zafer Selda Sezgin'in","genre":"video","inLanguage":"tr-TR","thumbnailUrl":"https:\/\/haberlisincom.teimg.com\/crop\/250x150\/haberlisin-com\/uploads\/2026\/10\/yeni-parti-sakarya-il-baskanligi-icin-yapilan-on-secimi-3-bin-886-oy-alan-selda-sezgin-kazandi.jpeg","contentUrl":"https:\/\/haberlisincom.tevideo.org\/haberlisin-com\/uploads\/2026\/10\/whatsapp-video-2026-10-18-at-195613.mp4","embedUrl":"https:\/\/www.haberlisin.com\/vidyome\/embed\/14678","dateCreated":"2026-10-18T19:59:00+03:00","datePublished":"2026-10-18T19:59:00+03:00","dateModified":"2026-10-18T20:13:32+03:00","uploadDate":"2026-10-18T19:59:00+03:00","description":"Yeni Parti Sakarya \u0130l Ba\u015fkanl\u0131\u011f\u0131 i\u00e7in yap\u0131lan \u00f6n se\u00e7imi 3 bin 886 oy alan Selda Sezgin kazand\u0131. Ecevit Kele\u015f\u2019in 3 bin 359 oy ald\u0131\u011f\u0131 yar\u0131\u015fta Sezgin\u2026","headline":"Partililer \"de\u011fi\u015fim\" dedi! \u00d6n se\u00e7imde zafer Selda Sezgin'in","image":"https:\/\/haberlisincom.teimg.com\/haberlisin-com\/uploads\/2026\/10\/yeni-parti-sakarya-il-baskanligi-icin-yapilan-on-secimi-3-bin-886-oy-alan-selda-sezgin-kazandi.jpeg","mainEntityOfPage":{"@type":"WebPage","@id":"https:\/\/www.haberlisin.com\/partililer-degisim-dedi-on-secimde-zafer-selda-sezginin"},"url":"https:\/\/www.haberlisin.com\/partililer-degisim-dedi-on-secimde-zafer-selda-sezginin"}</script>
