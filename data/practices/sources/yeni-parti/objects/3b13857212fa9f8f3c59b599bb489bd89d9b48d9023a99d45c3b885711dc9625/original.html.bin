px!important;padding:0!important;color:var(--hpc-body-text)!important;font-size:10.5px!important;font-weight:900!important;line-height:1.2!important;letter-spacing:.3px!important;text-transform:uppercase!important}#hpc-popup .hpc-dots{display:inline-flex!important;gap:2px!important;margin:0!important;padding:0!important}#hpc-popup .hpc-dots i{display:block!important;width:5px!important;height:5px!important;margin:0!important;padding:0!important;border-radius:50%!important}#hpc-popup .hpc-dots i:nth-child(1){background:#4285f4!important}#hpc-popup .hpc-dots i:nth-child(2){background:#ea4335!important}#hpc-popup .hpc-dots i:nth-child(3){background:#fbbc05!important}#hpc-popup .hpc-dots i:nth-child(4){background:#34a853!important}#hpc-popup .hpc-title{display:block!important;width:100%!important;max-width:100%!important;min-width:0!important;margin:0!important;padding:0!important;color:var(--hpc-main-text)!important;font-size:28px!important;font-weight:900!important;line-height:1.07!important;letter-spacing:-.85px!important}#hpc-popup .hpc-title span{color:var(--hpc-red)!important}#hpc-popup .hpc-desc{display:block!important;width:100%!important;max-width:100%!important;min-width:0!important;margin:10px 0 16px!important;padding:0!important;color:var(--hpc-body-text)!important;font-size:13.5px!important;font-weight:650!important;line-height:1.52!important}#hpc-popup .hpc-action{all:unset!important;position:relative!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:12px!important;width:100%!important;max-width:100%!important;min-width:0!important;min-height:50px!important;margin:0!important;padding:9px 10px 9px 16px!important;overflow:hidden!important;border:0!important;border-radius:13px!important;background:var(--hpc-red)!important;box-shadow:0 13px 25px rgba(227,6,19,.23)!important;color:#ffffff!important;cursor:pointer!important;font-family:inherit!important;font-size:13.5px!important;font-weight:900!important;line-height:1.2!important;text-decoration:none!important;transition:background .18s ease,transform .18s ease!important}#hpc-popup .hpc-action:hover{background:var(--hpc-red-dark)!important;color:#ffffff!important;transform:translateY(-1px)!important}#hpc-popup .hpc-action::before{content:""!important;position:absolute!important;top:0!important;left:-120%!important;width:45%!important;height:100%!important;background:linear-gradient(110deg,transparent,rgba(255,255,255,.28),transparent)!important;animation:hpcShine 3.8s 1.4s ease-in-out infinite!important}#hpc-popup .hpc-action>span{position:relative!important;z-index:1!important}#hpc-popup .hpc-action>span:first-child{display:block!important;min-width:0!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important}#hpc-popup .hpc-arrow{display:grid!important;place-items:center!important;flex:0 0 30px!important;width:30px!important;min-width:30px!important;max-width:30px!important;height:30px!important;min-height:30px!important;max-height:30px!important;margin:0!important;padding:0!important;border-radius:9px!important;background:rgba(255,255,255,.16)!important}#hpc-popup .hpc-arrow svg{display:block!important;width:14px!important;height:14px!important;fill:none!important;stroke:currentColor!important;stroke-width:2.4!important;stroke-linecap:round!important;stroke-linejoin:round!important}#hpc-popup .hpc-close:focus-visible,#hpc-popup .hpc-action:focus-visible,@keyframes hpcSourceUp{to{opacity:1;transform:translateY(0)}}@keyframes hpcBadge{to{opacity:1;transform:scale(1)}}@keyframes hpcShine{0%,62%{left:-120%}82%,100%{left:145%}}@media (max-width:480px){#hpc-popup{padding:10px!important}#hpc-popup .hpc-card{width:calc(100vw-20px)!important;max-width:calc(100vw-20px)!important;max-height:calc(100dvh-20px)!important;border-radius:20px!important}#hpc-popup .hpc-inner{padding:14px 14px 14px!important}#hpc-popup .hpc-header{height:40px!important;min-height:40px!important;max-height:40px!important;margin-bottom:11px!important;padding:0 39px!important}#hpc-popup .hpc-logo-shell{width:154px!important;max-width:52vw!important;height:38px!important;min-height:38px!important;max-height:38px!important}#hpc-popup .hpc-close{width:32px!important;min-width:32px!important;max-width:32px!important;height:32px!important;min-height:32px!important;max-height:32px!important;border-radius:10px!important}#hpc-popup .hpc-source{gap:9px!important;margin-bottom:13px!important;padding:9px 10px!important}#hpc-popup .hpc-icon{flex-basis:36px!important;width:36px!important;min-width:36px!important;max-width:36px!important;height:36px!important;min-height:36px!important;max-height:36px!important}#hpc-popup .hpc-source-text strong{font-size:13px!important}#hpc-popup .hpc-source-text span{font-size:10.5px!important}#hpc-popup .hpc-top{padding:7px!important}#hpc-popup .hpc-top span{display:none!important}#hpc-popup .hpc-title{font-size:23px!important;line-height:1.08!important;letter-spacing:-.65px!important}#hpc-popup .hpc-desc{margin:8px 0 13px!important;font-size:12.5px!important;line-height:1.45!important}#hpc-popup .hpc-action{min-height:46px!important;padding:8px 8px 8px 13px!important;font-size:12.5px!important}#hpc-popup .hpc-arrow{flex-basis:29px!important;width:29px!important;min-width:29px!important;max-width:29px!important;height:29px!important;min-height:29px!important;max-height:29px!important}}@media (max-width:360px){#hpc-popup{padding:7px!important}#hpc-popup .hpc-card{width:calc(100vw-14px)!important;max-width:calc(100vw-14px)!important;max-height:calc(100dvh-14px)!important}#hpc-popup .hpc-inner{padding:13px 12px!important}#hpc-popup .hpc-header{padding:0 36px!important}#hpc-popup .hpc-logo-shell{width:142px!important;max-width:49vw!important}#hpc-popup .hpc-source{gap:8px!important;padding:8px 9px!important}#hpc-popup .hpc-source-text strong{font-size:12px!important}#hpc-popup .hpc-source-text span{display:none!important}#hpc-popup .hpc-title{font-size:21px!important}#hpc-popup .hpc-desc{font-size:12px!important}}#hpc-popup .hpc-logo-shell{padding:4px 9px!important;border:1px solid rgba(255,255,255,.15)!important;background:#ffffff!important}#hpc-popup .hpc-title span{color:#ff3341!important}}@media (prefers-reduced-motion:reduce){#hpc-popup,#hpc-popup .hpc-card,#hpc-popup .hpc-source,#hpc-popup .hpc-top,#hpc-popup .hpc-action::before{animation:none!important;transition:none!important}#hpc-popup.is-open .hpc-source,#hpc-popup.is-open .hpc-top{opacity:1!important;transform:none!important}}</style><div id="hpc-popup" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="hpc-title" aria-describedby="hpc-desc"
><div class="hpc-backdrop" data-hpc-close="backdrop"></div><section class="hpc-card" tabindex="-1"><div class="hpc-line"></div><div class="hpc-inner"><header class="hpc-header"><span class="hpc-logo-shell" aria-label="Haberlisin"><span class="hpc-logo-mark" aria-hidden="true"></span></span><button type="button" class="hpc-close" aria-label="Pencereyi kapat" data-hpc-close="close_button" ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round"><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></svg></button></header><div class="hpc-source" aria-hidden="true"><span class="hpc-icon"></span><div class="hpc-source-text"><strong>haberlisin.com</strong><span>Sakarya’nın Haber Merkezi</span></div><div class="hpc-top"><svg viewBox="0 0 24 24"><path d="M12 2.8l2.82 5.71 6.3.92-4.56 4.44 1.08 6.28L12 17.18l-5.64 2.97 1.08-6.28-4.56-4.44 6.3-.92L12 2.8z"></path></svg><span>EN ÜSTTE</span></div></div><div class="hpc-label"><span class="hpc-dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span> Google tercih edilen kaynaklar </div><h2 class="hpc-title" id="hpc-title"> Google’da önce <span>Haberlisin’i</span> gör </h2><p class="hpc-desc" id="hpc-desc"> Haberlisin’i tercih ettiğin kaynaklara ekle, Sakarya haberlerimize daha kolay ulaş. </p><button id="hpc-action" class="hpc-action" type="button" ><span>Haberlisin’i tercih edilen kaynak yap</span><span class="hpc-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14"></path><path d="m14 7 5 5-5 5"></path></svg></span></button></div></section></div><script>(()=>{"use strict";const CONFIG={testMode:false,showAfterMs:7000,scrollPercent:35,dismissHours:24,selectedDays:30,destination:"https://www.google.com/preferences/source?q=haberlisin.com",excludedPaths:["/admin","/panel","/editor","/login","/giris","/uye","/api"]};const popup=document.getElementById("hpc-popup");const card=popup?.querySelector(".hpc-card");const action=document.getElementById("hpc-action");if(!popup||!card||!action)return;const KEYS={dismissed:"hpc_v17_dismissed_until",selected:"hpc_v17_selected_until",date:"hpc_v17_last_shown_date",session:"hpc_v17_session_shown"};let isOpen=false;let triggered=false;let previousFocus=null;const get=(storage,key)=>{try{return storage.getItem(key);}catch{return null;}};const set=(storage,key,value)=>{try{storage.setItem(key,String(value));}catch};const remove=(storage,key)=>{try{storage.removeItem(key);}catch};function today(){const d=new Date();return[d.getFullYear(),String(d.getMonth()+1).padStart(2,"0"),String(d.getDate()).padStart(2,"0")].join("-");}function excluded(){const path=location.pathname.toLowerCase();return CONFIG.excludedPaths.some(item=>path.startsWith(item));}function canShow(){if(CONFIG.testMode)return true;const now=Date.now();return(!excluded()&&Number(get(localStorage,KEYS.dismissed)||0)<=now&&Number(get(localStorage,KEYS.selected)||0)<=now&&get(localStorage,KEYS.date)!==today()&&get(sessionStorage,KEYS.session)!== "1");}function focusables(){return[...popup.querySelectorAll('button:not([disabled]),[tabindex]:not([tabindex="-1"])')].filter(el=>el.offsetParent!==null);}function analytics(event,extra=){if(!Array.isArray(window.dataLayer))return;window.dataLayer.push({event,component_name:"google_preferred_source_v17",source_domain:"haberlisin.com",...extra});}function replayAnimation()function openPopup(trigger="manual"){if(isOpen)return;if(!CONFIG.testMode&&(triggered||!canShow()))return;triggered=true;isOpen=true;previousFocus=document.activeElement;if(!CONFIG.testMode){set(localStorage,KEYS.date,today());set(sessionStorage,KEYS.session,"1");}replayAnimation();popup.classList.add("is-open");popup.setAttribute("aria-hidden","false");document.body.classList.add("hpc-lock");setTimeout(()=>{const items=focusables();(items[0]||card).focus();},60);analytics("preferred_source_popup_view",{popup_trigger:trigger});}function hidePopup(){isOpen=false;popup.classList.remove("is-open");popup.setAttribute("aria-hidden","true");document.body.classList.remove("hpc-lock");}function closePopup(reason){if(!isOpen)return;hidePopup();if(!CONFIG.testMode){set(localStorage,KEYS.dismissed,Date.now()+CONFIG.dismissHours*60*60*1000);}analytics(reason=== "remind_tomorrow"? "preferred_source_popup_remind_later":"preferred_source_popup_close",{close_reason:reason});setTimeout(()=>previousFocus?.focus?.(),50);}function scrollPercent(){const h=document.documentElement.scrollHeight-innerHeight;return h>0?(scrollY/h)*100:0;}function onScroll(){if(!triggered&&canShow()&&scrollPercent()>=CONFIG.scrollPercent){openPopup("scroll");removeEventListener("scroll",onScroll);}}popup.querySelectorAll("[data-hpc-close]").forEach(el=>{el.addEventListener("click",()=>closePopup(el.dataset.hpcClose));});action.addEventListener("click",()=>{if(!CONFIG.testMode){set(localStorage,KEYS.selected,Date.now()+CONFIG.selectedDays*24*60*60*1000);}analytics("preferred_source_popup_click",{destination_url:CONFIG.destination});hidePopup();const opened=window.open(CONFIG.destination,"_blank","noopener,noreferrer");if(!opened){location.href=CONFIG.destination;}});document.addEventListener("keydown",event=>{if(!isOpen)return;if(event.key=== "Escape"){closePopup("escape");return;}if(event.key!== "Tab")return;const items=focusables();if(!items.length){event.preventDefault();card.focus();return;}const first=items[0];const last=items[items.length-1];if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus();}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus();}});window.HPCPopup={open:()=>{triggered=false;openPopup("manual");},close:()=>closePopup("manual"),reset:()=>{Object.values(KEYS).forEach(key=>{remove(localStorage,key);remove(sessionStorage,key);});triggered=false;console.info("[HPC]v16 kayıtları temizlendi.");}};function init(){if(CONFIG.testMode){setTimeout(()=>openPopup("test"),500);return;}if(!canShow())return;setTimeout(()=>openPopup("delay"),CONFIG.showAfterMs);addEventListener("scroll",onScroll,{passive:true});}if(document.readyState=== "loading"){document.addEventListener("DOMContentLoaded",init,{once:true});}else{init();}})();</script></div>
    

