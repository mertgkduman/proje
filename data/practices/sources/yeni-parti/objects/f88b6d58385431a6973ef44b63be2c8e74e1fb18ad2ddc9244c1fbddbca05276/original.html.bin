<body class="d-flex flex-column min-vh-100">

    <div data-pagespeed="true"><script>
(function () {
  "use strict";

  /*
   * ANA SAYFA AÇILIŞ REKLAMI AYARLARI
   */
  var HOME_AD_IMAGE =
    "https://aydintimescom.teimg.com/aydintimes-com/uploads/2026/09/bakracjpg.jpeg";

  var HOME_AD_CLICK_URL =
    "https://www.instagram.com/bakraccoffee/";

  /*
   * Reklamın ekranda kalma süresi: 8 saniye
   */
  var AD_DURATION = 8000;
  var adTimer = null;

  function isHomePage() {
    var path = window.location.pathname
      .replace(/\/+/g, "/")
      .replace(/\/+$/, "");

    return path === "";
  }

  function removeAd() {
    var ad = document.getElementById("bakrac-fullscreen-ad");

    if (ad) {
      ad.remove();
    }

    if (adTimer) {
      clearTimeout(adTimer);
      adTimer = null;
    }
  }

  function addAdStyle() {
    if (document.getElementById("bakrac-fullscreen-style")) {
      return;
    }

    var style = document.createElement("style");
    style.id = "bakrac-fullscreen-style";

    style.textContent = `
      #bakrac-fullscreen-ad {
        position: fixed !important;
        inset: 0 !important;
        z-index: 2147483647 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        overflow: hidden !important;
        background: #365536 !important;
      }

      #bakrac-fullscreen-ad::before {
        content: "";
        position: absolute;
        inset: -30px;
        background-image: var(--bakrac-ad-image);
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        filter: blur(20px);
        transform: scale(1.08);
        opacity: 0.65;
      }

      #bakrac-fullscreen-ad .bakrac-ad-content {
        position: absolute !important;
        inset: 0 !important;
        z-index: 1 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
      }

      #bakrac-fullscreen-ad .bakrac-ad-image {
        display: block !important;
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        max-height: none !important;
        object-fit: contain !important;
        object-position: center !important;
      }

      #bakrac-fullscreen-ad .bakrac-close {
        position: absolute !important;
        top: 18px !important;
        right: 18px !important;
        z-index: 3 !important;
        width: 44px !important;
        height: 44px !important;
        padding: 0 !important;
        border: 2px solid #fff !important;
        border-radius: 50% !important;
        background: rgba(0, 0, 0, 0.7) !important;
        color: #fff !important;
        font: 700 28px/38px Arial, sans-serif !important;
        text-align: center !important;
        cursor: pointer !important;
      }

      #bakrac-fullscreen-ad .bakrac-ad-label {
        position: absolute !important;
        top: 20px !important;
        left: 20px !important;
        z-index: 3 !important;
        padding: 6px 10px !important;
        border-radius: 4px !important;
        background: rgba(0, 0, 0, 0.65) !important;
        color: #fff !important;
        font: 12px Arial, sans-serif !important;
      }

      @media (max-width: 767px) {
        #bakrac-fullscreen-ad .bakrac-close {
          top: 12px !important;
          right: 12px !important;
          width: 40px !important;
          height: 40px !important;
          font-size: 26px !important;
          line-height: 34px !important;
        }

        #bakrac-fullscreen-ad .bakrac-ad-label {
          top: 14px !important;
          left: 14px !important;
        }
      }
    `;

    document.head.appendChild(style);
  }

  function showHomePageAd() {
    if (!isHomePage() || document.getElementById("bakrac-fullscreen-ad")) {
      return;
    }

    addAdStyle();

    var ad = document.createElement("div");
    ad.id = "bakrac-fullscreen-ad";
    ad.style.setProperty("--bakrac-ad-image", 'url("' + HOME_AD_IMAGE + '")');

    var imageHtml = `
      <img
        class="bakrac-ad-image"
        src="${HOME_AD_IMAGE}"
        alt="Reklam"
      >
    `;

    if (HOME_AD_CLICK_URL) {
      imageHtml = `
        <a
          class="bakrac-ad-content"
          href="${HOME_AD_CLICK_URL}"
          target="_blank"
          rel="noopener sponsored"
          aria-label="Reklam bağlantısını aç"
        >
          ${imageHtml}
        </a>
      `;
    } else {
      imageHtml = `
        <div class="bakrac-ad-content">
          ${imageHtml}
        </div>
      `;
    }

    ad.innerHTML = `
      <span class="bakrac-ad-label">Reklam</span>
      ${imageHtml}
      <button
        type="button"
        class="bakrac-close"
        aria-label="Reklamı kapat"
      >
        &times;
      </button>
    `;

    document.body.appendChild(ad);

    // Kapatma butonuna tıklama
    ad.querySelector(".bakrac-close").addEventListener("click", function (e) {
      e.preventDefault();
      e.stopPropagation();
      removeAd();
    });

    // Otomatik kapanma zamanlayıcısı
    adTimer = setTimeout(removeAd, AD_DURATION);
  }

  /*
   * Escape tuşuna basıldığında reklamı kapatır.
   */
  document.addEventListener("keydown", function (event) {
    if (
      event.key === "Escape" &&
      document.getElementById("bakrac-fullscreen-ad")
    ) {
      removeAd();
    }
  });

  /*
   * Sayfa yüklendiğinde ana sayfa reklamını başlatır.
   */
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", showHomePageAd);
  } else {
    showHomePageAd();
  }
})();
</script></div>
    

