<form method="get" class="ailegovtr-search-form" data-results-url="/umbraco/surface/search/Results">
    <section>
        <div class="container">
            <div class="row">

                <div id="search" class="search">

                    <input id="DocTypeAliases" name="DocTypeAliases" type="hidden" value="USNNewsItem,USNAnnouncementItem,faqItem,USNPageFolder" />
                    <input id="FieldPropertyAliases" name="FieldPropertyAliases" type="hidden" value="nodeName,metaDescription,metaKeywords,ogTitle,ogDescription,newsTitle,newsSummary,newsContent,announcementTitle,announcementSummary,announcementContent,FAQItemQuestion,FAQItemAnswer" />
                    <input data-val="true" data-val-required="The PageSize field is required." id="PageSize" name="PageSize" type="hidden" value="4" />
                    <input data-val="true" data-val-required="The PagingGroupSize field is required." id="PagingGroupSize" name="PagingGroupSize" type="hidden" value="3" />

                    <input type="hidden" name="page" value="1" />

                    <input type="search"
                           name="q"
                           placeholder="Arama..."
                           class="form-control"
                           autocomplete="off" />

                    <span class="icon-search"></span>

                    <div id="search-results">
                    </div>

                </div>

            </div>
        </div>
    </section>
</form>

<script>
    (function () {
        var form = document.currentScript.previousElementSibling;
        if (!form || form.tagName !== 'FORM') { return; }

        var hedef = form.querySelector('#search-results');
        var sayfaAlani = form.querySelector('input[name="page"]');
        if (!hedef) { return; }

        function sonucGetir(sayfa) {
            var veri = new URLSearchParams(new FormData(form));
            if (sayfa) { veri.set('page', sayfa); }

            fetch(form.dataset.resultsUrl + '?' + veri.toString(), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
                .then(function (r) { return r.ok ? r.text() : null; })
                .then(function (html) {
                    if (html === null) { return; }
                    hedef.innerHTML = html;
                    if (sayfa && sayfaAlani) { sayfaAlani.value = sayfa; }
                })
                .catch(function () { /* sessizce gec: form normal gonderimle de calisir */ });
        }

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (sayfaAlani) { sayfaAlani.value = '1'; }
            sonucGetir(1);
        });

        // Sayfalama dugmeleri sonuc parcasinin icinde uretildigi icin olay
        // dinleyici kapsayiciya baglaniyor.
        hedef.addEventListener('click', function (e) {
            var dugme = e.target.closest('[data-page]');
            if (!dugme) { return; }
            e.preventDefault();
            sonucGetir(dugme.getAttribute('data-page'));
        });
    })();
</script>



