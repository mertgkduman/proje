        <!-- Accessibility: Erişilebilirlik menüsü için klavye + ARIA yönetimi -->
        <script>
        (function () {
            $(function () {
                var $toggle = $('#accessibilityToggle');
                var $panel = $('#accessibilityPanel');
                var $closeBtn = $('#accessibilityCloseButton');
                if (!$panel.length) return;

                var lastFocused = null;

                function isPanelOpen() {
                    return $panel.hasClass('open') || $panel.hasClass('is-open') || $panel.hasClass('show') || $panel.is(':visible') && $panel.css('display') !== 'none' && $panel.css('visibility') !== 'hidden';
                }

                function getFocusableElements() {
                    return $panel.find('button:not([disabled]), [role="button"]:not([disabled]), a[href], input:not([disabled]), [tabindex]:not([tabindex="-1"])').filter(':visible');
                }

                function openPanelA11y() {
                    lastFocused = document.activeElement;
                    $panel.attr('aria-hidden', 'false');
                    $toggle.attr('aria-expanded', 'true');
                    $toggle.attr('aria-label', 'Erişilebilirlik Menüsünü Kapat');
                    // İlk odaklanabilir öğeye focus ver (kapatma butonu)
                    setTimeout(function () {
                        var $first = $closeBtn.length ? $closeBtn : getFocusableElements().first();
                        if ($first.length) $first.focus();
                    }, 100);
                }

                function closePanelA11y() {
                    $panel.attr('aria-hidden', 'true');
                    $toggle.attr('aria-expanded', 'false');
                    $toggle.attr('aria-label', 'Erişilebilirlik Menüsünü Aç');
                    // Önceki odağa dön
                    if (lastFocused && typeof lastFocused.focus === 'function') {
                        try { lastFocused.focus(); } catch (e) { $toggle.focus(); }
                    } else {
                        $toggle.focus();
                    }
                }

                // Toggle butonuna tıklamada (eris.js açıyor olsa bile aria'yı güncelle)
                $toggle.on('click', function () {
                    setTimeout(function () {
                        if (isPanelOpen()) openPanelA11y(); else closePanelA11y();
                    }, 50);
                });

                // Kapat butonuna tıklamada
                $closeBtn.on('click', function () {
                    setTimeout(closePanelA11y, 50);
                });

                // ESC tuşu ile kapat
                $(document).on('keydown', function (e) {
                    if ((e.key === 'Escape' || e.keyCode === 27) && isPanelOpen()) {
                        e.preventDefault();
                        // eris.js'in kapatma butonunu programatik tetikle
                        if ($closeBtn.length) $closeBtn[0].click();
                        setTimeout(closePanelA11y, 50);
                    }
                });

                // ac-box (role="button") öğeleri için Space/Enter tıklama ve aria-pressed toggle
                $(document).on('keydown', '.ac-box[role="button"]', function (e) {
                    if (e.key === 'Enter' || e.key === ' ' || e.keyCode === 13 || e.keyCode === 32) {
                        e.preventDefault();
                        this.click();
                    }
                });

                // Bir ac-box tıklandığında aria-pressed'i toggle et (eris.js .active class ekliyor olabilir)
                $(document).on('click', '.ac-box[role="button"]', function () {
                    var $box = $(this);
                    setTimeout(function () {
                        var pressed = $box.hasClass('active') || $box.hasClass('selected') || $box.hasClass('is-active') || $box.attr('data-active') === 'true';
                        // Class yoksa kendi state'imizi toggle et
                        if (!pressed) {
                            var cur = $box.attr('aria-pressed') === 'true';
                            $box.attr('aria-pressed', cur ? 'false' : 'true');
                        } else {
                            $box.attr('aria-pressed', pressed ? 'true' : 'false');
                        }
                    }, 100);
                });

                // Focus trap — Tab ile panel dışına çıkmayı engelle (modal davranışı)
                $panel.on('keydown', function (e) {
                    if (e.key !== 'Tab' && e.keyCode !== 9) return;
                    if (!isPanelOpen()) return;
                    var $focusables = getFocusableElements();
                    if (!$focusables.length) return;
                    var first = $focusables[0];
                    var last = $focusables[$focusables.length - 1];
                    if (e.shiftKey && document.activeElement === first) {
                        e.preventDefault();
                        last.focus();
                    } else if (!e.shiftKey && document.activeElement === last) {
                        e.preventDefault();
                        first.focus();
                    }
                });

                // "Ayarları Temizle" butonu — tüm aria-pressed'leri sıfırla
                $('#clearSettings').on('click', function () {
                    setTimeout(function () {
                        $panel.find('.ac-box[role="button"]').attr('aria-pressed', 'false');
                    }, 100);
                });

                // İlk yüklemede panelin gizli olduğunu işaretle
                if (!isPanelOpen()) {
                    $panel.attr('aria-hidden', 'true');
                    $toggle.attr('aria-expanded', 'false');
                }

                // Ekran Okuyucu kapatıldığında geride kalan vurguyu temizle.
                // eris.js, okuyucu kapanınca son okunan öğeden 'accSpeakingArea'
                // class'ını kaldırmadığı için öğe sarı kalıyor. <html>'den
                // 'screen-reader' class'ı kalktığında tüm vurguları temizliyoruz.
                (function () {
                    var html = document.documentElement;
                    function clearSpeakingHighlight() {
                        var nodes = document.querySelectorAll('.accSpeakingArea');
                        for (var i = 0; i < nodes.length; i++) {
                            nodes[i].classList.remove('accSpeakingArea');
                        }
                    }
                    var wasOn = html.classList.contains('screen-reader');
                    var observer = new MutationObserver(function () {
                        var isOn = html.classList.contains('screen-reader');
                        if (wasOn && !isOn) {
                            clearSpeakingHighlight();
                        }
                        wasOn = isOn;
                    });
                    observer.observe(html, { attributes: true, attributeFilter: ['class'] });
                })();
            });
        })();
        </script>

        <!-- Metis Accordion Menu -->



        <!-- Custom Scripts -->

        <script>
            $(document).ready(function () {

                //exporte les données sélectionnées
                var $table = $('#table');



                var trBoldBlue = $("table");

                $(trBoldBlue).on("click", "tr", function () {
                    $(this).toggleClass("bold-blue");
                });



                // Video Tab Vertical Sliding
                $('.h-carouFredSel').carouFredSel({
                    items: 3,

                    auto: false,
                    circular: false,
                    infinite: true,

                    next: '#next-tabs',
                    prev: '#prev-tabs',

                    mousewheel: true,

                    swipe: {
                        onTouch: true,
                        onMouse: true
                    },

                    scroll: {
                        items: 1,

                        duration: 500,
                        pauseOnHover: true,
                        height: "variable"
                    }
                });

                // End Video Tab Vertical Sliding

                // Accessibility: bootstrap-table filter control'lere aria-label ekle
                function addAriaLabelsToFilterControls() {
                    $('.filter-control select, .filter-control input').each(function () {
                        var classes = $(this).attr('class') || '';
                        var fieldMatch = classes.match(/bootstrap-table-filter-control-([\w-]+)/);
                        var fieldName = fieldMatch ? fieldMatch[1] : '';
                        var labelText = '';
                        if (fieldName) {
                            var $th = $('th[data-field="' + fieldName + '"]');
                            if ($th.length) {
                                labelText = $th.clone().children('.th-inner').text().trim() || $th.text().trim();
                            }
                        }
                        var finalLabel = (labelText || fieldName || 'Filtre') + ' filtrele';
                        $(this).attr('aria-label', finalLabel);
                        if (!$(this).attr('title')) {
                            $(this).attr('title', finalLabel);
                        }
                        if ($(this).is('input') && !$(this).attr('placeholder')) {
                            $(this).attr('placeholder', finalLabel);
                        }
                    });
                }
                // Hem ready hem de post-body event'inde, ayrıca MutationObserver ile sürekli izle
                addAriaLabelsToFilterControls();
                setTimeout(addAriaLabelsToFilterControls, 100);
                setTimeout(addAriaLabelsToFilterControls, 500);
                setTimeout(addAriaLabelsToFilterControls, 1500);
                $('table[data-toggle="table"]').on('post-body.bs.table post-header.bs.table load-success.bs.table', addAriaLabelsToFilterControls);
                if (window.MutationObserver) {
                    var filterObserver = new MutationObserver(function () { addAriaLabelsToFilterControls(); });
                    $('table[data-toggle="table"]').each(function () {
                        var container = $(this).closest('.bootstrap-table')[0] || $(this).parent()[0];
                        if (container) {
                            filterObserver.observe(container, { childList: true, subtree: true });
                        }
                    });
                }

                // Accessibility: Erişilebilir metni olmayan tüm bağlantılara aria-label ekle
                function addAriaLabelsToLinks() {
                    $('a').each(function () {
                        var $a = $(this);
                        if ($a.attr('aria-label') && $a.attr('aria-label').length > 0) return;
                        if ($a.attr('aria-labelledby')) return;
                        var visibleText = $a.text().trim();
                        if (visibleText.length > 0) return;
                        var hasImgWithAlt = false;
                        $a.find('img').each(function () {
                            if ($(this).attr('alt') && $(this).attr('alt').trim().length > 0) hasImgWithAlt = true;
                        });
                        if (hasImgWithAlt) return;

                        var label = '';
                        var classes = $a.attr('class') || '';

                        // Sosyal paylaşım butonları (ssk-*)
                        if (classes.indexOf('ssk-facebook') > -1) label = 'Facebook üzerinde paylaş';
                        else if (classes.indexOf('ssk-twitter') > -1) label = 'Twitter üzerinde paylaş';
                        else if (classes.indexOf('ssk-instagram') > -1) label = 'Instagram\'da paylaş';
                        else if (classes.indexOf('ssk-youtube') > -1) label = 'YouTube üzerinde paylaş';
                        else if (classes.indexOf('ssk-linkedin') > -1) label = 'LinkedIn üzerinde paylaş';
                        else if (classes.indexOf('ssk-whatsapp') > -1) label = 'WhatsApp üzerinde paylaş';
                        else if (classes.indexOf('ssk-email') > -1) label = 'E-posta ile paylaş';
                        else if (classes.indexOf('ssk-pinterest') > -1) label = 'Pinterest üzerinde paylaş';
                        else if (classes.indexOf('ssk-telegram') > -1) label = 'Telegram üzerinde paylaş';
                        else if (classes.indexOf('ssk') > -1) label = 'Sosyal medyada paylaş';

                        // href'ten dosya adını al
                        if (!label) {
                            var href = $a.attr('href') || '';
                            if (href && href !== '#' && href.length > 1) {
                                try {
                                    var clean = href.split('?')[0].split('#')[0];
                                    var parts = clean.split('/');
                                    var fileName = parts[parts.length - 1] || parts[parts.length - 2] || '';
                                    fileName = decodeURIComponent(fileName);
                                    var ext = '';
                                    var dotIdx = fileName.lastIndexOf('.');
                                    if (dotIdx > 0) {
                                        ext = fileName.substring(dotIdx + 1).toLowerCase();
                                        fileName = fileName.substring(0, dotIdx);
                                    }
                                    fileName = fileName.replace(/[-_]+/g, ' ').replace(/\s+/g, ' ').trim();
                                    if (fileName.length > 0) {
                                        var prefix = 'Belgeyi aç';
                                        if (ext === 'pdf') prefix = 'PDF dosyasını aç';
                                        else if (ext === 'doc' || ext === 'docx') prefix = 'Word belgesini aç';
                                        else if (ext === 'xls' || ext === 'xlsx') prefix = 'Excel dosyasını aç';
                                        else if (ext === 'ppt' || ext === 'pptx') prefix = 'Sunum dosyasını aç';
                                        else if (ext === 'zip' || ext === 'rar' || ext === '7z') prefix = 'Arşivi indir';
                                        else if (ext === 'jpg' || ext === 'jpeg' || ext === 'png' || ext === 'gif' || ext === 'webp') prefix = 'Görseli aç';
                                        else if (ext === 'mp4' || ext === 'mp3' || ext === 'wav') prefix = 'Medyayı oynat';
                                        label = prefix + ': ' + fileName;
                                    } else if (href.indexOf('http') === 0) {
                                        label = 'Dış bağlantıyı aç';
                                    }
                                } catch (e) {
                                    label = 'Bağlantıyı aç';
                                }
                            }
                        }

                        if (!label) {
                            if ($a.find('i.fa, i.fas, i.far, i.fab, span.icon').length > 0) {
                                label = 'Bağlantı';
                            } else {
                                label = 'Bağlantıyı aç';
                            }
                        }

                        $a.attr('aria-label', label);
                        if (!$a.attr('title')) $a.attr('title', label);
                    });
                }
                addAriaLabelsToLinks();
                setTimeout(addAriaLabelsToLinks, 300);
                setTimeout(addAriaLabelsToLinks, 1500);
                if (window.MutationObserver) {
                    var linkObserver = new MutationObserver(function () { addAriaLabelsToLinks(); });
                    linkObserver.observe(document.body, { childList: true, subtree: true });
                }

                // Accessibility: target="_blank" olan bağlantılara "yeni sekmede açılır" bilgisi ekle (WCAG 3.2.5)
                function markNewTabLinks() {
                    $('a[target="_blank"]').each(function () {
                        var $a = $(this);
                        // Halihazırda işaretliyse atla
                        if ($a.attr('data-newtab-marked') === 'true') return;

                        // rel="noopener" yoksa ekle (güvenlik bonusu)
                        var rel = ($a.attr('rel') || '').toLowerCase();
                        if (rel.indexOf('noopener') === -1) {
                            $a.attr('rel', (rel ? rel + ' ' : '') + 'noopener');
                        }

                        // FOOTER BAKANLIK LİNKLERİ: <a> içinde blok <div class="content"> + görünür .text var.
                        // Bu linklerde ekran okuyucu aria-label'ı okumuyor; yalnızca GERÇEK sr-only metni okuyor.
                        // Bu yüzden linke ÖZEL tam metni (".text.mobile adı + (yeni sekmede açılır)") gerçek
                        // sr-only span olarak <a>'nın doğrudan çocuğu yap; görsel .content'i AT'den gizle.
                        var $content = $a.children('.content');
                        if ($content.length) {
                            if ($a.children('.newtab-indicator-sr').length === 0) {
                                var $name = $content.find('.text.mobile').first();
                                if (!$name.length) $name = $content.find('.text').first();
                                var nameHtml = $name.length ? $name.html() : $content.html();
                                var nameText = (nameHtml || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
                                $content.attr('aria-hidden', 'true');   // görsel tekrarı AT'den gizle
                                $a.removeAttr('aria-label');             // önceki denemelerden temizle
                                var srSpan = document.createElement('span');
                                srSpan.className = 'newtab-indicator-sr sr-only';
                                srSpan.textContent = (nameText ? nameText + ' ' : '') + '(yeni sekmede açılır)';
                                $a.append(srSpan);
                            }
                            $a.attr('data-newtab-marked', 'true');
                            return;
                        }

                        // Görsel olarak gizli "(yeni sekmede açılır)" notu ekle
                        // (aria-label varsa onu da güncelle, yoksa sadece sr-only span koy)
                        var currentAriaLabel = $a.attr('aria-label');
                        if (currentAriaLabel && currentAriaLabel.indexOf('yeni sekmede') === -1) {
                            $a.attr('aria-label', currentAriaLabel + ' (yeni sekmede açılır)');
                        } else if (!currentAriaLabel) {
                            // 1. img[alt] varsa (svg-inject henüz çalışmadıysa) alt metnini al
                            var imgAlts = [];
                            $a.find('img[alt]').each(function () {
                                var alt = $(this).attr('alt');
                                if (alt && alt.trim()) {
                                    imgAlts.push(alt.trim());
                                    $(this).attr('alt', '');
                                }
                            });
                            if (imgAlts.length > 0) {
                                $a.attr('aria-label', imgAlts.join(' ') + ' (yeni sekmede açılır)');
                            } else {
                                // 2. svg-inject sonrası img yoksa görünür metin içeriğini kullan
                                var $clone = $a.clone();
                                $clone.find('.newtab-indicator-sr, .sr-only, [aria-hidden="true"]').remove();
                                var linkText = $clone.text().replace(/\s+/g, ' ').trim();
                                if (linkText && linkText.length > 0) {
                                    $a.attr('aria-label', linkText + ' (yeni sekmede açılır)');
                                } else {
                                    if ($a.find('.newtab-indicator-sr').length === 0) {
                                        $a.append('<span class="newtab-indicator-sr sr-only"> (yeni sekmede açılır)</span>');
                                    }
                                }
                            }
                        }

                        // title varsa onu da pekiştir
                        var currentTitle = $a.attr('title');
                        if (currentTitle && currentTitle.indexOf('yeni sekmede') === -1) {
                            $a.attr('title', currentTitle + ' (yeni sekmede açılır)');
                        } else if (!currentTitle && currentAriaLabel) {
                            $a.attr('title', currentAriaLabel);
                        }

                        $a.attr('data-newtab-marked', 'true');
                    });
                }
                // İKON/GÖRSEL LİNKLER (sosyal medya, Hızlı Erişim): görünür metni yok, yalnızca aria-label var.
                // Ekran okuyucu aria-label'ı okumadığı için aria-label metnini GERÇEK sr-only metne çevir.
                // (markNewTabLinks'ten SONRA çalışır; target=_blank'lerde "(yeni sekmede açılır)" zaten eklenmiştir.)
                function convertAriaLabelLinksToSrText() {
                    $('a[aria-label]').each(function () {
                        var $a = $(this);
                        if ($a.attr('data-sr-converted') === 'true') return;
                        // Görünür metni olan linklere dokunma (sadece ikon/görsel linkler)
                        var $vis = $a.clone();
                        $vis.find('.sr-only, [aria-hidden="true"]').remove();
                        if ($vis.text().replace(/\s+/g, ' ').trim().length > 0) return;
                        var label = ($a.attr('aria-label') || '').trim();
                        if (!label) return;
                        if ($a.find('.sr-label-text').length === 0) {
                            var span = document.createElement('span');
                            span.className = 'sr-label-text sr-only';
                            span.textContent = label;
                            $a.append(span);
                        }
                        $a.removeAttr('aria-label');   // çift okuma olmasın (artık gerçek metin var)
                        $a.attr('data-sr-converted', 'true');
                    });
                }
                function runLinkA11y() { markNewTabLinks(); convertAriaLabelLinksToSrText(); }
                runLinkA11y();
                setTimeout(runLinkA11y, 300);
                setTimeout(runLinkA11y, 1500);
                if (window.MutationObserver) {
                    var newTabObserver = new MutationObserver(function () { runLinkA11y(); });
                    newTabObserver.observe(document.body, { childList: true, subtree: true });
                }

                // Accessibility: title niteliği olmayan iframe'lere title ekle (WCAG 2.4.1 / 4.1.2)
                function addTitlesToIframes() {
                    $('iframe').each(function () {
                        var $f = $(this);
                        if ($f.attr('title') && $f.attr('title').trim().length > 0) return;
                        if ($f.attr('aria-label') && $f.attr('aria-label').trim().length > 0) return;
                        var src = ($f.attr('src') || '').toLowerCase();
                        var title = '';
                        if (src.indexOf('google.com/maps') > -1 || src.indexOf('maps.google') > -1) {
                            title = 'Google Haritalar konum gömme';
                        } else if (src.indexOf('youtube.com') > -1 || src.indexOf('youtu.be') > -1 || src.indexOf('youtube-nocookie') > -1) {
                            title = 'YouTube video oynatıcı';
                        } else if (src.indexOf('vimeo.com') > -1) {
                            title = 'Vimeo video oynatıcı';
                        } else if (src.indexOf('facebook.com') > -1) {
                            title = 'Facebook gömülü içerik';
                        } else if (src.indexOf('twitter.com') > -1 || src.indexOf('x.com') > -1) {
                            title = 'Twitter gömülü içerik';
                        } else if (src.indexOf('instagram.com') > -1) {
                            title = 'Instagram gömülü içerik';
                        } else if (src.indexOf('soundcloud.com') > -1) {
                            title = 'SoundCloud ses oynatıcı';
                        } else if (src.indexOf('.pdf') > -1) {
                            title = 'PDF belge görüntüleyici';
                        } else if (src.indexOf('fancybox') > -1) {
                            title = 'Görüntü/medya önizleme';
                        } else if (src) {
                            try {
                                var host = src.split('/')[2] || '';
                                if (host) {
                                    title = host.replace(/^www\./, '') + ' gömülü içerik';
                                } else {
                                    title = 'Gömülü içerik';
                                }
                            } catch (e) {
                                title = 'Gömülü içerik';
                            }
                        } else {
                            title = 'Gömülü içerik';
                        }
                        $f.attr('title', title);
                        if (!$f.attr('aria-label')) $f.attr('aria-label', title);
                    });
                }
                addTitlesToIframes();
                setTimeout(addTitlesToIframes, 300);
                setTimeout(addTitlesToIframes, 1500);
                if (window.MutationObserver) {
                    var iframeObserver = new MutationObserver(function () { addTitlesToIframes(); });
                    iframeObserver.observe(document.body, { childList: true, subtree: true });
                }

                // Accessibility: Alt menü içeren öğelere ARIA bilgilerini ekle (WCAG 4.1.2)
                function enhanceSubmenus() {
                    $('li.has-children').each(function () {
                        var $li = $(this);
                        // Bu li'nin doğrudan <a> ve <ul> çocuklarını al
                        var $trigger = $li.children('a').first();
                        var $submenu = $li.children('ul').first();
                        if (!$trigger.length || !$submenu.length) return;

                        // Submenu'ya id verelim (yoksa)
                        var submenuId = $submenu.attr('id');
                        if (!submenuId) {
                            submenuId = 'submenu-' + Math.random().toString(36).substr(2, 9);
                            $submenu.attr('id', submenuId);
                        }

                        // Trigger'a ARIA ekle
                        if (!$trigger.attr('aria-haspopup')) {
                            $trigger.attr('aria-haspopup', 'true');
                        }
                        if (!$trigger.attr('aria-controls')) {
                            $trigger.attr('aria-controls', submenuId);
                        }
                        // is-hidden class'ı kontrol et — yoksa açık demektir
                        var isHidden = $submenu.hasClass('is-hidden');
                        $trigger.attr('aria-expanded', isHidden ? 'false' : 'true');

                        // Görünür linkin metnine "alt menü" gizli açıklaması ekle (yalnızca bir kez)
                        if ($trigger.find('.submenu-indicator-sr').length === 0) {
                            var linkText = $trigger.text().trim();
                            $trigger.append('<span class="submenu-indicator-sr sr-only"> , alt menü içerir</span>');
                            // Erişilebilir ad düşmesin diye aria-label de set edelim
                            if (!$trigger.attr('aria-label')) {
                                $trigger.attr('aria-label', linkText + ', alt menü içerir');
                            }
                        }

                        // Submenu'ya role ve label
                        if (!$submenu.attr('role')) {
                            $submenu.attr('role', 'menu');
                        }
                        if (!$submenu.attr('aria-label')) {
                            var label = $trigger.text().replace(', alt menü içerir', '').trim();
                            if (label) $submenu.attr('aria-label', label + ' alt menüsü');
                        }
                    });
                }

                // Submenu açılma/kapanma durumunu izle (is-hidden class değişimi)
                function watchSubmenuState() {
                    if (!window.MutationObserver) return;
                    $('li.has-children > ul').each(function () {
                        var ul = this;
                        var $li = $(ul).parent();
                        var $trigger = $li.children('a').first();
                        if (!$trigger.length) return;

                        var observer = new MutationObserver(function () {
                            var hidden = ul.classList.contains('is-hidden');
                            $trigger.attr('aria-expanded', hidden ? 'false' : 'true');
                        });
                        observer.observe(ul, { attributes: true, attributeFilter: ['class'] });
                    });
                }

                enhanceSubmenus();
                watchSubmenuState();
                // DOM güncellemelerine karşı tekrar dene
                setTimeout(enhanceSubmenus, 500);
                setTimeout(function () { enhanceSubmenus(); watchSubmenuState(); }, 1500);

                // ESC ile en üst düzeyde menüyü kapat (varsa)
                $(document).on('keydown', function (e) {
                    if (e.key !== 'Escape' && e.keyCode !== 27) return;
                    // Açık alt menüleri kapat — go-back linkini tetikle
                    var $openSubmenu = $('li.has-children > ul:not(.is-hidden)').last();
                    if ($openSubmenu.length) {
                        var $goBack = $openSubmenu.children('.go-back').children('a').first();
                        if ($goBack.length) {
                            e.preventDefault();
                            $goBack[0].click();
                        }
                    }
                });

                // Accessibility: Header tetikleyici düğmeleri (search/nav) için aria-expanded yönetimi
                (function () {
                    var $search = $('.search-trigger');
                    var $nav = $('.nav-trigger');

                    function syncFromHash() {
                        var hash = (window.location.hash || '').toLowerCase();
                        // Arama paneli açık mı?
                        var searchOpen = hash === '#search';
                        $search.attr('aria-expanded', searchOpen ? 'true' : 'false');
                        if (searchOpen) {
                            $search.attr('aria-label', 'Aramayı kapat');
                        } else {
                            $search.attr('aria-label', 'Aramayı aç');
                        }
                        // Navigasyon menüsü açık mı?
                        var navOpen = hash === '#primary-nav';
                        $nav.attr('aria-expanded', navOpen ? 'true' : 'false');
                        if (navOpen) {
                            $nav.attr('aria-label', 'Menüyü kapat');
                        } else {
                            $nav.attr('aria-label', 'Menüyü aç');
                        }
                    }

                    // Güvenli odaklama: tarayıcının öğeye kaydırmasını engelle (menü DOM'da altta olsa da sayfa zıplamasın)
                    function safeFocus(el) {
                        if (!el) return;
                        try { el.focus({ preventScroll: true }); }
                        catch (e) { el.focus(); }
                    }
                    // Yardımcılar: menünün ilk öğesi ve arama kutusu
                    function focusFirstMenuItem() {
                        var nav = document.getElementById('primary-nav');
                        if (!nav) return;
                        var item = nav.querySelector('a[href], button, [tabindex]');
                        if (item) {
                            safeFocus(item);
                        } else {
                            // İçinde odaklanabilir öğe yoksa konteynerin kendisine odaklan
                            if (!nav.hasAttribute('tabindex')) nav.setAttribute('tabindex', '-1');
                            safeFocus(nav);
                        }
                    }
                    function focusSearchInput() {
                        var panel = document.getElementById('search');
                        if (!panel) return;
                        var input = panel.querySelector('input[type="search"], input[type="text"], input:not([type])');
                        if (input) safeFocus(input);
                    }

                    syncFromHash();
                    $(window).on('hashchange', syncFromHash);

                    // Menüyü Aç tıklanınca: durum güncelle + odağı menünün ilk öğesine taşı
                    // (Menü DOM'da en altta olsa bile odak menüye gider; ekran okuyucu oradan okur.)
                    $nav.on('click', function () {
                        setTimeout(function () {
                            syncFromHash();
                            if ((window.location.hash || '').toLowerCase() === '#primary-nav') {
                                focusFirstMenuItem();
                            }
                        }, 200);
                    });
                    // Aramayı Aç tıklanınca: durum güncelle + odağı arama kutusuna taşı
                    $search.on('click', function () {
                        setTimeout(function () {
                            syncFromHash();
                            if ((window.location.hash || '').toLowerCase() === '#search') {
                                focusSearchInput();
                            }
                        }, 200);
                    });

                    // Klavye: link element ama role=button olduğu için Space ile de tetiklenmesini sağla
                    $search.add($nav).on('keydown', function (e) {
                        if (e.key === ' ' || e.keyCode === 32) {
                            e.preventDefault();
                            this.click();
                        }
                    });

                    // ESC: menü veya arama açıkken odağı tetikleyiciye geri döndür
                    $(document).on('keydown', function (e) {
                        if (e.key !== 'Escape' && e.keyCode !== 27) return;
                        var hash = (window.location.hash || '').toLowerCase();
                        if (hash === '#primary-nav' && $nav.length) {
                            $nav[0].focus();
                        } else if (hash === '#search' && $search.length) {
                            $search[0].focus();
                        }
                    });
                })();

                var vtabs = new Swiper('.vtabs', {
                    //autoHeight: true, //enable auto height
                    slidesPerView: 3,
                    spaceBetween: 30,
                    loop: false,

                    //autoHeight: true,

                    pagination: {
                        el: '.swiper-pagination-vtabs',
                        clickable: true,
                        dynamicBullets: true,

                    },


                    navigation: {
                        nextEl: '.swiper-button-next',
                        prevEl: '.swiper-button-prev',
                    },

                    // Accessibility: Türkçe ekran okuyucu mesajları
                    a11y: {
                        enabled: true,
                        prevSlideMessage: 'Önceki video',
                        nextSlideMessage: 'Sonraki video',
                        firstSlideMessage: 'Bu ilk video',
                        lastSlideMessage: 'Bu son video',
                        paginationBulletMessage: '{{index}}. videoya git',
                        notificationClass: 'swiper-notification'
                    },

                    keyboard: { enabled: true, onlyInViewport: true },

                    watchOverflow: true,
                    observer: true,
                    observeParents: true,

                    breakpoints: {

                        // when window width is <= 1024px
                        1024: {
                            slidesPerView: 3,
                            spaceBetween: 30
                        },

                        // when window width is <= 768px
                        768: {
                            slidesPerView: 2,
                            spaceBetween: 30
                        },

                        // when window width is <= 640px
                        640: {
                            slidesPerView: 1,
                            spaceBetween: 30
                        },

                        // when window width is <= 480px
                        480: {
                            slidesPerView: 1,
                            spaceBetween: 30
                        },
                    }
                });



            });
        </script>

        <script>

        // Start: Print Page

        var swiper = new Swiper('.swiper-quick-link', {
            slidesPerView: 7,
            //grabCursor: true,
            loop: true,

            autoplay: {
                delay: 2500,
                disableOnInteraction: false,
            },

            pagination: {
                el: '.swiper-pagination-quick-link',
                clickable: true,
                dynamicBullets: true,

            },

            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },

            breakpoints: {
                1024: {
                    slidesPerView: 6,
                    spaceBetween: 10
                },
                768: {
                    slidesPerView: 4,
                    spaceBetween: 10
                },
                640: {
                    slidesPerView: 3,
                    spaceBetween: 10
                },
                320: {
                    slidesPerView: 2,
                    spaceBetween: 10
                }
            }

        });

        var swiper = new Swiper('.swiper-quick-link2', {
            slidesPerView: 6,

            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev',
            },
            breakpoints: {
                1024: {
                    slidesPerView: 6,
                    spaceBetween: 10
                },
                768: {
                    slidesPerView: 4,
                    spaceBetween: 10
                },
                640: {
                    slidesPerView: 3,
                    spaceBetween: 10
                },
                320: {
                    slidesPerView: 2,
                    spaceBetween: 10
                }
            }

        });

        // Homepage Slider (Swiper Script)
        var swiper1 = new Swiper('.s2', {
            //grabCursor: true,
            loop: true,
            effect: 'fade',
            //crossFade: false,  Not working!
            fadeEffect: { crossFade: true },

            pagination: {
                el: '.swiper-pagination',
                type: 'fraction',

            },

            navigation: {
                nextEl: '.next',
                prevEl: '.prev'
            },

            // Accessibility: Türkçe ekran okuyucu mesajları
            a11y: {
                enabled: true,
                prevSlideMessage: 'Önceki haber slaytı',
                nextSlideMessage: 'Sonraki haber slaytı',
                firstSlideMessage: 'Bu ilk slayt',
                lastSlideMessage: 'Bu son slayt',
                paginationBulletMessage: '{{index}}. slayda git',
                notificationClass: 'swiper-notification'
            },

            // Klavye ile sol/sağ ok kontrolü
            keyboard: {
                enabled: true,
                onlyInViewport: true
            },

            // Pasif slaytları erişim dışı tut, aktif olanı odaklanabilir yap
            watchSlidesProgress: true,
            watchSlidesVisibility: true,

            on: {
                init: function () {
                    updateSlideAccessibility(this);
                },
                slideChange: function () {
                    updateSlideAccessibility(this);
                }
            }
        });

        // Aktif slayt dışındakileri ekran okuyucudan ve Tab'dan gizle
        function updateSlideAccessibility(sw) {
            var slides = sw.slides;
            for (var i = 0; i < slides.length; i++) {
                var slide = slides[i];
                var isActive = slide.classList.contains('swiper-slide-active');
                if (isActive) {
                    slide.removeAttribute('aria-hidden');
                    slide.setAttribute('tabindex', '0');
                    // Aktif slayt içindeki bağlantıları Tab sırasına geri al
                    var focusables = slide.querySelectorAll('a, button, input, select, textarea, [tabindex]');
                    for (var j = 0; j < focusables.length; j++) {
                        if (focusables[j].getAttribute('data-orig-tabindex') !== null) {
                            focusables[j].setAttribute('tabindex', focusables[j].getAttribute('data-orig-tabindex'));
                        } else {
                            focusables[j].removeAttribute('tabindex');
                        }
                    }
                } else {
                    slide.setAttribute('aria-hidden', 'true');
                    slide.setAttribute('tabindex', '-1');
                    // Pasif slayt içindeki bağlantıları Tab sırasından çıkar
                    var focusables2 = slide.querySelectorAll('a, button, input, select, textarea, [tabindex]');
                    for (var k = 0; k < focusables2.length; k++) {
                        var current = focusables2[k].getAttribute('tabindex');
                        if (current !== null && focusables2[k].getAttribute('data-orig-tabindex') === null) {
                            focusables2[k].setAttribute('data-orig-tabindex', current);
                        }
                        focusables2[k].setAttribute('tabindex', '-1');
                    }
                }
            }
        }

