<!-- Accessibility: Ekran okuyucular için görsel olarak gizli metin sınıfı (NVDA/JAWS uyumluluğu) -->
<style>
    .sr-only,
    .visually-hidden {
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        padding: 0 !important;
        margin: -1px !important;
        overflow: hidden !important;
        clip: rect(0, 0, 0, 0) !important;
        white-space: nowrap !important;
        border: 0 !important;
    }
    .sr-only-focusable:active,
    .sr-only-focusable:focus {
        position: static !important;
        width: auto !important;
        height: auto !important;
        margin: 0 !important;
        overflow: visible !important;
        clip: auto !important;
        white-space: normal !important;
    }

    /* Accessibility: Skip links — sadece klavye odağında görünür, fareyle gizli */
    .skip-links {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 99999;
        margin: 0;
        padding: 0;
        list-style: none;
        pointer-events: none;
    }
    .skip-links li {
        list-style: none;
    }
    .skip-link {
        position: absolute;
        top: -100px;
        left: 0;
        padding: 10px 16px;
        background-color: #003d80;
        color: #ffffff !important;
        text-decoration: underline !important;
        font-weight: 600;
        font-size: 14px;
        border: 2px solid #ffffff;
        border-radius: 0 0 4px 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        white-space: nowrap;
        pointer-events: auto;
        transition: top 0.15s ease-out;
    }
    .skip-link:focus,
    .skip-link:active {
        top: 0;
        outline: 3px solid #ffd54f;
        outline-offset: -3px;
    }
    /* Birden fazla skip-link varsa odaklananın diğerini kapatmaması için yan yana göster */
    .skip-links li + li .skip-link:focus,
    .skip-links li + li .skip-link:active {
        left: auto;
    }
    .skip-links li:nth-child(1) .skip-link:focus { left: 380px; }
    .skip-links li:nth-child(2) .skip-link:focus { left: 560px; }
    .skip-links li:nth-child(3) .skip-link:focus { left: 740px; }

    /* Bakanlık ana sayfa bağlantısı — skip-link gibi davranır, sol üst köşede */
    #ministry-home-link {
        position: absolute;
        top: -100px;
        left: 0;
        padding: 10px 16px;
        background-color: #b71c1c;
        color: #ffffff !important;
        text-decoration: underline !important;
        font-weight: 600;
        font-size: 14px;
        border: 2px solid #ffffff;
        border-radius: 0 0 4px 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
        white-space: nowrap;
        z-index: 99999;
        transition: top 0.15s ease-out;
        /* sr-only override — odakta görünür olabilsin */
        width: auto !important;
        height: auto !important;
        margin: 0 !important;
        overflow: visible !important;
        clip: auto !important;
    }
    #ministry-home-link:focus,
    #ministry-home-link:active {
        top: 0;
        outline: 3px solid #ffd54f;
        outline-offset: -3px;
    }

    /* main-content içine atlandığında focus outline'ı bastırılmasın */
    #main-content:focus {
        outline: none;
    }

    /* Accessibility: Hızlı Erişim kartlarındaki dekoratif ">" oku CSS pseudo-element ile çiziliyordu.
       Ekran okuyucular (özellikle iOS VoiceOver) bunu sürüme göre "isimsiz öğe / boşluk" olarak
       algıladığı için tamamen kaldırıldı. Kartlar zaten kutu+hover ile tıklanabilir görünüyor. */
    .quickAccessRepository .card::before,
    .quickAccessRepository .card::after,
    .quickAccessRepository .card *::before,
    .quickAccessRepository .card *::after,
    .quickAccessRepository .card-info::before,
    .quickAccessRepository .card-info::after,
    .quickAccessRepository a::before,
    .quickAccessRepository a::after {
        content: none !important;
        display: none !important;
    }
</style>

<!-- Accessibility: İçerik bağlantıları çevreleyen metinden ayırt edilebilir olmalı (WCAG 1.4.1 / 2.4.4) -->
<style>
    content a,
    content p a,
    content li a,
    content td a,
    content div a,
    .wrapper a,
    .wrapper p a,
    .wrapper li a,
    .news-item-content content a,
    .news-item-content p a,
    .news-item-content li a,
    article p a,
    article li a,
    article td a {
        color: #0056b3 !important;
        text-decoration: underline !important;
    }

    content a:visited,
    .wrapper a:visited,
    article a:visited {
        color: #6f42c1 !important;
    }

    content a:hover,
    content p a:hover,
    .wrapper p a:hover,
    .wrapper a:hover,
    article p a:hover,
    .news-item-content p a:hover {
        color: #003d80 !important;
        text-decoration: underline !important;
    }

    content a:focus,
    .wrapper a:focus,
    article a:focus {
        outline: 2px solid #0056b3 !important;
        outline-offset: 2px !important;
    }

    /* Bu sınıfları olan linklere uygulama; bunlar zaten görsel olarak ayırt edilebilir */
    content a.btn,
    content a.nav-link,
    content a.dropdown-item,
    content a.card,
    content a.video,
    content a.pdf-document,
    content a.image-document,
    content a.ssk,
    .wrapper a.btn,
    .wrapper a.video,
    article a.btn,
    article a.video {
        color: inherit !important;
        text-decoration: none !important;
    }
</style>


