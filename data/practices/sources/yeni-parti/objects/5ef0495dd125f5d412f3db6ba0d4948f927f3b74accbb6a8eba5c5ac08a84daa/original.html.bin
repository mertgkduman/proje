        <script>
            (function () {
                function setIframeTitles() {
                    var iframes = document.querySelectorAll('iframe');
                    for (var i = 0; i < iframes.length; i++) {
                        var f = iframes[i];
                        if (f.getAttribute('title')) continue;
                        if (f.getAttribute('aria-label')) continue;
                        if (f.getAttribute('aria-labelledby')) continue;
                        var role = f.getAttribute('role');
                        if (role === 'none' || role === 'presentation') continue;

                        var src = (f.getAttribute('src') || '').toLowerCase();
                        var title = 'Gömülü içerik';
                        if (src.indexOf('google.com/maps') !== -1 || src.indexOf('maps.google') !== -1) {
                            title = 'Harita';
                        } else if (src.indexOf('youtube.com') !== -1 || src.indexOf('youtu.be') !== -1) {
                            title = 'YouTube video oynatıcı';
                        } else if (src.indexOf('vimeo.com') !== -1) {
                            title = 'Vimeo video oynatıcı';
                        } else if (src.indexOf('.pdf') !== -1) {
                            title = 'PDF görüntüleyici';
                        }
                        f.setAttribute('title', title);
                    }
                }
                function fixHeadingOrder() {
                    var grayHeads = document.querySelectorAll('.gray-box > h5, .gray-box > h4, .gray-box > h6');
                    for (var i = 0; i < grayHeads.length; i++) {
                        var h = grayHeads[i];
                        var h2 = document.createElement('h2');
                        for (var j = 0; j < h.attributes.length; j++) {
                            h2.setAttribute(h.attributes[j].name, h.attributes[j].value);
                        }
                        h2.innerHTML = h.innerHTML;
                        h.parentNode.replaceChild(h2, h);
                    }
                }
                // Accessibility: Sayfada tek bir 1. seviye baslik (h1) olmasini sagla (WCAG 1.3.1 / 2.4.6)
                // Tum etiketler arasi tutarlilik: bolum basliklari (Haberler, Duyurular, Bakanlik Baglantilari...)
                // gorsel olarak ".section-title" sinifiyla ayni kalir ama semantik olarak h2 olur.
                function demoteHeading(h, tag) {
                    var n = document.createElement(tag);
                    for (var j = 0; j < h.attributes.length; j++) {
                        n.setAttribute(h.attributes[j].name, h.attributes[j].value);
                    }
                    n.innerHTML = h.innerHTML;
                    h.parentNode.replaceChild(n, h);
                    return n;
                }
                function fixH1Hierarchy() {
                    // 1) Bolum basligi olan tum h1.section-title -> h2 (footer + ana sayfa bolumleri)
                    var sectionH1s = document.querySelectorAll('h1.section-title');
                    for (var i = 0; i < sectionH1s.length; i++) {
                        demoteHeading(sectionH1s[i], 'h2');
                    }
                    // 2) Geriye kalan h1'leri say. Birden fazlaysa ilkini koru, gerisini h2 yap.
                    var remaining = document.querySelectorAll('h1');
                    if (remaining.length > 1) {
                        for (var k = 1; k < remaining.length; k++) {
                            demoteHeading(remaining[k], 'h2');
                        }
                    }
                    // 3) Hic h1 kalmadiysa (ornek: ana sayfa) en uste gorsel olarak gizli h1 ekle.
                    if (document.querySelectorAll('h1').length === 0) {
                        var host = document.getElementById('main-content') || document.body;
                        var h1 = document.createElement('h1');
                        h1.className = 'sr-only';
                        h1.style.cssText = 'position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;';
                        var t = (document.title || '').trim();
                        h1.textContent = t.length ? t : 'Ana Sayfa';
                        host.insertBefore(h1, host.firstChild);
                    }
                }
                function addCaptionsToYouTube() {
                    function patch(url) {
                        if (!url) return url;
                        if (url.indexOf('youtube.com') === -1 && url.indexOf('youtu.be') === -1) return url;
                        var hashIdx = url.indexOf('#');
                        var hash = hashIdx >= 0 ? url.substring(hashIdx) : '';
                        var base = hashIdx >= 0 ? url.substring(0, hashIdx) : url;
                        var sep = base.indexOf('?') >= 0 ? '&' : '?';
                        var add = '';
                        if (base.indexOf('cc_load_policy=') === -1) add += sep + 'cc_load_policy=1', sep = '&';
                        if (base.indexOf('cc_lang_pref=') === -1) add += sep + 'cc_lang_pref=tr', sep = '&';
                        if (base.indexOf('hl=') === -1) add += sep + 'hl=tr';
                        return base + add + hash;
                    }
                    var anchors = document.querySelectorAll('a[href*="youtube.com"], a[href*="youtu.be"]');
                    for (var i = 0; i < anchors.length; i++) {
                        var a = anchors[i];
                        if (a.dataset.ccPatched === '1') continue;
                        a.setAttribute('href', patch(a.getAttribute('href')));
                        a.dataset.ccPatched = '1';
                    }
                    var iframes = document.querySelectorAll('iframe[src*="youtube.com"], iframe[src*="youtu.be"]');
                    for (var k = 0; k < iframes.length; k++) {
                        var f = iframes[k];
                        if (f.dataset.ccPatched === '1') continue;
                        f.setAttribute('src', patch(f.getAttribute('src')));
                        f.dataset.ccPatched = '1';
                    }
                }
                // Accessibility: Mobil menüdeki "Ana Menüye Git" / "Önceki Menüye Git" (.go-back) ve boş
                // .see-all öğeleri ekran okuyucuda kafa karışıklığı ve odak kaybına yol açıyor.
                // Bunları AT'den gizle (aria-hidden) VE içlerindeki linkleri tab sırasından çıkar (tabindex=-1).
                // Görsel mobil işlev (tıklama) korunur; sadece ekran okuyucu/klavye odağından kaldırılır.
                function hideMenuGoBackFromSR() {
                    var items = document.querySelectorAll('.go-back, .see-all');
                    for (var i = 0; i < items.length; i++) {
                        var li = items[i];
                        if (li.getAttribute('data-sr-hidden') === 'true') continue;
                        li.setAttribute('aria-hidden', 'true');
                        var links = li.querySelectorAll('a');
                        for (var j = 0; j < links.length; j++) {
                            links[j].setAttribute('tabindex', '-1');
                        }
                        li.setAttribute('data-sr-hidden', 'true');
                    }
                }
                // Accessibility: Video kartlarındaki dekoratif oynat-ikonu overlay'i (.video-player_container)
                // boş span'ler + font-icon içeriyor; bazı ekran okuyucularda "boş" alan olarak okunuyor.
                // Bunu AT'den gizle. Linkin erişilebilir adı zaten .card-text (video başlığı) olur.
                // (Thumbnail img'leri zaten alt="" aria-hidden; emin olmak için onları da gizle.)
                function hideVideoCardDecorations() {
                    // Yalnızca dekoratif oynat-ikonu overlay'i gizlenir; anlamlı alt'lı video
                    // thumbnail'leri (diğer sayfalarda alt="video başlığı") ETKİLENMEZ.
                    var els = document.querySelectorAll('.video-player_container, .video-player_icon');
                    for (var i = 0; i < els.length; i++) {
                        if (els[i].getAttribute('aria-hidden') !== 'true') {
                            els[i].setAttribute('aria-hidden', 'true');
                        }
                    }
                }
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', setIframeTitles);
                    document.addEventListener('DOMContentLoaded', fixHeadingOrder);
                    document.addEventListener('DOMContentLoaded', fixH1Hierarchy);
                    document.addEventListener('DOMContentLoaded', addCaptionsToYouTube);
                    document.addEventListener('DOMContentLoaded', hideMenuGoBackFromSR);
                    document.addEventListener('DOMContentLoaded', hideVideoCardDecorations);
                } else {
                    setIframeTitles();
                    fixHeadingOrder();
                    fixH1Hierarchy();
                    addCaptionsToYouTube();
                    hideMenuGoBackFromSR();
                    hideVideoCardDecorations();
                }
            })();
        </script>
    </body>
</html>
