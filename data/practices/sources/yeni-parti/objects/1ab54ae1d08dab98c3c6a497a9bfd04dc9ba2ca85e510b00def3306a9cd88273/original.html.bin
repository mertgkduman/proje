"},{"@type":"SiteNavigationElement","name":"Ayd\u0131n Namaz Vakitleri","url":"https:\/\/www.aydinpost.com\/aydin-namaz-vakitleri","@id":"https:\/\/www.aydinpost.com\/aydin-namaz-vakitleri"},{"@type":"SiteNavigationElement","name":"Puan Durumu ve Fikst\u00fcr","url":"https:\/\/www.aydinpost.com\/futbol\/super-lig-puan-durumu-ve-fikstur","@id":"https:\/\/www.aydinpost.com\/futbol\/super-lig-puan-durumu-ve-fikstur"}]}</script>

<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"Thing","@id":"https:\/\/www.aydinpost.com","name":"Haberler"}},{"@type":"ListItem","position":2,"item":{"@type":"Thing","@id":"https:\/\/www.aydinpost.com\/aydin","name":"AYDIN"}},{"@type":"ListItem","position":3,"item":{"@type":"Thing","@id":"https:\/\/www.aydinpost.com\/yeni-parti-germencikte-on-secimin-kazanani-ibrahim-gul-oldu","name":"YEN\u0130 Parti Germencik\u2019te \u00f6n se\u00e7imin kazanan\u0131 \u0130brahim G\u00fcl oldu"}}]}</script>
<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"NewsArticle","headline":"YEN\u0130 Parti Germencik\u2019te \u00f6n se\u00e7imin kazanan\u0131 \u0130brahim G\u00fcl oldu","articleSection":"AYDIN","dateCreated":"2026-09-26T19:57:00+03:00","datePublished":"2026-09-26T19:57:00+03:00","dateModified":"2026-09-26T19:57:00+03:00","wordCount":169,"genre":"news","mainEntityOfPage":{"@type":"WebPage","@id":"https:\/\/www.aydinpost.com\/yeni-parti-germencikte-on-secimin-kazanani-ibrahim-gul-oldu"},"articleBody":"YEN\u0130 Parti Germencik \u0130l\u00e7e Ba\u015fkanl\u0131\u011f\u0131\u2019n\u0131n 1. Ola\u011fan Kongresi \u00f6ncesinde ger\u00e7ekle\u015ftirilen \u00f6n se\u00e7im tamamland\u0131. Germencik 19 May\u0131s D\u00fc\u011f\u00fcn Salonu\u2019nda yap\u0131lan se\u00e7imde \u00fcyeler, il\u00e7e ba\u015fkanl\u0131\u011f\u0131 i\u00e7in yar\u0131\u015fan adaylar aras\u0131nda tercihini yapt\u0131.\r\n\r\nOy verme i\u015flemi saat 08.30\u2019da ba\u015flarken sand\u0131klar 17.00\u2019de kapand\u0131. G\u00fcn boyunca devam eden se\u00e7imde toplam 432 \u00fcye oy kulland\u0131. \u00dc\u00e7 aday\u0131n yar\u0131\u015ft\u0131\u011f\u0131 se\u00e7imde \u0130brahim G\u00fcl 165 oy alarak ilk s\u0131rada yer ald\u0131. G\u00fcl\u2019\u00fc 161 oyla Nazike Cengi takip ederken, Durmu\u015f \u00d6zden 77 oyda kald\u0131.\r\n\r\nSay\u0131m sonucunda 2 oy ge\u00e7ersiz say\u0131l\u0131rken, 1 oy da bo\u015f kullan\u0131ld\u0131. G\u00fcl, rakibi Nazike Cengi\u2019nin 4 oy \u00f6n\u00fcnde se\u00e7imi tamamlad\u0131.\r\n\r\n\u00d6n se\u00e7imi kazanan \u0130brahim G\u00fcl, 5 Ekim Pazartesi g\u00fcn\u00fc ger\u00e7ekle\u015ftirilecek 1. Ola\u011fan \u0130l\u00e7e Kongresi\u2019nde ba\u015fkanl\u0131k i\u00e7in \u00f6ne \u00e7\u0131kan isim oldu. YEN\u0130 Parti Germencik \u0130l\u00e7e Ba\u015fkanl\u0131\u011f\u0131\u2019n\u0131n kongresi yine 19 May\u0131s D\u00fc\u011f\u00fcn Salonu\u2019nda d\u00fczenlenecek.","description":"YEN\u0130 Parti Germencik \u0130l\u00e7e Ba\u015fkanl\u0131\u011f\u0131 i\u00e7in d\u00fczenlenen \u00f6n se\u00e7imde \u00fc\u00e7 aday yar\u0131\u015ft\u0131. 432 \u00fcyenin oy kulland\u0131\u011f\u0131 se\u00e7imde \u0130brahim G\u00fcl, 165 oyla ilk s\u0131rada yer\u2026","inLanguage":"tr-TR","keywords":[],"image":{"@type":"ImageObject","url":"https:\/\/aydinpostcom.teimg.com\/crop\/1280x720\/aydinpost-com\/uploads\/2026\/09\/germencik.png","width":"1280","height":"720","caption":"YEN\u0130 Parti Germencik\u2019te \u00f6n se\u00e7imin kazanan\u0131 \u0130brahim G\u00fcl oldu"},"isFamilyFriendly":"http:\/\/schema.org\/True","isAccessibleForFree":"http:\/\/schema.org\/True","publisher":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.aydinpost.com\/#organization","name":"Ayd\u0131npost","image":"https:\/\/aydinpostcom.teimg.com\/aydinpost-com\/uploads\/2024\/03\/aydinpost-light.svg","logo":{"@type":"ImageObject","url":"https:\/\/aydinpostcom.teimg.com\/aydinpost-com\/uploads\/2024\/03\/aydinpost-light.svg","width":"640","height":"375"}},"author":{"@type":"Person","name":"G\u00fcne\u015f \u00e7elik","url":"https:\/\/www.aydinpost.com\/muhabir\/42\/gunes-celik"},"editor":{"@type":"Person","name":"G\u00fcne\u015f \u00e7elik","url":"https:\/\/www.aydinpost.com\/muhabir\/42\/gunes-celik"},"creator":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.aydinpost.com\/#organization","name":"Ayd\u0131npost","url":"https:\/\/www.aydinpost.com"}}</script>


