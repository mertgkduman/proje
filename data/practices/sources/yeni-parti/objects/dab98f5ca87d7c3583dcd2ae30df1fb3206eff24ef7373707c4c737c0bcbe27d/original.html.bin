<script type="text/javascript">
currentTheme = localStorage.getItem('theme') ? localStorage.getItem('theme') : 'light';
localStorage.setItem('theme', currentTheme);
document.documentElement.setAttribute('data-theme', currentTheme);
document.addEventListener('DOMContentLoaded', function() {
	
	if (currentTheme === 'dark') {
		document.getElementById("theme-mode").classList.remove("dark")
		document.getElementById("theme-mode").classList.add("light");
		document.querySelector('meta[name="theme-color"]').content = '#313235';
	}else{
		document.getElementById("theme-mode").classList.remove("light");
		document.getElementById("theme-mode").classList.add("dark");
		document.querySelector('meta[name="theme-color"]').content = '#fff';
	}
	
	document.getElementById("theme-mode").addEventListener("click", () => {
	const currentTheme = localStorage.getItem("theme");
		if (currentTheme === "light"){
			localStorage.setItem('theme', 'dark');
			document.documentElement.setAttribute('data-theme', 'dark');
			document.querySelector('meta[name="theme-color"]').content = '#313235';
			document.getElementById("theme-mode").classList.remove("dark");
			document.getElementById("theme-mode").classList.add("light");
		}else{
			localStorage.setItem('theme', 'light');
			document.documentElement.setAttribute('data-theme', 'light');
			document.querySelector('meta[name="theme-color"]').content = '#fff';
			document.getElementById("theme-mode").classList.remove("light")
			document.getElementById("theme-mode").classList.add("dark");
		}
	});
});
</script>
