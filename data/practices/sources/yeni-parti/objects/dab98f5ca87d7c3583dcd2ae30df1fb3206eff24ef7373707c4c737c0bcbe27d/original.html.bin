<script>
(function(){
	var durum = 'yok', bekleyen = null, aktif = null;
	function yukle(geri){
		if(durum === 'hazir'){ geri(); return; }
		bekleyen = geri;
		if(durum === 'yukleniyor') return;
		durum = 'yukleniyor';
		var s = document.createElement('script');
		s.src = 'https://code.responsivevoice.org/responsivevoice.js?key=wkeyt3Gh';
		s.onload = function(){
			if(document.readyState !== 'loading') responsiveVoice.init();
			durum = 'hazir';
			if(bekleyen){ var f = bekleyen; bekleyen = null; f(); }
		};
		s.onerror = function(){ durum = 'yok'; bekleyen = null; if(aktif) goster(aktif, 'play', 'Sesli Dinle', 'play'); };
		document.head.appendChild(s);
	}
	function goster(kutu, sinif, yazi, ikon){
		kutu.className = sinif;
		kutu.firstElementChild.innerHTML = '<i class="fa fa-' + ikon + '"></i> ' + yazi;
	}
	document.addEventListener('click', function(e){
		var a = e.target.closest('.play > a, .pause > a, .resume > a');
		if(!a || !a.closest('.dh-detay-araclar')) return;
		e.preventDefault();
		var kutu = a.parentNode;
		if(kutu.classList.contains('pause')){ if(durum === 'hazir'){ responsiveVoice.pause(); goster(kutu, 'resume', 'Devam Et', 'play'); } return; }
		if(kutu.classList.contains('resume')){ responsiveVoice.resume(); goster(kutu, 'pause', 'Durdur', 'pause'); return; }
		var makale = a.closest('article') || document;
		// Haber metnine araya reklam girmis olabilir (get_post_ads): betik/stil/reklam kutulari okunmaz
		var metin = [makale.querySelector('h1'), makale.querySelector('.dh-detay-spot'), makale.querySelector('.dh-detay-metin')]
			.map(function(p){
				if(!p) return '';
				var kopya = p.cloneNode(true);
				kopya.querySelectorAll('script,style,noscript,template,iframe,ins,.reklam-alani,[data-bik-reklam]').forEach(function(x){ x.remove(); });
				return kopya.textContent.replace(/\s+/g, ' ').trim();
			}).filter(Boolean)
			.map(function(t){ return /[.!?…:]$/.test(t) ? t : t + '.'; }).join(' ');
		if(!metin) return;
		if(aktif && aktif !== kutu && aktif.isConnected) goster(aktif, 'play', 'Sesli Dinle', 'play');
		aktif = kutu;
		goster(kutu, 'pause', 'Yükleniyor…', 'pause');
		yukle(function(){
			responsiveVoice.speak(metin, 'Turkish Male', {
				onstart: function(){ if(aktif === kutu) goster(kutu, 'pause', 'Durdur', 'pause'); },
				onend: function(){ if(aktif === kutu && kutu.classList.contains('pause')) goster(kutu, 'play', 'Tekrar Dinle', 'play'); }
			});
		});
	});
})();
</script>
