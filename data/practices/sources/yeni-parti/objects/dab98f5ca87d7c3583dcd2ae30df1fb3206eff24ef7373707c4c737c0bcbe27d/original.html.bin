<dialog class="dh-paylas-pencere" aria-labelledby="dh-paylas-baslik">
  <div class="dh-paylas-ust">
    <h2 id="dh-paylas-baslik">Bu Yazıyı Paylaş</h2>
    <button type="button" class="dh-paylas-kapat" data-dh-pencere-kapat aria-label="Kapat"><i class="fa fa-times"></i></button>
  </div>
  <div class="dh-paylas-aglar">
    <a class="dh-p-facebook" data-ag="facebook" href="#" target="_blank" rel="noopener nofollow" aria-label="Facebook'ta paylaş"><i class="fa fa-facebook-f"></i></a>
    <a class="dh-p-x" data-ag="x" href="#" target="_blank" rel="noopener nofollow" aria-label="X'te paylaş"><i class="fa fa-x-twitter"></i></a>
    <a class="dh-p-whatsapp" data-ag="whatsapp" href="#" target="_blank" rel="noopener nofollow" aria-label="WhatsApp'ta paylaş"><i class="fa fa-whatsapp"></i></a>
    <a class="dh-p-telegram" data-ag="telegram" href="#" target="_blank" rel="noopener nofollow" aria-label="Telegram'da paylaş"><i class="fa fa-telegram"></i></a>
  </div>
  <label class="dh-paylas-etiket" for="dh-paylas-link">veya linki kopyala</label>
  <div class="dh-paylas-kopya">
    <input id="dh-paylas-link" type="text" readonly />
    <button type="button" data-dh-kopyala aria-label="Linki kopyala"><i class="fa fa-copy"></i></button>
  </div>
</dialog>
<script>
(function(){
  var pencere = document.querySelector('.dh-paylas-pencere'), cubuk = document.querySelector('[data-dh-okuma]');
  function aktif(){ return document.querySelector('.dh-detay.active') || document.querySelector('.dh-detay'); }
  function adresler(url, baslik){
    var u = encodeURIComponent(url), b = encodeURIComponent(baslik);
    return { facebook: 'https://www.facebook.com/sharer/sharer.php?u=' + u, x: 'https://twitter.com/intent/tweet?text=' + b + '&url=' + u, whatsapp: 'https://api.whatsapp.com/send?text=' + b + '%20' + u, telegram: 'https://t.me/share/url?url=' + u + '&text=' + b };
  }
  function kopyalandi(dugme){
    dugme.innerHTML = '<i class="fa fa-check"></i>';
    setTimeout(function(){ dugme.innerHTML = '<i class="fa fa-copy"></i>'; }, 1600);
  }
  document.addEventListener('click', function(e){
    var hedef;
    if((hedef = e.target.closest('[data-dh-paylas]'))){
      var makale = hedef.hasAttribute('data-url') ? hedef : hedef.closest('.dh-detay') || aktif();
      if(!makale || !pencere.showModal) return;
      e.preventDefault();
      var a = adresler(makale.dataset.url, makale.dataset.baslik);
      pencere.querySelectorAll('[data-ag]').forEach(function(l){ l.href = a[l.dataset.ag]; });
      pencere.querySelector('input').value = makale.dataset.url;
      pencere.showModal();
    }else if((hedef = e.target.closest('[data-ag="facebook"],[data-ag="x"]'))){
      e.preventDefault();
      window.open(hedef.href, 'paylas', 'width=626,height=560');
    }else if((hedef = e.target.closest('[data-dh-kopyala]'))){
      var alan = pencere.querySelector('input');
      if(navigator.clipboard && window.isSecureContext){ navigator.clipboard.writeText(alan.value).then(function(){ kopyalandi(hedef); }); }
      else { alan.select(); document.execCommand('copy'); kopyalandi(hedef); }
    }else if(e.target.closest('[data-dh-pencere-kapat]')){
      pencere.close();
    }else if(e.target === pencere){
      var r = pencere.getBoundingClientRect();
      if(e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) pencere.close();
    }else if((hedef = e.target.closest('[data-dh-boyut]'))){
      var metin = (hedef.closest('.dh-detay') || aktif() || document).querySelector('.dh-detay-metin');
      if(!metin) return;
      var boyut = parseFloat(getComputedStyle(metin).fontSize) + 2 * hedef.dataset.dhBoyut;
      if(boyut >= 13 && boyut <= 30) metin.style.fontSize = boyut + 'px';
    }else if((hedef = e.target.closest('[data-dh-yorum-git]'))){
      var yorumlar = aktif() && aktif().querySelector('.dh-yorumlar');
      if(yorumlar){ e.preventDefault(); yorumlar.scrollIntoView({ behavior: 'smooth' }); }
    }
  });
  if(!cubuk) return;
  var cubukBaslik = cubuk.querySelector('.dh-okuma-baslik'), cubukYorum = cubuk.querySelector('[data-dh-yorum-git]');
  var bekliyor = false;
  function cubukGuncelle(){
    bekliyor = false;
    var makale = aktif();
    if(!makale) return;
    var kutu = makale.getBoundingClientRect(), baslik = makale.querySelector('.dh-detay-baslik');
    var acik = (baslik ? baslik.getBoundingClientRect().bottom : kutu.top) < 0 && kutu.bottom > 120;
    if(acik !== cubuk.classList.contains('dh-acik')){
      cubuk.classList.toggle('dh-acik', acik);
      cubuk.setAttribute('aria-hidden', acik ? 'false' : 'true');
      cubuk.querySelectorAll('button,a').forEach(function(d){ d.tabIndex = acik ? 0 : -1; });
    }
    if(!acik) return;
    if(cubukBaslik.textContent !== makale.dataset.baslik) cubukBaslik.textContent = makale.dataset.baslik;
    cubukYorum.hidden = makale.dataset.yorum === undefined;
    cubukYorum.lastChild.textContent = makale.dataset.yorum || '0';
    cubuk.style.setProperty('--ilerleme', Math.min(1, Math.max(0, -kutu.top / Math.max(1, kutu.height - innerHeight))).toFixed(3));
  }
  addEventListener('scroll', function(){ if(!bekliyor){ bekliyor = true; requestAnimationFrame(cubukGuncelle); } }, { passive: true });
})();
</script>
