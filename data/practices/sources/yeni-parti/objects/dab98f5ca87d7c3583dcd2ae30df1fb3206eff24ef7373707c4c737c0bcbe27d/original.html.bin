<script>
window.dhKaydirici = function(oklar, liste, otomatik){
	if(!oklar || !liste || !liste.firstElementChild) return;
	var dugmeler = oklar.querySelectorAll('button'), hedef = null, bekleme, dur = false;
	function durum(){
		oklar.hidden = liste.scrollWidth - liste.clientWidth <= 2;
		dugmeler[0].disabled = liste.scrollLeft <= 2;
		dugmeler[1].disabled = liste.scrollLeft >= liste.scrollWidth - liste.clientWidth - 2;
	}
	function git(yon){
		var adim = liste.firstElementChild.getBoundingClientRect().width + parseFloat(getComputedStyle(liste).columnGap || 0), baz = hedef === null ? liste.scrollLeft : hedef;
		hedef = Math.max(0, Math.min(liste.scrollWidth - liste.clientWidth, (Math.round(baz / adim) + yon) * adim));
		liste.scrollTo({left: hedef, behavior: 'smooth'});
	}
	dugmeler.forEach(function(d){ d.addEventListener('click', function(){ git(+d.getAttribute('data-yon')); }); });
	liste.addEventListener('scroll', function(){ clearTimeout(bekleme); bekleme = setTimeout(function(){ hedef = null; }, 200); durum(); }, {passive: true});
	window.addEventListener('resize', durum);
	durum();
	if(otomatik && !matchMedia('(prefers-reduced-motion: reduce)').matches){
		['mouseenter','focusin','touchstart'].forEach(function(o){ liste.addEventListener(o, function(){ dur = true; }, {passive: true}); });
		['mouseleave','focusout'].forEach(function(o){ liste.addEventListener(o, function(){ dur = false; }); });
		setInterval(function(){
			if(dur || document.hidden || liste.scrollWidth - liste.clientWidth <= 2) return;
			if(liste.scrollLeft >= liste.scrollWidth - liste.clientWidth - 2){ hedef = null; liste.scrollTo({left: 0, behavior: 'smooth'}); } else git(1);
		}, 4000);
	}
};
</script>
<script>
(function(kap){ dhKaydirici(kap.querySelector('.dh-kaydir-oklar'), kap.querySelector('.dh-takip-liste')); })(document.currentScript.parentNode);
</script>
