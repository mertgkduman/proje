                <a class="dropdown-item" href="javascript:void(0)" onclick="copyURL(event, 'https://www.halk54.com/engin-ozkoctan-sakaryadaki-il-baskanligi-secimine-iliskin-aciklama')" rel="noreferrer nofollow noopener external" title="Bağlantıyı Kopyala">
                    <i class="fas fa-link text-dark me-2"></i>
