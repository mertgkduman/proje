<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"Thing","@id":"https:\/\/www.halk54.com","name":"Haberler"}},{"@type":"ListItem","position":2,"item":{"@type":"Thing","@id":"https:\/\/www.halk54.com\/siyaset","name":"S\u0130YASET"}},{"@type":"ListItem","position":3,"item":{"@type":"Thing","@id":"https:\/\/www.halk54.com\/engin-ozkoctan-sakaryadaki-il-baskanligi-secimine-iliskin-aciklama","name":"Engin \u00d6zko\u00e7\u2019tan Sakarya\u2019daki il ba\u015fkanl\u0131\u011f\u0131 se\u00e7imine ili\u015fkin a\u00e7\u0131klama"}}]}</script>
<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"NewsArticle","headline":"Engin \u00d6zko\u00e7\u2019tan Sakarya\u2019daki il ba\u015fkanl\u0131\u011f\u0131 se\u00e7imine ili\u015fkin a\u00e7\u0131klama","articleSection":"S\u0130YASET","dateCreated":"2026-10-18T20:23:00+03:00","datePublished":"2026-10-18T20:23:00+03:00","dateModified":"2026-10-18T20:40:32+03:00","wordCount":220,"genre":"news","mainEntityOfPage":{"@type":"WebPage","@id":"https:\/\/www.halk54.com\/engin-ozkoctan-sakaryadaki-il-baskanligi-secimine-iliskin-aciklama"},"articleBody":"Yeni Parti Sakarya \u0130l Ba\u015fkanl\u0131\u011f\u0131 i\u00e7in 16 il\u00e7ede ger\u00e7ekle\u015ftirilen \u00f6n se\u00e7imde Ecevit Kele\u015f ile Selda Sezgin yar\u0131\u015ft\u0131. Kesin olmayan sonu\u00e7lara g\u00f6re \u00f6n se\u00e7imi Sezgin kazand\u0131. 7266 ki\u015fi oy kullandd\u0131\u011f\u0131 se\u00e7im sonucunda Selda Sezgin 3886 oy al\u0131rken Ecevit Kele\u015f ise 3359 oyda kald\u0131. Kurucu \u0130l Ba\u015fkan\u0131 O\u011fuz Can Curo\u011flu\u2019nun aday olmad\u0131\u011f\u0131 s\u00fcre\u00e7te Cengiz \u00c7i\u00e7ek ve \u0130smail K\u0131l\u0131\u00e7, Sezgin lehine yar\u0131\u015ftan \u00e7ekilmi\u015fti.\r\n\r\nSe\u00e7im sonu\u00e7lar\u0131n\u0131n en dikkat \u00e7eken yanlar\u0131ndan biriyse Sezgin'in CHP'den ayr\u0131larak Yeni Parti saflar\u0131na kat\u0131lan Sakarya eski Milletvekili Engin \u00d6zko\u00e7'un destekledi\u011fi bir isim olmas\u0131yd\u0131.\r\n\r\nSelda Sezgin'in kazanmas\u0131n\u0131 de\u011ferlendiren \u00d6zko\u00e7: \"Gen\u00e7lerin \u00f6n\u00fcn\u00fcn a\u00e7\u0131lmas\u0131 ad\u0131na \u00e7ok sevindirici bir sonu\u00e7 oldu. Yeni Parti'de gencecik p\u0131r\u0131l p\u0131r\u0131l bir karde\u015fimizin \u0130l Ba\u015fkan\u0131 olmas\u0131, \u015fehrimizi temsil etmesi son derece \u00f6nemli. \u0130n\u015fallah bu sonu\u00e7, se\u00e7imlere de yans\u0131r ve Sakarya da hak etti\u011fi yeri iktidar olarak al\u0131r. Eme\u011fi ge\u00e7en herkese te\u015fekk\u00fcr ediyorum\u201d dedi.\r\n\r\n\r\nKamuoyunda se\u00e7im s\u00fcrecinde destekledi\u011fi bir isim oldu\u011fu y\u00f6n\u00fcndeki de\u011ferlendirmelerin hat\u0131rlat\u0131lmas\u0131 \u00fczerine \u00d6zko\u00e7, \u201cEvet ben Selda Han\u0131m'\u0131 destekledim ve bu sonu\u00e7tan mutluyum\" ifadelerini kulland\u0131.","description":"CHP'den ayr\u0131larak Yeni Parti saflar\u0131na kat\u0131lan Sakarya eski Milletvekili Engin \u00d6zko\u00e7, Sakarya'da \u0130l Ba\u015fkanl\u0131\u011f\u0131 se\u00e7imini Selda Sezgin'in kazanmas\u0131n\u0131\u2026","inLanguage":"tr-TR","keywords":[],"image":{"@type":"ImageObject","url":"https:\/\/halk54com.teimg.com\/crop\/1280x720\/halk54-com\/uploads\/2026\/10\/b-1.jpg","width":"1280","height":"720","caption":"Engin \u00d6zko\u00e7\u2019tan Sakarya\u2019daki il ba\u015fkanl\u0131\u011f\u0131 se\u00e7imine ili\u015fkin a\u00e7\u0131klama"},"isFamilyFriendly":"http:\/\/schema.org\/True","isAccessibleForFree":"http:\/\/schema.org\/True","publisher":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.halk54.com\/#organization","name":"halk54.com","image":"https:\/\/halk54com.teimg.com\/halk54-com\/uploads\/2023\/08\/halk54-4.svg","logo":{"@type":"ImageObject","url":"https:\/\/halk54com.teimg.com\/halk54-com\/uploads\/2023\/08\/halk54-4.svg","width":"640","height":"375"}},"author":{"@type":"Person","name":"Halk54.com Edit\u00f6r","url":"https:\/\/www.halk54.com\/muhabir\/35\/halk54com-editor"},"editor":{"@type":"Person","name":"Halk54.com Edit\u00f6r","url":"https:\/\/www.halk54.com\/muhabir\/35\/halk54com-editor"},"creator":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.halk54.com\/#organization","name":"halk54.com","url":"https:\/\/www.halk54.com"}}</script>


