<style id="wp-custom-css">/* =========================================================
   CANLI YAYIN - Sarı / Siyah Özel Menü Butonu
========================================================= */

nav a[href*="canli-yayin"] {
  background: linear-gradient(45deg, #FFD700, #FFC107);
  color: #000 !important;
  padding: 4px 10px;
  border-radius: 9px;
  font-weight: 700;
  font-size: 14px;
  line-height: 1.2;
  height: auto !important;
  min-height: unset !important;
  display: inline-block;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  box-shadow: 0 0 12px rgba(255, 193, 7, 0.7);
  animation: canliTitre 1s infinite alternate;
}

@keyframes canliTitre {
  from {
    box-shadow: 0 0 5px rgba(255, 193, 7, 0.5);
  }
  to {
    box-shadow: 0 0 15px rgba(255, 193, 7, 1);
  }
}

nav a[href*="canli-yayin"]:hover {
  background: linear-gradient(45deg, #FFC107, #FFE082);
  color: #000 !important;
  transform: scale(1.05);
  box-shadow: 0 0 20px rgba(255, 193, 7, 0.9);
}

nav a[href*="canli-yayin"]::before {
  content: "📡 ";
  animation: canliBlink 1s infinite;
}

@keyframes canliBlink {
  0% { opacity: 1; }
  50% { opacity: 0.3; }
  100% { opacity: 1; }
}

/* =========================================================
   E-GAZETE - Mavi / Beyaz Özel Menü Butonu
========================================================= */

nav a[href*="yayinlar"] {
  background: linear-gradient(45deg, #007BFF, #0056b3);
  color: #fff !important;
  padding: 4px 10px;
  border-radius: 9px;
  font-weight: bold;
  font-size: 14px;
  line-height: 1.2;
  height: auto !important;
  min-height: unset !important;
  display: inline-block;
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  box-shadow: 0 0 12px rgba(0, 123, 255, 0.5);
  animation: egazeteTitre 1s infinite alternate;
}

@keyframes egazeteTitre {
  from {
    box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
  }
  to {
    box-shadow: 0 0 15px rgba(0, 123, 255, 1);
  }
}

nav a[href*="yayinlar"]:hover {
  background: linear-gradient(45deg, #0056b3, #3399ff);
  transform: scale(1.05);
  box-shadow: 0 0 20px rgba(0, 123, 255, 0.8);
}

nav a[href*="yayinlar"]::before {
  content: "📰 ";
  animation: egazeteBlink 1s infinite;
}

@keyframes egazeteBlink {
  0% { opacity: 1; }
  50% { opacity: 0.3; }
  100% { opacity: 1; }
}

/* =========================================================
   ME DİGİTAL Rozeti
========================================================= */

#liveWidget::after {
  content: "ME DİGİTAL";
  position: absolute;
  top: 0;
  right: 0;
  color: #ffffff;
  font-size: 6px;
  font-weight: bold;
  padding: 3px 5px;
  z-index: 10000;
}</style>
