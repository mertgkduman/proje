var checkDots = setInterval(function() {
    var dots = document.querySelector('#MansetSlider .owl-dots');
    if(dots) {
        // !important ile override ediyoruz
        dots.style.setProperty('text-align', 'center', 'important');
        clearInterval(checkDots);
    }
}, 100);
</script>

