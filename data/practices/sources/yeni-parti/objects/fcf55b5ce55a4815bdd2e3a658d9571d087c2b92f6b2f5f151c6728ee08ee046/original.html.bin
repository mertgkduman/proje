					<script>
					document.querySelectorAll('.emoji').forEach(el => {
						el.addEventListener('click', function() {
							const box = this.closest('.emoji-box');
							const id = box.dataset.id;
							const tur = box.dataset.tur;
							const tepki = this.dataset.tepki;

							fetch('tema/genel/ajax/tepki_kaydet.php', {
								method: 'POST',
								headers: {'Content-Type': 'application/x-www-form-urlencoded'},
								body: `icerik_id=${id}&icerik_turu=${tur}&tepki=${tepki}`
							})
							.then(res => res.json())
							.then(data => {
								if(data.success) {
									for(let t in data.sayilar) {
										document.getElementById(t).innerText = data.sayilar[t];
									}
									if(data.message === 'added' || data.message === 'changed') {
										document.querySelectorAll('.emoji').forEach(e => e.classList.remove('active'));
										this.classList.add('active');
									} else {
										this.classList.remove('active');
									}
								}
							});
						});
					});
					</script>

					
						
