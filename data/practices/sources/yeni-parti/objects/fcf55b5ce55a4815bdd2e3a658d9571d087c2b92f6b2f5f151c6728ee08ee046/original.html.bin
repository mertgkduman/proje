<div id="sonraki-haber-container"></div>
<script>
$(document).ready(function() {
    let currentId = 3568;
    let isLoading = false;
    let hasMore = true;

    function throttle(func, limit) {
        let inThrottle;
        return function(...args) {
            if (!inThrottle) {
                func(...args);
                inThrottle = true;
                setTimeout(() => inThrottle = false, limit);
            }
        };
    }

    function loadNextHaber() {
        if (isLoading || !hasMore) return;

        isLoading = true;
        $('#sonraki-haber-container').empty().html('<div class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x"></i></div>');

        $.ajax({
            url: 'tema/genel/ajax/sonraki-haber.php',
            type: 'GET',
            data: {
                current_id: currentId,
                kategori: '63'
            },
            success: function(response) {
                if (response.trim() !== '') {
                    $('#sonraki-haber-container').html(response).hide().fadeIn(500);
                    let newId = $('#sonraki-haber-container').find('[data-haber-id]').data('haber-id');
                    let newTitle = $('#sonraki-haber-container').find('[data-haber-title]').data('haber-title');
                    if (newId && newTitle) {
                        currentId = newId;
                        history.pushState(null, null, 'haber/' + $('#sonraki-haber-container').find('[data-haber-seo]').data('haber-seo') + '');
                        document.title = newTitle;
                    } else {
                        hasMore = false;
                        $('#sonraki-haber-container').html('');
                    }
                } else {
                    hasMore = false;
                    $('#sonraki-haber-container').html('');
                }
                isLoading = false;
                setTimeout(() => $(window).trigger('scroll'), 50);
            },
            error: function(xhr, status, error) {
                $('#sonraki-haber-container').html('<div class="text-center py-4">Haber yüklenirken bir hata oluştu: ' + error + '</div>');
                isLoading = false;
                hasMore = false;
            }
        });
    }

    function isAtBottom() {
        const scrollTop = $(window).scrollTop();
        const windowHeight = $(window).height();
        const documentHeight = $(document).height();
        const isBottom = scrollTop + windowHeight >= documentHeight - 10 ||
                         (window.scrollY >= (document.documentElement.scrollHeight - window.innerHeight - 10));
        return isBottom;
    }

    $(window).on('scroll', throttle(function() {
        if (isAtBottom() && !isLoading && hasMore) {
            loadNextHaber();
        }
    }, 100));

    if (isAtBottom() && !isLoading && hasMore) {
        loadNextHaber();
    }

    const observer = new MutationObserver(function(mutations) {
        mutations.forEach(function(mutation) {
            if (mutation.addedNodes.length && isAtBottom() && !isLoading && hasMore) {
                loadNextHaber();
            }
        });
    });

    observer.observe(document.getElementById('sonraki-haber-container'), {
        childList: true,
        subtree: true
    });

    $(window).on('scroll', function() {
        if (isAtBottom() && !isLoading && hasMore) {
            window.scrollTo(0, $(window).scrollTop() - 1);
            setTimeout(() => window.scrollTo(0, $(window).scrollTop() + 1), 10);
        }
    });
});
</script>
	
