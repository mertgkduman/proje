	<script src="tema/genel/vendor/OwlCarousel/owl.carousel.min.js" type="text/javascript"></script>
	
	<script>
/*
  MOBİLDE çalışır.
  href="#" olan ve hemen arkasında <ul> bulunan
  menü başlıklarını (KATEGORİLER, SERVİSLER vb.)
  tıklanınca açıp kapatır.
*/

document.addEventListener("DOMContentLoaded", function () {

    if (window.innerWidth > 991) return; // sadece mobil

    var links = document.querySelectorAll('a[href="#"]');

    links.forEach(function(link) {

        link.addEventListener('click', function(e) {

            var next = link.nextElementSibling;

            // Sadece alt menüsü varsa müdahale et
            if (next && next.tagName === 'UL') {
                e.preventDefault(); // # zıplamasını engelle

                // toggle
                if (next.style.display === 'block') {
                    next.style.display = 'none';
                } else {
                    next.style.display = 'block';
                }
            }

        });

    });

});
</script>

<script>
/*
====================================================
KÖŞE YAZARLARI ALANI – YAZAR ÖNCELİĞİ
----------------------------------------------------
1) "Önder Yıldırımcan" her zaman EN BAŞTA gösterilir.
2) Owl Carousel aktifse kendi sahası (owl-stage)
   içinde sıralama yapılır.
3) Mobilde kullanılan destroy / listeleme
   JS'i ile çakışmaz.
----------------------------------------------------
Not: Bu kod DOM yüklendikten sonra çalışır.
====================================================
*/

document.addEventListener("DOMContentLoaded", function () {

    var $carousel = $('.ne-carousel');
    var $stage = $carousel.find('.owl-stage');

    /* Eğer Owl çalışıyorsa stage içinde işlem yap */
    var $container = $stage.length ? $stage : $carousel;

    /* Clone olmayan gerçek item'lar */
    var $items = $container.find('.owl-item:not(.cloned) .hover-show-play-btn');

    /* Önder Yıldırımcan olanı bul */
    var $onder = $items.filter(function () {
        return $(this).find('.yazarlar a').text().trim() === 'Önder Yıldırımcan';
    }).first();

    /* Kendi owl-item'ı ile birlikte başa al */
    if ($onder.length) {
        var $wrapper = $onder.closest('.owl-item');
        $container.prepend($wrapper.length ? $wrapper : $onder);
    }

});
</script>

<script>
/*
====================================================
KÖŞE YAZARLARI ALANI ÖZEL DÜZENLEME
----------------------------------------------------
1) Mobilde Owl Carousel devre dışı bırakılır
   ve köşe yazıları alt alta listelenir.
2) "Önder Yıldırımcan" mobil listede
   SADECE 1 KEZ ve EN BAŞTA gösterilir.
3) Masaüstü görünümüne ve slider yapısına
   KESİNLİKLE dokunulmaz.
----------------------------------------------------
Not: Bu kod DOM yüklendikten sonra çalışır.
====================================================
*/

document.addEventListener("DOMContentLoaded", function () {

    /* === SADECE MOBİL === */
    if (window.innerWidth > 768) return;

    var $carousel = $('.ne-carousel');

    /* Owl Carousel aktifse mobilde kapat */
    if ($carousel.hasClass('owl-loaded')) {
        $carousel.trigger('destroy.owl.carousel');
    }

    /* Clone edilmiş item'ları TAMAMEN kaldır */
    $carousel.find('.owl-item.cloned').remove();

    /* Owl sarmalayıcılarını kaldır */
    $carousel
        .removeClass('owl-carousel owl-loaded owl-theme')
        .find('.owl-stage-outer, .owl-stage')
        .children()
        .unwrap()
        .unwrap();

    /* owl-item class'larını temizle */
    $carousel.find('.owl-item').removeClass('owl-item');

    /* Oklar ve noktaları kaldır */
    $carousel.find('.owl-nav, .owl-dots').remove();

    /* Önder Yıldırımcan'ı TEK KOPYA olarak başa al */
    var $onder = $carousel.find('.hover-show-play-btn').filter(function () {
        return $(this).find('.yazarlar a').text().trim() === 'Önder Yıldırımcan';
    }).first();

    if ($onder.length) {
        $carousel.prepend($onder);
    }

});
</script>

<script>
/*
