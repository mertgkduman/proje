										<div class="leave-comments mb-40 mt-40">
						<h2 class="title-semibold-dark size-xl mb-20">Yorum Gönder</h2>
						<form id="yorum-form" method="POST">
							<input type="hidden" name="tip" value="haber">
							<input type="hidden" name="icerik_id" value="3568">
							<input type="hidden" name="parent_id" id="parent_id" value="0">

							<div id="cevap-bilgi" class="mb-3" style="display:none;">
								<div class="alert alert-info d-flex justify-content-between align-items-center">
									<span id="cevap-kime"></span>
									<button type="button" id="cevap-iptal" class="btn btn-sm btn-danger"><i class="fas fa-times"></i></button>
								</div>
							</div>

							<div class="row">
								<div class="col-md-6 col-sm-12">
									<div class="form-group">
										<input name="isim" placeholder="Adınız Soyadınız *" class="form-control" type="text" required>
									</div>
								</div>
								<div class="col-md-6 col-sm-12">
									<div class="form-group">
										<input name="email" placeholder="E-Posta Adresiniz" class="form-control" type="email">
									</div>
								</div>
								<div class="col-12">
									<div class="form-group">
										<textarea name="yorum" placeholder="Yorumunuz *" class="textarea form-control" rows="8" required></textarea>
									</div>
								</div>
								<div class="col-12">
									<div class="form-group mb-none">
										<button type="submit" class="btn-ftg-ptp-45">Yorumu Gönder</button>
									</div>
								</div>
							</div>
						</form>
					</div>
					
					<div class="comments-area">
						<h2 class="title-semibold-dark size-xl border-bottom mb-20 pb-20">Yorumlar</h2>
						<div id="yorumlar"></div>
					</div>

					<script>
					$(document).ready(function() {
						let tip = $("input[name='tip']").val();
						let icerik_id = $("input[name='icerik_id']").val();

						function yorumlariYukle() {
							$("#yorumlar").load("tema/genel/ajax/yorumlar.php?tip=" + tip + "&icerik_id=" + icerik_id);
						}

						yorumlariYukle();

						$("#yorum-form").on("submit", function(e) {
							e.preventDefault();
							$.post("tema/genel/ajax/yorum-ekle.php", $(this).serialize(), function(cevap) {
								 if (cevap.trim() === "ok") {
									 
									Swal.fire({
										type: 'success',
										title: 'Yorum alındı!',
										text: 'Yorumunuz başarıyla gönderildi. Onay sonrası yayınlanacaktır.',
										confirmButtonText: 'Tamam'
									});

									$("#yorum-form")[0].reset();
									$("#parent_id").val("0");
									$("#cevap-bilgi").hide();
									yorumlariYukle();
								} else {
									 Swal.fire({
										type: 'warning',
										title: 'Hata.!',
										text: cevap,
										confirmButtonText: 'Tamam'
									});

								}
							});
						});

						$(document).on("click", ".cevapla-btn", function(e) {
							e.preventDefault();
							let yorumId = $(this).data("id");
							let yorumAd = $(this).data("ad");

							$("#parent_id").val(yorumId);
							$("#cevap-kime").html(`<strong>${yorumAd}</strong> adlı kullanıcıya cevap yazıyorsunuz`);
							$("#cevap-bilgi").show();
							$('html, body').animate({
								scrollTop: $("#yorum-form").offset().top - 100
							}, 400);
						});

						$("#cevap-iptal").on("click", function() {
							$("#parent_id").val("0");
							$("#cevap-bilgi").hide();
						});
					});
					</script>
									</div>
				
