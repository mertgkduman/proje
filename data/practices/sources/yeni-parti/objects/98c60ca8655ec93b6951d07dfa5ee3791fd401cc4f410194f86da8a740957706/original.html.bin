<script>
(function(){
	var kok = document.documentElement, panel = document.getElementById('dh-panel'), perde = panel.previousElementSibling, sonOdak = null;
	var dugmeler = document.querySelectorAll('[aria-controls="dh-panel"]');
	function durum(acik){ dugmeler.forEach(function(d){ d.setAttribute('aria-expanded', acik ? 'true' : 'false'); }); }
	function ac(arama){
		sonOdak = document.activeElement;
		perde.hidden = false;
		panel.removeAttribute('inert');
		panel.setAttribute('aria-hidden', 'false');
		void panel.offsetWidth;
		kok.classList.add('dh-panel-acik');
		durum(true);
		var hedef = arama ? panel.querySelector('.overlay-input') : panel.querySelector('.dh-panel-kapat');
		if(hedef) hedef.focus({preventScroll:true});
	}
	function kapat(){
		kok.classList.remove('dh-panel-acik');
		panel.setAttribute('aria-hidden', 'true');
		panel.setAttribute('inert', '');
		durum(false);
		setTimeout(function(){ if(!kok.classList.contains('dh-panel-acik')) perde.hidden = true; }, 300);
		if(sonOdak && sonOdak.focus) sonOdak.focus({preventScroll:true});
	}
	document.querySelectorAll('.dh-menu-ac').forEach(function(d){ d.addEventListener('click', function(){ ac(false); }); });
	document.querySelectorAll('.dh-arama-ac').forEach(function(d){ d.addEventListener('click', function(){ ac(true); }); });
	document.querySelectorAll('[data-dh-kapat]').forEach(function(d){ d.addEventListener('click', kapat); });
	document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && kok.classList.contains('dh-panel-acik')) kapat(); });
	panel.querySelector('[data-dh-tema]').addEventListener('click', function(){ document.getElementById('theme-mode').click(); });
	// Arama: haber_arama.php captcha dogrulamasindan sonra site geneli d_recaptcha cerezini koyar; cerez varsa ikinci kez captcha sorulmaz, dogrudan aranir
	var aramaDugme = panel.querySelector('.overlay-search .button'), aramaAlan = panel.querySelector('.overlay-input');
	function aramaDogrulandi(){ return /(?:^|;\s*)d_recaptcha=/.test(document.cookie); }
	function aramaGit(){ var k = aramaAlan.value.trim(); if(k) location.href = '/arama/' + encodeURIComponent(k) + '/'; else aramaAlan.focus(); }
	['pointerdown', 'focusin'].forEach(function(olay){ aramaDugme.parentNode.addEventListener(olay, function(e){ if(e.target === aramaDugme && aramaDogrulandi()) e.stopPropagation(); }, true); });
	aramaDugme.addEventListener('click', function(e){ e.preventDefault(); if(aramaDogrulandi()) aramaGit(); });
	panel.querySelector('.overlay-search-form').addEventListener('submit', function(e){ if(aramaDogrulandi()){ e.preventDefault(); aramaGit(); }else if(this.getAttribute('action').indexOf('/arama/') !== 0){ e.preventDefault(); aramaDugme.focus(); } });
	var menu = document.querySelector('.dh-menu'), liste = menu.querySelector('.dh-menu-liste'), secili = liste.querySelector('[aria-current="page"]');
	if(secili) liste.scrollLeft = secili.offsetLeft - (liste.clientWidth - secili.offsetWidth) / 2;
	if('IntersectionObserver' in window){
		var isaret = document.createElement('div');
		menu.parentNode.insertBefore(isaret, menu);
		new IntersectionObserver(function(k){ menu.classList.toggle('dh-yapisik', !k[0].isIntersecting && k[0].boundingClientRect.top < 0); }).observe(isaret);
	}
})();
</script>
