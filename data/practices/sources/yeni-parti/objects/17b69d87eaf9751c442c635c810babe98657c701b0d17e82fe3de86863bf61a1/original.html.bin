                <li><a href="https://sanatturk.com/oduller.html" class="block px-8 py-2 text-xs hover:text-brand-red hover:bg-gray-50 transition">Ödüller</a></li>
                <li><a href="https://sanatturk.com/reklam.html" class="block px-8 py-2 text-xs hover:text-brand-red hover:bg-gray-50 transition">Reklam</a></li>
                <li><a href="https://sanatturk.com/iletisim.html" class="block px-8 py-2 text-xs hover:text-brand-red hover:bg-gray-50 transition">İletişim</a></li>
                <li><a href="https://sanatturk.com/kunye.html" class="block px-8 py-2 text-xs hover:text-brand-red hover:bg-gray-50 transition">Künye</a></li>
                <li><a href="https://sanatturk.com/uygulama/" class="flex items-center gap-2 mx-6 mt-3 px-4 py-2.5 rounded text-xs text-white bg-brand-red font-bold"><i class="fas fa-mobile-alt"></i> Mobil Uygulama</a></li>
            </ul>
        </nav>
    </div>
    <script>
        function toggleMenu() {
            var c = document.getElementById('mobile-menu-container');
            var o = document.getElementById('mobile-menu-overlay');
            if (c) c.classList.toggle('open');
            if (o) o.classList.toggle('open');
        }
        function toggleCategoriesMenu(event) {
            if (event) event.stopPropagation();
            var dropdown = document.getElementById('categories-dropdown');
            if (dropdown) dropdown.classList.toggle('hidden');
        }
        document.addEventListener('click', function(event) {
            var dropdown = document.getElementById('categories-dropdown');
            var wrapper = document.getElementById('categories-dropdown-wrapper');
            if (dropdown && !dropdown.classList.contains('hidden') && wrapper && !wrapper.contains(event.target)) {
                dropdown.classList.add('hidden');
            }
        });
        document.addEventListener('DOMContentLoaded', function() {
            var btn = document.getElementById('menu-btn');
            if (btn) btn.addEventListener('click', toggleMenu);
            var closeBtn = document.getElementById('close-menu-btn');
            if (closeBtn) closeBtn.addEventListener('click', toggleMenu);
            var overlay = document.getElementById('mobile-menu-overlay');
            if (overlay) overlay.addEventListener('click', toggleMenu);
        });
    </script>
</body>
</html>
