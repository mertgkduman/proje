                                                 <div class="card row">
                                                         <div class="title-row black-text orange-round">
                                                                 <h6>İLGİLİNİZİ ÇEKECEK HABERLER</h6>
                                                                 <div>
                                                                         <span></span>
                                                                         <span></span>
                                                                         <span></span>
                                                                 </div>
                                                         </div>
