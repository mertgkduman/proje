<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"Thing","@id":"https:\/\/www.samsungazetesi.com","name":"Haberler"}},{"@type":"ListItem","position":2,"item":{"@type":"Thing","@id":"https:\/\/www.samsungazetesi.com\/samsun-haber","name":"Samsun Haber"}},{"@type":"ListItem","position":3,"item":{"@type":"Thing","@id":"https:\/\/www.samsungazetesi.com\/yeni-parti-samsun-kongresinde-birlik-mesaji-birlikte-yuruyecegiz","name":"Yeni Parti Samsun kongresinde birlik mesaj\u0131: \u201cBirlikte y\u00fcr\u00fcyece\u011fiz\u201d"}}]}</script>
<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"NewsArticle","headline":"Yeni Parti Samsun kongresinde birlik mesaj\u0131: \u201cBirlikte y\u00fcr\u00fcyece\u011fiz\u201d","articleSection":"Samsun Haber","dateCreated":"2026-10-25T11:27:00+03:00","datePublished":"2026-10-25T11:27:00+03:00","dateModified":"2026-10-25T15:45:24+03:00","wordCount":762,"genre":"news","mainEntityOfPage":{"@type":"WebPage","@id":"https:\/\/www.samsungazetesi.com\/yeni-parti-samsun-kongresinde-birlik-mesaji-birlikte-yuruyecegiz"},"articleBody":"Yeni Parti Samsun \u0130l Ba\u015fkanl\u0131\u011f\u0131 1. Ola\u011fan \u0130l Kongresi ger\u00e7ekle\u015ftirildi. Ge\u00e7ti\u011fimiz hafta yap\u0131lan \u00f6n se\u00e7imde Mehmet \u00d6zda\u011f ile Turgay \u00d6z\u00e7elik il ba\u015fkanl\u0131\u011f\u0131 i\u00e7in yar\u0131\u015ft\u0131. \u00d6n se\u00e7imi kazanan Mehmet \u00d6zda\u011f, bug\u00fcn d\u00fczenlenen kongrede tek listeyle delegelerin kar\u015f\u0131s\u0131na \u00e7\u0131kt\u0131.\r\n\r\nKongrede Yeni Parti Amasya Milletvekili Re\u015fat Karag\u00f6z Divan Ba\u015fkanl\u0131\u011f\u0131na se\u00e7ilirken, Avukat Halil G\u00fcnayd\u0131n ve Ay\u015fe \u00d6zdemir ise Divan Ba\u015fkan Yard\u0131mc\u0131s\u0131 oldu. \u00d6nergeler oy birli\u011fiyle kabul edildi.\r\n\r\n\r\n\r\n\u00d6ZDA\u011e: \u201cTARTI\u015eTIKTAN SONRA B\u0130RLE\u015eEMEYEN B\u0130R \u00d6RG\u00dcT\u00dcN \u0130KT\u0130DAR OLMASI \u0130MKANSIZDIR\u201d\r\n\r\nKongrede konu\u015fan Yeni Parti Samsun \u0130l Ba\u015fkan\u0131 Mehmet \u00d6zda\u011f, ge\u00e7en hafta \u00fcyelerin kat\u0131l\u0131m\u0131yla ger\u00e7ekle\u015ftirilen \u00f6n se\u00e7imin ard\u0131ndan parti i\u00e7inde birlik ve beraberli\u011fin sa\u011fland\u0131\u011f\u0131n\u0131 belirtti. Yar\u0131\u015f s\u00fcrecinde farkl\u0131 g\u00f6r\u00fc\u015flerin dile getirildi\u011fini ifade eden \u00d6zda\u011f, s\u00fcrecin parti kurallar\u0131 \u00e7er\u00e7evesinde \u00e7\u00f6z\u00fcme kavu\u015fturuldu\u011funu s\u00f6yledi.\r\n\r\n\u00d6zda\u011f, \u201cTart\u0131\u015fmayan bir \u00f6rg\u00fct\u00fcn var olmas\u0131 zordur ama tart\u0131\u015ft\u0131ktan sonra birle\u015femeyen bir \u00f6rg\u00fct\u00fcn iktidar olmas\u0131 imkans\u0131zd\u0131r\u201d ifadelerini kulland\u0131.\r\n\r\n\u00d6n se\u00e7imde ortaya \u00e7\u0131kan iradenin kongrede de tescil edilece\u011fini dile getiren \u00d6zda\u011f, Samsun'da partiyi iktidara ta\u015f\u0131ma hedefiyle \u00e7al\u0131\u015facaklar\u0131n\u0131 kaydetti.\r\n\r\n\r\n\r\n\u201cKAPIMIZ DA G\u00d6NL\u00dcM\u00dcZ DE M\u0130LLET\u0130M\u0130ZE A\u00c7IK OLACAK\u201d\r\n\r\nParti binas\u0131n\u0131n kap\u0131lar\u0131n\u0131n vatanda\u015flara a\u00e7\u0131k olaca\u011f\u0131n\u0131 vurgulayan \u00d6zda\u011f, Samsun'un ve b\u00f6lgenin sorunlar\u0131n\u0131 yaln\u0131zca tespit etmekle kalmay\u0131p \u00e7\u00f6z\u00fcm \u00f6nerileri de geli\u015ftireceklerini belirtti.\r\n\r\nParti i\u00e7i demokrasinin \u00f6nemine de\u011finen \u00d6zda\u011f, \u00fcyelerin iradesine sayg\u0131 duyacaklar\u0131n\u0131 ve vatanda\u015flarla g\u00f6z hizas\u0131nda siyaset yapacaklar\u0131n\u0131 ifade etti. \u00d6zda\u011f, konu\u015fmas\u0131nda Cumhurba\u015fkan\u0131 aday\u0131 Ekrem \u0130mamo\u011flu ve beraberindeki yol arkada\u015flar\u0131na da selam g\u00f6nderdi.\r\n\r\n\r\n\r\nKARAG\u00d6Z: \u201cM\u0130LLET\u0130N DERD\u0130YLE ORTAKLA\u015eMAK B\u0130ZE D\u00dc\u015eER\u201d\r\n\r\nYeni Parti Amasya Milletvekili Re\u015fat Karag\u00f6z ise konu\u015fmas\u0131nda, partinin kurulu\u015f amac\u0131n\u0131n makam elde etmek de\u011fil, vatanda\u015flar\u0131n sorunlar\u0131na \u00e7\u00f6z\u00fcm \u00fcretmek oldu\u011funu s\u00f6yledi.\r\n\r\nPartinin farkl\u0131 siyasi g\u00f6r\u00fc\u015flerden ve daha \u00f6nce siyasete kat\u0131lmam\u0131\u015f vatanda\u015flar\u0131n katk\u0131lar\u0131yla b\u00fcy\u00fcd\u00fc\u011f\u00fcn\u00fc belirten Karag\u00f6z, \u201cKamera arkalar\u0131nda \u00f6rg\u00fct dizayn etmek yerine milletin derdiyle ortakla\u015fmak, milletin derdiyle b\u00fct\u00fcnle\u015fmek bize d\u00fc\u015fer\u201d dedi.\r\n\r\nKarag\u00f6z, parti i\u00e7inde ki\u015fisel hesaplar\u0131n \u00f6n\u00fcne ge\u00e7ilmesi gerekti\u011fini vurgulayarak, siyasi makamlar\u0131n birer emanet olarak g\u00f6r\u00fclmesi ve bu g\u00f6revlere lay\u0131k ki\u015filerin getirilmesi gerekti\u011fini ifade etti.\r\n\r\n\r\n\r\nSAMSUN'UN TARIMSAL SORUNLARINA D\u0130KKAT \u00c7EKT\u0130\r\n\r\nSamsun'da \u00fcreticilerin ya\u015fad\u0131\u011f\u0131 sorunlara da de\u011finen Karag\u00f6z, \u00f6zellikle Bafra ve \u00c7ar\u015famba'da \u00e7eltik \u00fcreticilerinin fiyat beklentisine ve f\u0131nd\u0131k \u00fcreticilerinin ya\u015fad\u0131\u011f\u0131 s\u0131k\u0131nt\u0131lara dikkat \u00e7ekti.\r\n\r\nParti y\u00f6neticilerinin k\u00f6y k\u00f6y, mahalle mahalle dola\u015farak vatanda\u015flar\u0131n sorunlar\u0131n\u0131 dinlemesi gerekti\u011fini belirten Karag\u00f6z, bu sorunlar\u0131n hem Samsun'da hem de Ankara'da g\u00fcndeme ta\u015f\u0131naca\u011f\u0131n\u0131 s\u00f6yledi.\r\n\r\nKarag\u00f6z, kongrede belirlenecek y\u00f6netimin se\u00e7imlerin ard\u0131ndan vakit kaybetmeden saha \u00e7al\u0131\u015fmalar\u0131na ba\u015flamas\u0131 gerekti\u011fini kaydetti.\r\n\r\n\r\n\r\n\u00c7AN: \u201c\u0130LK SE\u00c7\u0130MLERDE \u0130KT\u0130DAR OLACA\u011eIZ\u201d\r\n\r\nYeni Parti Samsun Milletvekili Dr. Murat \u00c7an da konu\u015fmas\u0131nda partinin kurulu\u015f s\u00fcrecine ve siyasi hedeflerine ili\u015fkin de\u011ferlendirmelerde bulundu.\r\n\r\nPartinin kurulu\u015funun kolay olmad\u0131\u011f\u0131n\u0131 belirten \u00c7an, Genel Ba\u015fkan \u00d6zg\u00fcr \u00d6zel'in T\u00fcrkiye genelinde ger\u00e7ekle\u015ftirdi\u011fi ziyaretlerin ard\u0131ndan yeni bir siyasi yol a\u00e7ma karar\u0131 al\u0131nd\u0131\u011f\u0131n\u0131 s\u00f6yledi.\r\n\r\nYeni Parti'nin ilk se\u00e7imlerde iktidara gelece\u011fini savunan \u00c7an, birlik ve beraberlik i\u00e7inde \u00e7al\u0131\u015fman\u0131n \u00f6nemini vurgulad\u0131. Vatanda\u015flar\u0131n ekonomik s\u0131k\u0131nt\u0131lar\u0131na de\u011finen \u00c7an, emeklilerin, asgari \u00fccretlilerin, i\u015f\u00e7ilerin ve gen\u00e7lerin ya\u015fad\u0131\u011f\u0131 sorunlara dikkat \u00e7ekti.\r\n\r\n\u00c7an, Samsun'un ge\u00e7mi\u015fteki siyasi g\u00fcc\u00fcne yeniden kavu\u015fmas\u0131 i\u00e7in \u00e7al\u0131\u015facaklar\u0131n\u0131 ifade ederek, partinin hedeflerine ula\u015fmas\u0131nda vatanda\u015flar\u0131n deste\u011finin \u00f6nem ta\u015f\u0131d\u0131\u011f\u0131n\u0131 dile getirdi.\r\n\r\n\r\n\r\nTEK L\u0130STEYLE OYLAMAYA G\u0130D\u0130LD\u0130\r\n\r\nKongrede Mehmet \u00d6zda\u011f ba\u015fkanl\u0131\u011f\u0131ndaki il y\u00f6netimi, yedek \u00fcyeler, il disiplin kurulu \u00fcyeleri ve kurultay delegeleri i\u00e7in haz\u0131rlanan liste delegelerin oylar\u0131na sunuldu. Kongre divan\u0131na sunulan listede \u00d6zda\u011f, il ba\u015fkan\u0131 aday\u0131 olarak yer ald\u0131.\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nSamsun\u2019da kentsel d\u00f6n\u00fc\u015f\u00fcmde s\u0131rada iki il\u00e7e var!\r\n\r\nYeni Parti Samsun'da kongre heyecan\u0131!\r\n\r\nDAHA FAZLA SAMSUN HABER\u0130 \u0130\u00c7\u0130N TIKLAYINIZ","description":"SAMSUN HABER... Yeni Parti Samsun 1. Ola\u011fan \u0130l Kongresi'nde Mehmet \u00d6zda\u011f ba\u015fkanl\u0131\u011f\u0131ndaki listeyle oylamaya gidildi. Kongrede birlik ve iktidar mesajlar\u0131\u2026","inLanguage":"tr-TR","keywords":[],"image":{"@type":"ImageObject","url":"https:\/\/samsungazetesicom.teimg.com\/crop\/1280x720\/samsungazetesi-com\/uploads\/2026\/10\/whatsapp-image-2026-10-25-at-103631-1.jpeg","width":"1280","height":"720","caption":"Yeni Parti Samsun kongresinde birlik mesaj\u0131: \u201cBirlikte y\u00fcr\u00fcyece\u011fiz\u201d"},"publishingPrinciples":"https:\/\/www.samsungazetesi.com\/yayin-ilkeleri","isFamilyFriendly":"http:\/\/schema.org\/True","isAccessibleForFree":"http:\/\/schema.org\/True","publisher":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.samsungazetesi.com\/#organization","name":"Samsun Gazetesi","image":"https:\/\/samsungazetesicom.teimg.com\/samsungazetesi-com\/uploads\/2024\/02\/samsun-gazetesi-logo.svg","logo":{"@type":"ImageObject","url":"https:\/\/samsungazetesicom.teimg.com\/samsungazetesi-com\/uploads\/2024\/02\/samsun-gazetesi-logo.svg","width":"640","height":"375"}},"author":{"@type":"Person","name":"\u0130lkay Serdar","url":"https:\/\/www.samsungazetesi.com\/muhabir\/33\/ilkay-serdar"},"editor":{"@type":"Person","name":"Yunus Emre Pur\u00e7","url":"https:\/\/www.samsungazetesi.com\/muhabir\/28\/yunus-emre-purc"},"creator":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.samsungazetesi.com\/#organization","name":"Samsun Gazetesi","url":"https:\/\/www.samsungazetesi.com"}}</script>
<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"VideoObject","name":"Yeni Parti Samsun kongresinde birlik mesaj\u0131: \u201cBirlikte y\u00fcr\u00fcyece\u011fiz\u201d","genre":"video","inLanguage":"tr-TR","thumbnailUrl":"https:\/\/samsungazetesicom.teimg.com\/crop\/250x150\/samsungazetesi-com\/uploads\/2026\/10\/whatsapp-image-2026-10-25-at-103631-1.jpeg","embedUrl":"https:\/\/www.youtube.com\/embed\/3AyU1aTiFeI","dateCreated":"2026-10-25T11:27:00+03:00","datePublished":"2026-10-25T11:27:00+03:00","dateModified":"2026-10-25T15:45:24+03:00","uploadDate":"2026-10-25T11:27:00+03:00","description":"SAMSUN HABER... Yeni Parti Samsun 1. Ola\u011fan \u0130l Kongresi'nde Mehmet \u00d6zda\u011f ba\u015fkanl\u0131\u011f\u0131ndaki listeyle oylamaya gidildi. Kongrede birlik ve iktidar mesajlar\u0131\u2026","headline":"Yeni Parti Samsun kongresinde birlik mesaj\u0131: \u201cBirlikte y\u00fcr\u00fcyece\u011fiz\u201d","image":"https:\/\/samsungazetesicom.teimg.com\/samsungazetesi-com\/uploads\/2026\/10\/whatsapp-image-2026-10-25-at-103631-1.jpeg","mainEntityOfPage":{"@type":"WebPage","@id":"https:\/\/www.samsungazetesi.com\/yeni-parti-samsun-kongresinde-birlik-mesaji-birlikte-yuruyecegiz"},"url":"https:\/\/www.samsungazetesi.com\/yeni-parti-samsun-kongresinde-birlik-mesaji-birlikte-yuruyecegiz"}</script>


