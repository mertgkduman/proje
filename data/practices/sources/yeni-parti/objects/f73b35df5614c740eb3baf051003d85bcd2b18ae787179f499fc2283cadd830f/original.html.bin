                <a class="dropdown-item" href="javascript:void(0)" onclick="copyURL(event, 'https://www.samsungazetesi.com/yeni-parti-samsun-kongresinde-birlik-mesaji-birlikte-yuruyecegiz')" rel="noreferrer nofollow noopener external" title="Bağlantıyı Kopyala">
                    <i class="fas fa-link text-dark me-2"></i>
                    Kopyala
