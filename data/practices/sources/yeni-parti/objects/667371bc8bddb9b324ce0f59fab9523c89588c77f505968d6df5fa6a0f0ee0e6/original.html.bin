    <a href="https://x.com/intent/tweet?url=https%3A%2F%2Fwww.yozgatmedya.com.tr%2Fyozgatta-yeni-parti-on-seciminin-galibi-yasar&text=Yozgat%27ta+YEN%C4%B0+Parti+%C3%96n+Se%C3%A7iminin+Galibi+Ya%C5%9Far" onclick="if (!window.__cfRLUnblockHandlers) return false; initiateDesktopShare(event, 'twitter')" class="btn btn-dark btn-sm rounded-0 shadow-sm me-1" title="X&#039;de Paylaş" data-platform="twitter" data-share-url="https://www.yozgatmedya.com.tr/yozgatta-yeni-parti-on-seciminin-galibi-yasar" data-share-title="Yozgat&#039;ta YENİ Parti Ön Seçiminin Galibi Yaşar" rel="noreferrer nofollow noopener external" data-cf-modified-725aa7c3cb732442665b6f42-="">
