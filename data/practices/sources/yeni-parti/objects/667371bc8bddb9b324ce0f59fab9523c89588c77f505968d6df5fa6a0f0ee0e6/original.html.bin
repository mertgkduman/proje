                            <div class="col-12">
                    <a class="d-block bg-te-color p-1" href="/iyi-parti-genel-sekreteri-osman-erturk-ozel-yozgata-geliyor" title="İYİ Parti Genel Sekreteri Osman Ertürk Özel Yozgat&#039;a Geliyor" target="_self">
                        <div class="row g-1 align-items-center">
                            <div class="col-5 col-sm-3">
                                <img src="https://yozgatmedyacomtr.teimg.com/crop/250x150/yozgatmedya-com-tr/uploads/2026/09/osman-erturk-ozel.jpg" loading="lazy" width="860" height="504"
