body.listing-dark-theme .district-news__title,body.listing-dark-theme .district-news__card,body.listing-dark-theme .district-news__card h2,body.listing-dark-theme .gallery-page h1,body.listing-dark-theme .gallery-page h2,body.listing-dark-theme .section-spacing h1,body.listing-dark-theme .section-spacing h2{color:#f2f0ec!important}
body.listing-dark-theme .district-news__desc,body.listing-dark-theme .district-news__date,body.listing-dark-theme .gallery-page p,body.listing-dark-theme .section-spacing p{color:#b6b4af!important}
