        <span class="market-tape-name">Çeyrek Altın</span>
        <span class="market-tape-price" id="market-quarter-price">—</span>
        <span class="market-tape-change flat" id="market-quarter-change">Yükleniyor</span>
      </div>
            <div class="market-tape-card" aria-label="Tam Altın fiyatı ve değişimi">
        <span class="market-tape-name">Tam Altın</span>
