body.article-reading-theme .article-sidebar-stack section a:hover, body.article-reading-theme .stream-article .article-sidebar-stack section a:hover { background:transparent !important; }
body.article-reading-theme .article-sidebar-stack section a:hover p, body.article-reading-theme .stream-article .article-sidebar-stack section a:hover p { color:#e30613 !important; }
