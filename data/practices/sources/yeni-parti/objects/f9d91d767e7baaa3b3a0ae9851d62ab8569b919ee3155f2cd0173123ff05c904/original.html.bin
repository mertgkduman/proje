<style>
.breaking-ticker {
    display:flex;
    width:max-content;
    gap:0 !important;
    transform:translate3d(0,0,0);
    backface-visibility:hidden;
    will-change:transform;
    animation:ticker 20s linear infinite;
}
.breaking-track {
    display:flex;
    flex:0 0 auto;
    align-items:center;
    gap:40px;
    padding-right:40px;
}
@keyframes ticker {
    0% { transform:translate3d(0,0,0); }
    100% { transform:translate3d(-50%,0,0); }
}

/* Mobil daha hızlı */
@media (max-width: 768px) {
    .breaking-ticker {
        animation: ticker 20s linear infinite;
    }
}
</style>


