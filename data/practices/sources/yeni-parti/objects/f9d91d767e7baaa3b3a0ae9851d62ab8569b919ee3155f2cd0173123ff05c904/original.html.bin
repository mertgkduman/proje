<script>
(() => {
  const fmt = (value, digits = 2) => new Intl.NumberFormat('tr-TR', {minimumFractionDigits: digits, maximumFractionDigits: digits}).format(value);
  const setPrice = (key, value, currency = 'TRY', digits = 2) => {
    const el = document.getElementById('market-' + key + '-price');
    if (!el || !Number.isFinite(Number(value))) return;
    el.textContent = (currency === 'TRY' ? '₺' : '$') + fmt(Number(value), digits);
  };
  const setChange = (key, value) => {
    const el = document.getElementById('market-' + key + '-change');
    if (!el) return;
    if (value === null || value === undefined || value === '' || !Number.isFinite(Number(value))) { const el = document.getElementById('market-' + key + '-change'); if (el) { el.className = 'market-tape-change flat'; el.textContent = 'Günlük değişim bekleniyor'; } return; }
    const n = Number(value);
    el.className = 'market-tape-change ' + (n > 0 ? 'up' : n < 0 ? 'down' : 'flat');
    el.textContent = (n > 0 ? '↗ ' : n < 0 ? '↘ ' : '→ ') + (n > 0 ? '+' : '') + fmt(n) + '%';
  };
  const setUnavailable = key => {
    const el = document.getElementById('market-' + key + '-change');
    if (el) { el.className = 'market-tape-change flat'; el.textContent = 'Veri yok'; }
  };
  const setDelayed = key => {
    const change = document.getElementById('market-' + key + '-change');
    const card = change && change.closest('.market-tape-card');
    if (change) change.title = 'Son alınan değişim bilgisi; yeni veri kontrol ediliyor.';
    if (card) { card.classList.add('is-stale'); card.title = 'Veri kaynağı geçici olarak yanıt vermedi; son alınan değer gösteriliyor.'; }
  };
  const clearDelayed = key => {
    const change = document.getElementById('market-' + key + '-change');
    const card = change && change.closest('.market-tape-card');
    if (change) change.removeAttribute('title');
    if (card) { card.classList.remove('is-stale'); card.removeAttribute('title'); }
  };
  const applyMarketSummary = payload => {
    const items = payload && payload.success && payload.data ? payload.data : {};
    [['usd','TRY',2],['eur','TRY',2],['oil','USD',2],['bist','TRY',0]].forEach(([key,currency,digits]) => {
      const item = items[key];
      if (!item || !Number.isFinite(Number(item.price))) { setUnavailable(key); return; }
      setPrice(key, item.price, currency, digits);
      setChange(key, item.change);
    });
  };
  const applyCurrency = data => {
    const rates = data && data.result && data.result.data ? data.result.data : [];
    const usd = rates.find(item => item.code === 'TRY');
    const eur = rates.find(item => item.code === 'EUR');
    if (data && data.success && usd && Number(usd.calculated)) {
      const usdTry = Number(usd.calculated);
      setPrice('usd', usdTry);
      setChange('usd', usd.change);
      if (eur && Number(eur.calculated)) {
        setPrice('eur', usdTry / Number(eur.calculated));
        const change = Number.isFinite(Number(usd.change)) && Number.isFinite(Number(eur.change))
          ? Number(usd.change) - Number(eur.change) : null;
        setChange('eur', change);
      } else setUnavailable('eur');
    } else ['usd','eur'].forEach(setUnavailable);
  };
  const applyGold = data => {
    const metals = data && data.result ? data.result : [];
    const find = names => metals.find(item => names.includes(String(item.name || '').toLocaleLowerCase('tr-TR')));
    [['gram',['gram altın']],['quarter',['çeyrek altın']],['full',['tam altın']],['silver',['gümüş gram']],['ounce',['ons altın']]].forEach(([key,names]) => {
      const item = find(names);
      if (!data || !data.success || !item) { setUnavailable(key); return; }
      setPrice(key, Number(item.buying), 'TRY', 2);
      setChange(key, item.change !== undefined ? item.change : item.rate);
    });
  };
  const applyCrypto = data => {
    [['bitcoin','bitcoin'],['ethereum','ethereum']].forEach(([key,id]) => {
      const item = data && data[id];
      if (!item || !Number.isFinite(Number(item.usd))) { setUnavailable(key); return; }
      setPrice(key, item.usd, 'USD', Number(item.usd) >= 100 ? 0 : 3);
      setChange(key, item.usd_24h_change);
    });
  };
  const refresh = async (url, cacheKey, apply, keys) => {
    let hasFreshCache = false;
    try {
      const cached = JSON.parse(localStorage.getItem(cacheKey) || 'null');
      if (cached && cached.data && Number.isFinite(Number(cached.savedAt))) {
        apply(cached.data);
        hasFreshCache = true;
        if (cached.stale || cached.data?.stale || Date.now() - cached.savedAt > 120000) keys.forEach(setDelayed);
        else keys.forEach(clearDelayed);
      }
    } catch (_) {}
    const controller = new AbortController();
    const timeout = window.setTimeout(() => controller.abort(), 5000);
    try {
      const response = await fetch(url, {cache:'no-store', signal:controller.signal});
      if (!response.ok) throw new Error('Piyasa servisi yanıt vermedi');
      const data = await response.json();
      const stale = response.headers.get('X-Data-Stale') === 'true' || data?.stale === true;
      try { localStorage.setItem(cacheKey, JSON.stringify({savedAt:Date.now(),data,stale})); } catch (_) {}
      apply(data);
      keys.forEach(stale ? setDelayed : clearDelayed);
    } catch (_) {
      if (!hasFreshCache) keys.forEach(setUnavailable);
    } finally {
      window.clearTimeout(timeout);
    }
  };
  const update = () => {
    refresh('/api/market-summary','so-market-summary-v1',applyMarketSummary,['usd','eur','oil','bist']);
    refresh('/api/altin','so-market-gold-v1',applyGold,['gram','quarter','full','silver','ounce']);
    refresh('https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum&vs_currencies=usd&include_24hr_change=true','so-market-crypto-v1',applyCrypto,['bitcoin','ethereum']);

  };
  update();
  window.setInterval(update, 60000);
})();
</script>

