<style id="samsun-objectif-brand-colors">
:root { --so-brand-red:#e30613; }
[class*="text-red-"], [class*="hover:text-red-"]:hover { color:#e30613 !important; }
[class~="bg-red-50"], [class~="bg-red-100"], [class*="bg-red-50/"], [class*="bg-red-100/"] { background-color:rgba(227,6,19,.09) !important; }
[class*="bg-red-"]:not([class~="bg-red-50"]):not([class~="bg-red-100"]):not([class*="bg-red-50/"]):not([class*="bg-red-100/"]) { background-color:#e30613 !important; }
[class*="border-red-"] { border-color:rgba(227,6,19,.38) !important; }
[class*="ring-red-"] { --tw-ring-color:#e30613 !important; }
.site-footer { margin-top:42px !important; border-top:2px solid #e30613 !important; background:#121316 !important; color:#c2c3c8 !important; }
body.home-dark-theme > footer.site-footer { border-top:2px solid #e30613 !important; }
body.home-dark-theme > footer.site-footer a:hover, body.home-dark-theme > footer.site-footer a:focus-visible { color:#e30613 !important; }
.site-footer .footer-inner { max-width:1120px; margin:0 auto; padding:38px 24px 18px; }
.site-footer .footer-grid { display:grid; grid-template-columns:1.45fr 1fr 1fr 1fr; gap:34px; }
.site-footer .footer-brand img { display:block; width:auto; height:46px; margin-bottom:16px; }
.site-footer .footer-brand p { max-width:310px; margin:0; color:#a7a8ae !important; font-size:13px; line-height:1.7; }
.site-footer .footer-heading { margin:5px 0 14px; color:#f5f5f6 !important; font-size:12px; font-weight:800; letter-spacing:.13em; text-transform:uppercase; }
.site-footer .footer-links { display:grid; gap:10px; margin:0; padding:0; list-style:none; font-size:13px; }
.site-footer a { color:#bfc0c5 !important; text-decoration:none; transition:color .16s ease,background .16s ease; }
.site-footer a:hover, .site-footer a:focus-visible { color:#e30613 !important; }
.site-footer .footer-social { display:flex; flex-wrap:nowrap; align-items:center; gap:8px; }
.site-footer .footer-social a { padding:7px 10px; border:1px solid #37383d; border-radius:999px; }
.site-footer .footer-social a:hover { border-color:#e30613; }
.site-footer .footer-bottom { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:30px; padding-top:16px; border-top:1px solid #34353a; color:#909198; font-size:12px; }
.site-footer .footer-bottom-links { display:flex; gap:18px; }
#mega-menu { max-height:100dvh; overflow-y:auto; border-bottom:2px solid #e30613; border-radius:0 0 18px 18px; background:#17181b !important; box-shadow:none !important; backdrop-filter:none !important; -webkit-backdrop-filter:none !important; }
#mega-menu .menu-column { padding:16px; border:1px solid rgba(255,255,255,.09); border-radius:14px; background:rgba(255,255,255,.045); }
#mega-menu .menu-column ul { display:grid; gap:4px; margin:0; padding:0; list-style:none; }
#mega-menu .menu-column a { display:block; padding:8px 10px; border-radius:8px; transition:background .16s ease,color .16s ease; }
#mega-menu .menu-column a:hover, #mega-menu .menu-column a:focus-visible { color:#e30613 !important; background:transparent !important; }
@media(max-width:767px) {
 #searchBox { width:auto !important; min-width:0 !important; border:0 !important; background:transparent !important; overflow:visible !important; }
 #searchBox input { display:none !important; }
 #searchBtn { padding:7px 12px !important; }
 .site-footer .footer-social { flex-wrap:nowrap !important; gap:5px !important; }
 .site-footer .footer-social a { padding:4px 6px !important; font-size:11px !important; white-space:nowrap !important; }
 .site-footer .footer-inner { padding:30px 18px 16px; }
 .site-footer .footer-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px 16px; }
 .site-footer .footer-brand { grid-column:1/-1; }
 .site-footer .footer-brand p { max-width:420px; }
 .site-footer .footer-bottom { align-items:flex-start; flex-direction:column; margin-top:24px; }
 #mega-menu .menu-inner { padding:16px 14px 22px; }
 #mega-menu .menu-column { padding:11px; }
 #mega-menu .menu-column a { padding:7px 8px; font-size:13px; }
}
@media(max-width:380px) { #mega-menu .menu-grid { gap:8px; } #mega-menu .menu-column { padding:9px; } }
html[data-theme="light"] body > footer.site-footer { background:#fff !important; color:#4b5563 !important; border-top-color:#e30613 !important; }
html[data-theme="light"] body > footer.site-footer .footer-heading { color:#17181b !important; }
html[data-theme="light"] body > footer.site-footer .footer-brand p { color:#5c626b !important; }
html[data-theme="light"] body > footer.site-footer a { color:#4b5563 !important; }
html[data-theme="light"] body > footer.site-footer a:hover { color:#e30613 !important; }
html[data-theme="light"] body > footer.site-footer .footer-bottom { color:#737984; border-color:#e5e7eb; }

/* Preserve Ara dimensions and match the theme control to its button height. */
#searchBox { display:flex; align-items:center; }
#searchBtn { display:inline-flex; align-items:center; justify-content:center; }
#themeToggle { display:inline-flex; align-items:center; justify-content:center; align-self:center; height:37px; min-height:37px; box-sizing:border-box; }
@media(max-width:639px) { #themeToggle { height:37px; min-height:37px; } }

/* Reserve the theme control and paint the correct icon before the first header frame. */
#themeToggle { box-sizing:border-box; width:88px; height:36px; min-height:36px; flex:0 0 88px; }
#themeToggle .theme-icon-scene { position:relative; display:inline-block; width:20px; height:20px; flex:0 0 20px; vertical-align:middle; }
#themeToggle .theme-icon { position:absolute; inset:0; display:block; width:20px; height:20px; transform-origin:50% 50%; transition:none; }
#themeToggle .theme-icon-sun { opacity:0; transform:rotate(-110deg) scale(.25); }
#themeToggle .theme-icon-moon { opacity:1; transform:rotate(0) scale(1); }
html[data-theme="light"] #themeToggle .theme-icon-sun { opacity:1; transform:rotate(0) scale(1); }
html[data-theme="light"] #themeToggle .theme-icon-moon { opacity:0; transform:rotate(110deg) scale(.25); }
@media(max-width:639px) { #themeToggle { width:40px; flex-basis:40px; padding-left:0 !important; padding-right:0 !important; } }
</style>

<style>
.market-tape{width:100%;background:#fff;border-bottom:1px solid #e5e7eb;color:#171717;overflow:hidden}
.market-tape-inner{box-sizing:border-box;width:100%;max-width:1000px;margin:0 auto;padding:9px 12px}
.market-tape-row{display:grid;grid-template-columns:repeat(11,minmax(0,1fr));gap:6px;width:100%}
.market-tape-card{box-sizing:border-box;width:100%;height:72px;min-width:0;min-height:72px;padding:8px 7px;background:#fff;border:1px solid #e2e5e9;border-radius:8px;color:#171717}
.market-tape-name{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#737984;font-size:11px;font-weight:600;line-height:1.2}
.market-tape-price{display:block;overflow:hidden;margin-top:5px;color:#171717;font-size:12px;font-weight:750;line-height:1.15;white-space:nowrap}
.market-tape-change{box-sizing:border-box;display:inline-flex;align-items:center;gap:2px;max-width:100%;height:16px;min-height:16px;overflow:hidden;margin-top:6px;padding:3px 5px;border-radius:5px;background:#f3f4f6;color:#646b75;font-size:10px;font-weight:650;line-height:1;white-space:nowrap}
.market-tape-change.up{background:#eaf6ee;color:#148342}
.market-tape-change.down{background:#fff0f0;color:#e30613}
.market-tape-change.flat{background:#f3f4f6;color:#646b75}
@media(min-width:768px){.market-tape-inner{padding-top:0}}
@media(max-width:900px){.market-tape-row{grid-template-columns:repeat(6,minmax(0,1fr))}}
@media(max-width:767px){
.breaking-news-bar, body.home-dark-theme .breaking-news-bar { margin-bottom:0!important; }
.market-tape{margin-top:0!important;padding-top:0!important}
.market-tape-inner{padding:0 8px 4px;overflow:hidden}
.market-tape-row{display:flex;flex-wrap:nowrap;gap:6px;width:100%;overflow-x:auto;overflow-y:hidden;scrollbar-width:none;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;touch-action:pan-x}
.market-tape-row::-webkit-scrollbar{display:none}
.market-tape-card{box-sizing:border-box;flex:0 0 112px;width:112px;height:40px;min-width:112px;min-height:40px;padding:5px 6px;scroll-snap-align:start;border-radius:7px}
.market-tape-name{font-size:10px}
.market-tape-price{font-size:11px;margin-top:2px}
.market-tape-change{display:none!important}
}
</style>
<style id="samsun-objectif-ui-polish">
#backToTop { position:fixed; z-index:60; right:22px; bottom:22px; width:46px; height:46px; display:grid; place-items:center; border:1px solid rgba(255,255,255,.22); border-radius:50%; color:#fff; background:#e30613; box-shadow:0 8px 24px rgba(0,0,0,.24); opacity:0; visibility:hidden; pointer-events:none; transform:translateY(10px); transition:opacity .18s ease,transform .18s ease,visibility .18s ease,background-color .18s ease; cursor:pointer; }
#backToTop svg { width:22px; height:22px; }
#backToTop:hover, #backToTop:focus-visible { background:#b90715; outline:2px solid rgba(227,6,19,.28); outline-offset:3px; }
#backToTop.is-visible { opacity:1; visibility:visible; pointer-events:auto; transform:translateY(0); }
@media(max-width:767px) { #backToTop { right:14px; bottom:8px; width:42px; height:42px; } #backToTop svg { width:24px; height:24px; } #backToTop svg path { stroke-width:3; } }
@media(prefers-reduced-motion:reduce) { #backToTop { transition:none; } }
body > nav.bg-white a:hover, html[data-theme="light"] body > nav.bg-white a:hover, body > nav.bg-white button:hover, html[data-theme="light"] body > nav.bg-white button:hover { color:#e30613 !important; background:transparent !important; }
#mega-menu .menu-column a:hover, #mega-menu .menu-column a:focus-visible { color:#e30613 !important; background:transparent !important; }
