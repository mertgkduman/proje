    margin: 0 auto 20px !important;
    color: #aaa !important;
    font-size: 12px !important;
}
.article-reading-theme .article-reading-shell > nav a { color: #aaa !important; }
.article-reading-theme .article-reading-shell > header {
    max-width: 1080px !important;
    margin: 0 auto 22px !important;
}
.article-reading-theme .article-reading-shell > header h1 {
    max-width: 1080px;
    color: #f5f3ef !important;
    font-size: clamp(36px, 4.3vw, 58px) !important;
    line-height: 1.08 !important;
    font-weight: 800 !important;
    letter-spacing: -.035em;
}
.article-reading-theme .article-summary {
    max-width: 1000px !important;
    color: #c9c7c3 !important;
    font-size: clamp(19px, 2vw, 24px) !important;
    line-height: 1.5 !important;
    font-weight: 450 !important;
}
.article-reading-theme .article-meta-bar {
    max-width: 1080px;
    margin: 0 auto 22px !important;
    border-color: #3a3b3e !important;
    padding: 7px 0 !important;
    color: #c5c3bf;
}
.article-reading-theme .article-meta-bar span[style*="color:#646464"] { color: #c0beb9 !important; }
.article-reading-theme .article-meta-divider { background: #55565a !important; }
.article-reading-theme .article-share-label { color: #e6e4df; }
.article-reading-theme .article-stream-root { margin-top: 0; }
.article-reading-theme .article-stream-root > .stream-article-block {
    display: block;
    max-width: 1120px;
    margin: 0 auto;
}
.article-reading-theme .article-main-column { min-width: 0; }
.article-reading-theme .article-hero-layout { display: flex; flex-direction: column; gap: 0; }
.article-reading-theme .article-hero-layout > div:first-child { min-width: 0; }
.article-reading-theme .article-cover-frame {
    width: 100%;
    max-width: 100%;
    margin: 0 auto 28px !important;
    overflow: hidden;
    border-radius: 0;
}
.article-reading-theme .article-cover-frame img {
    display: block;
    width: 100%;
    max-height: 630px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
}
.article-reading-theme .article-cover-frame video {
    display:block !important;
    width:100% !important;
    max-width:none !important;
    height:auto !important;
    margin:0 !important;
    border-radius:0 !important;
    background:#000;
}
.article-reading-theme .odt-article-body {
    max-width: 760px !important;
    margin: 0 auto;
    color: #e6e4df;
}
.article-reading-theme .odt-article-body p {
    color: #e0ded9 !important;
    font-size: 19px;
    line-height: 1.78;
    margin-bottom: 1.25rem;
}
.article-reading-theme .odt-article-body h2,
.article-reading-theme .odt-article-body h3,
.article-reading-theme .odt-article-body h4 {
    color: #f5f3ef !important;
    font-size: 25px;
    line-height: 1.3;
    margin-top: 1.8em;
    margin-bottom: .6em;
}
.article-reading-theme .odt-article-body blockquote { color: #d1cfca; border-left-color: #e30613; }
.article-reading-theme .article-source-signature { max-width: 760px; margin: 20px auto 0; color: #c4c1bb; }
.article-reading-theme .article-sidebar-stack { position: static; gap: 24px; margin-top: 36px; }
.article-reading-theme .article-sidebar-stack section {
    padding: 16px;
    background: #202124;
    border: 1px solid #36373a;
    border-radius: 4px;
}
.article-reading-theme .article-sidebar-stack section h3 { color: #f0eeea; }
.article-reading-theme .article-sidebar-stack section a { border-color: #38393c; }
.article-reading-theme .article-sidebar-stack section a:hover { background: transparent; }
.article-reading-theme .article-sidebar-stack section a p { color: #e1dfda; }
.article-reading-theme .article-sidebar-stack section a:hover p { color: #e30613; }
.article-reading-theme #comments-yeni-parti-samsun-il-kongresi-sona-erdi-mehmet-ozdag-yeniden-baskan {
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
    border-color: #3a3b3e;
    color: #f0eeea;
}
.article-reading-theme #comments-yeni-parti-samsun-il-kongresi-sona-erdi-mehmet-ozdag-yeniden-baskan h3,
.article-reading-theme #comments-yeni-parti-samsun-il-kongresi-sona-erdi-mehmet-ozdag-yeniden-baskan h4 { color: #f0eeea; }
.article-reading-theme #comments-yeni-parti-samsun-il-kongresi-sona-erdi-mehmet-ozdag-yeniden-baskan p { color: #c9c7c2; }
.article-reading-theme #comments-yeni-parti-samsun-il-kongresi-sona-erdi-mehmet-ozdag-yeniden-baskan input,
.article-reading-theme #comments-yeni-parti-samsun-il-kongresi-sona-erdi-mehmet-ozdag-yeniden-baskan textarea {
    background: #202124;
    color: #f5f3ef;
    border-color: #444549;
}
.article-reading-theme #comments-yeni-parti-samsun-il-kongresi-sona-erdi-mehmet-ozdag-yeniden-baskan input::placeholder,
.article-reading-theme #comments-yeni-parti-samsun-il-kongresi-sona-erdi-mehmet-ozdag-yeniden-baskan textarea::placeholder { color: #a19f9a; }
.article-reading-theme .article-stream-sentinel { color: #aaa !important; }
@media (max-width: 899px) {
    body.article-reading-theme #main-wrapper { padding: 18px 0 36px !important; }
    .article-reading-theme .article-reading-shell { padding: 22px 16px 36px; }
    .article-reading-theme .article-reading-shell > nav { margin-bottom: 16px !important; }
    .article-reading-theme .article-reading-shell > header { margin-bottom: 16px !important; }
    .article-reading-theme .article-reading-shell > header h1 {
        font-size: clamp(30px, 8vw, 42px) !important;
        line-height: 1.12 !important;
    }
    .article-reading-theme .article-summary { font-size: 18px !important; line-height: 1.5 !important; }
    .article-reading-theme .article-meta-bar { margin-bottom: 16px !important; }
    .article-reading-theme .article-cover-frame {
        width: calc(100% + 32px);
        max-width: none;
        margin: 0 -16px 22px !important;
        border-radius: 0;
    }
    .article-reading-theme .article-cover-frame img { aspect-ratio: 16 / 10; max-height: none; }
    .article-reading-theme .odt-article-body p { font-size: 18px; line-height: 1.72; }
    .article-reading-theme .odt-article-body h2,
    .article-reading-theme .odt-article-body h3,
    .article-reading-theme .odt-article-body h4 { font-size: 22px; }
}
:root {
    --mobile-gutter: 0px;
    --mobile-meta-gutter: 2px;
}

.article-page-root,
.article-page-root * {
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", "Noto Sans", "Liberation Sans", Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
}

.odt-article-body p {
    font-size: 17px;
    line-height: 23px;
    color: rgb(0, 0, 0);
    font-weight: 400;
    font-style: normal;
    margin-top: 0;
    margin-bottom: 1rem;
}

.odt-article-body p:empty {
    display: none;
}

.odt-article-body h2,
.odt-article-body h3,
.odt-article-body h4 {
    color: rgb(0, 0, 0);
    font-size: 17px;
    line-height: 24px;
    font-weight: 700;
    font-style: normal;
    margin-top: 1.1em;
    margin-bottom: .35em;
}

.odt-article-body h2 + p,
.odt-article-body h3 + p,
.odt-article-body h4 + p,
.odt-article-body blockquote + p {
    margin-top: 0;
}

.odt-article-body > :first-child {
    margin-top: 0 !important;
}

.odt-article-body .article-inline-embed {
    margin: 2rem auto;
    max-width: 680px;
}

.odt-article-body figure,
.odt-article-body > img,
.odt-article-body p > img,
.odt-article-body .attachment {
    display: block;
    margin: 1.5rem 0 1.75rem;
}

.odt-article-body h2 + figure,
.odt-article-body h3 + figure,
.odt-article-body h2 + .attachment,
.odt-article-body h3 + .attachment {
    margin-top: 1rem;
}

.odt-article-body figure + p,
.odt-article-body .attachment + p {
    margin-top: 0.65rem;
}

.odt-article-body figure figcaption {
    margin-top: 0.55rem;
    font-size: 13px;
    line-height: 1.5;
    color: #6b7280;
}

.odt-article-body blockquote {
    border-left: 4px solid #e30613;
    padding-left: 1rem;
    color: #444;
    font-style: italic;
}

.odt-article-body a {
    color: #e30613;
    font-weight: 700;
    text-decoration: none;
}

.odt-article-body a:hover {
    color: #e30613;
    text-decoration: underline;
}

.article-source-signature {
    margin: 20px 0 0;
    font-size: 17px;
    line-height: 1.45;
    font-weight: 700;
    color: #111827;
}

.article-hero-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
}

.article-sidebar-stack {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
}

.article-cover-frame {
    max-width: 760px;
}

/* GUNCELLENEN META BAR STILLERI */
html, body {
    max-width: 100%;
    overflow-x: hidden;
    margin: 0 !important;
    padding: 0 !important;
}

.article-page-root {
    width: 100%;
    max-width: 1120px;
    overflow-x: clip;
}

.article-main-column,
.article-main-column > div,
.article-main-column img,
.odt-article-body,
.odt-article-body * {
    max-width: 100%;
}

.article-meta-bar {
    border-top: 1px solid #d4d4d4;
    border-bottom: 1px solid #d4d4d4;
    padding: 6px 0;
}

.article-meta-divider {
    width: 1px;
    height: 20px;
    background: #d4d4d4;
    display: inline-block;
}

@media (max-width: 899px) {
    html, body {
        overflow-x: hidden !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .article-page-root,
    .article-hero-layout,
    .article-main-column,
    .article-main-column > div,
    .article-cover-frame,
    .odt-article-body,
    .odt-article-body > * {
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box;
    }

    .article-page-root {
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    .article-page-root > nav,
    .article-page-root > header,
    .article-page-root > .article-meta-bar,
    .article-main-column > :not(.article-cover-frame):not(.odt-article-body),
    .article-sidebar-stack,
    #comments-yeni-parti-samsun-il-kongresi-sona-erdi-mehmet-ozdag-yeniden-baskan {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .article-page-root > nav > div,
    .article-page-root > header h1,
    .article-summary,
    .odt-article-body > p,
    .odt-article-body > h2,
    .odt-article-body > h3,
    .odt-article-body > h4,
    .odt-article-body > ul,
    .odt-article-body > ol,
    .odt-article-body > blockquote,
    .odt-article-body > table,
    .odt-article-body > iframe,
    .odt-article-body > .table-wrapper,
    #comments-yeni-parti-samsun-il-kongresi-sona-erdi-mehmet-ozdag-yeniden-baskan {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .article-page-root > header h1 {
        font-size: 30px !important;
        line-height: 30px !important;
    }

    .article-summary {
        font-size: 18px !important;
        line-height: 23px !important;
    }

    .article-meta-bar {
        padding: 2px var(--mobile-meta-gutter) !important;
    }

    .article-meta-inner {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: space-between !important;
        flex-wrap: nowrap !important;
        gap: 6px !important;
    }

    .article-meta-inner > div:first-child {
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
        min-width: 0 !important;
        flex: 1 1 auto !important;
        white-space: nowrap !important;
        overflow: hidden !important;
    }

    .article-meta-inner > div:last-child {
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
        flex: 0 0 auto !important;
        white-space: nowrap !important;
    }

    .article-meta-bar span,
    .article-meta-bar a,
    .article-meta-bar button {
        font-size: 11px !important;
        line-height: 10px !important;
        font-weight: 700 !important;
    }

    .article-meta-inner > div:first-child img,
    .article-meta-inner > div:last-child img,
    .article-meta-inner > div:last-child svg,
    .article-meta-inner > div:first-child svg {
        width: 16px !important;
        height: 16px !important;
    }

    .article-meta-inner > div:first-child {
        gap: 6px !important;
    }

    .article-meta-inner > div:last-child {
        gap: 5px !important;
    }

    .article-share-label {
        margin-right: 1px;
        font-size: 11px !important;
        line-height: 14px !important;
        font-weight: 600 !important;
    }

    .article-meta-divider,
    .article-meta-updated,
    .article-meta-categories {
        display: none !important;
    }

    .article-cover-frame,
    .odt-article-body p:has(img),
    .odt-article-body figure,
    .odt-article-body .wp-block-image,
    .odt-article-body .kg-image-card,
    .odt-article-body p img,
    .odt-article-body figure img,
    .odt-article-body .wp-block-image img,
    .odt-article-body .kg-image-card img {
        width: 100vw !important;
        max-width: 100vw !important;
        margin-left: calc(50% - 50vw) !important;
        margin-right: calc(50% - 50vw) !important;
    }

@media (max-width: 899px) {
    .article-cover-frame {
        width: calc(100% + 24px) !important;
        margin-left: -12px !important;
        margin-right: -12px !important;
        max-width: none !important;
    }

    .article-cover-frame img {
        width: 100% !important;
        height: auto !important;
        display: block;
    }

    /* parent'ların padding'ini sıfırla */
    .article-main-column,
    .article-main-column > div,
    .article-hero-layout > div:first-child {
        padding-left: 0 !important;
        padding-right: 0 !important;
        overflow: visible !important;
    }
}

    .odt-article-body {
        padding-left: 0 !important;
        padding-right: 0 !important;
        overflow-wrap: anywhere;
        word-break: break-word;
    }

    .odt-article-body > figure,
    .odt-article-body > img,
    .odt-article-body > .article-cover-frame,
    .odt-article-body > .kg-image-card,
    .odt-article-body > .wp-block-image {
        margin-top: 0 !important;
        margin-bottom: 0 !important;
    }

    .odt-article-body iframe,
    .odt-article-body table,
    .odt-article-body video,
    .odt-article-body embed {
        max-width: 100%;
    }
}
@media (min-width: 900px) {
    .article-hero-layout {
        grid-template-columns: minmax(0, 70%) minmax(280px, 30%);
        align-items: start;
    }
}

/* Haber içi görsellerin altında oluşan fazla boşluğu kapatır. */
.odt-article-body figure,
.odt-article-body .wp-block-image,
.odt-article-body .kg-image-card,
.odt-article-body .attachment,
.odt-article-body p:has(img) {
    margin-bottom: 0 !important;
}

.odt-article-body figure figcaption {
    margin-top: .2rem !important;
}

.odt-article-body figure + p,
.odt-article-body .wp-block-image + p,
.odt-article-body .kg-image-card + p,
.odt-article-body .attachment + p,
.odt-article-body p:has(img) + p {
    margin-top: .25rem !important;
}
/* Masaustu haber yerlesimi: sol tarafta yan haberler, sagda okuma kolonu. */
@media (min-width: 900px) {
    .article-reading-theme .article-hero-layout {
        display: grid !important;
        grid-template-columns: minmax(0, 1fr) minmax(270px, 320px) !important;
        gap: 32px !important;
        align-items: start !important;
    }
    .article-reading-theme .article-hero-layout > div:first-child {
        grid-column: 1;
        grid-row: 1;
        width: auto !important;
        max-width: 100% !important;
        min-width: 0 !important;
    }
    .article-reading-theme .article-hero-layout > aside {
        grid-column: 2;
        grid-row: 1;
        width: auto !important;
        max-width: 100% !important;
        min-width: 0 !important;
    }
    .article-reading-theme .article-sidebar-stack {
        position: sticky !important;
        top: 20px;
        margin-top: 0 !important;
    }
    .article-reading-theme .article-sidebar-stack section { padding: 14px !important; }
    .article-reading-theme .article-sidebar-stack section a { align-items: flex-start; gap: 10px !important; }
    .article-reading-theme .article-sidebar-stack section a img {
        width: 76px !important;
        height: 52px !important;
    }
    .article-reading-theme .article-sidebar-stack section a p {
        font-size: 13px !important;
        line-height: 1.35 !important;
    }
}
@media (max-width: 899px) {
    .article-reading-theme .article-hero-layout { display: flex !important; flex-direction: column !important; }
    .article-reading-theme .article-hero-layout > div:first-child,
    .article-reading-theme .article-hero-layout > aside {
        width: 100% !important;
        max-width: 100% !important;
    }
}
/* Okuma sutununu daralt, Google Haberler bandini kapak gorselinin ustune al. */
.article-reading-theme .odt-article-body {
    width: 100% !important;
    max-width: 740px !important;
    margin-left: auto !important;
    margin-right: auto !important;
}
.article-reading-theme .article-source-signature,
.article-reading-theme #comments-yeni-parti-samsun-il-kongresi-sona-erdi-mehmet-ozdag-yeniden-baskan {
    width: 100% !important;
    max-width: 740px !important;
    margin-left: auto !important;
    margin-right: auto !important;
}
.article-reading-theme .google-news-feature {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    gap: 20px;
    width: 100%;
    min-height: 74px;
    margin: 0 0 18px;
    padding: 12px 18px;
    color: #f5f2ed;
    text-decoration: none;
    background: linear-gradient(105deg, #232426 0%, #183b41 100%);
    border: 1px solid #45484a;
    border-radius: 10px;
    transition: border-color .18s ease, filter .18s ease;
}
.article-reading-theme .google-news-feature:hover { border-color: #69777a; filter: brightness(1.08); }
.article-reading-theme .google-news-feature-mark {
    flex: 0 0 48px;
    font-family: Arial, sans-serif;
    font-size: 46px;
    line-height: 1;
    font-weight: 800;
    text-align: center;
    color: #4285f4;
    background: conic-gradient(from -45deg, #4285f4 0 25%, #34a853 25% 48%, #fbbc05 48% 70%, #ea4335 70% 88%, #4285f4 88%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
}
.article-reading-theme .google-news-feature-copy {
    flex: 1 1 auto;
    min-width: 0;
    font-size: clamp(16px, 2vw, 28px);
    line-height: 1.22;
    font-weight: 700;
    letter-spacing: -.015em;
}
.article-reading-theme .google-news-feature-star {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 54px;
    width: 54px;
    height: 54px;
    color: #ffc400;
    font-size: 32px;
    line-height: 1;
    background: #222;
    border: 1px solid #414141;
    border-radius: 50%;
}
@media(max-width:899px) {
    .article-reading-theme .google-news-feature { gap: 12px; min-height: 64px; padding: 10px 12px; border-radius: 8px; }
    .article-reading-theme .google-news-feature-mark { flex-basis: 36px; font-size: 38px; }
    .article-reading-theme .google-news-feature-copy { font-size: 16px; }
    .article-reading-theme .google-news-feature-star { flex-basis: 42px; width: 42px; height: 42px; font-size: 25px; }
}
@media(max-width:420px) {
    .article-reading-theme .google-news-feature { gap: 8px; padding: 9px; }
    .article-reading-theme .google-news-feature-mark { flex-basis: 30px; font-size: 32px; }
    .article-reading-theme .google-news-feature-copy { font-size: 14px; }
    .article-reading-theme .google-news-feature-star { flex-basis: 36px; width: 36px; height: 36px; font-size: 22px; }
}
/* Hizalama ve yatay tasma korumasi: piyasa seridiyle ayni 1000px konteyner */
body.article-reading-theme,
body.article-reading-theme html {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden !important;
}
body.article-reading-theme #main-wrapper {
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: 1000px !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding: 0 12px 56px !important;
    overflow-x: clip !important;
}
.article-reading-theme .article-page-root,
.article-reading-theme .article-reading-shell {
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: 100% !important;
    margin-left: auto !important;
    margin-right: auto !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    overflow-x: clip !important;
}
.article-reading-theme .article-stream-root,
.article-reading-theme .article-stream-root > .stream-article-block,
.article-reading-theme .article-main-column,
.article-reading-theme .article-hero-layout,
.article-reading-theme .article-hero-layout > div,
.article-reading-theme .article-sidebar-stack,
.article-reading-theme .odt-article-body {
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
}
.article-reading-theme .article-cover-frame,
.article-reading-theme .odt-article-body figure,
.article-reading-theme .odt-article-body .wp-block-image,
.article-reading-theme .odt-article-body .kg-image-card,
.article-reading-theme .odt-article-body .attachment,
.article-reading-theme .odt-article-body p:has(img) {
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
}
.article-reading-theme .article-cover-frame img,
.article-reading-theme .odt-article-body img,
.article-reading-theme .odt-article-body video,
.article-reading-theme .odt-article-body iframe,
.article-reading-theme .odt-article-body embed,
.article-reading-theme .odt-article-body table {
    box-sizing: border-box !important;
    max-width: 100% !important;
}
.article-reading-theme .article-cover-frame img {
    width: 100% !important;
    height: auto !important;
    aspect-ratio: 16 / 9;
    object-fit: cover;
}
.article-reading-theme .odt-article-body pre,
.article-reading-theme .odt-article-body code { overflow-wrap: anywhere; }
@media (max-width: 899px) {
    body.article-reading-theme #main-wrapper {
        width: 100% !important;
        max-width: 100% !important;
        padding: 0 12px 36px !important;
    }
    .article-reading-theme .article-reading-shell { padding-top: 20px !important; padding-bottom: 30px !important; }
    .article-reading-theme .article-cover-frame,
    .article-reading-theme .odt-article-body figure,
    .article-reading-theme .odt-article-body .wp-block-image,
    .article-reading-theme .odt-article-body .kg-image-card,
    .article-reading-theme .odt-article-body p:has(img) {
        width: 100% !important;
        max-width: 100% !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }
}

/* Yalniz haber okuma sayfasinda site header'ini koyu temaya uydur. */
body.article-reading-theme > header {
    background: #17181b !important;
    border-color: #343539 !important;
    box-shadow: none !important;
}
body.article-reading-theme > header > div { background: transparent !important; }
body.article-reading-theme > header #searchBox,
body.article-reading-theme > header #searchBox input {
    background: #232427 !important;
    color: #f3f2ef !important;
    border-color: #45464a !important;
}
body.article-reading-theme > header #searchBox input::placeholder { color: #aaa9a5 !important; }
body.article-reading-theme > nav.bg-white {
    background: #1d1e21 !important;
    border-color: #35363a !important;
}
body.article-reading-theme > nav.bg-white > div,
body.article-reading-theme > nav.bg-white > div > div { background: transparent !important; }
body.article-reading-theme > nav.bg-white a,
body.article-reading-theme > nav.bg-white button {
    color: #e8e6e1 !important;
}
body.article-reading-theme > nav.bg-white span { color: #626367 !important; }
body.article-reading-theme > nav.bg-white a:hover,
body.article-reading-theme > nav.bg-white button:hover {
    color: #fff !important;
    background-color: #303135 !important;
}
body.article-reading-theme .breaking-ticker a { color: #e8e6e1 !important; }
body.article-reading-theme .breaking-ticker a:hover { color: #fff !important; }
body.article-reading-theme > div.bg-white.text-black {
    background: #1d1e21 !important;
    color: #f0efec !important;
}
body.article-reading-theme > div.bg-white.text-black .border-t { border-color: #37383c !important; }
@media(max-width:767px) {
    body.article-reading-theme > header { border-bottom-color: #343539 !important; }
    body.article-reading-theme > nav.bg-white { border-bottom: 1px solid #343539; }
}

/* Haber okuma sayfasinda emtia bandi ve footer da koyu temayi izler. */
body.article-reading-theme .market-tape {
    background: #17181b !important;
    color: #f0efec !important;
    border-bottom-color: #35363a !important;
}
body.article-reading-theme .market-tape-card {
    background: #222326 !important;
    color: #f0efec !important;
    border-color: #3a3b3f !important;
}
body.article-reading-theme .market-tape-name { color: #aaa9a5 !important; }
body.article-reading-theme .market-tape-price { color: #f5f3ef !important; }
body.article-reading-theme .market-tape-change.flat {
    color: #c4c2bd !important;
    background: #343539 !important;
}
body.article-reading-theme .market-tape-change.up {
    color: #48c77b !important;
    background: #183326 !important;
}
body.article-reading-theme .market-tape-change.down {
    color: #e30613 !important;
    background: #3a2224 !important;
}
body.article-reading-theme > footer {
    color: #b9b8b4 !important;
    background: #111214 !important;
    border-top-color: #35363a !important;
}
body.article-reading-theme > footer > div { background: transparent !important; }
body.article-reading-theme > footer p,
body.article-reading-theme > footer a { color: #b9b8b4 !important; }
body.article-reading-theme > footer h4 { color: #f0efec !important; }
body.article-reading-theme > footer .border-t { border-color: #35363a !important; }
body.article-reading-theme > footer .text-gray-500 { color: #8c8b87 !important; }

/* Okuma metni daha sıkı; yan haber sütunu sağda. */
.article-reading-theme .odt-article-body p {
    font-size: 17px !important;
    line-height: 1.58 !important;
}
.article-reading-theme .google-news-feature {
    min-height: 58px !important;
    padding-top: 8px !important;
    padding-bottom: 8px !important;
    gap: 14px !important;
}
.article-reading-theme .google-news-feature-copy {
    font-size: 13px !important;
    font-weight: 600 !important;
}
.article-reading-theme .google-news-feature-mark { font-size: 38px !important; }
.article-reading-theme .google-news-feature-star {
    flex-basis: 44px !important;
    width: 44px !important;
    height: 44px !important;
    font-size: 26px !important;
}
@media (max-width: 899px) {
    .article-reading-theme .odt-article-body p { font-size: 16px !important; line-height: 1.58 !important; }
    .article-reading-theme .google-news-feature { min-height: 54px !important; gap: 10px !important; }
    .article-reading-theme .google-news-feature-copy { font-size: 13px !important; }
    .article-reading-theme .google-news-feature-mark { font-size: 34px !important; }
    .article-reading-theme .google-news-feature-star {
        flex-basis: 40px !important;
        width: 40px !important;
        height: 40px !important;
        font-size: 23px !important;
    }
}

/* Sonsuz kaydirmayla eklenen haber basligi da koyu temada acik kalir. */
.article-reading-theme .stream-article-block .stream-article header h2 {
    color: #f5f3ef !important;
}

/* Sonsuz akisla eklenen haberleri ilk haberle ayni okuma tasarimina bagla. */
.article-reading-theme .stream-article-block {
    color: #f0efec !important;
    background: #17181b !important;
}
.article-reading-theme .stream-article {
    border-color: #3a3b3e !important;
    color: #f0efec !important;
}
.article-reading-theme .stream-article nav,
.article-reading-theme .stream-article nav a,
.article-reading-theme .stream-article nav span { color: #aaa9a5 !important; }
.article-reading-theme .stream-article header {
    max-width: 100% !important;
    margin: 0 auto 20px !important;
}
.article-reading-theme .stream-article header h2 {
    width: 100%;
    max-width: none;
    margin-left: 0 !important;
    margin-right: 0 !important;
    text-align: left !important;
    color: #f5f3ef !important;
    font-size: clamp(30px, 3.8vw, 48px) !important;
    line-height: 1.12 !important;
    font-weight: 800 !important;
}
.article-reading-theme .stream-article .article-summary {
    max-width: 760px !important;
    margin: 12px auto 0 !important;
    color: #c9c7c3 !important;
    font-size: 18px !important;
    line-height: 1.5 !important;
}
.article-reading-theme .stream-article .article-meta-bar { border-color: #3a3b3e !important; }
.article-reading-theme .stream-article .article-meta-bar span { color: #c5c3bf !important; }
.article-reading-theme .stream-article .article-meta-divider { background: #55565a !important; }
.article-reading-theme .stream-article .article-share-label { color: #e6e4df !important; }
.article-reading-theme .stream-article .article-sidebar-stack section h3,
.article-reading-theme .stream-article .article-sidebar-stack section p,
.article-reading-theme .stream-article [id^="comments-"] h3,
.article-reading-theme .stream-article [id^="comments-"] h4,
.article-reading-theme .stream-article [id^="comments-"] p {
    color: #e5e3de !important;
}
.article-reading-theme .stream-article .article-sidebar-stack section,
.article-reading-theme .stream-article [id^="comments-"] input,
.article-reading-theme .stream-article [id^="comments-"] textarea {
    background: #202124 !important;
    border-color: #38393c !important;
    color: #f5f3ef !important;
}
.article-reading-theme .stream-article .article-sidebar-stack section a { border-color: #38393c !important; }
.article-reading-theme .stream-article .article-sidebar-stack section a:hover { background: #292a2d !important; }
.article-reading-theme .stream-article .article-sidebar-stack section a:hover p { color: #ff4a50 !important; }
.article-reading-theme .stream-article .article-content-body p {
    color: #e0ded9 !important;
    font-size: 17px !important;
    line-height: 1.58 !important;
}
.article-reading-theme .stream-article .article-content-body h2,
.article-reading-theme .stream-article .article-content-body h3,
.article-reading-theme .stream-article .article-content-body h4 { color: #f5f3ef !important; }
@media(max-width:899px) {
    .article-reading-theme .stream-article header h2 { font-size: clamp(28px, 7.5vw, 38px) !important; }
    .article-reading-theme .stream-article .article-summary { font-size: 16px !important; }
    .article-reading-theme .stream-article .article-content-body p { font-size: 16px !important; }
}

.article-reading-theme .article-tags {
    box-sizing: border-box;
    margin-top: 14px !important;
    margin-bottom: 5px !important;
    padding: 13px 0 6px !important;
    border-color: #3a3b3e !important;
}
.article-reading-theme .article-tags a {
    display: inline-block;
    padding: 5px 10px !important;
    line-height: 1.35 !important;
    border-radius: 7px;
}

/* Use Google's current full-colour G asset rather than styling a letter. */
.article-reading-theme .google-news-feature img.google-news-feature-mark {
    display: block !important;
    flex: 0 0 48px !important;
    width: 48px !important;
    height: 49px !important;
    max-width: none !important;
    padding: 0 !important;
    object-fit: contain !important;
    background: none !important;
    -webkit-background-clip: border-box !important;
    background-clip: border-box !important;
    -webkit-text-fill-color: initial !important;
}
@media (max-width: 899px) {
    .article-reading-theme .google-news-feature img.google-news-feature-mark {
        flex-basis: 40px !important;
        width: 40px !important;
        height: 41px !important;
    }
}
@media (max-width: 420px) {
    .article-reading-theme .google-news-feature img.google-news-feature-mark {
        flex-basis: 34px !important;
        width: 34px !important;
        height: 35px !important;
    }
}

/* Infinite akista spot ana haber basligiyla ayni sol kenardan baslasin. */
.article-reading-theme .stream-article .article-summary {
    display: block !important;
    box-sizing: border-box !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 12px 0 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    text-align: left !important;
}

/* Koyu temada daha belirgin, dengeli son dakika bandi */
body.article-reading-theme .breaking-news-bar {
    position: relative;
    margin: 0 0 10px !important;
    padding: 7px 0 !important;
    color: #f4f1ee !important;
    background: linear-gradient(100deg, #251619 0%, #1c1d20 46%, #1c1d20 100%) !important;
    border-top: 1px solid #39363a;
    border-bottom: 1px solid #39363a;
}
body.article-reading-theme .breaking-news-bar::before {
    position: absolute;
    top: -1px;
    left: 0;
    right: 0;
    height: 2px;
    content: "";
    background: linear-gradient(90deg, #e30613 0%, #e30613 22%, rgba(227,6,19,0) 78%);
}
body.article-reading-theme .breaking-news-bar > div:first-child { display: none; }
body.article-reading-theme .breaking-news-row {
    gap: 12px !important;
    min-height: 34px;
    padding-top: 0 !important;
}
body.article-reading-theme .breaking-news-label {
    flex: 0 0 auto;
    gap: 7px !important;
    padding: 7px 10px !important;
    color: #fff !important;
    background: linear-gradient(135deg, #e30613 0%, #e30613 100%) !important;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 5px !important;
    box-shadow: 0 2px 10px rgba(227,6,19,.2);
    font-size: 10px !important;
    font-weight: 800 !important;
    letter-spacing: .055em;
}
body.article-reading-theme .breaking-live-dot {
    width: 6px !important;
    height: 6px !important;
    flex: 0 0 6px;
    background: #fff !important;
    box-shadow: 0 0 0 3px rgba(255,255,255,.14);
}
body.article-reading-theme .breaking-news-window {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    padding: 7px 0;
    -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 94%, transparent 100%);
    mask-image: linear-gradient(90deg, #000 0%, #000 94%, transparent 100%);
}
body.article-reading-theme .breaking-news-window .breaking-ticker {
    align-items: center;
    gap: 36px !important;
}
body.article-reading-theme .breaking-news-window .breaking-ticker a {
    color: #ece9e5 !important;
    font-size: 12px !important;
    font-weight: 600;
    letter-spacing: .005em;
    text-decoration: none;
}
body.article-reading-theme .breaking-news-window .breaking-ticker a:hover {
    color: #fff !important;
    text-decoration: underline;
    text-decoration-color: #e30613;
    text-underline-offset: 3px;
}
@media(max-width:640px) {
    body.article-reading-theme .breaking-news-bar { padding: 6px 0 !important; }
    body.article-reading-theme .breaking-news-row { gap: 9px !important; padding-left: 12px; padding-right: 12px; }
    body.article-reading-theme .breaking-news-label { padding: 6px 8px !important; font-size: 9px !important; }
    body.article-reading-theme .breaking-news-window .breaking-ticker { gap: 24px !important; }
    body.article-reading-theme .breaking-news-window .breaking-ticker a { font-size: 11px !important; }
}

/* Okuma sayfasi tipografi: spot 3px, govde 1px, ara basliklar 2px daha kucuk. */
.article-reading-theme .article-summary { font-size: clamp(13px, calc(2vw - 6px), 18px) !important; line-height: calc(1.44em + 1px) !important; }
.article-reading-theme .stream-article .article-summary { max-width: 1000px !important; font-size: clamp(13px, calc(2vw - 6px), 18px) !important; line-height: calc(1.44em + 1px) !important; }
.article-reading-theme .odt-article-body p,
.article-reading-theme .stream-article .article-content-body p { font-size: 15px !important; }
.article-reading-theme .odt-article-body h2,
.article-reading-theme .odt-article-body h3,
.article-reading-theme .odt-article-body h4,
.article-reading-theme .stream-article .article-content-body h2,
.article-reading-theme .stream-article .article-content-body h3,
.article-reading-theme .stream-article .article-content-body h4 { font-size: 17px !important; }
@media (max-width: 899px) {
    .article-reading-theme .article-summary { font-size: 12px !important; line-height: calc(1.44em + 1px) !important; }
    .article-reading-theme .stream-article .article-summary { font-size: 12px !important; }
    .article-reading-theme .odt-article-body p,
    .article-reading-theme .stream-article .article-content-body p { font-size: 14px !important; }
    .article-reading-theme .odt-article-body h2,
    .article-reading-theme .odt-article-body h3,
    .article-reading-theme .odt-article-body h4,
    .article-reading-theme .stream-article .article-content-body h2,
    .article-reading-theme .stream-article .article-content-body h3,
    .article-reading-theme .stream-article .article-content-body h4 { font-size: 14px !important; }
}

/* Etiket renkleri gece/gunduz temasina uyar. */
.article-reading-theme .article-tags { border-color: #3a3b3e !important; }
.article-reading-theme .article-tags a {
    padding: 3px 7px !important;
    font-size: 12px !important;
    line-height: 1.2 !important;
    border-radius: 5px !important;
    background: #252629 !important;
    color: #e6e4df !important;
    border: 1px solid #3a3b3e !important;
}
.article-reading-theme .article-tags a:hover,
.article-reading-theme .article-tags a:focus-visible {
    background: #404349 !important;
    color: #fff !important;
    border-color: #565a62 !important;
}
html[data-theme="light"] body.article-reading-theme .article-tags { border-color: #e5e7eb !important; }
html[data-theme="light"] body.article-reading-theme .article-tags a {
    background: #f3f4f6 !important;
    color: #303238 !important;
    border-color: #e5e7eb !important;
}
html[data-theme="light"] body.article-reading-theme .article-tags a:hover,
html[data-theme="light"] body.article-reading-theme .article-tags a:focus-visible {
    background: #e30613 !important;
    color: #fff !important;
    border-color: #e30613 !important;
}
/* Ana haber basligini govde tipografisiyle daha dengeli tut. */
.article-reading-theme .article-reading-shell > header h1 {
    font-size: clamp(26px, calc(3.8vw - 6px), 46px) !important;
}
@media (max-width: 899px) {
    .article-reading-theme .article-reading-shell > header h1 {
        font-size: clamp(22px, calc(7vw - 6px), 32px) !important;
    }
}

/* Haber basligi ile spot arasi bosluk */
.article-reading-theme .article-reading-shell > header .article-summary,
.article-reading-theme .stream-article header .article-summary {
    margin-top: 14px !important;
}
@media (max-width: 899px) {
    .article-reading-theme .article-reading-shell > header .article-summary {
        margin-top: 12px !important;
    }
}

/* Sonsuz akistaki haber basligini ilk haberle ayni olculere getir. */
.article-reading-theme .stream-article > nav {
    margin: 0 auto 20px !important;
    color: #aaa !important;
    font-size: 12px !important;
}
.article-reading-theme .stream-article > header {
    max-width: 1080px !important;
    margin: 0 auto 22px !important;
}
.article-reading-theme .stream-article > header h2 {
    font-size: clamp(26px, calc(3.8vw - 6px), 46px) !important;
    line-height: 1.08 !important;
    font-weight: 800 !important;
    letter-spacing: -.035em !important;
}
@media (max-width: 899px) {
    .article-reading-theme .stream-article > nav { margin-bottom: 16px !important; }
    .article-reading-theme .stream-article > header { margin-bottom: 16px !important; }
    .article-reading-theme .stream-article > header h2 {
        font-size: clamp(22px, calc(7vw - 6px), 32px) !important;
        line-height: 1.12 !important;
    }
}
/* Mobil haber okuma: tipografi ve yorumlar dengelendi. */
@media (max-width: 899px) {
    .article-reading-theme .article-reading-shell > nav[aria-label="Breadcrumb"] { font-size: 8.9px !important; }
    .article-reading-theme .stream-article > nav[aria-label="Breadcrumb"] { font-size: 10px !important; }
    .article-reading-theme .article-published-at,
    .article-reading-theme .stream-article .article-meta-left > span:not(.article-meta-divider) { font-size: 11px !important; }
    .article-reading-theme .article-meta-bar span,
    .article-reading-theme .article-meta-bar a,
    .article-reading-theme .article-meta-bar button { line-height: 1.3 !important; }
    .article-reading-theme .article-reading-shell > header .article-summary,
    .article-reading-theme .stream-article > header .article-summary { font-size: 15px !important; line-height: calc(1.44em - 1px) !important; }
    .article-reading-theme .google-news-feature-copy { font-size: 11px !important; }
    .article-reading-theme .odt-article-body p,
    .article-reading-theme .stream-article .article-content-body p { line-height: calc(1.58em - 1px) !important; }
    .article-reading-theme [id^="comments-"] h3,
    .article-reading-theme [id^="comments-"] h4 { font-size: 16px !important; line-height: 1.3 !important; }
    .article-reading-theme [id^="comments-"] .text-sm { font-size: 13px !important; line-height: 1.45 !important; }
    .article-reading-theme [id^="comments-"] .text-xs { font-size: 11px !important; line-height: 1.35 !important; }
    .article-reading-theme [id^="comments-"] label { font-size: 13px !important; }
    .article-reading-theme [id^="comments-"] input,
    .article-reading-theme [id^="comments-"] textarea { font-size: 14px !important; line-height: 1.4 !important; }
    .article-reading-theme [id^="comments-"] input::placeholder,
    .article-reading-theme [id^="comments-"] textarea::placeholder { font-size: 13px !important; }
    .article-reading-theme [id^="comments-"] button { font-size: 13px !important; line-height: 1.3 !important; }
}
/* Son mobil tipografi ayari */
@media (max-width: 899px) {
    .article-reading-theme .article-reading-shell > header h1,
    .article-reading-theme .stream-article > header h2 { font-size: clamp(32px, calc(7vw + 4px), 42px) !important; }
    .article-reading-theme .odt-article-body h2,
    .article-reading-theme .odt-article-body h3,
    .article-reading-theme .odt-article-body h4,
    .article-reading-theme .stream-article .article-content-body h2,
    .article-reading-theme .stream-article .article-content-body h3,
    .article-reading-theme .stream-article .article-content-body h4 {
        font-size: 18px !important;
        line-height: 1.25 !important;
    }
    .article-reading-theme .article-reading-shell > header .article-summary,
    .article-reading-theme .stream-article > header .article-summary { font-size: 16px !important; font-weight: 500 !important; }
    .article-reading-theme .odt-article-body p,
    .article-reading-theme .stream-article .article-content-body p,
    .article-reading-theme .odt-article-body ul,
    .article-reading-theme .odt-article-body ol,
    .article-reading-theme .odt-article-body li,
    .article-reading-theme .stream-article .article-content-body ul,
    .article-reading-theme .stream-article .article-content-body ol,
    .article-reading-theme .stream-article .article-content-body li {
        font-size: 16px !important;
        line-height: 23px !important;
        font-weight: 400 !important;
        letter-spacing: 0 !important;
    }
    .article-reading-theme .article-page-root .odt-article-body > blockquote,
    .article-reading-theme .article-page-root .odt-article-body blockquote,
    .article-reading-theme .stream-article .article-content-body blockquote,
    .article-reading-theme .stream-article .article-content-body blockquote p {
        font-size: 16px !important;
        line-height: 23px !important;
        font-weight: 400 !important;
        font-style: normal !important;
    }
    .article-reading-theme .article-page-root .odt-article-body blockquote,
    .article-reading-theme .stream-article .article-content-body blockquote {
        border-left-width: 3px !important;
        padding: .75rem 1rem .75rem 24px !important;
        margin: 1.35rem 0 1.55rem !important;
    }
    .article-reading-theme .odt-article-body figure figcaption,
    .article-reading-theme .stream-article .article-content-body figure figcaption {
        font-size: 13px !important;
        line-height: 1.45 !important;
    }
    .article-reading-theme .odt-article-body .article-gallery-caption,
    .article-reading-theme .stream-article .article-content-body .article-gallery-caption {
        font-size: 15.5px !important;
        line-height: 1.58 !important;
    }
    .article-reading-theme .article-published-at,
    .article-reading-theme .stream-article .article-meta-left > span:not(.article-meta-divider) { font-size: 9px !important; }
}
/* Mobilde breadcrumb bosluklarini dengeli daralt. */
@media (max-width: 899px) {
    .article-reading-theme .article-reading-shell { padding-top: 10px !important; }
    .article-reading-theme .article-reading-shell > nav { margin-top: 0 !important; margin-bottom: 8px !important; }
    .article-reading-theme .stream-article > nav { margin-top: 0 !important; margin-bottom: 8px !important; }
    .article-reading-theme .stream-article > header { margin-top: 0 !important; margin-bottom: 12px !important; }
    .article-reading-theme .article-meta-bar { padding: 2px var(--mobile-meta-gutter, 2px) !important; }
}

/* Başlık ritmi Diye Konuştu haber gövdesiyle eşit tutulur. */
.odt-article-body h2,
.odt-article-body h3,
.odt-article-body h4,
.article-reading-theme .stream-article .article-content-body h2,
.article-reading-theme .stream-article .article-content-body h3,
.article-reading-theme .stream-article .article-content-body h4 {
    margin: 22px 0 13px !important;
    line-height: 1.25 !important;
}
.odt-article-body h2 + p,
.odt-article-body h3 + p,
.odt-article-body h4 + p,
.article-reading-theme .stream-article .article-content-body h2 + p,
.article-reading-theme .stream-article .article-content-body h3 + p,
.article-reading-theme .stream-article .article-content-body h4 + p {
    margin-top: 0 !important;
}
.article-reading-theme .article-sidebar-stack section a p {
    font-size: 14px !important;
    line-height: 1.375 !important;
    font-weight: 600 !important;
}
@media (max-width: 768px) {
    .article-reading-theme .article-sidebar-stack section a p {
        font-size: 12px !important;
        line-height: 1.25 !important;
        font-weight: 600 !important;
    }
}

 /* Cover art should bleed through the article shell padding. */
.article-reading-theme .article-cover-frame {
    box-sizing:border-box !important;
    width:calc(100% + 56px) !important;
    max-width:none !important;
    margin:0 -28px 28px !important;
    border-radius:0 !important;
}
.article-reading-theme .article-cover-frame img {
    display:block !important;
    width:100% !important;
    max-width:none !important;
    margin:0 !important;
    border-radius:0 !important;
}
@media(max-width:899px) {
    .article-reading-theme .article-cover-frame {
        width:100vw !important;
        max-width:100vw !important;
        margin-top:0 !important;
        margin-bottom:24px !important;
        margin-left:calc(50% - 50vw) !important;
        margin-right:calc(50% - 50vw) !important;
    }
}
/* Koyu modda sert beyaz ayraçları okuma paletine yaklaştır. */
html[data-theme="dark"] body.article-reading-theme .article-reading-shell .border-gray-200 {
    border-color: #36373b !important;
}

/* Samsun yerel rehber bağlantıları: haber sonundaki sonraki okuma alanı. */
.article-reading-theme .so-local-guides{max-width:760px;margin:24px auto 18px;padding:12px 13px;border:1px solid #3a3b3e;background:#202124}.article-reading-theme .so-local-guides-title{display:flex;align-items:center;gap:7px;margin-bottom:9px;color:#f0eeea;font-size:12px;font-weight:850;letter-spacing:.035em}.article-reading-theme .so-local-guides-title>span{width:8px;height:8px;border-radius:50%;background:#e30613}.article-reading-theme .so-local-guides-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.article-reading-theme .so-local-guide-link{display:flex;min-width:0;flex-direction:column;gap:3px;padding:9px;border:1px solid #3a3b3e;background:#292a2d;color:#f0eeea;text-decoration:none;transition:border-color .16s ease,background .16s ease}.article-reading-theme .so-local-guide-link:hover{border-color:#e30613;background:#303136;color:#fff}.article-reading-theme .so-local-guide-link strong{font-size:12px;line-height:1.2}.article-reading-theme .so-local-guide-link small{color:#b5b4b0;font-size:10px;line-height:1.3}html[data-theme="light"] body.article-reading-theme .so-local-guides{border-color:#e5e7eb;background:#fafafa}html[data-theme="light"] body.article-reading-theme .so-local-guides-title,html[data-theme="light"] body.article-reading-theme .so-local-guide-link{color:#1f2937}html[data-theme="light"] body.article-reading-theme .so-local-guide-link{border-color:#e1e5ea;background:#fff}html[data-theme="light"] body.article-reading-theme .so-local-guide-link:hover{border-color:#e30613;background:#fff7f8}html[data-theme="light"] body.article-reading-theme .so-local-guide-link small{color:#6b7280}@media(max-width:640px){.article-reading-theme .so-local-guides{margin:18px auto 14px;padding:10px}.article-reading-theme .so-local-guides-list{grid-template-columns:1fr;gap:5px}.article-reading-theme .so-local-guide-link{padding:8px 9px}}

/* Okuma ritmi: başlık ve medya modülleri her haberde aynı nefes aralığını kullanır. */
.article-reading-theme .article-reading-shell > header h1,
.article-reading-theme .stream-article > header h2 {
    letter-spacing: -.012em !important;
}
.article-reading-theme .odt-article-body > figure,
.article-reading-theme .odt-article-body > .wp-block-image,
.article-reading-theme .odt-article-body > .kg-image-card,
.article-reading-theme .odt-article-body > .attachment,
.article-reading-theme .odt-article-body > .article-inline-embed,
.article-reading-theme .odt-article-body > .dk-inline-video,
.article-reading-theme .odt-article-body > p:has(img),
.article-reading-theme .odt-article-body > video,
.article-reading-theme .odt-article-body > iframe,
.article-reading-theme .odt-article-body > table,
.article-reading-theme .odt-article-body > .table-wrapper,
.article-reading-theme .odt-article-body > blockquote,
.article-reading-theme .stream-article .article-content-body > figure,
.article-reading-theme .stream-article .article-content-body > .wp-block-image,
.article-reading-theme .stream-article .article-content-body > .kg-image-card,
.article-reading-theme .stream-article .article-content-body > .attachment,
.article-reading-theme .stream-article .article-content-body > .article-inline-embed,
.article-reading-theme .stream-article .article-content-body > .dk-inline-video,
.article-reading-theme .stream-article .article-content-body > p:has(img),
.article-reading-theme .stream-article .article-content-body > video,
.article-reading-theme .stream-article .article-content-body > iframe,
.article-reading-theme .stream-article .article-content-body > table,
.article-reading-theme .stream-article .article-content-body > .table-wrapper,
.article-reading-theme .stream-article .article-content-body > blockquote {
    margin-top: 22px !important;
    margin-bottom: 22px !important;
}
.article-reading-theme .odt-article-body > figure + p,
.article-reading-theme .odt-article-body > .wp-block-image + p,
.article-reading-theme .odt-article-body > .kg-image-card + p,
.article-reading-theme .odt-article-body > .attachment + p,
.article-reading-theme .odt-article-body > .article-inline-embed + p,
.article-reading-theme .odt-article-body > .dk-inline-video + p,
.article-reading-theme .odt-article-body > p:has(img) + p,
.article-reading-theme .stream-article .article-content-body > figure + p,
.article-reading-theme .stream-article .article-content-body > .wp-block-image + p,
.article-reading-theme .stream-article .article-content-body > .kg-image-card + p,
.article-reading-theme .stream-article .article-content-body > .attachment + p,
.article-reading-theme .stream-article .article-content-body > .article-inline-embed + p,
.article-reading-theme .stream-article .article-content-body > .dk-inline-video + p,
.article-reading-theme .stream-article .article-content-body > p:has(img) + p {
    margin-top: 0 !important;
}
html[data-theme="dark"] body.article-reading-theme .article-reading-shell .border-gray-100 {
    border-color: #2d2e32 !important;
}
html[data-theme="dark"] body.article-reading-theme .article-reading-shell .border-gray-300 {
    border-color: #45474c !important;
}
html[data-theme="dark"] body.article-reading-theme [id^="comments-"] input,
html[data-theme="dark"] body.article-reading-theme [id^="comments-"] textarea {
    background: #202124 !important;
    color: #e6e5e1 !important;
}
</style>
<style>
.article-cover-video-frame{position:relative;overflow:hidden;background:#050505}.article-cover-video-frame video{display:block!important;width:100%!important;max-width:none!important;aspect-ratio:16/9;height:auto!important;margin:0!important;border-radius:0!important;background:#050505;object-fit:cover}.article-cover-video-frame.is-playing video{object-fit:contain}.so-cover-video-start{position:absolute;left:50%;top:50%;z-index:2;display:flex;align-items:center;justify-content:center;width:68px;height:68px;padding:0;border:1px solid rgba(255,255,255,.72);border-radius:50%;background:rgba(179,15,24,.90);box-shadow:0 8px 28px rgba(0,0,0,.34);transform:translate(-50%,-50%);transition:opacity .18s ease,transform .18s ease}.so-cover-video-start span{display:block;width:0;height:0;margin-left:5px;border-top:12px solid transparent;border-bottom:12px solid transparent;border-left:18px solid #fff}.article-cover-video-frame.is-playing .so-cover-video-start{opacity:0;pointer-events:none;transform:translate(-50%,-50%) scale(.88)}@media(max-width:640px){.so-cover-video-start{width:56px;height:56px}.so-cover-video-start span{border-top-width:10px;border-bottom-width:10px;border-left-width:16px}}
</style>
