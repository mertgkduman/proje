    width:100% !important;
    margin:0 0 10px !important;
    padding:7px 0 !important;
    color:#f4f1ee !important;
    background:linear-gradient(100deg,#251619 0%,#1c1d20 46%,#1c1d20 100%) !important;
    border-top:1px solid #39363a !important;
    border-bottom:1px solid #39363a !important;
}
html[data-theme="light"] body .breaking-news-bar {
    color:#202124 !important;
    background:#fff !important;
    border-color:#e5e7eb !important;
}
body .breaking-news-bar::before,
body.home-dark-theme .breaking-news-bar::before,
body.article-reading-theme .breaking-news-bar::before,
body.listing-dark-theme .breaking-news-bar::before {
    position:absolute !important;
    top:-1px !important;
    left:0 !important;
    right:0 !important;
    display:block !important;
    height:2px !important;
    content:"" !important;
    background:linear-gradient(90deg,#e30613 0%,#e30613 22%,rgba(227,6,19,0) 78%) !important;
}
body .breaking-news-bar > div:first-child,
body.home-dark-theme .breaking-news-bar > div:first-child,
body.article-reading-theme .breaking-news-bar > div:first-child,
body.listing-dark-theme .breaking-news-bar > div:first-child {
    display:none !important;
}
body .breaking-news-bar .breaking-news-row,
body.home-dark-theme .breaking-news-bar .breaking-news-row,
body.article-reading-theme .breaking-news-bar .breaking-news-row,
body.listing-dark-theme .breaking-news-bar .breaking-news-row {
    display:flex !important;
    align-items:center !important;
    box-sizing:border-box !important;
    width:100% !important;
    max-width:1000px !important;
    height:34px !important;
    min-height:34px !important;
    max-height:34px !important;
    margin:0 auto !important;
    padding:0 12px !important;
    gap:12px !important;
}
body .breaking-news-bar .breaking-news-label,
body.home-dark-theme .breaking-news-bar .breaking-news-label,
body.article-reading-theme .breaking-news-bar .breaking-news-label,
body.listing-dark-theme .breaking-news-bar .breaking-news-label {
    box-sizing:border-box !important;
    display:inline-flex !important;
    align-items:center !important;
    justify-content:center !important;
    flex:0 0 120px !important;
    width:120px !important;
    min-width:120px !important;
    max-width:120px !important;
    height:32px !important;
    min-height:32px !important;
    max-height:32px !important;
    padding:0 6px !important;
    gap:7px !important;
    overflow:hidden !important;
    white-space:nowrap !important;
    border:1px solid rgba(255,255,255,.14) !important;
    border-radius:5px !important;
    box-shadow:0 2px 10px rgba(227,6,19,.2) !important;
    color:#fff !important;
    -webkit-text-fill-color:#fff !important;
    background:linear-gradient(135deg,#e30613 0%,#e30613 100%) !important;
    font-size:10px !important;
    font-weight:800 !important;
    line-height:1 !important;
    letter-spacing:.055em !important;
    transition:none !important;
    animation:none !important;
}
html[data-theme="light"] body .breaking-news-bar .breaking-news-label,
html[data-theme="light"] body .breaking-news-bar .breaking-news-label * {
    color:#fff !important;
    -webkit-text-fill-color:#fff !important;
}
body .breaking-news-bar .breaking-live-dot {
    box-sizing:border-box !important;
    flex:0 0 6px !important;
    width:6px !important;
    min-width:6px !important;
    height:6px !important;
    min-height:6px !important;
    margin:0 !important;
    background:#fff !important;
    box-shadow:0 0 0 3px rgba(255,255,255,.14) !important;
    animation:none !important;
}
body .breaking-news-bar .breaking-news-window,
body.home-dark-theme .breaking-news-bar .breaking-news-window,
body.article-reading-theme .breaking-news-bar .breaking-news-window,
body.listing-dark-theme .breaking-news-bar .breaking-news-window {
    position:relative !important;
    display:block !important;
    flex:1 1 auto !important;
    min-width:0 !important;
    height:34px !important;
    padding:7px 0 !important;
    overflow:hidden !important;
    -webkit-mask-image:linear-gradient(90deg,#000 0%,#000 94%,transparent 100%);
    mask-image:linear-gradient(90deg,#000 0%,#000 94%,transparent 100%);
}
body .breaking-news-bar .breaking-ticker,
body.home-dark-theme .breaking-news-bar .breaking-ticker,
body.article-reading-theme .breaking-news-bar .breaking-ticker,
body.listing-dark-theme .breaking-news-bar .breaking-ticker {
    display:flex !important;
    align-items:center !important;
    gap:0 !important;
    height:100% !important;
    animation: ticker 20s linear infinite !important;
}
body .breaking-news-bar .breaking-track,
body.home-dark-theme .breaking-news-bar .breaking-track,
body.article-reading-theme .breaking-news-bar .breaking-track,
body.listing-dark-theme .breaking-news-bar .breaking-track {
    display:flex !important;
    flex:0 0 auto !important;
    align-items:center !important;
    height:100% !important;
    gap:40px !important;
    padding-right:40px !important;
}
body .breaking-news-bar .breaking-news-window .breaking-ticker a,
body.home-dark-theme .breaking-news-bar .breaking-news-window .breaking-ticker a,
body.article-reading-theme .breaking-news-bar .breaking-news-window .breaking-ticker a,
body.listing-dark-theme .breaking-news-bar .breaking-news-window .breaking-ticker a {
    flex:0 0 auto !important;
    color:#ece9e5 !important;
    font-size:12px !important;
    font-weight:600 !important;
    line-height:1.2 !important;
    text-decoration:none !important;
}
html[data-theme="light"] body .breaking-news-bar .breaking-news-window .breaking-ticker a {
    color:#202124 !important;
}
body .market-tape { margin-top:0 !important; }
body .market-tape-inner {
    box-sizing:border-box !important;
    width:100% !important;
    max-width:1000px !important;
    margin:0 auto !important;
}
@media(max-width:767px) {
    body > header #searchBox {
        flex:0 0 40px !important;
        width:40px !important;
        min-width:40px !important;
        max-width:40px !important;
        border:0 !important;
        background:transparent !important;
        overflow:visible !important;
    }
    body > header #searchBox input { display:none !important; }
    body > nav.bg-white[class~="hidden"],
    body > nav.bg-white[class~="md:block"] { display:none !important; }
    body > nav.bg-white[class~="md:hidden"] { display:block !important; }
    body > nav.bg-white[class~="md:hidden"] > div > div {
        height:32px !important;
        min-height:32px !important;
        max-height:32px !important;
    }
    body .breaking-news-bar,
    body.home-dark-theme .breaking-news-bar,
    body.article-reading-theme .breaking-news-bar,
    body.listing-dark-theme .breaking-news-bar {
        margin-bottom:4px !important;
        padding:3px 0 !important;
    }
    body .breaking-news-bar .breaking-news-row,
    body.home-dark-theme .breaking-news-bar .breaking-news-row,
    body.article-reading-theme .breaking-news-bar .breaking-news-row,
    body.listing-dark-theme .breaking-news-bar .breaking-news-row {
        height:26px !important;
        min-height:26px !important;
        max-height:26px !important;
        gap:7px !important;
        padding:0 12px !important;
    }
    body .breaking-news-bar .breaking-news-label,
    body.home-dark-theme .breaking-news-bar .breaking-news-label,
    body.article-reading-theme .breaking-news-bar .breaking-news-label,
    body.listing-dark-theme .breaking-news-bar .breaking-news-label {
        flex:0 0 78px !important;
        width:78px !important;
        min-width:78px !important;
        max-width:78px !important;
        height:22px !important;
        min-height:22px !important;
        max-height:22px !important;
        padding:0 4px !important;
        gap:4px !important;
        font-size:7px !important;
    }
    body .breaking-news-bar .breaking-news-window,
    body.home-dark-theme .breaking-news-bar .breaking-news-window,
    body.article-reading-theme .breaking-news-bar .breaking-news-window,
    body.listing-dark-theme .breaking-news-bar .breaking-news-window {
        height:26px !important;
        padding:3px 0 !important;
    }
    body .breaking-news-bar .breaking-news-window .breaking-ticker a,
    body.home-dark-theme .breaking-news-bar .breaking-news-window .breaking-ticker a,
    body.article-reading-theme .breaking-news-bar .breaking-news-window .breaking-ticker a,
    body.listing-dark-theme .breaking-news-bar .breaking-news-window .breaking-ticker a {
        font-size:9px !important;
        line-height:1.2 !important;
    }
    body .market-tape { margin-top:0 !important; padding-top:0 !important; }
    body .market-tape-inner { padding:0 8px 4px !important; }
}
</style>

<style id="archive-pagination-overflow-guard">
/* Keep archive pagination inside the page width; wrap controls instead of widening the viewport. */

body.listing-dark-theme #main-wrapper {
    box-sizing:border-box !important;
    width:100% !important;
    max-width:1000px !important;
    margin-left:auto !important;
    margin-right:auto !important;
    padding-left:12px !important;
    padding-right:12px !important;
    overflow-x:clip !important;
}

body.listing-dark-theme #main-wrapper {
    box-sizing:border-box !important;
    min-width:0 !important;
    max-width:1000px !important;
}
body.listing-dark-theme .archive-page,
body.listing-dark-theme .archive-pagination {
    box-sizing:border-box !important;
    min-width:0 !important;
    max-width:100% !important;
}
body.listing-dark-theme .archive-pagination {
    width:100% !important;
    overflow:hidden !important;
}
body.listing-dark-theme .archive-pagination nav {
    display:block !important;
    box-sizing:border-box !important;
    width:100% !important;
    max-width:100% !important;
    min-width:0 !important;
    overflow:hidden !important;
}
body.listing-dark-theme .archive-pagination nav > div:first-child {
    display:flex !important;
    box-sizing:border-box !important;
    width:100% !important;
    max-width:100% !important;
    min-width:0 !important;
    justify-content:center !important;
}
body.listing-dark-theme .archive-pagination nav > div:first-child > div:last-child {
    box-sizing:border-box !important;
    min-width:0 !important;
    max-width:100% !important;
}
body.listing-dark-theme .archive-pagination nav > div:first-child > div:last-child > span.inline-flex {
    display:flex !important;
    flex-wrap:wrap !important;
    justify-content:center !important;
    gap:4px !important;
    width:max-content !important;
    max-width:100% !important;
    overflow-wrap:anywhere !important;
}
body.listing-dark-theme .archive-pagination nav a,
body.listing-dark-theme .archive-pagination nav span[aria-disabled] > span,
body.listing-dark-theme .archive-pagination nav span[aria-current] > span {
    box-sizing:border-box !important;
    min-width:32px !important;
    height:32px !important;
    padding:4px 7px !important;
    margin:0 !important;
    border-radius:4px !important;
    line-height:22px !important;
    flex:0 0 auto !important;
}
body.listing-dark-theme .archive-pagination nav a svg,
body.listing-dark-theme .archive-pagination nav span[aria-disabled] svg {
    width:16px !important;
    height:16px !important;
    flex:0 0 16px !important;
}
@media(max-width:640px) {
    body.listing-dark-theme .archive-pagination {
        margin-top:20px !important;
        padding-left:0 !important;
        padding-right:0 !important;
    }
    body.listing-dark-theme .archive-pagination nav > div:first-child > div:first-child {
        display:none !important;
    }
    body.listing-dark-theme .archive-pagination nav > div:first-child > div:last-child {
        width:100% !important;
    }
}

/* samsun-archive-pagination-polish */
body.listing-dark-theme .archive-pagination nav > div:first-child > div:last-child > span.inline-flex{align-items:center!important;gap:7px!important;width:auto!important;border-radius:14px!important;box-shadow:none!important}
body.listing-dark-theme .archive-pagination nav a,body.listing-dark-theme .archive-pagination nav span[aria-disabled]>span,body.listing-dark-theme .archive-pagination nav span[aria-current]>span{display:inline-flex!important;align-items:center!important;justify-content:center!important;min-width:38px!important;height:38px!important;padding:0 10px!important;color:#d8d8da!important;background:#222326!important;border:1px solid #414247!important;border-radius:10px!important;font-size:13px!important;font-weight:650!important;line-height:1!important;text-decoration:none!important;box-shadow:0 2px 7px rgba(0,0,0,.12)!important;transition:color .15s ease,background-color .15s ease,border-color .15s ease,transform .15s ease,box-shadow .15s ease!important}
body.listing-dark-theme .archive-pagination nav a:hover,body.listing-dark-theme .archive-pagination nav a:focus-visible{color:#fff!important;background:#e30613!important;border-color:#e30613!important;transform:translateY(-1px);box-shadow:0 5px 14px rgba(227,6,19,.24)!important}
body.listing-dark-theme .archive-pagination nav a:focus-visible{outline:2px solid rgba(227,6,19,.55)!important;outline-offset:2px!important}
body.listing-dark-theme .archive-pagination nav [aria-current=page]>span,html[data-theme=light] body.listing-dark-theme .archive-pagination nav [aria-current=page]>span{color:#fff!important;background:linear-gradient(145deg,#ec1c2d,#c20818)!important;border-color:#e30613!important;box-shadow:0 5px 14px rgba(227,6,19,.28)!important}
body.listing-dark-theme .archive-pagination nav span[aria-disabled]>span{color:#797a7f!important;background:#1c1d20!important;border-color:#38393d!important;box-shadow:none!important}
html[data-theme=light] body.listing-dark-theme .archive-pagination nav a,html[data-theme=light] body.listing-dark-theme .archive-pagination nav span[aria-disabled]>span{color:#454a52!important;background:#fff!important;border-color:#dfe1e5!important}
html[data-theme=light] body.listing-dark-theme .archive-pagination nav a:hover,html[data-theme=light] body.listing-dark-theme .archive-pagination nav a:focus-visible{color:#fff!important;background:#e30613!important;border-color:#e30613!important}
body.listing-dark-theme .archive-page .archive-card-media{aspect-ratio:16/9!important;overflow:hidden!important;background:#222326!important}
body.listing-dark-theme .archive-page .archive-card-media img{display:block!important;width:100%!important;height:100%!important;object-fit:contain!important;object-position:center!important}
@media(max-width:640px){body.listing-dark-theme .archive-pagination nav>div:first-child>div:last-child>span.inline-flex{justify-content:center!important;gap:6px!important}body.listing-dark-theme .archive-pagination nav a,body.listing-dark-theme .archive-pagination nav span[aria-disabled]>span,body.listing-dark-theme .archive-pagination nav span[aria-current]>span{min-width:34px!important;height:34px!important;padding:0 7px!important;border-radius:9px!important;font-size:12px!important}}

/* Keep category, search and archive content aligned with the shared 1000px site column. */
html body.listing-dark-theme main#main-wrapper {
    width: min(100%, 1000px) !important;
    max-width: 1000px !important;
    min-width: 0 !important;
    margin-inline: auto !important;
    box-sizing: border-box !important;
    overflow-x: clip !important;
}
html body.listing-dark-theme main#main-wrapper > .archive-page,
html body.listing-dark-theme main#main-wrapper > .search-landing {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;
    box-sizing: border-box !important;
}
html body.listing-dark-theme .archive-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
}
@media (max-width: 960px) {
    html body.listing-dark-theme .archive-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
}
@media (max-width: 640px) {
    html body.listing-dark-theme main#main-wrapper { width: 100% !important; }
    html body.listing-dark-theme .archive-grid { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
}

/* Etiketler tema ile birlikte kontrastli kalir; acik modda kurumsal kirmizi kullanilir. */
html:not([data-theme="light"]) body.article-reading-theme #main-wrapper .article-tags {
    border-color: #3a3b3e !important;
}
html:not([data-theme="light"]) body.article-reading-theme #main-wrapper .article-tags a:not(.manset-badge) {
    background: #252629 !important;
    color: #e6e4df !important;
    border-color: #3a3b3e !important;
}
html:not([data-theme="light"]) body.article-reading-theme #main-wrapper .article-tags a:not(.manset-badge):hover,
html:not([data-theme="light"]) body.article-reading-theme #main-wrapper .article-tags a:not(.manset-badge):focus-visible {
    background: #e30613 !important;
    color: #fff !important;
    border-color: #e30613 !important;
}
html[data-theme="light"] body.article-reading-theme #main-wrapper .article-tags {
    border-color: #e5e7eb !important;
}
html[data-theme="light"] body.article-reading-theme #main-wrapper .article-tags a:not(.manset-badge) {
    background: #e30613 !important;
    color: #fff !important;
    border-color: #e30613 !important;
}
html[data-theme="light"] body.article-reading-theme #main-wrapper .article-tags a:not(.manset-badge):hover,
html[data-theme="light"] body.article-reading-theme #main-wrapper .article-tags a:not(.manset-badge):focus-visible {
    background: #b80715 !important;
    color: #fff !important;
    border-color: #b80715 !important;
}
</style>
<style id="samsun-shared-shell-colors">
/* Shared dark/light palette for the site-wide header and market strip. */
body > header,
body.home-dark-theme > header,
body.article-reading-theme > header,
body.listing-dark-theme > header {
    background:#17181b !important;
    border-color:#343539 !important;
    box-shadow:none !important;
}
body > header #searchBox,
body > header #searchBox input {
    background:#232427 !important;
    color:#f3f2ef !important;
    border-color:#45464a !important;
}
body > header #searchBox input::placeholder { color:#aaa9a5 !important; }
body > nav.bg-white,
body.home-dark-theme > nav.bg-white,
body.article-reading-theme > nav.bg-white,
body.listing-dark-theme > nav.bg-white {
    background:#1d1e21 !important;
    border-color:#35363a !important;
}
body > nav.bg-white a,
body > nav.bg-white button { color:#e8e6e1 !important; }
body > nav.bg-white span { color:#626367 !important; }
body .market-tape,
body.home-dark-theme .market-tape,
body.article-reading-theme .market-tape,
body.listing-dark-theme .market-tape {
    background:#17181b !important;
    color:#f0efec !important;
    border-bottom-color:#35363a !important;
}
body .market-tape-card,
body.home-dark-theme .market-tape-card,
body.article-reading-theme .market-tape-card,
body.listing-dark-theme .market-tape-card {
    background:#222326 !important;
    color:#f0efec !important;
    border-color:#3a3b3f !important;
}
body .market-tape-name { color:#aaa9a5 !important; }
body .market-tape-price { color:#f5f3ef !important; }
body .market-tape-change.flat { color:#c4c2bd !important; background:#343539 !important; }
body .market-tape-change.up { color:#48c77b !important; background:#183326 !important; }
body .market-tape-change.down { color:#ff6269 !important; background:#3a2224 !important; }
html[data-theme="light"] body > header,
html[data-theme="light"] body > nav.bg-white,
html[data-theme="light"] body .market-tape {
    background:#fff !important;
    color:#202124 !important;
    border-color:#e5e7eb !important;
}
html[data-theme="light"] body > header #searchBox,
html[data-theme="light"] body > header #searchBox input {
    background:#fff !important;
    color:#202124 !important;
    border-color:#d1d5db !important;
}
html[data-theme="light"] body > nav.bg-white a,
html[data-theme="light"] body > nav.bg-white button { color:#303238 !important; }
html[data-theme="light"] body .market-tape-card {
    background:#fff !important;
    color:#202124 !important;
    border-color:#e5e7eb !important;
}
html[data-theme="light"] body .market-tape-name { color:#6b7280 !important; }
html[data-theme="light"] body .market-tape-price { color:#202124 !important; }
html[data-theme="light"] body .market-tape-change.up { color:#128442 !important; background:#e8f7ed !important; }
html[data-theme="light"] body .market-tape-change.down { color:#e30613 !important; background:#fff0f0 !important; }
html[data-theme="light"] body .market-tape-change.flat { color:#646b75 !important; background:#f3f4f6 !important; }
</style>

<style id="samsun-search-modal-styles">
#siteSearchModal{position:fixed;inset:0;z-index:14000;display:flex;align-items:flex-start;justify-content:center;padding:clamp(100px,20vh,190px) 18px 24px;background:rgba(12,13,15,.76);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);opacity:0;visibility:hidden;pointer-events:none;transition:opacity .2s ease,visibility .2s ease}
#siteSearchModal.is-open{opacity:1;visibility:visible;pointer-events:auto}
#siteSearchModal .search-modal-panel{width:min(100%,680px);padding:28px;color:#f4f4f3;background:#202124;border:1px solid #45464a;border-top:3px solid #e30613;border-radius:16px;box-shadow:0 22px 70px rgba(0,0,0,.42);transform:translateY(-8px) scale(.99);transition:transform .2s ease}
#siteSearchModal.is-open .search-modal-panel{transform:translateY(0) scale(1)}
#siteSearchModal .search-modal-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:20px}
#siteSearchModal .search-modal-title{display:flex;align-items:center;gap:10px;margin:0;color:inherit;font-size:16px;font-weight:750;line-height:1.2}
#siteSearchModal .search-modal-mark{display:inline-grid;place-items:center;width:34px;height:34px;color:#fff;background:#e30613;border-radius:10px}
#siteSearchModal .search-modal-close{display:grid;place-items:center;width:38px;height:38px;flex:none;padding:0;color:#c8c8ca;background:#2c2d30;border:1px solid #444549;border-radius:10px;cursor:pointer}
#siteSearchModal .search-modal-close:hover{color:#fff;background:#e30613;border-color:#e30613}
#siteSearchModal .search-modal-form{display:flex;align-items:center;gap:10px;padding:7px;background:#17181b;border:1px solid #48494d;border-radius:12px;transition:border-color .16s ease,box-shadow .16s ease}
#siteSearchModal .search-modal-form:focus-within{border-color:#e30613;box-shadow:0 0 0 3px rgba(227,6,19,.18)}
#siteSearchModal .search-modal-input{min-width:0;flex:1;height:46px;padding:0 10px;color:#f7f7f7;background:transparent;border:0;outline:0;font-family:inherit;font-size:17px;font-weight:500;line-height:1.35}
#siteSearchModal .search-modal-input::placeholder{color:#929398}
#siteSearchModal .search-modal-submit{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-width:104px;height:46px;padding:0 17px;color:#fff;background:#e30613;border:0;border-radius:9px;font-size:15px;font-weight:700;cursor:pointer;transition:background .16s ease,transform .16s ease}
#siteSearchModal .search-modal-submit:hover{background:#b90715;transform:translateY(-1px)}
#siteSearchModal .search-modal-shortcuts{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:18px}
#siteSearchModal .search-modal-hint{margin-right:3px;color:#999a9f;font-size:12px}
#siteSearchModal .search-modal-chip{padding:7px 10px;color:#d7d7d9;background:#292a2d;border:1px solid #3e3f43;border-radius:999px;font-size:12px;line-height:1;text-decoration:none;transition:color .15s ease,border-color .15s ease,background .15s ease}
#siteSearchModal .search-modal-chip:hover{color:#fff;background:rgba(227,6,19,.15);border-color:#e30613}
body.site-search-modal-open{overflow:hidden}
html[data-theme="light"] #siteSearchModal .search-modal-panel{color:#202124;background:#fff;border-color:#e1e2e5;border-top-color:#e30613;box-shadow:0 22px 70px rgba(18,24,32,.24)}
html[data-theme="light"] #siteSearchModal .search-modal-close{color:#555b65;background:#f3f4f6;border-color:#e1e2e5}
html[data-theme="light"] #siteSearchModal .search-modal-form{background:#f7f7f8;border-color:#d9dbe0}
html[data-theme="light"] #siteSearchModal .search-modal-input{color:#202124}
html[data-theme="light"] #siteSearchModal .search-modal-chip{color:#454a52;background:#f5f5f6;border-color:#e2e3e6}
html[data-theme="light"] #siteSearchModal .search-modal-hint{color:#70757e}
@media(max-width:600px){#siteSearchModal{align-items:flex-start;padding:22vh 14px 20px}#siteSearchModal .search-modal-panel{padding:20px 16px;border-radius:14px}#siteSearchModal .search-modal-title{font-size:16px}#siteSearchModal .search-modal-form{gap:5px;padding:5px}#siteSearchModal .search-modal-input{height:44px;padding:0 7px;font-size:16px!important}#siteSearchModal .search-modal-submit{min-width:46px;width:46px;height:44px;padding:0}#siteSearchModal .search-modal-submit span{display:none}#siteSearchModal .search-modal-shortcuts{gap:7px;margin-top:15px}}
@media(prefers-reduced-motion:reduce){#siteSearchModal,#siteSearchModal .search-modal-panel,#siteSearchModal .search-modal-form,#siteSearchModal .search-modal-submit{transition:none}}
</style>

<style>
