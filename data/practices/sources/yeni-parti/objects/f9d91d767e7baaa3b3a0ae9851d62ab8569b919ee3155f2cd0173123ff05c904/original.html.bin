    <script>
    (() => {
        const pathKey = 'so-article-scroll-v2:' + location.pathname;
        const navigation = performance.getEntriesByType('navigation')[0];
        const isReload = navigation && navigation.type === 'reload';
        let savedY = 0;
        try {
            const value = sessionStorage.getItem(pathKey);
            if (value !== null) savedY = Math.max(0, parseInt(value, 10) || 0);
        } catch (_) {}
        let restoring = Boolean(isReload && savedY > 0);
        try { history.scrollRestoration = restoring ? 'manual' : 'auto'; } catch (_) {}
        const root = document.documentElement;
        if (restoring) {
            root.style.minHeight = Math.ceil(savedY + window.innerHeight) + 'px';
            root.style.scrollBehavior = 'auto';
            window.scrollTo(0, savedY);
        }
        let saveTimer;
        const savePosition = () => {
            if (restoring) return;
            try { sessionStorage.setItem(pathKey, String(Math.max(0, Math.round(window.scrollY || root.scrollTop || 0)))); } catch (_) {}
        };
        window.addEventListener('scroll', () => {
            if (restoring) return;
            clearTimeout(saveTimer);
            saveTimer = setTimeout(savePosition, 120);
        }, { passive: true });
        window.addEventListener('pagehide', savePosition);
        if (restoring) {
            const reassertPosition = () => window.scrollTo(0, savedY);
            const finishRestore = () => {
                if (!restoring) return;
                reassertPosition();
                requestAnimationFrame(() => {
                    reassertPosition();
                    root.style.minHeight = '';
                    root.style.scrollBehavior = '';
                    restoring = false;
                    savePosition();
                });
            };
            document.addEventListener('DOMContentLoaded', reassertPosition, { once: true });
            window.addEventListener('load', finishRestore, { once: true });
            setTimeout(finishRestore, 2500);
        }
    })();
    </script>
