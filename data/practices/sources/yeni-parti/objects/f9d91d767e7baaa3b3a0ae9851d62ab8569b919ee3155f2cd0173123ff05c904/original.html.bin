<style id="desktop-search-control-compact">
.search-mic-icon{border:0;background:transparent;cursor:pointer}.search-mic-icon.is-listening{color:#cc1517!important}
@media(min-width:768px){
 body>header #searchBox{width:212px!important;min-width:212px!important;max-width:212px!important;height:36px!important;border-radius:9px!important}
 body>header #searchBox input{height:34px!important;padding-left:8px!important;font-size:12px!important}
 body>header #searchBox .search-mic-icon{width:25px!important;min-width:25px!important;height:34px!important;flex-basis:25px!important}
 body>header #searchBox .search-mic-icon svg{width:17px!important;height:17px!important}
 body>header #searchBox #searchBtn{width:36px!important;min-width:36px!important;height:34px!important;border-radius:0 7px 7px 0!important}
 #themeToggle{width:36px!important;min-width:36px!important;height:34px!important;min-height:34px!important;max-height:34px!important;flex-basis:36px!important}
 #themeToggle .theme-icon-scene,#themeToggle .theme-icon{width:14px!important;height:14px!important}
}
</style>
<style id="desktop-inline-breaking-style">
@media(min-width:768px){
  .desktop-inline-breaking{display:flex;align-items:center;min-width:0;max-width:none;flex:1 1 0;margin:0 22px;gap:10px;overflow:hidden}
  .desktop-inline-breaking__label{display:inline-flex;align-items:center;gap:6px;flex:0 0 auto;color:#e30613;font-size:11px;font-weight:850;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap}
  .desktop-inline-breaking__label i{display:block;width:7px;height:7px;border-radius:50%;background:#e30613;box-shadow:0 0 0 3px rgba(227,6,19,.12)}
  .desktop-inline-breaking__window{min-width:0;overflow:hidden;border-left:1px solid #d8dce1;padding-left:10px}
  .desktop-inline-breaking__ticker{display:flex;align-items:center;gap:36px;width:max-content;white-space:nowrap;animation:desktopInlineTicker 38s linear infinite}
  .desktop-inline-breaking__ticker a{color:#3c424a!important;font-size:12px;font-weight:650;text-decoration:none}
  .desktop-inline-breaking__ticker a:hover{color:#e30613!important}
  /* Son dakika akışı logo yanında; eski satırdan kalan ince bantı gösterme. */
  .breaking-news-bar{display:none!important}
  body .market-tape{margin-top:10px!important}
  .market-tape-inner{max-width:1000px!important;padding-left:0!important;padding-right:0!important}
  body>header{position:sticky!important;border-bottom:0!important}
  body>header::after{content:"";position:absolute;left:0;right:0;bottom:0;height:2px;background:linear-gradient(90deg,#cc1517 0%,#bd001a 48%,rgba(189,0,26,.16) 100%);pointer-events:none}
  body>nav.bg-white.hidden[class~="md:block"]{margin-top:5px!important}
}
@keyframes desktopInlineTicker{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media(max-width:767px){
  .desktop-inline-breaking{display:none!important}
  body>header #searchBox{display:flex!important;flex:0 0 38px!important;width:38px!important;min-width:38px!important;max-width:38px!important;height:38px!important;border:0!important;background:transparent!important;overflow:visible!important}
  body>header #searchBox input,body>header #searchBox .search-mic-icon{display:none!important}
  body>header #searchBox #searchBtn{display:inline-flex!important;align-items:center!important;justify-content:center!important;flex:0 0 38px!important;width:38px!important;min-width:38px!important;height:38px!important;padding:0!important;border-radius:8px!important;background:#cc1517!important;color:#fff!important}
  body>header #searchBox #searchBtn .search-button-icon{width:18px!important;height:18px!important}
}
</style>
</head>

