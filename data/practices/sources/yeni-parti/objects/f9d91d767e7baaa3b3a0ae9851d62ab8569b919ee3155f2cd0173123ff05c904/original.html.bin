    color:#e30613 !important;
}

/* Thinner red underline appears only while hovering over breaking headlines. */
body.home-dark-theme .breaking-news-window .breaking-ticker a:hover,
body.article-reading-theme .breaking-news-window .breaking-ticker a:hover,
html[data-theme="light"] body .breaking-news-window .breaking-ticker a:hover {
    color:#e30613 !important;
    text-decoration:underline !important;
    text-decoration-color:#e30613 !important;
    text-decoration-thickness:1px !important;
    text-underline-offset:3px !important;
}
