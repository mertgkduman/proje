}
/* Reading-page links use the brand red on hover in both themes. */
body.article-reading-theme a:hover:not(.article-tags a):not(.google-news-feature):not(#searchBtn):not(#themeToggle):not([style*="background"]) {
    color:#e30613 !important;
}
body.article-reading-theme .article-sidebar-stack section a:hover p,
body.article-reading-theme .article-page-root a:hover h1,
body.article-reading-theme .article-page-root a:hover h2,
body.article-reading-theme .article-page-root a:hover h3,
body.article-reading-theme .article-page-root a:hover h4 {
    color:#e30613 !important;
}

/* Icons have a stable first frame; animate only after the user changes the theme. */
#themeToggle .theme-icon-scene {
    position:relative;
    display:inline-block;
    width:20px;
    height:20px;
    flex:0 0 20px;
    vertical-align:middle;
}
#themeToggle .theme-icon {
    position:absolute;
    inset:0;
    display:block;
    width:20px;
    height:20px;
    transform-origin:50% 50%;
    transition:none;
}
#themeToggle .theme-icon-sun {
    opacity:0;
    transform:rotate(-110deg) scale(.25);
}
#themeToggle .theme-icon-moon {
    opacity:1;
    transform:rotate(0) scale(1);
}
html[data-theme="light"] #themeToggle .theme-icon-sun {
    opacity:1;
    transform:rotate(0) scale(1);
}
html[data-theme="light"] #themeToggle .theme-icon-moon {
    opacity:0;
    transform:rotate(110deg) scale(.25);
}
html.theme-toggle-animated #themeToggle .theme-icon {
    transition:opacity .32s ease, transform .48s cubic-bezier(.2,.8,.2,1), color .25s ease;
}
@media (prefers-reduced-motion: reduce) {
    html.theme-toggle-animated #themeToggle .theme-icon { transition:none; }
}

/* Haber kapak görselini kendi içerik sütununu tam dolduracak şekilde, kırpmadan göster. */
body.article-reading-theme .article-cover-frame {
