<script>
function menuAc() {
    const menu = document.getElementById('mega-menu');
    menu.classList.remove('-translate-y-full');
    menu.setAttribute('aria-hidden', 'false');
    document.querySelectorAll('[data-menu-trigger]').forEach(button => button.setAttribute('aria-expanded', 'true'));
    document.getElementById('menu-overlay').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
}

function menuKapat() {
    const menu = document.getElementById('mega-menu');
    menu.classList.add('-translate-y-full');
    menu.setAttribute('aria-hidden', 'true');
    document.querySelectorAll('[data-menu-trigger]').forEach(button => button.setAttribute('aria-expanded', 'false'));
    document.getElementById('menu-overlay').classList.add('hidden');
    document.body.style.overflow = '';
}
document.addEventListener('keydown', event => { if (event.key === 'Escape') menuKapat(); });
</script>



