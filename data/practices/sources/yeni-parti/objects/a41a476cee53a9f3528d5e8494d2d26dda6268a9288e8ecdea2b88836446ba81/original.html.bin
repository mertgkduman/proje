        <script>
            $(document).ready(function() {
                const relatedBox = `
                    <div class="my-8 p-6 rounded-xl border border-[var(--color-border)] bg-[var(--color-card)] hover:shadow-lg transition-shadow"
                    data-url="https://www.edirneahval.com/siyaset/bagimsiz-baskan-sezgin-geldiden-parti-aciklamasi-baska-partiye-gececek-mi/104240"

                    >
                    <a href="https://www.edirneahval.com/siyaset/bagimsiz-baskan-sezgin-geldiden-parti-aciklamasi-baska-partiye-gececek-mi/104240"
                            class="flex flex-col lg:flex-row items-center gap-6 group  !no-underline">
                            <div class="flex-shrink-0 w-full lg:w-64 h-48 rounded-lg overflow-hidden flex items-center justify-center">
                                <img src="https://cdn.edirneahval.com/2026/08/bagimsiz-baskan-sezgin-geldiden-parti-aciklamasi-baska-partiye-gececek-mi-106a900cbf8d9da.webp" alt="Bağımsız Başkan Sezgin Geldi&#039;den &#039;Parti&#039; Açıklaması: Başka Partiye Geçecek Mi?"   onerror="this.onerror=null;this.src='https://edirneahval.b-cdn.net/uploads/settings/2026/04/defaultimage.png-aa3RBy5J.png'"
                                    style="width:100% !important;height:100% !important;object-fit:cover !important;max-width:100% !important;"
                                    class="transition-transform duration-500 group-hover:translate-y-[-5px]">
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-3">
                                    <span class="px-3 py-1 text-xs font-semibold rounded-full bg-[var(--color-primary-50)] text-[var(--color-primary)] no-underline">
                                        Siyaset
                                    </span>
                                    <span class="text-sm text-[var(--color-muted)]">2 ay önce</span>
                        </div>
                                <h3 class="text-xl font-bold text-[var(--color-text)] !mt-1 mb-2 group-hover:text-[var(--color-primary)] transition-colors no-underline">
                                   Bağımsız Başkan Sezgin Geldi&#039;den &#039;Parti&#039; Açıklaması: Başka Partiye Geçecek Mi?
                                </h3>
                                <div class="flex items-center gap-2 w-fit text-sm font-semibold text-[var(--color-primary)] border-b-1 border-transparent group-hover:border-b-1 group-hover:border-[var(--color-primary)] transition-border duration-200">
                                    <span>Bu Haber İlginizi Çekebilir</span>
                                    <i class="ri-arrow-right-line group-hover:translate-x-1 transition-transform"></i>
                            </div>
                        </div>
                    </a>
                </div>
        `;
                                    insertBoxAfterParagraph('#liteArticleContent', relatedBox, 6);
                            });

            // İlgili haber/teaser kutusunu yerleştirir:
            //  - Yeterince uzun yazıda içerik ortasına (mevcut davranış korunur)
            //  - Kısa yazıda KAYNAK bilgisinden SONRA; böylece kaynak, yazı biter bitmez
            //    ilgili haber kutusundan ÖNCE görünür.
            function insertBoxAfterParagraph(selector, htmlToInsert, afterParagraph = null) {
                const $content = $('#detail-content').length ? $('#detail-content') : $(selector);
                const paragraphs = $content.find('p');
                const $source = $('#postKaynak');

                const target = afterParagraph !== null ?
                    afterParagraph :
                    Math.floor(paragraphs.length / 2);

                // Hedef paragraftan sonra hâlâ paragraf kalıyorsa kutu gerçekten içerik
                // ortasında olur; bu durumda mevcut davranışı koru.
                if (paragraphs.length > target + 1) {
                    $(paragraphs[target]).after(htmlToInsert);
                    return;
                }

                // Aksi halde kutuyu kaynaktan (kaynak yoksa içerikten) sonra ekle.
                ($source.length ? $source : $content).after(htmlToInsert);
            }
        </script>
    <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/vce701823e78c4301a35b7e07294d87301792088814092" integrity="sha512-UKNk8GbxkABxKcXYuLkO16EleLGUkcvJWtpSNmExE0Too3ZaFAxTscNWEc1OdAv5/BikHawapSCaiD2XCmp+Bw==" data-cf-beacon='{"version":"2024.11.0","token":"6c6c575d5f754f2f9638e5b76969d215","r":1,"spa":2}' crossorigin="anonymous"></script>
</body>



</html>
