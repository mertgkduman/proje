                               title="MHP Kayseri Teşkilatında Yeni Görevlendirme">
                                                                    <picture class="spot-skel flex-shrink-0 w-[110px] h-16">
                                        <source srcset="https://images.durusthaber.com/media/2026/11/mhp-kayseri-teskilatinda-yeni-gorevlendirme_6b01aec96615e_t.webp" type="image/webp"
                                                loading="lazy">
                                        <img src="https://images.durusthaber.com/media/2026/11/mhp-kayseri-teskilatinda-yeni-gorevlendirme_6b01aec96615e_t.jpg" alt="MHP Kayseri Teşkilatında Yeni Görevlendirme"
                                             loading="lazy" class="object-cover object-center w-full h-full">
