    </div>
    <div class="flex flex-col justify-center flex-1 px-4 py-3">
        <h3 class="text-lg font-medium uppercase">Yorumlar
            
        </h3>
    </div>

<button
        x-show="!showCommentForm"
        x-on:click="checkLoginStatus()"
        class="dark:bg-customdarkgray-800 dark:text-gray-300 bg-white border border-gray-300 font-semibold py-1 px-2 text-sm rounded-tm
    hover:bg-gray-100 transition mr-2">
    Yorum Yap
</button>
</div>
            <div x-show="showCommentForm"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 transform scale-95"
                 x-transition:enter-end="opacity-100 transform scale-100"
                 x-transition:leave="transition ease-in duration-200"
                 x-transition:leave-start="opacity-100 transform scale-100"
                 x-transition:leave-end="opacity-0 transform scale-95"
                 class="mt-4 rounded-tm bg-white dark:bg-customdarkgray-800 dark:text-gray-300 p-4">

            <form x-on:submit.prevent="addComment" x-show="showMainCommentForm">
                <input type="hidden" name="_token" value="" autocomplete="off">                <div class="flex flex-col space-y-2">
                    <div class="flex flex-col md:flex-row space-y-4 md:space-y-0 md:space-x-4">
                        <input x-show="!userIsLoggedIn" autocomplete="off" x-model="newComment.author" type="text" placeholder="Ad / Soyad" class="dark:bg-customdarkgray-900 w-full text-sm bg-gray-100 hover:bg-white" required>
                                                    <input x-show="!userIsLoggedIn" autocomplete="off" x-model="newComment.email" type="email" placeholder="Email" class="dark:bg-customdarkgray-900 w-full text-sm bg-gray-100 hover:bg-white" required>
                                            </div>
                    <textarea x-model="newComment.text" x-on:input="remainingChars = 1000 - newComment.text.length" class="dark:bg-customdarkgray-900 h-24 text-sm bg-gray-100 hover:bg-white" maxlength="1000" placeholder="Herkese açık bir yorum ekleyin" required></textarea>
                    <div x-cloak x-show="remainingChars <=0" class="text-xs p-2 bg-red-100 border border-red-400 text-red-700 rounded-md mt-2">
                         Maksimum karakter sayısına ulaştınız
                    </div>
                    <p class="text-xs">Kalan Karakter: <span class="text-red-600" x-text="remainingChars"></span></p>


                        <div x-data="voiceComment()" class="mt-2">
   <button type="button"
           class="bg-gray-200 hover:bg-gray-300 text-gray-800 text-sm font-medium px-3 py-2 rounded-lg flex items-center gap-2 shadow-sm transition-all
           duration-150"
           x-on:click="toggleRecording">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" class="w-5 h-5" viewBox="0 0 24 24"
         stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M12 18v3m6-3a6 6 0 01-12 0m12-5V9a6 6 0 00-12 0v4"/>
        <circle cx="12" cy="12" r="3"/>
    </svg>
    <span x-text="isRecording ? 'Kaydı Durdur' : 'Ses Ekle'"></span>
</button>

<template x-if="isRecording">
    <div class="text-xs text-red-600 mt-2">
        Süre: <span x-text="formattedTime"></span> / 02:00
    </div>
</template>

    <template x-if="audioUrl">
        <div class="mt-2 space-y-2">
            <audio :src="audioUrl" controls class="w-full"></audio>
        </div>
    </template>

<input type="hidden" name="audio_blob" :value="$store.commentAudio.audio_blob">


</div>
                </div>
                <div class="flex items-center justify-between mt-2 my-2">
                    <div class="flex items-center">
                        <input
                                type="checkbox"
                                x-model="isTOSAccepted"
                                @change="if (newComment.text.trim().length < 3) {
        Swal.fire({
            title: 'Uyarı',
            text: 'Yorum alanı en az 3 karakter olmalıdır.',
            icon: 'warning',
            timer: 3000,
            showConfirmButton: false
        });
        isTOSAccepted = false;
    }"
                                name="usertos"
                                id="usertos-277680"
                                class="mr-2"
                        >

                        <label for="usertos-277680" class="mb-0 text-xs">
                            <a href="#" x-on:click.prevent="openTOSModal">Yorum yazma kurallarını</a> okudum ve kabul ediyorum.
                        </label>
                    </div>
                                        <button
                            type="submit"
                            :class="(
        newComment.text.length < 3 ||
        newComment.author.trim().length < 3 ||
        (!userIsLoggedIn && true && (!newComment.email || newComment.email.trim().length < 3)) ||
        !isTOSAccepted
    )
        ? 'bg-gray-300 dark:bg-gray-700 cursor-not-allowed text-white font-semibold p-2 rounded-md text-xs'
        : 'bg-red-700 hover:bg-red-800 text-white font-semibold p-2 rounded-md text-xs'"
                            :disabled="
        sending ||
        newComment.text.length < 3 ||
        newComment.author.trim().length < 3 ||
        (!userIsLoggedIn && true && (!newComment.email || newComment.email.trim().length < 3)) ||
        !isTOSAccepted
    "
                    >
                        Gönder
                    </button>


                </div>
            </form>
    </div>


            <div class="space-y-4 overflow-auto" itemprop="comment" style="max-height: 500px;">
