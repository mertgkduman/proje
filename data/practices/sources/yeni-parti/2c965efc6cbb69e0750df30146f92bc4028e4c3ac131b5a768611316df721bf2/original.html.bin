<style>
/* ========================================
   HEADER 13 - LOGO
   ======================================== */
.header-13 .main-header .middle-header .logo-brand {
    max-width: 200px;
}
.header-13 .logo-brand img {
    height: auto;
    object-fit: contain;
    max-height: 105px;
}
@media (max-width: 576px) {
    .header-13 .logo-brand img {
        max-height: 55px !important;
    }
}

/* ========================================
   HEADER 13 - TOP HEADER
   ======================================== */
.header-13 .top-header {
    height: 41.2px;
}
.header-13 .top-header .top-parite {
    font-size: 14px;
}
.header-13 .city-choices .choices {
    width: 150px;
    height: 37.7px;
}
.header-13 .top-header ul {
    white-space: nowrap;
    -ms-overflow-style: none;
    scrollbar-width: none;
    transition: top .3s;
    flex-wrap: nowrap;
}
.header-13 .top-header ul li {
    padding-right: 15px;
    margin-right: 15px;
}
.header-13 .top-header ul li:last-child {
    padding-right: 0;
    margin-right: 0;
}

/* ========================================
   HEADER 13 - MENU TWO ROWS (SKEW EFFECT)
   ======================================== */
.header-13 .menu-two-rows::before {
    top: 0;
    left: 19px;
    content: "";
    bottom: auto;
    height: 100%;
    width: 197px;
    position: absolute;
    background-color: var(--te-color);
    -webkit-transform: skew(-30deg);
    -moz-transform: skew(-30deg);
    -ms-transform: skew(-30deg);
    -o-transform: skew(-30deg);
    transform: skew(-30deg);
    z-index: 2;
}
.header-13 .main-header .container::before {
    border-left: 3px solid var(--te-accent-color);
    bottom: 0;
    content: "";
    height: 77px;
    left: 218px;
    margin-left: 0;
    position: absolute;
    top: 15px;
    transform: rotate(30deg) translateY(-8px);
    z-index: 3;
}
.header-13 .menu-two-rows .top-menu ul:first-child {
    margin-left: 85px;
}
.header-13 .menu-two-rows .top-menu i {
    color: var(--te-accent-color);
}

/* ========================================
   HEADER 13 - CATEGORY MENU (Swiper)
   ======================================== */
.header-13 .header-13-category-menu {
    position: relative;
    height: 38px;
    padding-left: 60px;
    padding-right: 45px;
    background-color: var(--te-accent-color);
    overflow: visible;
}
.header-13 .header-13-categories-swiper {
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    height: 100%;
}
.header-13 .header-13-categories-swiper .swiper-wrapper {
    display: flex;
    align-items: center;
}
.header-13 .header-13-categories-swiper .swiper-slide {
    width: auto;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
}
.header-13 .header-13-categories-swiper .nav-link {
    white-space: nowrap;
    transition: all 0.3s ease;
    color: #333;
    padding: 0.25rem 1rem !important;
    border-right: 0.5px solid black;
}
.header-13 .header-13-categories-swiper .nav-link:hover {
    color: #555;
}

/* Swiper Navigation Buttons */
.header-13 .header-13-swiper-button-prev,
.header-13 .header-13-swiper-button-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: all 0.3s ease;
}
.header-13 .header-13-swiper-button-prev {
    left: 65px;
}
.header-13 .header-13-swiper-button-next {
    right: 5px;
}
.header-13 .header-13-swiper-button-prev.swiper-button-active,
.header-13 .header-13-swiper-button-next.swiper-button-active {
    opacity: 1;
    pointer-events: auto;
}
.header-13 .header-13-swiper-button-prev:hover,
.header-13 .header-13-swiper-button-next:hover {
    background: transparent;
    color: white;
    border-color: white;
    transform: translateY(-50%) scale(1.1);
}
.header-13 .header-13-swiper-button-prev i,
.header-13 .header-13-swiper-button-next i {
    font-size: 0.75rem;
}

/* ========================================
   HEADER 13 - BREAKING NEWS
   ======================================== */
.header-13 .breaking-news {
    align-items: center;
    position: relative;
    overflow: hidden;
}
.header-13 .breaking-news-label {
    flex-shrink: 0;
    margin-left: 35px;
}
.header-13 .breaking-news-wrapper {
    flex: 1;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 15px, black calc(100% - 15px), transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 15px, black calc(100% - 15px), transparent);
}
.header-13 .breaking-news-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll-13 60s linear infinite;
}
.header-13 .breaking-news-track:hover {
    animation-play-state: paused;
}
@keyframes marquee-scroll-13 {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
}
.header-13 .breaking-news-list {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    font-size: 15px;
}
.header-13 .breaking-news-list li {
    padding-right: 3rem;
    position: relative;
}
.header-13 .breaking-news-list li::after {
    content: "\25CF";
    position: absolute;
    right: 1.25rem;
    color: var(--te-color);
    opacity: 0.5;
}
.header-13 .breaking-news-item {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    white-space: nowrap;
    transition: color 0.2s ease;
}
.header-13 .breaking-news-item:hover {
    color: var(--te-color);
}

/* ========================================
   HEADER 13 - MOBILE CATEGORIES
   ======================================== */
.header-13 .mobile-categories-wrapper {
    background-color: var(--te-accent-color);
}
.header-13 .mobile-categories-wrapper::before {
    background: linear-gradient(to right, var(--te-accent-color), transparent);
}
.header-13 .mobile-categories-wrapper::after {
    background: linear-gradient(to left, var(--te-accent-color), transparent);
}
.header-13 .mobile-categories li {
    border-right-color: rgba(0, 0, 0, 0.15);
}
.header-13 .mobile-categories li a {
    color: #333;
}

/* ========================================
   HEADER 13 - RESPONSIVE
   ======================================== */
@media (min-width: 992px) and (max-width: 1199px) {
    .header-13 .header-13-categories-swiper {
        max-width: 600px;
    }
}
@media (min-width: 1200px) and (max-width: 1399px) {
    .header-13 .header-13-categories-swiper {
        max-width: 760px;
    }
}
@media (min-width: 1400px) {
    .header-13 .header-13-categories-swiper {
        max-width: 950px;
    }
}
@media only screen and (max-width: 991px) {
    .header-13 .main-header .container::before {
        display: none;
    }
    .header-13 .menu-two-rows .top-menu ul:first-child {
        margin-left: 0;
    }
}
</style>

<script type="fcbf08c3e1954064431b047e-text/javascript">
(function() {
    'use strict';

    function initHeader13Categories() {
        var swiperContainer = document.querySelector('.header-13 .header-13-categories-swiper');
        if (!swiperContainer) return;

        var categoriesSwiper = new Swiper('.header-13 .header-13-categories-swiper', {
            slidesPerView: 'auto',
            spaceBetween: 0,
            loop: false,
            freeMode: {
                enabled: true,
                sticky: false
            },
            mousewheel: {
                forceToAxis: true
            },
            grabCursor: true,
            navigation: {
                nextEl: '.header-13 .header-13-swiper-button-next',
                prevEl: '.header-13 .header-13-swiper-button-prev'
            },
            on: {
                init: function() {
                    updateNavigationButtons(this);
                },
                resize: function() {
                    this.update();
                    updateNavigationButtons(this);
                },
                setTranslate: function() {
                    updateNavigationButtons(this);
                }
            }
        });

        function updateNavigationButtons(swiper) {
            var prevButton = document.querySelector('.header-13 .header-13-swiper-button-prev');
            var nextButton = document.querySelector('.header-13 .header-13-swiper-button-next');
            if (!prevButton || !nextButton) return;

            var totalWidth = 0;
            swiper.slides.forEach(function(slide) {
                if (!slide.classList.contains('swiper-slide-duplicate')) {
                    totalWidth += slide.offsetWidth;
                }
            });

            var containerWidth = swiper.el.offsetWidth;

            if (totalWidth <= containerWidth) {
                prevButton.classList.remove('swiper-button-active');
                nextButton.classList.remove('swiper-button-active');
            } else {
                if (swiper.isBeginning) {
                    prevButton.classList.remove('swiper-button-active');
                } else {
                    prevButton.classList.add('swiper-button-active');
                }
                if (swiper.isEnd) {
                    nextButton.classList.remove('swiper-button-active');
                } else {
                    nextButton.classList.add('swiper-button-active');
                }
            }
        }

        var resizeTimer;
        window.addEventListener('resize', function() {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function() {
                categoriesSwiper.update();
                updateNavigationButtons(categoriesSwiper);
            }, 250);
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHeader13Categories);
    } else {
        initHeader13Categories();
    }
})();
</script>


    





