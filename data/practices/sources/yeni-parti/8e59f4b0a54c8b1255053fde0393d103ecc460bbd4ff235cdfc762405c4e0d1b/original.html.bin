    <script>
    (function(){
        var el = document.getElementById('nvClock');
        if(!el) return;
        function tick(){
            var d = new Date();
            var s = d.toLocaleTimeString('tr-TR',{hour:'2-digit',minute:'2-digit',second:'2-digit',timeZone:'Europe/Istanbul'});
            el.textContent = s;
        }
        tick(); setInterval(tick, 1000);
    })();

    // finans seridi: usd/eur/gbp/btc/altin/faiz + gunluk degisim
    (function(){
        var box = document.getElementById('nvMarket');
        if(!box) return;
        fetch('/wp-content/uploads/dtv-finans.json?ts=' + Date.now())
        .then(function(r){ return r.json(); })
        .then(function(d){
            var f2 = function(n){ return n.toLocaleString('tr-TR',{minimumFractionDigits:2, maximumFractionDigits:2}); };
            var arrow = function(c){ return c>0 ? ' \u25B2' : (c<0 ? ' \u25BC' : ''); };
            var cls = function(c){ return c>0 ? 'artis' : (c<0 ? 'dusus' : ''); };
            var parts = [];
            var item = function(name, o, fmt, href, nosym){
                if(!o) return;
                var v = fmt==='int' ? Math.round(o.v).toLocaleString('tr-TR') : f2(o.v);
                var ch = (typeof o.c === 'number') ? '<i class="' + cls(o.c) + '">' + arrow(o.c) + ' ' + Math.abs(o.c).toLocaleString('tr-TR',{minimumFractionDigits:2, maximumFractionDigits:2}) + '%</i>' : '';
                parts.push('<a class="nv-mk" href="' + href + '">' + name + ' <b>' + v + (nosym ? '' : ' \u20BA') + '</b>' + ch + '</a>');
            };
            item('USD/TRY', d.usd, null, '/finans/doviz/usd-try/');
            item('EUR/TRY', d.eur, null, '/finans/doviz/eur-try/');
            item('BIST 100', d.xu, 'int', '/finans/borsa/bist100/', true);
            if(d.btc) parts.push('<a class="nv-mk" href="/finans/kripto/bitcoin">BTC <b>' + Math.round(d.btc.v).toLocaleString('tr-TR') + ' \u20BA</b><i class="' + cls(d.btc.c) + '">' + arrow(d.btc.c) + ' ' + Math.abs(d.btc.c).toFixed(2) + '%</i></a>');
            if(d.altin) parts.push('<a class="nv-mk altin" href="/finans/altin/gram-altin/">GRAM ALTIN <b>' + Math.round(d.altin.v).toLocaleString('tr-TR') + ' \u20BA</b><i class="' + cls(d.altin.c) + '">' + arrow(d.altin.c) + ' ' + Math.abs(d.altin.c).toFixed(2) + '%</i></a>');
            if(d.faiz) parts.push('<a class="nv-mk faiz" href="/finans/faiz/">FAIZ <b>%' + d.faiz.v.toLocaleString('tr-TR') + '</b><i class="' + cls(d.faiz.v - d.faiz.onceki) + '">\u00F6nceki %' + d.faiz.onceki.toLocaleString('tr-TR') + '</i></a>');
            box.innerHTML = parts.join('');
        })
        .catch(function(){ box.parentElement.style.display = 'none'; });
    })();

    // sticky header: kaydirma sinifi
    (function(){
        var last = 0;
        window.addEventListener('scroll', function(){
            var y = window.scrollY || document.documentElement.scrollTop;
            if((y > 140) !== (last > 140)){
                document.body.classList.toggle('kaydirildi', y > 140);
                last = y;
            }
        }, { passive: true });
    })();

    // sticky header yuksekligi
    (function(){
        var mb = document.querySelector('.nv-mastbar');
        if(!mb) return;
        function ayarla(){ document.documentElement.style.setProperty('--mast-h', mb.offsetHeight + 'px'); }
        ayarla();
        window.addEventListener('resize', ayarla);
    })();

    // manset slider
    (function(){
        var sl = document.getElementById('nvSlider');
        if(!sl) return;
        var slides = sl.querySelectorAll('.nv-slide');
        if(slides.length < 2) return;
        var dots = sl.querySelectorAll('.nv-sl-dots button');
        var idx = 0, timer = null;
        function goster(n){
            idx = (n + slides.length) % slides.length;
            slides.forEach(function(s){ s.classList.remove('aktif'); });
            slides[idx].classList.add('aktif');
            dots.forEach(function(d){ d.classList.remove('aktif'); });
            if(dots[idx]) dots[idx].classList.add('aktif');
        }
        function baslat(){ timer = setInterval(function(){ goster(idx + 1); }, 5000); }
        function durdur(){ clearInterval(timer); }
        dots.forEach(function(d){ d.addEventListener('click', function(e){ e.stopPropagation(); durdur(); goster(+this.dataset.i); baslat(); }); });
        var o = sl.querySelector('.onceki'), s2 = sl.querySelector('.sonraki');
        if(o) o.addEventListener('click', function(e){ e.stopPropagation(); durdur(); goster(idx - 1); baslat(); });
        if(s2) s2.addEventListener('click', function(e){ e.stopPropagation(); durdur(); goster(idx + 1); baslat(); });
        sl.addEventListener('mouseenter', durdur);
        sl.addEventListener('mouseleave', baslat);
        baslat();
    })();

    // hamburger menu
    (function(){
        var hb = document.querySelector('.nv-hamburger');
        var hp = document.getElementById('nvBurgerPanel');
        if(!hb || !hp) return;
        hb.addEventListener('click', function(e){
            e.stopPropagation();
            var ac = hp.classList.toggle('acik');
            hb.classList.toggle('acik', ac);
            hb.setAttribute('aria-expanded', ac ? 'true' : 'false');
        });
        document.addEventListener('click', function(e){
            if(hp.classList.contains('acik') && !hp.contains(e.target) && !hb.contains(e.target)){
                hp.classList.remove('acik'); hb.classList.remove('acik');
            }
        });
        document.addEventListener('keydown', function(e){
            if(e.key === 'Escape'){ hp.classList.remove('acik'); hb.classList.remove('acik'); }
        });
    })();
    </script>
