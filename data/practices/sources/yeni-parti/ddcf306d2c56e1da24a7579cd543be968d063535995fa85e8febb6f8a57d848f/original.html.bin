    </div>


</div>




        <div class="container g-0 g-sm-4">

            <div class="news-section overflow-hidden mt-lg-3">
                <div class="row g-3">
                    <div class="col-lg-8">

                        <div class="inner">
    <a href="https://usakhabergazetesicomtr.teimg.com/crop/1280x720/usakhabergazetesi-com-tr/uploads/2026/10/yeni-parti-usak-il-baskanligina-adayligini-acikladi-111.jpg" class="position-relative d-block" title="Serap Ergün Bitgin, Yeni Parti Uşak İl Başkanlığına Adaylığını Açıkladı" data-fancybox>
                        <div class="zoom-in-out m-3">
