                <div class="flex flex-column gap-m">

                    <div class="flex flex-column gap-s">
                        <!-- KAPAK RESMİ -->
                                                    <a href="/uploads/2026/10/855603164102375588209322738561300050140798196n2-6ada22c3ca645.webp" class="glightbox" data-gallery="dataset-gallery">
                                                                    <picture>
                                        <source media="(max-width: 768px)" srcset="/uploads/2026/10/855603164102375588209322738561300050140798196n2-6ada22c3d7424_thumb.webp">
                                        <img src="/uploads/2026/10/855603164102375588209322738561300050140798196n2-6ada22c3ca645.webp" alt="YENİ PARTİ MUĞLA İL BAŞKANLIĞI SEÇİMİNDE GİRGİN’İN İTİRAZI REDDEDİLDİ" class="article-image">
