                        <div class="related-news my-3 bg-white p-3">
    <div class="section-title d-flex mb-3 align-items-center">
        <div class="h2 lead flex-shrink-1 text-te-color m-0 text-nowrap fw-bold">Bunlar da ilginizi çekebilir</div>
