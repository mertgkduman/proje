    <a href="https://api.whatsapp.com/send?text=DBP%27de+ola%C4%9Fan%C3%BCst%C3%BC+kongre+-+https%3A%2F%2Fwww.haberercis.com.tr%2Fdbpde-olaganustu-kongre" onclick="if (!window.__cfRLUnblockHandlers) return false; initiateDesktopShare(event, 'whatsapp')" class="btn btn-success btn-sm rounded-0 btn-whatsapp shadow-sm me-1" title="Whatsapp&#039;ta Paylaş" data-platform="whatsapp" data-share-url="https://www.haberercis.com.tr/dbpde-olaganustu-kongre" data-share-title="DBP&#039;de olağanüstü kongre" rel="noreferrer nofollow noopener external" data-cf-modified-140a7657744fb9db51be5f1e-="">
