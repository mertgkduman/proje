 // Dünya Kupası sayfalarında / dünya kupası haber detayında kuleleri ayrı handler yönetir; burada çakışmayı önle.
 if (document.querySelector(".dunya-kupasi-page") || false) return;
 const TRIGGER_SCROLL_Y = 300;
 const FOOTER_OFFSET = 200;
 // Yatay konum (left/right) CSS'te (.ad-left-160/.ad-right-160); fixed durumda da % viewport'a
 // gore hesaplanir. Eski inline hesap innerWidth (kaydirma cubugu dahil) kullaniyordu.

 const adElements = [
 { el: document.querySelector(".ad-left-160") },
 { el: document.querySelector(".ad-right-160") }
 ].filter(item => item.el);

 const footerElement = document.querySelector(".footer");

 let isFixed = false;
 let ticking = false;

 function handleScroll() {
 // Kuleler CSS ile gizliyken (viewport < 1432) bosuna konum hesaplama.
 if (window.sdkTowerAds && !window.sdkTowerAds.mediaQuery.matches) return;
 if (!ticking) {
 window.requestAnimationFrame(() => {
 const scrollY = window.scrollY;

 const footerTop = footerElement ? footerElement.getBoundingClientRect().top + scrollY : Infinity;
 const stopY = footerTop - FOOTER_OFFSET;

 if (scrollY > TRIGGER_SCROLL_Y && scrollY < stopY) {
 if (!isFixed) {
