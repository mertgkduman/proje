 .hds-abs { position: absolute; left: 0; right: 0; top: 125px; z-index: 5; }
 /* Şerit varken içerik biraz daha aşağıdan başlar: şeridin üstünde ve altında eşit (~19px / ~14px) boşluk kalır */
