	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">İl&ccedil;e Y&ouml;netim Kurulu</span></span></li>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">Mahalle Danışma Meclisi</span></span></li>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">İl&ccedil;e Danışma Meclisi</span></span></li>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">İl&ccedil;e Kadın Meclisi</span></span></li>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">İl&ccedil;e Gen&ccedil;lik Meclisi</span></span></li>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">D) İl &Ouml;rg&uuml;t&uuml;</span></span></li>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">İl Kongresi</span></span></li>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">İl Eş Başkanlığı</span></span></li>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">İl Y&ouml;netim Kurulu</span></span></li>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">İl Disiplin Kurulu</span></span></li>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">İl Danışma Meclisi</span></span></li>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">İl Kadın Meclisi</span></span></li>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">İl Gen&ccedil;lik Meclisi</span></span></li>
</ol>

<ol>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">E) Parti Temsilciliği ve Lokalleri</span></span></li>
	<li><span style="font-size:12px"><span style="font-family:times new roman,times,serif">Parti temsilciliği</span></span></li>
