    <link rel="stylesheet" href="/files/theme-builds/ultimate-modern/page-0e3ac8d964cf8db953d92c70edf27947c3eb68a39a99d5147d3f8255c2971f75.css?v=0e3ac8d964cf8db953d92c70edf27947c3eb68a39a99d5147d3f8255c2971f75">    <script type="application/ld+json">{"@context":"https://schema.org","@type":"NewsMediaOrganization","@id":"https://www.batmanexpress.com/#organization","url":"https://www.batmanexpress.com/","name":"Batman Express","logo":{"@type":"ImageObject","url":"https://www.batmanexpress.com/assets/branding/batmanexpress-light.svg"},"founder":{"@type":"Person","name":"Mehmet KAYA"},"publisher":{"@type":"Person","name":"Mehmet KAYA"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","@id":"https://www.batmanexpress.com/#website","name":"Batman Express","url":"https://www.batmanexpress.com/","publisher":{"@id":"https://www.batmanexpress.com/#organization"},"inLanguage":"tr","potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://www.batmanexpress.com/search.html?q={search_term_string}"},"query-input":"required name=search_term_string"}}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"NewsArticle","@id":"https://www.batmanexpress.com/haber/dbp-batman-da-secime-gidiyor-33620.html#article","mainEntityOfPage":{"@type":"WebPage","@id":"https://www.batmanexpress.com/haber/dbp-batman-da-secime-gidiyor-33620.html"},"headline":"DBP, BATMAN’DA SEÇİME GİDİYOR","description":"Demokratik Bölgeler Partisi (DBP) Batman İl Örgütü, 19 Eylül Cumartesi Günü gerçekleştirilecek 2. Olağan Kongre öncesinde basın toplantısı düzenledi.","articleSection":"Gündem","articleBody":"DBP Batman İl Binası’nda düzenlenen toplantıda kongrenin hazırlık süreci, gündemi ve programına ilişkin bilgi verildi. Toplantıda Kürtçe basın metnini Yunus Bağış, Türkçe metni ise TJA aktivisti Havva Can okudu.\r\nKONGRE HAZIRLIKLARI PAYLAŞILDI\r\nBasın toplantısında DBP Batman İl Örgütü’nün kongre hazırlıkları ve kongre programına ilişkin bilgiler paylaşıldı.  Kongreye ilişkin yapılan açıklamada, kadınlar, gençler, emekçiler, demokratik kitle örgütleri, siyasi parti ve kurum temsilcileri, aydınlar ve basın emekçileri davet edildi.\r\nKONGRE 19 EYLÜL’DE\r\nDBP Batman İl Örgütü 2. Olağan Kongresi, 19 Eylül 2026 Cumartesi günü saat 13.00’te Roza Düğün Salonu’nda gerçekleştirilecek.","inLanguage":"tr","isAccessibleForFree":true,"isFamilyFriendly":true,"datePublished":"2026-09-17T18:44:00+03:00","dateModified":"2026-09-17T18:45:00+03:00","wordCount":147,"author":{"@type":"Organization","@id":"https://www.batmanexpress.com/#organization","name":"Batman Express"},"publisher":{"@id":"https://www.batmanexpress.com/#organization"},"publishingPrinciples":"https://www.batmanexpress.com/bilgi/yayin-ilkeleri.html","image":["https://batmanexpress-com.cdn.newsdata.com.tr/files/uploads/news/default/dbp-batman-da-secime-gidiyor-158553.webp"],"thumbnailUrl":"https://batmanexpress-com.cdn.newsdata.com.tr/files/uploads/news/default/dbp-batman-da-secime-gidiyor-158553.webp"}</script>
