/* ========================================
   YAZARLAR SAYFASI
   Masaüstü: 5 yazar
   Mobil: 3 yazar
   ======================================== */

.yazarlar-grid {
    display: grid !important;
    grid-template-columns: repeat(5, minmax(0, 1fr)) !important;
    column-gap: 18px !important;
    row-gap: 30px !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
}

/* WPBakery'nin clearfix yapısını iptal et */
.yazarlar-grid::before,
.yazarlar-grid::after {
    display: none !important;
    content: none !important;
}

/* WPBakery'nin 1/5 genişliğini Grid'e bırak */
.yazarlar-grid > .yazar-karti {
    width: auto !important;
    max-width: none !important;
    float: none !important;
    clear: none !important;
    position: relative !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* İç padding */
.yazarlar-grid > .yazar-karti > .vc_column-inner {
    padding-left: 5px !important;
    padding-right: 5px !important;
}

/* Fotoğraf hizalama */
.yazar-karti .wpb_single_image {
    margin-bottom: 8px !important;
    text-align: center !important;
}

/* Fotoğraflar */
.yazar-karti .wpb_single_image img {
    width: 100px !important;
    height: 100px !important;
    max-width: 100px !important;
    object-fit: cover !important;
    border-radius: 50% !important;
}

/* Yazar isimleri */
.yazar-karti h3 {
    margin: 5px 0 0 !important;
    font-size: 15px !important;
    line-height: 1.3 !important;
    text-align: center !important;
}


/* TABLET */
@media only screen and (max-width: 991px) {

    .yazarlar-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
        column-gap: 12px !important;
    }
}


/* MOBİL */
@media only screen and (max-width: 767px) {

    .yazarlar-grid {
        display: grid !important;
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        column-gap: 6px !important;
        row-gap: 22px !important;
        width: 100% !important;
    }

    .yazarlar-grid > .yazar-karti {
        width: auto !important;
        min-width: 0 !important;
        max-width: none !important;
        float: none !important;
        clear: none !important;
        flex: none !important;
        padding: 0 2px !important;
    }

    .yazarlar-grid > .yazar-karti > .vc_column-inner {
        width: 100% !important;
        padding-left: 2px !important;
        padding-right: 2px !important;
    }

    .yazar-karti .wpb_single_image {
        margin-bottom: 5px !important;
    }

    .yazar-karti .wpb_single_image img {
        width: 80px !important;
        height: 80px !important;
        max-width: 80px !important;
        min-width: 0 !important;
    }

    .yazar-karti h3 {
        margin: 4px 0 0 !important;
        padding: 0 2px !important;
        font-size: 12px !important;
        line-height: 1.2 !important;
        overflow-wrap: anywhere !important;
        word-break: normal !important;
    }
}

/* Yazar gridinin soldan boşluk bırakmasını engelle */
.yazarlar-grid {
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
}

.yazarlar-grid > .yazar-karti:first-child {
    margin-left: 0 !important;
    padding-left: 0 !important;
}

.yazarlar-grid > .yazar-karti:first-child > .vc_column-inner {
    padding-left: 0 !important;
}

/* Yazar kutusunu kompakt hale getir */
.jeg_authorbox {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;

    width: auto !important;
    max-width: 100% !important;

    padding: 8px 12px !important;
    margin-top: 15px !important;
    margin-bottom: 15px !important;

    border: 1px solid #e6e6e6 !important;
    background: #fff !important;
}

/* Avatar alanı */
.jeg_authorbox .jeg_author_image {
    width: 48px !important;
    min-width: 48px !important;
    margin: 0 !important;
}

/* Avatar */
.jeg_authorbox .jeg_author_image img {
    width: 48px !important;
    height: 48px !important;
    object-fit: cover !important;
    border-radius: 50% !important;
}

/* İçerik alanı */
.jeg_authorbox .jeg_author_content {
    padding: 0 !important;
    margin: 0 !important;
}

/* Yazar adı */
.jeg_authorbox .jeg_author_name {
    margin: 0 !important;
    padding: 0 !important;
    font-size: 15px !important;
    line-height: 1.2 !important;
}

/* Biyografiyi gizle */
.jeg_authorbox .jeg_author_description,
.jeg_authorbox .jeg_author_desc,
.jeg_authorbox .author_description {
    display: none !important;
}

/* Sosyal medya bağlantılarını gizle */
.jeg_authorbox .jeg_author_socials,
.jeg_authorbox .socials_widget {
    display: none !important;
}


.carousel-yazar {
    margin-top: 6px;
    font-size: 13px;
    font-weight: 600;
    color: #777;
}

.carousel-yazar a {
    color: #777;
    text-decoration: none;
}

.carousel-yazar a:hover {
    color: #d71920;
}


/* =========================================
   POLİTİKA HABER - SIDEBAR YAZAR SLIDER
   ========================================= */

.ph-yazar-sidebar {
    display: block;
    width: 100%;
    max-width: 100%;
    padding: 15px;
    border: 1px solid #e8e8e8;
    background: #fff;
    box-sizing: border-box;
}

/* Başlık */

.ph-yazar-sidebar-header {
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 2px solid #d71920;
}

.ph-yazar-sidebar-header a {
    color: #222;
    font-size: 17px;
    font-weight: 700;
    text-decoration: none;
}

/* Slider dış alan */

.ph-yazar-slider-wrap {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
    min-width: 0;
}

/* Görünen ve kaydırılan alan */

.ph-yazar-viewport {
    display: block;
    width: 100%;
    min-width: 0;

    overflow-x: auto;
    overflow-y: hidden;

    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;

    scrollbar-width: none;
    -ms-overflow-style: none;

    -webkit-overflow-scrolling: touch;
}

.ph-yazar-viewport::-webkit-scrollbar {
    display: none;
}

/* Hareket eden bölüm */

.ph-yazar-track {
    display: flex;
    flex-wrap: nowrap;
    width: 100%;
}

/* Her yazar */

.ph-yazar-item {
    flex: 0 0 50%;
    width: 50%;

    padding: 4px 5px 8px;

    box-sizing: border-box;

    text-align: center;
    text-decoration: none;

    scroll-snap-align: start;
}

/* Yazar fotoğrafı */

.ph-yazar-item img {
    display: block;

    width: 82px;
    height: 82px;

    margin: 0 auto 8px;

    border-radius: 50%;

    object-fit: cover;

    transition: transform 0.2s ease;
}

/* İsim */

.ph-yazar-item span {
    display: block;

    min-height: 34px;

    color: #222;

    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;

    transition: color 0.2s ease;
}

.ph-yazar-item:hover img {
    transform: scale(1.05);
}

.ph-yazar-item:hover span {
    color: #d71920;
}

/* Sağ-sol okları */

.ph-yazar-arrow {
    position: absolute;

    top: 34px;

    z-index: 10;

    display: flex;

    align-items: center;
    justify-content: center;

    width: 28px;
    height: 28px;

    padding: 0;

    border: 1px solid #ddd;
    border-radius: 50%;

    background: rgba(255, 255, 255, 0.95);

    color: #333;

    font-size: 22px;
    line-height: 1;

    cursor: pointer;

    transition: 0.2s;
}

.ph-yazar-prev {
    left: -6px;
}

.ph-yazar-next {
    right: -6px;
}

.ph-yazar-arrow:hover {
    border-color: #d71920;
    background: #d71920;
    color: #fff;
}

/* Tüm Yazarlar */

.ph-yazar-all {
    margin-top: 10px;
    padding-top: 8px;

    border-top: 1px solid #eee;

    text-align: center;
}

.ph-yazar-all a {
    color: #777;

    font-size: 11px;
    font-weight: 700;

    text-decoration: none;
}

.ph-yazar-all a:hover {
    color: #d71920;
}

/* =========================================
   MOBİL
   ========================================= */

@media only screen and (max-width: 767px) {

    .ph-yazar-sidebar {
        display: block !important;
        visibility: visible !important;
        opacity: 1 !important;

        width: 100% !important;
        max-width: 100% !important;

        padding: 12px;

        box-sizing: border-box;
    }

    .ph-yazar-slider-wrap {
        display: flex !important;
        width: 100%;
        min-width: 0;
    }

    .ph-yazar-viewport {
        display: block !important;

        width: 100% !important;
        min-width: 0;

        overflow-x: auto !important;
        overflow-y: hidden;

        -webkit-overflow-scrolling: touch;
    }

    .ph-yazar-track {
        display: flex !important;
        flex-wrap: nowrap !important;
        width: 100%;
    }

    .ph-yazar-item {
        flex: 0 0 50%;
        width: 50%;
    }

    .ph-yazar-item img {
        width: 72px;
        height: 72px;
    }

    .ph-yazar-item span {
        font-size: 12px;
    }

    .ph-yazar-arrow {
        display: flex !important;
    }
}

/* Özel başlık */

.ph-ozel-baslik .jeg_block_title {
    font-size: 13px !important;
}

/* ==================================
   EN SON YAZAR YAZILARI SLIDER
   ================================== */

.ph-yazi-slider {
    width: 100%;
    padding: 14px;
    border: 1px solid #e8e8e8;
    background: #fff;
    box-sizing: border-box;
}

/* Başlık */

.ph-yazi-slider-header {
    margin-bottom: 15px;
    padding-bottom: 8px;
    border-bottom: 2px solid #d71920;

    color: #222;
    font-size: 17px;
    font-weight: 700;
}

/* Slider */

.ph-yazi-slider-wrap {
    position: relative;
}

.ph-yazi-viewport {
    overflow: hidden;
}

.ph-yazi-track {
    display: flex;
    flex-wrap: nowrap;

    overflow-x: auto;

    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;

    scrollbar-width: none;
}

.ph-yazi-track::-webkit-scrollbar {
    display: none;
}


/* Bir yazı */

.ph-yazi-card {
    flex: 0 0 50%;
    width: 50%;

    padding: 0 6px;

    box-sizing: border-box;

    scroll-snap-align: start;
}


/* Görsel */

.ph-yazi-image {
    display: block;

    width: 100%;
    overflow: hidden;

    margin-bottom: 8px;
}

.ph-yazi-image img {
    display: block;

    width: 100%;
    height: 105px;

    object-fit: cover;

    transition: transform 0.25s ease;
}

.ph-yazi-card:hover img {
    transform: scale(1.04);
}


/* Başlık */

.ph-yazi-card h3 {
    margin: 0 0 6px;

    font-size: 14px;
    line-height: 1.3;
}

.ph-yazi-card h3 a {
    color: #222;
    text-decoration: none;
}

.ph-yazi-card h3 a:hover {
    color: #d71920;
}


/* Yazar */

.ph-yazi-author {
    color: #777;

    font-size: 12px;
    font-weight: 600;
}


/* Oklar */

.ph-yazi-prev,
.ph-yazi-next {
    position: absolute;

    top: 40px;

    z-index: 10;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 28px;
    height: 28px;

    padding: 0;

    border: 1px solid #ddd;
    border-radius: 50%;

    background: rgba(255,255,255,.95);

    color: #222;

    font-size: 22px;

    cursor: pointer;
}

.ph-yazi-prev {
    left: -8px;
}

.ph-yazi-next {
    right: -8px;
}

.ph-yazi-prev:hover,
.ph-yazi-next:hover {
    border-color: #d71920;
    background: #d71920;
    color: #fff;
}


/* Mobil */

@media only screen and (max-width: 767px) {

    .ph-yazi-card {
        flex-basis: 50%;
        width: 50%;
    }

    .ph-yazi-image img {
        height: 90px;
    }

    .ph-yazi-card h3 {
        font-size: 12px;
    }

    .ph-yazi-author {
        font-size: 11px;
    }
}

		</style>
