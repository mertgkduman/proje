 // ===== Masthead sticky (scroll'da asagi kayma) AC/KAPA =====
 // false => masthead asagi kaymaz (statik durur). Acmak icin true yap.
 var ENABLE_MASTHEAD_STICKY = false;

 const masthead = document.getElementById("native_masthead_970x250");
 if (!masthead) return;

 const placeholder = document.createElement("div");
 placeholder.style.display = "none";
 placeholder.style.height = masthead.offsetHeight + "px";
 placeholder.style.margin = getComputedStyle(masthead).margin;
 masthead.parentNode.insertBefore(placeholder, masthead);

 let originalTop = masthead.offsetTop;
 let hasShown = false;
 let timer = null;
 let observer = null;

 function hasAdContent() {
 // Sadece gercek reklam icerigi kontrol et (iframe = GPT reklami yuklendi)
 return masthead.querySelector("iframe, img, video, object, embed");
 }

 function updateOverlay() {
 if (window.scrollY > 10) {
 masthead.classList.add("scrolled");
 } else {
 masthead.classList.remove("scrolled");
 }
 }

 function showAd() {
 if (hasShown) return;
 hasShown = true;

 placeholder.style.display = "block";
 masthead.classList.add("is-fixed");

 updateOverlay();

 requestAnimationFrame(function () {
 masthead.classList.add("is-visible");
 });

 clearTimeout(timer);

 timer = setTimeout(function () {
 masthead.classList.remove("is-visible");

 setTimeout(function () {
 masthead.classList.remove("is-fixed");
 placeholder.style.display = "none";
 }, 350);

 }, 5000);
 }

 window.addEventListener("scroll", function () {
 // Sticky kapaliysa scroll'da asagi kayma calismasin
 if (!ENABLE_MASTHEAD_STICKY) return;

 updateOverlay();

 if (window.scrollY > originalTop + 50 && !hasShown) {

 if (hasAdContent()) {
 showAd();
 return;
 }

 if (observer) observer.disconnect();

 observer = new MutationObserver(function () {
 if (hasAdContent()) {
 observer.disconnect();
 showAd();
 }
 });

 observer.observe(masthead, {
 childList: true,
 subtree: true,
 characterData: true
 });

 setTimeout(function () {
 if (observer) observer.disconnect();
 }, 7000);
 }
 });
 }); </script> <!-- Sağ 160x600 (Dünya Kupası'nda WorldCup 160x2053 kulesine döner) --> <div class="ad-right-160"> <div id="160x600_right"> <div id="native_160x600_right"> <div id='div-gpt-ad-1728979615093-0' style='min-width: 120px; min-height: 600px;'> </div> </div> </div> </div> <!-- Sol 160x600 (Dünya Kupası'nda WorldCup 160x2053 kulesine döner) --> <div class="ad-left-160"> <div id="160x600_left"> <div id="native_160x600_left"> <div id='div-gpt-ad-1728979603192-0' style='min-width: 120px; min-height: 600px;'> </div> </div> </div> </div> <!-- Mobil Masthead --> <div id="native_masthead_mobil" style="width: 320px; height: 100px; margin: 0 auto 32px; display: block;"> <div id="native_masthead_320x100"> <div id="div-gpt-ad-1791468940691-0"></div> </div> </div> <script> window.googletag = window.googletag || { cmd: [] };

