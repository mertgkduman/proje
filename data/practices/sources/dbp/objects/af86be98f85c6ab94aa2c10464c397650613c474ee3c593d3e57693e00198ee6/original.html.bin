 transform: translateZ(0);
 will-change: transform, left, right;
 } </style> <script> // Kule (160x600) reklamlari icin ortak tembel tanimlama yardimcisi (ana sayfa + haber detay).
 // Esik 1432 px: 1060 px icerik + 2 x (160 px kule + 4 px kenar) = 1388 px + ~16 px kaydirma cubugu (media query
 // cubugu da sayar); 1432'de bosluk ~14px, 1440 ekranda ~18px. CSS (max-width:1431px) kutulari gizler;
 // burada GPT slotu, viewport ilk kez esigi gectiginde tanimlanir ve gosterilir. Kutular DOM'dan silinmez,
 // boylece pencere sonradan genisletildiginde (Mac'te tam ekran, DevTools kapatma vb.) kuleler yenileme
 // beklemeden gelir. Viewport tekrar daralirsa CSS gizler, iframe korunur.
 window.sdkTowerAds = window.sdkTowerAds || (function () {
 var MIN_WIDTH_PX = 1432;
 var mq = window.matchMedia('(min-width: ' + MIN_WIDTH_PX + 'px)');

 function init(slots, targeting) {
 var defined = false;

 function defineAndDisplay() {
 if (defined) return;
 defined = true;
 window.googletag = window.googletag || { cmd: [] };
 googletag.cmd.push(function () {
 var displayIds = [];
 slots.forEach(function (s) {
 if (!document.getElementById(s.divId)) return;
 var slot = googletag.defineSlot(s.adUnit, s.sizes, s.divId);
 if (!slot) return; // div zaten baska bir slota bagli
 if (targeting) slot.setConfig({ targeting: targeting });
 slot.addService(googletag.pubads());
 displayIds.push(s.divId);
 });
 if (!displayIds.length) return; // bu sayfada kule div'i yok (orn. Dunya Kupasi id'leri)
 if (!googletag.pubadsReady) {
 // Ilk yuklemede prebid_*configv5.js'ten once calisiriz; sayfa geneli ayarlar burada.
 googletag.setConfig({ singleRequest: true });
 }
 googletag.enableServices();
 displayIds.forEach(function (id) { googletag.display(id); });
 });
 }

 if (mq.matches) {
 defineAndDisplay();
 return;
 }
 var timer = null;
 var onChange = function (e) {
 // Kisa bekleme: hizli genislet/daralt sirasinda gizli kutuya istek atmayalim (adsby autobackfill,
 // clientWidth==0 gordugu dolu slotu bos sayip kendi birimiyle yeniden tanimliyor).
 if (timer) { clearTimeout(timer); timer = null; }
 if (!e.matches) return;
 timer = setTimeout(function () {
 timer = null;
 if (!mq.matches) return;
 if (mq.removeEventListener) mq.removeEventListener('change', onChange); else mq.removeListener(onChange);
 defineAndDisplay();
 }, 400);
 };
 if (mq.addEventListener) mq.addEventListener('change', onChange); else mq.addListener(onChange);
 }

 return { init: init, minWidth: MIN_WIDTH_PX, mediaQuery: mq };
 })(); </script> <!-- Scroll ile yukarıdan kayan sabit masthead için stiller --> <style> #native_masthead_970x250.is-fixed {
