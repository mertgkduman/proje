window.location.href+" #refr";$("#refr").load(refrstring, function(){twttr.widgets.load();});}</script><script type="text/javascript">var ha = ( $('.live-blog-video').offset().top + $('.live-blog-video').height() );$(window).scroll(function(){if ( $(window).scrollTop() > ha + 300 ) {$('.live-blog-video').css('bottom','0');} else if ( $(window).scrollTop() < ha + 200) {$('.live-blog-video').removeClass('out').addClass('in');} else {$('.live-blog-video').removeClass('in').addClass('out');$('.live-blog-video').css('bottom','-300px');};});</script><style>.embed-container { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; max-width: 100%; } .embed-container iframe, .embed-container object, .embed-container embed { position: absolute; top: 0; left:0px; width: 100%; height: 100%; }</style> <div class="col-lg-3 col-sm-3 col-md-3 mobile-section2"> <div class="list-block sidebar-haber list-group shadow"> <div class="writers-list"> <div class="title-yazar"><span>YAZARLAR</span></div> <div class="writer"> <a class="item" href="https://www.evrensel.net/yazi/87984/her-seyi-ben-bilirim-tutumu-asiyi-asi-sorununa-donusturuyor" target="_blank"> <img src="https://www.evrensel.net/upload/yazar/cache/100x100/yazar_e8298fe29bb34f1280c4f33ea90d5bb71c4d6aa2.jpg" alt="İhsan Çaralan" class="rounded-circle shadow"> <div class="slug">İhsan Çaralan</div>  <p>‘Her şeyi ben bilirim’ tutumu, ‘aşı’yı ‘aşı sorunu’na dönüştürüyor</p> </a> <a class="item" href="https://www.evrensel.net/yazi/87987/gercekten-erdogana-tuzak-mi-kuruluyor" target="_blank"> <img src="https://www.evrensel.net/upload/yazar/cache/100x100/yazar_4a080115fbe76080e405e2071d4398a8fb38be78.jpg" alt="Yusuf Karataş" class="rounded-circle shadow"> <div class="slug">Yusuf Karataş</div> <p>Gerçekten Erdoğan’a tuzak mı kuruluyor?</p> </a> <a class="item" href="https://www.evrensel.net/yazi/87982/aihm-ve-bagimsiz-yargi" target="_blank"> <img src="https://www.evrensel.net/upload/yazar/cache/100x100/yazar_014ea5906e6f