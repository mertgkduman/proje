ürleri" /> </a> </div><div class="writers-list"> <iframe style="margin:5px 0 25px 0;display:block;" name="BIKADV" src="https://medya.ilan.gov.tr/widgets/YYN-000341-20160622.html" scrolling="no" width="100%" height="140" frameborder="0"></iframe> </div><div class="writers-list nomobile"> <a class="item" href="https://www.evrensel.net/fotograf/5/evrensel-gazetesi-birinci-sayfasi" target="_blank"> <div class="title-sidebar"><span>BİRİNCİ SAYFA</span></div> <img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x420.jpg" data-src="https://www.evrensel.net/upload/fotograf/cache/255x420/fotograf_e8b4d1b6c1096f4766236948a3f131abf3adfc58.jpg" alt="Evrensel Gazetesi Birinci Sayfa" /> </a> </div> <div class="writers-list"> </div> <div class="writers-list bulten_sidebar nomobile shadow"> <a class="item" href="https://www.evrensel.net/haber-bulteni" target="_blank"><div class="slug">HABER BÜLTENİ</div> <img src="https://www.evrensel.net/tema/evr19/img/ebulten.jpeg" alt="Evrensel haber bülteni" style="width:100%" /></a> </div> </div> </div> </div> </div></section><section class="tab-mobile"><div class="container"><div class="row"><div class="col-lg-4 col-sm-4 col-md-4"><div class="tab shadow"> <button class="tablinks" onclick="openCity(event, 'karikatur')" id="defaultOpen">SEFER SELVİ</button> <button class="tablinks" onclick="openCity(event, 'gazete')">BİRİNCİ SAYFA</button></div><div id="karikatur" class="tabcontent"><a href="https://www.evrensel.net/fotograf/4/sefer-selvi-karikaturleri" target="_blank"><img class="lazyload" src="https://www.evrensel.net/tema/evr19/img/255x210.jpg" data-src="https://www.evrensel.net/upload/fotograf/fotograf_d96a663e64e8505013a149b6f72b5afd316445a2.jpg" alt="Sefer Selvi Karikatürleri" /></a> </div><div id="gazete" class="tabcontent"><a href="https://www.evrensel.net/fotograf/5/evrensel-gazetesi-birinci-sayfasi" target="_blank"><img class="lazyload" src="https://www.evrensel.net/tema/evr19/img/255x420.jpg" data-src="https://www.evrensel.net/upload/fotograf/cache/255x420/fotograf_e8b4d1b6c1096f4766236948a3f131abf3adfc58.jpg" alt="Evrensel Gazetesi Birinci Sayfa" /></a></div></div></div></div></section> <section class="blog-full-with-sidebar"><div class="site-wrapper"><div class="site-content"><div class="section-content"><div class="container"><div class="row"><div class="col-md-10 ml-md-auto mr-md-auto"> <div class="rooms rooms--modern"> <div class="room"> <div class="room__body"> <a href="https://www.evrensel.net/haber/423996/milli-egitim-bakani-ziya-selcuktan-yuz-yuze-egitim-aciklamasi" target="_blank"><div class="room__header"><div class="room__meta"><img style="width:45%;float:left;margin:0 10px 0 0" src="https://www.evrensel.net/images/570/upload/dosya/168025.jpg" alt="Milli Eğitim Bakanı Ziya Selçuk&#39;tan yüz yüze eğitim açıklaması"></div></div><div class="room__excerpt"><p>Milli Eğitim Bakanı Ziya Selçuk&#39;tan yüz yüze eğitim açıklaması</p></div><div class="room__footer"><p class="btn btn-link btn-link--clean btn-link--dash">OKUMAK İÇİN TIKLAYIN...</p></div> </a> </div><div class="room__img"> <a href="https://www.evrensel.net/haber/396181/koronavirus-nedir-nasil-bulasir-belirtileri-neler-koronavirusten-nasil-korunuruz" target="_blank"><div class="room__badge room__badge--inverse" style="width:70%"><span style="font-size:2.3rem;font-weight: bold;padding: 5px 10px;display: block;line-height:2.8rem;">Koronavirüs vaka sayıları, son haberler, analizler</span>  <p style="font-size:1rem;font-weight: bold;padding: 5px 10px;display: block;line-height:1rem;color:#d0d0d0;width:150px"></p> </div><img src="https://www.evrensel.net/images/840/upload/dosya/159017.jpg"> </a></div></div> </div> </div></div></div></div></div></div></section><section class="blog-full-with-sidebar"><div class="container"><div class="row"><div class="col-lg-12 col-sm-12"><div class="row"><div class="categorygrid"><div class="categorygrid__gridwrapper"><div class="categorygrid__grid"><div class="col-lg-3 col-sm-3"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423996/milli-egitim-bakani-ziya-selcuktan-yuz-yuze-egitim-aciklamasi" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/168025.jpg" alt="Milli Eğitim Bakanı Ziya Selçuk&#39;tan yüz yüze eğitim açıklaması"></div><div class="card-body"><h5 class="card-title">Milli Eğitim Bakanı Ziya Selçuk&#39;tan yüz yüze eğitim açıklaması</h5><p class="card-text">Milli Eğitim Bakanı Ziya Selçuk: 15 Şubat&#39;tan itibaren okulların mümkün olduğu kadar daha yüksek bir kapasiteyle açılması gerektiği noktasında bir kararlılığımız var.</p></div></a></div></div></div><div class="col-lg-3 col-sm-3"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423995/erisim-engeli-getirilen-haberlerin-yuzde-42si-erdogan-ve-cevresi-hakkinda-oldu" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/173970.jpg" alt="Erişim engeli getirilen haberlerin yüzde 42’si Erdoğan ve çevresi hakkında oldu"></div><div class="card-body"><h5 class="card-title">Erişim engeli getirilen haberlerin yüzde 42’si Erdoğan ve çevresi hakkında oldu</h5><p class="card-text">Free Web Turkey&#39;in raporuna göre Kasım 2019- Ekim 2020 arasında en az 1910 URL engellendi. Engellenen haberlerin yüzde 42’si AKP&#39;li Cumhurbaşkanı Tayyip Erdoğan, ailesi ve çevresi hakkında oldu.</p></div></a></div></div></div><div class="col-lg-3 col-sm-3"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423991/odtude-8-ogrenci-asistani-isten-atildi-siyasi-olarak-alinan-karar-geri-cekilmeli" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/176331.jpg" alt="ODTÜ&#39;de 8 öğrenci asistanı işten atıldı: Siyasi olarak alınan karar geri çekilmeli"></div><div class="card-body"><h5 class="card-title">ODTÜ&#39;de 8 öğrenci asistanı işten atıldı: Siyasi olarak alınan karar geri çekilmeli</h5><p class="card-text">CHP Ankara Milletvekili Levent Gök, ODTÜ bünyesinde görev yapan 8 öğrenci asistanının görevlerine son verilmesini Meclis gündemine taşıdı.</p></div></a></div></div></div><div class="col-lg-3 col-sm-3"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423989/iran-sinirinda-cig-altinda-kalan-5-kolber-halen-kayip" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/176315.jpg" alt="İran sınırında çığ altında kalan 5 kolber halen kayıp"></div><div class="card-body"><h5 class="card-title">İran sınırında çığ altında kalan 5 kolber halen kayıp</h5><p class="card-text">İran sınırındaki çığ sonrası kendilerinden haber alınamayan 5 kolberi arama çalışmaları kötü hava koşulları nedeniyle yapılamıyor.</p></div></a></div></div></div><div class="col-lg-3 col-sm-3"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423935/joe-biden-ve-kamala-harrisin-yemin-toreni-nasil-yapilacak-ne-hazirliklar-yapildi" target="_blank"><div class="btn btn-round btn-danger btn-sm card-blog-link"><i class="fas fa-history"></i> GÜNCELLENDİ</div><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/177320.jpg" alt="Joe Biden ve Kamala Harris&#39;in yemin töreni nasıl yapılacak, ne hazırlıklar yapıldı?"></div><div class="card-body"><h5 class="card-title">Joe Biden ve Kamala Harris&#39;in yemin töreni nasıl yapılacak, ne hazırlıklar yapıldı?</h5><p class="card-text">Kongre binası baskınının ardından güvenlik önlemlerinin üst seviyede olduğu ABD&#39;de Joe Biden&#39;ın devir teslimi bugün gerçekleşecek. Seromoni, Joe Biden ve Kamala Harris&#39;in yemin töreni ile başlayacak.</p></div></a></div></div></div><div class="col-lg-3 col-sm-3"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423986/tbmm-baskani-sentop-bugune-kadar-142-milletvekilinde-koronavirus-tespit-edildi" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/159485.jpg" alt="TBMM Başkanı  Şentop: Bugüne kadar 142 milletvekilinde koronavirüs tespit edildi"></div><div class="card-body"><h5 class="card-title">TBMM Başkanı  Şentop: Bugüne kadar 142 milletvekilinde koronavirüs tespit edildi</h5><p class="card-text">TBMM Başkanı Mustafa Şentop Kovid-19 aşısı yaptırdı. Sonrasında açıklama yapan Şentop, bugüne kadar 142 milletvekilinde koronavirüs tespit edildiğini duyurdu.</p></div></a></div></div></div><div class="col-lg-3 col-sm-3"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423981/donald-trump-73-kisi-hakkinda-af-karari-cikardi" target="_blank"><div class="btn btn-round btn-danger btn-sm card-blog-link"><i class="fas fa-history"></i> GÜNCELLENDİ</div><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/173758.jpg" alt="Donald Trump 73 kişi hakkında af kararı çıkardı"></div><div class="card-body"><h5 class="card-title">Donald Trump 73 kişi hakkında af kararı çıkardı</h5><p class="card-text">ABD Başkanı Donald Trump, Beyaz Saray&#39;daki son saatlerinde 73 kişi hakkında af kararı çıkardı. 70 kişinin de cezasını hafifletti.</p></div></a></div></div></div><div class="col-lg-3 col-sm-3"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423982/kulis-cumhur-ittifaki-secimlere-katilma-kosullarinda-duzenleme-yapmaya-hazirlaniyor" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/176885.jpg" alt="Kulis: Cumhur İttifakı, seçimlere katılma koşullarında düzenleme yapmaya hazırlanıyor"></div><div class="card-body"><h5 class="card-title">Kulis: Cumhur İttifakı, seçimlere katılma koşullarında düzenleme yapmaya hazırlanıyor</h5><p class="card-text">Cumhur İttifakının, anayasa referandumundan bu yana yapmayı planladığı seçimler yasasında değişiklik çalışmalarına hız verdiği iddia edildi.</p></div></a></div></div></div></div></div></div></div></div></div></div></section><div class="jumbotron"></div><section class="blog-full-with-sidebar"><div class="container"><div class="row"><div class="col-lg-12 col-sm-12"><div class="row"><div class="categorygrid"><div class="categorygrid__gridwrapper"><div class="categorygrid__grid"><div class="col-lg-4 col-sm-4"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423927/melek-kentmen-hulusi-kentmen-karakter-oyuncusuydu-ama-basrol-oyuncusu-gibi-sevildi" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/177281.jpg" alt="Melek Kentmen: Hulusi Kentmen karakter oyuncusuydu ama başrol oyuncusu gibi sevildi"></div><div class="card-body"><h5 class="card-title">Melek Kentmen: Hulusi Kentmen karakter oyuncusuydu ama başrol oyuncusu gibi sevildi</h5></div></a></div></div></div><div class="col-lg-4 col-sm-4"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423769/yilin-ilk-derbisinde-besiktas-galatasarayi-2-0-maglup-etti" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/177165.jpg" alt="Yılın ilk derbisinde Beşiktaş, Galatasaray&#39;ı 2-0 mağlup etti"></div><div class="card-body"><h5 class="card-title">Yılın ilk derbisinde Beşiktaş, Galatasaray&#39;ı 2-0 mağlup etti</h5></div></a></div></div></div><div class="col-lg-4 col-sm-4"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423765/fenerbahce-mesut-ozil-transferinde-mutlu-sona-ulasti" target="_blank"><div class="btn btn-round btn-danger btn-sm card-blog-link"><i class="fas fa-history"></i> GÜNCELLENDİ</div><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/177160.jpg" alt="Fenerbahçe, Mesut Özil transferinde mutlu sona ulaştı"></div><div class="card-body"><h5 class="card-title">Fenerbahçe, Mesut Özil transferinde mutlu sona ulaştı</h5></div></a></div></div></div><div class="col-lg-4 col-sm-4"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423689/gulten-akin-siir-dinletisi-online-yapilacak" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/177099.jpg" alt="Gülten Akın şiir dinletisi online yapılacak"></div><div class="card-body"><h5 class="card-title">Gülten Akın şiir dinletisi online yapılacak</h5></div></a></div></div></div><div class="col-lg-4 col-sm-4"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423666/aykut-kence-evrim-konferansi-bu-yil-online-yapilacak" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/177084.jpg" alt="Aykut Kence Evrim Konferansı bu yıl online yapılacak"></div><div class="card-body"><h5 class="card-title">Aykut Kence Evrim Konferansı bu yıl online yapılacak</h5></div></a></div></div></div><div class="col-lg-4 col-sm-4"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423642/bireysel-cizgiden-toplumculuga-n-zim-hikmet" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/109167.jpg" alt="&quot;Bireysel&quot; çizgiden &quot;toplumculuğa&quot; Nâzım Hikmet"></div><div class="card-body"><h5 class="card-title">&quot;Bireysel&quot; çizgiden &quot;toplumculuğa&quot; Nâzım Hikmet</h5></div></a></div></div></div></div></div></div></div></div></div></div></section><div class="jumbotron"></div><section class="blog-full-with-sidebar"><div class="container"><div class="row"><div class="col-lg-3 col-sm-3"><div class="categorygrid__griditem--tall"><div class="card card-blog-entry bg-viridian-500 text-white-50 border-0 shadow" style="background-color:#3c8536!important;margin:0 0 10px 0"><div class="card-blog-img"><a href="https://www.evrensel.net/ege" target="_blank"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x420.jpg" data-src="https://www.evrensel.net/upload/dosya/153201.jpg" alt="Evrensel Ege Sayfaları" /></a></div><div class="card-body mb-4 md-2"><h5 class="card-title card-title-light-1 text-uppercase"><a href="https://www.evrensel.net/ege">EVRENSEL EGE</a></h5><p class="card-text margin-55-0">Ege'den daha fazla haber, röportaj, mektup, analiz ve köşe yazısı...</p></div><div class="card-footer border-0 bg-transparent margin-35-0-0-0"><div class="meta-item meta-light-2 float-right mb-2"><a href="https://www.evrensel.net/ege"><i class="fas fa-book-open"></i> Ege Sayfaları için tıklayın...</a></div></div></div></div></div><div class="col-lg-9 col-sm-9"><div class="row"><div class="categorygrid"><div class="categorygrid__gridwrapper"><div class="categorygrid__grid"><div class="col-lg-4 col-sm-4"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423970/sosyal-denge-tazminatina-sayistay-tirpani" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/122376.jpg" alt="Sosyal denge tazminatına Sayıştay tırpanı"></div><div class="card-body"><h5 class="card-title">Sosyal denge tazminatına Sayıştay tırpanı</h5><p class="card-text">Sayıştay, 2015-2016&#39;da Balçova Belediyesiyle imzalanan toplu sözleşmede yer alan sosyal denge tazminatının tavan tutarı aştığını belirleyip &quot;kamu zararı&quot; dedi. Emekçiler karara tepkili.</p></div></a></div></div></div><div class="col-lg-4 col-sm-4"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423958/chp-jeslerle-ilgili-rapor-calismasina-basladi" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/177305.jpg" alt="CHP JES’lerle ilgili rapor çalışmasına başladı"></div><div class="card-body"><h5 class="card-title">CHP JES’lerle ilgili rapor çalışmasına başladı</h5><p class="card-text">CHP Jeotermal Enerji Araştırma Komisyonu, Aydın, Manisa, Denizli, İzmir ve Muğla’da yapacakları toplantı ve araştırmalar sonucu JES’lerle ilgili rapor hazırlayacağını duyurdu.</p></div></a></div></div></div><div class="col-lg-4 col-sm-4"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423864/doc-dr-cemal-guvecin-asi-kararsizliginin-nedeni-bilgi-kirliligi" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/176812.jpg" alt="Doç. Dr. Cemal Güvecin: Aşı kararsızlığının nedeni bilgi kirliliği"></div><div class="card-body"><h5 class="card-title">Doç. Dr. Cemal Güvecin: Aşı kararsızlığının nedeni bilgi kirliliği</h5><p class="card-text">DEÜ Tıp Tarihi ve Etik Ana Bilim Dalı Öğretim Üyesi Doç. Dr. Cemal Hüseyin Güvercin, koronavirüs aşısına güvensizliği ve halk sağlığı bağlamında aşının önemini değerlendirdi.</p></div></a></div></div></div><div class="col-lg-4 col-sm-4"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423815/is-cinayetinde-esini-kaybeden-hulkiye-karadas-hukuk-mucadelesi-veriyor" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/177202.jpg" alt="İş cinayetinde eşini kaybeden Hulkiye Karadaş hukuk mücadelesi veriyor"></div><div class="card-body"><h5 class="card-title">İş cinayetinde eşini kaybeden Hulkiye Karadaş hukuk mücadelesi veriyor</h5><p class="card-text">Kent Beton&#39;da şoför olarak çalışan Ahmet Karadaş&#39;ın iş cinayetinde yaşamını yitirmesinin ardından hukuk mücadelesi başlatan eşi Hulkiye Karadaş, &quot;Çocuklarım için hakkımı arayacağım&quot; diyor.</p></div></a></div></div></div><div class="col-lg-4 col-sm-4"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423863/bucanin-tek-devlet-hastanesi-kapatildiktan-sonra-sahra-hastanesi-icin-adim-atilmadi" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/177235.jpg" alt="Buca&#39;nın tek devlet hastanesi kapatıldıktan sonra sahra hastanesi için adım atılmadı"></div><div class="card-body"><h5 class="card-title">Buca&#39;nın tek devlet hastanesi kapatıldıktan sonra sahra hastanesi için adım atılmadı</h5><p class="card-text">İzmir’in 550 bin nüfuslu ilçesi Buca’da depremde hasar gördüğü için kapatılan tek devlet hastanesinin yerine hükümetin sözünü verdiği sahra hastanesi için hâlâ adım atılmadı.</p></div></a></div></div></div><div class="col-lg-4 col-sm-4"><div class="categorygrid__griditem "><div class="card border-0 shadow"><a href="https://www.evrensel.net/haber/423850/narlidere-halki-kentsel-donusum-surecine-mudahil-olmak-istiyor" target="_blank"><div class="card-img-wrapper"><img class="card-img-top lazyload" src="https://www.evrensel.net/tema/evr19/img/255x170.jpg" data-src="https://www.evrensel.net/images/330/upload/dosya/177223.jpg" alt="Narlıdere halkı kentsel dönüşüm sürecine müdahil olmak istiyor"></div><div class="card-body"><h5 class="card-title">Narlıdere halkı kentsel dönüşüm sürecine müdahil olmak istiyor</h5><p class="card-text">Narlıdere Kentsel Dönüşüm Platformu, Narlıdere Belediye Başkanı Ali Engin’e seslenerek kentsel dönüşüm sürecine halkın da dahil edilmesini talep etti.</p></div></a></div></div></div></div></div></div></div></div></div></div></section></main><div class="alert alert-danger alert-icon"><div class="container"><div class="saat24-bar"><a href="https://www.evrensel.net/son-24-saat" class="alert-link"><strong><i class="fas fa-clock"></i> Son 24 saatte eklenen tüm haberler için tıklayın.</strong></a></div></div></div> <footer><link rel="stylesheet" href="https://www.evrensel.net/tema/evr19/css/footer.css" /><script></script><div id="footer"><div class="bg-email-sub"><div class="container mobile-section bulten_mobile"><div class="row"><div class="col-sm-12"><span class="footer_bulten">HABER BÜLTENİ</span><p class="footer_bulten">Günün önemli gelişmeleri e-posta adresinize gelsin.</p></div><div class="col-sm-4 text-center"> <img src="https://www.evrensel.net/tema/evr19/img/ebulten.jpeg" alt="Evrensel haber bülteni" style="width:98%" /></div></div></div><div class="container"><div class="row"><div class="col-sm-12"><div class="sf-menu"><ul class="list-unstyled"><li><a class="u-list" href="https://www.evrensel.net">ANASAYFA</a></li><li><a class="u-list" href="https://www.evrensel.net/abone">E-gazete</a></li><li><a class="u-list" href="https://www.evrensel.net/iletisim">İletişim</a></li><li><a class="u-list" href="https://www.evrensel.net/sayfa/2/kunye">Künye</a></li><li><a class="u-list" href="https://www.evrensel.net/arsiv">Arşiv</a></li><li><a class="u-list" href="https://www.evrensel.net/sayfa/3/reklam">Reklam</a></li><li><a class="u-list" href="https://www.evrensel.net/sayfa/4/gizlilik-politikasi-ve-kullanici-sozlesmesi">Gizlilik Politikası</a></li><li><a class="u-list" href="https://www.evrensel.net/mobil">Mobil Uygulamalar</a></li></ul></div></div> <div class="col-md-4"><button onclick="window.location.href='https://itunes.apple.com/tr/app/evrensel/id984477039?l=tr&mt=8'" type="button" class="btn btn-xs btn-light u-btn-light text-left mb-2"><span class="media"><span class="d-flex mr-3"><span class="fab fa-apple"></span></span><span class="media-body"><span class="d-block">App Store</span></span></span></button><button onclick="window.location.href='https://play.google.com/store/apps/details?id=net.evrensel.android'" type="button" class="btn btn-xs btn-light u-btn-light u-btn-wide transition-3d-hover text-left mb-2"><span class="media"><span class="d-flex mr-3"><span class="fab fa-google-play font-size-26"></span></span><span class="media-body"><span class="d-block">Google Play</span></span></span></button></div></div></div></div></div></footer> </div><script type="text/javascript" src="//www.3dcart.com/lp/cookie-law-generator/cookie.js?skin=cookielaw1&amp;msg=Deneyiminizi%20daha%20iyi%20hale%20getirmek%20i%C3%A7in%20%C3%A7erezleri%20kullan%C4%B1yoruz.%20Devam%20ederek%20%C3%A7erez%20kullan%C4%B1m%C4%B1m%C4%B1z%C4%B1%20kabul%20etmi%C5%9F%20oluyorsunuz.%20&amp;link_color=f7f8dc&amp;learnmore=Veri%20ve%20gizlilik%20politikam%C4%B1za%20buradan%20g%C3%B6z%20atabilirsiniz.&amp;morelink=https%3A%2F%2Fwww.evrensel.net%2Fsayfa%2F4%2Fgizlilik-politikasi-ve-kullanici-sozlesmesi&amp;accept_text=KABUL"></script></body></div></html>