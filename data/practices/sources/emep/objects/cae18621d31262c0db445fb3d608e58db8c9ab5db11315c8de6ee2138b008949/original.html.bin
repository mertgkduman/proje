    itemsIconType: 'rounded',                    countdown: 0,                    showMenuHeader: true,                    showHeaderCloseBtn: true,                    headerCloseBtnColor: '#aa1218',                    headerCloseBtnBgColor: '#fff',                    promptPosition: 'side',                    theme: '#aa1218',                    items: [                        {                            title: "Twitter",                            icon: '<i class="fab fa-twitter"></i>',                            href: "https://twitter.com/intent/tweet?text=" + tweettext,                            color: '#1DA1F2'                        },{                            title: "Whatsapp",                            icon: '<i class="fab fa-whatsapp"></i>',                            href: "whatsapp://send?text=https://www.evrensel.net/haber/338968/emep-8-kongresi-tek-adam-rejimine-karsi-ortak-mucadele" + whatsapptext,                            color: '#4EC85C'                        },{                            title: "Facebook",                            icon: '<i class="fab fa-facebook"></i>',                            href: "https://www.facebook.com/sharer.php?u=https://evrn.sl/K5F0m?a=8457a" + facebooktext,                            color: '#4267B2'                        },                        {                            title: 'Messenger',                            icon: '<i class="fab fa-facebook-messenger"></i>',                            href: "fb-messenger://share/?link=https://evrn.sl/K5F0m?a=8457a" + messengertext,                            color: '#009DFF'                        },                        {                            title: "Pocket",                            icon: '<i class="fab fa-get-pocket"></i>',                            href: "https://getpocket.com/edit?url=https://evrn.sl/K5F0m?a=8457a" + pockettext,                            color: '#EF4359'                        },                        {                      