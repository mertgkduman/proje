<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"Thing","@id":"https:\/\/www.ozgunkocaeli.com.tr","name":"Haberler"}},{"@type":"ListItem","position":2,"item":{"@type":"Thing","@id":"https:\/\/www.ozgunkocaeli.com.tr\/kocaeli-haberleri","name":"Kocaeli Haberleri"}},{"@type":"ListItem","position":3,"item":{"@type":"Thing","@id":"https:\/\/www.ozgunkocaeli.com.tr\/emepli-sahbaz-mazbatayi-alir-almaz-ilk-isci-ve-emekcileri-selamladi","name":"EMEP'li \u015eahbaz mazbatay\u0131 al\u0131r almaz ilk i\u015f\u00e7i ve emek\u00e7ileri selamlad\u0131"}}]}</script>
<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"NewsArticle","headline":"EMEP'li \u015eahbaz mazbatay\u0131 al\u0131r almaz ilk i\u015f\u00e7i ve emek\u00e7ileri selamlad\u0131","articleSection":"Kocaeli Haberleri","dateCreated":"2026-11-05T16:31:00+03:00","datePublished":"2026-11-05T16:31:00+03:00","dateModified":"2026-11-05T16:31:00+03:00","wordCount":734,"genre":"news","mainEntityOfPage":{"@type":"WebPage","@id":"https:\/\/www.ozgunkocaeli.com.tr\/emepli-sahbaz-mazbatayi-alir-almaz-ilk-isci-ve-emekcileri-selamladi"},"articleBody":"Emek Partisi (EMEP) Kocaeli \u0130l \u00d6rg\u00fct\u00fc'n\u00fcn 11. Ola\u011fan Kongresi'nde yeniden il ba\u015fkanl\u0131\u011f\u0131na se\u00e7ilen \u0130lhami \u015eahbaz, mazbatas\u0131n\u0131 ald\u0131. 1 Kas\u0131m 2026 tarihinde ger\u00e7ekle\u015ftirilen kongrede tek aday olarak se\u00e7ime giren ve kullan\u0131lan 29 oyun tamam\u0131n\u0131 alan \u015eahbaz, yeni g\u00f6rev d\u00f6nemine ili\u015fkin a\u00e7\u0131klamalarda bulundu. \u0130\u015f\u00e7i haklar\u0131 ve emek m\u00fccadelesine vurgu yapan \u015eahbaz, \u00e7al\u0131\u015fma hayat\u0131ndaki sorunlara kar\u015f\u0131 m\u00fccadelelerini s\u00fcrd\u00fcreceklerini belirterek i\u015f\u00e7i ve emek\u00e7ilere dayan\u0131\u015fma \u00e7a\u011fr\u0131s\u0131 yapt\u0131.\r\n\r\n\u0130LHAM\u0130 \u015eAHBAZ MAZBATASINI ALDI\r\n\r\nEmek Partisi Kocaeli \u0130l \u00d6rg\u00fct\u00fc'nde kongre s\u00fcrecinin ard\u0131ndan mazbata teslimi ger\u00e7ekle\u015ftirildi.\r\n\r\nPartinin 11. Ola\u011fan \u0130l Kongresi'nde yeniden ba\u015fkanl\u0131\u011fa se\u00e7ilen \u0130lhami \u015eahbaz, se\u00e7im sonucunun ard\u0131ndan mazbatas\u0131n\u0131 alarak yeni d\u00f6nemine ba\u015flad\u0131.\r\n\r\n\u0130l ba\u015fkanl\u0131\u011f\u0131 g\u00f6revini s\u00fcrd\u00fcrecek olan \u015eahbaz, mazbatas\u0131n\u0131 almas\u0131n\u0131n ard\u0131ndan yapt\u0131\u011f\u0131 a\u00e7\u0131klamada partinin \u00f6n\u00fcm\u00fczdeki d\u00f6nemde izleyece\u011fi m\u00fccadele anlay\u0131\u015f\u0131na ili\u015fkin de\u011ferlendirmelerde bulundu.\r\n\r\n11. OLA\u011eAN KONGREDE G\u00dcVEN TAZELEM\u0130\u015eT\u0130\r\n\r\nEMEP Kocaeli \u0130l \u00d6rg\u00fct\u00fc, 11. Ola\u011fan Kongresi'ni 1 Kas\u0131m 2026 Pazar g\u00fcn\u00fc ger\u00e7ekle\u015ftirdi.\r\n\r\n\u0130l\u00e7e kongrelerinin tamamlanmas\u0131n\u0131n ard\u0131ndan d\u00fczenlenen kongrede mevcut \u0130l Ba\u015fkan\u0131 \u0130lhami \u015eahbaz, tek aday olarak se\u00e7ime kat\u0131ld\u0131.\r\n\r\nToplam 40 delegenin oy kullanma hakk\u0131n\u0131n bulundu\u011fu kongrede 29 delege sand\u0131k ba\u015f\u0131na gitti.\r\n\r\nKullan\u0131lan 29 oyun tamam\u0131n\u0131 alan \u015eahbaz, yeniden EMEP Kocaeli \u0130l Ba\u015fkan\u0131 se\u00e7ildi.\r\n\r\nKongreye parti \u00fcyeleri ve delegelerin yan\u0131 s\u0131ra \u00e7e\u015fitli sendikalar\u0131n, siyasi partilerin ve sivil toplum kurulu\u015flar\u0131n\u0131n temsilcileri de kat\u0131ld\u0131.\r\n\r\n\u201c\u0130\u015e\u00c7\u0130 SINIFININ M\u00dcCADELES\u0130N\u0130N EN \u00d6N SAFINDA OLACA\u011eIZ\u201d\r\n\r\nMazbatas\u0131n\u0131 alan \u0130lhami \u015eahbaz, yeni d\u00f6nemde i\u015f\u00e7i ve emek\u00e7ilerin haklar\u0131na ili\u015fkin \u00e7al\u0131\u015fmalar\u0131n\u0131 s\u00fcrd\u00fcreceklerini a\u00e7\u0131klad\u0131.\r\n\r\n\u00c7al\u0131\u015fma ya\u015fam\u0131nda ya\u015fand\u0131\u011f\u0131n\u0131 savundu\u011fu hak kay\u0131plar\u0131na ve i\u015fveren bask\u0131lar\u0131na dikkat \u00e7eken \u015eahbaz, \u015fu ifadeleri kulland\u0131:\r\n\r\n\u201cYeni d\u00f6nemde de sermayenin bask\u0131lar\u0131na ve hak gasplar\u0131na kar\u015f\u0131 i\u015f\u00e7i s\u0131n\u0131f\u0131n\u0131n ve emek\u00e7ilerin omuz omuza m\u00fccadelesinin en \u00f6n saf\u0131nda yer almaya devam edece\u011fiz.\u201d\r\n\r\n\u015eahbaz, partinin yeni d\u00f6nemde de emek ve \u00e7al\u0131\u015fma ya\u015fam\u0131na ili\u015fkin sorunlar\u0131 g\u00fcndeminde tutaca\u011f\u0131n\u0131 belirtti.\r\n\r\nKOCAEL\u0130'DE EMEK M\u00dcCADELES\u0130 VURGUSU\r\n\r\nT\u00fcrkiye'nin \u00f6nemli sanayi merkezlerinden biri olan Kocaeli'de i\u015f\u00e7i haklar\u0131, sendikal \u00f6rg\u00fctlenme ve \u00e7al\u0131\u015fma ko\u015fullar\u0131, EMEP'in yerel siyasi g\u00fcndeminde yer al\u0131yor.\r\n\r\nKongre s\u00fcrecinde de i\u015f\u00e7i ve emek\u00e7ilerin sorunlar\u0131na dikkat \u00e7eken \u015eahbaz, yeni d\u00f6nemde dayan\u0131\u015fman\u0131n g\u00fc\u00e7lendirilmesi gerekti\u011fini savundu.\r\n\r\n\u0130l ba\u015fkanl\u0131\u011f\u0131n\u0131 yeniden \u00fcstlenen \u015eahbaz'\u0131n a\u00e7\u0131klamas\u0131nda i\u015f\u00e7i s\u0131n\u0131f\u0131n\u0131n ortak hareket etmesi ve hak taleplerinin \u00f6rg\u00fctl\u00fc bi\u00e7imde dile getirilmesi \u00f6ne \u00e7\u0131kt\u0131.\r\n\r\n\u015eAHBAZ'DAN \u0130KT\u0130DAR POL\u0130T\u0130KALARINA ELE\u015eT\u0130R\u0130\r\n\r\nEMEP Kocaeli \u0130l Ba\u015fkan\u0131 \u0130lhami \u015eahbaz, mazbata a\u00e7\u0131klamas\u0131nda iktidar\u0131n ekonomi ve y\u00f6netim politikalar\u0131n\u0131 da ele\u015ftirdi.\r\n\r\nMevcut y\u00f6netim anlay\u0131\u015f\u0131n\u0131n yoksullu\u011fu art\u0131rd\u0131\u011f\u0131n\u0131 ve kamu kaynaklar\u0131n\u0131n kullan\u0131m\u0131na ili\u015fkin sorunlar bulundu\u011funu savunan \u015eahbaz, bunlara kar\u015f\u0131 siyasi ve toplumsal m\u00fccadelenin geni\u015fletilmesi gerekti\u011fini belirtti.\r\n\r\n\u015eahbaz, a\u00e7\u0131klamas\u0131n\u0131n devam\u0131nda \u015fu s\u00f6zlere yer verdi:\r\n\r\n\u201cKongremizden ald\u0131\u011f\u0131m\u0131z g\u00fc\u00e7le ve partimizin tarihsel misyonuna uygun olarak; halk\u0131 yoksulla\u015ft\u0131ran, \u00fclkenin t\u00fcm kaynaklar\u0131n\u0131 pe\u015fke\u015f \u00e7eken bu tek adam rejimine ve soygun d\u00fczenine son vermek \u00fczere t\u00fcm i\u015f\u00e7i ve emek\u00e7ileri, ezilenleri birle\u015fik m\u00fccadeleyi b\u00fcy\u00fctmeye \u00e7a\u011f\u0131r\u0131yoruz.\u201d\r\n\r\n\u015eahbaz'\u0131n bu ifadeleri, partisinin iktidar politikalar\u0131na y\u00f6nelik siyasi ele\u015ftirilerini yans\u0131t\u0131yor.\r\n\r\nEMEP KOCAEL\u0130'DE YEN\u0130 D\u00d6NEM BA\u015eLADI\r\n\r\n\u0130lhami \u015eahbaz'\u0131n mazbatas\u0131n\u0131 almas\u0131yla EMEP Kocaeli \u0130l \u00d6rg\u00fct\u00fc'nde kongre sonras\u0131 yeni d\u00f6nem ba\u015flad\u0131.\r\n\r\n\u015eahbaz, a\u00e7\u0131klamas\u0131nda \u00e7al\u0131\u015fma hayat\u0131ndaki hak kay\u0131plar\u0131, i\u015f\u00e7i ve emek\u00e7ilerin talepleri ile siyasi dayan\u0131\u015fma konular\u0131na a\u011f\u0131rl\u0131k verecekleri mesaj\u0131n\u0131 verdi.\r\n\r\n11. Ola\u011fan Kongre'de yeniden se\u00e7ilerek g\u00fcven tazeleyen EMEP Kocaeli \u0130l Ba\u015fkan\u0131 \u0130lhami \u015eahbaz, mazbatas\u0131n\u0131 ald\u0131ktan sonra i\u015f\u00e7i ve emek\u00e7ilerin haklar\u0131na y\u00f6nelik m\u00fccadeleyi s\u00fcrd\u00fcreceklerini belirterek ortak hareket etme \u00e7a\u011fr\u0131s\u0131nda bulundu.\r\n\r\n","description":"Emek Partisi (EMEP) Kocaeli \u0130l \u00d6rg\u00fct\u00fc'n\u00fcn 11. Ola\u011fan Kongresi'nde yeniden ba\u015fkan se\u00e7ilen \u0130lhami \u015eahbaz, mazbatas\u0131n\u0131 alarak yeni d\u00f6nemine ba\u015flad\u0131. Kongrede\u2026","inLanguage":"tr-TR","keywords":[],"image":{"@type":"ImageObject","url":"https:\/\/ozgunkocaelicomtr.teimg.com\/crop\/1280x720\/ozgunkocaeli-com-tr\/uploads\/2026\/11\/signal-2026-11-05-144808.jpeg","width":"1280","height":"720","caption":"EMEP'li \u015eahbaz mazbatay\u0131 al\u0131r almaz ilk i\u015f\u00e7i ve emek\u00e7ileri selamlad\u0131"},"isFamilyFriendly":"http:\/\/schema.org\/True","isAccessibleForFree":"http:\/\/schema.org\/True","publisher":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.ozgunkocaeli.com.tr\/#organization","name":"\u00d6zg\u00fcn Kocaeli","image":"https:\/\/ozgunkocaelicomtr.teimg.com\/ozgunkocaeli-com-tr\/uploads\/2025\/10\/ozgun-kocaeli-logo.png","logo":{"@type":"ImageObject","url":"https:\/\/ozgunkocaelicomtr.teimg.com\/ozgunkocaeli-com-tr\/uploads\/2025\/10\/ozgun-kocaeli-logo.png","width":"640","height":"375"}},"author":{"@type":"Person","name":"Haber Merkezi","url":"https:\/\/www.ozgunkocaeli.com.tr\/muhabir\/53935\/haber-merkezi"},"editor":{"@type":"Person","name":"Haber Merkezi","url":"https:\/\/www.ozgunkocaeli.com.tr\/muhabir\/53935\/haber-merkezi"},"creator":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.ozgunkocaeli.com.tr\/#organization","name":"\u00d6zg\u00fcn Kocaeli","url":"https:\/\/www.ozgunkocaeli.com.tr"}}</script>


