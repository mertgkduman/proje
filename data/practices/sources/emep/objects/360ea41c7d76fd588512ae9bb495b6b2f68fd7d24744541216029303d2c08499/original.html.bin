erlay"></div></nav><script> function hbSearchEvent(ad) { try { window.dataLayer = window.dataLayer || []; dataLayer.push({ event: ad }); } catch (e) { } } var hbSearchToggle = document.getElementById("search-toggle-button"); if (hbSearchToggle) hbSearchToggle.addEventListener("click", function () { hbSearchEvent('click_search_icon'); }); var hbSearchMobilAc = document.getElementById("mobile-search-button"); if (hbSearchMobilAc) hbSearchMobilAc.addEventListener("click", function () { hbSearchEvent('click_search_icon'); }); var hbSearchForm = document.getElementById("searchform"); if (hbSearchForm) hbSearchForm.addEventListener("submit", function () { hbSearchEvent('submit_search'); }); document.querySelector("#hbSubmit").onclick = function () { Search(); }; var hbSearchMobilIkon = document.querySelector("#search-container .search-input span.icon"); if (hbSearchMobilIkon) hbSearchMobilIkon.addEventListener("click", function () { hbSearchEvent('click_search_icon'); Search(); }); document.querySelector("#hbSearch").addEventListener("keypress", function (event) { if (event.keyCode == 13) { event.preventDefault(); Search(); } }); function Search() { var terim = document.querySelector('#hbSearch').value.trim(); if (terim == "" || terim == null || terim == undefined) return false; else { hbSearchEvent('submit_search'); window.location = "/ara/?q=" + terim; } } </script><script type="text/javascript">var activeElement = document.querySelector(".hbFinanceTopBar .active"); if (activeElement !== null && typeof activeElement.scrollIntoView === 'function') { activeElement.scrollIntoView(false); } </script><script src="https://www.haberler.com/mstatic/assets/js/custom.js?v=16"></script><script>(function () { const dropdown = document.querySelector(".category-dropdown"); if (!dropdown) return; const titleButtons = dropdown.querySelectorAll('.title-bar button'); if (titleButtons.length === 0) return; titleButtons.forEach(btn =>{ btn.addEventListener("click", function (e) { e.prevent