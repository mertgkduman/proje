                        <div class="sidebar_widget recent_widgets wow fadeInUp">
                            <h5 class="widget_title">Son Eklenenler</h5>
                            <ul>
							
                                <li>
                                    <div class="image">
                                        <img src="/resimler/anafoto.jpg_VRS159.jpeg" alt="INDUSTRIALL AVRUPA İCRA KURULU TOPLANTISI İSTANBUL’DA YAPILDI" class="image-fit">
                                    </div>
                                    <div class="text">
                                        <h6 class="mb-0">
                                            <a href="/haber/industriall-avrupa-sendikasi-icra-kurulu-toplantisi-istanbulda-yapildi">INDUSTRIALL AVRUPA İCRA KURULU TOPLANTISI İSTANBUL’DA YAPILDI</a>
                                        </h6>
                                        <p class="mb-0"><strong><i class="fal fa-calendar-alt"></i> </strong><a href="/haber/industriall-avrupa-sendikasi-icra-kurulu-toplantisi-istanbulda-yapildi">20.11.2026</a></p>
                                    </div>
                                </li>
                           
                                <li>
                                    <div class="image">
                                        <img src="/resimler/Ana-Foto_TMFR33.jpg" alt="SENDİKAMIZDAN HABAŞ ÖNÜNDE BASIN AÇIKLAMASI" class="image-fit">
                                    </div>
