    ctaText: 'Google\'da Tercih Et',
    laterText: 'Daha sonra',
    primary: '#c8102e',     // Buton / vurgu rengi (sitenin ana rengiyle değiştirilebilir)
    dark: '#1a1f2b',        // Başlık rengi
    position: 'right',      // Masaüstünde: 'right' | 'center' | 'left'
    delayMs: 3000,          // Sayfa açıldıktan kaç ms sonra çıksın
    scrollTrigger: 0.25,    // Ya da sayfanın %25'i kaydırılınca (hangisi önce olursa). 0 = kapalı
    remindLaterDays: 3,     // "Daha sonra" -> kaç gün sonra tekrar
    closeDays: 7,           // X / ESC ile kapatınca kaç gün sonra tekrar
    doneDays: 365,          // Butona tıklayınca kaç gün gösterilmesin
