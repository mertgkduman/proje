        <form method="POST" action="https://www.koroglugazetesi.com/comments/add" accept-charset="UTF-8" id="form_162665"><input name="_token" type="hidden" value="AmucKZHfOKtkHbCFaqE0LvF9eUDUYHf3fzJlSjcu">
