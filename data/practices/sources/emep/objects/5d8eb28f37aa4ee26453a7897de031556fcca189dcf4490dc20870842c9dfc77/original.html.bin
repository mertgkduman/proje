    '<path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.8 2.4 30.3 0 24 0 14.6 0 6.6 5.4 2.6 13.3l7.9 6.1C12.4 13.7 17.7 9.5 24 9.5z"/>' +
    '<path fill="#4285F4" d="M46.1 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.4c-.5 2.9-2.2 5.3-4.6 6.9l7.5 5.8c4.4-4 6.8-10 6.8-17.2z"/>' +
    '<path fill="#FBBC05" d="M10.5 28.6c-.5-1.4-.8-3-.8-4.6s.3-3.2.8-4.6l-7.9-6.1C1 16.6 0 20.2 0 24s1 7.4 2.6 10.7l7.9-6.1z"/>' +
    '<path fill="#34A853" d="M24 48c6.5 0 11.9-2.1 15.9-5.8l-7.5-5.8c-2.1 1.4-4.8 2.3-8.4 2.3-6.3 0-11.6-4.2-13.5-10l-7.9 6.1C6.6 42.6 14.6 48 24 48z"/>' +
    '</svg>';

  var html = '' +
    '<button type="button" class="kgk-x" data-act="close" aria-label="Kapat">&#10005;</button>' +
    '<div class="kgk-body">' +
      '<span class="kgk-g">' + gLogo + '</span>' +
      '<div class="kgk-txt">' +
        '<div class="kgk-t" id="kgk-t">' + CONFIG.title + '</div>' +
        '<p class="kgk-d" id="kgk-d">' + CONFIG.desc + '</p>' +
      '</div>' +
    '</div>' +
    '<div class="kgk-act">' +
      '<a class="kgk-cta" data-act="go" href="' + CONFIG.sourceUrl + '" target="_blank" rel="noopener">' +
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>' +
        CONFIG.ctaText + '</a>' +
      '<button type="button" class="kgk-later" data-act="later">' + CONFIG.laterText + '</button>' +
    '</div>';

  // --- Davranış ----------------------------------------------------------
  var box, shown = false, offsetTimer = null;

  function track(action) {
    try {
      if (window.gtag) window.gtag('event', 'kaynak_panel', { action: action });
      if (window.dataLayer) window.dataLayer.push({ event: 'kaynak_panel', kaynak_action: action });
    } catch (e) {}
  }

  function close(days, action) {
    if (!box) return;
    setUntil(days);
    track(action);
    box.classList.remove('kgk-in');
    document.removeEventListener('keydown', onKey);
    clearTimeout(offsetTimer);
    var b = box; box = null;
    setTimeout(function () { if (b.parentNode) b.parentNode.removeChild(b); }, 450);
  }

  // Çerez uyarısı görünürse paneli onun üstüne taşı
  function cookieOffset() {
    if (!box) return;
    var c = document.querySelector(CONFIG.cookieBarSelector), h = 0;
    if (c) {
      var cs = getComputedStyle(c);
      if (cs.display !== 'none' && cs.visibility !== 'hidden') h = c.getBoundingClientRect().height;
    }
    var base = window.innerWidth <= 600 ? 0 : 24;
    box.style.bottom = (base + h) + 'px';
    offsetTimer = setTimeout(cookieOffset, 500);
  }

  function onKey(e) { if (e.key === 'Escape') close(CONFIG.closeDays, 'esc'); }

  function show() {
    if (shown) return;
    if (document.hidden) {
      document.addEventListener('visibilitychange', function h() {
        if (!document.hidden) { document.removeEventListener('visibilitychange', h); show(); }
      });
      return;
    }
    shown = true;
    window.removeEventListener('scroll', onScroll);

    var style = document.createElement('style');
    style.textContent = css;
    document.head.appendChild(style);

    box = document.createElement('div');
    box.className = 'kgk';
    box.setAttribute('role', 'dialog');
    box.setAttribute('aria-modal', 'false');
    box.setAttribute('aria-labelledby', 'kgk-t');
    box.setAttribute('aria-describedby', 'kgk-d');
    box.innerHTML = html;
    document.body.appendChild(box);
    cookieOffset();

    box.addEventListener('click', function (e) {
      var a = e.target.closest('[data-act]');
      if (!a) return;
      var act = a.getAttribute('data-act');
      if (act === 'go') close(CONFIG.doneDays, 'click_google');
      else if (act === 'later') close(CONFIG.remindLaterDays, 'later');
      else if (act === 'close') close(CONFIG.closeDays, 'close');
    });
    document.addEventListener('keydown', onKey);

    requestAnimationFrame(function () { requestAnimationFrame(function () { box && box.classList.add('kgk-in'); }); });
    track('view');
  }

  function onScroll() {
    var h = document.documentElement.scrollHeight - window.innerHeight;
    if (h > 0 && window.scrollY / h >= CONFIG.scrollTrigger) show();
  }

  function init() {
    setTimeout(show, force ? 0 : CONFIG.delayMs);
    if (!force && CONFIG.scrollTrigger > 0) window.addEventListener('scroll', onScroll, { passive: true });
  }
  if (document.readyState !== 'loading') init();
  else document.addEventListener('DOMContentLoaded', init);
})();
</script></div><div data-pagespeed="true"><script>
  function adjustMenuFontSize() {
  const menuItems = document.querySelectorAll('.main-menu ul li .nav-link');
  const minFontSize = 12; // Minimum font size in pixels
  const maxFontSize = 18; // Maximum font size in pixels
  
  // Calculate new font size based on window width
  let newFontSize = (window.innerWidth / 100);

  // Ensure new font size is within the defined limits
  if (newFontSize < minFontSize) {
    newFontSize = minFontSize;
  } else if (newFontSize > maxFontSize) {
    newFontSize = maxFontSize;
  }

  // Apply new font size to menu items
  menuItems.forEach(item => {
    item.style.fontSize = newFontSize + 'px';
  });
}

// Adjust font size when the window is resized or loaded
window.addEventListener('resize', adjustMenuFontSize);
window.addEventListener('load', adjustMenuFontSize);

</script>


<script>
(function () {
  const KEY = 'main_headline_index';
  let boundSwiper = null;

  function getSwiper() {
    const el = document.querySelector('.swiper.main-headline');
    if (!el || !el.swiper) return null;
    return el.swiper;
  }

  function save(swiper) {
    try {
      sessionStorage.setItem(KEY, swiper.realIndex);
    } catch (e) {}
  }

  function restore(swiper) {
    const idx = sessionStorage.getItem(KEY);
    if (idx === null) return;

    const i = parseInt(idx, 10);
    if (!Number.isFinite(i)) return;

    if (swiper.params.loop) {
      swiper.slideToLoop(i, 0);
    } else {
      swiper.slideTo(i, 0);
    }
  }

  function bind(swiper) {
    if (boundSwiper === swiper) return;
    boundSwiper = swiper;

    restore(swiper);

    swiper.on('slideChange', () => save(swiper));

    document.addEventListener('click', e => {
      if (e.target.closest('.swiper.main-headline a')) {
        save(swiper);
      }
    }, true);

    window.addEventListener('pagehide', () => save(swiper));
  }

  function tick() {
    const swiper = getSwiper();
    if (swiper) bind(swiper);
  }

  window.addEventListener('load', () => {
    tick();
    setTimeout(tick, 300);
    setTimeout(tick, 1000);
  });

  window.addEventListener('pageshow', tick);

  const obs = new MutationObserver(tick);
  obs.observe(document.body, { childList: true, subtree: true });

})();
</script></div>
<script>
(function () {
    const header         = document.querySelector("header");
    const pageHeader     = document.querySelector(".page-header");
    const subCategories  = document.querySelector(".sub-categories");
    const adTop          = document.querySelector("#ad_152");

    let headerHeight = 0;

    if (header) headerHeight += header.offsetHeight;
    if (pageHeader) headerHeight += pageHeader.offsetHeight;
    if (subCategories) headerHeight += subCategories.offsetHeight;
    if (adTop) headerHeight += adTop.offsetHeight + 33;

    const css = `#ad_36, #ad_9 { top: ${headerHeight}px !important; }`;
    const style = document.createElement("style");
    style.id = "adFixEarly";
    style.textContent = css;

    document.head.appendChild(style);
})();
</script>
