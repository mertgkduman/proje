  }
  var st = getState();
  if (!force && st.until && Date.now() < st.until) return;

  // --- Stil --------------------------------------------------------------
  var P = CONFIG.primary, D = CONFIG.dark;
  var posCss = CONFIG.position === 'left' ? 'left:24px;'
    : CONFIG.position === 'center' ? 'left:50%;margin-left:-180px;'
    : 'right:24px;';

  var css = '' +
    '.kgk,.kgk *{box-sizing:border-box}' +
    '.kgk{position:fixed;' + posCss + 'bottom:24px;z-index:2147483000;width:360px;max-width:calc(100vw - 32px);' +
      'background:#fff;color:#1b2433;border-radius:14px;overflow:hidden;' +
      'font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;' +
      'box-shadow:0 18px 50px rgba(0,0,0,.22),0 2px 8px rgba(0,0,0,.10);' +
      'border-top:4px solid ' + P + ';' +
      'transform:translateY(calc(100% + 40px));opacity:0;' +
      'transition:transform .45s cubic-bezier(.2,.9,.25,1),opacity .3s ease,bottom .25s ease}' +
    '.kgk.kgk-in{transform:none;opacity:1}' +
    '.kgk-body{display:flex;gap:12px;align-items:flex-start;padding:16px 16px 14px}' +
    '.kgk-g{flex:0 0 40px;width:40px;height:40px;border-radius:50%;background:#fff;display:grid;place-items:center;' +
      'box-shadow:0 0 0 1px #e6e9ef,0 3px 8px rgba(0,0,0,.08)}' +
    '.kgk-g svg{display:block;width:22px;height:22px}' +
    '.kgk-txt{flex:1;min-width:0}' +
    '.kgk-t{font-size:16px;line-height:1.3;font-weight:800;color:' + D + ';margin:0 0 5px;padding-right:22px}' +
    '.kgk-d{font-size:13px;line-height:1.5;color:#556070;margin:0}' +
    '.kgk-x{position:absolute;top:10px;right:10px;width:26px;height:26px;border-radius:50%;border:0;background:#f1f4f8;' +
      'color:#5b6576;font-size:14px;line-height:26px;text-align:center;cursor:pointer;padding:0;transition:background .15s}' +
    '.kgk-x:hover{background:#e3e8ef;color:' + D + '}' +
    '.kgk-act{display:flex;align-items:center;gap:8px;padding:0 16px 16px}' +
    '.kgk-cta{flex:1;display:flex;align-items:center;justify-content:center;gap:7px;background:' + P + ';' +
      'color:#fff !important;text-decoration:none !important;font-weight:700;font-size:14px;padding:11px 14px;' +
      'border-radius:10px;transition:filter .15s,transform .15s}' +
    '.kgk-cta:hover{filter:brightness(.9);transform:translateY(-1px)}' +
    '.kgk-cta svg{width:16px;height:16px}' +
    '.kgk-later{background:none;border:0;color:#7b8597;font-size:13px;cursor:pointer;padding:8px 4px;white-space:nowrap}' +
    '.kgk-later:hover{color:' + D + ';text-decoration:underline}' +
    '.kgk :focus-visible{outline:3px solid #f5b800;outline-offset:2px}' +
    /* Mobil: alt kenara yapışık panel */
    '@media (max-width:600px){' +
      '.kgk{left:0;right:0;bottom:0;margin-left:0;width:auto;max-width:none;border-radius:14px 14px 0 0}' +
      '.kgk-body{padding:14px 14px 10px}' +
      '.kgk-t{font-size:15px}.kgk-d{font-size:12.5px}' +
      '.kgk-act{padding:0 14px calc(12px + env(safe-area-inset-bottom))}' +
