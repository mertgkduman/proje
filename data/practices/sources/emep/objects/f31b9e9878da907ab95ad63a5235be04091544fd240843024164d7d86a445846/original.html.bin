html{
    margin: 0; padding: 0;
    width: 100%;
}
body {
	font-family:"Roboto", Arial, Helvetica, sans-serif; color:#31373a;
	padding-top: 15px;
	padding: 0; margin: 0;
  background-color: #fff;
}
ul {
  list-style: none;
  margin:0;
  padding:0;
}
.container{
  max-width: 1270px;
}
@media (min-width: 1200px){.container {
      width: 1270px;
  }}
.wrapper{
  min-height: 600px;
  margin-bottom: 40px;
}
.row {
  margin-left: -10px;
  margin-right: -10px;
}
.row [class^="col-"],
.row [class*=" col-"] {
  padding-left: 10px;
  padding-right: 10px;
}
a{
	color: #333;
}
a:hover{
	color: #ED1C24;
	text-decoration: none;
}
.pt-0 {
  padding-top: 0 !important;
}
.mt-0 {
  margin-top: 0 !important;
}
.bg-transparent {
  background-color: transparent !important;
}
span.title-icons {
  font-size: 90%;
  opacity: 0.8;
  color: #ED1C24;
}
.navbar-brand .main-logo {
  max-width: 170px;
}
@media (max-width: 767px){.navbar-brand .main-logo {
    max-width: 110px;
  }}
footer{
  background-color: #000;
  color: #FFF;
  margin-top: 0px;
  padding-top: 10px;
}
footer a{
  color: #FFF;
}
footer a:hover{
  color: #ea757e;
}
#menubar {
  border-top: 1px solid #ccc;
  border-bottom: 1px solid #ccc;
}
#mainmenu {
  width: 100%;
}
#mainmenu > div {
  display: flex;
  justify-content: space-between;
}
.navbar-nav {
  display: flex;
  align-items: center;
}
.nav-categories {
  flex-grow: 1;
}
.navbar-nav > li {
  float: none;
}
.navbar-nav > li > a{
  letter-spacing: -0.5px;
  white-space: nowrap;
}
.navbar-nav > li > a:hover{
  color: inherit;
}
@media (max-width: 991px){#navigation .navbar-toggle {
      display: block;
  }
#navigation .navbar-collapse.collapse {
      display: none !important;
  }
#menubar .container {
    max-width: 100%;
    width: 100%;
  }
#menubar .container,
  #navigation .navbar-collapse,
  #navigation .navbar-collapse .container {
    padding-left: 0 !important;
    padding-right: 0 !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
  }
#mainmenu > div,
  .navbar-nav {
    flex-direction: column;
    align-items: flex-start;
  }
.navbar-nav > li {
    width: 100%;
  }
.navbar-nav > li > a{
    padding: 12px 13px;
    width: 100%;
  }
#topbar {
    flex-direction: row-reverse;
  }
.topbar .container {
    width: 100%;
  }
#topbar-left {
    display: flex;
    align-items: center;
    flex-grow: 1;
    justify-content: space-between;
  }
#topbar-left .navbar-brand {
    height: auto;
  }
.dropdown-menu {
    right: 0;
    left: auto;
  }
#navigation .navbar-nav {
    width: 100%;
  }
.nav-search {
    display: block;
  }}
@media (min-width: 992px){#navigation .navbar-collapse {
    padding: 0;
  }
#navigation .navbar-nav li, .dropdown {
    position:relative;
  }
#navigation .navbar-nav {
    top: 2px;
  }
.navbar-nav > li > a{
    padding: 6px 7px;
    margin: 6px;
    border-radius: 5px;
  }
#navigation .dropdown-menu { 
    border-top:1px solid;
    min-width:160px;
    border-radius: 0; 
    z-index: 9999 !important;
    margin-top: -2px !important;
    background-color:#fff;
  }
#navigation .language-dropdown .dropdown-menu {
    min-width:75px;
  }
#topbar-right {
    flex-grow: 1;
  }
.navbar-nav > li > a:first-child {
    margin-left: 0;
  }
.search input{
    width: 170px;
  }}
.navbar {
  border-radius: 0;
  margin-bottom: 0;
}
.navbar-toggle {
  border: 1px solid #fff;
  margin-top: 0;
  margin-bottom: 0;
}
.navbar-toggle .icon-bar {
  background-color: #384650;
}
.navbar-toggle, 
.navbar-fixed-top .navbar-toggle {
  border: 1px solid #384650;
}
.navbar-toggle .icon-bar, 
.navbar-fixed-top .navbar-toggle .icon-bar {
  background-color: #384650;
}
#navigation {
  background-color:#fff;
  
}
#topbar {
  display: flex;
  position: relative;
  align-items: center;
  justify-content: space-between;
}
#topbar-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
.navbar-brand {
  height:60px;
  padding:9px 15px;
}
@media screen and (min-width: 768px){.homepage .container,
  #page-article .container {
    padding-left: 20px;
    padding-right: 20px;
  }
.homepage .row [class^="col-"],
  .homepage .row [class*=" col-"],
  #page-article .row [class^="col-"],
  #page-article .row [class*=" col-"] {
    padding-left: 20px;
    padding-right: 20px;
  }}
#navigation .container .navbar-brand {
  margin-left:-15px;
}
.navbar-nav {
  float: none;
}
.navbar-nav a {
  font-weight: bold;
}
.language-dropdown, 
#date-time, 
#topbarAd {
  display:inline-block;
  margin-left:12px;
  line-height:60px;
  color:#525b6e;
  font-size:14px;
}
.language-dropdown .dropdown-menu{
  border-radius:0;
  border-color:#ebecee;
  min-width:74px;
  z-index: 10000;
}
.language-dropdown a{
  color:#384650;
  text-decoration: none !important;
}
.language-dropdown .dropdown-menu{
  padding: 0;
}
.language-dropdown .dropdown-menu a{
  padding: 10px 32px;
  font-size: 1.6rem;
}
.homepage-bld {
  margin-top: 40px;
}
.search input{
  padding: 12px;
  transition: all 0.5s ease-in-out;
}
.search-form{
  padding-left: 0;
  height: 48px;
  font-size: 14px;
  font-weight: 300;
  outline: none;
  width: 100%;
  border: 1px solid #eee;
  background-color:#f2f3f5;
  border-right:0;
  border-radius: 5px;
}
.navbar-dark {
  background-color: #262628;
}
.navbar-dark a,
.navbar-dark .language-dropdown a {
  color: #dfdfdf;
}
.navbar-dark .nav-social a i {
  filter: grayscale(1) brightness(4);
}
