<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"Thing","@id":"https:\/\/www.kirsehircigdem.com","name":"Haberler"}},{"@type":"ListItem","position":2,"item":{"@type":"Thing","@id":"https:\/\/www.kirsehircigdem.com\/gundem","name":"G\u00fcndem"}},{"@type":"ListItem","position":3,"item":{"@type":"Thing","@id":"https:\/\/www.kirsehircigdem.com\/emep-kirsehirde-yeni-donem-il-baskani-pelin-atarbay-oldu","name":"EMEP K\u0131r\u015fehir\u2019de Yeni D\u00f6nem: \u0130l Ba\u015fkan\u0131 Pelin Atarbay Oldu"}}]}</script>
<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"NewsArticle","headline":"EMEP K\u0131r\u015fehir\u2019de Yeni D\u00f6nem: \u0130l Ba\u015fkan\u0131 Pelin Atarbay Oldu","articleSection":"G\u00fcndem","dateCreated":"2026-09-07T10:32:00+03:00","datePublished":"2026-09-07T10:32:00+03:00","dateModified":"2026-09-07T10:32:00+03:00","wordCount":299,"genre":"news","mainEntityOfPage":{"@type":"WebPage","@id":"https:\/\/www.kirsehircigdem.com\/emep-kirsehirde-yeni-donem-il-baskani-pelin-atarbay-oldu"},"articleBody":"Emek Partisi (EMEP) K\u0131r\u015fehir \u0130l \u00d6rg\u00fct\u00fc\u2019n\u00fcn 4. Ola\u011fan Kongresi ger\u00e7ekle\u015ftirildi. Kongrede yap\u0131lan se\u00e7imin ard\u0131ndan EMEP K\u0131r\u015fehir \u0130l Ba\u015fkan\u0131 se\u00e7ilen Pelin Atarbay, kad\u0131nlar\u0131n toplumsal ya\u015famdan siyasete kadar her alanda daha g\u00f6r\u00fcn\u00fcr ve etkin olmas\u0131 gerekti\u011fini vurgulad\u0131.\r\n\r\nKongrenin ard\u0131ndan de\u011ferlendirmelerde bulunan Atarbay, yeni d\u00f6nemde kad\u0131nlar\u0131n ya\u015fam\u0131n her alan\u0131nda daha fazla s\u00f6z sahibi olmas\u0131 gerekti\u011fine dikkat \u00e7ekti.\r\n\r\n\r\n\r\nKad\u0131nlar\u0131n yaln\u0131zca \u00e7al\u0131\u015fma ya\u015fam\u0131nda de\u011fil, siyasette, sendikal m\u00fccadelede, toplumsal \u00f6rg\u00fctlenmede ve karar alma mekanizmalar\u0131nda daha g\u00f6r\u00fcn\u00fcr ve etkin bi\u00e7imde yer almas\u0131n\u0131n \u00f6nemini vurgulayan Atarbay, kad\u0131nlar\u0131n \u00f6rg\u00fctl\u00fc g\u00fcc\u00fcn\u00fcn toplumsal m\u00fccadeleyi de g\u00fc\u00e7lendirece\u011fini ifade etti.\r\n\r\nAtarbay ayr\u0131ca kongreye kat\u0131lan siyasi parti, sendika ve demokratik kitle \u00f6rg\u00fctlerinin temsilcilerine, yurtta\u015flara ve EMEP K\u0131r\u015fehir \u00f6rg\u00fct\u00fcne te\u015fekk\u00fcr etti.\r\n\r\nK\u0131r\u015fehir\u2019de Siyaset ve Emek \u00d6rg\u00fctleri Kongrede Bulu\u015ftu\r\n\r\nKongreye K\u0131r\u015fehir Belediye Ba\u015fkan Yard\u0131mc\u0131s\u0131 Naz\u0131m K\u00f6ksal, T\u0130P K\u0131r\u015fehir \u0130l Temsilcisi Damla Ye\u015filli, SOL Parti K\u0131r\u015fehir \u0130l Temsilcisi \u015eakir \u015eenol, Atat\u00fcrk\u00e7\u00fc D\u00fc\u015f\u00fcnce Derne\u011fi Ba\u015fkan\u0131 Birol Yurdug\u00fcl, D\u0130SK Genel-\u0130\u015f \u015eube Ba\u015fkan\u0131 Metin \u00d6zkan, E\u011fitim-Sen K\u0131r\u015fehir \u015eube Ba\u015fkan\u0131 \u00d6zdemir Beyhan, \u00d6zg\u00fcrl\u00fck\u00e7\u00fc Hukuk\u00e7ular Derne\u011fi ad\u0131na \u00d6mer G\u00fcrler, yazar Emin Salman ve TKP K\u0131r\u015fehir Temsilcisi Kadir Da\u011f\u0131stan kat\u0131ld\u0131.\r\n\r\nEMEP K\u0131r\u015fehir \u0130l \u00d6rg\u00fct\u00fc\u2019n\u00fcn 4. Ola\u011fan Kongresi, yeni y\u00f6netimin belirlenmesi ve yeni d\u00f6neme ili\u015fkin mesajlar\u0131n ard\u0131ndan tamamland\u0131.","description":"Emek Partisi (EMEP) K\u0131r\u015fehir \u0130l \u00d6rg\u00fct\u00fc, 4. Ola\u011fan Kongresi\u2019ni 6 Eyl\u00fcl 2026 tarihinde Ne\u015fet Erta\u015f K\u00fclt\u00fcr Sanat Merkezi\u2019nde ger\u00e7ekle\u015ftirdi. Siyasi parti\u2026","inLanguage":"tr-TR","keywords":[],"image":{"@type":"ImageObject","url":"https:\/\/kirsehircigdemcom.teimg.com\/crop\/1280x720\/kirsehircigdem-com\/uploads\/2026\/09\/pelin-atarbay-emep-emek.jpeg","width":"1280","height":"720","caption":"EMEP K\u0131r\u015fehir\u2019de Yeni D\u00f6nem: \u0130l Ba\u015fkan\u0131 Pelin Atarbay Oldu"},"isFamilyFriendly":"http:\/\/schema.org\/True","isAccessibleForFree":"http:\/\/schema.org\/True","publisher":{"@type":"NewsMediaOrganization","@id":"https:\/\/kirsehircigdem.com\/#organization","name":"K\u0131r\u015fehir \u00c7i\u011fdem","image":"https:\/\/kirsehircigdemcom.teimg.com\/kirsehircigdem-com\/images\/banner\/sozcu-box-logo.png","logo":{"@type":"ImageObject","url":"https:\/\/kirsehircigdemcom.teimg.com\/kirsehircigdem-com\/images\/banner\/sozcu-box-logo.png","width":"640","height":"375"}},"author":{"@type":"Person","name":"Nurten Ceylan - Damla Ye\u015filli"},"editor":{"@type":"Person","name":"DAMLA YE\u015e\u0130LL\u0130","url":"https:\/\/www.kirsehircigdem.com\/muhabir\/94\/damla-yesilli"},"creator":{"@type":"NewsMediaOrganization","@id":"https:\/\/kirsehircigdem.com\/#organization","name":"K\u0131r\u015fehir \u00c7i\u011fdem","url":"https:\/\/kirsehircigdem.com"}}</script>


