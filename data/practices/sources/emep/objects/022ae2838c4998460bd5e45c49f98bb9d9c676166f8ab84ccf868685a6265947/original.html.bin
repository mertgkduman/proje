:root {
    --img-namaz-strip:        url('https://www.gercekhaberci.com/frontend/diamond/assets/img/namaz-vakti-strip.png');
    --img-move-icon:          url('https://www.gercekhaberci.com/frontend/diamond/assets/img/SVG/move-vertical.svg');
    --img-weather-acik:       url('https://www.gercekhaberci.com/frontend/diamond/assets/img/weather_widget_backgrounds/acik.webp');
    --img-weather-kapali:     url('https://www.gercekhaberci.com/frontend/diamond/assets/img/weather_widget_backgrounds/kapali.webp');
    --img-weather-yagmurlu:   url('https://www.gercekhaberci.com/frontend/diamond/assets/img/weather_widget_backgrounds/yagmurlu.webp');
    --img-weather-kar:        url('https://www.gercekhaberci.com/frontend/diamond/assets/img/weather_widget_backgrounds/kar-yagisli.webp');
    --img-weather-az-bulutlu: url('https://www.gercekhaberci.com/frontend/diamond/assets/img/weather_widget_backgrounds/az-bulutlu.webp');
}
</style>

