  <style>.post-detail-main-nest,.top-advert-box{background: #f7f7f7}.post-detail-main-nest{--post-detail-box-gap: 6px}.post-detail-main-mininest > .bg-white{padding-inline: var(--post-detail-box-gap)}.social-icon-size{width: 34px;height: 34px}.social-icon-size:hover{filter: brightness(0.8)}.post-detail-main-nest .currency-sidebar-slider{padding: 25px 28px}.post-detail-main-nest .content-title a{display: -webkit-inline-box !important;-webkit-box-orient: vertical;overflow: hidden !important;text-overflow: ellipsis;-webkit-line-clamp: 2;-webkit-box-pack: center}@media screen and (max-width: 500px){.post-detail-main-nest{--post-detail-box-gap: 0px}.post-detail-main-mininest{padding: 0}}.detail-sort-item{display: flow-root}@media (min-width: 992px){.row:has(> [class*="col-"] .post-breadcrumb-nav) > .columnSticky{padding-top: 16px}}</style><style>.post-breadcrumb-nav{overflow-x: auto;-webkit-overflow-scrolling: touch;scrollbar-width: none}.post-breadcrumb-nav::-webkit-scrollbar{display: none}.post-breadcrumb-inner{gap: 8px}.post-breadcrumb-home,.post-breadcrumb-link{text-decoration: none;white-space: nowrap;transition: opacity .15s}.post-breadcrumb-home:hover,.post-breadcrumb-link:hover{opacity: .7}.post-breadcrumb-icon{font-size: 16px;margin-right: 4px}.post-breadcrumb-current{max-width: 200px}.post-breadcrumb-home,.post-breadcrumb-sep{display: inline-flex;align-items: center}.post-breadcrumb-nav .post-breadcrumb-sep-icon{margin-right: 0 !important}.post-breadcrumb-nav img.module-head-icon,.post-breadcrumb-nav .module-head-icon svg{width: 1em;height: 1em;object-fit: contain}@media (max-width: 767px){.post-breadcrumb-nav{padding: 8px 0 4px 0 !important}}.post-main-head{letter-spacing: -.04rem}@media (max-width: 500px){.post-title-container{padding: 0 !important}.post-main-head{font-size: 28px !important;line-height: 42px !important;margin: 10px 0 !important}.post-summary{font-size: 18px !important;line-height: 28px !important;letter-spacing: .3px}}.post-info-bar{margin-left: calc(var(--bs-gutter-x,1.5rem) * -.5 - var(--post-detail-box-gap,0px)) !important;margin-right: calc(var(--bs-gutter-x,1.5rem) * -.5 - var(--post-detail-box-gap,0px)) !important}.post-info-bar-inner{flex-wrap: nowrap !important;gap: 12px 16px}.post-info-bar-left{flex: 1 1 auto;min-width: 0;text-align: left}.post-info-bar-share{flex: none;gap: 8px}.post-info-bar .post-info-block{align-self: stretch;display: flex;flex-direction: column;justify-content: center;min-width: max-content;padding: 0;text-align: left}.post-info-bar .post-info-block + .post-info-block{border-left: 1px solid var(--bs-secondary-color);margin-left: 10px;padding-left: 10px}.post-info-bar .post-user-infos{flex-direction: row;text-decoration: none;color: inherit;gap: 8px}.post-info-bar .post-editor-img img{object-fit: cover}.post-info-bar .post-date-text{min-width: max-content;text-align: left}.post-info-bar .post-city-name a,.post-info-bar .post-city-link,.post-info-bar .post-city-town-link{text-decoration: none;color: inherit}.post-info-bar .post-source-names{text-align: left}.post-info-bar .post-source-link:hover,.post-info-bar .post-source-link:focus-visible{text-decoration: underline}.post-info-bar .post-source-sep{display: inline-block;margin: 0 2px 0 6px;opacity: .55}.post-info-bar .post-source-sep-dot{width: 4px;height: 4px;margin: 0 4px 0 8px;border-radius: 50%;background: currentColor;vertical-align: middle}.post-info-bar .social-icon-size{width: 34px;height: 34px;flex-shrink: 0}.post-info-bar .social-icon-size:hover{filter: brightness(0.8)}.post-info-bar .bg-facebook{background-color: #1877f2}.post-info-bar .bg-twitter{background-color: #000000}.post-info-bar .bg-whatsapp{background-color: #25d366}.post-info-bar .post-googlenews-btn{background-color: #ffffff}@media (max-width: 767px){.post-info-bar{overflow: hidden}.post-info-bar .post-info-bar-inner{align-items: center !important;flex-direction: row !important;flex-wrap: nowrap !important;gap: 0 !important;justify-content: flex-start !important;overflow-x: auto;overscroll-behavior-x: contain;scrollbar-width: thin;-webkit-overflow-scrolling: touch}.post-info-bar .post-info-bar-left{flex: 0 0 auto;flex-wrap: nowrap !important;justify-content: flex-start !important;width: max-content}.post-info-bar .post-date-text{margin-bottom: 0}.post-info-bar .post-info-bar-share{flex: 0 0 auto;margin-left: 10px;padding-right: 10px}}.post-image-wrapper .video-detail-video{aspect-ratio: 780 / 500}.post-image-img{display: block}.post-image-wrapper video{width: 100%;max-width: 100%;height: auto;max-height: 80vh}@keyframes share-band-gradient-move{0%{background-position: 0% 50%}50%{background-position: 100% 50%}100%{background-position: 0% 50%}}.share-band .social_btns_style{height: 45px;margin-right: 10px;padding: 7px 18px 9px 18px;transition: .15s ease-in-out}.share-band .social_btns_style:hover{filter: brightness(.9)}.share-band .social_btns_style i{font-size: 24px;margin-right: 10px}.share-band .google_news_btn{border: 1px solid #c7c7c7;padding: 11px 16px 9px 17px}.share-band .google_news_btn img{max-width: min-content}.share-band .share_btn{outline: none;border: none;padding: 0 13px}.share-band .share_btn i{margin: 0;font-size: 19px;pointer-events: none}.share-band .social-emote{border: 1px solid #c7c7c7;padding: 7px 11px 3px 12px;transition: .3s ease-in-out}.share-band .social-emote i{margin: 0;transition: .3s}.share-band .social-emote:hover i{scale: 1.2}.share-band .news-band-like.liked{position: relative;background-image: linear-gradient(45deg,#4144ff,#ff2b2b,#ca4000) !important;background-size: 400% 400% !important;animation: share-band-gradient-move 3s infinite linear;transition: transform 0.3s ease-in-out}.share-band .news-band-like.liked i{color: #fff !important;transform: scale(1.3);transition: transform 0.3s ease-in-out}.col-lg-8 .share-band .social_btns_style{padding: 7px 11px 9px 11px;height: 40px}.col-lg-8 .share-band .google_news_btn img{width: 90px}.col-lg-8 .share-band .social-emote i{line-height: 21px}@media screen and (max-width: 500px){.share-band .social_btns_style{font-size: 0 !important;padding: 7px 13px 9px 13px}.share-band .social_btns_style i{margin-right: 0}.share-band .google_news_btn{padding: 10px}.share-band .google_news_btn img{width: 60px}}#postdetailmodule1 .post-breadcrumb-nav{background:transparent;padding:16px 0 4px 0}#postdetailmodule1 .post-breadcrumb-nav .post-breadcrumb-home{font-family:system-ui;font-size:14px;font-weight:400;line-height:16px;color:#6c757d}#postdetailmodule1 .post-breadcrumb-nav .post-breadcrumb-link{font-family:system-ui;font-size:14px;font-weight:400;line-height:16px;color:#6c757d}#postdetailmodule1 .post-breadcrumb-nav .post-breadcrumb-current{font-family:system-ui;font-size:14px;font-weight:400;line-height:16px;color:#6c757d}#postdetailmodule1 .post-breadcrumb-nav .post-breadcrumb-sep{color:#6c757d;font-size:14px}#postdetailmodule2 .post-main-head{font-family:HBR;font-size:44px;font-weight:800;line-height:50px;color:#000000;margin:6px 0px 0px 0px}#postdetailmodule2 .post-summary{font-family:system-ui;font-size:21px;font-weight:400;line-height:27px;color:#000000;margin:10px 0px 6px 0px}#postdetailmodule2 .post-title-container{padding:0px 0px 8px 0px}#postdetailmodule3 .post-info-bar{background:#e2e3e5;padding:16px 16px 16px 16px;margin:0 0 16px 0}#postdetailmodule3 .post-info-bar .post-editor-name{font-family:system-ui;font-size:14px;font-weight:600;line-height:18px;color:#212529}#postdetailmodule3 .post-info-bar .post-editor-title{font-family:system-ui;font-size:12px;font-weight:400;line-height:16px;color:#565e64}#postdetailmodule3 .post-info-bar .post-date-value{font-family:system-ui;font-size:14px;font-weight:600;line-height:18px;color:#212529}#postdetailmodule3 .post-info-bar .post-date-label{font-family:system-ui;font-size:12px;font-weight:400;line-height:16px;color:#565e64}#postdetailmodule3 .post-info-bar .post-city-name a{font-family:system-ui;font-size:14px;font-weight:600;line-height:18px;color:#212529}#postdetailmodule3 .post-info-bar .post-city-town{font-family:system-ui;font-size:12px;font-weight:400;line-height:16px;color:#565e64}#postdetailmodule3 .post-info-bar .post-source-names{font-family:system-ui;font-size:12px;font-weight:400;line-height:16px;color:#212529}#postdetailmodule24 .post-image-wrapper{margin:0 0 16px 0;padding:0 0 0 0}#postdetailmodule25 .share-band{margin:0 0 16px 0}#postdetailmodule25 .share-band .social_btns_style{font-family:system-ui;font-size:14px;font-weight:600;line-height:20px;color:#ffffff;border-radius:6px}#postdetailmodule25 .share-band .social_btns_style:not(.share_btn) i{font-size:24px}#postdetailmodule25 .share-band .social_btns_style.news-band-like{background:#ffffff;border:1px solid #c7c7c7}#postdetailmodule25 .share-band .social_btns_style.news-band-like i{color:#3b55a0}#postdetailmodule25 .share-band .social_btns_style.google_news_btn{background:#ffffff;border:1px solid #c7c7c7}#postdetailmodule25 .share-band .social_btns_style.facebook_btn{background:#3b55a0;font-family:system-ui;font-size:14px;font-weight:600;line-height:20px;color:#ffffff;border:0px solid #3b55a0}#postdetailmodule25 .share-band .social_btns_style.twitter_btn{background:#000000;font-family:system-ui;font-size:14px;font-weight:600;line-height:20px;color:#ffffff;border:0px solid #000000}#postdetailmodule25 .share-band .social_btns_style.whatsapp_btn{background:#25d366;font-family:system-ui;font-size:14px;font-weight:600;line-height:20px;color:#ffffff;border:0px solid #25d366}#postdetailmodule25 .share-band .social_btns_style.share_btn{background:#f6d500;color:#000000;border:0px solid #000000}#postdetailmodule25 .share-band .social_btns_style.share_btn i{font-size:19px}</style><link rel="preload" as="style" href="https://www.gercekhaberci.com/frontend/diamond/compiled/css/post-detail-compiled.css?v=1795297206" onload="this.rel='stylesheet'">
