<script>
    // --- Sayfada Geçirilen Süre Takibi (Time on Page) ---
    let pageLoadTime = Date.now();
    let totalTimeSpent = 0;
    let isPageActive = true;

    // Kullanıcı sekmeyi değiştirdiğinde süreyi duraklat/devam ettir
    document.addEventListener('visibilitychange', function () {
        if (document.hidden) {
            totalTimeSpent += Date.now() - pageLoadTime;
            isPageActive = false;
        } else {
            pageLoadTime = Date.now();
            isPageActive = true;
        }
    });

    // Sayfa kapanmadan veya yenilenmeden hemen önce veriyi gönder
    window.addEventListener('beforeunload', function () {
        if (isPageActive) {
            totalTimeSpent += Date.now() - pageLoadTime;
        }
        gtag('event', 'time_spent_on_page', {
            'value': totalTimeSpent,
            'page_path': window.location.pathname
        });
    });

    // --- Kaydırma Derinliği Takibi (Scroll Depth — passive + rAF throttle) ---
    let scrollTicking = false;
    const scrollThresholds = [25, 50, 75, 100];
    function onScrollDepth() {
        if (scrollTicking) return;
        scrollTicking = true;
        window.requestAnimationFrame(function () {
            scrollTicking = false;
            const scrollHeight = document.documentElement.scrollHeight;
            const scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;
            const clientHeight = window.innerHeight || document.documentElement.clientHeight;
            if (!scrollHeight) return;

            const scrollDepth = (scrollTop + clientHeight) / scrollHeight * 100;
            scrollThresholds.forEach(function (threshold) {
                if (scrollDepth >= threshold && !window['scrollThreshold' + threshold]) {
                    window['scrollThreshold' + threshold] = true;
                    gtag('event', 'scroll_depth', {
                        'value': threshold,
                        'page_path': window.location.pathname
                    });
                }
            });

            if (window.scrollThreshold100) {
                document.removeEventListener('scroll', onScrollDepth);
            }
        });
    }
    document.addEventListener('scroll', onScrollDepth, { passive: true });
</script>

