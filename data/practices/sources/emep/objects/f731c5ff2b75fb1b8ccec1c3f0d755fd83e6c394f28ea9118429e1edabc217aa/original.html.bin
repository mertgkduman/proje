            <header class="td-post-title">
                <h1 class="entry-title">Taksim’deki Kadına Yönelik Şiddet Karşıtı Eylem Yasaklandı</h1>

                

                <div class="td-module-meta-info">
                                        <span class="td-post-date"><time class="entry-date updated td-module-date" datetime="2019-11-24T21:09:22+00:00" >24/11/2019</time></span>                    <div class="td-post-comments"><a href="https://odakdergisi2.com/taksimdeki-kadina-yonelik-siddet-karsiti-eylem-yasaklandi/#respond"><i class="td-icon-comments"></i>0</a></div>                    <div class="td-post-views"><i class="td-icon-views"></i><span class="td-nr-views-26496">1618</span></div>                </div>

            </header>

        </div>

