				<div class="full-gray">
					<div class="container relative pt30">
						<h1 class="articleTitle">EMEP, yeni yılı grevdeki Trelleborg işçileriyle karşıladı</h1>

						<div class="evrensel-manset">
							<div class="manset-main">
								<div class="manset-tip1">
									<div class="ust">
										<div class="manset-article">
											<div class="manset-text">
												<h2 class="article-spot">Emek Partisi Kocaeli İl Örgütü, yeni yılı 22 gündür hakları için grev yapan Trelleborg işçileriyle karşıladı.</h2>
																									<div class="mobileMenu pt15">
														<div id='div-gpt-ad-1771915251719-0' data-ad-unit-path="/23311515254/Desktop-Mobil-Site-Geneli-Spotalti" class="advertisement-area" style="min-height:250px;display:flex;align-items:center;justify-content:center;"></div>
													</div>
																							</div>
											<figure class="manset-foto">
																																																					<div class="yt-lite-facade" data-yt-id="JaPASVF9rJs&#x20;">
															<img src="https://i.ytimg.com/vi/JaPASVF9rJs&#x20;/hqdefault.jpg" onerror="this.onerror=null;this.src='https://www.evrensel.net/images/840/upload/dosya/153337.jpg';" alt="EMEP, yeni yılı grevdeki Trelleborg işçileriyle karşıladı" width="480" height="360" fetchpriority="high">
															<button type="button" class="yt-lite-play" aria-label="EMEP, yeni yılı grevdeki Trelleborg işçileriyle karşıladı - Videoyu oynat">
