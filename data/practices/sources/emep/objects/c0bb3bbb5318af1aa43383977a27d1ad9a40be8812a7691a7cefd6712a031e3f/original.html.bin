<div class="modal fade" id="external-link" tabindex="-1" aria-labelledby="external-modal" aria-hidden="true" data-url="https://www.gazeteekspres.com">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center rounded-0">
            <div class="modal-header">
