	<script>
	(function() {
		var desktopNav = document.getElementById('desktop-nav');
		var mobileTarget = document.getElementById('mobile-nav-target');
		if (!desktopNav || !mobileTarget) return;

		var clone = desktopNav.cloneNode(true);
		clone.removeAttribute('id');

		// 1. seviye sub-menu → menu-style_1 ekle
		var level1 = clone.querySelectorAll('.menu-item-has-children > .sub-menu');
		for (var i = 0; i < level1.length; i++) {
			level1[i].classList.add('menu-style_1');
		}

		// 2. seviye sub-menu → menu-style_2 ekle
		var level2 = clone.querySelectorAll('.menu-item-has-children > .sub-menu .menu-item-has-children > .sub-menu');
		for (var i = 0; i < level2.length; i++) {
			level2[i].classList.remove('menu-style_1');
			level2[i].classList.add('menu-style_2');
		}

		// head_actions'ın önüne ekle
		var headActions = mobileTarget.querySelector('.head_actions');
		
		mobileTarget.insertBefore(clone, headActions);
	})();
	</script>

