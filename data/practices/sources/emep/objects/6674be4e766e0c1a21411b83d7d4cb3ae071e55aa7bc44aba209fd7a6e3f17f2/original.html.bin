				</div>

				<div class="container relative">
					<div class="article">
						<div class="paylas pt30" data-article-id="367618" data-content-type="haber">
							<a href="https://api.whatsapp.com/send?text=https://www.evrensel.net/haber/367618/sozde-kriz-pazari-yakiyor" target="_blank" rel="nofollow" data-share-platform="whatsapp" title="WhatsApp'la paylaş">
