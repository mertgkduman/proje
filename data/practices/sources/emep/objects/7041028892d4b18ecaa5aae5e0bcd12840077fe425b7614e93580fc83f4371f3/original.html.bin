    --img-weather-yagmurlu:   url('https://www.bagimsizkocaeli.com.tr/frontend/diamond/assets/img/weather_widget_backgrounds/yagmurlu.webp');
    --img-weather-kar:        url('https://www.bagimsizkocaeli.com.tr/frontend/diamond/assets/img/weather_widget_backgrounds/kar-yagisli.webp');
    --img-weather-az-bulutlu: url('https://www.bagimsizkocaeli.com.tr/frontend/diamond/assets/img/weather_widget_backgrounds/az-bulutlu.webp');
}
