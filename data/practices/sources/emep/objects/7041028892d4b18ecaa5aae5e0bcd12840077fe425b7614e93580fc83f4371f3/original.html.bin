: anywhere}@media (max-width: 575px){.post-lead .post-lead__text{font-size: 18px !important;line-height: 28px !important}}.google-news-follow{position: relative;display: flex;align-items: center;gap: 14px;min-width: 0}.google-news-follow::before{content: "";position: absolute;top: 0;left: 0;right: 0;height: 4px;background: linear-gradient(90deg,#4285f4 0 25%,#ea4335 25% 50%,#fbbc05 50% 75%,#34a853 75% 100%)}.google-news-follow .google-news-follow__icon{display: inline-flex;align-items: center;justify-content: center;flex: 0 0 auto;border-radius: 50%}.google-news-follow .google-news-follow__body{flex: 1;min-width: 0;overflow-wrap: anywhere}.google-news-follow .google-news-follow__button{display: inline-flex;align-items: center;justify-content: center;flex: 0 0 auto;gap: 5px;text-decoration: none}.google-news-follow .google-news-follow__button:hover{filter: brightness(.9)}@media (max-width: 575px){.google-news-follow{flex-wrap: wrap;gap: 10px;padding: 16px 12px 12px 12px !important}.google-news-follow .google-news-follow__icon{width: 34px !important;height: 34px !important}.google-news-follow .google-news-follow__body{flex-basis: 0}.google-news-follow .google-news-follow__title{font-size: 12px !important;line-height: 18px !important}.google-news-follow .google-news-follow__description{font-size: 9px !important;line-height: 14px !important}.google-news-follow .google-news-follow__button{flex-basis: 100%;min-width: 0;font-size: 10px !important;line-height: 14px !important;padding: 10px 12px 10px 12px !important}}.editor-byline .editor-byline__author{display: flex;align-items: center;gap: 14px}.editor-byline .editor-byline__identity{display: flex;flex-direction: column;gap: 3px;min-width: 0;overflow-wrap: anywhere}.editor-byline .editor-byline__avatar{flex: 0 0 auto;max-width: 100%;border-radius: 50%;object-fit: cover;filter: grayscale(1)}.editor-byline .editor-byline__name{text-decoration: underline;text-underline-offset: 3px}.editor-byline .editor-byline__meta{display: