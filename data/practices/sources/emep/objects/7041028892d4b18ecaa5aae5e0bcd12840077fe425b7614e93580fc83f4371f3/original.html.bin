<script type="application/ld+json">{"@context":"https://schema.org","@graph":[{"@type":"NewsMediaOrganization","@id":"https://www.bagimsizkocaeli.com.tr/#organization","description":"Kocaeli'nin güncel, tam bağımsız gazetesi ve Kocaeli haber sitesi. Son dakika Kocaeli Haberleri, Bağımsız Kocaeli'de.","url":"https://www.bagimsizkocaeli.com.tr","logo":{"@type":"ImageObject","url":"https://www.bagimsizkocaeli.com.tr/uploads/logos/logo-1794859201.png","width":1200,"height":399},"email":"haber@bagimsizkocaeli.com.tr","knowsLanguage":"tr-TR","ownershipFundingInfo":"https://www.bagimsizkocaeli.com.tr/kurumsal/kunye","diversityPolicy":"https://www.bagimsizkocaeli.com.tr/kurumsal/kunye","address":{"@type":"PostalAddress","addressLocality":"Kocaeli"},"contactPoint":[{"@type":"ContactPoint","telephone":"‪+90 532 730 91 71‬","contactType":"customer service","contactOption":"TollFree","areaServed":"TR"}]},{"@type":"WebSite","@id":"https://www.bagimsizkocaeli.com.tr/#website","url":"https://www.bagimsizkocaeli.com.tr","description":"Kocaeli'nin güncel, tam bağımsız gazetesi ve Kocaeli haber sitesi. Son dakika Kocaeli Haberleri, Bağımsız Kocaeli'de.","publisher":{"@id":"https://www.bagimsizkocaeli.com.tr/#organization"},"potentialAction":{"@type":"SearchAction","target":"https://www.bagimsizkocaeli.com.tr/arama?search={search_term_string}","query-input":"required name=search_term_string"}},{"@type":"WebPage","@id":"https://www.bagimsizkocaeli.com.tr/siyaset/emep-izmit-baskan-secti/29904/#webpage","url":"https://www.bagimsizkocaeli.com.tr/siyaset/emep-izmit-baskan-secti/29904","name":"EMEP İzmit başkan seçti","description":"Emek Partisi İzmit İlçe Örgütü'nde yapılan ilçe kongresinde Dursun Deniz yeniden başkanlığa seçildi.","datePublished":"2020-10-04T08:12:19+03:00","dateModified":"2020-10-04T08:12:19+03:00","isPartOf":{"@id":"https://www.bagimsizkocaeli.com.tr/#website"},"primaryImageOfPage":{"@id":"https://www.bagimsizkocaeli.com.tr/siyaset/emep-izmit-baskan-secti/29904/#primaryimage"}},{"@type":"ImageObject","url":"https://www.bagimsizkocaeli.com.tr/cropImages/1280x720/olds/bagimsizkocaeli-com-tr/2020/10/EMEP-Izmit-baskan-secti-dursun.jpg","width":1280,"height":720,"@id":"https://www.bagimsizkocaeli.com.tr/siyaset/emep-izmit-baskan-secti/29904/#primaryimage"},{"@type":"NewsArticle","@id":"https://www.bagimsizkocaeli.com.tr/siyaset/emep-izmit-baskan-secti/29904/#article","inLanguage":"tr","genre":"News","headline":"EMEP İzmit başkan seçti","description":"Emek Partisi İzmit İlçe Örgütü'nde yapılan ilçe kongresinde Dursun Deniz yeniden başkanlığa seçildi.","datePublished":"2020-10-04T08:12:19+03:00","dateModified":"2020-10-04T08:12:19+03:00","articleSection":"Siyaset","articleBody":"Emek Partisi İzmit İlçe Örgütü'nün ilçe kongresi, Emek Partisi (EMEP) Kocaeli İl Örgütü nde gerçekleştirildi. EMEP İzmit İlçe Başkanı Dursun Deniz yeniden başkan seçildi. Pandemi şartlarına uygun bir şekilde yapılan kongrede açılış ve saygı duruşunun ardından söz alan EMEP İl Başkanı Arzu Erkan, dönemin dezavantajlarından bahsederek, 9. Genel Kongremizi; tek adam, tek parti iktidarının tüm demokratik şeyleri askıya aldığı bir koşulda gerçekleştiriyoruz. İktidar pandemiyi de kendine kalkan olarak kullanıyor. Biz 8. Kongre sürecimizi de OHAL döneminde gerçekleştirmiştik. Şimdi de içinde bulunduğumuz zaman çok normal bir zaman değil dedi. DAHA ADİL BİR YAŞAM MÜCADELESİ VERİYORUZ Topyekün mücadele çağrılarını yineleyen Erkan, HDP 31 Mart'ta 65 belediye kazanmıştı, şu an 6 HDP'li belediye kaldı. Seçimle alamadıklarını kayyum ile alıyor bu iktidar. Öte yandan kıdem tazminatı, İstanbul Sözleşmesi, siyasi partiler ve belediye kanunları, oda ve barolara dönük saldırılar ve AYM'nin yapısının tartıştırılması da dahil olmak üzere birçok konuda baskıyı arttırarak devam edecekler. Peki biz ne yapacağız? Bütün bunlar üzerinden saldırılara karşı topyekün mücadele çağrımızı bir kez daha ifade ederek, emekçileri hakları için mücadeleye çağıracağız. İşçiler, emekçiler Cumhur ve Millet İttifakı arasında tercih etmek zorunda değil, başka bir seçenek daha var, bir üçüncü yol mümkün. Bu üçüncü yol halk demokrasidir, demokratik halk iktidarıdır. Partimiz daha adil bir yaşam için bunun mücadelesini veriyor, vermeye de devam edecektir ifadelerini kullandı. SÖMÜRÜNÜN VE BASKININ OLMADIĞI Ardından konuşan EMEP İzmit İlçe Başkanı Dursun Deniz ise, Sömürünün ve baskının olmadığı bir toplumsal sistem kurmaya hedefliyoruz. Daha çok gerçekleri anlatarak, aydınlatma çalışmamızı sürdürerek bu hedefimizi sağlamamız gerekiyor dedi. Konuşmaların ardından mali rapor ve karar önergelerin okunmasının ardından seçime gidildi. Yeni dönemde görev alacak yönetim Dursun Deniz'in başkanlığında oluşturuldu.","keywords":["Emek Partisi İzmit İlçe Örgütü","EMEP Kocaeli","Dursun Deniz"],"wordCount":267,"isFamilyFriendly":true,"speakable":{"@type":"SpeakableSpecification","cssSelector":[".content-title",".content-description",".text-content"]},"image":[{"@id":"https://www.bagimsizkocaeli.com.tr/siyaset/emep-izmit-baskan-secti/29904/#primaryimage"}],"editor":{"@id":"https://www.bagimsizkocaeli.com.tr/siyaset/emep-izmit-baskan-secti/29904/#author"},"author":{"@id":"https://www.bagimsizkocaeli.com.tr/siyaset/emep-izmit-baskan-secti/29904/#author"},"publisher":{"@id":"https://www.bagimsizkocaeli.com.tr/#organization"},"mainEntityOfPage":{"@id":"https://www.bagimsizkocaeli.com.tr/siyaset/emep-izmit-baskan-secti/29904/#webpage"}},{"@type":"Person","@id":"https://www.bagimsizkocaeli.com.tr/siyaset/emep-izmit-baskan-secti/29904/#author","name":"Uğur Enç","url":"https://www.bagimsizkocaeli.com.tr/editor/ugur-enc/4","image":"https://www.bagimsizkocaeli.com.tr/uploads/users/2026/11/ugur-enc-1q1dew.jpg","description":"Kocaeli İzmit doğumlu. AİBÜ İngilizce Biyoloji eğitimini yarım bırakarak 2009 yılında gazeteciliğe başladı.","worksFor":{"@id":"https://www.bagimsizkocaeli.com.tr/#organization"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Bağımsız Kocaeli Gazetesi - Kocaeli Haber","item":"https://www.bagimsizkocaeli.com.tr"},{"@type":"ListItem","position":2,"name":"Siyaset","item":"https://www.bagimsizkocaeli.com.tr/siyaset"},{"@type":"ListItem","position":3,"name":"EMEP İzmit başkan seçti","item":"https://www.bagimsizkocaeli.com.tr/siyaset/emep-izmit-baskan-secti/29904"}]}]}</script>

