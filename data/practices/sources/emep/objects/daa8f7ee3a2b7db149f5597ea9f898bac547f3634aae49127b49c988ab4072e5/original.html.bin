    <script>
        $(document).ready(function () {
            const date1 = new Date('12/23/2020');
            const date2 = new Date();
            const diffTime = Math.abs(date2 - date1);
            const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            $("#LblCounter").text(diffDays);
        });
    </script>

