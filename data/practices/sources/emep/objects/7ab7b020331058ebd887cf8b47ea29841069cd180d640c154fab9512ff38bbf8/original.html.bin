<p style="text-align&#58;justify;"><span style="font-size&#58;16px;"><span style="font-family&#58;times new roman,times,serif;">Prof. Dr. Metin ÖZDEMİR&#58; Ankara Sosyal Bilimler Üniversitesi</span></span></p>

<p style="text-align&#58;justify;"><span style="font-size&#58;16px;"><span style="font-family&#58;times new roman,times,serif;">Doç. Dr. Hasan Fırat DİKER&#58; Fatih Sultan Mehmet Vakıf Üniversitesi</span></span></p>

<p style="text-align&#58;justify;"><span style="font-size&#58;16px;"><span style="font-family&#58;times new roman,times,serif;">Doç. Dr. Hilal KAZAN&#58; İstanbul Üniversitesi</span></span></p>

<p style="text-align&#58;justify;"><span style="font-size&#58;16px;"><span style="font-family&#58;times new roman,times,serif;"><strong>Düzenleme Kurulu</strong></span></span></p>

<p style="text-align&#58;justify;"><span style="font-size&#58;16px;"><span style="font-family&#58;times new roman,times,serif;">Prof. Dr. Huriye MARTI</span></span></p>

