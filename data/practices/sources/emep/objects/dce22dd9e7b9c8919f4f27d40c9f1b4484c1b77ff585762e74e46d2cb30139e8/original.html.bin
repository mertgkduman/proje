<div id="meclis-arastirma-onergesi-detay" class="common-page-content page-content">
    <div class="container">
        <div class="row g-0">
            <div class="col-lg-8 col-md-12">
                <div id="content-dinamik-title">
                    <div id="content-title-type">
                        MECLİS ARAŞTIRMASI ÖNERGE BİLGİLERİ
                    </div>
                </div>
                <div class="blog-content tbmm-div-list">
                    <table class="table table-striped" style="width:100%;">

                        <tbody>
                            <tr>
                                <td style="width:25%"></td>
                                <td>  <a target="_blank" href="https://cdn.tbmm.gov.tr/KKBSPublicFile/D28/Y4/T10/WebOnergeMetni/fe0725e2-03bb-4b0d-bd12-1315cd8b8c2f.pdf">Meclis Araştırması Önergesinin Metni</a> </td>
                            </tr>
                            <tr>
                                <td><b>Dönemi ve Yasama Yılı</b></td>
                                <td>28 / 4</td>
                            </tr>
                            <tr>
                                <td><b>Esas Numarası</b></td>
                                <td>10 / 4172</td>
                            </tr>
                            <tr>
                                <td><b>Başkanlığa Geliş Tarihi</b></td>
                                <td>07/05/2026</td>
                            </tr>
                            <tr>
                                <td><b>Önergenin Özeti</b></td>
                                <td>&#x130;zmir&#x27;in Alia&#x11F;a il&#xE7;esinde ba&#x15F;ta gemi s&#xF6;k&#xFC;m tesisleri, demir-&#xE7;elik fabrikalar&#x131;, petrokimya tesisleri olmak &#xFC;zere a&#x11F;&#x131;r sanayide &#xE7;al&#x131;&#x15F;an i&#x15F;&#xE7;ilerin kar&#x15F;&#x131;la&#x15F;t&#x131;&#x11F;&#x131; sorunlar&#x131;n ara&#x15F;t&#x131;r&#x131;larak i&#x15F;&#xE7;i sa&#x11F;l&#x131;&#x11F;&#x131; ve g&#xFC;venli&#x11F;inin sa&#x11F;lanmas&#x131; i&#xE7;in al&#x131;nmas&#x131; gereken tedbirlerin belirlenmesi amac&#x131;yla bir Meclis ara&#x15F;t&#x131;rmas&#x131; a&#xE7;&#x131;lmas&#x131;na ili&#x15F;kin &#xF6;nergesi</td>
                            </tr>
                            <tr>
                                <td><b>Okutulduğu Birleşim</b></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td><b>Önerge Sahibi</b>
                                <td>&#x130;stanbul Milletvekili &#x130;skender Bayhan ve 21 Milletvekili </td>
                            </tr>
                             <tr>
                                <td><b>Son Durumu</b></td>
                                <td>G&#xFC;ndemde</td>
                            </tr>
                 
                           
                        </tbody>
                    </table>
               
