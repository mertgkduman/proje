                <a
                    href="https://t.me/share/url?url=https%3A%2F%2Fwww.kayserihaber.com%2Fmahmut-arikan-bugun-kayseride-iste-programi&text=Mahmut+Ar%C4%B1kan+bug%C3%BCn+Kayseri%E2%80%99de%21+%C4%B0%C5%9Fte+saat+saat+program%C4%B1"
                    class="dropdown-item"
