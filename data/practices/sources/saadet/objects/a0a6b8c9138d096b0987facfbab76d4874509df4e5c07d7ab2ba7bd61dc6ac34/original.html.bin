            <a class="col-lg-3 col-sm-6 newsOneLine-box journal-blocks" href="/haberler/chp-genel-merkezine-25-kasim-pankarti-asildi">
                    <picture>
                        <source media="screen and (max-width:415px)" srcset="https://media.chp.org.tr/haberler/2026/11/25/de6abf97-ffd3-4527-a44a-aa1111da4775.jpg?w=400&h=225" />
                        <source media="screen and (max-width:540px)" srcset="https://media.chp.org.tr/haberler/2026/11/25/de6abf97-ffd3-4527-a44a-aa1111da4775.jpg?w=400&h=225" />
