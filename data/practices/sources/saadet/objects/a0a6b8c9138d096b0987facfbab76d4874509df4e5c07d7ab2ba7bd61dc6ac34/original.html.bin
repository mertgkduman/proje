<script>
    $(document).on("click","#live-close",function (){
        $("#live-banner").remove();
        //cookie ye ekleme
        var date = new Date();
        date.setTime(date.getTime() + (10 * 60 * 1000));
        var expires = "expires=" + date.toUTCString();
        document.cookie = "liveStream=true;" + expires;
    });
