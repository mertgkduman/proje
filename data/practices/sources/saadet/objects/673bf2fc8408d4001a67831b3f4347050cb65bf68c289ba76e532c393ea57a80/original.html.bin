    <div class="new-content">
        <!--Common content template-->
            <div class="image-container">
        <div class="images image-gradient-vertical">
                <!-- News Photos -->
                <div class="swiper-container">
                    <div class="swiper-wrapper">
                                <div class="swiper-slide">
                                        <div class="swiper-lazy-preloader"></div>
                                        <img class="img-fluid swiper-lazy" src="/Media/mvybz2es/2026-asgari-&#252;cret.jpeg?anchor=center&amp;mode=crop&amp;width=1920&amp;height=1080&amp;rnd=134110001472330000" alt="2026 Yılında Ge&#231;erli Olacak Yeni Asgari &#220;cret 28 Bin 75 Lira 50 Kuruş Olarak Belirlendi">
