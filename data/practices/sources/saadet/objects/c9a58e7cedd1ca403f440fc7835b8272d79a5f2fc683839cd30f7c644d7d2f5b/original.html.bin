                        <div class="col-6 col-md-3 mb-20">
                          <h4 class="simple-title" style="font-weight: 700; margin-bottom: 12px; font-size: 13px; color: #ffffff; letter-spacing: 0.5px;">MOBİL UYGULAMALAR</h4>
