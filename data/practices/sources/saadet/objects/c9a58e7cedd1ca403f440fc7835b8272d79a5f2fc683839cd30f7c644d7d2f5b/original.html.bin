<!-- Erişilebilirlik Paneli Ana Gövde (Ekran okuyucu bu bölümü tamamen atlar) -->
<div id="ax-panel" class="ax-closed" aria-hidden="true" data-html2canvas-ignore="true">
  
  <div class="ax-header">
    <h2>Erişilebilirlik Menüsü</h2>
    <button type="button" class="ax-close-btn" onclick="toggleAxMenu()">×</button>
  </div>

  <div class="ax-content">
    <!-- AYARLAR BÖLÜMÜ -->
  
<div class="ax-section">
      <div class="ax-section-title">Ayarlar <span class="ax-dots"></span></div>
      <div class="ax-grid-2">
        <button type="button" onclick="axResetAll()">
          <span class="ax-icon">🔄</span>
          <span class="ax-label">Ayarları Temizle</span>
        </button>
        <button type="button" onclick="axToggleBigUI()">
          <span class="ax-icon">⛶</span>
          <span class="ax-label">Büyük Boyutlu Panel</span>
        </button>
        <button type="button" id="btn-ax-shortcuts" onclick="axShowShortcuts()">
          <span class="ax-icon">⌨️</span>
          <span class="ax-label">Kısayollar</span>
        </button>
        <button type="button" onclick="axToggleImages()">
          <span class="ax-icon">👁️‍🗨️</span>
          <span class="ax-label">Resimleri Gizle</span>
        </button>
      </div>

      <div id="ax-shortcuts-info" class="ax-shortcuts-panel">
        <p>Ctrl + Y / Ctrl + y: Erişilebilirlik Menüsünü Açma</p>
        <p>Tab: Butonlar Arasında Gezinme</p>
      </div>
    </div>

    <!-- EKRAN OKUYUCU BÖLÜMÜ -->
    <div class="ax-section">
      <div class="ax-section-title">Ekran Okuyucu <span class="ax-dots"></span></div>
      <div class="ax-screen-reader">
        <div class="ax-sr-controls">
          <button type="button" onclick="axPlaySpeech()" title="Oynat">▶ Oynat</button>
          <button type="button" onclick="axPauseSpeech()" title="Duraklat">⏸ Duraklat</button>
          <button type="button" onclick="axStopSpeech()" title="Sustur">🔄 Sustur</button>
        </div>
        <div class="ax-range-container">
          <label for="ax-speed">Okuma Hızı</label>
          <input type="range" id="ax-speed" min="0.5" max="2" step="0.1" value="1" onchange="axUpdateSpeechRate()" />
        </div>
      </div>
    </div>

    <!-- METNİ HİZALA BÖLÜMÜ -->
    <div class="ax-section">
      <div class="ax-section-title">Metni Hizala <span class="ax-dots"></span></div>
      <div class="ax-grid-3">
        <button type="button" onclick="axSetTextAlign('left')">
          <span class="ax-icon">📋</span>
          <span class="ax-label">Sola Hizala</span>
        </button>
        <button type="button" onclick="axSetTextAlign('center')">
          <span class="ax-icon">📊</span>
          <span class="ax-label">Ortala</span>
        </button>
        <button type="button" onclick="axSetTextAlign('right')">
          <span class="ax-icon">📉</span>
          <span class="ax-label">Sağa Hizala</span>
        </button>
      </div>
    </div>

    <!-- OKUMA ARAÇLARI BÖLÜMÜ -->
    <div class="ax-section">
      <div class="ax-section-title">Okuma Araçları <span class="ax-dots"></span></div>
      <div class="ax-grid-2">
       <button type="button" id="btn-reading-guide" onclick="axToggleReadingGuide()">
    <span class="ax-icon">📖</span>
    <span class="ax-label">Okuma Rehberi</span>
</button>
        <button type="button" id="btn-reading-mask" onclick="axToggleReadingMask()">
          <span class="ax-icon">🔲</span>
          <span class="ax-label">Okuma Maskesi</span>
        </button>
      </div>
    </div>

    <!-- METİN VE BAĞLANTILAR BÖLÜMÜ -->
