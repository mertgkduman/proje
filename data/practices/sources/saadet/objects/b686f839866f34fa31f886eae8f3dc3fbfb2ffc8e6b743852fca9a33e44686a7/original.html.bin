<script>
(function(){
    document.querySelectorAll('.yt-netflix .yt-carousel').forEach(function(el){
        var isDown=false, startX, scrollLeft, hasDragged=false;
        el.addEventListener('mousedown',function(e){
            e.preventDefault();
            isDown=true; hasDragged=false;
            startX=e.pageX; scrollLeft=el.scrollLeft;
        });
        el.addEventListener('mouseleave',function(){ isDown=false; el.classList.remove('yt-dragging'); });
        el.addEventListener('mouseup',function(){ isDown=false; el.classList.remove('yt-dragging'); });
        el.addEventListener('mousemove',function(e){
            if(!isDown) return;
            e.preventDefault();
            var diff=e.pageX-startX;
            if(Math.abs(diff)>5){ hasDragged=true; el.classList.add('yt-dragging'); }
            el.scrollLeft=scrollLeft-diff;
        });
        el.querySelectorAll('.yt-slide').forEach(function(slide){
            slide.addEventListener('click',function(e){
                if(hasDragged){ e.preventDefault(); }
            });
        });
    });
})();
</script>

