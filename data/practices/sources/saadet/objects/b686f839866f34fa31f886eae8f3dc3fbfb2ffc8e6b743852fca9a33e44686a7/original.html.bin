.yt-netflix { background:#fff; border-radius:12px; overflow:hidden; box-shadow:0 1px 6px rgba(0,0,0,.08); }
.yt-netflix .yt-header { padding:14px 20px; display:flex; align-items:center; }
.yt-netflix .yt-header-left { display:flex; align-items:center; gap:8px; flex-grow:1; }
.yt-netflix .yt-logo { width:28px; height:20px; flex-shrink:0; }
.yt-netflix .yt-header-left h2 { color:#0d0d0d; font-size:1rem; font-weight:700; margin:0; }
.yt-netflix .yt-channel-btn { background:#ff0000; color:#fff; padding:7px 20px; border-radius:20px; font-size:.78rem; font-weight:600; text-decoration:none; display:inline-flex; align-items:center; gap:6px; transition:background .2s; }
.yt-netflix .yt-channel-btn:hover { background:#d90000; color:#fff; }
.yt-netflix .yt-carousel-wrap { padding:16px 20px 20px; overflow:hidden; }
.yt-netflix .yt-carousel { display:flex; gap:14px; overflow-x:auto; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; scrollbar-width:none; padding:4px 0; cursor:grab; }
.yt-netflix .yt-carousel.yt-dragging { cursor:grabbing; scroll-snap-type:none; }
.yt-netflix .yt-carousel.yt-dragging .yt-slide { user-select:none; }
.yt-netflix .yt-carousel::-webkit-scrollbar { display:none; }
.yt-netflix .yt-slide { flex:0 0 280px; scroll-snap-align:start; position:relative; border-radius:10px; overflow:hidden; transition:transform .3s, box-shadow .3s; }
.yt-netflix .yt-slide:hover { transform:scale(1.05); box-shadow:0 8px 30px rgba(0,0,0,.15); z-index:2; }
.yt-netflix .yt-slide img { width:100%; height:auto; aspect-ratio:16/9; object-fit:cover; display:block; }
.yt-netflix .yt-play { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:56px; height:40px; background:#ff0000; border-radius:10px; display:flex; align-items:center; justify-content:center; z-index:2; opacity:0; transition:opacity .25s; }
.yt-netflix .yt-slide:hover .yt-play { opacity:1; }
.yt-netflix .yt-play i { color:#fff; font-size:17px; margin-left:3px; }
.yt-netflix .yt-slide-info { position:absolute; bottom:0; left:0; right:0; padding:24px 12px 10px; background:linear-gradient(transparent, rgba(0,0,0,.85)); }
.yt-netflix .yt-slide-title { color:#fff; font-size:.82rem; font-weight:500; line-height:1.35; margin:0; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.yt-netflix .yt-slide-num { position:absolute; top:8px; left:10px; background:#ff0000; color:#fff; font-size:.65rem; font-weight:700; width:22px; height:22px; border-radius:50%; display:flex; align-items:center; justify-content:center; z-index:2; }
@media (max-width:991px) {
    .yt-netflix .yt-slide { flex:0 0 250px; }
}
@media (max-width:575px) {
    .yt-netflix .yt-header { padding:10px 12px; }
    .yt-netflix .yt-channel-btn { padding:5px 12px; font-size:.72rem; }
    .yt-netflix .yt-carousel-wrap { padding:12px 12px 14px; }
    .yt-netflix .yt-slide { flex:0 0 220px; }
    .yt-netflix .yt-play { width:44px; height:32px; }
    .yt-netflix .yt-play i { font-size:14px; }
    .yt-netflix .yt-slide-title { font-size:.75rem; }
}
[data-theme="dark"] .yt-netflix { background:var(--color-surface-secondary, #1e293b); box-shadow:0 1px 6px rgba(0,0,0,.2); }
[data-theme="dark"] .yt-netflix .yt-header { border-bottom-color:var(--color-border-default, #334155); }
[data-theme="dark"] .yt-netflix .yt-header-left h2 { color:#fff; }
[data-theme="dark"] .yt-netflix .yt-slide:hover { box-shadow:0 8px 30px rgba(0,0,0,.5); }
