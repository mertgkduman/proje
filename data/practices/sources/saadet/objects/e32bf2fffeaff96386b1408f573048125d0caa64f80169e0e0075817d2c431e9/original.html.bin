#eg-adli-dosyalar .eg-dosya-card{background:#fff;min-width:0;height:190px;border:1px solid #e1e5e8;padding:14px 16px;display:flex;flex-direction:column;overflow:hidden}
#eg-adli-dosyalar .eg-dosya-meta{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11px;line-height:18px;margin:0 0 9px;color:#666}
#eg-adli-dosyalar .eg-dosya-category{color:#b71c1c;font-weight:800;text-transform:uppercase;letter-spacing:.25px}
#eg-adli-dosyalar h3{font-size:19px;line-height:1.22;font-weight:800;margin:0 0 8px;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
#eg-adli-dosyalar h3 a{color:#222;text-decoration:none}
#eg-adli-dosyalar h3 a:hover{color:#bd2025}
#eg-adli-dosyalar .eg-dosya-summary{font-size:14px;line-height:1.4;color:#53585e;margin:0 0 9px;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
#eg-adli-dosyalar .eg-dosya-source{margin-top:auto;padding-top:8px;border-top:1px solid #eff0f2;display:flex;justify-content:space-between;gap:8px;align-items:center;font-size:11px;line-height:1.3;color:#666}
#eg-adli-dosyalar .eg-dosya-source span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
#eg-adli-dosyalar .eg-dosya-source a{flex-shrink:0;color:#333;text-decoration:underline;text-underline-offset:3px}
#eg-adli-dosyalar a:focus-visible,#eg-adli-dosyalar button:focus-visible{outline:3px solid #bc2328;outline-offset:3px}
#eg-adli-dosyalar .eg-dosya-more{display:block;margin:18px auto 0;background:#fff;border:1px solid #aeb4b9;color:#222;font-family:inherit;font-size:14px;font-weight:700;padding:10px 22px;cursor:pointer;max-width:100%}
#eg-adli-dosyalar .eg-dosya-more:hover{background:#f6f6f6;border-color:#444}
#eg-adli-dosyalar .eg-dosya-status{font-size:12px;line-height:1.5;color:#60656b;text-align:center;margin:10px 0 0}
#eg-adli-dosyalar [hidden]{display:none!important}
@media(max-width:991px){#eg-adli-dosyalar .eg-dosya-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:575px){#eg-adli-dosyalar .eg-dosya-grid{grid-template-columns:minmax(0,1fr);gap:10px}#eg-adli-dosyalar .eg-dosya-card{height:184px;padding:13px 14px}#eg-adli-dosyalar h2{font-size:22px}#eg-adli-dosyalar h3{font-size:18px}#eg-adli-dosyalar .eg-dosya-heading{align-items:flex-start}}
</style>
<script>
(function(){
'use strict';
function init(){
if(location.pathname!=='/'||document.getElementById('eg-adli-dosyalar'))return;
var host=document.querySelector('main > .container');if(!host)return;
var data=[{"date":"2026-11-20","category":"Narkotik soruşturması","title":"33 ilde jandarma operasyonu: 159 tutuklama","summary":"İçişleri Bakanlığının 20 Kasım açıklamasına göre 254 şüpheliden 159’u tutuklandı, 95’i hakkında adli kontrol uygulandı. Operasyonlarda 504 kilogram uyuşturucu ve 104 bin 56 hap ele geçirildi.","source":"İçişleri Bakanlığı","url":"https://x.com/TC_icisleri/status/2123687214013936126","id":"eg-dosya-20261120-narkotik-33il"}];
var section=document.createElement('section');section.id='eg-adli-dosyalar';section.setAttribute('aria-labelledby','eg-dosya-title');section.dataset.version='2026-11-21-v1';
var heading=document.createElement('div');heading.className='eg-dosya-heading';var intro=document.createElement('div');
var title=document.createElement('h2');title.id='eg-dosya-title';title.textContent='Yolsuzluk ve organize suç dosyaları';
var subtitle=document.createElement('p');subtitle.className='eg-dosya-subtitle';subtitle.textContent='Jandarma operasyonları • 20 Kasım 2026 açıklaması';intro.append(title,subtitle);heading.append(intro);
var grid=document.createElement('div');grid.className='eg-dosya-grid';var more=document.createElement('button');more.type='button';more.className='eg-dosya-more';more.textContent='Daha fazla haber';
var status=document.createElement('p');status.className='eg-dosya-status';status.setAttribute('aria-live','polite');status.setAttribute('aria-atomic','true');section.append(heading,grid,more,status);host.append(section);
var count=0,observer=null;
function link(d,label){var a=document.createElement('a');a.href=d.url;a.target='_blank';a.rel='noopener noreferrer';a.textContent=label;return a;}
function appendBatch(){var end=Math.min(count+6,data.length),fragment=document.createDocumentFragment();for(;count<end;count++){
var d=data[count],card=document.createElement('article');card.className='eg-dosya-card';card.id=d.id;
var meta=document.createElement('div');meta.className='eg-dosya-meta';var category=document.createElement('span');category.className='eg-dosya-category';category.textContent=d.category;
var time=document.createElement('time');time.dateTime=d.date;time.textContent=d.date.split('-').reverse().join('.');meta.append(category,time);
var h3=document.createElement('h3');var mainlink=link(d,d.title);mainlink.title=d.title+' — Kaynak: '+d.source+' (yeni sekmede açılır)';h3.append(mainlink);
var summary=document.createElement('p');summary.className='eg-dosya-summary';summary.textContent=d.summary;
var source=document.createElement('div');source.className='eg-dosya-source';var name=document.createElement('span');name.textContent='Kaynak: '+d.source;name.title=d.source;
var read=link(d,'Haberi oku ↗');read.setAttribute('aria-label',d.title+' — kaynağında oku (yeni sekme)');source.append(name,read);card.append(meta,h3,summary,source);fragment.append(card);}
grid.append(fragment);section.dataset.loaded=String(count);status.textContent=count+' / '+data.length+' haber';if(count>=data.length){more.hidden=true;if(observer)observer.disconnect();}else if(observer){requestAnimationFrame(function(){var r=more.getBoundingClientRect();if(r.top<innerHeight+180&&r.bottom>0)appendBatch();});}}
more.addEventListener('click',appendBatch);appendBatch();if('IntersectionObserver'in window){observer=new IntersectionObserver(function(entries){if(entries.some(function(e){return e.isIntersecting;})&&count<data.length)appendBatch();},{rootMargin:'0px 0px 180px 0px',threshold:0});observer.observe(more);}}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
})();
</script></div>

    
