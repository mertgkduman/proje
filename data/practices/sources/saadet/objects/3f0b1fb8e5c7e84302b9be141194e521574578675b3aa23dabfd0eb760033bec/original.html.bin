                    href="https://t.me/share/url?url=https%3A%2F%2Fwww.tv5.com.tr%2Fmahmut-arikan-anayasa-yeni-donemin-siyasi-kapisi-yapilmak-isteniyor&text=Mahmut+Ar%C4%B1kan%3A+%E2%80%9CAnayasa%2C+yeni+d%C3%B6nemin+siyasi+kap%C4%B1s%C4%B1+yap%C4%B1lmak+isteniyor%E2%80%9D"
                    class="dropdown-item"
                    onclick="initiateDesktopShare(event, 'telegram')"
                    data-platform="telegram"
                    data-share-url="https://www.tv5.com.tr/mahmut-arikan-anayasa-yeni-donemin-siyasi-kapisi-yapilmak-isteniyor"
                    data-share-title="Mahmut Arıkan: “Anayasa, yeni dönemin siyasi kapısı yapılmak isteniyor”"
                    rel="noreferrer nofollow noopener external"
                    title="Telegram"
                >
                    <i class="fab fa-telegram-plane text-primary me-2"></i>Telegram
                </a>
