      <div class="entry-content" data-io-article-url="https://www.indyturk.com/node/771988/siyaset/saadet-partisi-genel-ba%C5%9Fkan%C4%B1-ar%C4%B1kan-2027%E2%80%99de-se%C3%A7imlerin-yap%C4%B1laca%C4%9F%C4%B1n%C4%B1-d%C3%BC%C5%9F%C3%BCn%C3%BCyorum">
        <script>
          if (isMobileDevice()) {
            document.write("<div class='block-wrapper'><div class='premium-content'><div id='div-gpt-ad-3341368-3'></div></div></div>");
