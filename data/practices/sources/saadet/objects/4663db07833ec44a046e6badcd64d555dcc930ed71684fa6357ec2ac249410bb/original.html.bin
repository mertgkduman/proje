w({ behavior: 'smooth', block: 'center' }); return true; } window.abcAddComment = function (form, type, postId) { var btn = q('.comment_submit', form); if (form.__abcBusy) { return false; } form.__abcBusy = true; if (btn) { btn.disabled = true; } var base = (typeof BURL !== 'undefined' && BURL) ? BURL : '/'; var body = new URLSearchParams(new FormData(form)).toString(); fetch(base + 'x_comment_add.php?type=' + encodeURIComponent(type) + '&id=' + encodeURIComponent(postId), { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' }, body: body }).then(function (r) { return r.json(); }).then(function (res) { var msg = (res && res.message && res.message.length) ? res.message.join(' ') : 'Beklenmeyen bir yanıt alındı.'; if (res && res.result) { var pending = !res.approved; var ta = q('textarea[name="comment_content"]', form); var nameEl = q('input[name="member_name"]', form); addToList(postId, res.comment || { member_name: nameEl ? nameEl.value : '', comment_content: ta ? ta.value : '', formatted_date: '' }, pending); setMsg(form, msg, pending ? 'warning' : 'success'); if (ta) { ta.value = ''; } /* basarida temizle */ var rt = q('.reply_to', form); if (rt) { rt.innerHTML = ''; } var rp = q('input[name="reply"]', form); if (rp) { rp.value = '0'; } } else { /* HATA: mesaji goster, KULLANICININ YAZDIGINI KORU */ setMsg(form, msg, 'warning'); } refreshCaptcha(form, postId); }).catch(function (err) { setMsg(form, 'Yorum gönderilemedi. Lütfen tekrar deneyin.', 'danger'); refreshCaptcha(form, postId); if (window.console) { console.error('abcAddComment', err); } }).then(function () { form.__abcBusy = false; if (btn) { btn.disabled = false; } }); return false; }; /* Eski cagiranlar icin: paket yuklendikten sonra da bizi isaret etsin */ function abcInstall() { window.addComment = window.abcAddComment; } abcInstall(); document.addEventListener('DOMContentLoaded', abcInstall); window.addEventListener('load', abcInstall); /* Guvenlik kodu gorseline tiklayinca yenile */ document.addEventListener('click', function (e) { var t = e.target; if (t && t.classList && t.classList.contains('guvenlik_image')) { t.src = '/inc/image.php?p=' + (t.getAttribute('data-p') || '') + '&t=' + Date.now(); } }); })();</script><style>.comment_add .mesaj{display:none} .comment_add .mesaj.alert-success{display:block;margin-bottom:10px;background:#e6f6ea;border:1px solid #b7e3c3;color:#1b6b32;padding:9px 12px;border-radius:6px} .comment_add .mesaj.alert-warning{display:block;margin-bottom:10px;background:#fff8e1;border:1px solid #f2e2b5;color:#8a6100;padding:9px 12px;border-radius:6px} .comment_add .mesaj.alert-danger{display:block;margin-bottom:10px;background:#fdecea;border:1px solid #f5c2c0;color:#a32019;padding:9px 12px;border-radius:6px} .comments li.abc-pending{opacity:.85;border-left:3px solid #e0a800;padding-left:10px} .abc-pending-badge{display:inline-block;margin-top:6px;background:#fff3cd;color:#8a6100;border:1px solid #f2e2b5;border-radius:4px;padding:2px 8px;font-size:11.5px}</style> <div class="comments cm-comment" id="comments-467541" data-id="467541" data-type="1" data-list="6" style="display:none"> <div class="caption"><i class="icon-chat-1"></i><span>(0) Yorum</span> </div> </div></section><div id="fb-comments-467541" class="fb-comments" data-href="https://abcgazetesi.com.tr/karamollaoglundan-aciklama-bizler-milletimize-verdigimiz-sozun-arkasindayiz-467541" data-width="100%" data-numposts="5" data-colorscheme="light"></div><div class="benzericerik"> <span class="title"><i></i> İLGİNİZİ ÇEKEBİLİR</span><div class="row"> <div class="col-12 col-sm-6 col-lg-3"> <div class="post-item"> <a href="/gundem/halk-tvden-ayrilan-gazeteciler-yeni-kanali-kurdu-halk-televizyonu-yayina-basladi-878212"> <div class=""> <img class="lazy" loading="lazy" data-src="https://abcgazetesi.com.tr/d/news/567742.jpg" alt="Halk TV&#039;den ayrılan gazeteciler yeni kanalı kurdu! &#039;Halk Televizyonu&#039; yayına baş