    <div
    data-cookie-consent
    hidden
    role="dialog"
    aria-label="Çerez tercihleri"
    aria-live="polite"
    data-no-print
    class="fixed inset-x-0 bottom-0 z-[70] border-t-2 border-brand-500 bg-white shadow-float"
>
    <div class="mx-auto flex max-w-[86rem] flex-col gap-4 px-5 py-4 lg:flex-row lg:items-center lg:px-8">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
            <svg class="size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/>
</svg>        </span>

        <div class="flex-1 text-sm text-ink-600">
            <p class="font-semibold text-navy-800">Çerez Politikası</p>
            <p class="mt-1 leading-relaxed">
                Sitemizin çalışması için zorunlu çerezleri kullanıyoruz. Deneyiminizi iyileştirmek amacıyla kullandığımız
                isteğe bağlı çerezleri kabul edebilir veya reddedebilirsiniz.
                                    <a href="https://www.turkegitimsen.org.tr/sayfa/cerez-politikasi" class="font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 hover:decoration-brand-600">
                        Ayrıntılı bilgi
                    </a>
                            </p>
        </div>

        <div class="flex shrink-0 flex-wrap gap-2">
            <button
                type="button"
                data-cookie-reject
                class="rounded-md border border-ink-200 px-5 py-2.5 text-sm font-semibold text-ink-600 transition hover:border-ink-300 hover:text-navy-800"
            >
                Reddet
            </button>
            <button
                type="button"
                data-cookie-accept
                class="rounded-md bg-brand-500 px-6 py-2.5 text-sm font-bold text-white transition hover:bg-brand-600"
            >
                Kabul Et
            </button>
        </div>
    </div>
</div>

    
