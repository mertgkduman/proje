</svg>
        <input
            data-command-input
            type="search"
            name="q"
            autocomplete="off"
            placeholder="Haber, duyuru, mevzuat veya belge ara…"
            aria-label="Arama terimi"
            class="w-full border-0 bg-transparent py-4 text-[15px] text-ink-900 placeholder:text-ink-400 focus:outline-none"
        >

        <span data-command-spinner hidden class="shrink-0 text-ink-400">
            <svg class="size-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true" data-slot="icon">
