                <div class="col-3">
                    <input type="button" id="kaydet" class="btn btn-success" value="Kaydet" />
                </div>
                <div class="col-9 text-right">
                    <span class="text-primary">Farklı olanı seçin:</span>
                    <div class="secim btn-group">
                        <a class="btn btn-secondary">#</a>
