<style>
    #modalreklam_panel .baslik4 {
        font-size: 25pt;
    }
</style>



    </form>

    <script type="text/javascript">
        $(function () {

            $('#modalreklam_panel').modal({
                keyboard: true
            })
            function resize() {
                $('.haberresim').each(function () {
                    y = $(this).width() / 1.77;
                    $(this).height(y);
                });

                $('.otofont-1').each(function () {
                    var u = $(this).width();
                    u = Math.round(u / 40) + 7;
                    $(this).css("font-size", u + "pt");
                    $(this).css("line-height", u * 1.3 + "pt");
                    //console.log($(this).attr('id') + "-" + u);
                });

                $('.otofont-2').each(function () {
                    var u = $(this).width();
                    u = Math.round(u / 120) + 7;
                    $(this).css("font-size", u + "pt");
                    $(this).css("line-height", u * 1.2 + "pt");

                });
            }

            $(window).resize(function () {
                resize();
            });

            $(".dugmeli_slide").slick({
                autoplay: true,
                dots: true,
                infinite: true
            });

            $('.numarali_dugmeli_slide').on('init', function (event, slick) {
                var sl = $(this);
                genislik = 100 / sl.find(".slick-dots li").length;
                sl.find(".slick-dots li").css({ "width": genislik + '%' });
                sl.find(".slick-dots li").mousemove(function () {
                    sl.slick('goTo', $(this).index());
                });
            });

            $(".numarali_dugmeli_slide").slick({
                autoplay: true,
                dots: true,
                customPaging: function (slider, i) {
                    var thumb = $(slider.$slides[i]).data();
                    return '<a>' + (i + 1) + '</a>';
                },
                slidesToShow: 1,
                slidesToScroll: 1
            });

            $(".gazeteler_slide").slick({
                autoplay: true,
                dots: true,
                infinite: true,
                slidesToShow: 5,
                slidesToScroll: 5
            });

            $(".cizgilerindili").slick({
                utoplay: true,
                dots: true,
                infinite: true,
                slidesToShow: 1,
                slidesToScroll: 1
            });


            //Haber Liste
            $('.haberliste').each(function () {
                //Listedeki tüm resimler gizlenip ilk resim gösterliyor.
                $(this).find(".haberresim").hide();
                $(this).find(".haberresim:eq(0)").show();
            })
            $('.haberliste .list-group a').mouseover(function () {
                var ul = $(this).closest("ul");
                var sira = $(ul).find("a").index($(this));
                $(ul).find(".haberresim").hide();
                $(ul).find('.haberresim:eq(' + sira + ')').show();
                /*$a = $(this).closest(".haberliste");
                $a.find(".link").hide();
                i = $a.find(".list-group a").index(this);
                $a.find('.link:eq(' + i + ')').show();*/
            });

            resize();

            $('.splash').hide();
        });

    </script>

</body>
</html>
