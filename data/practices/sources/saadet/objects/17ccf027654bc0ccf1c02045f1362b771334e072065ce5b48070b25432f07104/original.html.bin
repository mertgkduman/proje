                        <a class="btn btn-secondary">#</a>
                    </div>


                    <input type="hidden" name="ctl21$karakter_secim" id="karakter_secim" />
                    <input type="hidden" name="ctl21$kontrol_kod" id="kontrol_kod" />
                    <input type="hidden" name="ctl21$id" id="id" value="118717" />
                    <input type="hidden" name="ctl21$tur" id="tur" value="1" />
                </div>
            </div>

        </div>
        <div class="card-footer" id="mesaj">
            <div class="alert alert-success" role="alert"></div>
        </div>
    </div>
    <div id="yorumlar">
        
    </div>

				</div>

<script type="text/javascript">
    $("#mesaj").hide();

    function kodYerlestir(kod) {
        $(".secim a").remove();
        $("#kontrol_kod").val(kod.substring(0, 28));
        $(".secim").html(kod.substring(28));
        $('.secim a').on("click", function () {
            $("#mesaj").hide();
            $(".secim").css({ "border": "1px solid transparent" });
            $('.secim a').removeClass('btn-info btn-warning');
            $('.secim a').addClass('btn-warning');

            $(this).removeClass('btn-warning');
            $(this).addClass('btn-info');
            $("#karakter_secim").val($(this).index(".secim a"));
        })
    }

    $.ajax({
        url: '/moduller/metodlar.asmx/KodGetir',
        dataType: 'json',
        type: 'POST',
        contentType: 'application/json; charset=utf-8',
        success: function (data) {
            kodYerlestir(data.d)
        }
    })

    function mesaj(mesaj, durum) {
        $('#mesaj').show();
        $('#mesaj div').removeClass('alert-success alert-danger');
        if (durum == 1) $('#mesaj div').addClass("alert-success");
        else $('#mesaj div').addClass("alert-danger")
        $("#mesaj div").html(mesaj);
    }

    $("#kaydet").click(function () {
        var a = $(".secim a").hasClass("btn-info");
        if (!a) {
            mesaj("Mesaj gönderebilmek için farklı olan karakteri seçin.", 2);
            $(".secim").css({ "border": "1px solid red" });
        } else if ($("#yorum_ad").val() == "") {
            mesaj("Yorum için adınızı girin.", 2);
            $("#yorum_ad").focus();
        } else if ($("#yorum_metin").val() == "") {
            mesaj("mesaj", "Yorumunuzu girin.", 2);
            $("#yorum_metin").focus();
        }
        else {
            $.ajax({
                url: '/moduller/metodlar.asmx/YorumKaydet',
                dataType: 'json',
                type: 'POST',
                data: JSON.stringify({
                    'Ad': $("#yorum_ad").val(),
                    'Metin': $("#yorum_metin").val(),
                    'Tur': $("#tur").val(),
                    'Id': $("#id").val(),
                    'Secim': $("#karakter_secim").val(),
                    'Kontrol': $("#kontrol_kod").val()
                }),
                contentType: 'application/json; charset=utf-8',
                success: function (data) {
                    if (data.d == "Başarılı") {
                        mesaj("Yorumunuz alındı. Onaylandıktan sonra yayınlanacaktır.", 1);
                        $("#yorum_ad").val("");
                        $("#yorum_metin").val("");
                        $(".secim").css({ "border": "1px solid transparent" });
                        $('.secim a').removeClass('btn-info btn-warning');
                        $('.secim a').addClass('btn-warning');
                        $("#karakter_secim").val("");
                    } else {
                        mesaj("Farklı karakter seçimini tekrar deneyiniz.", 2);
                        kodYerlestir(data.d)
                    }
                }
            })
        }
    })

    /*getir(1);
    function getir() {
        $.ajax({
            contentType: "text/html; charset=utf-8",
