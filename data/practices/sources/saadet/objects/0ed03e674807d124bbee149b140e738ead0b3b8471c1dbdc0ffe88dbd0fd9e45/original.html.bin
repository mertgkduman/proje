<script type="text/javascript">
    jQuery(document).ready(function() {
        App.init();
        });
		
function getSize() {
  size = $( "#icerikVerisi" ).css( "font-size" );
  size = parseInt(size, 10);
  $( "#font-size" ).text(  size  );
}


getSize();

$( "#up" ).on( "click", function() {

$( "#font-size" ).show();
  if ((size + 2) <= 50) {
    $( "#icerikVerisi" ).css( "font-size", "+=2" );
	var sizenew = size += 2;
    $( "#font-size" ).text( sizenew+" Punto" );
  }
});

$( "#down" ).on( "click", function() {
$( "#font-size" ).show();	
  if ((size - 2) >= 12) {
    $( "#icerikVerisi" ).css( "font-size", "-=2" );
	var sizenew = size -= 2;
    $( "#font-size" ).text(sizenew+" Punto");
  }
});		
</script>
