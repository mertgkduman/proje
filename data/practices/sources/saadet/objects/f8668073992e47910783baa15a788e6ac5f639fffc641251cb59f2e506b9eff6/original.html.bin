  (function () {
    function moveBlock() {
        const sorumluYim = document.getElementById('bik-kunye-sorumlu-yim');
        if (!sorumluYim) return;

        const targetBlock = sorumluYim.closest('.my-3');
        if (!targetBlock) return;

        // milligazete.com.tr Sorumlusu bloğunu h4 metnine göre bul
        const blocks = document.querySelectorAll('#bik-kunye-main .my-3');
        let milliBlock = null;
        blocks.forEach(block => {
            const h4 = block.querySelector('h4');
            if (h4 && h4.textContent.trim() === 'milligazete.com.tr Sorumlusu') {
                milliBlock = block;
            }
        });

        if (!milliBlock || milliBlock === targetBlock) return;

        targetBlock.parentNode.insertBefore(milliBlock, targetBlock);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', moveBlock);
    } else {
        moveBlock();
    }
})();
  </script>
