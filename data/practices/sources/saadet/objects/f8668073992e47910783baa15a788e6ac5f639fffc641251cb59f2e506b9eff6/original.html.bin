<script>
(function () {
    function cleanPath() {
        return window.location.pathname.replace(/\/+$/, '') || '/';
    }

    function norm(s) {
        return (s || '').trim().replace(/\s+/g, ' ').toLocaleLowerCase('tr');
    }

    // "Daha fazla göster" butonlarını kaldırır (sınıf veya metin eşleşmesiyle)
    function removeMoreButtons(root) {
        root = root || document;

        root.querySelectorAll('.btn-more').forEach(function (btn) {
            btn.remove();
        });

        root.querySelectorAll('a, button').forEach(function (el) {
            if (norm(el.textContent) === 'daha fazla göster') {
                el.remove();
            }
        });
    }

    function run() {
        var path = cleanPath();

        // 1) /bilgi-rehberi → "daha fazla" butonunu kaldır
        if (path === '/bilgi-rehberi') {
            document.querySelectorAll('.btn-more[data-url="/service/json/pagination.json"]').forEach(function (btn) {
                btn.remove();
            });
        }

        // 2) /arsiv (ve /arsiv/...) → "Bilgi rehberi" bölümünü kaldır
        if (path === '/arsiv' || path.indexOf('/arsiv/') === 0) {
            document.querySelectorAll('h3').forEach(function (h3) {
                if (norm(h3.textContent) !== 'bilgi rehberi') return;

                var el = h3.nextElementSibling;
                while (el && el.tagName !== 'H3') {
                    var next = el.nextElementSibling;
                    el.remove();
                    el = next;
                }
                h3.remove();
            });
        }

        // 3) /muhabir/... (ör. /muhabir/72640/haber-servisi) → "DAHA FAZLA GÖSTER" kaldır
        if (path.indexOf('/muhabir/') === 0) {
            removeMoreButtons();
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
    } else {
        run();
    }

    // İçerik sonradan AJAX ile gelirse tekrar temizle
    var timer;
    new MutationObserver(function () {
        clearTimeout(timer);
        timer = setTimeout(run, 50);
    }).observe(document.documentElement, { childList: true, subtree: true });
})();
