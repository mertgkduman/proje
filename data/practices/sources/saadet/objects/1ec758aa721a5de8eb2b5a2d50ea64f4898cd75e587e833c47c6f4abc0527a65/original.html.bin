                            </span>

            <button class="js-cookie-consent-agree cookie-consent__agree" style="background-color: #000 !important; color: #fff !important; border: 1px solid #fff !important;">
                Tamam
            </button>
        </div>
    </div>
    <div data-site-cookie-name="te_cookie_consent"></div>
    <div data-site-cookie-lifetime="7300"></div>
    <div data-site-cookie-domain="www.bursasaati.com.tr"></div>
    <div data-site-session-secure=";secure"></div>

    
    <script>
        (function () {
            function init() {
                if (typeof window.jQuery === 'undefined') { return; }
                var $ = window.jQuery;
                var COOKIE_VALUE    = 1;
                var COOKIE_NAME     = $('div[data-site-cookie-name]').data('site-cookie-name');
                var COOKIE_DOMAIN   = $('div[data-site-cookie-domain]').data('site-cookie-domain');
                var COOKIE_LIFETIME = $('div[data-site-cookie-lifetime]').data('site-cookie-lifetime');
                var SESSION_SECURE  = $('div[data-site-session-secure]').data('site-session-secure') || '';

                function cookieExists(name) {
                    return document.cookie.split('; ').indexOf(name + '=' + COOKIE_VALUE) !== -1;
                }
                function showDialog() {
                    $('.js-cookie-consent').removeClass('is-hidden').each(function () {
                        this.style.setProperty('display', 'block', 'important');
                    });
                }
                function hideDialog() {
                    $('.js-cookie-consent').addClass('is-hidden').each(function () {
                        this.style.setProperty('display', 'none', 'important');
                    });
                }
                function setCookie() {
                    var date = new Date();
                    date.setTime(date.getTime() + (COOKIE_LIFETIME * 24 * 60 * 60 * 1000));
                    document.cookie = COOKIE_NAME + '=' + COOKIE_VALUE
                        + ';expires=' + date.toUTCString()
                        + ';domain=' + COOKIE_DOMAIN
                        + ';path=/' + SESSION_SECURE;
                }

                if (cookieExists(COOKIE_NAME)) { hideDialog(); } else { showDialog(); }

                $(document).on('click', '.js-cookie-consent-agree', function () {
                    setCookie();
                    hideDialog();
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>





    <div data-pagespeed="true"><script>
(function () {
    var TARGET_AD_IDS = [
        'ad_150',
        'ad_150_mobile',
        'ad_152',
        'ad_152_mobile'
    ];

    /*
     * Bazı alanlarda dış div ölçüsü yanlış basılırsa burada ezebiliriz.
     * Örnek: ad_150_mobile dışarıda 300x100 görünüp içeride 300x250 reklam varsa.
     */
    var MANUAL_FALLBACK_SIZES = {
        ad_150_mobile: {
            width: 300,
            height: 250
        }
    };

    function toNumber(value) {
        if (!value) return 0;

        value = String(value).trim();

        if (value.indexOf('%') !== -1) return 0;

        value = value.replace('px', '').trim();

        var number = parseFloat(value);

        return isNaN(number) ? 0 : number;
    }

    function setImportant(el, prop, value) {
        if (!el) return;
        el.style.setProperty(prop, value, 'important');
    }

    function getElementSizeValue(el, prop) {
        if (!el) return 0;

        return (
            toNumber(el.getAttribute(prop)) ||
            toNumber(el.style[prop])
        );
    }

    function getUrlNumber(url, key) {
        try {
            var parsed = new URL(url, window.location.href);
            return toNumber(parsed.searchParams.get(key));
        } catch (e) {
            return 0;
        }
    }

    function getIframeImageSize(iframe) {
        try {
            var doc = iframe.contentDocument || iframe.contentWindow.document;

            if (!doc) return null;

            var img = doc.querySelector('img');

            if (!img) return null;

            var width =
                toNumber(img.getAttribute('width')) ||
                toNumber(img.style.width) ||
                img.naturalWidth ||
                img.offsetWidth;

            var height =
                toNumber(img.getAttribute('height')) ||
                toNumber(img.style.height) ||
                img.naturalHeight ||
                img.offsetHeight;

            if (width && height) {
                return {
                    width: width,
                    height: height
                };
            }
        } catch (e) {
            return null;
        }

        return null;
    }

    function getAdSize(ad, iframe) {
        /*
         * 1. Manuel tanım varsa öncelik bunun.
         * Çünkü bazı alanlarda data-height yanlış basılıyor.
         */
        if (MANUAL_FALLBACK_SIZES[ad.id]) {
            return MANUAL_FALLBACK_SIZES[ad.id];
        }

        /*
         * 2. iframe içindeki gerçek görsel ölçüsü okunabiliyorsa onu kullan.
         */
        if (iframe) {
            var realImageSize = getIframeImageSize(iframe);

            if (realImageSize) {
                return realImageSize;
            }
        }

        /*
         * 3. Reklam alanındaki data-width / data-height.
         */
        var dataWidth = toNumber(ad.getAttribute('data-width'));
        var dataHeight = toNumber(ad.getAttribute('data-height'));

        if (dataWidth && dataHeight) {
            return {
                width: dataWidth,
                height: dataHeight
            };
        }

        /*
         * 4. iframe URL içindeki w / h parametreleri.
         */
        if (iframe) {
            var urlWidth =
                getUrlNumber(iframe.src, 'w') ||
                getUrlNumber(iframe.src, 'width');

            var urlHeight =
                getUrlNumber(iframe.src, 'h') ||
                getUrlNumber(iframe.src, 'height');

            var iframeWidth =
                getElementSizeValue(iframe, 'width') ||
                urlWidth;

            var iframeHeight =
                getElementSizeValue(iframe, 'height') ||
                urlHeight;

            if (urlWidth && iframeHeight) {
                return {
                    width: urlWidth,
                    height: iframeHeight
                };
            }

            if (iframeWidth && iframeHeight) {
                return {
                    width: iframeWidth,
                    height: iframeHeight
                };
            }
        }

        /*
         * 5. Dış div style width / height.
         */
        var adWidth = getElementSizeValue(ad, 'width');
        var adHeight = getElementSizeValue(ad, 'height');

        if (adWidth && adHeight) {
            return {
                width: adWidth,
                height: adHeight
            };
        }

        return null;
    }

    function getAvailableWidth(ad, baseWidth) {
        var parent = ad.parentElement;
        var parentWidth = parent ? parent.clientWidth : window.innerWidth;
        var viewportWidth = window.innerWidth - 20;

        return Math.min(baseWidth, parentWidth, viewportWidth);
    }

    function resizeAd(ad) {
        if (!ad) return;

        var computed = window.getComputedStyle(ad);

        if (computed.display === 'none') {
            return;
        }

        var iframe = ad.querySelector('iframe');
        var size = getAdSize(ad, iframe);

        if (!size || !size.width || !size.height) {
            return;
        }

        var baseWidth = size.width;
        var baseHeight = size.height;

        var finalWidth = getAvailableWidth(ad, baseWidth);

        if (!finalWidth) return;

        var finalHeight = Math.round(finalWidth * baseHeight / baseWidth);

        setImportant(ad, 'box-sizing', 'border-box');
        setImportant(ad, 'width', finalWidth + 'px');
        setImportant(ad, 'max-width', baseWidth + 'px');
        setImportant(ad, 'height', finalHeight + 'px');
        setImportant(ad, 'min-height', '0');
        setImportant(ad, 'max-height', 'none');
        setImportant(ad, 'overflow', 'visible');
        setImportant(ad, 'margin-left', 'auto');
        setImportant(ad, 'margin-right', 'auto');
        setImportant(ad, 'text-align', 'center');
        setImportant(ad, 'justify-content', 'center');
        setImportant(ad, 'align-items', 'center');

        var rendered = ad.querySelector('.ad-rendered');

        if (rendered) {
            setImportant(rendered, 'box-sizing', 'border-box');
            setImportant(rendered, 'width', finalWidth + 'px');
            setImportant(rendered, 'max-width', baseWidth + 'px');
            setImportant(rendered, 'height', finalHeight + 'px');
            setImportant(rendered, 'min-height', '0');
            setImportant(rendered, 'max-height', 'none');
            setImportant(rendered, 'overflow', 'visible');
            setImportant(rendered, 'margin-left', 'auto');
            setImportant(rendered, 'margin-right', 'auto');
            setImportant(rendered, 'text-align', 'center');
        }

        if (iframe) {
            setImportant(iframe, 'box-sizing', 'border-box');
            setImportant(iframe, 'display', 'block');
            setImportant(iframe, 'width', finalWidth + 'px');
            setImportant(iframe, 'max-width', '100%');
            setImportant(iframe, 'height', finalHeight + 'px');
            setImportant(iframe, 'border', '0');
            setImportant(iframe, 'overflow', 'hidden');
            setImportant(iframe, 'margin-left', 'auto');
            setImportant(iframe, 'margin-right', 'auto');
        }

        ad.querySelectorAll(':scope > img, .ad-rendered > img').forEach(function (img) {
            setImportant(img, 'box-sizing', 'border-box');
            setImportant(img, 'display', 'block');
            setImportant(img, 'width', finalWidth + 'px');
            setImportant(img, 'max-width', '100%');
            setImportant(img, 'height', 'auto');
            setImportant(img, 'margin-left', 'auto');
            setImportant(img, 'margin-right', 'auto');
        });
    }

    function resizeAllAds() {
        TARGET_AD_IDS.forEach(function (id) {
            resizeAd(document.getElementById(id));
        });
    }

    function bindIframeLoads() {
        TARGET_AD_IDS.forEach(function (id) {
            var ad = document.getElementById(id);

            if (!ad) return;

            ad.querySelectorAll('iframe').forEach(function (iframe) {
                if (iframe.dataset.responsiveAdBound === '1') return;

                iframe.dataset.responsiveAdBound = '1';

                iframe.addEventListener('load', function () {
                    setTimeout(function () {
                        resizeAd(ad);
                    }, 150);
                });
            });
        });
    }

    function runResponsiveAds() {
        bindIframeLoads();
        resizeAllAds();

        setTimeout(resizeAllAds, 300);
        setTimeout(resizeAllAds, 1000);
        setTimeout(resizeAllAds, 2000);
    }

    document.addEventListener('DOMContentLoaded', runResponsiveAds);
    window.addEventListener('load', runResponsiveAds);
    window.addEventListener('resize', resizeAllAds);

    /*
     * Reklam rotasyonu varsa ölçüyü periyodik yeniler.
     */
    setInterval(function () {
        runResponsiveAds();
    }, 3000);

    var observerTimer = null;

    var observer = new MutationObserver(function () {
        clearTimeout(observerTimer);

        observerTimer = setTimeout(function () {
            runResponsiveAds();
        }, 150);
    });

    observer.observe(document.documentElement, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: [
            'src',
            'width',
            'height',
            'data-width',
            'data-height'
        ]
    });
})();
</script>
<style>
@media screen and (min-width: 1200px) {
    :root {
        --tower-width: 160px;
        --tower-height: 600px;
        --tower-gap: 12px;
        --tower-top: 260px;
        --tower-scale: 1;
    }

    #ad_36,
    #ad_9 {
        position: fixed !important;
        top: var(--tower-top) !important;

        width: var(--tower-width) !important;
        height: var(--tower-height) !important;

        margin: 0 !important;
        padding: 0 !important;

        overflow: visible !important;
        z-index: 3 !important;

        display: flex !important;
        align-items: flex-start !important;
        justify-content: center !important;

        transform: scale(var(--tower-scale)) !important;
        transform-origin: top center !important;
    }

    #ad_36 .ad-rendered,
    #ad_9 .ad-rendered {
        width: var(--tower-width) !important;
        height: var(--tower-height) !important;

        display: flex !important;
        align-items: flex-start !important;
        justify-content: center !important;

        overflow: visible !important;
    }

    #ad_36 iframe,
    #ad_9 iframe {
        width: var(--tower-width) !important;
        height: var(--tower-height) !important;

        display: block !important;
        border: 0 !important;
        overflow: hidden !important;

        margin: 0 auto !important;
    }

    #ad_36 img,
    #ad_9 img {
        display: block !important;
        width: var(--tower-width) !important;
        height: var(--tower-height) !important;
        object-fit: contain !important;
        margin: 0 auto !important;
    }
}

@media screen and (max-width: 1199px) {
    #ad_36,
    #ad_9 {
        display: none !important;
    }
}
</style>

<script>
(function () {
    var ticking = false;

    function getMainContainer() {
        return (
            document.querySelector('main .container') ||
            document.querySelector('.container') ||
            document.querySelector('.content .container')
        );
    }

    function getHeaderBottom() {
        var selectors = [
            '.header-8',
            '.top-header',
            '.main-menu',
            'header'
        ];

        var bottom = 0;

        selectors.forEach(function (selector) {
            var el = document.querySelector(selector);
            if (!el) return;

            var rect = el.getBoundingClientRect();

            if (rect.bottom > 0 && rect.top < window.innerHeight) {
                bottom = Math.max(bottom, rect.bottom);
            }
        });

        return bottom;
    }

    function updateTowerAds() {
        var leftAd = document.getElementById('ad_36');
        var rightAd = document.getElementById('ad_9');

        if (!leftAd && !rightAd) {
            ticking = false;
            return;
        }

        var vw = window.innerWidth;
        var vh = window.innerHeight;

        var towerWidth = 160;
        var towerHeight = 600;
        var gap = 12;
        var bottomGap = 20;

        if (vw < 1200) {
            if (leftAd) leftAd.style.setProperty('display', 'none', 'important');
            if (rightAd) rightAd.style.setProperty('display', 'none', 'important');
            ticking = false;
            return;
        }

        var container = getMainContainer();

        var siteLeft;
        var siteRight;

        if (container) {
            var rect = container.getBoundingClientRect();
            siteLeft = rect.left;
            siteRight = rect.right;
        } else {
            var siteWidth = 1140;
            siteLeft = (vw - siteWidth) / 2;
            siteRight = siteLeft + siteWidth;
        }

        var leftPos = siteLeft - towerWidth - gap;
        var rightPos = siteRight + gap;

        var leftCanShow = leftPos >= 0;
        var rightCanShow = rightPos + towerWidth <= vw;

        if (leftAd) {
            if (leftCanShow) {
                leftAd.style.setProperty('display', 'flex', 'important');
                leftAd.style.setProperty('left', Math.round(leftPos) + 'px', 'important');
                leftAd.style.setProperty('right', 'auto', 'important');
            } else {
                leftAd.style.setProperty('display', 'none', 'important');
            }
        }

        if (rightAd) {
            if (rightCanShow) {
                rightAd.style.setProperty('display', 'flex', 'important');
                rightAd.style.setProperty('left', Math.round(rightPos) + 'px', 'important');
                rightAd.style.setProperty('right', 'auto', 'important');
            } else {
                rightAd.style.setProperty('display', 'none', 'important');
            }
        }

        var headerBottom = getHeaderBottom();

        var safeTop = headerBottom > 0
            ? Math.ceil(headerBottom + 14)
            : 20;

        var centeredTop = Math.round((vh - towerHeight) / 2);
        var finalTop = Math.max(safeTop, centeredTop);

        var availableHeight = vh - finalTop - bottomGap;
        var scale = availableHeight / towerHeight;

        scale = Math.min(1, scale);
        scale = Math.max(0.60, scale);

        document.documentElement.style.setProperty('--tower-top', Math.round(finalTop) + 'px');
        document.documentElement.style.setProperty('--tower-scale', scale.toFixed(3));

        ticking = false;
    }

    function requestUpdateTowerAds() {
        if (!ticking) {
            window.requestAnimationFrame(updateTowerAds);
            ticking = true;
        }
    }

    document.addEventListener('DOMContentLoaded', requestUpdateTowerAds);
    window.addEventListener('load', requestUpdateTowerAds);
    window.addEventListener('resize', requestUpdateTowerAds);
    window.addEventListener('scroll', requestUpdateTowerAds, { passive: true });

    setTimeout(requestUpdateTowerAds, 300);
    setTimeout(requestUpdateTowerAds, 1000);
    setTimeout(requestUpdateTowerAds, 2000);

    var observer = new MutationObserver(function () {
        requestUpdateTowerAds();
    });

    observer.observe(document.documentElement, {
        childList: true,
        subtree: true,
        attributes: true,
        attributeFilter: ['style', 'class', 'data-affix', 'src']
    });

    requestUpdateTowerAds();
})();
</script></div><script>
(function () {
    if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) return;

    function isContentLink(a) {
        var href = a.getAttribute('href');
        if (!href) return false;
        if (/^(#|mailto:|tel:|javascript:)/i.test(href)) return false;
        if (a.hasAttribute('download')) return false;
        if (a.getAttribute('target') === '_blank') return false;
        if (a.closest('[data-no-new-tab]')) return false;
        return a.hostname === window.location.hostname;
    }

    function markAll(root) {
        (root || document).querySelectorAll('a[href]').forEach(function (a) {
            if (isContentLink(a)) {
                a.setAttribute('target', '_blank');
                var rel = (a.getAttribute('rel') || '');
                if (rel.indexOf('noopener') === -1) {
                    a.setAttribute('rel', (rel + ' noopener').trim());
                }
            }
        });
    }

    function init() {
        markAll(document);
        // AJAX ile gelen içerik (sonsuz kaydırma, kategori listeleri, swiper klonları)
        new MutationObserver(function (muts) {
            muts.forEach(function (m) {
                m.addedNodes.forEach(function (n) {
                    if (n.nodeType !== 1) return;
                    if (n.tagName === 'A') { markAll(n.parentNode); } else { markAll(n); }
                });
            });
        }).observe(document.body, { childList: true, subtree: true });

        // data-link taşıyan tıklanabilir öğeler (swiper bullet vb.) target attribute almaz
        document.addEventListener('click', function (e) {
            var el = e.target.closest('[data-link]');
            if (!el) return;
            var url = el.getAttribute('data-link');
            if (!url || /^(#|mailto:|tel:|javascript:)/i.test(url)) return;
            e.preventDefault();
            e.stopImmediatePropagation();
            window.open(url, '_blank', 'noopener');
        }, true);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
<script>
(function () {
    const header         = document.querySelector("header");
    const pageHeader     = document.querySelector(".page-header");
    const subCategories  = document.querySelector(".sub-categories");
    const adTop          = document.querySelector("#ad_152");

    let headerHeight = 0;

    if (header) headerHeight += header.offsetHeight;
    if (pageHeader) headerHeight += pageHeader.offsetHeight;
    if (subCategories) headerHeight += subCategories.offsetHeight;
    if (adTop) headerHeight += adTop.offsetHeight + 33;

    const css = `#ad_36, #ad_9 { top: ${headerHeight}px !important; }`;
    const style = document.createElement("style");
    style.id = "adFixEarly";
    style.textContent = css;

    document.head.appendChild(style);
})();
</script>
