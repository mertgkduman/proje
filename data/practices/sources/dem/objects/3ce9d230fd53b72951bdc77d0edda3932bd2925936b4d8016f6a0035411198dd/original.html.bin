            .video-embed { position: relative; width: 100%; }
            /* Embed kendi padding-tabanlı wrapper'ını getirdiyse: hiç dokunma (çift sarmayı önle) */
            .video-embed > div[style*="padding"] { width: 100%; }
            /* getEmbedAttribute accessor'ı iframe'e position:absolute;height:100% ekliyor.
               Absolute child sıfır-yükseklikli parent içinde 0px = görünmez kalıyordu.
               Parent'a 16:9 padding-tabanlı yükseklik ver → absolute iframe doldursun. */
            .video-embed:has(iframe[style*="absolute"]) { padding-bottom: 56.25%; height: 0; }
            /* Çıplak iframe / position:absolute OLMAYAN iframe geldiyse 16:9 responsive yap */
            .video-embed > iframe:not([style*="absolute"]) { display: block; width: 100%; aspect-ratio: 16 / 9; height: auto; border: 0; }
        </style>
