                <a class="dropdown-item" href="javascript:void(0)" onclick="copyURL(event, 'https://www.aydinpost.com/dem-partinin-yeni-pmsinde-33-yeni-isim')" rel="noreferrer nofollow noopener external" title="Bağlantıyı Kopyala">
                    <i class="fas fa-link text-dark me-2"></i>
