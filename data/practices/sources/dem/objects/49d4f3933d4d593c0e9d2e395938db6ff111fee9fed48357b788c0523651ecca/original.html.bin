                    href="https://t.me/share/url?url=https%3A%2F%2Fwww.aydinpost.com%2Fdem-partinin-yeni-pmsinde-33-yeni-isim&text=DEM+Parti%27nin+yeni+PM%27sinde+33+yeni+isim"
                    class="dropdown-item"
                    onclick="initiateDesktopShare(event, 'telegram')"
                    data-platform="telegram"
                    data-share-url="https://www.aydinpost.com/dem-partinin-yeni-pmsinde-33-yeni-isim"
                    data-share-title="DEM Parti&#039;nin yeni PM&#039;sinde 33 yeni isim"
