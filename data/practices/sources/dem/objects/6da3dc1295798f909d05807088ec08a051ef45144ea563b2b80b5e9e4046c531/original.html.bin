		<div class="post-article" id="news-132493" data-order="1" data-id="132493" data-title="DEM Partili Eş Başkanın istifası için halk belediyeye yürüdü" data-url="https://www.tigrishaber.com/dem-partili-es-baskanin-istifasi-icin-halk-belediyeye-yurudu-132493h.htm">
			<div class="row">
	<div class="col-12 col-lg-8 article-detail news-detail">

		<div class="content-heading">
			<h1 class="content-title">DEM Partili Eş Başkanın istifası için halk belediyeye yürüdü</h1>
		</div>

		<div class="content-image">
							<div class="imgc image">
					<picture>
												<img fetchpriority="high" src="https://www.tigrishaber.com/d/news/172098.jpg" alt="DEM Partili Eş Başkanın istifası için halk belediyeye yürüdü"/>
					</picture>
				</div>
					</div>

		<div class="content-date">
			<div><span>Yayınlanma:</span>
				<time datetime="2025-07-04 19:22:54">04/07/2025 19:22</time>
			</div>
					</div>

		<div class="content-tools">
			<div class="bookmark-block" data-type="1" data-twitter="" data-googlenews="">
			</div>

			<div class="text-size">
				<span class="icon-print bg" onclick="return openPopUp_670x500('/print.php?type=1&amp;id=132493')" title="Yazdır"></span>
				<span class="icon-plus bg" onclick="changeTextSize('.article-content .text-content', 'u');" title="Yazıyı büyüt" role="button"></span>
				<span class="icon-fontsize bg" onclick="resetFontSize('.article-content .text-content');" title="Normal Boyut" role="button"></span>
