1bfdef71834667b.js\",\"/_next/static/chunks/bbe1858669985cb6.js\",\"/_next/static/chunks/15c3cd4f911135f3.js\",\"/_next/static/chunks/98ca826370b557fc.js\",\"/_next/static/chunks/797221ab587a3576.js\",\"/_next/static/chunks/b146d82a5b82a89a.js\",\"/_next/static/chunks/d965178bba4f3078.js\",\"/_next/static/chunks/5af2fcf0a4a3b8fe.js\"],\"default\"]\n31:Td83,"])</script><script>self.__next_f.push([1,"\u003cp style=\"margin-bottom:1.5rem\"\u003e\u003cstrong\u003e\u003cspan\u003eHaber Merkezi\u003c/span\u003e\u003c/strong\u003e\u003cspan\u003e \u0026ndash; Silopi Belediye Eşbaşkanı Av. Jiyan Ormanlı, DEM Parti\u0026rsquo;nin d\u0026uuml;n yaptığı a\u0026ccedil;ıklamaya ilişkin \u0026ldquo;Mensubu bulunduğum partinin şahsıma dair sosyal medya hesabı \u0026uuml;zerinden yapmış olduğu a\u0026ccedil;ıklamayla ilgili olarak; g\u0026ouml;revimin başında olduğumu, Silopi halkının g\u0026ouml;stermiş olduğu tevecc\u0026uuml;he layık kalacağımı, daha sonra halkımıza etraflıca gerekli bilgilendirmeyi yapacağımı bilgilerinize sunarım\u0026rdquo; dedi.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.5rem\"\u003e\u003cspan\u003eOrmanlı, Instagram hesabı \u0026uuml;zerinden yaptığı a\u0026ccedil;ıklamada \"g\u0026ouml;revinin başında olduğunu\" belirterek, ilerleyen s\u0026uuml;re\u0026ccedil;te detaylı bir bilgilendirme yapacağını ifade etti.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.5rem\"\u003e\u003cspan\u003e\u0026ldquo;Silopi Belediye Başkanı\u0026rdquo; sıfatını kullanan Ormanlı\u0026rsquo;nın a\u0026ccedil;ıklaması şu şekilde:\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.5rem\"\u003e\u003cspan\u003e\u0026ldquo;Mensubu bulunduğum partinin şahsıma dair sosyal medya hesabı \u0026uuml;zerinden yapmış olduğu a\u0026ccedil;ıklamayla ilgili olarak; g\u0026ouml;revimin başında olduğumu, Silopi halkının g\u0026ouml;stermiş olduğu tevecc\u0026uuml;he layık kalacağımı, daha sonra halkımıza etraflıca gerekli bilgilendirmeyi yapacağımı bilgilerinize sunarım. Saygılarımla\u0026rdquo;\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.5rem\"\u003e\u003cspan\u003e\u003cimg alt=\"\" src=\"https://images.rudaw.net/Library/Images/Uploaded%20Images/2025/07/03/zzScreenshot_1.jpg\" title=\"Ormanlı'nın açıklaması\" /\u003e\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.5rem\"\u003e\u003cstrong\u003e\u003cspan\u003eNe olmuştu?\u003c/span\u003e\u003c/strong\u003e\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.5rem\"\u003e\u003cspan\u003eDEM Parti, 31 Mart 2024 Mahalli İdareler Se\u0026ccedil;imlerinde Şırnak\u0026rsquo;ın Silopi il\u0026ccedil;esinde belediye eşbaşkanı olarak se\u0026ccedil;ilen Jiyan Ormanlı\u0026rsquo;nın, \"kesin ihra\u0026ccedil;\" talebiyle Merkez Disiplin Kurulu\u0026rsquo;na\u003ca href=\"https://www.rudaw.net/turkish/middleeast/turkey/0207202524\" target=\"_blank\"\u003e sevk edildiğini duyurmuştu.\u003c/a\u003e \u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.5rem\"\u003e\u003cspan\u003eParti tarafından yapılan yazılı a\u0026ccedil;ıklamada, \u0026ldquo;Ormanlı\u0026rsquo;nın eşbaşkanlık sistemine karşı tutum geliştirdiği, ortak y\u0026ouml;netim anlayışını benimsemediği, parti kararlarını tanımadığı ve halkın belediyecilik konusundaki beklentilerini karşılayamadığı\u0026rdquo; belirtildi.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.5rem\"\u003e\u003cspan\u003eAyrıca \u0026ldquo;Ormanlı\u0026rsquo;nın, DEM Parti\u0026rsquo;nin yerel y\u0026ouml;netim politikalarıyla \u0026ouml;rt\u0026uuml;şmeyen uygulamalarda bulunduğu\u0026rdquo; kaydedildi.\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.5rem\"\u003e\u003cspan\u003eDEM Parti Demokratik Yerel Y\u0026ouml;netimler Kurulu tarafından yapılan a\u0026ccedil;ıklamada, şu ifadelere yer verildi:\u003c/span\u003e\u003c/p\u003e\n\u003cp style=\"margin-bottom:1.5rem\"\u003e\u003cspan\u003e\u0026ldquo;Jiyan Ormanlı; belediye eşbaşkanlığı yaptığı s\u0026uuml;re i\u0026ccedil;erisinde eşbaşkanlık sistemine karşı diren\u0026ccedil; geliştirmesi, ortak y\u0026ouml;netim k\u0026uuml;lt\u0026uuml;r\u0026uuml; yerine ben merkezci bir y\u0026ouml;netim anlayışı benimsemesi, parti kararlarını tanımaması, belediyecilik konusunda halkın talep ve beklentilerini karşılayamaması ve partimizin yerel y\u0026ouml;netimler politikasıyla \u0026ouml;rt\u0026uuml;şmeyen pratiklerde bulunması nedeniyle \u0026lsquo;kesin ihra\u0026ccedil;\u0026rsquo; istemiyle DEM Parti Merkez Disiplin Kuruluna sevk edilmiştir.\u0026rdquo;\u003c/span\u003e\u003c/p\u003e"])</script><script>self.__next_f.push([1,"6:[\"$\",\"div\",null,{\"className\":\"flex flex-col min-h-screen\",\"children\":[[\"$\",\"$L2e\",null,{\"variant\":\"default\"}],[\"$\",\"$L2f\",null,{\"langId\":5,\"articleId\":882010}],[\"$\",\"$L30\",null,{\"article\":{\"id\":882010,\"title\":\"DEM Parti kesin ihracını istemişti: Silopi Belediye Eşbaşkanı Ormanlı’dan açıklama\",\"subtitle\":\"DEM Parti kesin ihracını istemişti: Silopi Belediye Eşbaşkanı Ormanlı’dan açıklama\",\"category\":\"TÜRKİYE\",\"categoryId\":89,\"date\":\"03-07-2025\",\"rawDate\":\"2025-07-03T17:23:00Z\",\"author\":\"Rûdaw Editör Masası\",\"authorId\":null,\"authorSlug\":null,\"authorImage\":null,\"authorBio\":null,\"authors\":null,\"image\":\"https://images.rudaw.net/s3/rudaw.net/ContentFiles/882010Image1.jpg\",\"imgFocal\":null,\"imgVariants\":null,\"imageCaption\":\"Rûdaw Grafik\",\"content\":\"$31\",\"videoUrl\":null,\"videoType\":\"vod\",\"videoOnly\":false,\"tags\":[],\"libraryFolderId\":0,\"newsType\":6,\"galleryLayout\":null,\"metaStyle\":null,\"variant\":\"news\",\"template\":null,\"liveUpdates\":[]},\"category\":\"turkey\",\"slug\":\"882010\",\"relatedArticles\":[{\"id\":1287941,\"title\":\"Ankara Fuarı'nda bölge illerinin turizm potansiyeli tanıtıldı\",\"subtitle\":\"\",\"category\":\"TÜRKİYE\",\"image\":\"https://images.rudaw.net/images/asset/news/20261121203915_screenshot-7.jpg\",\"href\":\"/categories/turkey/1287941\",\"date\":\"21-11-2026\",\"author\":\"Şevket Herki\",\"authorImage\":\"https://images.rudaw.net/rudaw.net/ContentFiles/20260603145005_avatar.jpg\"},{\"id\":1287935,\"title\":\"Ahmet Nuri Bezar’ı öldüren çiftin, cinayetten sonra evlendiği ortaya çıktı\",\"subtitle\":\"\",\"category\":\"TÜRKİYE\",\"image\":\"https://images.rudaw.net/images/asset/news/20261121192306_hhh.jpg\",\"href\":\"/categories/turkey/1287935\",\"date\":\"21-11-2026\",\"author\":\"Rûdaw\",\"authorImage\":\"https://images.rudaw.net/rudaw.net/ContentFiles/20260603103119_avatar.jpg\"},{\"id\":1287932,\"title\":\"Hatimoğulları: Adalet Bakanı'na, bu süreci yürütenlere sesleniyorum ailelerin taleplerini yerine getirin!\",\"subtitle\":\"\",\"category\":\"TÜRKİYE\",\"image\":\"https://images.rudaw.net/images/asset/news/20261121183235_yyyyyyy.jpg\",\"href\":\"/categories/turkey/1287932\",\"date\":\"21-11-2026\",\"author\":\"Rûdaw\",\"authorImage\":\"https://images.rudaw.net/rudaw.net/ContentFiles/20260603103119_avatar.jpg\"}],\"singlePageTemplate\":null}]]}]\n"])</script></body></html>