    <meta property="og:image" content="https://disk.org.tr/wp-content/uploads/2020/05/manset.jpg" />
    <meta property="og:title" content=" &raquo; Taksim yine yasak: DİSK Yöneticileri gözaltında! (Foto Haber)"/>
    <meta property="og:type" content="article"/>
    <meta property="og:description" content="DİSK Yönetim Kurulu'nun ve üye sendikaların yöneticilerinin Taksim Anıtı'na çelenk bırakmaları bir kez daha engellendi. DİSK Genel Başkanı Arzu Çerkezoğlu ve Genel Sekreter Adnan Serdaroğlu'nun da aralarında olduğu 15 kişi gözaltına alındı."/>
    <meta property="og:url" content="https://disk.org.tr/2020/05/taksim-yine-yasak-disk-yoneticileri-gozaltinda-foto-haber/"/>
    <meta property="og:site_name" content="Disk.Org.Tr"/>

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@diskinsesi" />
    <meta name="twitter:title" content=" &raquo; Taksim yine yasak: DİSK Yöneticileri gözaltında! (Foto Haber)"/>
    <meta name="twitter:description" content="DİSK Yönetim Kurulu'nun ve üye sendikaların yöneticilerinin Taksim Anıtı'na çelenk bırakmaları bir kez daha engellendi. DİSK Genel Başkanı Arzu Çerkezoğlu ve Genel Sekreter Adnan Serdaroğlu'nun da aralarında olduğu 15 kişi gözaltına alındı."/>
    <meta name="twitter:image" content="https://disk.org.tr/wp-content/uploads/2020/05/manset.jpg" />


