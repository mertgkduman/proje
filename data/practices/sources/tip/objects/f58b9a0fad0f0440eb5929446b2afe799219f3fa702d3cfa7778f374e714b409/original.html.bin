<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
(function(){
  const overlay = document.getElementById('searchOverlay');
  const card    = overlay.querySelector('.search-card');
  const input   = document.getElementById('searchInput');
  const results = document.getElementById('searchResults');
  const openBtns = [document.getElementById('openSearchDesktop'), document.getElementById('openSearchMobile')].filter(Boolean);
  const endpointBase = document.body.getAttribute('data-search-endpoint') || '/';
  // Alt alan adlarında (ör. biryolvar) sonuçlar ana siteye gitsin.
  const SITE_BASE = "";
  const siteUrl = (u) => (typeof u === 'string' && u.startsWith('/') && !u.startsWith('//')) ? SITE_BASE + u : u;
  function openOverlay(){
    overlay.classList.add('show');
    setTimeout(()=> input?.focus(), 10);
    document.body.style.overflow = 'hidden';
  }
  function closeOverlay(){
    overlay.classList.remove('show');
    document.body.style.overflow = '';
    input.value = '';
    results.classList.remove('show');
    results.innerHTML = '';
  }
  openBtns.forEach(b=> b.addEventListener('click', openOverlay));
  document.addEventListener('keydown', (e)=>{ if(e.key === 'Escape' && overlay.classList.contains('show')) closeOverlay(); });
  overlay.addEventListener('click', (e)=>{ if(!card.contains(e.target)) closeOverlay(); });
  let t=null, lastQ='';
  input.addEventListener('input', ()=>{
    const q = input.value.trim();
    if (q === lastQ) return;
    lastQ = q;
    clearTimeout(t);
    if (q.length < 2) {
      results.classList.remove('show');
      results.innerHTML = '';
      return;
    }
    t = setTimeout(()=> search(q), 160);
  });
  async function search(q){
    try{
      const url = endpointBase + (endpointBase.includes('?') ? '&' : '?') + '__ajax=search&q=' + encodeURIComponent(q);
      const res = await fetch(url, {credentials:'same-origin'});
      if (!res.ok) throw new Error('HTTP '+res.status);
      const data = await res.json();
      const items = Array.isArray(data.items) ? data.items : [];
      if (!items.length) {
        results.innerHTML = '<div class="sr-empty">☹️ Maalesef aradığın kelimeye ait bir sonuç bulamadık.</div>';
        results.classList.add('show');
        return;
      }
      results.innerHTML = items.map(it=>{
        const thumb = it.thumb ? it.thumb : 'https://tip.org.tr/wp-content/uploads/2023/05/tip-logo-1600x900-2-scaled.jpg';
        const date  = it.date ? new Date(it.date.replace(' ','T')).toLocaleDateString('tr-TR') : '';
        const badge = it.label ? `<span class="sr-badge">${escapeHtml(it.label)}</span>` : '';
        const snippet = (it.snippet||'').trim();
        return `
          <a class="sr-item" href="${siteUrl(it.url)}">
            <span class="sr-thumb"><img src="${thumb}" alt=""></span>
            <span class="sr-meta" style="min-width:0;">
              <h4 class="sr-title">
                ${escapeHtml(it.title)} ${badge}
              </h4>
              ${snippet ? `<p class="sr-snippet">${escapeHtml(snippet)}</p>` : ''}
              ${date ? `<small style="color:#666">${date}</small>` : ''}
            </span>
          </a>`;
      }).join('');
      results.classList.add('show');
    } catch(e){
      console.error('Arama hatası:', e);
      results.innerHTML = '<div class="sr-empty">☹️ Maalesef aradığın kelimeye ait bir sonuç bulamadık.</div>';
      results.classList.add('show');
    }
  }
  function escapeHtml(s){
    return (s||'').replace(/[&<>"']/g, m=> ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
  }
})();
</script>

</body>
</html>
<body>

<div class="page-banner">
  <div class="container-1200 d-flex align-items-center justify-content-between gap-2">
    <h1 class="banner-title m-0">PARTİ SÖZCÜSÜ</h1>

    <!-- SAĞ: Sosyal medya (banner içine taşındı) -->
    <div class="banner-socials d-flex align-items-center gap-2">
      <a class="social-btn" href="https://x.com/serakadigil" target="_blank" rel="noopener" aria-label="X (Twitter)">
        <i class="fa-brands fa-x"></i>
      </a>
      <a class="social-btn" href="https://www.facebook.com/serakadigil/" target="_blank" rel="noopener" aria-label="Facebook">
        <i class="fa-brands fa-facebook-f"></i>
      </a>
      <a class="social-btn" href="https://www.instagram.com/serakadigil/" target="_blank" rel="noopener" aria-label="Instagram">
        <i class="fa-brands fa-instagram"></i>
      </a>
    </div>
  </div>
</div>

<section class="pt-0 pb-4">
  <div class="container-1200">
    <div class="row g-4">
      <main class="col-12">
        <div class="card border-0 shadow-sm" tabindex="0">
          <div class="card-body p-4 p-md-4">

            <section class="mb-section">
              <div class="row align-items-center g-4 hero-band">
                <!-- BAŞLIK: Mobilde üstte, masaüstünde sağ metnin üst hizasına yakın -->
              

                <!-- GÖRSEL -->
                <div class="col-12 col-lg-5 d-flex flex-column align-items-center order-1 order-lg-1">
                  <img
                    src="https://tip.org.tr/wp-content/uploads/elementor/thumbs/serakadigil-1-q4lt6fh0mcgr7u7iudtvziuinix3i3ybepb6d46bns.png"
                    alt="Sera Kadıgil"
                    class="img-fluid hero-avatar shadow-sm"
                  >
                </div>

                <!-- METİN -->
                <div class="col-12 col-lg-7 order-2 order-lg-2">  <div class="col-12 title-col order-0 order-lg-0">
                  <h2 class="hero-name text-center text-lg-start m-0">SERA KADIGİL</h2>
                </div>
                  <div class="hero-text">
                    <p>1984’te İstanbul’da doğan Saliha Sera Kadıgil, Vefa Lisesi’nin ardından 2007’de İstanbul Üniversitesi Hukuk Fakültesi’nden mezun oldu. Aynı üniversitede Özel Hukuk yüksek lisansını 2010’da tamamladı; Londra Queen Mary University’de yaptığı araştırmaların ardından tezini “sinema eserleri” üzerine yazdı. İstanbul Üniversitesi’nde doktora çalışmalarını sürdürüyor. Uzmanlık alanları arasında kültür-sanat hukuku ile fikir ve sanat eserleri üzerindeki haklar yer alıyor.</p>
                    <p>Hukuk pratiğinde kültür-sanat alanındaki sendika ve kurumlara avukatlık yaptı; İstanbul Barosu Hayvan Hakları Komisyonu Yürütme Kurulu’nda görev aldı. Avukatlık stajını “Ergenekon kumpası” davaları sürecinde tamamladı. Bu deneyimler, ifade ve örgütlenme özgürlüğü ile hayvan hakları gibi başlıklarda kamusal savunuculuk çizgisini pekiştirdi.</p>

                  
                  </div>
                </div>
				  
              </div>
				  <p>Siyasi yaşamına CHP’de başladı; Kadın Kolları MYK üyeliği ve üç dönem Parti Meclisi üyeliği yaptı. 2018’de İstanbul 1. Bölge seçim çevresinden TBMM’ye girdi. 25 Haziran 2021’de CHP’den istifa ederek Türkiye İşçi Partisi’ne (TİP) katıldı; 2021’den bu yana TİP Parti Sözcüsü’dür. 2023 genel seçimlerinde yeniden İstanbul milletvekili seçilerek 28. Dönem’de görevine devam etmektedir.<br><br>Meclis çalışmalarında kadınların ve LGBTİ+’ların eşit yurttaşlığı, emek ve sosyal haklar, kültür-sanat politikaları, hukuk devleti ve ifade özgürlüğü başlıklarını öne çıkarır. Basın toplantıları ve sosyal medya üzerinden düzenli açıklamalar yaparak TİP’in güncel politik hattını kamuoyuna duyurmaktadır.</p>
            </section>

          </div>
        </div>
      </main>
    </div>
  </div>
</section>

