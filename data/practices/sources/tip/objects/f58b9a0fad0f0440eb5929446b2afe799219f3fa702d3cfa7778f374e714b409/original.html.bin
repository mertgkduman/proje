    .search-overlay{ position:fixed; inset:0; z-index:1055; background:linear-gradient(180deg, rgba(19,44,85,.88), rgba(19,44,85,.88)); display:none; backdrop-filter:blur(2px); }
    .search-overlay.show{ display:block; }
