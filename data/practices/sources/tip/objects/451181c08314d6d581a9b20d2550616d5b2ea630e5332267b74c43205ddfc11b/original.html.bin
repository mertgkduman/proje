<script>
var REAKSIYON_AJAX = '/php/reaksiyon_ajax.php';
var emojiListesi = [
    {tip: 1, emoji: '👍', ad: 'Beğendim'},
    {tip: 2, emoji: '👏', ad: 'Alkış'},
    {tip: 3, emoji: '😊', ad: 'Güldüm'},
    {tip: 4, emoji: '👎', ad: 'Beğenmedim'},
    {tip: 5, emoji: '😡', ad: 'Kızdım'},
    {tip: 6, emoji: '😜', ad: 'Eğlendim'},
    {tip: 7, emoji: '😮', ad: 'Şaşırdım'},
    {tip: 8, emoji: '😢', ad: 'Üzüldüm'}
];
function reaksiyonlariYukle() {
    var el = document.getElementById('reaksiyon-alani');
    if (!el) return;
    var id = el.getAttribute('data-id');
    var tur = el.getAttribute('data-tur');
    var grid = document.getElementById('reaksiyon-grid');
    var xhr = new XMLHttpRequest();
    xhr.open('GET', REAKSIYON_AJAX + '?action=reaksiyon_getir&icerik_id=' + id + '&icerik_tur=' + tur);
    xhr.onload = function() {
        if (xhr.status !== 200) return;
        var res = JSON.parse(xhr.responseText);
        if (!res.success) return;
        renderReaksiyonlar(grid, res.sayilar, res.kullanici_secim, id, tur);
    };
    xhr.send();
}
function renderReaksiyonlar(grid, sayilar, secim, id, tur) {
    var html = '';
    for (var i = 0; i < emojiListesi.length; i++) {
        var e = emojiListesi[i];
        var aktif = secim === e.tip ? ' aktif' : '';
        var sayi = sayilar[e.tip] || 0;
        html += '<div class="reaksiyon-item' + aktif + '" onclick="reaksiyonVer(' + e.tip + ')" title="' + e.ad + '">';
        html += '<span class="reaksiyon-sayi">' + sayi + '</span>';
        html += '<div class="reaksiyon-cizgi"></div>';
        html += '<span class="reaksiyon-emoji">' + e.emoji + '</span>';
        html += '</div>';
    }
    grid.innerHTML = html;
}
function reaksiyonVer(emojiTip) {
    var el = document.getElementById('reaksiyon-alani');
    if (!el) return;
    var id = el.getAttribute('data-id');
    var tur = el.getAttribute('data-tur');
    var grid = document.getElementById('reaksiyon-grid');
    var xhr = new XMLHttpRequest();
    xhr.open('POST', REAKSIYON_AJAX + '?action=reaksiyon_ver');
    xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
    xhr.onload = function() {
        if (xhr.status !== 200) return;
        var res = JSON.parse(xhr.responseText);
        if (!res.success) return;
        renderReaksiyonlar(grid, res.sayilar, res.kullanici_secim, id, tur);
    };
    xhr.send('icerik_id=' + id + '&icerik_tur=' + tur + '&emoji_tip=' + emojiTip);
}
document.addEventListener('DOMContentLoaded', function() { reaksiyonlariYukle(); });
</script>
<script>
// Toast bildirimi
function ndToast(msg, icon) {
    icon = icon || 'success';
    if (typeof Swal === 'undefined') return;
    Swal.fire({ toast: true, position: 'top-end', icon: icon, title: msg, showConfirmButton: false, timer: 2000, timerProgressBar: true });
}
// Yazı boyutu
var _ndFontSize = parseInt(localStorage.getItem('nd_font_size') || '0');
(function(){ if(_ndFontSize) document.getElementById('icerikAlani') && (document.getElementById('icerikAlani').style.fontSize = (1 + _ndFontSize*0.1) + 'rem'); })();
function nd_fontSize(d) {
    _ndFontSize = Math.max(-3, Math.min(5, _ndFontSize + d));
    var el = document.getElementById('icerikAlani');
    if (el) el.style.fontSize = (1 + _ndFontSize * 0.1) + 'rem';
    localStorage.setItem('nd_font_size', _ndFontSize);
}
// Paylaşım tracking
function haberPaylas(platform, haberId) {
    var url = window.location.href;
    var baslik = document.title;
    var shareUrl = '';
    switch(platform) {
        case 'facebook': shareUrl = 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(url); break;
        case 'twitter': shareUrl = 'https://twitter.com/intent/tweet?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(baslik); break;
        case 'whatsapp': shareUrl = 'https://wa.me/?text=' + encodeURIComponent(baslik + ' ' + url); break;
        case 'telegram': shareUrl = 'https://t.me/share/url?url=' + encodeURIComponent(url) + '&text=' + encodeURIComponent(baslik); break;
        case 'linkedin': shareUrl = 'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(url); break;
        case 'pinterest': shareUrl = 'https://pinterest.com/pin/create/button/?url=' + encodeURIComponent(url) + '&description=' + encodeURIComponent(baslik); break;
        case 'copy':
            var doCopy = function() {
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(url).then(function() { ndToast('Link kopyalandı!'); });
                } else {
                    var ta = document.createElement('textarea');
                    ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
                    document.body.appendChild(ta); ta.focus(); ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                    ndToast('Link kopyalandı!');
                }
            };
            if (typeof Swal !== 'undefined') { doCopy(); } else {
                var s = document.createElement('script');
                s.src = 'https://cdn.jsdelivr.net/npm/sweetalert2@11';
                s.onload = doCopy;
                document.head.appendChild(s);
            }
            break;
    }
    if (shareUrl) {
        // 2.3.55: mobil uygulamada yerel paylasim; acilir pencere engellenirse ayni sekmede ac
        if (window.HaberApp && typeof window.HaberApp.share === 'function') { window.HaberApp.share(baslik, url); }
        else { var _pw = null; try { _pw = window.open(shareUrl, '_blank', 'width=600,height=500'); } catch (e) {} if (!_pw) location.href = shareUrl; }
    }
    // DB'de paylaşım sayısını artır
    fetch('/php/haberdetay.php?ajax_action=paylasim_artir&haber_id=' + haberId, {
        method: 'POST',
        headers: {'X-Requested-With': 'XMLHttpRequest'}
    }).catch(function(){});
}
// Beğeni tracking
function haberBegen(haberId) {
    fetch('/php/haberdetay.php?ajax_action=begeni_artir&haber_id=' + haberId, {
        method: 'POST',
        headers: {'X-Requested-With': 'XMLHttpRequest'}
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
        if (data.success) {
            var el = document.getElementById('begeniSayisi');
            el.textContent = data.begeni;
            var btn = document.getElementById('begeniBtn');
            btn.style.background = '#e74c3c';
            btn.style.color = '#fff';
            btn.querySelector('i').className = 'fas fa-heart';
        }
    })
    .catch(function(){});
}
function initYorumSistemi() {
    var YORUM_AJAX = '/php/yorum_ajax.php';
    var yorumSayfa = 1;
    var yorumToplamSayfa = 1;
    var avatarRenkler = ['#e74c3c','#3498db','#2ecc71','#9b59b6','#f39c12','#1abc9c','#e67e22','#34495e'];
    function avatarRenk(isim) {
        var hash = 0;
        for (var i = 0; i < isim.length; i++) hash = isim.charCodeAt(i) + ((hash << 5) - hash);
        return avatarRenkler[Math.abs(hash) % avatarRenkler.length];
    }
    window.yorumKartiHTML = function(y, altMi) {
        var basHarf = (y.isim || '?').charAt(0).toUpperCase();
        var renk = avatarRenk(y.isim || '');
        var boyut = altMi ? 'width:34px;height:34px;font-size:0.85rem;' : '';
        var html = '<div class="yorum-card" data-yorum-id="' + y.id + '">';
        html += '<div class="yorum-avatar" style="background:' + renk + ';' + boyut + '">' + basHarf + '</div>';
        html += '<div class="yorum-body">';
        html += '<div class="yorum-header"><span class="yorum-isim">' + y.isim + '</span><span class="yorum-tarih">' + (y.tarih_formatted || '') + '</span></div>';
        html += '<div class="yorum-icerik">' + y.icerik + '</div>';
        if (!altMi) {
            html += '<button type="button" class="yorum-cevapla-btn" onclick="cevapla(' + y.id + ',\'' + y.isim.replace(/'/g, "\\'") + '\')"><i class="fas fa-reply"></i> Cevapla</button>';
        }
        html += '</div></div>';
        return html;
    };
    window.yorumlariYukle = function(sayfa) {
        var dataid = $('input[name="dataid"]').val();
        if (!dataid) return;
        $.get(YORUM_AJAX, {
            action: 'yorumlari_getir',
            dataid: dataid,
            tur: 1,
            sayfa: sayfa || 1
        }, function(res) {
            if (!res.success) {
                $('#yorum-listesi').html('<div class="yorum-bos"><i class="far fa-comment-dots"></i> ' + (res.message || 'Yorumlar yüklenemedi.') + '</div>');
                return;
            }
            yorumToplamSayfa = res.toplam_sayfa || 1;
            $('#yorum-toplam').text(res.toplam || 0);
            if (sayfa === 1) {
                $('#yorum-listesi').empty();
            }
            $('#yorum-yukle-bilgi').remove();
            if (res.yorumlar.length === 0 && sayfa === 1) {
                $('#yorum-listesi').html('<div class="yorum-bos"><i class="far fa-comment-dots"></i> Henüz yorum yapılmamış. İlk yorumu siz yapın!</div>');
                $('#yorum-daha-fazla').hide();
                return;
            }
            var html = '';
            for (var i = 0; i < res.yorumlar.length; i++) {
                var y = res.yorumlar[i];
                html += yorumKartiHTML(y, false);
                // Cevaplar
                if (y.cevaplar && y.cevaplar.length > 0) {
                    html += '<div class="yorum-alt-container" id="cevaplar-' + y.id + '">';
                    for (var j = 0; j < y.cevaplar.length; j++) {
                        html += yorumKartiHTML(y.cevaplar[j], true);
                    }
                    if (y.cevap_sayisi > y.cevaplar.length) {
                        html += '<button type="button" class="yorum-daha-cevap" onclick="tumCevaplariYukle(' + y.id + ')">Tüm cevapları gör (' + y.cevap_sayisi + ')</button>';
                    }
                    html += '</div>';
                }
            }
            $('#yorum-listesi').append(html);
            // Daha fazla butonu
            if (yorumSayfa < yorumToplamSayfa) {
                $('#yorum-daha-fazla').show();
            } else {
                $('#yorum-daha-fazla').hide();
            }
        }, 'json').fail(function() {
            $('#yorum-listesi').html('<div class="yorum-bos"><i class="fas fa-exclamation-triangle"></i> Yorumlar yüklenirken bir hata oluştu.</div>');
        });
    };
    window.yorumDahaFazla = function() {
        yorumSayfa++;
        yorumlariYukle(yorumSayfa);
    };
    window.tumCevaplariYukle = function(parentId) {
        $.get(YORUM_AJAX, {
            action: 'cevaplari_getir',
            parent_id: parentId
        }, function(res) {
            if (!res.success) return;
            var container = $('#cevaplar-' + parentId);
            container.empty();
            for (var i = 0; i < res.cevaplar.length; i++) {
                container.append(yorumKartiHTML(res.cevaplar[i], true));
            }
        }, 'json');
    };
    window.cevapla = function(yorumId, isim) {
        $('#yorum-parent-id').val(yorumId);
        $('#yorum-cevap-isim').html('<i class="fas fa-reply"></i> <strong>' + isim + '</strong> adlı kullanıcıya cevap yazıyorsunuz');
        $('#yorum-cevap-bilgi').slideDown(200);
        $('html, body').animate({ scrollTop: $('#yorumForm').offset().top - 80 }, 400);
        $('#yorum-icerik').focus();
    };
    window.cevapIptal = function() {
        $('#yorum-parent-id').val(0);
        $('#yorum-cevap-bilgi').slideUp(200);
    };
    window.yorumEkle = function(e) {
        e.preventDefault();
        var btn = $('#yorum-gonder-btn');
        btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Gönderiliyor...');
        $('#yorum-alert').empty();
        $.post(YORUM_AJAX + '?action=yorum_ekle', $('#yorumForm').serialize(), function(res) {
            var cls = res.success ? 'yorum-alert yorum-alert-success' : 'yorum-alert yorum-alert-error';
            $('#yorum-alert').html('<div class="' + cls + '">' + (res.message || 'Bir hata oluştu.') + '</div>');
            if (res.success) {
                $('#yorumForm')[0].reset();
                $('#yorum-parent-id').val(0);
                $('#yorum-cevap-bilgi').hide();
                $('#yorum-karakter').text('0');
                var ci = document.getElementById('yorum-captcha-img');
                if (ci) ci.src = '/php/image.php?' + Math.random();
            }
        }, 'json').fail(function(xhr) {
            var msg = 'Bir hata oluştu. Lütfen tekrar deneyin.';
            try { msg = JSON.parse(xhr.responseText).message || msg; } catch(e) {}
            $('#yorum-alert').html('<div class="yorum-alert yorum-alert-error">' + msg + '</div>');
        }).always(function() {
            btn.prop('disabled', false).html('<i class="far fa-paper-plane"></i> Yorum Gönder');
        });
    };
    // Karakter sayacı
    $(document).on('input', '#yorum-icerik', function() {
        $('#yorum-karakter').text($(this).val().length);
    });
    // Sayfa yüklendiğinde yorumları getir
    yorumlariYukle(1);
}
document.addEventListener('DOMContentLoaded', function() {
    var waitJQ = setInterval(function() {
        if (typeof jQuery !== 'undefined') { clearInterval(waitJQ); initYorumSistemi(); }
    }, 50);
    // TTS Player init
    if (typeof TTSPlayer !== 'undefined' && TTSPlayer.isSupported()) {
        var ok = TTSPlayer.init('#ttsContainer', '.detay-content');
        if (ok) document.getElementById('ttsContainer').style.display = '';
    }
});
</script>
