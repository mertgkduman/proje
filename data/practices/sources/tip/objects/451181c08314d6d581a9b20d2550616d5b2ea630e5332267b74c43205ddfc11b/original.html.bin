<section class="content-area">
    <div class="container">
<div id="infiniteScrollContainer">
<div class="content-row haber-kapsa" data-haber-id="84934">
    
    <div class="content-main">
        <div class="block-card" itemscope itemtype="https://schema.org/NewsArticle">

            <!-- Kırmızı Üst Başlık -->
            
            <!-- Tarih — başlığın üstünde -->
                        <div class="nd-date-top"><i class="far fa-clock"></i><time itemprop="datePublished" datetime="2024-03-12T21:49:44+03:00">12.03.2024 21:49</time></div>
            
            <!-- Başlık -->
            <!-- BASLIK-KUCUK-HARF: gorunen baslik kucuk harfli, schema.org headline
                 orijinal yazimla korunuyor (Google Haberler/arama sonucu icin). -->
            <meta itemprop="headline" content="TİP&#039;in vekil adayından TİP&#039;e ağır eleştiri: İktidarın ekmeğine yağ süren bir parti ">
            <h1 class="nd-title">TİP&#039;in vekil adayından TİP&#039;e ağır eleştiri: İktidarın ekmeğine yağ süren bir parti </h1>

            <!-- Alt Başlık -->
            
            <!-- Spot/Özet -->
                        <p class="nd-spot" itemprop="description">Genel seçimlerde TİP İzmir 2. bölge milletvekili adayı olan, daha sonra partisinden kesin ihraç talebiyle Merkez Disiplin Kurulu&#039;na sevk edilen Ali Haydar Öztürk, TİP Çankaya Belediye Başkan Adayı İrfan Değirmenci’nin basın açıklamasına yanıt verdi. </p>
            
            <!-- Meta Bilgi Çubuğu -->
            <div class="nd-meta-strip">
                <div class="nd-ms-left">
                                                            <meta itemprop="dateModified" content="2026-09-07T12:57:03+03:00">
                                        
                    <!-- Sosyal paylasim — tarihin hemen altinda -->
                    <div class="nd-share-inline">
                <a href="javascript:void(0)" onclick="haberPaylas('facebook',84934)" class="nd-sc-btn nd-sc-fb" title="Facebook'ta Paylaş"><i class="fab fa-facebook-f"></i></a>
                <a href="javascript:void(0)" onclick="haberPaylas('twitter',84934)" class="nd-sc-btn nd-sc-tw" title="X'te Paylaş"><i class="fab fa-x-twitter"></i></a>
                <a href="javascript:void(0)" onclick="haberPaylas('whatsapp',84934)" class="nd-sc-btn nd-sc-wa" title="WhatsApp'ta Paylaş"><i class="fab fa-whatsapp"></i></a>
                <a href="javascript:void(0)" onclick="haberPaylas('telegram',84934)" class="nd-sc-btn nd-sc-tg" title="Telegram'da Paylaş"><i class="fab fa-telegram-plane"></i></a>
