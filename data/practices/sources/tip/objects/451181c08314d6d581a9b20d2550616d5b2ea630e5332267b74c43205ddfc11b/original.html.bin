    <!-- Analytics visitor_id cookie tracker (1 yıl TTL, UUID) -->
    <script src="/php/analytics-tracker.js" defer></script>
    <script>
    (function() {
        var tracked = false;
        function trackVisit() {
            if (tracked) return;
            tracked = true;
            var fd = new FormData();
            fd.append('action', 'track_visitor');
            fd.append('page_url', window.location.pathname);
            fd.append('page_title', document.title);
            fd.append('referrer', document.referrer || '');
            fd.append('session_id', '');
            fetch('/php/analytics.php', {
                method: 'POST',
                body: fd,
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            }).catch(function(){});
        }
        if (document.readyState === 'complete') {
            trackVisit();
        } else {
            window.addEventListener('load', trackVisit);
        }
        // Her 30 saniyede aktivite güncelle
        setInterval(function() {
            var fd = new FormData();
            fd.append('action', 'update_visitor_activity');
            fd.append('time_on_page', 30);
            fetch('/php/analytics.php', {
                method: 'POST',
                body: fd,
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            }).catch(function(){});
        }, 30000);
    })();
    </script>
<script>
(function() {
    var BP = 768;
    function swapBg() {
        var isMobile = window.innerWidth <= BP;
        var els = document.querySelectorAll('[data-mobile-bg]');
        for (var i = 0; i < els.length; i++) {
            var el = els[i];
            if (!el.dataset.originalBg) {
                el.dataset.originalBg = el.style.backgroundImage;
            }
            if (isMobile && el.dataset.mobileBg) {
                el.style.backgroundImage = "url('" + el.dataset.mobileBg + "')";
            } else if (el.dataset.originalBg) {
                el.style.backgroundImage = el.dataset.originalBg;
            }
        }
    }
    swapBg();
    var t;
    window.addEventListener('resize', function() {
        clearTimeout(t);
        t = setTimeout(swapBg, 150);
    });
})();
</script>
