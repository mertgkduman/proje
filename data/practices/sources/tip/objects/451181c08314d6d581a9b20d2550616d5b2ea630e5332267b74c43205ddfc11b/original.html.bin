<style>.yb-btn{margin-right:10px}.yb-btn.yb-aktif{color:#dc2626;opacity:1}.yb-btn .yb-sayi{margin-left:4px}.yb-not{display:block;font-size:.8rem;margin-top:6px;color:#6b7280}.yb-not a{text-decoration:underline}</style>
<script data-yorum-begeni>
(function () {
    var liste = document.getElementById('yorum-listesi');
    if (!liste || !window.fetch) return;
    var UC = '/ajax/uyelik.php', bekleyen = {}, zamanlayici = null, aktif = null;

    function dugme(kart, v) {
        var govde = kart.querySelector('.yorum-body');
        if (!govde || govde.querySelector('.yb-btn')) return;
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 'yorum-cevapla-btn yb-btn' + (v && v.benim ? ' yb-aktif' : '');
        b.setAttribute('data-id', kart.getAttribute('data-yorum-id'));
        b.setAttribute('aria-pressed', v && v.benim ? 'true' : 'false');
        b.innerHTML = '<i class="' + (v && v.benim ? 'fas' : 'far') + ' fa-thumbs-up"></i> Beğen<span class="yb-sayi">' + (v && v.begen ? v.begen : '') + '</span>';
        var cevapla = govde.querySelector('.yorum-cevapla-btn');
        if (cevapla) govde.insertBefore(b, cevapla); else govde.appendChild(b);
    }

    function yukle() {
        zamanlayici = null;
        var ids = Object.keys(bekleyen);
        if (!ids.length) return;
        var kartlar = bekleyen; bekleyen = {};
        fetch(UC + '?action=yorum_begeni_durum&ids=' + ids.join(','), { credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (!res || !res.success) return;
                aktif = res.aktif;
                if (!res.aktif) return; // üyelik kapalı: düğme gösterilmez
                ids.forEach(function (id) { dugme(kartlar[id], res.veriler[id]); });
            })
            .catch(function () {});
    }

    function tara() {
        if (aktif === false) return;
        var kartlar = liste.querySelectorAll('.yorum-card[data-yorum-id]');
        for (var i = 0; i < kartlar.length; i++) {
            var k = kartlar[i], id = k.getAttribute('data-yorum-id');
            if (id && !k.querySelector('.yb-btn') && !bekleyen[id]) bekleyen[id] = k;
        }
        if (Object.keys(bekleyen).length && !zamanlayici) zamanlayici = setTimeout(yukle, 150);
    }

    liste.addEventListener('click', function (e) {
        var b = e.target.closest ? e.target.closest('.yb-btn') : null;
        if (!b || b.disabled) return;
        b.disabled = true;
        var fd = new FormData();
        fd.append('action', 'yorum_begen');
        fd.append('yorum_id', b.getAttribute('data-id'));
        fd.append('tip', 'begen');
        fetch(UC, { method: 'POST', body: fd, credentials: 'same-origin' })
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (res && res.login_required) {
                    if (!b.parentNode.querySelector('.yb-not')) {
                        var n = document.createElement('span');
                        n.className = 'yb-not';
                        n.innerHTML = 'Beğenmek için <a href="/uye-giris">giriş yapın</a>.';
                        b.parentNode.appendChild(n); // düğmelerin arasına değil kartın sonuna
                    }
                    return;
                }
                if (!res || !res.success) return;
                var benim = res.status !== 'removed';
                b.classList.toggle('yb-aktif', benim);
                b.setAttribute('aria-pressed', benim ? 'true' : 'false');
                b.querySelector('i').className = (benim ? 'fas' : 'far') + ' fa-thumbs-up';
                b.querySelector('.yb-sayi').textContent = res.begen ? res.begen : '';
            })
            .catch(function () {})
            .then(function () { b.disabled = false; });
    });

    new MutationObserver(tara).observe(liste, { childList: true, subtree: true });
    tara();
})();
</script>    </div>
