    <script>(function(){var t=localStorage.getItem('theme_mode');if(t==='dark')document.documentElement.setAttribute('data-theme','dark')})()</script>
    
    
    <script>
    /* HaberApp <-> Web köprüsü: native varsa native bridge, yoksa Web API / OneSignal fallback. */
    (function(){
        var inApp = !!(window.HaberApp) || /HaberApp\//.test(navigator.userAgent || '');
        var hasOneSignal = false;
        document.documentElement.classList.add(inApp ? 'in-haber-app' : 'in-web');

        function viaOneSignal(fn){
            if (!hasOneSignal) return Promise.resolve(false);
            window.OneSignalDeferred = window.OneSignalDeferred || [];
            return new Promise(function(res){ window.OneSignalDeferred.push(function(OS){ try { fn(OS); res(true); } catch(_) { res(false); } }); });
        }

        window.AppBridge = {
            inApp: inApp,
            platform: inApp && window.HaberApp && window.HaberApp.platform ? window.HaberApp.platform() : 'web',
            share: function(title, url){
                title = title || document.title || '';
                url = url || location.href;
                if (inApp && window.HaberApp && window.HaberApp.share) { window.HaberApp.share(title, url); return; }
                if (navigator.share) { navigator.share({ title: title, url: url }).catch(function(){}); return; }
                try { window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(title + ' ' + url), '_blank'); } catch(_) {}
            },
            subscribe: function(topic){
                if (inApp && window.HaberApp && window.HaberApp.subscribeTopic) { window.HaberApp.subscribeTopic(String(topic||'')); return Promise.resolve(true); }
                return viaOneSignal(function(OS){ OS.User.PushSubscription.optIn(); if (topic) OS.User.addTag(String(topic), '1'); });
            },
            unsubscribe: function(topic){
                if (inApp && window.HaberApp && window.HaberApp.unsubscribeTopic) { window.HaberApp.unsubscribeTopic(String(topic||'')); return Promise.resolve(true); }
                return viaOneSignal(function(OS){ if (topic) OS.User.removeTag(String(topic)); });
            },
            setUserId: function(id){
                if (inApp && window.HaberApp && window.HaberApp.setUserId) { window.HaberApp.setUserId(String(id||'')); return Promise.resolve(true); }
                return viaOneSignal(function(OS){ if (id) OS.login(String(id)); });
            },
            clearUserId: function(){
                if (inApp && window.HaberApp && window.HaberApp.clearUserId) { window.HaberApp.clearUserId(); return Promise.resolve(true); }
                return viaOneSignal(function(OS){ OS.logout(); });
            },
            toast: function(msg){
                if (inApp && window.HaberApp && window.HaberApp.toast) { window.HaberApp.toast(String(msg||'')); return; }
                if (window.Swal) { window.Swal.fire({ toast:true, position:'top', timer:2000, showConfirmButton:false, icon:'info', title:String(msg||'') }); }
            },
            openExternal: function(url){
                if (inApp && window.HaberApp && window.HaberApp.openExternal) { window.HaberApp.openExternal(String(url||'')); return; }
                try { window.open(url, '_blank', 'noopener'); } catch(_) {}
            }
        };
    })();
