        <div id="google_translate_element" style="display:none;"></div>
    <script>
    window.ACTIVE_LANGUAGES = 'tr,en';
    // Dil seçici dropdown toggle
    (function(){
        document.addEventListener('click', function(e) {
            var toggle = e.target.closest('.topbar-lang-toggle');
            var dropdown = document.querySelector('.topbar-lang-dropdown');
            if (toggle && dropdown) {
                e.preventDefault();
                dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
                return;
            }
            // Dil seçimi
            var opt = e.target.closest('.language-option');
            if (opt) {
                e.preventDefault();
                var kod = opt.dataset.kod;
                if (!kod) return;
                localStorage.setItem('manualLangSelection', 'true');
                var hn = location.hostname;
                var parts = hn.split('.');
                var domains = ['', '.' + hn];
                if (parts.length > 2) domains.push('.' + parts.slice(-2).join('.'));
                if (kod === 'tr') {
                    domains.forEach(function(d) {
                        var dp = d ? '; domain=' + d : '';
                        document.cookie = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/' + dp;
                    });
                    localStorage.removeItem('siteLang');
                } else {
                    domains.forEach(function(d) {
                        var dp = d ? '; domain=' + d : '';
                        document.cookie = 'googtrans=/tr/' + kod + '; path=/' + dp;
                    });
                    localStorage.setItem('siteLang', kod);
                }
                var formData = new FormData();
                formData.append('kod', kod);
                fetch('/api/language/set', { method:'POST', body:formData })
                    .then(function(){ location.reload(); })
                    .catch(function(){ location.reload(); });
                return;
            }
            // Dropdown dışına tıklayınca kapat
            if (dropdown && !e.target.closest('.topbar-lang-menu')) {
                dropdown.style.display = 'none';
            }
        });
    })();
    </script>
