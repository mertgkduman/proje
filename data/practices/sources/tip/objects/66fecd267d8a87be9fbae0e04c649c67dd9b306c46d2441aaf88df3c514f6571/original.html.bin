<div id="update-form-container" class="update-form-container">
    <div id="subscriptions-hide" style="display: none;"></div>
    <div id="form-subscription" class="form-subscription">
        <h3 class="h2-style">Subscribe to newsletters</h3>
        
        <button id="close-form-subscription"><span class="icon-close"></span></button>
    </div>

    <iframe id="hidden-iframe" name="hidden-iframe" style="display: none;"></iframe>

    <form class="form-modal" id="update-form" method="POST" target="hidden-iframe" action="/content/nato/en/news-and-events/articles/news/2026/07/08/secretary-general-on-the-ankara-summit-nato-delivers/jcr:content.update-form.json" data-g-site-key="6LfHCgAsAAAAAGhkk9p9-hrWxyVUwM89HvwO7oTl">
        <input type="hidden" name="publicId"/>
        <input type="hidden" name="tempPublicId"/>
        <div class="form-step" id="step-1">
            <div class="form-step__content">
                <h3 class="h3-style form-step__subtitle">Step 1 of 2</h3>
                <h2 class="h2-style form-step__title">Personal data</h2>
                <p class="form-step__description">Please provide us with some basic information to identify you.</p>
                <div class="form-group">
                    <label for="email">Email address *</label>
                    <input type="text" id="email" name="email" readonly/>
                </div>
                <div class="form-group" id="group-firstName">
                    <label class="form-group__text-label" for="firstName">First name
                        *
                    </label>
                    <p class="error-message error-message--firstName">Please complete your First name before continuing</p>
                    <input type="text" id="firstName" maxlength="128" name="firstName"/>
                </div>
                <div class="form-group" id="group-familyName">
                    <label class="form-group__text-label" for="familyName">Family name
                        *</label>
                    <p class="error-message error-message--familyName">
                        Please complete your Family name before continuing</p>
                    <input type="text" id="familyName" maxlength="128" name="familyName"/>
                </div>
            </div>
            <div class="form__button-container">
                <button type="button" id="next-to-step-2" class="form__button">
                    <p>CONTINUE</p>
                    <span class="icon-arrow_right"></span>
                </button>
            </div>
        </div>
        <div class="form-step" id="step-2" style="display: none;">
            <div class="form-step__content">
                <div class="form-group">
                    <p class="error-message error-message--recaptcha d-none"></p>
                </div>
                <h3 class="h3-style form-step__subtitle">Step 2 of 2</h3>
                <h2 class="h2-style form-step__title">Subscription preferences</h2>
                <p class="form-step__description">Select the publications you would like to receive.</p>
                <div class="form-group">
                    <div class="checkbox-container">
                        <input checked id="update" name="update-newsletters" type="checkbox" value="update"/>
                        <div class="checkbox-label__container">
                            <label class="checkbox-label" for="update">Update</label>
                            <p class="checkbox-label__text">A recurring newsletter with our most captivating news stories, photos and videos.</p>
                        </div>
                        <input type="checkbox" id="press" name="press-newsletters" value="press"/>
                        <div class="checkbox-label__container">
                            <label class="checkbox-label" for="press">Press</label>
                            <p class="checkbox-label__text">Get our press releases in your inbox immediately after they&#39;re released. These cover visits or statements by the (Deputy) Secretary General, media advisories and ministerial/summit communiques.</p>
                        </div>
                        <input type="checkbox" id="multimedia" name="multimedia-newsletters" value="multimedia"/>
                        <div class="checkbox-label__container">
                            <label class="checkbox-label" for="multimedia">Multimedia</label>
                            <p class="checkbox-label__text">Get access to our free broadcast-quality video content. Discover news and feature video stories, b-rolls and soundbites from NATO operations, press conferences and activities.</p>
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <p class="error-message error-message--newsletter">
                        Please select at least one newsletter option</p>
                </div>
            </div>
            <div class="form__button-container">
                <button class="form__button-back" id="back-to-step-1" type="button">
                    <span class="icon-arrow_left"></span>
                    <p>Back</p>
                </button>
                <button type="button" id="next-to-step-3" class="form__button">
                    <p>SUBSCRIBE</p>
                    
                    <span class="icon-arrow_right"></span>
                </button>
            </div>
        </div>

        <div class="form-step" id="step-3" style="display: none;">
            <div class="form-step__heading">
                <h3 class="h3-style form-step__title">
                    Thanks! You&#39;re almost there...</h3>
                
                <p>Please verify your subscription in the message you received in your email (you might need to check your spam folder). You can continue in the meantime by adding the following optional information.</p>
                
            </div>
            <div class="form-step__content-subscribed">
                <div>
                    <h5 class="h5-style form-step__subheading-title">
                        Do you have time to provide us with some additional information?</h5>
                    
                    <p>We&#39;ll use this information to provide you with a more personalized experience.</p>
                </div>
                <div class="form-group">
                    <p class="small-text">Date of birth:</p>
                    <label class="lighten">For example, 19 4 1974.</label>
                    <p class="error-message" id="date-error-message" style="display: none;">
                        Please enter a valid date.</p>
                    <div class="date-inputs">
                        <div class="date-input">
                            <label for="day">Day</label>
                            <input type="text" id="day" name="day" placeholder="DD" maxlength="2" pattern="\d{1,2}" inputmode="numeric"/>
                        </div>
                        <div class="date-input">
                            <label for="month">Month</label>
                            <input type="text" id="month" name="month" placeholder="MM" maxlength="2" pattern="\d{1,2}" inputmode="numeric"/>
                        </div>
                        <div class="date-input">
                            <label for="year">Year</label>
                            <input type="text" id="year" name="year" placeholder="YYYY" maxlength="4" pattern="\d{4}" inputmode="numeric"/>
                        </div>
                        <input type="hidden" id="birthday" name="birthday" value=""/>
                    </div>
                </div>
                <div class="form-group form-group__dropdown">
                    <p class="small-text">Occupation</p>
                    <label>Knowing about your industry helps us provide better content for our users.</label>
                    <div class="form-group__dropdown-container">
                        <select id="occupation" name="occupation">
                            <option value="">
                                Select an option
                            </option>
                            <option value="media">
                                Media (journalist, blogger)
                            </option>
                            <option value="government">
                                Government (Elected, International organisation, etc)
                            </option>
                            <option value="military">
                                Military
                            </option>
                            <option value="academic">
                                Education (Student, Teacher, Professor)
                            </option>
                            <option value="other">
                                Other
                            </option>
                        </select>
                        <span class="icon-down-logout"></span>
                    </div>
                </div>
                <div class="form-group">
                    <p class="small-text">Organisation</p>
                    <label>This help text could be used to explain this information request.</label>
                    <input type="text" id="organisation" name="organisation" maxlength="256"/>
                </div>
            </div>
            <div class="form__button-container">
                <button class="form__button-close" id="close-modal-2"><p>CLOSE</p></button>
                <button type="button" id="open-final-modal" class="form__button">
                    <p>SEND</p>
                    <span class="icon-arrow_right"></span>
                </button>
            </div>
        </div>
        <div id="final-modal" style="display: none;">
            <div class="form-step form-final-modal">
                <h3 class="h3-style form-step__title">
                    Thank you for providing the additional information</h3>
                
                <p>Your subscription process has been successfully completed. Remember to check your email if this is your first time subscribing.</p>
                
            </div>
            <div class="form__button-container form-final-modal__button">
                <button class="form__button" id="close-modal" type="button">
                    <p>CLOSE</p>
                </button>
            </div>
        </div>
