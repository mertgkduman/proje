it,.nav-all .search-container{display:none !important}</style><div class="abc-ara-serit" id="abcAraKutu" hidden> <form class="abc-ara-form" action="/ara" method="get" role="search"> <input type="search" name="key" class="abc-ara-girdi" placeholder="Haber ara..." aria-label="Haber ara" autocomplete="off"> <button type="button" class="abc-ara-kapat" aria-label="Aramayı kapat"> <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg> </button> </form></div><script>/* Ana menü "DİĞER" açılır listesi — 2026-07-29 Masaüstünde hover ile açılır (CSS), tıklama ve klavye ile de çalışır. Dokunmatik cihazda hover olmadığı için tıklama ŞART. */ (function () { "use strict"; var kap = document.querySelector(".abc-nav-diger"); if (!kap) { return; } var btn = kap.querySelector(".abc-nav-diger-btn"); var liste = kap.querySelector(".abc-nav-alt"); if (!btn || !liste) { return; } function ayarla(acik) { btn.setAttribute("aria-expanded", acik ? "true" : "false"); kap.classList.toggle("acik", acik); } btn.addEventListener("click", function (e) { e.preventDefault(); ayarla(btn.getAttribute("aria-expanded") !== "true"); }); /* Dışarı tıklayınca kapan */ document.addEventListener("click", function (e) { if (!kap.contains(e.target)) { ayarla(false); } }); /* Esc ile kapan, odak butona dönsün */ document.addEventListener("keydown", function (e) { if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") { ayarla(false); btn.focus(); } }); /* Fare menüden ayrılınca kapat (hover ile açılmışsa tutarlı davransın) */ kap.addEventListener("mouseleave", function () { ayarla(false); }); })(); /* --- Arama seridi: buyutec tiklamasi ------------------------------------- Baglanti korunur (JS calismazsa arama sayfasina gider); JS varsa yerinde acilir ve odak dogrudan girdiye gider. */ (function () { "use strict"; var ac = document.querySelector(".abc-ara-ac"); var kutu = document.getElementById("abcAraKutu"); if (!ac || !kutu) { return; } var girdi = kutu.querySelector(".abc-ara-girdi"); var kapat = kutu.querySelector(".abc-ara-kapat"); function ayarla(acik) { kutu.hidden = !acik; ac.setAttribute("aria-expanded", acik ? "true" : "false"); if (acik) { setTimeout(function () { girdi.focus(); }, 30); } } ac.addEventListener("click", function (e) { e.preventDefault(); ayarla(kutu.hidden); }); kapat.addEventListener("click", function () { ayarla(false); ac.focus(); }); document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !kutu.hidden) { ayarla(false); ac.focus(); } }); /* Bos aramayla gonderilmesin */ kutu.querySelector("form").addEventListener("submit", function (e) { if (!girdi.value.trim()) { e.preventDefault(); girdi.focus(); } }); })(); /* --- Mobil cekmece: disari tiklayinca / Esc ile kapansin ------------------ Acma isini bundle daki mevcut jQuery kodu yapiyor (body.menu-visible); burada yalnizca kapatma yollari ve arka plan perdesi eklenir. */ (function () { "use strict"; var btn = document.querySelector(".abc-menu-btn"); var menu = document.querySelector(".nav-all"); if (menu && !menu.id) { menu.id = "abcMobilMenu"; } /* Hamburger <-> X: buton YERINDE kalir, yalnizca cizgiler doner. Durum tek kaynaktan (body.menu-visible) okunur; bundle'daki mevcut jQuery ac/kapa kodu korunur, biz sadece yansitiriz. */ /* Başlık yüksekliğini ölç ve CSS değişkenine yaz — çekmece tam altından başlasın (üst şerit kayınca yükseklik değişiyor, sabit veremeyiz). */ function basligiOlc() { var h = document.querySelector(".nav-main-container"); if (!h) { return; } var alt = Math.round(h.getBoundingClientRect().bottom); if (alt > 0) { document.documentElement.style.setProperty("--abc-hdr", alt + "px"); } } basligiOlc(); window.addEventListener("resize", basligiOlc); window.addEventListener("scroll", function () { if (document.body.classList.contains("menu-visible")) { basligiOlc(); } }, { passive: true }); function yansit() { var acik = document.body.classList.contains("menu-visible"); if (acik) { basligiOlc(); } if (btn) { btn.classList.toggle("acik", acik); btn.setAttribute("aria-expanded", acik ? "true" : "false"); btn.setAttribute("aria-label", acik ? "Menüyü kapat" : "Menü"); } } /* body sinifi baskasi tarafindan degistirilse de yakala */ if (window.MutationObserver) { new MutationObserver(yansit).observe(document.body, { attributes: true, attributeFilter: ["class"] }); } yansit(); function kapat() { document.body.classList.remove("menu-visible"); } document.addEventListener("keydown", function (e) { if (e.key === "Escape") { kapat(); } }); document.addEventListener("click", function (e) { if (!document.body.classList.contains("menu-visible")) { return; } var menu = document.querySelector(".nav-all"); if (menu && !menu.contains(e.target) && !e.target.closest(".show-all-menu")) { kapat(); } }); })();</script><main role="main"><div class="container section-padding-gutter"><div class="row"> <div class="col-12 col-lg-12 nopadding"> <div class="page-content news-scroll" data-pages="[{&quot;id&quot;:&quot;878554&quot;,&quot;link&quot;:&quot;gundem\/erdogandan-kurra-hafiz-ali-kemal-hut-icin-duygusal-taziye-mesaji-878554&quot;},{&quot;id&quot;:&quot;878553&quot;,&quot;link&quot;:&quot;gundem\/bakan-gurlek-duyurdu-fon-sorusturmasinda-iddianame-asamasina-gecildi-878553&quot;},{&quot;id&quot;:&quot;878550&quot;,&quot;link&quot;:&quot;gundem\/on-binlerce-kisinin-bekledigi-aciklama-geldi-cevdet-yilmaz-fon-odemeleri-icin-tari-878550&quot;},{&quot;id&quot;:&quot;878547&quot;,&quot;link&quot;:&quot;gundem\/erdoganin-genclik-yillarindan-hocasi-ali-kemal-hut-efendi-vefat-etti-878547&quot;}]"><div class="post-item" id="news-283047" data-order="1" data-id="283047" data-title="Türkiye İşçi Partisi &#039; Gel kardeşim&#039; sloganı ile geliyor!" data-url="https://abcgazetesi.com.tr/turkiye-isci-partisi-gel-kardesim-slogani-ile-geliyor-283047"> <div class="article-detail news-detail"><img src="/service/fia/tracker.php?n=283047" alt="" aria-hidden="true" width="1" height="1" loading="eager" decoding="async" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden"><section class="breadcrumbs"> <ol><li><a href="https://abcgazetesi.com.tr/" title="Haberler"><i class="fa icon-home"></i>Haberler</a></li> <li><a href="https://abcgazetesi.com.tr/gundem" title="Gündem Haberleri">Gündem</a></li> <li>Türkiye İşçi Partisi ' Gel kardeşim' sloganı ile geliyor!</li></ol> </section><h1 class="content-title">Türkiye İşçi Partisi ' Gel kardeşim' sloganı ile geliyor!</h1> <div class="article-image"><div class="imgc image"><img class="lazy" loading="lazy" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" data-src="https://abcgazetesi.com.tr/d/news/0.jpg" data-sizes="auto" data-srcset-pass="https://abcgazetesi.com.tr/d/news_ts/0.jpg 414w, https://abcgazetesi.com.tr/d/news_t/0.jpg 702w, https://abcgazetesi.com.tr/d/news/0.jpg 1280w" alt="Türkiye İşçi Partisi ' Gel kardeşim' sloganı ile geliyor!"/></div></div><aside class="article-side"><div class="content-date"><time class="p1" datetime="2018-03-23 21:29:00">21:29 - 23 Mart 2018</time></div><div class="content-tools bookmark-block" data-type="1" data-twitter="abcgazete"><a rel="nofollow noopener" href="https://news.google.com/publications/CAAqBwgKMMqgmQsw6qqxAw?hl=tr&amp;gl=TR&amp;ceid=TR:tr" target="_blank" title="Google News abone ol" class="icon-google facebook-bg"></a> <a rel="nofollow noopener" href="javascript:;" onclick="copyToClipboard('https://abcgazetesi.com.tr/turkiye-isci-partisi-gel-kardesim-slogani-ile-geliyor-283047')" class="fa icon-link facebook-bg" title="Haber Linkini Kopyala"></a> <a rel="nofollow noopener" href="javascript:;" class="d-none fa icon-star facebook-bg" title="Favorilere Ekle"></a> </div> </aside><article class="article-content"><div class="content-heading"> <h2 class="content-description">Türkiye’nin içinde bulunduğu toplumsal ve siyasal sorunların kimlik ve kültür çatışmalarıyla aşılmasının imkansız olduğunu ve Saray Rejimi’ne karşı mücadelede işçi sınıfının ve emekçilerin siyaset alanına taşınmasının...</h2> </div><div class="text-content"><p>Türkiye’nin içinde bulunduğu toplumsal ve siyasal sorunların kimlik ve kültür çatışmalarıyla aşılmasının imkansız olduğunu ve Saray Rejimi’ne karşı mücadelede işçi sınıfının ve emekçilerin siyaset alanına taşınmasının en kritik nokta olduğunu düşünen işçiler, emekçiler ve sosyalistler bir araya gelerek Türkiye İşçi Partisi’ni (TİP) yeniden kuruyor.</p><p>İleri haber'de yer alan habere göre, Türkiye’nin birçok ilinden, birinci ve ikinci TİP üyesi, tarihsel TKP üyesi, işçiler, sendika ve işçi temsilcileri, demokratik kitle örgütü temsilcileri, akademisyenler, yazarlar, gazeteciler ve çeşitli mesleklerden pek çok kişinin imzasıyla TİP'in kuruluşuna ilişkin  “Gel Kardeşim'' başlıklı bir çağrı metni yayınlandı.</p><div class="banner banner-wide"><div id='div-gpt-ad-1707404603672-0' style='min-width: 300px; min-height: 50px;'> <script>  googletag.cmd.push(function() { googletag.display('div-gpt-ad-1707404603672-0'); });  </script></div></div><p>“Gel Kardeşim!'' deklarasyonuyla yola çıkan TİP, Türkiye’nin birçok bölgesinde geniş katılımlı halk toplantıları yoluyla örgütlenerek, önümüzdeki birkaç ayda kuruluş sürecini tamamlayacak.</p><p><strong>''TASADA VE SEVİNÇTE ORTAKLAŞIYORUZ!’</strong></p><p>TİP girişimi tarafından kuruluş sürecine ilişkin yapılan açıklamada, “Türkiye İşçi Partisi, Türkiye sosyalist hareketinin bütün mirasını işçi ve emekçilerin hizmetine sunacak; ülkemizin gömülmek istendiği karanlığı yırtıp bağımsız, aydınlık ve özgür bir Türkiye’nin işçiler ve emekçiler tarafından kurulmasını sağlayacaktır.</p><p>Ülkemizin her köşesinde yan yana geliyoruz. </p><p>Tasada ve sevinçte ortaklaşıyoruz. </p><p>İşçilerin ve emekçilerin partisini, kendi partimizi kuruyoruz.</p><p>Bizi yok sayanlara, çaresiz bırakmaya çalışanlara, umudu karartmaya çalışanlara karşı haykırıyoruz: Biz halkız! Biz kazanacağız!'' denildi.</p><p><strong>ÇAĞRI METNİ 'GEL KARDEŞİM':</strong></p><p>Zenginleri daha zengin, yoksulları daha yoksul eden bu düzene,</p><p>Saatlerce alın teri döküp yine de geçinememeye, iş yerinde maruz kaldığın tacize, tehdide ve sömürüye,</p><p>Çocuğunu okutmak, hastanı tedavi ettirmek, insan gibi dinlenebilmek için servet harcatan mecburiyete son vermek istiyorsan gel.</p><div class="banner banner-wide"><ins class="adsbygoogle" style="display:block; text-align:center;" data-ad-layout="in-article" data-ad-format="fluid" data-ad-client="ca-pub-5037980398676429" data-ad-slot="3716310191"></ins><script>  (adsbygoogle = window.adsbygoogle || []).push({});</script></div><p>Yandaş olup el pençe durmadın diye, hırsıza arsıza göz yummadın diye, hakkını elinden almaya çalışanlara izin vermedin diye tehdit ve teşhir edilen, baskıya ve hakarete uğrayan, işsiz ve yoksul bırakılan milyonlardan biriysen gel.</p><p>Üç yanı deniz, dört yanı işçi mezarlarıyla çevrilmiş memleketin haline isyan ediyorsan gel kardeşim.</p><p>Gel kardeşim!</p><p>Eşit, özgür, kardeşçe ve adil bir yaşam istiyorsan,</p><p>Geleceğini çalanlardan, tüm özgürlüklerini elinden alanlardan, en temel haklarını gasp edenlerden usandıysan gel.</p><p>Ölüm, keder ve acı neden hep bizim payımıza düşüyor diyorsan,</p><p>Din tacirlerine, savaş çığırtkanlarına kanmadıysan,</p><p>Emeğine, haysiyetine, kentine, doğana saldıranlara; yaşamına, zevklerine ve tercihlerine burnunu sokanlara; seni baskı ve yasaklarla teslim almaya çalışanlara dur demek istiyorsan gel.</p><p>Gel ki,</p><p>Güzel ülkemizin tepesine çöreklenmiş çeteleri, saraylarda sefa sürenleri, bizim emeğimizle servetine servet ekleyenleri alaşağı edelim.</p><p>Zalimin, hırsızın, yobazın saltanatını yıkalım.</p><p>Bağımsız, laik, eşit, özgür, adil bir geleceğe adım atalım. </p><p>Kentleri, meydanları, okulları, iş yerleri yaşam, sevinç ve umut dolu bir ülke kuralım.</p><p>Gel, yoldaş olalım.</p><p>Bizi parçalayıp teslim alacağını sananlara birliğimizin gücünü gösterelim.</p><p>Bizi susturup güdebileceğini sananlara özgürlüğümüzden vazgeçmeyeceğimizi gösterelim.</p><p>Bizi korkutup geri adım attıracağını sananlara cesaretimizi ve kararlılığımızı gösterelim. </p><p>Bizi yok sayanlara biz varız, biz halkız diyelim.</p><p>Çaresiz bırakmaya çalışanlara çare halktır diyelim.</p><p>Umudu karartmaya çalışanlara umut halktadır diyelim.</p><p>Gel kardeşim,</p><p>Ekmeği paylaşalım, emeği iktidara taşıyalım.</p><p>İşçilerin, emekçilerin, yani hepimizin sesine ses katalım.</p><p>Türkiye’nin işçi partisini, Türkiye emekçilerinin partisini kuralım.</p><p><strong>İLK ÇAĞIRICILAR:</strong></p><p>Tuncay Ünlüeser- Avukat  <strong>Adana</strong><br>Ecevit Ablak- Elektrik Mühendisleri Odası Ankara Şube YK Üyesi <strong> Adana</strong><br>Elif Çamöz - FKF MYK Üyesi  <strong>Ankara</strong><br>Ercan Bölükbaşı-Akademisyen, FKF Kurucu Genel Sekreteri <strong> Ankara</strong><br>Ertan Saygınar-Elektrik Mühendisleri Odası Ankara Şube Eski YK Üyesi <strong> Ankara</strong><br>Enver Çamlıdere-Eski TİP ve Sosyalist Gençlik Örgütü Üyesi <strong> Ankara</strong><br>Fatoş Erol-Kimya Mühendisi, İlerici Kadınlar Meclisi  <strong>Ankara</strong><br>Günseli Mungan-Emekli Öğretmen, Eski Genel-Der Şube Yöneticisi  <strong>Ankara</strong><br>Harun Kılıçoğlu-Peyzaj Mimarı  <strong>Ankara</strong><br>Hüseyin Cahit Soylu-Eski TİP Üyesi  <strong>Ankara</strong><br>Kadir Durmuş-Spor Emek-Sen Yöneticisi <strong> Ankara</strong><br>İlhan Akalın-Yazar, Eski TİP Üyesi  <strong>Ankara</strong><br>Metin Çulhaoğlu-Yazar, Eski TİP Üyesi  <strong>Ankara</strong><br>Murat Bozbeyoğlu-Sosyal-İş Ankara Şube Başkanı  <strong>Ankara</strong><br>Orhan Saraç-Tarihsel TKP Üyesi  Ankara<br>Seher Yaşar -Batıkent Gezi Kültür ve Dayanışma Derneği YK Üyesi  <strong>Ankara</strong><br>Selahattin Gökcan-Eski İGD Üyesi <strong> Ankara</strong><br>Sermet Yalçın-Tarihsel TKP Üyesi  <strong>Ankara</strong><br>Tuncay Çelen -Eski Dev-Genç MYK Üyesi  <strong>Ankara</strong><br>Zarife Yurtseven-Mamak Gezi Kültür ve Dayanışma Derneği YK Üyesi  <strong>Ankara</strong><br>Cafer Yelsalı-Turizm İşçisi  <strong>Antalya</strong><br>Hayri Erdoğan-Eski TİP Üyesi <strong> Antalya</strong><br>Nevzat Polat-Tekel Direnişçisi  <strong>Antalya</strong><br>Yeliz Badaş-Market İşçisi  <strong>Antalya</strong><br>Ali İhsan Şimşek-Eski TKP İşçinin Sesi Üyesi, Tüm Emekli-Sen Yönetim Kurulu Üyesi  <strong>Aydın</strong><br>Ergün Güner-Tüketici Hakları Derneği Sorumlusu  <strong>Aydın</strong><br>Mustafa Özkan-Eski TİP Üyesi  <strong> Balıkesir </strong><br>Hüseyin Ay -Tarihsel TKP Üyesi   <strong>Balıkesir </strong><br>Baran Kaya -Avukat  <strong> Bursa</strong><br>Ali İlhan Uysal-Hizmet İşçisi <strong> Çanakkale</strong><br>Barış Kineşçi-Araştırma Uzmanı  <strong>Çorum</strong><br>Süleyman Çağlı-Eski TİP Üyesi <strong> Denizli</strong><br>Celal Ateş-Emekli Maliyeci  <strong>Tunceli</strong><br>Cebrail Akboyun-Eski TİP Üyesi  <strong>Diyarbakır</strong><br>Nadi Öztürk-Eski Eğitim-Sen Uzunköprü Şube Başkanı<strong>  Edirne</strong><br>Cansu Atay-İlerici Kadınlar Meclisi <strong>  Eskişehir</strong><br>Gökberk Çınar-FKF MYK Üyesi  <strong>Eskişehir</strong><br>Gün Çağ Aydın-Yayıncı  <strong>Eskişehir</strong><br>Pirozan Eltan- Elektrik-Elektronik Mühendisi  <strong>Gaziantep</strong><br>Levent Çapak-Tekel Direnişçisi  <strong>Hatay</strong><br>Nihal Mengüllüoğlu- Eski İKD Üyesi <strong> Hatay</strong><br>Toni Aygün -Döşeme Ustası  <strong>Hatay</strong><br>Abdullah Özdemir-Tek-Gıda-İş Eski Şube Başkanı  <strong>İstanbul</strong><br>Ali Önder Öndeş-Eski TİP Üyesi, Eski Sosyalist Türkiye Partisi Genel Başkanı <strong> İstanbul</strong><br>Bahadır Yavuz-Gümüşhane Kelkitliler Derneği Başkanı <strong> İstanbul</strong><br>Barış Atay-Tiyatrocu, Yönetmen  <strong>İstanbul</strong><br>Can Soyer-Yön Dergisi Genel Yayın Yönetmeni <strong> İstanbul</strong><br>Cem Erdoğan -Karayolları Kentsel Gelişim Derneği Genel Sekreteri  <strong>İstanbul</strong><br>Deniz Ali Gür-KHK Nedeniyle İşsiz Akademisyen  <strong>İstanbul</strong><br>Deniz Kıyafet-PSAKD Maltepe Şube Başkanı  <strong>İstanbul</strong><br>Deniz Öztürk-Mimarlar Odası Büyükkent Şubesi Eski YK Yedek Üyesi  <strong>İstanbul</strong><br>Ebru Pektaş-Yazar, İlerici Kadınlar Meclisi <strong> İstanbul</strong><br>Ekim Nehir -Hekim, Halkın Doktorları Grubu  <strong>İstanbul</strong><br>Emre Gürcanlı-Yazar, Akademisyen  <strong>İstanbul</strong><br>Engin Arslan -Tarihsel TKP Üyesi  <strong>İstanbul</strong><br>Erçin Fırat-FKF Kurucu Genel Başkanı  <strong>İstanbul</strong><br>Erkan Baş-HTKP Genel Başkanı  <strong>İstanbul</strong><br>Erman Payaslı-Bilgisayar Mühendisleri Odası İstanbul Temsilciler Kurulu Üyesi<strong> İstanbul</strong><br>Fatma Gül Eryıldız-KHK Nedeniyle İşsiz Akademisyen, Şehir Plancısı<strong>  İstanbul</strong><br>Hakan Güneş-Akademisyen<strong>  İstanbul</strong><br>Hamiyet Şabudak -Çekmeköy Dayanışma Derneği Başkanı <strong> İstanbul</strong><br>Hasan Karayol-Müzisyen  <strong>İstanbul</strong><br>Hüseyin Ağçal-PSAKD Avcılar Şube Başkanı <strong> İstanbul</strong><br>Hüseyin Ergun Doğru -Elektrik Mühendisleri Odası İstanbul Şube Başkan Yardımcısı<strong> İstanbul</strong><br>İbrahim Eke-Uzman Psikolog  <strong>İstanbul</strong><br>İsmail Özkan-Eski TİP Beykoz İlçe Başkanı  <strong>İstanbul</strong><br>Meltem Kolgazi-Akademisyen, İlerici Kadınlar Meclisi <strong> İstanbul</strong><br>Meral Aydemir-Eski TİP Üyesi  <strong>İstanbul</strong><br>Meryem Yıldırım -Gazeteci <strong> İstanbul</strong><br>Nazır Kapusuz-Ekonomist  <strong>İstanbul</strong><br>Onur Emre Yağan-İleri Haber Genel Yayın Yönetmeni <strong> İstanbul</strong><br>Onur Güneş-Avukat, Adalet İçin Hukukçular  <strong>İstanbul</strong><br>Özgür Urfa-Avukat, Adalet İçin Hukukçular  <strong>İstanbul</strong><br>Sevgi Aydemir-Aşçı   <strong>İstanbul</strong><br>Sinan Dervişoğlu-Yazar  <strong>İstanbul</strong><br>Taşkın Dilek-Anadolunun Sesi Tokat Gazetesi Genel Yayın Yönetmeni  <strong>İstanbul</strong><br>Tuğba Özer -Gazeteci  <strong>İstanbul</strong><br>Uğur Özdemir-Eski TİP Beykoz İlçe Başkanı  <strong>İstanbul</strong><br>Ümit Bayrak-Mimarlar Odası Büyükkent Şubesi Eski YK Üyesi Vahdettin Özkan -Eski TİP Üyesi <strong> İstanbul</strong><br>Yelda Koçak-Avukat, İlerici Kadınlar Meclisi  <strong>İstanbul</strong><br>Ahmet Duran Bülbül-Hekim  <strong>İzmir</strong><br>Bayram Töre-Eski TİP Üyesi, Eğitim-Sen Kırkağaç Eski Şube Başkanı Erdal İlgan-Eski TİP üyesi  <strong>İzmir</strong><br>Erkin Özalp-Yazar, Çevirmen <strong> İzmir</strong><br>Faruk Algeç-Eski TİP Üyesi, Eski Petrol-İş Menemen Danışma Kurulu Üyesi <strong> İzmir</strong><br>Galip Çevik-Tarihsel TKP Üyesi, Eski Müzik-Der Başkanı  <strong>İzmir</strong><br>Hasan Gürgan-Eski TİP Üyesi  <strong>İzmir</strong><br>Işın Turgut-Nazım Hikmet Kültürevi Sözcüsü, Sosyolog <strong> İzmir</strong><br>İhsan Can Akmarul-Avukat, Adalet İçin Hukukçular <strong> İzmir</strong><br>İzzet Ararat -Eski TİP Üyesi  <strong>İzmir</strong><br>Kenan Yılmaz-Tarihsel TKP üyesi <strong> İzmir</strong><br>Kudret Ulutürk-Eski TİP Üyesi, Emekli Hakim  <strong>İzmir</strong><br>Leyla Yıldız-Eski TKP İşçinin Sesi Üyesi, Demokrat Radyo Kurucusu <strong> İzmir</strong><br>Mehmet Ali Levent-Eski TİP Üyesi, TÜM-DER İzmir Şube Başkanı  <strong>İzmir</strong><br>Mustafa Yakı-Eski DİSK Maden-İş Temsilcisi <strong> İzmir</strong><br>Nesih Doğan-Eski TİP Bismil İlçe Başkanı  <strong>İzmir</strong><br>Nursen Taşer-Eski TİP üyesi  <strong>İzmir</strong><br>Özcan Keçecioğlu-Eski TİP Üyesi, TÜM-DER Muğla Yöneticisi <strong> İzmir</strong><br>Rauf Cankurtaran -Tarihsel TKP Üyesi  <strong>İzmir</strong><br>Rıfat Seyran-Eski TİP Üyesi, TÖS Adana Şube Başkanı <strong> İzmir</strong><br>Savaş Al -Eski TİP GYK Üyesi <strong> İzmir</strong><br>Seher Ünver Bülbül-Eski TİP Üyesi, Eski Eğitim-Sen İzmir Yöneticisi<strong>  İzmir</strong><br>Selma Şen-Eski BES İzmir Şube Başkanı  <strong>İzmir</strong><br>Tahsin İşbilen-Belgesel Sinemacı, Yönetmen  <strong>İzmir</strong><br>Teoman Taşer-Eski TİP Üyesi, TÖB-DER Sözcüsü <strong> İzmir</strong><br>Turan Serin -Tarihsel TKP üyesi  <strong>İzmir</strong><br>Vural Atis-Eski DİSK Maden-İş Ege Bölge Temsilcisi<strong>  İzmir</strong><br>Sargın Arslan-İnşaat Mühendisi  <strong>Karabük</strong><br>Saim Tanrıkulu-Eski TİP Üyesi, Buca ADD Eski Şube Başkanı  <strong>Kars </strong><br>Fırat Kurtal -Kimyager  <strong>Kocaeli</strong><br>Özer Gömeç-Muhasebeci  <strong>Konya</strong><br>Turan Atasever-İnşaat İşçisi  <strong>Konya</strong><br>Ali Toraman-Tekel İşçisi  <strong>Manisa</strong><br>Halil Gümüş-Eski TİP Salihli İlçe Başkanı, Avukat  <strong>Manisa</strong><br>Turan Kayacık-Eski TİP Üyesi, Şair  <strong>Manisa</strong><br>Yumni Kement-Eski TİP Üyesi, TÜM-DER Yöneticisi  <strong>Manisa</strong><br>Bülent Ufuk Ateş-Eski TİP Üyesi, PSAKD Mersin Şube Başkanı  <strong>Mersin</strong><br>Menekşe Özer-PSAKD Mersin Şube YK Üyesi  <strong>Mersin</strong><br>Sinan Eriş-Yüksek Ziraat Mühendisi  <strong> Mersin</strong><br>Deniz Mavitaş-PSAKD Muğla Şube YK Üyesi  <strong>Muğla</strong><br>İskender Doğer-Tarihsel TKP üyesi  <strong>Muğla</strong><br>Mustafa Emre Atmaca-Avukat  <strong>Muğla</strong><br>Mustafa İnce-Eski TİP Üyesi  <strong>Muğla</strong><br>Tahsin Kalay-Eski TİP Üyesi  <strong>Muğla</strong><br>Eray Diriarın- Satış Temsilcisi  <strong>Sakarya</strong><br>Şahin Kışlakçı-Dekorasyon İşçisi  <strong>Sakarya </strong><br>Yasin Eken- Tarihsel TKP üyesi <strong> Siirt</strong><br>Zekeriya Çığır-Tarihsel TKP üyesi, Eski Siirt Belediye Meclis Üyesi  <strong>Siirt</strong><br>Sinan Raci Ergün-Eğitimci, Yayıncı  <strong>Sinop </strong><br>Betül Süel-Çevre Mühendisleri Odası Trakya Temsilcisi <strong> Tekirdağ</strong><br>Birtan Altan -Makina Mühendisleri Odası Çorlu YK Sekreteri <strong> Tekirdağ</strong><br>Buket Çınar-Makina Mühendisleri Odası Çorlu Eski YK Üyesi  <strong>Tekirdağ</strong><br>Emin İşcan -Eski İTÜ Fabrika Komitesi Temsilcisi  <strong>Tekirdağ</strong><br>Emre Ge