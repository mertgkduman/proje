<!doctype html> <html lang="tr"> <head> <meta charset="utf-8" /> <meta http-equiv="X-UA-Compatible" content="IE=edge" /> <meta name="viewport" content="width=device-width, initial-scale=1" />  <meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1" /> <title>Türkiye İşçi Partisi &#039; Gel kardeşim&#039; sloganı ile geliyor!</title><meta name="description" content="Türkiye’nin içinde bulunduğu toplumsal ve siyasal sorunların kimlik ve kültür çatışmalarıyla aşılmasının imkansız olduğunu ve Saray Rejimi’ne karşı mücadelede.." /><link rel="canonical" href="https://abcgazetesi.com.tr/turkiye-isci-partisi-gel-kardesim-slogani-ile-geliyor-283047" /><meta name="Googlebot-News" content="index, follow" /><meta name="articleSection" content="Gündem"><meta name="articleAuthor" content="Hubbard"><meta property="og:title" content="Türkiye İşçi Partisi &#039; Gel kardeşim&#039; sloganı ile geliyor!" /><meta property="og:description" content="Türkiye’nin içinde bulunduğu toplumsal ve siyasal sorunların kimlik ve kültür çatışmalarıyla aşılmasının imkansız olduğunu ve Saray Rejimi’ne karşı mücadelede.."/><meta property="og:type" content="article" /><meta property="og:site_name" content="ABC Haber" /><meta property="og:url" content="https://abcgazetesi.com.tr/turkiye-isci-partisi-gel-kardesim-slogani-ile-geliyor-283047" /><meta property="og:image" content="https://abcgazetesi.com.tr/d/news/0.jpg"/><meta property="og:image:alt" content="Türkiye İşçi Partisi &#039; Gel kardeşim&#039; sloganı ile geliyor!"/><meta property="og:category" content="turkiye"/><meta property="fb:pages" content="1220821564598439"/><meta name="yandex-verification" content="a2537076c3aac0ab"/><meta name="google-site-verification" content="JtMTYuq-zNujIirgbqSspVH9CprnHi9v6UHp9vGpEQs"/><meta name="facebook-domain-verification" content="p9uwmwmndxdftkjf59apannp0tjexp"/><meta name="dmca-site-verification" content="Z0lQa3F1YTVKclhiTjJHdnVLby9OeExNbm9XWU1pNFhXK2w5OHZRVDRBOD01"/><met