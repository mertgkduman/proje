Query HENUZ TANIMLI OLMAYABILIR. Bu yuzden saf JavaScript kullaniliyor; ayrica fonksiyon adi benzersiz (abcAddComment) oldugu icin paket onu ezemez. */ (function () { /* --- YAMA 2026-11-15 (II): SONSUZ AKISTA TEKRAR KURULUM --- Sonsuz kaydirma (cm-infinity-scroll) sonraki haberi AJAX ile cekip jQuery .append() ile ekler; jQuery eklenen HTML icindeki <script>'i CALISTIRIR. PHP'nin __abcCommentJsPrinted bayragi ISTEK BASINA oldugu icin her parca bu bloku yeniden basar. Koruma olmadan her kaydirmada document'e bir captcha-yenileme dinleyicisi daha ekleniyor, kodu yenilemek icin tek tiklama N istek tetikliyordu (ayni anahtara N kod uretme yarisi). Tanim zaten ayni; ilk kurulum yeterli. */ if (window.__abcCommentKurulum) { return; } window.__abcCommentKurulum = true; function q(sel, root) { return (root || document).querySelector(sel); } function setMsg(form, text, kind) { var el = q('.mesaj', form); if (!el) { el = document.createElement('span'); form.insertBefore(el, form.firstChild); } /* "mesaj" sinifi KORUNUR; eski kod removeClass() ile onu da siliyordu ve mesaj bir daha guncellenemiyordu. */ el.className = 'mesaj alert alert-' + kind; el.textContent = text; el.style.display = 'block'; } function refreshCaptcha(form, postId) { var img = q('.guvenlik_image', form); if (img) { img.src = '/inc/image.php?p=' + postId + '&t=' + Date.now(); } var code = q('input[name="guvenlik_code"]', form); if (code) { code.value = ''; } } /* Gonderilen yorumu listeye ekle; yayinda degilse "onay bekliyor" olarak */ function addToList(postId, c, pending) { var box = document.getElementById('comments-' + postId); if (!box) { return false; } box.style.display = ''; var ul = q('ul.items', box); if (!ul) { ul = document.createElement('ul'); ul.className = 'items'; box.appendChild(ul); } var li = document.createElement('li'); li.className = 'level0' + (pending ? ' abc-pending' : ''); var u = document.createElement('span'); u.className = 'u'; var n = document.createElement('span'); n.className = 'n'; n.textContent = c.member_name || 'Okur'; u.appendChild(n); u.appendChild(document.createTextNode(' / ' + (c.formatted_date || ''))); li.appendChild(u); var p = document.createElement('p'); p.textContent = String(c.comment_content || '').replace(/<br\s*\/?>/gi, '\n'); li.appendChild(p); if (pending) { var b = document.createElement('span'); b.className = 'abc-pending-badge'; b.textContent = 'Onay bekliyor — yönetici onayladıktan sonra yayınlanacak'; li.appendChild(b); } ul.insertBefore(li, ul.firstChild); if (!pending) { var cap = q('.caption span', box); if (cap) { var m = cap.textContent.match(/\((\d+)\)/); if (m) { cap.textContent = cap.textContent.replace(/\(\d+\)/, '(' + (parseInt(m[1], 10) + 1) + ')'); } } } li.scrollIntoView({ behavior: 'smooth', block: 'center' }); return true; } window.abcAddComment = function (form, type, postId) { var btn = q('.comment_submit', form); if (form.__abcBusy) { return false; } form.__abcBusy = true; if (btn) { btn.disabled = true; } var base = (typeof BURL !== 'undefined' && BURL) ? BURL : '/'; var body = new URLSearchParams(new FormData(form)).toString(); fetch(base + 'x_comment_add.php?type=' + encodeURIComponent(type) + '&id=' + encodeURIComponent(postId), { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' }, body: body }).then(function (r) { return r.json(); }).then(function (res) { var msg = (res && res.message && res.message.length) ? res.message.join(' ') : 'Beklenmeyen bir yanıt alındı.'; if (res && res.result) { var pending = !res.approved; var ta = q('textarea[name="comment_content"]', form); var nameEl = q('input[name="member_name"]', form); addToList(postId, res.comment || { member_name: nameEl ? nameEl.value : '', comment_content: ta ? ta.value : '', formatted_date: '' }, pending); setMsg(form, msg, pending ? 'warning' : 'success'); if (ta) { ta.value = ''; } /* basarida temizle */ var rt = q('.reply_to', form); if (rt) { rt.innerHTML = ''; } var rp = q('input[name="reply"]', form); if (rp) { rp.value = '0'; } } else { /* HATA: mesaji goster, KULLANICININ YAZDIGINI KORU */ setMsg(form, msg, 'warning'); } refreshCaptcha(form, postId); }).catch(function (err) { setMsg(form, 'Yorum gönderilemedi. Lütfen tekrar deneyin.', 'danger'); refreshCaptcha(form, postId); if (window.console) { console.error('abcAddComment', err); } }).then(function () { form.__abcBusy = false; if (btn) { btn.disabled = false; } }); return false; }; /* Eski cagiranlar icin: paket yuklendikten sonra da bizi isaret etsin */ function abcInstall() { window.addComment = window.abcAddComment; } abcInstall(); document.addEventListener('DOMContentLoaded', abcInstall); window.addEventListener('load', abcInstall); /* Guvenlik kodu gorseline tiklayinca yenile */ document.addEventListener('click', function (e) { var t = e.target; if (t && t.classList && t.classList.contains('guvenlik_image')) { t.src = '/inc/image.php?p=' + (t.getAttribute('data-p') || '') + '&t=' + Date.now(); } }); })();</script><style>.comment_add .mesaj{display:none} .comment_add .mesaj.alert-success{display:block;margin-bottom:10px;background:#e6f6ea;border:1px solid #b7e3c3;color:#1b6b32;padding:9px 12px;border-radius:6px} .comment_add .mesaj.alert-warning{display:block;margin-bottom:10px;background:#fff8e1;border:1px solid #f2e2b5;color:#8a6100;padding:9px 12px;border-radius:6px} .comment_add .mesaj.alert-danger{display:block;margin-bottom:10px;background:#fdecea;border:1px solid #f5c2c0;color:#a32019;padding:9px 12px;border-radius:6px} .comments li.abc-pending{opacity:.85;border-left:3px solid #e0a800;padding-left:10px} .abc-pending-badge{display:inline-block;margin-top:6px;background:#fff3cd;color:#8a6100;border:1px solid #f2e2b5;border-radius:4px;padding:2px 8px;font-size:11.5px}</style> <div class="comments cm-comment" id="comments-283047" data-id="283047" data-type="1" data-list="6" style="display:none"> <div class="caption"><i class="icon-chat-1"></i><span>(0