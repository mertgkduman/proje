    transition:opacity .2s ease, transform .2s ease, box-shadow .2s ease; z-index:1030;
  }
  .back-to-top.show{opacity:1; pointer-events:auto; transform:translateY(0);}
  .back-to-top:hover{box-shadow:0 8px 24px rgba(0,0,0,.2);}
</style>

