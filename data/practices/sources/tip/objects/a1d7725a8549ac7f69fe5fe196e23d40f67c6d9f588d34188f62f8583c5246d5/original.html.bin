                    <span class="ms-2 badge bg-light text-dark border hit-badge d-none">0</span>
                  </a>
                                  <a class="nav-link py-1 px-2 rounded toc-link d-flex align-items-center" href="#1-bolum-parti-programi">
                    <span class="flex-grow-1">1. Bölüm: Parti Programı</span>
