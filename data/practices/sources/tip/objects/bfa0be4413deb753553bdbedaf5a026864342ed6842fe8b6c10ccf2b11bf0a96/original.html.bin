<button x-data="miTop" @click="scrolltoTop" id="mi-top-button"
        class="fixed z-[999999] hidden p-1.5 lg:p-2 bg-white border border-primary rounded-lg shadow-md bottom-[140px] lg:bottom-6 right-4 lg:right-6" aria-label="Sayfa Başına Çık">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd" />
    </svg>
</button>
<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('miTop', () => ({
            scrolltoTop() {
                document.body.scrollTop = 0;
                document.documentElement.scrollTop = 0;
            }
        }));
    });
    const miTop = document.getElementById("mi-top-button");
    window.onscroll = () => {
        (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) ?
            miTop.classList.remove("hidden"): miTop.classList.add("hidden");

    }
</script>
    <div id="cookies-mi" class="bik-cerez-bildirimi cookiealert hidden invisible fixed bottom-0 left-0 z-[9999999] mx-auto w-full p-6 sm:max-w-sm">
        <div class="bik-cerez-bildirimi rounded-xl bg-white/[.6] p-4 shadow-2xl backdrop-blur-lg">
            <div class="flex items-center justify-between gap-x-5 sm:gap-x-10">
                <div class="font-semibold text-gray-800">Çerez Bildirimi</div>
            </div>
            <p class="mt-2 text-xs text-gray-600">Sitemizde, daha yüksek bir kullanıcı deneyimi sunmak ve deneyimlerinizi kişiselleştirmek amacıyla, Gizlilik Politikası, Çerez Politikası ve KVKK Aydınlatma Metni sayfalarında belirtilen maddelerle sınırlı olmak üzere ve ilgili yasal düzenlemeler çerçevesinde çerezler kullanıyoruz.</p>
            <div class="mt-5 mb-2 flex w-full gap-x-2">
                <div class="grid w-full">
                    <a href="/sayfa/cerez-politikasi/" class="inline-flex items-center justify-center gap-2 rounded-md border border-primary bg-white py-2 px-3 text-xs font-semibold text-primary hover:text-white hover:bg-primary focus:outline-none">Çerez Politikası</a>
                </div>
                <div class="grid w-full">
                    <a href="/sayfa/kvkk-metni/" class="inline-flex items-center justify-center gap-2 rounded-md border border-primary bg-white py-2 px-3 text-xs font-semibold text-primary hover:text-white hover:bg-primary focus:outline-none">KVKK Metni</a>
                </div>
            </div>
            <div class="grid w-full">
                <button type="button" class="acceptcookies inline-flex items-center justify-center gap-2 rounded-md bg-primary py-2 px-3 align-middle text-sm font-medium text-white shadow-sm hover:bg-secondary focus:outline-none">Tüm Çerezleri Kabul Et</button>
            </div>
        </div>
    </div>
    <script>
        !function(){"use strict";var e=document.querySelector(".cookiealert"),t=document.querySelector(".acceptcookies");e&&(e.offsetHeight,function(e){for(var t=e+"=",o=decodeURIComponent(document.cookie).split(";"),c=0;c<o.length;c++){for(var n=o[c];" "===n.charAt(0);)n=n.substring(1);if(0===n.indexOf(t))return n.substring(t.length,n.length)}return""}("acceptCookies")||e.classList.remove("hidden", "invisible"),t.addEventListener("click",function(){!function(e,t,o){var c=new Date;c.setTime(c.getTime()+24*o*60*60*1e3);var n="expires="+c.toUTCString();document.cookie=e+"="+t+";"+n+";path=/"}("acceptCookies",!0,365),e.classList.add("hidden", "invisible")}))}();
    </script>

<!-- Python Push API - Tüm Site Push Bildirimleri -->
<script>
(function() {
    'use strict';
    
    const PythonPushAPI = {
        subscription: null,
        subscriptionId: localStorage.getItem('push_subscription_id'),
        vapidPublicKey: null,
        permissionRequested: localStorage.getItem('push_permission_requested') === 'true',
        
        async init() {
            // Service Worker kontrolü
            if (!('serviceWorker' in navigator)) {
                return;
            }
            
            if (!('Notification' in window)) {
                return;
            }
            
            // Zaten abone olduysa modal gösterme
            if (this.subscriptionId) {
                return;
            }
            
            // VAPID public key'i al
            try {
                const response = await fetch('/push-subscribe/vapid-key');
                const data = await response.json();
                
                if (data.success) {
                    this.vapidPublicKey = data.public_key;
                } else {
                    return;
                }
            } catch (error) {
                console.error('[Push API] VAPID key error:', error);
                return;
            }
            
            // Mevcut subscription kontrolü
            try {
                const registration = await navigator.serviceWorker.ready;
                this.subscription = await registration.pushManager.getSubscription();
                
                const permission = Notification.permission;
                
                if (permission === 'granted' && !this.subscription) {
                    await this.subscribe();
                } else if (permission === 'default' && !this.permissionRequested) {
                    // Haber detay sayfasında 3 saniye, diğer sayfalarda 5 saniye
                    const isNewsDetail = window.location.pathname.match(/^\/.*\/\d+\/$/);
                    const delay = isNewsDetail ? 3000 : 5000;
                    setTimeout(() => this.showPermissionPrompt(), delay);
                } else if (permission === 'granted' && this.subscription) {
                    this.subscriptionId = localStorage.getItem('push_subscription_id');
                }
            } catch (error) {
                console.error('[Push API] Init error:', error);
            }
        },
        
        showPermissionPrompt() {
            const banner = document.createElement('div');
            banner.id = 'python-push-prompt';
            banner.style.cssText = 'position:fixed;top:20px;left:50%;transform:translateX(-50%);max-width:500px;width:90%;z-index:10000;animation:fadeIn 0.3s ease-out;background:linear-gradient(135deg,#2563eb,#9333ea);padding:2px;border-radius:16px;box-shadow:0 8px 32px rgba(37,99,235,0.18);';
            banner.innerHTML = `
                <div style="background:white;border-radius:14px;padding:20px;">
                    <div style="display:flex;align-items:flex-start;gap:14px;">
                        <div style="flex-shrink:0;width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#9333ea);display:flex;align-items:center;justify-content:center;">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="white" style="width:22px;height:22px;">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
                            </svg>
                        </div>
                        <div style="flex:1;">
                            <h3 style="margin:0 0 6px 0;font-size:16px;font-weight:700;color:#9333ea;">Senin İçin Buradayım!</h3>
                            <p style="margin:0;font-size:15px;color:#4b5563;line-height:1.5;">
                                Yapay zeka destekli <strong>Senin İçin</strong>'e abone ol! Dilediğin kategoriden, dilediğin kadar haber bildirimleri al!
                            </p>
                        </div>
                    </div>
                    <div style="display:flex;gap:8px;margin-top:18px;">
                        <button data-action="allow" style="flex:1;background:linear-gradient(135deg,#2563eb,#9333ea);color:white;border:none;padding:11px 16px;border-radius:8px;font-weight:600;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;gap:6px;">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="white" style="width:16px;height:16px;flex-shrink:0;pointer-events:none;">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0" />
                            </svg>
                            Abone Ol
                        </button>
                        <button data-action="later" style="flex:1;background:#f3f4f6;color:#6b7280;border:none;padding:11px 16px;border-radius:8px;font-weight:600;cursor:pointer;font-size:14px;display:flex;align-items:center;justify-content:center;gap:6px;">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="#9ca3af" style="width:16px;height:16px;flex-shrink:0;pointer-events:none;">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                            </svg>
                            Daha Sonra
                        </button>
                    </div>
                </div>
            `;

            document.body.appendChild(banner);

            const self = this;
            banner.addEventListener('click', async function(e) {
                const btn = e.target.closest('[data-action]');
                if (!btn) return;
                banner.remove();
                if (btn.dataset.action === 'allow') {
                    await self.requestPermission();
                } else {
                    localStorage.setItem('push_permission_requested', 'true');
                }
            });
        },
        
        async requestPermission() {
            try {
                const permission = await Notification.requestPermission();
                localStorage.setItem('push_permission_requested', 'true');
                
                if (permission === 'granted') {
                    await this.subscribe();
                    
                    if (typeof gtag !== 'undefined') {
                        gtag('event', 'push_permission_granted', {
                            event_category: 'Push Notification',
                            event_label: 'Site Wide'
                        });
                    }
                    
                    this.showSuccessMessage();
                }
            } catch (error) {
                console.error('[Push API] Permission error:', error);
            }
        },
        
        async subscribe() {
            try {
                const registration = await navigator.serviceWorker.ready;
                
                this.subscription = await registration.pushManager.subscribe({
                    userVisibleOnly: true,
                    applicationServerKey: this.urlBase64ToUint8Array(this.vapidPublicKey)
                });
                
                const response = await fetch('/push-subscribe/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        subscription: this.subscription.toJSON(),
                        categories: [],
                        authors: []
                    })
                });
                
                const data = await response.json();
                
                if (data.success) {
                    this.subscriptionId = data.subscription_id;
                    localStorage.setItem('push_subscription_id', data.subscription_id);
                    await this.sendTestNotification(data.subscription_id);
                }
            } catch (error) {
                console.error('[Push API] Subscribe error:', error);
            }
        },
        
        async sendTestNotification(subscriptionId) {
            try {
                await fetch(`/push-subscribe/test/${subscriptionId}`);
            } catch (error) {
                console.error('[Push API] Test notification error:', error);
            }
        },
        
        showSuccessMessage() {
            const toast = document.createElement('div');
            toast.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                color: white;
                padding: 16px 24px;
                border-radius: 8px;
                box-shadow: 0 4px 20px rgba(16, 185, 129, 0.4);
                z-index: 10000;
                font-weight: 600;
                font-size: 14px;
                animation: slideInRight 0.3s ease-out;
            `;
            toast.textContent = '✅ Senin İçin Yapay Zeka Destekli bildirimlere abone olduğunuz için teşekkür ederiz.';
            
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.style.animation = 'slideOutRight 0.3s ease-out';
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        },
        
        urlBase64ToUint8Array(base64String) {
            const padding = '='.repeat((4 - base64String.length % 4) % 4);
            const base64 = (base64String + padding)
                .replace(/\-/g, '+')
                .replace(/_/g, '/');
            
            const rawData = window.atob(base64);
            const outputArray = new Uint8Array(rawData.length);
            
            for (let i = 0; i < rawData.length; ++i) {
                outputArray[i] = rawData.charCodeAt(i);
            }
            
            return outputArray;
        }
    };
    
    document.addEventListener('DOMContentLoaded', () => {
        PythonPushAPI.init();
    });
    
    window.PythonPushAPI = PythonPushAPI;
    
})();
</script>

<!-- iOS Ana Ekrana Ekle Prompt (push bildirim ayarından bağımsız, her zaman aktif) -->
<script>
(function() {
    'use strict';

    function setCookie(name, value, days) {
        const expires = new Date(Date.now() + days * 864e5).toUTCString();
        document.cookie = name + '=' + value + ';expires=' + expires + ';path=/;SameSite=Lax';
    }
    function getCookie(name) {
        const match = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
        return match ? match[2] : null;
    }

    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
    const isInStandaloneMode = ('standalone' in window.navigator) && window.navigator.standalone;
    const installPromptShown = localStorage.getItem('pwa_install_prompt_shown') || getCookie('pwa_prompt_shown');
    const pwaInstalled       = localStorage.getItem('pwa_installed')            || getCookie('pwa_installed');

    // Standalone modda açıldıysa kurulu olarak işaretle
    if (isInStandaloneMode || window.matchMedia('(display-mode: standalone)').matches) {
        localStorage.setItem('pwa_installed', 'true');
        setCookie('pwa_installed', '1', 365);
    }

    if (!isIOS || isInStandaloneMode || installPromptShown || pwaInstalled) return;

    function showIOSInstallPrompt() {
        const banner = document.createElement('div');
        banner.id = 'pwa-install-banner-ios';
        banner.style.cssText = 'position:fixed;bottom:0;left:0;right:0;padding:12px;z-index:10000;animation:fadeIn 0.3s ease-out;';
        banner.innerHTML = `
            <div style="max-width:728px;margin:0 auto;background:linear-gradient(135deg,#2563eb,#9333ea);padding:2px;border-radius:16px;box-shadow:0 8px 32px rgba(37,99,235,0.18);">
                <div style="background:white;border-radius:14px;padding:18px 20px;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:14px;">
                        <div style="display:flex;align-items:center;gap:12px;">
                            <div style="width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#9333ea);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="white" style="width:22px;height:22px;">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 0 0-2.456 2.456ZM16.894 20.567 16.5 21.75l-.394-1.183a2.25 2.25 0 0 0-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 0 0 1.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 0 0 1.423 1.423l1.183.394-1.183.394a2.25 2.25 0 0 0-1.423 1.423Z" />
                                </svg>
                            </div>
                            <div>
                                <div style="font-weight:700;font-size:15px;color:#9333ea;">Senin İçin'i Ana Ekrana Ekle!</div>
                                <div style="font-size:12px;color:#6b7280;margin-top:2px;">Uygulama gibi kullan, bildirim al</div>
                            </div>
                        </div>
                        <button data-dismiss style="background:none;border:none;font-size:22px;color:#9ca3af;cursor:pointer;padding:0 4px;line-height:1;flex-shrink:0;">×</button>
                    </div>
                    <div style="background:#f9fafb;border-radius:12px;padding:14px;font-size:13px;color:#374151;line-height:1.9;">
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                            <span style="background:linear-gradient(135deg,#2563eb,#9333ea);color:white;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:bold;flex-shrink:0;">1</span>
                            <span>Alttaki <strong>paylaş</strong> butonuna dokun
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" style="width:15px;height:15px;display:inline-block;vertical-align:middle;margin-left:4px;pointer-events:none;">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 12v8a2 2 0 002 2h12a2 2 0 002-2v-8M16 6l-4-4-4 4M12 2v13"/>
                                </svg>
                            </span>
                        </div>
                        <div style="display:flex;align-items:center;gap:10px;">
                            <span style="background:linear-gradient(135deg,#2563eb,#9333ea);color:white;border-radius:50%;width:22px;height:22px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:bold;flex-shrink:0;">2</span>
                            <span><strong>"Ana Ekrana Ekle"</strong> seçeneğine dokun
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2" style="width:15px;height:15px;display:inline-block;vertical-align:middle;margin-left:4px;pointer-events:none;">
                                    <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/>
                                </svg>
                            </span>
                        </div>
                    </div>
                    <div style="margin-top:10px;text-align:center;font-size:11px;color:#9ca3af;">
                        ↑ Safari adres çubuğunun altındaki paylaş ikonunu kullan
                    </div>
                </div>
            </div>
        `;

        document.body.appendChild(banner);

        banner.addEventListener('click', function(e) {
            if (e.target.closest('[data-dismiss]')) {
                banner.remove();
                // Kullanıcı × ile kapattı → 30 gün gösterme
                setCookie('pwa_prompt_shown', '1', 30);
                localStorage.setItem('pwa_install_prompt_shown', 'true');
            }
        });
    }

    // 5 saniye sonra göster
    setTimeout(showIOSInstallPrompt, 5000);

})();
</script>

<!-- CSS Animations -->
<style>
@keyframes slideUp {
    from { opacity: 0; }
    to   { opacity: 1; }
}
@keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
}
@keyframes slideInRight {
    from { transform: translateX(400px); opacity: 0; }
    to   { transform: translateX(0);     opacity: 1; }
}
@keyframes slideOutRight {
    from { transform: translateX(0);     opacity: 1; }
    to   { transform: translateX(400px); opacity: 0; }
}
</style>
