  <div align=center>
  <table class=MsoNormalTable border=0 cellspacing=0 cellpadding=0 width=586
   style='width:439.45pt;border-collapse:collapse;mso-yfti-tbllook:480;
   mso-padding-alt:0cm 5.4pt 0cm 5.4pt'>
   <tr style='mso-yfti-irow:0;mso-yfti-firstrow:yes;height:15.85pt'>
    <td width=195 style='width:146.55pt;border:none;border-bottom:solid #660066 1.0pt;
    mso-border-bottom-alt:solid #660066 .5pt;padding:0cm 5.4pt 0cm 5.4pt;
    height:15.85pt'>
    <p class=MsoNormal style='line-height:12.0pt;mso-line-height-rule:exactly;
    tab-stops:1.0cm center 49.7pt 177.15pt right 326.0pt'><span
    style='font-size:8.0pt;font-family:Arial'>26 Kasım 2022 CUMARTESİ<o:p></o:p></span></p>
    </td>
    <td width=195 style='width:146.55pt;border:none;border-bottom:solid #660066 1.0pt;
    mso-border-bottom-alt:solid #660066 .5pt;padding:0cm 5.4pt 0cm 5.4pt;
    height:15.85pt'>
    <p class=MsoNormal align=center style='text-align:center;line-height:12.0pt;
    mso-line-height-rule:exactly;tab-stops:1.0cm center 49.7pt 177.15pt right 326.0pt'><b
