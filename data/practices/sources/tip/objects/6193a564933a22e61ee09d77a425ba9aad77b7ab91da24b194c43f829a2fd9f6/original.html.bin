<!DOCTYPE html><html><head>    <meta name="viewport" content="width=device-width" /> 
 <meta http-equiv="Content-Type" content="text/html; charset=ISO-8859-9">   <style>        .MsoNormal {            margin: 0 3.0pt 0 1.0pt;            text-align: center;            text-indent: 1.0pt;        }        .spnStyle {            font-size: 18.0pt;            line-height: 150%;        }        #tblTbmmOylama td, #tblTbmmOylama th {            padding: 5px;            border: 1px solid black;        }        #tblTbmmOylama tbody tr:nth-child(even) {            background-color: #eee;        }        #tblTbmmOylama th {            text-align: center;        }        button.accordion {            background-color: #fff;            color:#000aff;            cursor: pointer;            padding: 10px;            width: 100%;            border: none;            text-align: left;            outline: none;            transition: 0.4s;        }            button.accordion.active, button.accordion:hover {                background-color: #ddd;            }        div.panel {            display: none;            background-color: white;            transition: max-height 0.2s ease-out;        }    </style></head><body>    <div>        <p class="MsoNormal" align="center">            <b>                <span class="spnStyle">TÜRKİYE BÜYÜK MİLLET MECLİSİ</span>            </b>        </p>        <p class="MsoNormal" align="center">            <b>                <span class="spnStyle"> AÇIK OYLAMA SONUÇLARI </span>            </b>        </p>        <p class="MsoNormal" align="center">            <b>                <span class="spnStyle">41&#39;inci Birleşim</span>            </b>        </p>        <p class="MsoNormal" align="center">            <b>                <span class="spnStyle">2 Ocak 2020 Perşembe</span>            </b>        </p>    </div>    <br />    <br />    <div id="bas">            <h2>Kabul Edilenler</h2>                <button class="accordion"><span style="font-weight:bold;color:#000"> 1.</span> Libya&#39;ya Asker Gönderme Tezkeresi Açık Oylama Sonuc