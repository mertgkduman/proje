    <div class="printable-area page-taxonomy-term-56" dir="ltr">
      <div class="entry-content" data-io-article-url="https://www.indyturk.com/node/507986/siyaset/erkan-ba%C5%9F-ya%C5%9Fanan-bar%C4%B1nma-krizi-bir-siyasal-sistem-krizidir">
        <script>
