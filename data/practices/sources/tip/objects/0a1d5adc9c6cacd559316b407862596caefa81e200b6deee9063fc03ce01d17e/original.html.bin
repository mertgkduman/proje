    <script type="application/javascript">
        $.getJSON('https://api.ipify.org?format=jsonp&callback=?', function (data) {
            var IPdata = data.ip.split('.').slice(0, 3).join(".");
            if (IPdata === "212.156.72") {
                $('#intranet').show();
            }
            if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
                $('#intranet').hide();
            }
        });
    </script>

    <script>
        $(document).ready(function () {
            /*
            var control = true;
            var d = new Date();
            var tarih = d.toISOString().split("T")[0];
            var saat = d.getHours();
            var dakika = d.getMinutes();
            var segment1 = window.location.href.split("/")[3];

            if ((tarih === "2025-07-04") && control) {
                $("#bTwi").trigger('click');
            }
            */

            var currentPath = window.location.pathname;
            var isHomepage = currentPath === "/" || currentPath === "/tr/anasayfa" || currentPath === "/en/home-page";
            var popupShown = sessionStorage.getItem('popupShown');
            
            if (isHomepage || !popupShown) {
                $("#bTwi").trigger('click');
                
                if (!isHomepage) {
                    sessionStorage.setItem('popupShown', 'true');
                }
            }
            
            $("#exampleModal").on('hidden.bs.modal', function (e) {
                var iframe = $("#exampleModal iframe");
                iframe.attr("src", iframe.attr("src"));
            });
        });
    </script>

   
    <script>
        $(document).ready(function() {
            // Generate document links dynamically - only for the first button of each type
            $('.btn-word:first').attr('href', '/api/DocumentGenerator/GenerateDocument?nodeId=92294&format=docx');
            $('.btn-pdf:first').attr('href', '/api/DocumentGenerator/GenerateDocument?nodeId=92294&format=pdf');
            
            // Share dropdown toggle
            $('#shareDropdownBtn').on('click', function(e) {
                e.stopPropagation();
                $('#shareDropdownMenu').toggle();
            });
            
            // Close dropdown when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('#shareDropdownBtn, #shareDropdownMenu').length) {
                    $('#shareDropdownMenu').hide();
                }
            });
        });
    </script>


   
