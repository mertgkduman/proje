<script>
    $.fn.mousetip = function(tip, x, y) {
        var $this = $(this);
        $this.hover(function() {
            var city        = $(this).find('text').data('city');
            var c_url        = $(this).find('text').data('url');
            var sandik      = ($(this).find('text').data('sandik')) == undefined ? '0' : ($(this).find('text').data('sandik'));
            var p1o         = $(this).find('text').data('p1o');
            var p1a         = $(this).find('text').data('p1a');
            var p1i         = $(this).find('text').data('p1i');
            var p2o         = $(this).find('text').data('p2o');
            var p2a         = $(this).find('text').data('p2a');
            var p2i         = $(this).find('text').data('p2i');
            var p1s         = $(this).find('text').data('p1s');
            var p2s         = $(this).find('text').data('p2s');
            var pop = '' +
                '<div class="tip">'+
                '<div class="city">' +
                '<span class="city-name"><a href="'+ c_url +'">'+ city +'</a></span>'+
                '<span class="sandik">Açılan Sandık '+ sandik +'</span>'+
                '</div>'+(sandik!='%0,00'?
                    '<div class="party">'+
                    '<span class="party-icon"><img src="'+ p1i +'" /><span class="_ponb '+p1s+'" data-percentage="'+p1o+'"><span class="c-progress '+p1s+'" style="width: '+p1o+'"></span><span>' + p1a +  ' ' + p1o + '</span></span></span>' +
                    '<span class="party-icon"><img src="'+ p2i +'" /><span class="_ponb '+p2s+'" data-percentage="'+p2o+'"><span class="c-progress '+p2s+'" style="width: '+p2o+'"></span><span>' + p2a +  ' ' + p2o + '</span></span></span>' +
                    '</div>':'')+
                '</div>';
            $('body').append(pop);
        }, function() {
            $('body').find('.tip').remove();
        }).mousemove(function(e) {
            var mouseX = e.pageX + (x || 10);
            var mouseY = e.pageY + (y || 10);
            $('.tip').show().css({
                top:mouseY, left:mouseX
            });
        });
    };
    $('.place').mousetip('.tip', -50, 30);
    $('.place').click(function () {
        location.href=$(this).find('text').data('url');
    });

    $(document).ready(function() {
        $(".person-progress .progress-bar").each(function () {
            var width = $(this).data("progress");
            $(this).css("width", width);
        });

        $(".scroller").click(function () {
           var t = $(this).data('target');
           $('html, body').animate({scrollTop:$(t).offset().top}, 'slow');
        });

        $(".btn-toggle").click(function() {
            var t = $(this).data("target");
            $(".map,.list-unstyled:not(.ana-sayfa), .stat, .status:not(.ana-sayfa)").hide();
            $(t).show();
           $(this).closest(".button-group").find(".btn-toggle").removeClass("selected");
           $(this).addClass("selected");
        });

        if ($(".resfresh-status").length > 0) {
            var loadingSec = 60;
            var loadingValue = 0;
            function barAnim(){
                loadingValue += 1;
                $( ".progress-bar.resfresh-status" ).css( "width", Math.round(loadingValue * (100/loadingSec)) + "%");
                if(loadingValue >= loadingSec){
                    //window.location.reload();
                }
                return setTimeout(barAnim, 1000);
            }
            barAnim();
        }
    } );
</script>
</body>
</html>
