<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=ISO-8859-9">
<title>Türkiye Büyük Millet Meclisi</title>
<style type="text/css">
BODY{
  FONT-FAMILY:Verdana, Tahoma, Arial;
  font-size:12px;
  background-color:#ffffff;
}

.backG {
  FONT-FAMILY:Verdana, Tahoma, Arial;
  background-color:#93c39b; 
  color:#ffffff; 
  border-bottom:#538c4d 2px solid;
  font-size:12px;
}  

body,td,th {
  FONT-FAMILY:Verdana, Tahoma, Arial;
  font-size: 12px;
  color: #4B555E;
}
body {
  background-image: url(https://www5.tbmm.gov.tr/resimler/back.gif);
}

input,textarea,select,file{
background:  url("https://www5.tbmm.gov.tr/resimler/shadeform.jpg");

}
a:link {
  color: #689BA2;
  text-decoration: none;
}
a:visited {
  text-decoration: none;
  color: #689BA2;
}
a:hover {
  text-decoration: none;
  color: #FF0000;
}
a:active {
  text-decoration: none;
  color: #FF0000;
}

td.form1
{
  FONT-FAMILY:Verdana, Tahoma, Arial;
  background:#eaeaea;
  font-size:12px;
}


.hint {
     display: none;
    position: absolute;
    right: 40px;
    width: 200px;
    margin-top: -1px;
    border: 1px solid #4F8EB6;
    background: #DCE9F0  no-repeat -10px 5px; 
    padding-left:5px; padding-right:5px; padding-top:6px; padding-bottom:6px
}

/* The pointer image is hadded by using another span */
.hint .hint-pointer {
    position: absolute;
    left: -1px;
    top: 5px;
    width: 10px;
    height: 19px;
}


</style>  
</head>

