                                    <div class="col">
                                        <div class="card mb-2">
                                            <a id="ctl00_ctl51_g_e34bf129_076d_4bef_98e6_8846f26e7f8b_rpt_sonHaberler_ctl06_lnk_resim" href="https://yozgat.tarimorman.gov.tr/Haber/842/Okul-Ve-Kurumlardaki-Gida-Isletmelerinde-Calisan-Personele-Hijyen-Egitimi"><img id="ctl00_ctl51_g_e34bf129_076d_4bef_98e6_8846f26e7f8b_rpt_sonHaberler_ctl06_img_resim" class="card-img-top img-fluid" alt="..." src="/FotografGalerisi/G%c4%b1da%20Hijyen%20E%c4%9fitimi/4f9c2ff2-ec84-463d-8c0a-6627b2fe7e50.jpg?RenditionID=2" /></a>
