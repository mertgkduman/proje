                                    <button type="button" onclick="axPlaySpeech()" title="Oynat">▶ Oynat
                                    </button>
                                    <button type="button" onclick="axPauseSpeech()" title="Duraklat">⏸ Duraklat
                                    </button>
                                    <button type="button" onclick="axStopSpeech()" title="Sustur">🔄 Sustur
