        .report-item h5 {
            font-size: 16px;
            font-weight: 500;
            margin: 20px 0;
            transition: all .3s ease;
            position: relative;
            padding-top: 5px;
        }
        .report-item:hover h5 {
            color:#008ad1;
        }
        .report-item .btn {
            margin-bottom: 10px;
        }
        .report-item h5:before {
            content: "";
            position: absolute;
            left: 0;
            top: -7px;
            transform: translateY(-50%);
            width: 23%;
            height: 2px;
            background-color: #008ad1;
            transition: all .3s ease;
        }
        .report-item .btn-outline-success {
            color: #008ad1;
            background-color: transparent;
            background-image: none;
