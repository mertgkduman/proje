                                <span class="itemAuthor">
                                    <a id="ctl00_ctl51_g_f88239ec_0d3e_4407_909d_19b0270f6408_lnk_arsivadres" class="arsivTumu" href="https://ardahan.tarimorman.gov.tr/Sayfalar/Arsiv.aspx?Liste=Haber">Arşiv</a></span>
