  <p class=MsoNormal style='margin-bottom:0cm;margin-bottom:.0001pt;text-align:
  justify;line-height:normal'><span style='font-size:10.0pt;font-family:"Times New Roman",serif'>Defterdar
  Yardımcısı</span></p>
  </td>
 </tr>
 <tr style='height:20.2pt'>
  <td width=47 valign=top style='width:35.2pt;border:solid windowtext 1.0pt;
  border-top:none;padding:0cm 5.4pt 0cm 5.4pt;height:20.2pt'>
