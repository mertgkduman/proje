                        <div class="col-6 col-md-3 mb-20">
                          <h4 class="simple-title" style="font-weight: 700; margin-bottom: 12px; font-size: 13px; color: #ffffff; letter-spacing: 0.5px;">ACİL NUMARALAR</h4>
                          <ul class="list-unstyled" style="padding-left: 0; line-height: 2; font-size: 12px; list-style: none; margin-top: 0;">
                            <li style="margin-bottom: 6px;">
                              <i class="fa fa-caret-right" style="margin-right: 6px; opacity: 0.8;"></i>
                              <a href="tel:180" class="color-1white">
                                <strong style="color: #ffffff;">180</strong> / Tarım İletişim Merkez
                              </a>
                            </li>
