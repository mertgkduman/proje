  let refreshTimer = null;

  function isExcludedPage() {
    const pathname = window.location.pathname
      .toLowerCase()
      .replace(/\/+$/, "");

    return EXCLUDED_PATHS.some(function (excludedPath) {
      return (
        pathname === excludedPath ||
        pathname.startsWith(excludedPath + "/")
      );
    });
  }

  function hasMedia() {
    return MEDIA_SELECTORS.some(function (selector) {
      return document.querySelector(selector) !== null;
    });
  }

  function isMediaPlaying() {
    return Array.from(document.querySelectorAll("video, audio")).some(
      function (media) {
        return !media.paused && !media.ended;
      }
    );
  }

  function isUserEditing() {
    const element = document.activeElement;

    if (!element) {
      return false;
    }

    const tagName = element.tagName.toLowerCase();

    return (
      tagName === "input" ||
      tagName === "textarea" ||
      tagName === "select" ||
      element.isContentEditable
    );
  }

  function canRefresh() {
    return (
      document.readyState === "complete" &&
      !document.hidden &&
      navigator.onLine &&
      !isExcludedPage() &&
      !hasMedia() &&
      !isMediaPlaying() &&
      !isUserEditing()
    );
  }

  function saveScrollPosition() {
    try {
      sessionStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          x: window.scrollX,
          y: window.scrollY,
          savedAt: Date.now()
        })
      );
    } catch (error) {
      // sessionStorage kullanılamıyorsa yenileme devam eder.
    }
  }

  function restoreScrollPosition() {
    let storedValue;

    try {
      storedValue = sessionStorage.getItem(STORAGE_KEY);

      if (!storedValue) {
        return;
      }

      sessionStorage.removeItem(STORAGE_KEY);

      const position = JSON.parse(storedValue);

      // Eski veya geçersiz kayıtları kullanma.
      if (
        !position.savedAt ||
        Date.now() - position.savedAt > 5 * 60 * 1000
      ) {
        return;
      }

      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          window.scrollTo(
            Number(position.x) || 0,
            Number(position.y) || 0
          );
        });
      });
    } catch (error) {
      // Hatalı kayıt sayfanın çalışmasını engellemesin.
    }
  }

  function scheduleRefresh(delay) {
    clearTimeout(refreshTimer);

    refreshTimer = window.setTimeout(function checkAndRefresh() {
      if (!canRefresh()) {
        scheduleRefresh(RETRY_INTERVAL);
        return;
      }

      saveScrollPosition();
      window.location.reload();
    }, delay);
  }

  // Panel ve video sayfalarında otomatik yenileme sistemi hiç başlatılmaz.
  if (isExcludedPage() || hasMedia()) {
    return;
  }

  window.addEventListener(
    "load",
    function () {
      restoreScrollPosition();
      scheduleRefresh(REFRESH_INTERVAL);
    },
    { once: true }
  );

  // Sayfa gizlendiğinde çalışan süreyi iptal et.
  document.addEventListener("visibilitychange", function () {
    if (document.hidden) {
      clearTimeout(refreshTimer);
      return;
    }

    // Kullanıcı sekmeye döndüğünde aniden yenileme yapma;
    // 70 saniyelik süreyi yeniden başlat.
    scheduleRefresh(REFRESH_INTERVAL);
  });

  // Sayfadan ayrılırken zamanlayıcıyı temizle.
  window.addEventListener("pagehide", function () {
    clearTimeout(refreshTimer);
  });
})();
</script></div><script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
