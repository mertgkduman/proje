 /* rstyle6.css'teki element seviyesi nav kuralı (float:left, margin-top:3px !important, width:calc(100% - 450px)) burada geçersiz */
 .hds { display: flex; float: none; align-items: center; justify-content: flex-start; gap: 12px; width: fit-content; max-width: 100%; margin: 0 !important; padding: 0; list-style: none; }
 .hds-pill { display: inline-flex; flex: 0 1 auto; min-width: 0; align-items: center; gap: 8px; height: 28px; padding: 0 16px; border-radius: 999px; background: #fff; box-shadow: 0 1px 3px rgba(0, 0, 0, .10), 0 0 0 1px rgba(0, 0, 0, .03); color: #333; font-size: 14px; font-weight: 600; line-height: 1; white-space: nowrap; text-decoration: none; transition: background-color .12s ease; }
 .hds-pill::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: #0b5cb6; flex-shrink: 0; }
 .hds-pill:hover { background: #fafafa; box-shadow: 0 2px 6px rgba(0, 0, 0, .12), 0 0 0 1px rgba(0, 0, 0, .03); color: #333; text-decoration: none; }
 .hds-pill:focus-visible { outline: 2px solid #0b5cb6; outline-offset: 2px; }
 @media only screen and (max-width: 768px) {
 .hds { gap: 8px; width: auto; max-width: none; padding: 0 16px; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; scroll-snap-type: x proximity; scroll-padding-inline: 16px; }
 .hds::-webkit-scrollbar { display: none; }
 .hds-pill { flex: 0 0 auto; padding: 0 14px; gap: 6px; font-size: 13px; scroll-snap-align: start; }
 } </style> <div class="hds-abs"> <div class="hds-outer content-container w-md-100 p-md-0"> <div class="hds-wrap"> <nav class="hds" aria-label="Haber dosyaları"> <a class="hds-pill" href="/galatasaray-aston-villa-maci/" title="Galatasaray-Aston Villa maçı haber dosyası">Galatasaray-Aston Villa ma&#231;ı</a> <a class="hds-pill" href="/shakhtar-fenerbahce-maci/" title="Shakhtar - Fenerbahçe maçı haber dosyası">Shakhtar - Fenerbah&#231;e ma&#231;ı</a> <a class="hds-pill" href="/unlulere-uyusturucu-operasyonu/" title="Ünlülere uyuşturucu operasyonu haber dosyası">&#220;nl&#252;lere uyuşturucu operasyonu</a> </nav> </div> </div> </div> <div id="page"> <style> @media (max-width: 970px) {
