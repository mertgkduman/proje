 var TARGET_WIDTH = 650; // HC'den farklı (SondakikaCom.Helper.SdCrop)
 var HOST_RE = /(\/\/(?:foto\.haberler\.com|foto\.sondakika\.com))\//i;

 function cropImage(img) {
 var src = img.getAttribute("src") || "";
 if (!HOST_RE.test(src) || src.indexOf("/crop/") !== -1) return;

 var w = img.naturalWidth, h = img.naturalHeight;
 if (!w || !h || w <= TARGET_WIDTH) return;

 var cropH = Math.round(TARGET_WIDTH * h / w);
 var newSrc = src.replace(HOST_RE, "$1/crop/" + TARGET_WIDTH + "x" + cropH + "/webp/");
 if (newSrc === src) return;

 img.setAttribute("width", TARGET_WIDTH);
 img.setAttribute("height", cropH);
 img.style.maxWidth = "100%"; // mobilde ekranı taşmasını önler
 img.style.height = "auto"; // max-width:100% ile birlikte oranı korur
 img.style.display = "block";
