 masthead.classList.add("is-visible");
 });

 clearTimeout(timer);

 timer = setTimeout(function () {
 masthead.classList.remove("is-visible");

 setTimeout(function () {
 masthead.classList.remove("is-fixed");
 placeholder.style.display = "none";
 }, 350);

 }, 5000);
 }

 window.addEventListener("scroll", function () {
 // Sticky kapaliysa scroll'da asagi kayma calismasin
 if (!ENABLE_MASTHEAD_STICKY) return;

 updateOverlay();

 if (window.scrollY > originalTop + 50 && !hasShown) {

