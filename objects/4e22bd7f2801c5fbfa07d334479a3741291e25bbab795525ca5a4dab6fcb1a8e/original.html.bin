                <style>
    [x-cloak]{display:none!important}
    .ccbnr{position:fixed;left:10px;right:10px;bottom:10px;z-index:99999;max-width:340px;
        font-family:inherit;font-size:12.5px;line-height:1.45}
    @media(min-width:640px){.ccbnr{left:auto;right:18px;bottom:18px}}
    .ccbnr-card{background:#fff;color:#1f2937;border:1px solid #e5e7eb;border-radius:9px;
        box-shadow:0 8px 18px -8px rgba(0,0,0,.16);overflow:hidden}
    .ccbnr-pad{padding:11px 13px}
    .ccbnr-h{font-weight:600;font-size:13.5px;margin:0 0 4px;color:#111827}
    .ccbnr-p{color:#4b5563;margin:0;font-size:11.5px;line-height:1.5}
    .ccbnr-a{color:#dc2626;text-decoration:none}
    .ccbnr-a:hover{text-decoration:underline}
    .ccbnr-row{display:flex;gap:5px;margin-top:10px;flex-wrap:wrap}
    .ccbnr-btn{flex:1 1 0;min-width:70px;border:0;cursor:pointer;font-weight:600;font-size:11px;
        padding:5px 8px;border-radius:5px;transition:background .15s}
    .ccbnr-primary{background:#dc2626;color:#fff}.ccbnr-primary:hover{background:#b91c1c}
    .ccbnr-ghost{background:#f3f4f6;color:#374151}.ccbnr-ghost:hover{background:#e5e7eb}
    .ccbnr-link{background:none;border:0;color:#6b7280;font-size:11px;cursor:pointer;
        text-decoration:underline;padding:0;margin-top:7px}
    .ccbnr-link:hover{color:#dc2626}
    .ccbnr-foot{display:flex;align-items:center;justify-content:space-between;margin-top:7px;gap:10px}
    .ccbnr-item{background:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:10px;margin-bottom:8px}
    .ccbnr-item-top{display:flex;align-items:center;justify-content:space-between}
    .ccbnr-item-h{font-weight:600;font-size:12.5px}
    .ccbnr-item-p{color:#6b7280;font-size:11.5px;margin:3px 0 0}
    .ccbnr-badge{font-size:10.5px;background:#e5e7eb;color:#374151;padding:2px 7px;border-radius:5px}
    .ccbnr-list{max-height:50vh;overflow-y:auto}
    .ccbnr-x{background:none;border:0;cursor:pointer;color:#9ca3af;font-size:18px;line-height:1}
    .ccbnr-more{background:none;border:0;color:#dc2626;font-size:11px;cursor:pointer;padding:4px 0 0;text-decoration:underline}
    .ccbnr-more:hover{color:#b91c1c}
    .dark .ccbnr-a,.dark .ccbnr-more{color:#f87171}
    .dark .ccbnr-ghost{background:#212529;color:#e5e7eb}.dark .ccbnr-ghost:hover{background:#2c3137}
    .ccbnr-p a{color:#dc2626;text-decoration:none}
    .ccbnr-p a:hover{text-decoration:underline}
</style>

<div x-data="ccConsent()" x-show="visible" x-cloak class="ccbnr" style="display:none">
    <div class="ccbnr-card dark:bg-customdarkgray-900 dark:border-gray-700 dark:text-gray-300">

        <div x-show="!showDetails" class="ccbnr-pad">
            <div class="ccbnr-p dark:text-gray-300">
                                    <span x-show="!expanded">Sitemizde, sizlere daha iyi hizmet sunabilmek için çerezler kullanılmaktadır. KVKK ve GDPR kapsamında kişisel verilerini </span>
                    <span x-show="expanded" x-cloak><p>Sitemizde, sizlere daha iyi hizmet sunabilmek için çerezler kullanılmaktadır. KVKK ve GDPR kapsamında kişisel verileriniz işlenmektedir. Detaylar için Veri Politikamızı inceleyebilirsiniz.</p></span>
                    <button type="button" class="ccbnr-more" @click="expanded = !expanded"
                            x-text="expanded ? '↑ daha az' : 'devamı...'"></button>
                            </div>
            <div class="ccbnr-row">
                <button type="button" class="ccbnr-btn ccbnr-primary" @click="acceptAll()">Kabul Et</button>
                <button type="button" class="ccbnr-btn ccbnr-ghost dark:bg-customdarkgray-800 dark:text-gray-200" @click="rejectAll()">Reddet</button>
            </div>
            <div class="ccbnr-foot">
                <button type="button" class="ccbnr-link dark:text-gray-400" @click="showDetails = true">Ayarlar</button>
                <a href="https://www.karamangundem.com/cerez-politikasi" class="ccbnr-a" style="font-size:11px">Politika →</a>
            </div>
        </div>

        <div x-show="showDetails" x-cloak class="ccbnr-pad">
            <div class="ccbnr-item-top" style="margin-bottom:12px">
                <strong>Çerez Tercihleri</strong>
                <button type="button" class="ccbnr-x dark:text-gray-400" @click="showDetails = false">&times;</button>
            </div>
            <div class="ccbnr-list">
                <div class="ccbnr-item dark:bg-customdarkgray-800 dark:border-gray-700">
                    <div class="ccbnr-item-top">
                        <span class="ccbnr-item-h">Zorunlu çerezler</span>
                        <span class="ccbnr-badge dark:bg-gray-700 dark:text-gray-300">Her zaman aktif</span>
                    </div>
                    <p class="ccbnr-item-p dark:text-gray-400">Oturum, güvenlik ve temel işlevler. Bunlar olmadan site çalışmaz.</p>
                </div>
                <div class="ccbnr-item dark:bg-customdarkgray-800 dark:border-gray-700">
                    <label class="ccbnr-item-top" style="cursor:pointer">
                        <span class="ccbnr-item-h">Tercih çerezleri</span>
                        <input type="checkbox" x-model="prefs.functionality">
                    </label>
                    <p class="ccbnr-item-p dark:text-gray-400">Dil ve görüntüleme tercihlerinizi hatırlamak için.</p>
                </div>
                <div class="ccbnr-item dark:bg-customdarkgray-800 dark:border-gray-700">
                    <label class="ccbnr-item-top" style="cursor:pointer">
                        <span class="ccbnr-item-h">Reklam çerezleri</span>
                        <input type="checkbox" x-model="prefs.ads">
                    </label>
                    <p class="ccbnr-item-p dark:text-gray-400">İlgi alanınıza uygun reklam göstermek için.</p>
                </div>
                <div class="ccbnr-item dark:bg-customdarkgray-800 dark:border-gray-700">
                    <label class="ccbnr-item-top" style="cursor:pointer">
                        <span class="ccbnr-item-h">Kişiselleştirilmiş reklam</span>
                        <input type="checkbox" x-model="prefs.personalization">
                    </label>
                    <p class="ccbnr-item-p dark:text-gray-400">Davranışınıza özel reklam içeriği için.</p>
                </div>
            </div>
            <div class="ccbnr-row">
                <button type="button" class="ccbnr-btn ccbnr-primary" @click="saveCustom()">Tercihimi Kaydet</button>
                <button type="button" class="ccbnr-btn ccbnr-ghost dark:bg-customdarkgray-800 dark:text-gray-200" @click="acceptAll()">Hepsini Kabul</button>
            </div>
        </div>
    </div>
</div>

<script>
    function ccConsent() {
        const STORAGE_KEY = 'cc_consent_v2';
        const VERSION = 2;
        const MAX_AGE_MS = 180 * 24 * 60 * 60 * 1000;

        return {
            visible: false,
            showDetails: false,
            expanded: false,
            prefs: { functionality: false, ads: false, personalization: false },

            init() {
                try {
                    const raw = localStorage.getItem(STORAGE_KEY);
                    if (!raw) { this.visible = true; return; }
                    const data = JSON.parse(raw);
                    if (data.version !== VERSION) { this.visible = true; return; }
                    if (!data.ts || (Date.now() - data.ts) > MAX_AGE_MS) { this.visible = true; return; }
                    this.applyToGtag({
                        functionality:   !!data.functionality,
                        ads:             !!data.ads,
                        personalization: !!data.personalization,
                    });
                } catch (e) { this.visible = true; }
            },

            acceptAll() { this.persist({ functionality: true, ads: true, personalization: true }); },
            rejectAll() { this.persist({ functionality: false, ads: false, personalization: false }); },
            saveCustom() {
                this.persist({
                    functionality:   !!this.prefs.functionality,
                    ads:             !!this.prefs.ads,
                    personalization: !!this.prefs.personalization,
                });
            },

            persist(p) {
                try {
                    localStorage.setItem(STORAGE_KEY, JSON.stringify({ version: VERSION, ts: Date.now(), ...p }));
                } catch (e) {}
                this.applyToGtag(p);
                this.visible = false;
            },

            applyToGtag(p) {
                if (typeof window.gtag !== 'function') {
                    window.dataLayer = window.dataLayer || [];
                    window.gtag = function () { window.dataLayer.push(arguments); };
                }
                window.gtag('consent', 'update', {
                    'functionality_storage':   p.functionality   ? 'granted' : 'denied',
                    'personalization_storage': p.personalization ? 'granted' : 'denied',
                    'ad_storage':              p.ads             ? 'granted' : 'denied',
                    'ad_user_data':            p.ads             ? 'granted' : 'denied',
                    'ad_personalization':      p.personalization ? 'granted' : 'denied',
                });
            },
        };
    }

    window.resetCookieConsent = function () {
        try { localStorage.removeItem('cc_consent_v2'); } catch (e) {}
        location.reload();
    };
</script>
