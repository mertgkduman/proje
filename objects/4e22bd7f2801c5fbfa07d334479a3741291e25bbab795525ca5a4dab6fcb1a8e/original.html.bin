            isDark = document.documentElement.classList.contains('dark');
        });
        observer.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ['class']
        });
     "
            >

                <div
                        @click="
            const next = localStorage.getItem('darkMode') !== 'true';
            localStorage.setItem('darkMode', next);
        "
