    /* CLS: kutu HTML'de nötr "—" ile gelir ve ORADA KALIR. Sayaç 0 olsa da,
       hiç alınamasa da kutu KALDIRILMAZ — aksi halde ilk boyamadan sonra
       öğe kaybolup satır toplanıyor ("çekme"). Tek değişen, tirenin sayıya
       dönüşmesi; kutu sayısı ve satır yüksekliği sabit kalır.

       Bu yüzden burada is-empty/is-failed gizleme kuralı YOK. */

    /* Sayı alanı: counter sayarken basamak değiştikçe (0 → 470 → 4.7K)
       yanındaki etiket zıplamasın diye min genişlik. tabular-nums rakamları
       eşit genişliğe sabitler; 4ch en uzun kısaltılmış biçime ("4.7K") yeter,
       daha uzunu (12.3M) zaten nadir ve alan büyümeye açık. */
    .stats-num {
        display: inline-block;
        min-width: 4ch;
        font-variant-numeric: tabular-nums;
    }
    /* Sayaç artarken hafif vurgu. prefers-reduced-motion'da devre dışı. */
    @media (prefers-reduced-motion: no-preference) {
        .stats-box.is-counting .stats-num {
            transition: color .15s ease-out;
            color: var(--bs-emphasis-color, inherit);
        }
    }
</style>

