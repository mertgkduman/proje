                    data-platform="telegram"
                    data-share-url="https://www.kocaelitv.com.tr/yeni-parti-kocaelinin-gelir-ve-giderleri-aciklandi-borclar-odenince-kasada-ne-kalacak"
                    data-share-title="Yeni Parti Kocaeli&#039;nin gelir ve giderleri açıklandı! Borçlar ödenince kasada ne kalacak?"
