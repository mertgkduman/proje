        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0" style="height:90vh;">
                <div class="modal-header py-2 px-3" style="background:var(--bordo);color:#fff;border-radius:0;">
                    <span id="pdfModalLabel" class="small fw-semibold text-truncate me-2" style="max-width:80%;"></span>
                    <div class="d-flex gap-2 ms-auto">
                        <button id="pdfModalFullscreen" type="button"
                            class="btn btn-sm px-2 py-1 border-0 text-white d-flex align-items-center gap-1"
                            style="background:rgba(255,255,255,0.15); font-size:0.75rem;" title="Yeni sekmede aç">
                            <i class="ri-external-link-line"></i>
                            <span class="d-none d-sm-inline">Tam ekran</span>
                        </button>

                        <button type="button" class="btn btn-sm px-2 py-1 border-0 text-white"
                            style="background:rgba(255,255,255,0.15);" data-bs-dismiss="modal" aria-label="Kapat">
                            <i class="ri-close-line"></i>
                        </button>
                    </div>
                </div>
                <div class="modal-body p-0" style="flex:1;overflow:hidden;">
