				<div class="full-gray">
					<div class="container relative pt30">
						<h1 class="articleTitle">BDP\'nin adı Demokratik Bölgeler Partisi oldu</h1>

						<div class="evrensel-manset">
							<div class="manset-main">
								<div class="manset-tip1">
									<div class="ust">
										<div class="manset-article">
											<div class="manset-text">
												<h2 class="article-spot">\'Demokratik özerklik ile özgür yaşamı inşa ediyoruz\' şiarıyla gerçekleştirilen BDP 3. Olağan Kongresi’nde Demokratik Bölgeler Partisi (DBP) eş genel başkanlığına Emine Ayna ve Kamuran Yüksek seçildi. </h2>
																									<div class="mobileMenu pt15">
														<div id='div-gpt-ad-1771915251719-0' data-ad-unit-path="/23311515254/Desktop-Mobil-Site-Geneli-Spotalti" class="advertisement-area"></div>
													</div>
																							</div>
											<figure class="manset-foto">
																							</figure>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>

				<div class="container relative">
					<div class="article">
						<div class="paylas pt30">
							<a href="https://api.whatsapp.com/send?text=https://www.evrensel.net/haber/88097/bdpnin-adi-demokratik-bolgeler-partisi-oldu" target="_blank" rel="nofollow" title="WhatsApp'la paylaş">
								<svg class="icon whatsapp">
									<use xlink:href="https://www.evrensel.net/templates/img/icons.svg#whatsapp"></use>
								</svg>
							</a>
