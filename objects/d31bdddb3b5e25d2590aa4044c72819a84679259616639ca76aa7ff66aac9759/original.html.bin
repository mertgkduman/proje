}

.evr-sub-cta-icon {
    font-size: 1.1rem;
    line-height: 1.1;
}

.evr-sub-cta-feat-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
}

.evr-sub-cta-feature strong {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 2px;
}

.evr-sub-cta-feature span {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.3;
    display: block;
}

.evr-sub-cta-action {
    flex: 0.8;
