<script>
    document.addEventListener('DOMContentLoaded', function() {
        setTimeout(function() {
            var ctaEl = document.querySelector('.evr-sub-cta');
            if (ctaEl && window.getComputedStyle(ctaEl).display !== 'none') {
                var title = 'Evrensel\u0027e\u0020Abone\u0020Ol';
                gtag('event', 'view_abone_cta', { 
                    'event_category': 'Engagement', 
                    'event_label': 'CTA Karti', 
                    'cta_title': title 
                });
                if (typeof ym === 'function') {
                    ym(46172883, 'params', { 'cta_impression': { 'title': title } });
                }
            }
        }, 1000); // Metrika'nın tamamen yüklenmesini beklemek için kısa bir gecikme
    });
</script>

<style>
/* Giriş yapmış (is-user) veya abone olmuş (is-subscriber) okurlar için kutuyu gizle */
