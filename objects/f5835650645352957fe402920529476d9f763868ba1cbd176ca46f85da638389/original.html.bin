r\/social-icons\/article-redesign-bluesky.svg","linkQueryParam":"text"},"telegram":{"name":"telegram","url":"https:\/\/t.me\/share\/url?url=https%3A%2F%2Ftr.euronews.com%2F2026%2F08%2F04%2Fyeni-partide-yeni-orgutlenme-modeli-genel-baskani-dogrudan-uyeler-sececek&utm_source=Telegram&utm_medium=Social","iconSharer":"\/images\/vector\/social-icons\/article-redesign-telegram.svg","linkQueryParam":"url"},"threads":{"name":"threads","url":"https:\/\/threads.net\/intent\/post?text=https%3A%2F%2Ftr.euronews.com%2F2026%2F08%2F04%2Fyeni-partide-yeni-orgutlenme-modeli-genel-baskani-dogrudan-uyeler-sececek&utm_source=Threads&utm_medium=Social","iconSharer":"\/images\/vector\/social-icons\/article-redesign-threads.svg","linkQueryParam":"text"},"whatsapp":{"name":"whatsapp","url":"whatsapp:\/\/send?text=https%3A%2F%2Ftr.euronews.com%2F2026%2F08%2F04%2Fyeni-partide-yeni-orgutlenme-modeli-genel-baskani-dogrudan-uyeler-sececek&utm_source=Whatsapp&utm_medium=Social","iconSharer":"\/images\/vector\/social-icons\/article-redesign-whatsapp.svg","linkQueryParam":"text"}}},"entities":{"country":{"id":284,"urlSafeValue":"turkiye","title":"T\u00fcrkiye"},"continent":{"id":104,"urlSafeValue":"avrupa","title":"Avrupa"},"article":{"id":2915033,"cid":"9861883","livestream":[],"technicalTags":["features.textToSpeech.disable"],"relatedIds":[2912027,2915168,2918649],"preferredRatio":"auto","program":{"id":"world","urlSafeValue":"dunya","title":"D\u00fcnya"},"isWire":false,"agencyKey":"euronews","masterCMS":"v2","adobeFromBreakingNews":false,"contentType":"normal","lastPublishedAt":1785905315,"createdAt":1785839885,"publishedAt":1785842385,"firstPublishedAt":1785842385,"lastModified":1785905315,"path":"\/2026\/08\/04\/yeni-partide-yeni-orgutlenme-modeli-genel-baskani-dogrudan-uyeler-sececek","isMagazine":false,"leadin":"Yeni Parti'nin ilk TBMM grup toplant\u0131s\u0131nda yeni \u00f6rg\u00fctlenme modelini a\u00e7\u0131klayan \u00d6zel, genel ba\u015fkan dahil t\u00fcm y\u00f6neticilerin \u00fcyelerce se\u00e7ilece\u011fini s\u00f6yledi. Partisinin se\u00e7imde birinci olamamas\u0131 halinde yeniden aday olmayaca\u011f\u0131n\u0131 belirten \u00d6zel, 700 bini a\u015fk\u0131n istifadan haberdar olduklar\u0131n\u0131 a\u00e7\u0131klad\u0131.","pfpRelated":[],"title":"Yeni Parti'de yeni \u00f6rg\u00fctlenme modeli: Genel ba\u015fkan\u0131 do\u011frudan \u00fcyeler se\u00e7ecek","versionId":"2","plainText":"Yeni Parti Genel Ba\u015fkan\u0131 \u00d6zg\u00fcr \u00d6zel, partisinin sal\u0131 g\u00fcn\u00fc d\u00fczenlenen ilk T\u00fcrkiye B\u00fcy\u00fck Millet Meclisi (TBMM) grup toplant\u0131s\u0131nda, il\u00e7e ve il ba\u015fkanlar\u0131 ile genel ba\u015fkan\u0131n b\u00fct\u00fcn \u00fcyeler taraf\u0131ndan do\u011frudan se\u00e7ilece\u011fini a\u00e7\u0131klad\u0131.\n\nDelege sistemine dayal\u0131 \u00f6rg\u00fctlenme bi\u00e7imini terk edeceklerini belirten \u00d6zel, delegeli\u011fin yaln\u0131zca Siyasi Partiler Kanunu\u2019nun gereklerini kar\u015f\u0131layan teknik bir g\u00f6rev olarak kalaca\u011f\u0131n\u0131 s\u00f6yledi.\n\n\u00d6zel, \"Art\u0131k \u00fcyeleri geri plana atan eski nesil siyaset anlay\u0131\u015f\u0131 sona erecek; \u00fcyelerin s\u00f6z, yetki ve karar sahibi oldu\u011fu yeni nesil siyaset Yeni Parti ile birlikte kurulacakt\u0131r,\" dedi.\n\n\u00dcye say\u0131s\u0131, n\u00fcfusu ve imkanlar\u0131 uygun olan mahallelerde mahalle meclisleri kuracaklar\u0131n\u0131 a\u00e7\u0131klayan \u00d6zel, partinin temel siyaset organlar\u0131n\u0131n il\u00e7e ba\u015fkanl\u0131klar\u0131 ve y\u00f6netim kurullar\u0131 de\u011fil, \u00fcyelerden olu\u015fan il\u00e7e meclisleri olaca\u011f\u0131n\u0131 belirtti.\n\n\u0130\u015f\u00e7ilerden emeklilere, \u00e7ift\u00e7ilerden i\u015f insanlar\u0131na, kad\u0131nlardan gen\u00e7lere kadar farkl\u0131 toplumsal kesimlerin il\u00e7e ve il meclisleri arac\u0131l\u0131\u011f\u0131yla partinin politikalar\u0131n\u0131 belirleyece\u011fini s\u00f6yleyen \u00d6zel, yeni \u00fcyelerin bekletilmeden karar ve \u00e7al\u0131\u015fma s\u00fcre\u00e7lerine dahil edilece\u011fini kaydetti.\n\n\u00d6zel, \"Bizim partimizin g\u00fcc\u00fc liderinden, y\u00f6neticilerinden de\u011fil; partimizin g\u00fcc\u00fc \u00f6rg\u00fct\u00fcnden ve bilhassa her bir \u00fcyesinden gelecektir,\" diye konu\u015ftu.\n\nYeni Parti\u2019nin kurulu\u015funa giden s\u00fcreci de anlatan \u00d6zel, CHP y\u00f6netimine y\u00f6nelik m\u00fcdahaleyi \"yarg\u0131 darbesi\" ve \"sivil darbe\" olarak nitelendirdi.\n\n\"Bu salonda son yapt\u0131\u011f\u0131m\u0131z grup toplant\u0131s\u0131nda nas\u0131l bir yarg\u0131 darbesine maruz kald\u0131\u011f\u0131m\u0131z\u0131 detaylar\u0131yla anlatm\u0131\u015ft\u0131m,\" diyen \u00d6zel, s\u00f6zlerini \u015f\u00f6yle s\u00fcrd\u00fcrd\u00fc:\n\n\"Bu darbe prati\u011fine kar\u015f\u0131 verdi\u011fimiz hukuki, siyasi, fiziki m\u00fccadeleye sizler t\u00fcm milletimizle birlikte en yak\u0131ndan \u015fahitsiniz. Bu m\u00fccadelenin i\u00e7indesiniz, bu m\u00fccadelenin ta kendisisiniz.\"\n\n\u00d6zel, s\u00fcrecin ard\u0131ndan 60 g\u00fcnde 22 ili gezerek vatanda\u015flar\u0131n g\u00f6r\u00fc\u015flerini ald\u0131klar\u0131n\u0131 belirterek, \"Ya bir yol bulaca\u011f\u0131z ya yeni bir yol a\u00e7aca\u011f\u0131z,\" s\u00f6zleriyle hareket ettiklerini ve 24 Temmuz\u2019da 91 milletvekiliyle Yeni Parti\u2019yi kurduklar\u0131n\u0131 s\u00f6yledi.\n\nSe\u00e7imde birinci olamazsa yeniden aday olmayacak\n\nPartideki b\u00fct\u00fcn y\u00f6netici makamlar\u0131na en fazla \u00fc\u00e7 d\u00f6nem g\u00f6rev s\u0131n\u0131r\u0131 getirilece\u011fini a\u00e7\u0131klayan \u00d6zel, kendi genel ba\u015fkanl\u0131\u011f\u0131 i\u00e7in de se\u00e7im ba\u015far\u0131s\u0131na ba\u011fl\u0131 bir kural ilan etti.\n\n\u00d6zel, genel ba\u015fkan olarak girdi\u011fi yerel veya genel se\u00e7imde Yeni Parti\u2019nin birinci olamamas\u0131 durumunda ertesi g\u00fcn kurultay\u0131 toplayaca\u011f\u0131n\u0131 ve yeniden aday olmayaca\u011f\u0131n\u0131 s\u00f6yledi.\n\n\"Siyaset iddia i\u015fidir,\" diyen \u00d6zel, \"\u0130ster yerel, ister genel, genel ba\u015fkanl\u0131\u011f\u0131nda girdi\u011fim se\u00e7imden parti birinci parti olarak, zafer kazanarak, iktidar olarak \u00e7\u0131kmad\u0131ysa; ertesi g\u00fcn kurultay\u0131 topluyorum ve aday olmuyorum,\" ifadelerini kulland\u0131.\n\nGenel ba\u015fkan\u0131n ve partideki siyaset\u00e7ilerin kaderinin milletin kaderinden ayr\u0131 olamayaca\u011f\u0131n\u0131 savunan \u00d6zel, \"Milletin y\u00fcz\u00fc g\u00fclmedik\u00e7e hi\u00e7birimizin y\u00fcz\u00fc g\u00fclmeyecektir,\" dedi.\n\n'700 bini a\u015fan istifalardan haberdar\u0131z'\n\nEski partisinde ya\u015fanan istifalara de\u011finen \u00d6zel, bug\u00fcne kadar herhangi bir istifa \u00e7a\u011fr\u0131s\u0131 yapmad\u0131klar\u0131n\u0131 ancak 700 bini a\u015fan istifadan haberdar olduklar\u0131n\u0131 s\u00f6yledi.\n\n\u00d6zel, \"\u0130stifa etmeyin,\" dedikleri belediye ba\u015fkanlar\u0131 ve belediye meclisi \u00fcyelerinin de \"Siz oradayken burada nas\u0131l dural\u0131m?\" diyerek harekete ge\u00e7ti\u011fini belirtti.\n\n\"\u015eimdiye kadar hi\u00e7bir istifa \u00e7a\u011fr\u0131s\u0131 yapmad\u0131k. Ama 700 bini a\u015fan istifalardan haberdar\u0131z,\" diyen \u00d6zel, eski CHP \u00fcyelerine \u015fu \u00e7a\u011fr\u0131y\u0131 yapt\u0131:\n\n\"\u015eimdi art\u0131k vakittir. Ge\u00e7mi\u015fte birlikte \u00fcye olmaktan onur ve gurur duydu\u011fum t\u00fcm arkada\u015flar\u0131m\u0131za, bu yeni nesil siyasete, Yeni Parti\u2019ye yapt\u0131\u011f\u0131m\u0131z davetle birlikte \u015f\u00f6yle sesleniyorum: Darbecilerden, butlanc\u0131lardan, cuntac\u0131lardan kurtulun; Yeni Partimize buyurun.\"\n\nPartinin yaln\u0131zca eski CHP \u00fcyelerine seslenmedi\u011fini belirten \u00d6zel, milliyet\u00e7i, muhafazakar, K\u00fcrt, liberal ve sosyalist demokratlar\u0131 da Yeni Parti\u2019ye kat\u0131lmaya davet etti.\n\n\u00d6zel, \"Bu parti, elbette g\u00f6zya\u015flar\u0131yla ayr\u0131ld\u0131\u011f\u0131m\u0131z Cumhuriyet Halk Partililerin Yeni Partisidir. Bu parti, Atat\u00fcrk\u00e7\u00fclerin, aslan sosyal demokratlar\u0131n Yeni Partisidir. Ancak yaln\u0131zca bana, bize, birbirimize benzeyenlerin de\u011fil; farkl\u0131l\u0131klar\u0131n\u0131 koruyarak ortak bir gelecek in\u015fa etmek isteyen b\u00fct\u00fcn demokratlar\u0131n Yeni Partisidir,\" dedi.\n\nKonu\u015fmas\u0131n\u0131n devam\u0131nda isim vermeden mutlak butlan karar\u0131yla CHP Genel Ba\u015fkan\u0131 olarak geri d\u00f6nen Kemal K\u0131l\u0131\u00e7daro\u011flu\u2019na g\u00f6nderme yapan \u00d6zel, K\u0131l\u0131\u00e7daro\u011flu\u2019nun kendilerine \"darbe\" yapt\u0131\u011f\u0131n\u0131 ima etti.\n\nYurtta\u015ftan ald\u0131klar\u0131 destekleri hat\u0131rlat\u0131rken isim vermeden konu\u015fan \u00d6zel, \u015funlar\u0131 s\u00f6yledi:\n\n\"Milletten korkarak, millete ra\u011fmen, millet istemeden hi\u00e7bir \u015fey olmaz. Seni oturttu\u011fu koltuktan millete ra\u011fmen asla oturulmaz. Ve millete sayg\u0131 seni bir makama getirdi\u011finde de\u011fil; art\u0131k o makama lay\u0131k g\u00f6rmedi\u011finde ne yapaca\u011f\u0131na ba\u011fl\u0131d\u0131r. Sen milletin g\u00f6z\u00fcnden d\u00fc\u015fm\u00fc\u015fsen, sen milletin g\u00f6nl\u00fcnden d\u00fc\u015fm\u00fc\u015fsen, millet art\u0131k de\u011fi\u015ftirmeye karar vermi\u015fse ve sen bir darbeye yeltenmi\u015fsen millet senin de\u011fil, o darbe yapt\u0131klar\u0131n\u0131n arkas\u0131nda b\u00f6yle durur i\u015fte, b\u00f6yle durur.\"\n\nVize serbestisi ve Siyasi Etik Yasas\u0131 vurgusu\n\n\u00d6zel, Yeni Parti grubunun Meclis\u2019e sundu\u011fu ikinci kanun teklifinin, Avrupa Konseyi Yolsuzlu\u011fa Kar\u015f\u0131 Devletler Grubu (GRECO) kriterlerine tam uyumlu bir Siyasi Etik Yasas\u0131 oldu\u011funu a\u00e7\u0131klad\u0131.\n\nTeklifin siyasi finansman\u0131n \u015feffafla\u015ft\u0131r\u0131lmas\u0131, milletvekillerinin kabul edebilece\u011fi hediyelere s\u0131n\u0131r getirilmesi, siyaset\u00e7ilerin yak\u0131nlar\u0131n\u0131n kamu ihaleleri ve kamu istihdam\u0131yla ili\u015fkilerinin denetlenmesi, lobicilik faaliyetlerinin a\u00e7\u0131klanmas\u0131 ve sebepsiz zenginle\u015fmenin ara\u015ft\u0131r\u0131lmas\u0131 gibi d\u00fczenlemeler i\u00e7erdi\u011fini belirten \u00d6zel, AK Parti\u2019ye \u00e7a\u011fr\u0131da bulundu.\n\n\u00d6zel, \"Bize birtak\u0131m operasyonlar, iftiralar, gizli tan\u0131klar, yalanc\u0131 \u015fahitler \u00fczerinden iftiralar atan AK Parti siyasetine a\u00e7\u0131k \u00e7a\u011fr\u0131md\u0131r. GRECO kriterlerine tam uyumlu Siyasi Etik Yasas\u0131, Siyasi \u015eeffafl\u0131k Yasas\u0131 Yeni Parti\u2019nin size ilk \u00f6nerisidir. Hodri meydan, biz buraday\u0131z,\" dedi.\n\nGRECO\u2019nun 2023\u2019te g\u00fcncelledi\u011fi rapora de\u011finen \u00d6zel, milletvekilleri, hakimler ve savc\u0131larda yolsuzlu\u011fun \u00f6nlenmesine ili\u015fkin 22 tavsiyeden yaln\u0131zca \u00fc\u00e7\u00fcn\u00fcn yerine getirildi\u011fini savundu.\n\n\u00d6zel, \"Bu \u00fclkede milletvekilleri, hakimler ve savc\u0131lar\u0131n mal varl\u0131klar\u0131, zenginle\u015fmeleri ya da etik d\u0131\u015f\u0131 davran\u0131\u015flar\u0131 denetleme y\u00f6n\u00fcnden 22 kriterden sadece \u00fc\u00e7\u00fc kar\u015f\u0131lanabiliyor. On dokuzu yok,\" diye konu\u015ftu.\n\nSiyasi Etik Yasas\u0131\u2019n\u0131 2016\u2019da Avrupa Birli\u011fi ile y\u00fcr\u00fct\u00fclen vize serbestisi s\u00fcreciyle de ili\u015fkilendiren \u00d6zel, d\u00f6nemin Ba\u015fbakan\u0131 Ahmet Davuto\u011flu\u2019nun d\u00fczenlemeyi \u00e7\u0131karmas\u0131na Cumhurba\u015fkan\u0131 Recep Tayyip Erdo\u011fan\u2019\u0131n engel oldu\u011funu ileri s\u00fcrd\u00fc.\n\nErdo\u011fan\u2019\u0131n Davuto\u011flu\u2019na, \"E\u011fer bu kanun \u00e7\u0131karsa AK Parti\u2019de il\u00e7e ba\u015fkan\u0131, il ba\u015fkan\u0131 bulamazs\u0131n,\" dedi\u011fini \u00f6ne s\u00fcren \u00d6zel, bu nedenle vize serbestisi s\u00fcrecinin tamamlanamad\u0131\u011f\u0131n\u0131 savundu.\n\n\u00d6zel, \"E\u011fer Erdo\u011fan partisine g\u00fcvenseydi, siyasi \u015feffafl\u0131\u011f\u0131 taahh\u00fct etseydi bug\u00fcn Avrupa\u2019n\u0131n t\u00fcm \u00fclkelerinde serbest\u00e7e dola\u015fan ve Avrupa Birli\u011fi y\u00fcr\u00fcy\u00fc\u015f\u00fcnde \u00e7ok daha iyi bir yere kavu\u015fmu\u015f bir \u00fclke olacakt\u0131k,\" dedi.\n\nBe\u015f g\u00fcnde 240 milyon lira ba\u011f\u0131\u015f\n\nPartinin kurulu\u015f s\u00fcrecinde ba\u015flat\u0131lan ba\u011f\u0131\u015f kampanyas\u0131na ili\u015fkin rakamlar\u0131 payla\u015fan \u00d6zel, be\u015f g\u00fcnde 113 bin ki\u015finin toplam 240 milyon lira ba\u011f\u0131\u015fta bulundu\u011funu a\u00e7\u0131klad\u0131.\n\n\u00d6zel, \"Be\u015f g\u00fcnde 113 bin ba\u011f\u0131\u015f\u00e7\u0131 taraf\u0131ndan, ki iki g\u00fcn\u00fc hafta sonudur, toplamda 240 milyon lira ba\u011f\u0131\u015fta bulunuldu,\" dedi.\n\n\u015eeffafl\u0131\u011f\u0131 demokratik me\u015fruiyetin \u015fart\u0131 olarak kabul ettiklerini belirten \u00d6zel, ba\u011f\u0131\u015f bilgilerinin her ak\u015fam saat 20.00\u2019de kamuoyuyla payla\u015f\u0131ld\u0131\u011f\u0131n\u0131 s\u00f6yledi.\n\n\u00d6zel, \"Bundan sonra da ald\u0131\u011f\u0131m\u0131z her ba\u011f\u0131\u015f\u0131 ve harcad\u0131\u011f\u0131m\u0131z her kuru\u015f paray\u0131 ba\u011f\u0131\u015f\u0131 yapanlarla, kamu otoriteleriyle ve kamuoyuyla \u015feffaf bir \u015fekilde payla\u015fmaya devam edece\u011fiz,\" ifadelerini kulland\u0131.\n\nParti hesaplar\u0131n\u0131n kamu denetimine a\u00e7\u0131k oldu\u011funu ve ba\u011f\u0131ms\u0131z denet\u00e7i raporlar\u0131n\u0131n yay\u0131mlanaca\u011f\u0131n\u0131 kaydeden \u00d6zel, toplanan ba\u011f\u0131\u015flarla kendisine l\u00fcks ara\u00e7 al\u0131nd\u0131\u011f\u0131 y\u00f6n\u00fcndeki iddiay\u0131 da reddetti.\n\n\"\u015eu ana kadar gelen ba\u011f\u0131\u015flardan harcanan iki kalem var. O da d\u00fcn yap\u0131ld\u0131,\" diyen \u00d6zel, \"\u0130n\u015faat\u0131 bitmek \u00fczere olan genel merkezin do\u011fal gaz\u0131 ve suyu a\u00e7\u0131ld\u0131. Bilginiz olsun,\" \u015feklinde konu\u015ftu.\n\n\u00d6zel, ba\u011f\u0131\u015f yapan vatanda\u015flar\u0131n banka transferlerinin a\u00e7\u0131klama b\u00f6l\u00fcm\u00fcne yazd\u0131\u011f\u0131 mesajlardan baz\u0131lar\u0131n\u0131 da okudu. Bir \u00f6\u011frencinin 200 liral\u0131k ba\u011f\u0131\u015f\u0131 i\u00e7in \"\u00d6\u011frenciyim, \u00e7ok g\u00f6nderemiyorum. Elimden gelen buydu,\" notunu yazd\u0131\u011f\u0131n\u0131 aktaran \u00d6zel, ba\u015fka bir ba\u011f\u0131\u015f\u00e7\u0131n\u0131n ise ayakkab\u0131 almak i\u00e7in ay\u0131rd\u0131\u011f\u0131 bin liray\u0131 partiye g\u00f6nderdi\u011fini s\u00f6yledi.\n\nCuma g\u00fcn\u00fcne kadar 65 il ve 733 il\u00e7ede \u00f6rg\u00fctlenme\n\nPartinin \u00f6rg\u00fctlenme \u00e7al\u0131\u015fmalar\u0131na ili\u015fkin bilgi veren \u00d6zel, hafta ba\u015f\u0131nda 54 olan teknik \u00f6rg\u00fctlenmenin tamamland\u0131\u011f\u0131 il say\u0131s\u0131n\u0131n 60\u2019\u0131n \u00fczerine \u00e7\u0131kt\u0131\u011f\u0131n\u0131 a\u00e7\u0131klad\u0131.\n\n\u00d6zel, \"Hafta ba\u015f\u0131 54\u2019t\u00fc, an itibariyle 60\u2019\u0131n \u00fczerinde. Cuma g\u00fcn\u00fc itibar\u0131yla 65 ilimizde ve 733 il\u00e7emizde teknik \u00f6rg\u00fctlenme a\u015famalar\u0131n\u0131 tamamlam\u0131\u015f durumda olaca\u011f\u0131z,\" dedi.\n\nOnline \u00fcyelik sisteminin bir haftad\u0131r haz\u0131r oldu\u011funu belirten \u00d6zel, sistemin faaliyete ge\u00e7mesi i\u00e7in Yarg\u0131tay ve baz\u0131 kamu kurumlar\u0131n\u0131n onaylar\u0131n\u0131n beklendi\u011fini s\u00f6yledi.\n\nYeni sistemde \u00fcyelik ba\u015fvurusunun WhatsApp \u00fczerinden g\u00f6nderilecek tek bir ba\u011flant\u0131yla ba\u015flat\u0131labilece\u011fini kaydeden \u00d6zel; ba\u015fvuru, foto\u011fraf y\u00fckleme, Yarg\u0131tay\u2019a bildirim, kimlik bas\u0131m talimat\u0131 ve aidat taahh\u00fcd\u00fcn\u00fcn birka\u00e7 ad\u0131mda tamamlanaca\u011f\u0131n\u0131 belirtti.\n\nPartinin teknik kurulu\u015funun tamamland\u0131\u011f\u0131n\u0131 ifade eden \u00d6zel, siyasi kurulu\u015f s\u00fcrecinin yakla\u015f\u0131k \u00fc\u00e7 ay sonra yap\u0131lmas\u0131 planlanan ilk kurultaya kadar devam edece\u011fini s\u00f6yledi.\n\n\u0130lk kurultaya kadar partiye kat\u0131lanlar\u0131n \"ger\u00e7ek ve siyasi kurucular\" olarak kabul edilece\u011fini belirten \u00d6zel, konu\u015fmas\u0131n\u0131 \u015fu s\u00f6zlerle tamamlad\u0131:\n\n\"Talimat\u0131 milletten ald\u0131k, ismi milletten ald\u0131k, b\u00fct\u00e7eyi milletten ald\u0131k. Hep beraber y\u00fcr\u00fcyoruz. Pusulam\u0131z millet, rotam\u0131z iktidar.\"\n\n","advertising":0,"advertisingData":{"sponsorLogoReverse":"","endDate":0,"isDfp":false,"sponsorLogo":"","startDate":0},"isLiveCoverage":false,"canonical":"https:\/\/tr.euronews.com\/2026\/08\/04\/yeni-partide-yeni-orgutlenme-modeli-genel-baskani-dogrudan-uyeler-sececek","country":{"id":284,"urlSafeValue":"turkiye","title":"T\u00fcrkiye"},"isBreakingNews":false,"type":"normal","numberWords":1186,"isOpinion":false,"grapeshotCategories":[],"versions":{"tr":{"url":"yeni-partide-yeni-orgutlenme-modeli-genel-baskani-dogrudan-uyeler-sececek","title":"Yeni Parti'de yeni \u00f6rg\u00fctlenme modeli: Genel ba\u015fkan\u0131 do\u011frudan \u00fcyeler se\u00e7ecek","publishedAt":1785842385}},"daletEventName":"Main Opposition leader \u00d6zel unveils YEN\u0130 Party reforms","contextualSignals":{"doubleVerify":{"ids":[],"slugs":[]}},"isAutoPublished":false,"isAutoLocalised":false,"isReviewed":false,"daletPyramidId":6123278,"excludeSocialMedia":false,"hasVuukle":true,"authors":[{"urlSafeValue":"sait-burak.utucu@ext.euronews.com","title":"Sait Burak Utucu","twitter":""}]},"image":{"defaultImagePath":"https:\/\/images.euronews.com\/articles\/stories\/09\/86\/18\/83\/1200x675_cmsv2_a6baaa8f-731f-5953-b46e-81ff1871207b-9861883.jpg"},"keywords":[{"id":"15142","slug":"chp","urlSafeValue":"chp","title":"CHP"},{"id":"12790","slug":"kemal-kilicdaro