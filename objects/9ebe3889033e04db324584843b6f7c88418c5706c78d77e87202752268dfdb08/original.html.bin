<style>.weather-widget-bg { background-image: var(--img-weather-acik); background-repeat: no-repeat; filter: brightness(0.7); background-size: cover; } .weather-widget-bg.acik { background-image: var(--img-weather-acik); } .weather-widget-bg.kapali { background-image: var(--img-weather-kapali); } .weather-widget-bg.yagmurlu, .weather-widget-bg.hafif-yagmur, .weather-widget-bg.orta-siddetli-yagmur { background-image: var(--img-weather-yagmurlu); } .weather-widget-bg.kar-yagisli, .weather-widget-bg.hafif-kar-yagisli { background-image: var(--img-weather-kar); } .weather-widget-bg.az-bulutlu, .weather-widget-bg.parcali-bulutlu, .weather-widget-bg.parcali-az-bulutlu { background-image: var(--img-weather-az-bulutlu); }</style>


