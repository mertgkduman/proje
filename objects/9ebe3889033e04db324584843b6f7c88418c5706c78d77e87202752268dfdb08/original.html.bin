      <source media="(max-width:480px)" srcset="https://www.gazetekritik.com/cropImages/480x/uploads/haberler/2026/10/ASHV-yeni-partide-il-baskanligi-on-secimi-sonuclari-celik-karaca-ve-guc-kazandi.jpg">
      <source media="(max-width:800px)" srcset="https://www.gazetekritik.com/cropImages/768x/uploads/haberler/2026/10/ASHV-yeni-partide-il-baskanligi-on-secimi-sonuclari-celik-karaca-ve-guc-kazandi.jpg">
      
      <img class="post-image-img w-100" width="1280" height="672" src="https://www.gazetekritik.com/cropImages/1280x/uploads/haberler/2026/10/ASHV-yeni-partide-il-baskanligi-on-secimi-sonuclari-celik-karaca-ve-guc-kazandi.jpg" alt="Yeni Parti’de il başkanlığı ön seçimi sonuçları: Çelik, Karaca ve Güç kazandı" decoding="async" fetchpriority="high">
