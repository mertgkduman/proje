  (function () {
    var shouldGuardStorage = false;
    if (!shouldGuardStorage || typeof window === 'undefined' || !window.localStorage) {
      return;
    }

    var storageProto = Object.getPrototypeOf(window.localStorage);
    if (!storageProto || typeof storageProto.setItem !== 'function' || storageProto.__t24SafeSetItemPatched) {
      return;
    }

    var originalSetItem = storageProto.setItem;
    storageProto.setItem = function (key, value) {
      try {
        return originalSetItem.call(this, key, value);
      } catch (error) {
        var isQuotaError = error && (
          error.name === 'QuotaExceededError'
          || error.name === 'NS_ERROR_DOM_QUOTA_REACHED'
          || error.code === 22
          || error.code === 1014
        );

        if (isQuotaError) {
          try {
            console.warn('[t24] localStorage quota reached; continuing payment flow.', key);
          } catch (noop) {
            // Intentionally ignore logging errors.
          }
          return;
        }

        throw error;
      }
    };

    storageProto.__t24SafeSetItemPatched = true;
  })();
</script>

