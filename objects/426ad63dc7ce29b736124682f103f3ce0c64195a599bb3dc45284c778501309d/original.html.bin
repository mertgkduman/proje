.story-content div[style*="padding-bottom:56.25%"]:empty,
.story-content div[style*="padding-bottom: 56.25%"]:empty,
.mobil-haber-detay-card-content-text div[style*="padding-bottom:56.25%"]:empty,
.mobil-haber-detay-card-content-text div[style*="padding-bottom: 56.25%"]:empty {
    display: none !important;
    height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
}

/* Google Ads - Reklam alanları için min-height (layout shift önleme) */
[id*="div-gpt-ad"] {
    min-height: 50px;
    display: block;
}
/* Diger_1x1 out-of-page: 1x1 + yayın kodu; min-height 50px reklamı bozar */
.t24-diger-1x1-oop {
    min-height: 0 !important;
    width: 1px !important;
    height: 1px !important;
    max-height: 1px !important;
    overflow: hidden !important;
    position: absolute !important;
    left: 0 !important;
    top: 0 !important;
    clip: rect(0, 0, 0, 0) !important;
    pointer-events: none !important;
    margin: 0 !important;
    padding: 0 !important;
    border: 0 !important;
}

/* Tüm reklamlar için sabit height (reklam dolmasa bile boş kalmaması için) */
[id*="div-gpt-ad"] {
    box-sizing: border-box;
}

/* Farklı reklam boyutları için sabit height - Öncelik sırası: Büyükten küçüğe */
/* 600px reklamlar */
[id*="div-gpt-ad"][style*="600px"]:not([style*="1600px"]):not([style*="2600px"]) {
    height: 600px !important;
    min-height: 600px !important;
}

/* 325px reklamlar */
[id*="div-gpt-ad"][style*="325px"]:not([style*="600px"]):not([style*="250px"]):not([style*="200px"]):not([style*="100px"]):not([style*="90px"]):not([style*="50px"]) {
    height: 325px !important;
    min-height: 325px !important;
}

/* 250px reklamlar */
[id*="div-gpt-ad"][style*="250px"]:not([style*="600px"]):not([style*="325px"]):not([style*="200px"]):not([style*="100px"]):not([style*="90px"]):not([style*="50px"]) {
    height: 250px !important;
    min-height: 250px !important;
}

/* 200px reklamlar */
[id*="div-gpt-ad"][style*="200px"]:not([style*="600px"]):not([style*="325px"]):not([style*="250px"]):not([style*="100px"]):not([style*="90px"]):not([style*="50px"]) {
    height: 200px !important;
    min-height: 200px !important;
}

/* 100px reklamlar */
[id*="div-gpt-ad"][style*="100px"]:not([style*="600px"]):not([style*="325px"]):not([style*="250px"]):not([style*="200px"]):not([style*="90px"]):not([style*="50px"]) {
    height: 100px !important;
    min-height: 100px !important;
}

/* 90px reklamlar */
[id*="div-gpt-ad"][style*="90px"]:not([style*="600px"]):not([style*="325px"]):not([style*="250px"]):not([style*="200px"]):not([style*="100px"]):not([style*="50px"]) {
    height: 90px !important;
    min-height: 90px !important;
}

/* 50px reklamlar - En son kontrol edilmeli */
[id*="div-gpt-ad"][style*="50px"]:not([style*="600px"]):not([style*="325px"]):not([style*="250px"]):not([style*="200px"]):not([style*="100px"]):not([style*="90px"]) {
    height: 50px !important;
    min-height: 50px !important;
}

/* Reklam wrapper'ları için sabit height (display: none olsa bile height korunsun) */
.ad-wrapper-fixed {
    width: 300px !important;
    height: 250px !important;
    min-width: 300px !important;
    min-height: 250px !important;
    position: relative !important;
    display: inline-block !important;
}

/* Reklam wrapper'ları için margin ayarları */
.ad-wrapper-fixed {
    margin: 0 auto 20px auto !important;
}

/* Sonradan yüklenen reklamlar için col-12 margin-top: 0 */
.col-12[id*="div-gpt-ad"] {
    margin-top: 0 !important;
}

/* Story inline ad wrapper */
.story-inline-ad-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    margin: 20px 0;
}

/* Article inline ad wrapper */
.article-inline-ad-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    margin: 20px 0;
}

/* Gallery inline ad wrapper */
.gallery-inline-ad-wrapper {
    width: 100%;
    display: flex;
    justify-content: center;
    margin: 20px 0;
}

/* Sticky sidebar ad */
#div-gpt-ad-story-sidebar-sticky,
#div-gpt-ad-article-sidebar-sticky,
#div-gpt-ad-video-sidebar-sticky {
    position: sticky;
    top: 80px;
    z-index: 10;
}
