<script>
    const input = document.getElementById("searchInputYazar");
    const dropdownYazar = document.getElementById("dropdown");
    if (input && dropdownYazar) {
        input.addEventListener("input", function() {
            const value = this.value.toLowerCase();
            dropdownYazar.innerHTML = "";

            if (value === "") {
                dropdownYazar.style.display = "none";
                return;
            }

            const filtered = dropdownitems.filter(item => item.toLowerCase().includes(value));

            if (filtered.length === 0) {
                dropdownYazar.style.display = "none";
                return;
            }

            filtered.forEach(item => {
                const div = document.createElement("div");
                div.textContent = item;
                div.onclick = () => {
                    input.value = item;
                    dropdown.style.display = "none";
                };
                dropdownYazar.appendChild(div);
            });

            dropdownYazar.style.display = "block";
        });

        document.addEventListener("click", (e) => {
            if (!e.target.closest(".search-container")) {
                dropdownYazar.style.display = "none";
            }
        });

    }
</script>

<script>
    $(document).ready(function() {
        var owl = $(".bir-bakista-bugun-owl");

        owl.owlCarousel({
            loop: false,
            center: false,
            margin: 0,
            dots: true,
            dotsData: true,
            nav: false,
            autoplay: false,
            autoplayTimeout: 3000,
            stagePadding: 0,
            responsive: {
                0: {
                    items: 1
                },
                600: {
                    items: 1
                },
                1000: {
                    items: 1
                }
            }
        });

        owl.on('changed.owl.carousel', function(event) {
            var currentIndex = event.item.index;

            // Aktif class güncelle
            $('.custom-dots span').removeClass('active');
            var activeDot = $('.custom-dots span[data-slide="' + currentIndex + '"]');
            activeDot.addClass('active');

            // 🔥 Aktif dot görünmüyorsa scroll et
            // scrollIntoView ile yumuşak kaydırma
            activeDot[0].scrollIntoView({
                behavior: 'smooth',
                inline: 'center', // 'nearest', 'start' veya 'center' olabilir
                block: 'nearest'
            });
        });

        // Custom dot tıklama ile slider geçişi
        $('.custom-dots span').click(function() {
            var index = $(this).data('slide');
            owl.trigger('to.owl.carousel', [index, 300]);

            // Aktif class'ı güncelle
            $('.custom-dots span').removeClass('active');
            $(this).addClass('active');
        });

        // 🌀 SLIDER DEĞİŞTİĞİNDE DOTA OTOMATİK AKTİF VER
        owl.on('changed.owl.carousel', function(event) {
            var currentIndex = event.item.index;
            $('.custom-dots span').removeClass('active');
            $('.custom-dots span[data-slide="' + currentIndex + '"]').addClass('active');
        });

        // İlk dot'u başlangıçta aktif yap
        $('.custom-dots span').first().addClass('active');

        // Özel butonları Owl Carousel ile bağlama
        $(".custom-prev-btn").click(function() {
            owl.trigger("prev.owl.carousel");
        });

        $(".custom-next-btn").click(function() {
            owl.trigger("next.owl.carousel");
        });

    });
</script>

