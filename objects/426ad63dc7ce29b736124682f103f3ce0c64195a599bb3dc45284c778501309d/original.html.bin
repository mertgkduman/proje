    <script>
      (function () {
        var accessGranted = false;
        var loginUrl = "https:\/\/t24.com.tr\/giris-yap?return=https%3A%2F%2Ft24.com.tr%2Fcevre%2Fafrikanin-nobeli-avukat-arif-ali-cangiya-verildi%252C365566";

        class CustomOfferwallChoice {
          async initialize(params) {
            var Enum = (window.googlefc
              && window.googlefc.offerwall
              && window.googlefc.offerwall.customchoice
              && window.googlefc.offerwall.customchoice.InitializeResponseEnum) || {};

            if (accessGranted) {
              return Enum.ACCESS_GRANTED;
            }

            return Enum.ACCESS_NOT_GRANTED;
          }

          async show() {
            window.location.href = loginUrl;
            return false;
          }
        }

        window.googlefc = window.googlefc || {};
        window.googlefc.offerwall = window.googlefc.offerwall || {};
        window.googlefc.offerwall.customchoice = window.googlefc.offerwall.customchoice || {};
        window.googlefc.offerwall.customchoice.registry = new CustomOfferwallChoice();

        // "Zaten abone misiniz?" linkinin adresi Funding Choices panelinde sabit; ziyaretçinin domainindeki girişe çevrilir.
        function fixSubscriptionLinks(root) {
          var links = (root || document).querySelectorAll('a.fc-subscription-link');
          for (var i = 0; i < links.length; i++) {
            if (links[i].href !== loginUrl) {
              links[i].href = loginUrl;
            }
          }
        }

        if (window.MutationObserver) {
          new MutationObserver(function (mutations) {
            for (var i = 0; i < mutations.length; i++) {
              if (mutations[i].addedNodes.length) {
                fixSubscriptionLinks();
                return;
              }
            }
          }).observe(document.documentElement, { childList: true, subtree: true });
        }
      })();
    </script>
    
