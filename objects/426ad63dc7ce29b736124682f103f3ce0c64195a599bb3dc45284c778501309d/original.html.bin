  window.googletag = window.googletag || {cmd: []};
  window.googletag.cmd = window.googletag.cmd || [];
  
  // googletag için global alias (güvenlik için)
  var googletag = window.googletag;
  
  // Google Ad Manager script'ini direkt yükle (çerez politikasından bağımsız)
  // Script yüklendikten sonra cmd queue'daki tüm komutlar otomatik çalışacak
  (function() {
    // Script'in zaten yüklenip yüklenmediğini kontrol et
    var gptScriptExists = document.querySelector('script[src*="securepubads.g.doubleclick.net/tag/js/gpt.js"]');
    
    if (!gptScriptExists) {
      // Script'i yükle
      var gptScript = document.createElement('script');
      gptScript.async = true;
      gptScript.src = 'https://securepubads.g.doubleclick.net/tag/js/gpt.js';
      gptScript.crossOrigin = 'anonymous';
      gptScript.onload = function() {
        // Script yüklendikten sonra cmd queue'daki tüm komutları çalıştır
        // googletag.cmd.push ile eklenen tüm fonksiyonlar otomatik çalışacak
        console.log('Google Ad Manager script loaded successfully');
      };
      gptScript.onerror = function() {
        console.error('Failed to load Google Ad Manager script');
      };
      document.head.appendChild(gptScript);
    } else {
      // Script zaten yüklenmiş, cmd queue'daki komutları çalıştır
      if (window.googletag && window.googletag.cmd && Array.isArray(window.googletag.cmd)) {
        var cmdQueue = window.googletag.cmd.slice(0);
        cmdQueue.forEach(function(cmd) {
          if (typeof cmd === 'function') {
            try {
              cmd();
            } catch(e) {
              console.error('Google Ads cmd error:', e);
            }
          }
        });
      }
    }
  })();
</script>




