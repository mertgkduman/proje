<style>
    .mobile-accordion-item {
        width: 100%;
    }

    .mobile-accordion-toggle {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 12px 0;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
    }

    .mobile-accordion-toggle:hover {
        opacity: 0.8;
    }

    .mobile-accordion-icon {
        font-size: 20px;
        font-weight: bold;
        transition: transform 0.3s ease;
        display: inline-block;
    }

    .mobile-accordion-toggle.active .mobile-accordion-icon {
        transform: rotate(45deg);
    }

    .mobile-accordion-content {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
        padding-left: 20px;
    }

    .mobile-accordion-content.active {
        max-height: 500px;
    }

    .mobile-accordion-content a {
        display: block;
        padding: 10px 0;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
    }

    .mobile-accordion-content a:hover {
        opacity: 0.8;
        padding-left: 10px;
    }

    /* Sub-accordion için stiller (Video alt menüsü) */
    .mobile-accordion-sub-item {
        position: relative;
    }

    .mobile-accordion-sub-toggle {
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        padding: 10px 0;
        cursor: pointer;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
    }

    .mobile-accordion-sub-toggle:hover {
        opacity: 0.8;
    }

    .mobile-accordion-sub-icon {
        font-size: 18px;
        font-weight: bold;
        transition: transform 0.3s ease;
        display: inline-block;
    }

    .mobile-accordion-sub-toggle.active .mobile-accordion-sub-icon {
        transform: rotate(45deg);
    }

    .mobile-accordion-sub-content {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease;
        padding-left: 20px;
    }

    .mobile-accordion-sub-content.active {
        max-height: 500px;
    }

    .mobile-accordion-sub-content a {
        display: block;
        padding: 8px 0;
        text-decoration: none;
        color: inherit;
        transition: all 0.3s ease;
    }

    .mobile-accordion-sub-content a:hover {
        opacity: 0.8;
        padding-left: 10px;
    }
</style>

<script>
    function toggleMobileAccordion(element) {
        const accordionItem = element.closest('.mobile-accordion-item');
        const accordionContent = accordionItem.querySelector('.mobile-accordion-content');
        const isActive = element.classList.contains('active');

        // Tüm accordion'ları kapat
        document.querySelectorAll('.mobile-accordion-toggle').forEach(function(toggle) {
            toggle.classList.remove('active');
        });
        document.querySelectorAll('.mobile-accordion-content').forEach(function(content) {
            content.classList.remove('active');
        });

        // Eğer tıklanan accordion zaten açık değilse, onu aç
        if (!isActive) {
            element.classList.add('active');
            accordionContent.classList.add('active');
        }
    }

    function toggleMobileSubAccordion(element) {
        const subItem = element.closest('.mobile-accordion-sub-item');
        const subContent = subItem.querySelector('.mobile-accordion-sub-content');
        const isActive = element.classList.contains('active');

        // Aynı parent içindeki diğer sub-accordion'ları kapat
        const parentAccordion = element.closest('.mobile-accordion-content');
        if (parentAccordion) {
            parentAccordion.querySelectorAll('.mobile-accordion-sub-toggle').forEach(function(toggle) {
                if (toggle !== element) {
                    toggle.classList.remove('active');
                }
            });
            parentAccordion.querySelectorAll('.mobile-accordion-sub-content').forEach(function(content) {
                if (content !== subContent) {
                    content.classList.remove('active');
                }
            });
        }

        // Eğer tıklanan sub-accordion zaten açık değilse, onu aç
        if (!isActive) {
            element.classList.add('active');
            subContent.classList.add('active');
        } else {
            element.classList.remove('active');
            subContent.classList.remove('active');
        }
    }
</script>




