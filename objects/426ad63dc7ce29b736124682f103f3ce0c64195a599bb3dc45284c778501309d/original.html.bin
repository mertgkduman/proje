    }
</script>



<script>
    // Resmi ilanlar sayfasında bu script'i çalıştırma (kendi datepicker'ı var)
    const isOfficialAnnouncementPage = window.location.pathname.includes('/resmi-ilanlar');
    
    if (!isOfficialAnnouncementPage && document.getElementById('tarih') && document.getElementById('datepickerDropdown') && document.getElementById(
            'currentMonthYear') && document.getElementById('datepickerGrid') && document.getElementById('prevMonth') &&
        document.getElementById('nextMonth') && document.getElementById('clearDate') && document.getElementById(
            'todayDate')) {



        // Set initial date if year, month, day parameters exist
                    const initialDate = new Date();
        

        class CustomDatePicker {
            constructor() {
                this.input = document.getElementById('tarih');
                this.dropdown = document.getElementById('datepickerDropdown');
                this.currentMonthYear = document.getElementById('currentMonthYear');
                this.grid = document.getElementById('datepickerGrid');
                this.prevBtn = document.getElementById('prevMonth');
                this.nextBtn = document.getElementById('nextMonth');
                this.clearBtn = document.getElementById('clearDate');
                this.todayBtn = document.getElementById('todayDate');

                this.currentDate = new Date(initialDate);
                this.selectedDate = new Date(initialDate);
                this.isOpen = false;

                this.monthNames = [
                    'Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran',
                    'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık'
                ];

                this.dayNames = ['Pt', 'Sa', 'Ça', 'Pe', 'Cu', 'Ct', 'Pz'];

                this.init();
            }

            init() {
                this.renderCalendar();
                this.bindEvents();
                this.input.value = this.formatDate(this.selectedDate);

            }

            bindEvents() {
                // Input tıklama
                this.input.addEventListener('click', () => {
                    this.toggle();
                });

                // Dropdown dışına tıklama
                document.addEventListener('click', (e) => {
                    if (!this.input.contains(e.target) && !this.dropdown.contains(e.target)) {
                        this.close();
                    }
                });

                // Navigasyon butonları
                this.prevBtn.addEventListener('click', () => {
                    this.currentDate.setMonth(this.currentDate.getMonth() - 1);
                    this.renderCalendar();
                });

                this.nextBtn.addEventListener('click', () => {
                    this.currentDate.setMonth(this.currentDate.getMonth() + 1);
                    this.renderCalendar();
                });

                // Aksiyon butonları
                this.clearBtn.addEventListener('click', () => {
                    this.clearDate();
                });

                this.todayBtn.addEventListener('click', () => {
                    this.selectToday();
                });
            }

            renderCalendar() {
                const year = this.currentDate.getFullYear();
                const month = this.currentDate.getMonth();

                // Ay ve yıl başlığını güncelle
                this.renderMonthYearControls(year, month);

                // Grid'i temizle
                this.grid.innerHTML = '';

                // Gün başlıklarını ekle
                this.dayNames.forEach(day => {
                    const dayHeader = document.createElement('div');
                    dayHeader.className = 'datepicker-day-header';
                    dayHeader.textContent = day;
                    this.grid.appendChild(dayHeader);
                });

                // Ayın ilk günü ve son günü
                const firstDay = new Date(year, month, 1);
                const lastDay = new Date(year, month + 1, 0);
                const daysInMonth = lastDay.getDate();
                const startingDayOfWeek = (firstDay.getDay() + 6) % 7; // Pazartesi'den başlayacak şekilde ayarla

                // Önceki ayın günlerini ekle
                const prevMonth = new Date(year, month, 0);
                const daysInPrevMonth = prevMonth.getDate();

                for (let i = startingDayOfWeek - 1; i >= 0; i--) {
                    const day = document.createElement('div');
                    day.className = 'datepicker-day other-month';
                    day.textContent = daysInPrevMonth - i;
                    this.grid.appendChild(day);
                }

                // Bu ayın günlerini ekle
                const today = new Date();
                for (let day = 1; day <= daysInMonth; day++) {
                    const dayElement = document.createElement('div');
                    dayElement.className = 'datepicker-day';
                    dayElement.textContent = day;

                    // Bugün kontrolü
                    if (year === today.getFullYear() && month === today.getMonth() && day === today.getDate()) {
                        dayElement.classList.add('today');
                    }

                    // Seçili gün kontrolü
                    if (this.selectedDate &&
                        year === this.selectedDate.getFullYear() &&
                        month === this.selectedDate.getMonth() &&
                        day === this.selectedDate.getDate()) {
                        dayElement.classList.add('selected');
                    }

                    dayElement.addEventListener('click', () => {
                        this.selectDate(new Date(year, month, day));
                    });

                    this.grid.appendChild(dayElement);
                }

                // Sonraki ayın günlerini ekle (takvimi tamamlamak için)
                const totalCells = this.grid.children.length - 7; // Gün başlıklarını çıkar
                const remainingCells = 42 - totalCells; // 6 satır x 7 gün = 42 hücre

                for (let day = 1; day <= remainingCells; day++) {
                    const dayElement = document.createElement('div');
                    dayElement.className = 'datepicker-day other-month';
                    dayElement.textContent = day;
                    this.grid.appendChild(dayElement);
                }
            }

            renderMonthYearControls(year, month) {
                if (!this.currentMonthYear) return;
                const minYear = 2000;
                const maxYear = new Date().getFullYear() + 1;
                const monthOptions = this.monthNames
                    .map((name, idx) => `<option value="${idx}" ${idx === month ? 'selected' : ''}>${name}</option>`)
                    .join('');
                let yearOptions = '';
                for (let y = maxYear; y >= minYear; y--) {
                    yearOptions += `<option value="${y}" ${y === year ? 'selected' : ''}>${y}</option>`;
                }

                this.currentMonthYear.innerHTML = `
                    <div class="d-flex gap-1 align-items-center justify-content-center">
                        <select class="form-select form-select-sm" data-role="month" style="max-width: 130px;">
                            ${monthOptions}
                        </select>
                        <select class="form-select form-select-sm" data-role="year" style="max-width: 96px;">
                            ${yearOptions}
                        </select>
                    </div>
                `;

                const monthSelect = this.currentMonthYear.querySelector('[data-role="month"]');
                const yearSelect = this.currentMonthYear.querySelector('[data-role="year"]');
                if (monthSelect) {
                    monthSelect.addEventListener('change', () => {
                        this.currentDate.setMonth(parseInt(monthSelect.value, 10), 1);
                        this.renderCalendar();
                    });
                }
                if (yearSelect) {
                    yearSelect.addEventListener('change', () => {
                        this.currentDate.setFullYear(parseInt(yearSelect.value, 10), this.currentDate.getMonth(), 1);
                        this.renderCalendar();
                    });
                }
            }

            selectDate(date) {
                this.selectedDate = date;
                this.input.value = this.formatDate(date);
                this.close();
                this.renderCalendar();


                // Seçilen tarihe göre URL oluştur
                const formattedYear = date.getFullYear();
                const formattedMonth = String(date.getMonth() + 1).padStart(2, '0');
                const formattedDay = String(date.getDate()).padStart(2, '0');
                
                // Mevcut sayfa URL'sine göre base URL belirle
                const currentPath = window.location.pathname;
                let baseUrl;
                
                if (currentPath.includes('/bir-bakista-bugun')) {
                    baseUrl = 'https://t24.com.tr/bir-bakista-bugun';
                } else {
                    baseUrl = 'https://t24.com.tr/basin';
                }
                
                window.location.href = `${baseUrl}/${formattedYear}/${formattedMonth}/${formattedDay}`;
                // Tarih seçildiğinde AJAX isteği gönder
                //this.loadPaperData(date);
            }

            selectToday() {
                this.selectDate(new Date());
            }

            clearDate() {
                this.selectedDate = null;
                this.input.value = '';
                this.close();
                this.renderCalendar();

                // Tüm verileri yükle
                this.loadPaperData(null);
            }

            formatDate(date) {
                const day = String(date.getDate()).padStart(2, '0');
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const year = date.getFullYear();
                return `${day}.${month}.${year}`;
            }

            toggle() {
                if (this.isOpen) {
                    this.close();
                } else {
                    this.open();
                }
            }

            open() {
                this.dropdown.classList.add('show');
                this.isOpen = true;
            }

            close() {
                this.dropdown.classList.remove('show');
                this.isOpen = false;
            }

            loadPaperData(date) {
                // Bu fonksiyon backend'den tarihe göre veri çekmek için kullanılacak
                console.log('Tarih seçildi:', date ? this.formatDate(date) : 'Tüm tarihler');

                // AJAX isteği burada yapılabilir
                // $.ajax({
                //     url: '/api/paper-data',
                //     method: 'GET',
                //     data: { date: date ? this.formatDate(date) : null },
                //     success: function(response) {
                //         // Verileri güncelle
                //     }
                // });
            }
        }

        // Sayfa yüklendiğinde datepicker'ı başlat (highlight, editorial, dailysummary, basin ve resmi-ilanlar sayfalarında çalışmasın)
        document.addEventListener('DOMContentLoaded', function() {
            // Highlight, editorial, dailysummary, basin ve resmi-ilanlar sayfalarında çalışmasın (kendi datepicker'ları var)
            const currentPath = window.location.pathname;
            if (!currentPath.includes('/manset-arsivi') && 
                !currentPath.includes('/highlight') && 
                !currentPath.includes('/editorun-sectikleri') &&
                !currentPath.includes('/bir-bakista-bugun') &&
                !currentPath.includes('/basin') &&
                !currentPath.includes('/resmi-ilanlar')) {
                new CustomDatePicker();
            }
        });

    }
</script>

<script>
    // Paylaşım Modal İşlemleri
    const shareButton = document.getElementById('shareButton');
    const shareModal = document.getElementById('shareModal');
    const shareModalBody = shareModal ? shareModal.querySelector('.share-modal-body') : null;
    const closeModal = document.querySelector('.close-modal');
    const copyLinkButton = document.getElementById('copyLinkButton');
    const shareFacebookLink = document.getElementById('shareFacebookLink');
    const shareTwitterLink = document.getElementById('shareTwitterLink');
    const shareWhatsappLink = document.getElementById('shareWhatsappLink');
    const shareLinkedinLink = document.getElementById('shareLinkedinLink');
    let currentShareUrl = '';

    function getShareUrlWithTimestamp() {
        const shareUrl = new URL(window.location.href);
        shareUrl.searchParams.set('_t', Date.now().toString());
        return shareUrl.toString();
    }

    function updateShareLinks(shareUrl) {
        const shareTitle = shareModalBody ? (shareModalBody.dataset.shareTitle || '') : '';
        const encodedUrl = encodeURIComponent(shareUrl);
        const encodedTitle = encodeURIComponent(shareTitle);

        if (shareFacebookLink) {
            shareFacebookLink.href = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
        }

        if (shareTwitterLink) {
            shareTwitterLink.href = `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`;
        }

        if (shareWhatsappLink) {
            shareWhatsappLink.href = `https://wa.me/?text=${encodeURIComponent(`${shareTitle} ${shareUrl}`.trim())}`;
        }

        if (shareLinkedinLink) {
            shareLinkedinLink.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
        }
    }

    if(shareButton && shareModal && closeModal && copyLinkButton){
    // Modal açma
    shareButton.addEventListener('click', function(e) {
        e.preventDefault();
        currentShareUrl = getShareUrlWithTimestamp();
        updateShareLinks(currentShareUrl);
        shareModal.style.display = 'flex';
    });

    // Modal kapatma
    closeModal.addEventListener('click', function() {
        shareModal.style.display = 'none';
    });

    // Modal dışına tıklayınca kapatma
    window.addEventListener('click', function(e) {
        if (e.target === shareModal) {
            shareModal.style.display = 'none';
        }
    });

    // Link kopyalama
    copyLinkButton.addEventListener('click', function(e) {
        e.preventDefault();
        if (!currentShareUrl) {
            currentShareUrl = getShareUrlWithTimestamp();
            updateShareLinks(currentShareUrl);
        }

        navigator.clipboard.writeText(currentShareUrl).then(function() {
            // Başarılı mesajı
            const originalText = copyLinkButton.querySelector('span').textContent;
            copyLinkButton.querySelector('span').textContent = 'Kopyalandı!';

            setTimeout(function() {
                copyLinkButton.querySelector('span').textContent = originalText;
            }, 2000);
        }).catch(function(err) {
            console.error('Link kopyalanamadı:', err);
            alert('Link kopyalanırken bir hata oluştu.');
        });
    });
    }
</script>

<script>
    // Font Boyutu Yönetimi
    $(document).ready(function() {
        const fontSizePanel = $('#fontSizePanel');
        const fontSizeButton = $('#fontSizeButton');
        const closeFontPanel = $('#closeFontPanel');
        const fontSizeRange = $('#fontSizeRange');
        const fontSizeValue = $('#fontSizeValue');
        const resetFontSize = $('#resetFontSize');
        const contentText = $('.mobil-haber-detay-card-content-text p,.haberdetay p,.mobil-video-detay-sayfasi .video-content p,.mobil-video-detay-sayfasi .video-content li');
        const articleTitle = $('.mobil-yazar-yazi-detay-section h2,.haberdetay h2,.haberdetay h1,.mobil-video-detay-sayfasi .video-content h1');
        const articleExcerpt = $('.mobil-yazar-yazi-detay-section h3,.haberdetay h3,.mobil-haber-detay-card-content-text h3,.mobil-video-detay-sayfasi .video-content h3');
       

        // LocalStorage'dan kayıtlı font boyutunu al
        const savedFontSize = localStorage.getItem('articleFontSize') || 21;
        
        // Sayfa yüklendiğinde kayıtlı font boyutunu uygula
        applyFontSize(savedFontSize);
        fontSizeRange.val(savedFontSize);
        fontSizeValue.text(savedFontSize);

        // Font boyutu panelini aç/kapat
        fontSizeButton.on('click', function(e) {
            e.preventDefault();
            fontSizePanel.fadeToggle(300);
        });

        closeFontPanel.on('click', function() {
            fontSizePanel.fadeOut(300);
        });

        // Panel dışına tıklandığında kapat
        $(document).on('click', function(e) {
            if (!$(e.target).closest('#fontSizePanel, #fontSizeButton').length) {
                fontSizePanel.fadeOut(300);
            }
        });

        // Range slider değiştiğinde
        fontSizeRange.on('input', function() {
            const fontSize = $(this).val();
            fontSizeValue.text(fontSize);
            applyFontSize(fontSize);
            localStorage.setItem('articleFontSize', fontSize);
        });

        // Varsayılan değere dön
        resetFontSize.on('click', function() {
            const defaultSize = 21;
            fontSizeRange.val(defaultSize);
            fontSizeValue.text(defaultSize);
            applyFontSize(defaultSize);
            localStorage.setItem('articleFontSize', defaultSize);
        });

        // Font boyutunu uygulayan fonksiyon
        function applyFontSize(size) {
            contentText.css('font-size', size + 'px');
            articleExcerpt.css('font-size', size*1.3 + 'px');
            // Başlık ve özet için orantılı boyut 
        }
    });

   
</script>


<!-- Image Error Handler - Yüklenmeyen görseller için placeholder -->
<script>
(function() {
    'use strict';
    
    // Placeholder path - config'den al veya sabit kullan
    const PLACEHOLDER_PATH = 'https://t24.com.tr/placeholder.png';
    
    // İşlenmiş görselleri takip et (sonsuz döngüyü önlemek için)
    const processedImages = new WeakSet();

    /**
     * URL'deki path segmentlerini güvenli şekilde encode et.
     * Özellikle "( )" ve boşluk içeren legacy medya URL'leri için.
     */
    function normalizeImageUrl(src) {
        if (!src || typeof src !== 'string') {
            return src;
        }

        // Sadece media-cdn görselleri için uygula.
        if (!src.includes("media-cdn.t24.com.tr")) {
            return src;
        }

        try {
            const urlObj = new URL(src, window.location.origin);
            const segments = urlObj.pathname.split('/').map(function(segment) {
                if (!segment) return segment;
                try {
                    return encodeURIComponent(decodeURIComponent(segment));
                } catch (e) {
                    return encodeURIComponent(segment);
                }
            });
            urlObj.pathname = segments.join('/');
            return urlObj.toString();
        } catch (e) {
            // URL parse edilemezse en azından boşlukları encode et.
            return src.replace(/ /g, '%20');
        }
    }
    
    /**
     * Görsel hatası için handler
     */
    function handleImageError(img) {
        // Eğer zaten işlendiyse veya placeholder ise, tekrar işleme
        if (processedImages.has(img) || img.src === PLACEHOLDER_PATH || img.src.includes('placeholder.png')) {
            return;
        }

        // Placeholder'a düşmeden önce normalize URL ile 1 kez yeniden dene.
        if (!img.dataset.urlNormalizedRetry) {
            const currentSrc = img.getAttribute('src') || img.src || '';
            const normalizedSrc = normalizeImageUrl(currentSrc);
            if (normalizedSrc && normalizedSrc !== currentSrc) {
                img.dataset.urlNormalizedRetry = '1';
                img.src = normalizedSrc;
                return;
            }
            img.dataset.urlNormalizedRetry = '1';
        }
        
        // İşlendi olarak işaretle
        processedImages.add(img);
        
        // Placeholder'a değiştir
        img.src = PLACEHOLDER_PATH;
        
        // Placeholder da yüklenemezse, error event'ini kaldır (sonsuz döngüyü önle)
        img.onerror = function() {
            this.onerror = null; // Event handler'ı kaldır
            this.style.display = 'none'; // Görseli gizle
        };
    }
    
    /**
     * Mevcut tüm görselleri işle
     */
    function processExistingImages() {
        const images = document.querySelectorAll('img:not([data-error-handled])');
        images.forEach(function(img) {
            // Zaten error handler varsa atla
            if (img.hasAttribute('data-error-handled')) {
                return;
            }
            
            // Attribute ekle (tekrar işlenmesini önle)
            img.setAttribute('data-error-handled', 'true');

            // İlk yüklemeden önce URL normalize et
            const originalSrc = img.getAttribute('src') || '';
            const normalizedSrc = normalizeImageUrl(originalSrc);
            if (normalizedSrc && normalizedSrc !== originalSrc) {
                img.setAttribute('src', normalizedSrc);
            }
            
            // Eğer görsel zaten yüklenmişse ve hata varsa kontrol et
            if (img.complete && img.naturalHeight === 0) {
                handleImageError(img);
            } else {
                // Error event handler ekle
                img.addEventListener('error', function() {
                    handleImageError(this);
                }, { once: true }); // once: true ile sadece bir kez çalışsın
            }
        });
    }
    
    /**
     * Dinamik eklenen görselleri yakala (MutationObserver)
     */
    function observeNewImages() {
        // MutationObserver sadece modern tarayıcılarda çalışır
        if (typeof MutationObserver === 'undefined') {
            return;
        }
        
        const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                mutation.addedNodes.forEach(function(node) {
                    // Eğer node bir img ise
                    if (node.nodeType === 1 && node.tagName === 'IMG') {
                        if (!node.hasAttribute('data-error-handled')) {
                            node.setAttribute('data-error-handled', 'true');
                            node.addEventListener('error', function() {
                                handleImageError(this);
                            }, { once: true });
                        }
                    }
                    
                    // Eğer node içinde img'ler varsa
                    if (node.nodeType === 1 && node.querySelectorAll) {
                        const images = node.querySelectorAll('img:not([data-error-handled])');
                        images.forEach(function(img) {
                            img.setAttribute('data-error-handled', 'true');
                            img.addEventListener('error', function() {
                                handleImageError(this);
                            }, { once: true });
                        });
                    }
                });
            });
        });
        
        // Document body'yi gözlemle
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    }
    
    // DOM yüklendiğinde çalıştır
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            processExistingImages();
            observeNewImages();
        });
    } else {
        // DOM zaten yüklüyse hemen çalıştır
        processExistingImages();
        observeNewImages();
    }
})();
</script>
<script>
(function () {
    var statusUrl = "https:\/\/t24.com.tr\/webuser\/nav-status";

    function applyWebUserNav(data) {
        if (!data || typeof data !== 'object') return;

        var loggedIn = !!data.logged_in;
        document.querySelectorAll('[data-webuser-nav="guest"]').forEach(function (el) {
            el.hidden = loggedIn;
        });
        document.querySelectorAll('[data-webuser-nav="user"]').forEach(function (el) {
            if (el.hasAttribute('data-webuser-subscribe')) {
                el.hidden = !loggedIn || !!data.has_active_membership;
            } else {
                el.hidden = !loggedIn;
            }
        });
        document.querySelectorAll('[data-webuser-subscribe]').forEach(function (el) {
            if (el.getAttribute('data-webuser-nav') === 'user') {
                el.hidden = !loggedIn || !!data.has_active_membership;
            }
        });

        var firstName = (data.first_name || '').trim();
        document.querySelectorAll('[data-webuser-first-name]').forEach(function (el) {
            el.textContent = firstName ? (', ' + firstName) : '';
        });
        document.querySelectorAll('[data-webuser-first-name-text]').forEach(function (el) {
            el.textContent = firstName;
        });

        window.dispatchEvent(new CustomEvent('t24:webuser-status', { detail: data }));
    }

    function loadWebUserNav() {
        fetch(statusUrl, {
            credentials: 'same-origin',
            headers: {
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest'
            }
        }).then(function (response) {
            if (!response.ok) return null;
            return response.json();
        }).then(function (data) {
            if (data) applyWebUserNav(data);
        }).catch(function () {});
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loadWebUserNav);
    } else {
        loadWebUserNav();
    }
})();
</script>

</body>

