            transform: translateY(-1px);
        }
    </style>

<div class="t24-subscription-callout" role="region" aria-label="T24 abonelik">
    <div class="t24-subscription-callout-top">
        <p class="t24-subscription-callout-login" style="margin-top: 0; margin-bottom: 1rem; font-size: 21px;">
            BU HABERİ, T24 ABONELERİNİN DE
            SAĞLADIĞI KATKIYLA OKUYORSUNUZ.
            <br><br>
