            <!-- Story Title -->
            <h1 class="mb-2">Afrika’nın Nobel’i Avukat Arif Ali Cangı’ya verildi</h1>

            
                            <h2>Nükleersiz Gelecek Ödülleri, ilk defa Türkiye’den bir kişiye verildi</h2>
                            
            <!-- Story Cover Image -->
            <div class="haberkapak">
                <img src="http://media-cdn.t24.com.tr/media/stories/2016/10/raw_afrikanin-nobeli-avukat-arif-ali-cangiya-verildi_208308601.jpg" alt="">

                        </div>

             

            <div class="mobil-haber-detay-card-content-date-share">

                <div class="mobil-haber-detay-card-content-published-date">
