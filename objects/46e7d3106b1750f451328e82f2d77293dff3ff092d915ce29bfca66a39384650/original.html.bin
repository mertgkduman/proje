                En iyi site deneyimi sağlamak için çerezlerden faydalanıyoruz. Detaylar için lütfen tıklayın.
                            </span>

            <button class="js-cookie-consent-agree cookie-consent__agree" style="background-color: #000 !important; color: #fff !important; border: 1px solid #fff !important;">
                Tamam
            </button>
        </div>
    </div>
    <div data-site-cookie-name="te_cookie_consent"></div>
    <div data-site-cookie-lifetime="7300"></div>
    <div data-site-cookie-domain="www.manisahaber.com"></div>
    <div data-site-session-secure=";secure"></div>

    
    <script>
        (function () {
            function init() {
                if (typeof window.jQuery === 'undefined') { return; }
                var $ = window.jQuery;
                var COOKIE_VALUE    = 1;
                var COOKIE_NAME     = $('div[data-site-cookie-name]').data('site-cookie-name');
                var COOKIE_DOMAIN   = $('div[data-site-cookie-domain]').data('site-cookie-domain');
                var COOKIE_LIFETIME = $('div[data-site-cookie-lifetime]').data('site-cookie-lifetime');
                var SESSION_SECURE  = $('div[data-site-session-secure]').data('site-session-secure') || '';

                function cookieExists(name) {
                    return document.cookie.split('; ').indexOf(name + '=' + COOKIE_VALUE) !== -1;
                }
                function showDialog() {
                    $('.js-cookie-consent').removeClass('is-hidden').each(function () {
                        this.style.setProperty('display', 'block', 'important');
                    });
                }
                function hideDialog() {
                    $('.js-cookie-consent').addClass('is-hidden').each(function () {
                        this.style.setProperty('display', 'none', 'important');
                    });
                }
                function setCookie() {
                    var date = new Date();
                    date.setTime(date.getTime() + (COOKIE_LIFETIME * 24 * 60 * 60 * 1000));
                    document.cookie = COOKIE_NAME + '=' + COOKIE_VALUE
                        + ';expires=' + date.toUTCString()
                        + ';domain=' + COOKIE_DOMAIN
                        + ';path=/' + SESSION_SECURE;
                }

                if (cookieExists(COOKIE_NAME)) { hideDialog(); } else { showDialog(); }

                $(document).on('click', '.js-cookie-consent-agree', function () {
                    setCookie();
                    hideDialog();
                });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', init);
            } else {
                init();
            }
        })();
    </script>





    

    
    <input type="hidden" name="_js_token" value="" data-challenge="eyJpdiI6ImJKUm5wdVM4cy9iTEp4aHREOVJhTEE9PSIsInZhbHVlIjoiaExzdWVtVEFWWTRGcTRMcWI4WVQ1bERQRDVGUFVSOXRBeXB3VGNBemZYcmRvWXllVzZsdjI5eVpmYmU5eUFBWSIsIm1hYyI6ImE5YTA4ZmExZTMwMmM5ZmM2ZGIxYzEyNWNhNzA5OTZjMzdmNzlmODU0OGM2NTg4NTk1YmVhODViMGZlNDYwZmQiLCJ0YWciOiIifQ==">

<script data-cfasync="false">
(function() {
    // Bir input'u KENDİ data-challenge'ı ile doldurur. Doldurulmuş input'a dokunmaz.
    function fill(input) {
        if (!input || input.name !== '_js_token') return;
        var challenge = input.getAttribute('data-challenge');
        if (!challenge) return;
        input.value = btoa(JSON.stringify({
            ch: challenge,
            t: Math.floor(Date.now() / 1000),
            r: Math.random().toString(36).substr(2, 9)
        }));
    }

    // 1) Hızlı yol: currentScript ile KENDİ input'unu bul, querySelector ile DEĞİL.
    // querySelector('input[name="_js_token"]') sayfadaki İLK input'u alıyordu; footer'da
    // da bu component olduğu için arama/iletişim formundaki input hiç doldurulmuyordu.
    // Rastgele id ÇÖZÜM DEĞİL: md5(uniqid()) HTML'i her render'da değiştirip cache'i kırar.
    var s = document.currentScript;
    var own = s ? s.previousElementSibling : null;
    fill(own);

    // Form submit edilmeden önce token'ı tazele (t/r alanları yenilensin).
    if (own && own.name === '_js_token') {
        var form = own.closest ? own.closest('form') : null;
        if (form) form.addEventListener('submit', function () { fill(own); });
    }

    // 2) EMNİYET AĞI (2026-09-14 — arama beyaz ekran): document.currentScript null
    // olabiliyor (inline script'i taşıyan/erteleyen edge katmanları — ör. Rocket
    // Loader —, eski tarayıcılar, HTML'i yeniden enjekte eden tema script'leri).
    // O durumda token BOŞ gidiyor, ValidateJsToken POST'u reddediyordu.
    // DOM hazır olunca HÂLÂ boş kalan TÜM _js_token input'larını, her biri KENDİ
    // data-challenge'ı ile doldur. Sunucu HTML'i değişmiyor → full-page cache bozulmaz.
    // Component sayfada birden çok kez render olabilir (footer + arama formu).
    // Belge seviyesindeki dinleyiciler SADECE BİR KEZ kurulsun.
    if (window.__teJsTokenGlobal) return;
    window.__teJsTokenGlobal = 1;

    function sweep() {
        var list = document.querySelectorAll('input[name="_js_token"]');
        for (var i = 0; i < list.length; i++) {
            if (!list[i].value) fill(list[i]);
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', sweep);
    } else {
        sweep();
    }

    // Submit anında da son bir kez: form'a sonradan eklenen/boş kalan input'u yakala.
    document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!form || !form.querySelectorAll) return;
        var list = form.querySelectorAll('input[name="_js_token"]');
        for (var i = 0; i < list.length; i++) fill(list[i]);
    }, true);
})();
</script>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        var menuElement = document.querySelector('#mobile-menu');
        var menuTriggers = document.querySelectorAll('a[href="#menu"]'); // Birden fazla tetikleyici iÃ§in
        var menuClose = document.querySelector('#mobile-menu #menu_close');

        var locale = "tr";
        var menuTitle = (locale === 'tr') ? 'MENÜ' : 'MENU';

        if (menuElement && menuTriggers.length > 0 && menuClose) {
            var menu = new MmenuLight(menuElement, 'all');
            var navigator = menu.navigation({
                // selectedClass: 'Selected',
                slidingSubmenus: true,
                // theme: 'dark',
                title: menuTitle
            });
            var drawer = menu.offcanvas({
                position: 'left'
            });

            // Menü aÃ§ma
            menuTriggers.forEach(function(trigger) {
                trigger.addEventListener('click', function(evnt) {
                    evnt.preventDefault();
                    drawer.open();
                });
            });

            // Menü kapama
            menuClose.addEventListener('click', function(event) {
                event.preventDefault();
                drawer.close();
            });
        }
    });
</script>

