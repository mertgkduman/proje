<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@type":"Thing","@id":"https:\/\/www.manisahaber.com","name":"Haberler"}},{"@type":"ListItem","position":2,"item":{"@type":"Thing","@id":"https:\/\/www.manisahaber.com\/siyaset","name":"Siyaset"}},{"@type":"ListItem","position":3,"item":{"@type":"Thing","@id":"https:\/\/www.manisahaber.com\/yeni-parti-manisada-kongre-takvimi-aciklandi","name":"YEN\u0130 Parti Manisa\u2019da kongre takvimi a\u00e7\u0131kland\u0131"}}]}</script>
<script type="application/ld+json">{"@context":"https:\/\/schema.org","@type":"NewsArticle","headline":"YEN\u0130 Parti Manisa\u2019da kongre takvimi a\u00e7\u0131kland\u0131","articleSection":"Siyaset","dateCreated":"2026-08-31T14:44:00+03:00","datePublished":"2026-08-31T14:44:00+03:00","dateModified":"2026-08-31T14:44:00+03:00","wordCount":237,"genre":"news","mainEntityOfPage":{"@type":"WebPage","@id":"https:\/\/www.manisahaber.com\/yeni-parti-manisada-kongre-takvimi-aciklandi"},"articleBody":"Kongre takvimine g\u00f6re 3 - 6 Ekim tarihleri aras\u0131nda, \u00fcye say\u0131s\u0131 400\u2019den fazla olan yerlerde il\u00e7e ba\u015fkan\u0131 \u00f6n se\u00e7imleri ger\u00e7ekle\u015ftirilecek. \u00d6n se\u00e7im s\u00fcrecinin ard\u0131ndan 18 Ekim tarihinde il\u00e7e kongreleri yap\u0131lacak.\r\n\r\n\u0130l\u00e7e kongrelerinin tamamlanmas\u0131n\u0131n ard\u0131ndan YEN\u0130 Parti Manisa\u2019da il ba\u015fkan\u0131 \u00f6n se\u00e7im s\u00fcreci ba\u015flayacak. \u0130l ba\u015fkan\u0131 \u00f6n se\u00e7iminin 24 - 27 Ekim tarihleri aras\u0131nda yap\u0131lmas\u0131 planlan\u0131yor.\r\n\r\nYEN\u0130 Parti Manisa\u2019n\u0131n kongre s\u00fcreci, Ekim ay\u0131nda yap\u0131lacak il kongresi ile tamamlanacak. \u0130l kongresinin ard\u0131ndan Manisa il te\u015fkilat\u0131n\u0131n yeni y\u00f6netiminin belirlenmesi bekleniyor.\r\n\r\nYEN\u0130 Parti Manisa \u0130l Ba\u015fkanl\u0131\u011f\u0131 taraf\u0131ndan a\u00e7\u0131klanan takvim do\u011frultusunda s\u00fcre\u00e7 \u015f\u00f6yle i\u015fleyecek: 26 A\u011fustos - 1 Eyl\u00fcl tarihleri aras\u0131nda \u00fcye listelerinin ask\u0131ya \u00e7\u0131kar\u0131lmas\u0131 ve ask\u0131dan indirilmesi, 3 Eyl\u00fcl tarihinde il\u00e7e itirazlar\u0131n\u0131n karara ba\u011flanmas\u0131, 5 Eyl\u00fcl tarihinde il y\u00f6netimine itirazlar\u0131n son g\u00fcn\u00fc, 7 Eyl\u00fcl tarihinde il itirazlar\u0131n\u0131n kesin karara ba\u011flanmas\u0131 ger\u00e7ekle\u015ftirilecek.\r\n\r\nTakvimin devam\u0131nda 12 Eyl\u00fcl tarihinde il\u00e7e ba\u015fkan\u0131 \u00f6n se\u00e7imi, 3 - 6 Ekim tarihleri aras\u0131nda \u00fcye say\u0131s\u0131 400\u2019den fazla olan yerlerde il\u00e7e ba\u015fkan\u0131 \u00f6n se\u00e7imi, 18 Ekim tarihinde il\u00e7e kongreleri, 24 - 27 Ekim tarihleri aras\u0131nda il ba\u015fkan\u0131 \u00f6n se\u00e7imi ve Ekim ay\u0131nda il kongresi yap\u0131lacak.\r\n\r\n","description":"YEN\u0130 Parti Manisa yapt\u0131\u011f\u0131 resmi a\u00e7\u0131klamada kongre takvimini payla\u015ft\u0131.","inLanguage":"tr-TR","keywords":[],"image":{"@type":"ImageObject","url":"https:\/\/manisahabercom.teimg.com\/crop\/1280x720\/manisahaber-com\/uploads\/2026\/08\/yni.jpg","width":"1280","height":"720","caption":"YEN\u0130 Parti Manisa\u2019da kongre takvimi a\u00e7\u0131kland\u0131"},"isFamilyFriendly":"http:\/\/schema.org\/True","isAccessibleForFree":"http:\/\/schema.org\/True","publisher":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.manisahaber.com\/#organization","name":"Manisa Haber","image":"https:\/\/manisahabercom.teimg.com\/manisahaber-com\/uploads\/2026\/06\/0ad0d75a-0436-499f-a103-e82254f7eb93-1.png","logo":{"@type":"ImageObject","url":"https:\/\/manisahabercom.teimg.com\/manisahaber-com\/uploads\/2026\/06\/0ad0d75a-0436-499f-a103-e82254f7eb93-1.png","width":"640","height":"375"}},"author":{"@type":"Person","name":"Mert Demirer","url":"https:\/\/www.manisahaber.com\/muhabir\/17\/mert-demirer"},"editor":{"@type":"Person","name":"Mert Demirer","url":"https:\/\/www.manisahaber.com\/muhabir\/17\/mert-demirer"},"creator":{"@type":"NewsMediaOrganization","@id":"https:\/\/www.manisahaber.com\/#organization","name":"Manisa Haber","url":"https:\/\/www.manisahaber.com"}}</script>


