<div class='post-outer'>
<div class='post hentry' itemprop='blogPost' itemscope='itemscope' itemtype='http://schema.org/BlogPosting'>
<meta content='174811128530515465' itemprop='blogId'/>
<meta content='2596062461248445202' itemprop='postId'/>
<a name='2596062461248445202'></a>
<h3 class='post-title entry-title' itemprop='name'>
program
</h3>
<div class='post-header'>
<div class='post-header-line-1'></div>
</div>
<div class='post-body entry-content' id='post-body-2596062461248445202' itemprop='description articleBody'>
<h2 style="background-color: white; border: 0px; color: #151515; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 2.5em; line-height: 1.1em; margin: 0px 0px 15px; outline: 0px; padding: 0px;">
<span style="background-color: transparent; color: #444444; font-size: 11pt; line-height: 20.390625px; text-align: justify;">BARIŞ VE DEMOKRASİ PARTİSİ PROGRAMI</span></h2>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt; outline: 0px; padding: 0px; text-align: justify;">
<br /></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt; outline: 0px; padding: 0px; text-align: justify;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">İÇİNDEKİLER</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt; outline: 0px; padding: 0px; text-align: justify;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">GİRİŞ</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt; outline: 0px; padding: 0px; text-align: justify;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">SİYASİ İLKELERİMİZ</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt; outline: 0px; padding: 0px; text-align: justify; text-indent: 35.4pt;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">1-Yeni ve Çağdaş Bir Anayasa için</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 85.5pt; outline: 0px; padding: 0px; text-align: justify; text-indent: -18pt;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;"><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">a.<span style="background-color: transparent; border: 0px; font-family: 'Times New Roman'; font-size: 7pt; line-height: normal; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span></span><span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">Temel Hak ve Özgürlükler</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 85.5pt; outline: 0px; padding: 0px; text-align: justify; text-indent: -18pt;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;"><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">b.<span style="background-color: transparent; border: 0px; font-family: 'Times New Roman'; font-size: 7pt; line-height: normal; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span></span><span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">Hukuk Devleti ve Adalet</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 36pt; outline: 0px; padding: 0px; text-align: justify;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">2. Katılımcı, Demokratik ve Özgür Bir Türkiye için</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 35.4pt; outline: 0px; padding: 0px; text-align: justify;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;"><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;</span><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>a. Kürt Sorununa Demokratik ve Barışçı Çözüm Yolu</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt; outline: 0px; padding: 0px; text-align: justify;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;"><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>b. Kadın Demokratikleşmenin Temel Dinamiğidir</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 35.4pt; outline: 0px; padding: 0px; text-align: justify;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;"><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;</span><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>c. Emeğin Özgürlüğü ve Yaratıcılığı Esastır</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 35.4pt; outline: 0px; padding: 0px; text-align: justify;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;"><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;</span><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>d. Ekolojik Denge &#8211; Sürdürülebilir Bir Yaşam</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt; outline: 0px; padding: 0px; text-align: justify;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;"><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;</span><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>e. Yerinden Yönetim</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt; outline: 0px; padding: 0px; text-align: justify;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;"><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;</span><span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span>f.<span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;</span>Basın Özgürlüğü ve İletişim</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt; outline: 0px; padding: 0px; text-align: justify; text-indent: 35.4pt;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">3. Bölge ve Dünya Siyasetimiz</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt; outline: 0px; padding: 0px; text-align: justify;">
<br /></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt; outline: 0px; padding: 0px; text-align: justify;">
<span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">EKONOMİ POLİTİKAMIZ</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 54pt; outline: 0px; padding: 0px; text-align: justify; text-indent: -18pt;">
<span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">1.<span style="background-color: transparent; border: 0px; font-family: 'Times New Roman'; font-size: 7pt; line-height: normal; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span><span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">Ekonomik Sorunlar</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 54pt; outline: 0px; padding: 0px; text-align: justify; text-indent: -18pt;">
<span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">2.<span style="background-color: transparent; border: 0px; font-family: 'Times New Roman'; font-size: 7pt; line-height: normal; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span><span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">İşsizlikle Mücadele ve İstihdam</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 54pt; outline: 0px; padding: 0px; text-align: justify; text-indent: -18pt;">
<span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">3.<span style="background-color: transparent; border: 0px; font-family: 'Times New Roman'; font-size: 7pt; line-height: normal; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span><span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">Bölgeler Arası Eşitsizlik</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 54pt; outline: 0px; padding: 0px; text-align: justify; text-indent: -18pt;">
<span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">4.<span style="background-color: transparent; border: 0px; font-family: 'Times New Roman'; font-size: 7pt; line-height: normal; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span><span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">Kamu Zararına Özelleştirmeye Karşıyız</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 54pt; outline: 0px; padding: 0px; text-align: justify; text-indent: -18pt;">
<span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">5.<span style="background-color: transparent; border: 0px; font-family: 'Times New Roman'; font-size: 7pt; line-height: normal; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span><span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">Tüketiciler Korunmalı ve Örgütlenmelerinin Önü Açılmalıdır</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 54pt; outline: 0px; padding: 0px; text-align: justify; text-indent: -18pt;">
<span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">6.<span style="background-color: transparent; border: 0px; font-family: 'Times New Roman'; font-size: 7pt; line-height: normal; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span><span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">Vergi Sistemi Gelir Dağılımını Düzeltici Bir Rol Üstlenmelidir</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 54pt; outline: 0px; padding: 0px; text-align: justify; text-indent: -18pt;">
<span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">7.<span style="background-color: transparent; border: 0px; font-family: 'Times New Roman'; font-size: 7pt; line-height: normal; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span><span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">Yeraltı ve Yerüstü Kaynakları Değerlendirmelidir</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 54pt; outline: 0px; padding: 0px; text-align: justify; text-indent: -18pt;">
<span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">8.<span style="background-color: transparent; border: 0px; font-family: 'Times New Roman'; font-size: 7pt; line-height: normal; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span><span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">Uluslararası Ticarette Adil Koşulların Yerleşmesi İçin Mücadele Edilmelidir</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 54pt; outline: 0px; padding: 0px; text-align: justify; text-indent: -18pt;">
<span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">9.<span style="background-color: transparent; border: 0px; font-family: 'Times New Roman'; font-size: 7pt; line-height: normal; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></span><span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">Tarım, Orman ve Hayvancılık Sektörleri Geliştirilmelidir</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt 54pt; outline: 0px; padding: 0px; text-align: justify; text-indent: -18pt;">
<span style="background-color: transparent; border: 0px; margin: 0px; outline: 0px; padding: 0px;">10.<span style="background-color: transparent; border: 0px; font-family: 'Times New Roman'; font-size: 7pt; line-height: normal; margin: 0px; outline: 0px; padding: 0px;">&nbsp;&nbsp;</span></span><span style="background-color: transparent; background-position: initial initial; background-repeat: initial initial; border: 0px; font-size: 11pt; margin: 0px; outline: 0px; padding: 0px;">Turizm Çevreye ve Turistik Bölgelerde Yaşayanlara Zarar Vermeden Geliştirilmelidir</span></div>
<div class="msonospacing0" style="background-color: white; border: 0px; color: #444444; font-family: 'Lucida Grande', 'Lucida Sans Unicode', Helvetica, Arial, sans-serif; font-size: 12px; line-height: 20.390625px; margin: 0cm 0cm 0.0001pt; outline: 0px; padding: 0px; text-align: justify;">
