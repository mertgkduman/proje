                <a class="mt-3" href="https://gaziantepsabah.com/siyaset/deva-partisine-katildilar/130780">
            <div class="d-flex flex-lg-row flex-md-row flex-sm-row align-items-center my-2">
                                <img class="mt-lg-0 mt-md-0 mt-sm-0 flex-shrink-0" width="190" height="110" src="/uploads/oldimg/deva-partisine-katildilar-1645185969-849361-185x110.jpg?token=5fcc559b341791ce472bb9d1823c9028" alt="DEVA Partisi’ne katıldılar">
                

                <div class="ms-3 d-flex justify-content-center flex-column">
