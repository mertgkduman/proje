<style>
        #tmvPromo{position:fixed;bottom:20px;z-index:9990;width:360px;max-width:calc(100vw - 32px);
            background:#fff;border-radius:18px;box-shadow:0 18px 50px rgba(0,0,0,.22);overflow:hidden;
            font-size:14px;line-height:1.5;display:none;animation:tmvPromoIn .38s cubic-bezier(.2,.8,.2,1)}
        #tmvPromo.tmv-pos-right{right:20px;left:auto}
        #tmvPromo.tmv-pos-left{left:20px;right:auto}
        #tmvPromo.tmv-pos-center{left:0;right:0;margin-left:auto;margin-right:auto}
        #tmvPromo.tmv-pos-middle{left:0;right:0;top:0;bottom:0;margin:auto;height:-moz-max-content;height:max-content;max-height:calc(100vh - 40px)}
        @keyframes tmvPromoIn{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
        #tmvPromo .tmv-accent{height:5px}
        #tmvPromo.tmv-g .tmv-accent{background:linear-gradient(90deg,#4285F4,#EA4335,#FBBC05,#34A853)}
        #tmvPromo.tmv-ig .tmv-accent{background:linear-gradient(90deg,#f09433,#dc2743,#cc2366,#bc1888)}
        #tmvPromo .tmv-inner{padding:18px 18px 20px;position:relative}
        #tmvPromo .tmv-close{position:absolute;top:14px;right:14px;width:28px;height:28px;border:0;border-radius:50%;
            background:#f3f4f6;color:#6b7280;font-size:16px;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .15s}
        #tmvPromo .tmv-close:hover{background:#e5e7eb;color:#374151}
        #tmvPromo .tmv-head{display:flex;align-items:center;gap:12px;margin-bottom:13px;padding-right:30px}
        #tmvPromo .tmv-badge{width:46px;height:46px;border-radius:14px;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
        #tmvPromo.tmv-g .tmv-badge{background:#fff;border:1px solid #eef0f3;box-shadow:0 3px 10px rgba(66,133,244,.15)}
        #tmvPromo.tmv-ig .tmv-badge{background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);box-shadow:0 4px 12px rgba(204,35,102,.28)}
        #tmvPromo .tmv-title{font-size:16px;font-weight:800;color:#111827;line-height:1.3}
        #tmvPromo .tmv-desc{font-size:13px;color:#6b7280;line-height:1.55;margin-bottom:16px}
        #tmvPromo .tmv-cta{display:block;text-align:center;text-decoration:none;color:#fff;font-weight:700;font-size:14px;
            padding:12px 16px;border-radius:12px;transition:transform .15s,box-shadow .15s}
        #tmvPromo .tmv-cta:hover{transform:translateY(-1px)}
        #tmvPromo.tmv-g .tmv-cta{background:#1a73e8;box-shadow:0 5px 16px rgba(26,115,232,.4)}
        #tmvPromo.tmv-g .tmv-cta:hover{background:#1765cc}
        #tmvPromo.tmv-ig .tmv-cta{background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);box-shadow:0 5px 16px rgba(204,35,102,.4)}
        @media (max-width:480px){
            #tmvPromo.tmv-pos-right,#tmvPromo.tmv-pos-left,#tmvPromo.tmv-pos-center,#tmvPromo.tmv-pos-middle{
                left:0;right:0;top:auto;bottom:0;margin:0;height:auto;max-height:none}
            #tmvPromo{left:0;right:0;bottom:0;width:100%;max-width:100%;border-radius:16px 16px 0 0;
                box-shadow:0 -6px 28px rgba(0,0,0,.18);animation:tmvPromoSheet .34s cubic-bezier(.2,.8,.2,1)}
            @keyframes tmvPromoSheet{from{transform:translateY(100%)}to{transform:none}}
            #tmvPromo .tmv-accent{height:3px}
            #tmvPromo .tmv-inner{padding:15px 16px 17px}
            #tmvPromo .tmv-head{gap:10px;margin-bottom:8px;padding-right:26px}
            #tmvPromo .tmv-badge{width:36px;height:36px;border-radius:10px}
            #tmvPromo .tmv-badge svg{width:19px;height:19px}
            #tmvPromo .tmv-title{font-size:14px}
            #tmvPromo .tmv-desc{font-size:12.5px;line-height:1.5;margin-bottom:13px}
            #tmvPromo .tmv-close{top:11px;right:11px;width:26px;height:26px;font-size:15px}
            #tmvPromo .tmv-cta{padding:12px 16px;font-size:13.5px}
        }
    </style>
    <div id="tmvPromo" class="tmv-pos-right" role="dialog" aria-live="polite" aria-labelledby="tmvPromoTitle" aria-describedby="tmvPromoDesc">
        <div class="tmv-accent"></div>
        <div class="tmv-inner">
            <button type="button" id="tmvPromoClose" class="tmv-close" aria-label="Kapat">&times;</button>
            <div class="tmv-head">
                <span id="tmvPromoIcon" class="tmv-badge"></span>
                <div id="tmvPromoTitle" class="tmv-title"></div>
            </div>
            <div id="tmvPromoDesc" class="tmv-desc"></div>
            <a id="tmvPromoCta" class="tmv-cta" href="#" target="_blank" rel="noopener noreferrer"></a>
        </div>
    </div>
    <script>
        (function () {
            var cards = {"google":{"title":"Google\u0027da bizi öne çıkarın","desc":"Google algoritmasına bırakmayın, okuyacağınız haberi siz seçin!","cta":"Tıkla ve ekle","url":"https:\/\/www.google.com\/preferences\/source?q=denizliekspres.com.tr","icon":"g"}};
            var icons = {
                g:  '<svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5a5.6 5.6 0 0 1-2.4 3.7v3h3.9c2.3-2.1 3.5-5.2 3.5-8.9z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 8-2.9l-3.9-3a7.2 7.2 0 0 1-10.8-3.8H1.2v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.2a12 12 0 0 0 0 10.8l4.1-3.1z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.4.6 4.6 1.8L20 3.2A12 12 0 0 0 1.2 6.6l4.1 3.1C6.3 6.8 8.9 4.8 12 4.8z"/></svg>',
                ig: '<svg width="26" height="26" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path fill="#fff" d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.9.2 2.3.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1.1.4 2.3.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.9-.4 2.3-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1.1.4-2.3.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.9-.2-2.3-.4a3.8 3.8 0 0 1-1.4-.9 3.8 3.8 0 0 1-.9-1.4c-.2-.4-.4-1.1-.4-2.3-.1-1.2-.1-1.6-.1-4.8s0-3.6.1-4.8c.1-1.2.2-1.9.4-2.3.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1.1-.4 2.3-.4 1.2-.1 1.6-.1 4.8-.1zm0 3.9a5.9 5.9 0 1 0 0 11.8 5.9 5.9 0 0 0 0-11.8zm0 9.7a3.8 3.8 0 1 1 0-7.6 3.8 3.8 0 0 1 0 7.6zm7.4-9.9a1.4 1.4 0 1 1-2.8 0 1.4 1.4 0 0 1 2.8 0z"/></svg>'
            };

            var V = 4;
            function ck(name) { return 'tmv_promo_' + name + '_v' + V; }

            function getCookie(name) {
                var m = document.cookie.match('(?:^|; )' + name + '=([^;]*)');
                return m ? decodeURIComponent(m[1]) : null;
            }
            function setCookie(name, value, days) {
                document.cookie = name + '=' + encodeURIComponent(value)
                    + '; path=/; max-age=' + (days * 86400) + '; SameSite=Lax';
            }

            var eligible = Object.keys(cards).filter(function (k) {
                return !getCookie(ck('done_' + k));
            });
            if (!eligible.length) return;
            if (getCookie(ck('wait'))) return;

            var seq = parseInt(getCookie('tmv_promo_seq') || '0', 10) || 0;
            var key = eligible[seq % eligible.length];
            var card = cards[key];

            var freqDays = 7;
            function finish() {
                setCookie(ck('wait'), '1', freqDays);
                var el = document.getElementById('tmvPromo');
                if (el) { el.style.display = 'none'; }
            }

            setTimeout(function () {
                var el = document.getElementById('tmvPromo');
                if (!el) return;
                setCookie('tmv_promo_seq', seq + 1, 400);
                el.classList.add(card.icon === 'ig' ? 'tmv-ig' : 'tmv-g');
                document.getElementById('tmvPromoIcon').innerHTML = icons[card.icon] || '';
                document.getElementById('tmvPromoTitle').textContent = card.title;
                document.getElementById('tmvPromoDesc').textContent = card.desc;
                var cta = document.getElementById('tmvPromoCta');
                cta.textContent = card.cta;
                cta.href = /^https?:\/\//i.test(card.url) ? card.url : '#';
                el.style.display = 'block';

                var autoHide = setTimeout(function () { finish(); }, 10000);

                document.getElementById('tmvPromoClose').addEventListener('click', function () {
                    clearTimeout(autoHide);
                    finish();
                });
                cta.addEventListener('click', function () {
                    clearTimeout(autoHide);
                    var doneDays = (key === 'google') ? 30 : 180;
                    setCookie(ck('done_' + key), '1', doneDays);
                    finish();
                });
            }, 6 * 1000);
        })();
    </script>
