        <style>
        @keyframes bellShake {
            0%, 50%, 100% { transform: rotate(0); }
            10%, 30%      { transform: rotate(15deg); }
            20%, 40%      { transform: rotate(-15deg); }
        }
        .important-fixed-notification-icon-box {
            position: fixed;
            z-index: 30 !important;
        }
        .important-post-panel {
            z-index: 30 !important;
        }
        .important-fixed-notification-icon-box .bell-shake {
            width: 20px;
            height: 20px;
            color: #fff;   /* SVG fill="currentColor" icin */
            margin: auto;   /* flex icinde kesin merkezleme */
            flex-shrink: 0;
            transform-origin: top center;
            display: block;
        }
        .important-fixed-notification-icon-box:hover .bell-shake {
            animation: bellShake 0.8s ease-in-out infinite;
        }
    </style>
    <div x-data="importantPost()" data-nosnippet>
    <div class="important-fixed-notification-icon-box" @click="togglePostPanel"
         :class="showPost ? 'bg-gray-700' : 'setgen-bg'">
        <svg class="bell-shake" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-label="Bildirim Zili" role="img">
            <path d="M12 2C10.9 2 10 2.9 10 4V4.29C7.03 5.17 5 7.9 5 11V16L3 18V19H21V18L19 16V11C19 7.9 16.97 5.17 14 4.29V4C14 2.9 13.1 2 12 2ZM12 22C13.1 22 14 21.1 14 20H10C10 21.1 10.9 22 12 22Z"/>
        </svg>
        <span class="important-notification-icon-box-count" @click.stop="setCookieAndClose" title="Kapat">x</span>
    </div>

    <div x-cloak class="important-post-panel dark:bg-customdarkgray-900 dark:text-gray-300" x-show="showPost">
        <div class="important-post-panel-close-button" @click="closePostPanel">×</div>
        <div class="mb-2 p-2 font-semibold text-xl setgen-bg setgen-text rounded-tm">
            <span x-text="panelTitle"></span>
        </div>

        <template x-for="item in post" :key="item.id">
            <div class="important-post-item cursor-pointer"
                 x-on:click="if (item.url) window.location.href = item.url">
                <picture class="important-post-image">
                    <template x-if="item.post_thumb_image.webp !== item.post_thumb_image.image">
                        <source srcset="data:," :srcset="item.post_thumb_image.webp" type="image/webp">
                    </template>
                    <img src="data:," :src="item.post_thumb_image.image" :alt="item.title || 'Haber'" loading="lazy">
                </picture>
                <div class="important-post-content">
                    <a href="#" rel="nofollow" :title="item.title"
                       x-on:click.prevent="if (item.url) window.location.href = item.url">
                        <div x-text="item.title" class="font-semibold line-clamp-2 text-sm"></div>
                    </a>
                    <p class="important-post-time-ago" x-text="item.created_at"></p>
                </div>
            </div>
        </template>

        <template x-if="!post.length">
            <div class="p-3 text-sm text-gray-300">Şu an gösterilecek içerik bulunamadı.</div>
        </template>
    </div>
</div>

    <script>
function importantPost() {
    return {
        showPost: false,
        post: [],
        panelTitle: "G\u00fcn\u00fcn Geli\u015fmeleri",
        loadPost() {
            fetch("https://www.denizliekspres.com.tr/important-post", { headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }})
                .then(r => { if (!r.ok) { throw new Error('important ' + r.status); } return r.json(); })
                .then(data => {

                    if (Array.isArray(data)) {
                        this.post = data;
                        this.panelTitle = data.length ? "G\u00fcn\u00fcn Geli\u015fmeleri" : "\u0130lginizi \u00c7ekebilir";
                        if (!data.length) this.fetchYesterdayFallback();
                    } else {
                        this.post = data.items || [];
                        this.panelTitle = data.title || (this.post.length ? "G\u00fcn\u00fcn Geli\u015fmeleri" : "\u0130lginizi \u00c7ekebilir");
                    }
                })
                .catch(err => console.error('Önemli gönderi yüklenirken hata:', err));
        },

        fetchYesterdayFallback() {  },

        togglePostPanel() {
            this.showPost = !this.showPost;
            if (this.showPost && !this.post.length) this.loadPost();
        },
        closePostPanel() { this.showPost = false; },
        setCookieAndClose() {
            document.cookie = "hidePostPanel=true; max-age=3600; path=/";
            document.querySelector('[x-data="importantPost()"]').style.display = 'none';
        }
    }
}

document.addEventListener('DOMContentLoaded', function () {
    if (document.cookie.split(';').some((c) => c.trim().startsWith('hidePostPanel='))) {
        const el = document.querySelector('[x-data="importantPost()"]');
        if (el) el.style.display = 'none';
    }
});
</script>

