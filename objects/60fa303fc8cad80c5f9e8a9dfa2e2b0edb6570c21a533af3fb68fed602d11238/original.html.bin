   <script>
      (function () {
         function done(e) {
            var t = e.target;
            if (!t || t.tagName !== 'IMG') return;
            var s = t.closest('.spot-skel');
            if (s) s.classList.add('skel-done');
         }
         document.addEventListener('load', done, true);
         document.addEventListener('error', done, true);
         document.addEventListener('DOMContentLoaded', function () {
            Array.prototype.forEach.call(document.querySelectorAll('.spot-skel img, img.spot-skel'), function (i) {
               if (i.complete) done({ target: i });
            });
         });
      })();
   </script>
