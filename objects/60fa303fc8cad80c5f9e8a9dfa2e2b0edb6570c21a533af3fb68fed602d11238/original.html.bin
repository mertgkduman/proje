<button
        x-data="{ scrollTo: false, timeout: null }"
        x-show="scrollTo"
        @scroll.window="
        clearTimeout(timeout);
        if (window.pageYOffset > 200) {
            scrollTo = true;
            timeout = setTimeout(() => scrollTo = false, 1000); // scroll durunca 1sn sonra kaybol
